CREATE TABLE #tempCloseRebookLoan
(
    RawDataId <same datatype as ETIDetailRecord.RawDataId>
);

INSERT INTO #tempCloseRebookLoan (RawDataId)
SELECT DISTINCT
       ETIDet2.RawDataId
FROM ETIDetailRecord ETIDet1
INNER JOIN ETIDetailRecord ETIDet2
    ON ETIDet1.TxnRefNbr =
       CASE
           WHEN ETIDet2.RecordTypeId = 23
               THEN CAST(SUBSTRING(ETIDet2.AgrRef, 2, 11) AS INT)
           ELSE ETIDet2.BgnRef
       END
WHERE ETIDet1.StatusId = 140
  AND ETIDet1.ProcessedRecordID = 2
