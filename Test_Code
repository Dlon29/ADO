        public static bool IsDate(String strToCheck)
        {
            /*
             * Function to Check for date in the M/D/Y format
             *	M can be 1 or 2 digits
             *	D can be 1 or 2 digits
             *	Y can be 2 or 4 digits
             * */

            Regex objDatePattern = new Regex(@"^(\d{1,2})(\/)(\d{1,2})(\/)(\d{2}|\d{4})$");
            return objDatePattern.IsMatch(strToCheck);
        }

