		CASE LEN(TriPartyGrpID) WHEN 0 THEN NULL ELSE CONVERT(INT,TriPartyGrpID) END,--TriPartyGrpID,
		CASE LEN(CollSchedID) WHEN 0 THEN NULL ELSE CONVERT(INT,CollSchedID) END,--CollSchedID,
		CASE WHEN (LEN(ProductCategory) = 0 OR ProductCategory = '')  THEN NULL ELSE ProductCategory END,--ProductCategory,
		LowDivRate,
		STTLevel,
		STTEndDate,
		STTDivRate,
