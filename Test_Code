                                    TotalQtyRecalledSale = Convert.ToInt64(lblLoanQtyAllocatedTOAcct.Text.Replace(",", "")) - (Convert.ToInt64(lblSaleQtyRecalled.Text.Replace(",", "")) + Convert.ToInt64(lblNonSaleQtyRecalled.Text.Replace(",", "")));

