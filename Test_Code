/* =============================================================
   Function-based version, adapted from the generic template to
   your actual schema.

   IMPORTANT: this restructuring does NOT fix the deadlock. It's
   the same query as the UNION ALL version from before, just
   packaged inside a function for reuse/testability. If the
   client's ask is specifically "make this a function so it's
   reusable/testable," this satisfies that. If the client believes
   a function will resolve the deadlock, that's a misconception -
   correct it before this ships. The root cause is still the
   read-then-write gap against ETIDetailRecord (see the two
   earlier messages in this thread).

   Note: functions cannot reference local (#) temp tables created
   outside their own scope, so the two-temp-table split from the
   previous version (#ValidTxnRefs -> #tempCloseRebookLoan) has to
   collapse into one self-contained query inside the function.
   ============================================================= */

CREATE OR ALTER FUNCTION dbo.fn_GetCloseRebookRawDataIds()
RETURNS TABLE
AS
RETURN
(
    WITH ValidTxnRefs AS (
        SELECT DISTINCT E.TxnRefNbr
        FROM ETIDetailRecord E
        WHERE E.RecordTypeId = 3        -- RSL
          AND E.StatusId = 140
          AND E.ProcessedRecordID = 2
    )
    SELECT E.RawDataId
    FROM ETIDetailRecord E
    INNER JOIN ValidTxnRefs V
        ON V.TxnRefNbr = E.BgnRef
       AND E.RecordTypeId = 1           -- TSL
       AND E.StatusId = 0

    UNION ALL

    SELECT E.RawDataId
    FROM ETIDetailRecord E
    INNER JOIN ValidTxnRefs V
        ON V.TxnRefNbr = CAST(SUBSTRING(E.BgnRef, 2, 11) AS INT)
       AND E.RecordTypeId = 23          -- GPL
       AND E.StatusId = 0
);
GO

-- 1. Explicitly define the table structure
CREATE TABLE #tempCloseRebookLoan
(
    RawDataId BIGINT NOT NULL
);

-- 2. Insert the data via the function
INSERT INTO #tempCloseRebookLoan (RawDataId)
SELECT RawDataId
FROM dbo.fn_GetCloseRebookRawDataIds();

