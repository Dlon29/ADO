		UnitsAllocated		BIGINT,
		MaxLimit			BIGINT,
		MinLimit			BIGINT, 
		Incr				INT,
		BrkID				INT,	
		BrkNbr				VARCHAR(12),
		AcctId				INT,
		AcctNbr				VARCHAR(12),
		FaceAmountFromAlloc	BIGINT,
		FaceAmountActual	BIGINT,	
		Price				NUMERIC(20,7),    --// Neelima-- change in code to make Price as 7 Decimal From NUMERIC(20,6)
		PriceCurr			VARCHAR(3),
