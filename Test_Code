using STBUSA.Excel.Util.C1Compatibility;
using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;

namespace MoBetterReports.CustomerReports.BusinessLogic
{
    public class C1ReportGenerationLogic : C1ReportGeneration
    {
        /// <summary>
        /// This method write a report header based on configuration read from config sheet
        /// </summary>
        /// <param name="secNo">section no for retriving data from DB config based on section</param>
        /// <param name="dtReportHeader">Data table contains report header data</param>
        /// <param name="configSections">It contains section wise configuration</param>
        /// <param name="dbColumns">It contains the information about database columns</param>
        /// <param name="workSheetTemplate">worksheet template which we need to write the data and generate the excel</param>
        public override void WriteReportHeader(int secNo, DataTable dtReportHeader, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, ref XLSheet workSheetTemplate)
        {
                //Header Section 1
                string section = "Section" + secNo;
                var getSection1Position = configSections[section].SectionValue.Split(',');  // Get starting Row and Column position from config collection.
                int Sec1row = Convert.ToInt32(getSection1Position[(int)Cell.Row]), Sec1column = Convert.ToInt32(getSection1Position[(int)Cell.Column]);
                var section1 = dbColumns.Where(p => p.Section == configSections[section].SectionName).ToList(); //Retrive the Section 1 from DB columns collection

                DBTempHeader dBTempHeader;
                for (int i = 0; i < dtReportHeader.Rows.Count; i++)
                {
                    for (int j = 0; j < section1.Count; j++)
                    {
                        dBTempHeader = new DBTempHeader();
                        dBTempHeader.DBColumn = section1[j].DBColumn;
                        dBTempHeader.DBNullValue = section1[j].DBNullValue;

                        var getSection1DynamicPosition = section1[j].Location.Split(',');
                        Sec1row = Convert.ToInt32(getSection1DynamicPosition[(int)Cell.Row]);
                        Sec1column = Convert.ToInt32(getSection1DynamicPosition[(int)Cell.Column]);

                        workSheetTemplate[Sec1row, Sec1column].SetValue((string.IsNullOrWhiteSpace(Convert.ToString(dtReportHeader.Rows[i][dBTempHeader.DBColumn])) == false ? dtReportHeader.Rows[i][dBTempHeader.DBColumn] : dBTempHeader.DBNullValue), workSheetTemplate.GetCell(Sec1row, Sec1column).Style);
                    }
                }
        }

        /// <summary>
        /// This method write a report header based on configuration read from config sheet
        /// </summary>
        /// <param name="secNo">section no for retriving data from DB config based on section</param>
        /// <param name="dtSection2">Data table contains section 2 data</param>
        /// <param name="configSections">It contains section wise configuration</param>
        /// <param name="dbColumns">It contains the information about database columns</param>
        /// <param name="workSheetTemplate">worksheet template which we need to write the data and generate the excel</param>
        public override void WriteSection2(int secNo, DataTable dtSection2, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, ref XLSheet workSheetTemplate)
        {
            //Data Section 2
            string section = "Section" + secNo;
            var getSection2Position = configSections[section].SectionValue.Split(','); // Get starting Row and Column position from config collection.
            int Sec2row = Convert.ToInt32(getSection2Position[(int)Cell.Row]), Sec2column = Convert.ToInt32(getSection2Position[(int)Cell.Column]);
            var section2 = dbColumns.Where(p => p.Section == configSections[section].SectionName).ToList(); //Retrive the Section 2 from DB columns collection.

            XLStyle xLStyle;
            DBTempHeader dBTempHeader;
            for (int i = 0; i < dtSection2.Rows.Count; i++)
            {
                for (int j = 0; j < section2.Count; j++)
                {
                    dBTempHeader = new DBTempHeader();
                    dBTempHeader.DBColumn = section2[j].DBColumn;
                    dBTempHeader.DBNullValue = section2[j].DBNullValue;

                    var colIndex = Convert.ToInt32(section2[j].Index);

                    workSheetTemplate.Rows[Sec2row].Height = workSheetTemplate.Rows[Convert.ToInt32(getSection2Position[(int)Cell.Row])].Height;
                    xLStyle = workSheetTemplate.GetCell(Convert.ToInt32(getSection2Position[(int)Cell.Row]), colIndex).Style;
                    xLStyle.BorderRight = XLLineStyleEnum.Thin;
                    workSheetTemplate[Sec2row, colIndex].SetValue((string.IsNullOrWhiteSpace(Convert.ToString(dtSection2.Rows[i][dBTempHeader.DBColumn])) == false ? dtSection2.Rows[i][dBTempHeader.DBColumn] : dBTempHeader.DBNullValue), xLStyle);
                }
                workSheetTemplate.Rows.Insert(Sec2row + 1);
                Sec2row++;
            }
            workSheetTemplate.Rows.RemoveAt(Sec2row);
        }

        /// <summary>
        /// 
        /// </summary>
        /// <param name="secNo"></param>
        /// <param name="dtAccount"></param>
        /// <param name="configSections"></param>
        /// <param name="dbColumns"></param>
        /// <param name="workSheetTemplate"></param>
        public override void WriteSection3(int secNo, DataTable dtAccount, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, ref XLSheet workSheetTemplate)
        {
            throw new NotImplementedException();
        }

        #region Helpers
        /// <summary>
        /// This method read the main configuration from config sheet
        /// </summary>
        /// <param name="workSheetConfig">worksheet for config</param>
        /// <returns>This method returns main config with type dict</returns>
        public override Dictionary<int, XLCell> GetConfiguration(XLSheet workSheetConfig)
        {
            Dictionary<int, XLCell> sheetConfig = new Dictionary<int, XLCell>();

            sheetConfig.Add((int)ConfigSectionKey.SectionPosition, workSheetConfig.GetCell(1, 1));
            sheetConfig.Add((int)ConfigSectionKey.DBColPosition, workSheetConfig.GetCell(2, 1));

            return sheetConfig;
        }

        /// <summary>
        /// This method read the database configuration from config sheet
        /// </summary>
        /// <param name="xLCell">Cell position to read for DB Configuration</param>
        /// <param name="xLConfigSheet">DB configuration</param>
        /// <returns>This method returns the DB config with type dict</returns>
        public override List<DBTempHeader> GetDBColumnFromConfig(XLCell xLCell, XLSheet xLConfigSheet)
        {
            List<DBTempHeader> dbColPosition = new List<DBTempHeader>();

            var colPosition = xLCell.Text.Split(',');
            int fromRowIndex = Convert.ToInt32(colPosition[0]), toRowIndex = Convert.ToInt32(colPosition[1]), fromColumnIndex = Convert.ToInt32(colPosition[2]), toColumnIndex = Convert.ToInt32(colPosition[3]);
            int count = 0;
            for (int i = fromRowIndex; i <= toRowIndex; i++)
            {
                DBTempHeader dBTempHeader = new DBTempHeader();
                count = 0;
                for (int j = fromColumnIndex; j <= toColumnIndex; j++)
                {
                    count++;
                    if (count == 1)
                        dBTempHeader.Section = ((xLConfigSheet.GetCell(i, j) != null) ? xLConfigSheet.GetCell(i, j).Text : null);
                    else if (count == 2)
                        dBTempHeader.DBColumn = ((xLConfigSheet.GetCell(i, j) != null) ? xLConfigSheet.GetCell(i, j).Text : null);
                    else if (count == 3)
                        dBTempHeader.Index = ((xLConfigSheet.GetCell(i, j) != null) ? xLConfigSheet.GetCell(i, j).Text : null);
                    else if (count == 4)
                        dBTempHeader.DBNullValue = ((xLConfigSheet.GetCell(i, j) != null) ? xLConfigSheet.GetCell(i, j).Text : null);
                    else if (count == 5)
                        dBTempHeader.Location = ((xLConfigSheet.GetCell(i, j) != null) ? xLConfigSheet.GetCell(i, j).Text : null);
                }

                dbColPosition.Add(dBTempHeader);
            }

            return dbColPosition;
        }

        /// <summary>
        /// This method read the section configuration from config sheet
        /// </summary>
        /// <param name="xLCell">Cell position to read for Section Configuration</param>
        /// <param name="xLConfigSheet">Section Configuration</param>
        /// <returns>This method returns the section config with type dict</returns>
        public override Dictionary<string, Sections> GetSectionsFromConfig(XLCell xLCell, XLSheet xLConfigSheet)
        {
            Dictionary<string, Sections> sections = new Dictionary<string, Sections>();

            var colPosition = xLCell.Text.Split(',');
            int fromRowIndex = Convert.ToInt32(colPosition[0]), toRowIndex = Convert.ToInt32(colPosition[1]), fromColumnIndex = Convert.ToInt32(colPosition[2]), toColumnIndex = Convert.ToInt32(colPosition[3]);
            int count = 0;
            for (int i = fromRowIndex; i <= toRowIndex; i++)
            {
                Sections section = new Sections();
                count = 0;
                for (int j = fromColumnIndex; j <= toColumnIndex; j++)
                {
                    count++;
                    if (count == 1)
                        section.SectionName = ((xLConfigSheet.GetCell(i, j) != null) ? xLConfigSheet.GetCell(i, j).Text : null);
                    else if (count == 2)
                        section.SectionValue = ((xLConfigSheet.GetCell(i, j) != null) ? xLConfigSheet.GetCell(i, j).Text : null);
                }
                sections.Add(section.SectionName, section);
            }

            return sections;
        }

        /// <summary>
        /// This method is used to Get the Excel column name using column index
        /// </summary>
        /// <param name="columnNumber">column number/index to get the column name</param>
        /// <returns>This method returns the column name based on column number/index</returns>
        public override string GetExcelColumnName(int columnNumber)
        {
            int dividend = columnNumber + 1;
            string columnName = String.Empty;
            int modulo;

            while (dividend > 0)
            {
                modulo = (dividend - 1) % 26;
                columnName = Convert.ToChar(65 + modulo).ToString() + columnName;
                dividend = (int)((dividend - modulo) / 26);
            }

            return columnName;
        }

        //Property class to read DB config
        public class DBTempHeader
        {
            public string Section { get; set; }
            public string DBColumn { get; set; }
            public string Index { get; set; }
            public string DBNullValue { get; set; }
            public string Location { get; set; }
        }

        //Property class to read section config
        public class Sections
        {
            public string SectionName { get; set; }
            public string SectionValue { get; set; }
        }

        //enumeration for config
        public enum ConfigSectionKey
        {
            SectionPosition = 1,
            DBColPosition = 2
        }

        //enumeration for Excel Cell
        public enum Cell
        {
            Row = 0,
            Column = 1
        }

        #endregion
    }
}
