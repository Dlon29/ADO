		NULL,
		temp.SecLocCode,
		temp.SecCode,
		FaceAmount,
		temp.Price, -- Price
		NULL, -- PriceOverride
		/*CASE b.BusinessInd
			WHEN 'FI' THEN
				ROUND((FaceAmount * temp.Price) / 100,2)
			ELSE ROUND((FaceAmount * temp.Price),2)
		END*/
		CASE WHEN @UseAmountCheck = 1 THEN temp.Principal ELSE ROUND((FaceAmount * temp.Price),2) END, -- Principal
		ISNULL(temp.PriceCurr, ''),
		temp.CollCCY, -- CollateralCCY
		CASE temp.SettlementDate WHEN '1900-01-01 00:00:00.000' THEN NULL ELSE temp.SettlementDate END,
		CASE temp.termDate WHEN '1900-01-01 00:00:00.000' THEN NULL ELSE temp.termDate END,
		temp.BrkNbr,
		temp.WLDepository,
		bs.LoanType,
		temp.Disclosure,
		temp.RebateRate,
		@BatchDate,
		temp.AsOfDate,
		1, -- IsValid
		0, -- ErrorBitMap
		@StatusId,
		temp.TransmitFlg,
		temp.BasketNbr,
		temp.ModifiedBy,
		@ModifiedDate
