        /// <summary>
        /// Page Navigation for grid
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void PageNavigation_Click(object sender, System.Web.UI.WebControls.CommandEventArgs e)
        {
            // get the parameters from hidden controls. 
            _PageChange = "True";
            MethodName = "PageNavigation_Click";
            try
            {
                switch (e.CommandName.ToUpper())
                {
                    case FIRST:						//first
                        _PageNo = 1;
                        txtGoTo1.Text = txtGoTo2.Text = string.Empty;
                        break;

                    case PREVIOUS:					//prev
                        _PageNo--;
                        txtGoTo1.Text = txtGoTo2.Text = string.Empty;
                        if (_PageNo < 1)
                            _PageNo = 1;
                        break;

                    case NEXT:						//next
                        _PageNo++;
                        txtGoTo1.Text = txtGoTo2.Text = string.Empty;
                        if (_PageNo > _TotPage)
                            _PageNo = _TotPage;
                        break;

                    case LAST:						//last
                        _PageNo = _TotPage;
                        txtGoTo1.Text = txtGoTo2.Text = string.Empty;
                        break;

                    case GOTO1:
                        _PageNo = Int32.Parse(this.txtGoTo1.Text);
                        break;

                    case GOTO2:
                        _PageNo = Int32.Parse(this.txtGoTo2.Text);
                        break;
                }

                // refresh the page based on the navigation
                LoadUploadRepoTemplates();
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                _show_error_row = string.Empty;
            }
        }

        /// <summary>
        /// Load Upload Template 
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        private void LoadUploadRepoTemplates()
        {
            MethodName = "LoadUploadRepoTemplates()";
            PagedDataSource objPagedDS = new PagedDataSource();

            try
            {
                DataSet DS = new DataSet();

                DS = GetMethodCall(enumGetSQLIdentifier.GET_UPLOADED_NEW_REPO_REQUEST.ToString());

                objPagedDS.DataSource = DS.Tables[0].DefaultView;
                objPagedDS.AllowPaging = true;

                if (objPagedDS.DataSourceCount < _PAGESIZE)
                    objPagedDS.PageSize = objPagedDS.DataSourceCount;
                else
                    objPagedDS.PageSize = _PAGESIZE;

                // delete the last page record contains only one record
                // will load pageN - 1
                if (_PageNo > objPagedDS.PageCount)
                    _PageNo = objPagedDS.PageCount;

                if (_PageNo <= 0)
                    _PageNo = 1;

                objPagedDS.CurrentPageIndex = _PageNo - 1;
                _TotPage = objPagedDS.PageCount;

                if (objPagedDS.Count == 0)
                {
                    _PageNo = 0;
                    _TotPage = 0;
                }

                PageNofM = _PageNo.ToString() + " of " + _TotPage.ToString();


                if (objPagedDS.Count > 0)
                {
                    pnlSRRMsg.Visible = false;
                    cmdDeleteRepoTemplate.Visible = true;
                    grdRepoUpload.DataSource = objPagedDS;
