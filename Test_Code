CREATE PROCEDURE [dbo].[p_GetCollateralMonitoringReport_CRMM]         
(             
  @pBatchRunDate DATETIME,      
  @pReportSetupID  SMALLINT=0,    
  @pSource   VARCHAR(10)='0',--0:UI, 1:Package   
  @isInternal BIT = 0  
)        
        
        
AS        
BEGIN        
        
SET NOCOUNT ON        
       
 DECLARE @AsOfStartDate  DATETIME= @pBatchRunDate -- P2422 SET @pBatchRunDate TO @AsOfStartDate AND @AsOfEndDate      
 DECLARE @AsOfEndDate  DATETIME = @pBatchRunDate      
      
 DECLARE @REFERENCE_REPORTID  AS INT        
 DECLARE @EQUITY_BUSINESS_IND AS VARCHAR (2)        
 --DECLARE @BusinessInd VARCHAR(2)        
 DECLARE @IncludeProcessedLoans BIT      

 SET @REFERENCE_REPORTID = 163        
 SET @EQUITY_BUSINESS_IND = 'EQ'        
         
   --P2422 remove report specific parameter which is no longer nedded.      
--SET @BusinessInd = dbo.f_GetReportParameterValue(@ReportID, '@CollateralBusinessInd')        
--SET @IncludeProcessedLoans = CONVERT(BIT, ISNULL(dbo.f_GetReportParameterValue(164, '@IncludeProcessedLoanSummary'),0))        
       
 SET @IncludeProcessedLoans = 1 --P2422 Set IncludeProcessedLoan 1 to get the data for EQ.               
         
--==================CRMM DATA START=======================================================          
 DECLARE @CurrentDate DATETIME = GETDATE(),          
  @ProductType VARCHAR(50),          
  @ReportProfileID INT,          
  @ProductLine VARCHAR(50) ,        
  @PackageID INT,          
  @Frequency CHAR(1)='' ,      
  @Format VARCHAR(5),      
 -- @IsOwnRepo BIT,       
 -- @IsIndemnified BIT = 0,      
  @CurrencyList VARCHAR(100),      
  @BatchRunDateEnd DATETIME = @pBatchRunDate    
 -- @INCLUDE_AGENT_DIRECT_LENDING_LOANS BIT      
        
 --GENERATE REPORT SETUP DATA           
 IF OBJECT_ID('tempdb..#TMP_REPORT_SETUP') IS NULL           
 BEGIN          
  SELECT *           
  INTO           
   #TMP_REPORT_SETUP          
  FROM           
  MOBETTER.dbo.f_CreateReportSetupSchema()          
 END          
          
 IF OBJECT_ID('tempdb..#TMP_REPORT_SETUP_DATA') IS NULL           
 BEGIN          
  SELECT *   
  INTO           
   #TMP_REPORT_SETUP_DATA          
  FROM           
   MOBETTER.dbo.f_CreateReportSetupDataSchema()          
 END          
          
 EXEC p_GenerateReportSetupData @BatchRunDate = @pBatchRunDate, @ReportID = @pReportSetupID          
 --EXEC p_GenerateReportSetupData @BatchRunDate = @CurrentDate, @ReportID = @pReportSetupID --TODO: Remove this and uncomment above line          
          
 --select * from #TMP_REPORT_SETUP          
 --select * from #TMP_REPORT_SETUP_DATA          
--GENERATE REPORT SETUP DATA END          
 SET @ReportProfileID = (SELECT ReportProfileID FROM #TMP_REPORT_SETUP)          
--GET REPORT PARAMETERS START          
           
 DECLARE @TestParam int = (select dbo.f_GetReportAttributeValue(@ReportProfileID,'TestParam'))          
 --SELECT @TestParam          
       SELECT @ProductType = ISNULL(ProductType, ''), @ReportProfileID = ISNULL(ReportProfileID, 0), @ProductLine = ISNULL(ProductLine, ''),@PackageID = PackageID ,@Format=Format      
   FROM #TMP_REPORT_SETUP      
         
  -- SET @IsOwnRepo = CASE WHEN @ProductType = 'OWN' THEN 1 ELSE 0 END       
  --IF @ProductType = 'ADL-SMTBUSA Indem' OR @ProductType = 'ADL-SMTBUSA Non-Indem'        
  --BEGIN        
  -- SET @INCLUDE_AGENT_DIRECT_LENDING_LOANS = 1        
  -- IF @ProductType = 'ADL-SMTBUSA Indem'        
  -- BEGIN        
  --  SET @IsIndemnified = 1        
  -- END        
  --END       
      
  --P2422: Check Package Frequency          
  IF(@pSource = '1')          
  BEGIN          
   SELECT @Frequency = Frequency       
   FROM NamedPackageHeader       
   WHERE PackageID = @PackageID          
          
   IF @Frequency = 'M'      
   BEGIN     
   DECLARE @BRD DATETIME = @AsOfStartDate 
              SET @AsOfStartDate = DATEADD(MONTH,DATEDIFF(MONTH,0,DATEADD(MONTH,-1,@BRD)),0)      
              SET @BatchRunDateEnd = DATEADD(MONTH,DATEDIFF(MONTH,0,@BRD),-1)      
			  set @AsOfEndDate = @BatchRunDateEnd
   END      
  END       
--==================CRMM DATA END=======================================================        

 SET @AsOfEndDate = dbo.f_GetPrevBizDayIfHoliday(@AsOfEndDate)        
 IF ( @AsOfStartDate > @AsOfEndDate )         
 BEGIN        
  SET @AsOfStartDate = @AsOfEndDate        
 END
      
--Sheet1Section1 RS 1       
 IF (@Format != 'PDF')      
 BEGIN      
  SELECT TS.CustomerReportTo AS [To]      
              ,CONVERT(VARCHAR, @BatchRunDateEnd, 101) AS ToDate                
              ,'Customer Report\' + TemplateFileName AS TemplateFileName                    
              --,'Customer Report\' + (SELECT TOP 1 VALUE FROM lava.dbo.fn_SplitStringWithDelimiter('|',TemplateFileName)           
              --            WHERE VALUE LIKE CASE @Format WHEN  'PDF' THEN '%.RPT' WHEN  'XLSX' THEN '%.XLSX' ELSE '%%'END) AS TemplateFileName      
         ,PackageFileName AS [FileName]                
         ,PackageFileName AS [PackageFileName]                
         , TS.[Format]      
         --, OptionalWS1       
         --, OptionalWS2        
         ,ISNULL(TS.WinZip,0) AS Zip      
         ,TS.Code       
   FROM #TMP_REPORT_SETUP TS         
  END         
    

 --Broker groups         
 IF OBJECT_ID('tempdb..#TMP_LATEST_BRKGROUPS','U') IS NULL        
 BEGIN        
  SELECT BrkGrpID, BrkGrpCode, BrkGrpName           
  INTO #TMP_LATEST_BRKGROUPS        
  FROM dbo.f_GetLatestBrokerGroups()         
  WHERE ( CLReportBrkGrpID IS NULL  )        
 END         
         
 --Indemnified accounts         
 IF ( OBJECT_ID('tempdb..#TMP_RWA_REPORT_ALL_ACCTS','U') IS NULL )         
 BEGIN      SELECT *         
  INTO #TMP_RWA_REPORT_ALL_ACCTS        
  FROM dbo.f_CreateRWAReportAccountsSchema()         
 END        
       
 /* P2422: commenting this as we have Filter Accounts based on Report Setup Data         
 IF ( OBJECT_ID('tempdb..#TMP_REPORT_ACCTS','U') IS NULL )         
 BEGIN        
SELECT CONVERT(VARCHAR(12), AcctNbr) AS AcctNbr        
  INTO #TMP_REPORT_ACCTS        
  FROM dbo.f_GetReportAcctNumberParams(163,'@AcctList')        
 END        
  SELECT * FROM #TMP_REPORT_ACCTS      
  */      
      
 --Collaterals         
 IF OBJECT_ID('tempdb..#TMP_COLLATERALS','U') IS NULL           
 BEGIN        
  SELECT *         
  INTO #TMP_COLLATERALS        
  FROM dbo.f_CreateCollateralsSchema()         
 END        
        
 --Allocations        
 IF OBJECT_ID('tempdb..#TMP_COLLATERAL_DETAILS','U') IS NULL  -- Allocated Collaterals        
 BEGIN        
  SELECT *         
  INTO #TMP_COLLATERAL_DETAILS        
  FROM dbo.f_CreateCollateralDetailsSchema()         
 END        
    
 --P2422    
 DECLARE @AcctNbrList   NVARCHAR(max) = NULL    
   select @AcctNbrList =     
   CONVERT(NVARCHAR(MAX),(select    
    (    
        select    
        t2.AcctID AS 'acct/@ID'    
        --t2.AcctNbr AS 'acct/@Number'    
        from #TMP_REPORT_SETUP_DATA as t2    
        --where t2.Acctnbr <> '100027076'    
        for xml path(''), type    
    )    
	for xml path ('root'),type))    
             
   --EXEC p_GetLoansAndCollateralAllocations @AsOfStartDate, @AsOfEndDate,NULL,164    
   EXEC p_GetLoansAndCollateralAllocations @AsOfEndDate, @AsOfEndDate,NULL,@REFERENCE_REPORTID    
   --SELECT * FROM #TMP_COLLATERAL_DETAILS     

 --Aggregate loans by broker          
 CREATE TABLE #TMP_PROCESSED_LOAN_SUMMARY           
 (          
	  BusinessInd   VARCHAR(2),          
	  TripartyGrpID INT,          
	  BrkGrpID   INT,          
	  BrkGrpName   VARCHAR(100),  
	  CollCCYCode CHAR(3),        
	  Principal  DECIMAL(25,10)          
 )          
           
 DECLARE @TMP_CURRENCY_CONV TABLE          
 (          
  AsOfDate  DATETIME,          
  FromCCY   VARCHAR(3),           
  ConversionRatio FLOAT           
 )          
           
 IF ( @IncludeProcessedLoans = 1 )          
 BEGIN          
  DECLARE @EQ_GLOBAL_USD AS INT           
  DECLARE @EQ_GLOBAL_EUR AS INT           
            
  SET @EQ_GLOBAL_EUR = 4          
  SET @EQ_GLOBAL_USD = 5          
            
  --Aggregate equity loans from MTMTripartyBalance          
  INSERT INTO #TMP_PROCESSED_LOAN_SUMMARY           
  (           
	 BusinessInd, TripartyGrpID, BrkGrpID, BrkGrpName, CollCCYCode,Principal           
  )          
  SELECT           
   BusinessIND = 'EQ',           
   TPBANK.TripartyGrpID,           
   TBRKGRP.BrkGrpID,           
   TBRKGRP.BrkGrpName,
   TTPBAL.CollCCYCode,           
   Principal = SUM(TTPBAL.BalanceAmount)
   --TTPBAL.BalanceAmount
  FROM           
   LAVA.dbo.MTMTripartyBalance AS TTPBAL          
   INNER JOIN [Broker] AS TBRK           
    ON ( TTPBAL.BrkNbr = TBRK.BrkNbr ) AND           
       ( TTPBAL.AsOfDate BETWEEN TBRK.EffectiveDateBegin AND TBRK.EffectiveDateEnd  ) AND           
       ( ISNULL(TBRK.IsDeleted,0) = 0 ) AND           
       ( ISNULL(TBRK.TriPartyID ,0) > 0 )           
   INNER JOIN dbo.[BrokerGroup] AS BG           
    ON ( TBRK.BrkGrpID = BG.BrkGrpID ) AND           
       ( TTPBAL.AsOfDate BETWEEN BG.EffectiveDateBegin AND BG.EffectiveDateEnd  ) AND           
       ( ISNULL(BG.IsDeleted,0) = 0 ) AND           
       ( ISNULL(BG.IsAgentDirectLending, 0 ) = 0 ) --#TMP_LATEST_BRKGROUPS not to be used here          
   INNER JOIN TriPartyBank AS TPBANK          
    ON ( TBRK.TriPartyID = TPBANK.TriPartyID ) AND           
       ( TTPBAL.AsOfDate BETWEEN TPBANK.EffectiveDateBegin AND TPBANK.EffectiveDateEnd ) AND           
 ( ISNULL(TPBANK.IsDeleted,0) = 0 )           
   INNER JOIN #TMP_LATEST_BRKGROUPS AS TBRKGRP          
    ON ( TBRK.BrkGrpID = TBRKGRP.BrkGrpID )          
  WHERE           
   ( TBRK.BusinessInd= 'EQ' ) AND           
   ( TTPBAL.AsOfDate BETWEEN @AsOfStartDate AND @AsOfEndDate ) AND           
   ( ISNULL(TTPBAL.IsDeleted,0) = 0  )   AND
   ( TTPBAL.IsLocked = 1)         
  GROUP BY           
	TPBANK.TripartyGrpID, TBRKGRP.BrkGrpID, TBRKGRP.BrkGrpName, TTPBAL.CollCCYCode         
          
     
  --Aggregate fixed income loans from ProcessedLoans         
  /* P422 TODO: replaced #TMP_REPORT_ACCTS with #TMP_REPORT_SETUP_DATA        
        
  SELECT TPL.*, CONVERT(DECIMAL(17,4),0) AS PrincipalUSD           
 INTO #TMP_PROCESSED_LOANS          
  FROM           
   dbo.f_IsFutureTableDateRange(@AsOfStartDate, @AsOfEndDate, 0, 0, 0) AS TPL -- 5th parameter to block the Loaned Securities Service records          
   INNER JOIN #TMP_REPORT_ACCTS AS TMP_RPT_ACCTS          
    ON ( TPL.AcctNbr = TMP_RPT_ACCTS.AcctNbr )          
   INNER JOIN #TMP_RWA_REPORT_ALL_ACCTS AS TACCTS          
    ON ( TMP_RPT_ACCTS.AcctNbr = TACCTS.AcctNbr )          
  WHERE           
   ( dbo.f_IsLoan( SecType , AllocFlag, TxnType ) = 1 ) AND           
   ( TPL.BucketSecType = 'FI' )       AND           
   ( TPL.IsFutureOverride = 0 )         
     */     
        
  SELECT TPL.*, CONVERT(DECIMAL(17,4),0) AS PrincipalUSD           
  INTO #TMP_PROCESSED_LOANS          
  FROM           
   dbo.f_IsFutureTableDateRange(@AsOfStartDate, @AsOfEndDate, 0, 0, 0) AS TPL -- 5th parameter to block the Loaned Securities Service records          
   INNER JOIN #TMP_REPORT_SETUP_DATA AS TRSD          
    ON ( TPL.AcctNbr = TRSD.AcctNbr )          
   INNER JOIN #TMP_RWA_REPORT_ALL_ACCTS AS TACCTS          
    ON ( TRSD.AcctNbr = TACCTS.AcctNbr )          
  WHERE           
   ( dbo.f_IsLoan( SecType , AllocFlag, TxnType ) = 1 ) AND           
   ( TPL.BucketSecType = 'FI' )       AND           
   ( TPL.IsFutureOverride = 0 )        
          
            
  INSERT INTO @TMP_CURRENCY_CONV  ( AsOfDate, FromCCY, ConversionRatio )           
  SELECT AsOfDate, FromCCY, dbo.f_GetCurrencyConversion(dbo.f_GetFlwnBizDay(AsOfDate), CONVERT(CHAR(3),FromCCY), 'USD')          
  FROM ( SELECT DISTINCT AsOfDate, CollCCYCode AS FromCCY FROM #TMP_PROCESSED_LOANS ) TPL          
  UNION            
  SELECT DISTINCT AsOfDate, 'USD', 1 FROM #TMP_PROCESSED_LOANS TPL --For USD currencies, there nothing to convert - ratio is 1.          
            
  UPDATE #TMP_PROCESSED_LOANS          
  SET PrincipalUSD = ( TPL.Principal * TCUR.ConversionRatio )           
  FROM           
   #TMP_PROCESSED_LOANS TPL INNER JOIN @TMP_CURRENCY_CONV TCUR            
   ON ( TPL.AsOfDate = TCUR.AsOfDate ) AND ( TPL.CollCCYCode = TCUR.FromCCY )             
            
  INSERT INTO #TMP_PROCESSED_LOAN_SUMMARY ( BusinessInd, TripartyGrpID, BrkGrpID, BrkGrpName, CollCCYCode, Principal)            
  SELECT 'FI' AS BusinessInd, TPL.TripartyGrpID, TBRKGRP.BrkGrpID, TBRKGRP.BrkGrpName, TPL.CollCCYCode, SUM(Principal)          
  FROM           
      #TMP_PROCESSED_LOANS AS TPL          
   INNER JOIN [BROKER] AS TBRK           
    ON ( TPL.BrkNbr = TBRK.BrkNbr ) AND ( TPL.AsOfDate BETWEEN TBRK.EffectiveDateBegin AND TBRK.EffectiveDateEnd  )            
   INNER JOIN dbo.[BrokerGroup] AS BG           
    ON ( TBRK.BrkGrpID = BG.BrkGrpID ) AND           
       ( TPL.AsOfDate BETWEEN BG.EffectiveDateBegin AND BG.EffectiveDateEnd  ) AND           
       ( ISNULL(BG.IsDeleted,0) = 0 ) AND           
       ( ISNULL(BG.IsAgentDirectLending, 0 ) = 0 ) --#TMP_LATEST_BRKGROUPS not to be used here          
   INNER JOIN #TMP_LATEST_BRKGROUPS AS TBRKGRP           
    ON ( TBRK.BrkGrpID = TBRKGRP.BrkGrpID )          
  GROUP BY            
   TPL.TriPartyGrpID, TBRKGRP.BrkGrpID, TBRKGRP.BrkGrpName, TPL.CollCCYCode          
    
 END           
          
          
 --Collaterals ( P1330 BRD 5.1 This report for JTSB shows only Triparty Equity Collateral (but for both fixed income and equity loans) with information derived from Triparty           
 --         reports which are delivered to SMTBUSA daily either via FTP or uploaded by the user into MoBetter (Euroclear) )                      
         
 SELECT TACCTS.AcctName, TCOL.*, TCLS.Description,        
 CASE WHEN TCLS.Description = 'Equities'  THEN 'EQ'           
    ELSE 'FI' END AS CollateralBusinessIndicator        
 INTO #TMP_ALLOCATIONS          
 FROM           
  #TMP_COLLATERAL_DETAILS AS TCOL           
  INNER JOIN CollateralClassAssetTypes TCLSAT           
   ON ( TCOL.TripartyGrpID = TCLSAT.TripartyGrpID ) AND ( TCOL.IssuerType = TCLSAT.IssuerType ) AND           
      ( TCOL.AsOfDate BETWEEN TCLSAT.EffectiveDateBegin AND TCLSAT.EffectiveDateEnd )           
  INNER JOIN CollateralClass TCLS           
   ON ( TCLSAT.CollateralClassID = TCLS.CollateralClassID ) AND           
      ( TCOL.AsOfDate BETWEEN TCLS.EffectiveDateBegin AND TCLS.EffectiveDateEnd )  
-- INNER JOIN #TMP_REPORT_ACCTS AS TRPTACCTS
  INNER JOIN #TMP_REPORT_SETUP_DATA AS TRSD     --P2422: replaced #TMP_REPORT_ACCTS with #TMP_REPORT_SETUP_DATA     
   ON ( TCOL.AcctNbr = TRSD.AcctNbr )             
  INNER JOIN #TMP_RWA_REPORT_ALL_ACCTS AS TACCTS          
   ON ( TRSD.AcctNbr = TACCTS.AcctNbr )          
  LEFT JOIN REFERENCE.dbo.Security AS TSEC           
   ON ( TCOL.SecID = TSEC.SecID )          
  LEFT JOIN SecurityStatistics AS TSECSTAT           
   ON (TSEC.TickSymb = TSECSTAT.TickerSymbol )          
   AND (TCOL.AsOfDate BETWEEN TSECSTAT.EffectiveDateBegin AND TSECSTAT.EffectiveDateEnd )          
 WHERE           
    (( TCLS.Description != 'CASH' )         
   --AND  (( TCLS.Description  = 'Equities' AND @BusinessInd = 'EQ' ) OR   --P2422 Commenting some filter conditions here becuase we need data for both EQ and FI here.        
            --( TCLS.Description != 'Equities' AND @BusinessInd = 'FI' ) OR           
            --( @BusinessInd IS NULL ))        
   )  AND           
     ( TCOL.CollValue IS NOT NULL )          
               
          
 --======================================================================================================================================================================================================          
 --Resultset           
 --======================================================================================================================================================================================================          
 --Processed loan summary        
 -- P2422 This result set is used to get the Principal for EQ.       
 /*      
 SELECT TLSUM.*           
 FROM #TMP_PROCESSED_LOAN_SUMMARY AS TLSUM          
 WHERE EXISTS ( SELECT * FROM #TMP_ALLOCATIONS AS TALLOC           
       WHERE ( TLSUM.TripartyGrpID = TALLOC.TripartyGrpID ) AND           
          ( TLSUM.BrkGrpID = TALLOC.BrkGrpID ) AND          
          ( TLSUM.BusinessInd = TALLOC.BucketSecType ) )          
   */        
         
      
   --Security monthly average volume      
  SELECT DISTINCT           
  TALLOC.SecCode, COALESCE(TALLOC.ISIN, TSEC.ISIN) AS ISIN, COALESCE(TSECINFO.TickerSymbol, TSEC.TickSymb) AS TickerSymbol, TALLOC.SecurityDesc, 
  TSECSTAT.MonthlyAvgVolume30D, ROUND(TSECSTAT.MonthlyAvgVolume30D*0.3,0) AS MonthlyAvgVolume30Per30D      
  INTO #TMP_SecADV      
  FROM           
  ( SELECT DISTINCT AsOfDate,SecCode, SecID, ISIN, SecurityDesc            
    FROM #TMP_ALLOCATIONS           
    WHERE ( CollateralBusinessIndicator = @EQUITY_BUSINESS_IND )) AS TALLOC          
  LEFT JOIN REFERENCE.dbo.Security AS TSEC           
  ON ( TALLOC.SecID = TSEC.SecID )          
  LEFT JOIN SecurityInfo AS TSECINFO          
  ON ((TALLOC.ISIN = TSECINFO.ISIN ) OR ( TSEC.ISIN = TSECINFO.ISIN ))          
  LEFT JOIN SecurityStatistics AS TSECSTAT           
  ON  (( TSEC.TickSymb = TSECSTAT.TickerSymbol ) OR (TSECINFO.TickerSymbol = TSECSTAT.TickerSymbol ))          
  AND (TALLOC.AsOfDate BETWEEN TSECSTAT.EffectiveDateBegin AND TSECSTAT.EffectiveDateEnd )       
           
 --Collateral allocations (FI)                 
 SELECT      
	'COLLATERAL' AS TxnType,       
	ReceivedOrDelivered,  
	BucketSecType,
	CollateralBusinessIndicator,      
	SecCode,        
	SecurityDesc,        
	CollCCYCode,        
	BrkGrpName,        
	Quantity,        
	SecurityPrice,        
	CollValue as MarketValue,  --Collateral Market Value      
	CollValueWithoutMargin As CollateralValue,--Collateral Required Value          
	CASE WHEN CollateralType = 'T' THEN 'Triparty'        
	ELSE 'Bilateral' END AS LoanType       
 FROM 
	#TMP_ALLOCATIONS        
 WHERE 
	( [Description] != 'Equities'  ) -- P2422 Flter data for FI for sheet 1            
 ORDER BY 
	BrkGrpName      
      
--Collateral allocations (EQ) 
 SELECT   
	TA.BrkGrpID,
	'COLLATERAL' AS TxnType,       
	ReceivedOrDelivered,      
	BucketSecType,
	CollateralBusinessIndicator,      
	TA.SecCode,        
	TA.SecurityDesc,        
	TA.CollCCYCode,       
	TA.BrkGrpName,        
	TLSUM.Principal AS LoanAmount,
	MAX(TA.SecurityPrice) AS SecurityPrice,            
	SUM(Quantity) AS Quantity,    
	SUM(CollValue) as MarketValue,  --Collateral Market Value      
	SUM(CollValueWithoutMargin) As CollateralValue, --Collateral Required Value      
	SUM(CollValue)/NULLIF(SUM(CollValueWithoutMargin),0) AS PercentMarginHairCut,      
	SUM(CollValueWithoutMargin)/NULLIF(TLSUM.Principal,0) AS PercentConcentration,      
	SA.MonthlyAvgVolume30D,      
	SA.MonthlyAvgVolume30Per30D,      
	CASE WHEN SUM(Quantity) < SA.MonthlyAvgVolume30Per30D THEN 'Yes' ELSE 'No' END AS 'UnitPledged30Per30ADV',
	'' AS '30DADV',
	'' AS '30%DADV',
	'No' AS 'UnitPledgedwithin30DATV',
	CONVERT(VARCHAR,TA.BrkGrpID)+BucketSecType+TA.CollCCYcode AS BrkGrpSecType
 FROM 
	#TMP_ALLOCATIONS TA 
 INNER JOIN
	(
		SELECT TLS.BusinessInd, TLS.BrkGrpID, TLS.CollCCYCode, SUM(TLS.Principal) AS Principal
		FROM #TMP_PROCESSED_LOAN_SUMMARY AS TLS
		WHERE EXISTS ( SELECT * FROM #TMP_ALLOCATIONS AS TALLOC 
						 WHERE ( TLS.TripartyGrpID = TALLOC.TripartyGrpID ) AND 
							   ( TLS.BrkGrpID = TALLOC.BrkGrpID ) AND
					           ( TLS.BusinessInd = TALLOC.BucketSecType ) AND
							   ( TLS.CollCCYcode = TALLOC.CollCCYcode ) AND 	
							   ( TALLOC.CollateralBusinessIndicator = 'EQ' ))
		GROUP BY
			TLS.BusinessInd, TLS.BrkGrpID, TLS.CollCCYCode  -- Group By logic fixed excludes TripartyGrpID for LoanAmount
	) TLSUM 
	ON
		 ( TLSUM.BrkGrpID = TA.BrkGrpID ) AND
		 ( TLSUM.BusinessInd = TA.BucketSecType ) AND
		 ( TLSUM.CollCCYCode = TA.CollCCYCode) 
 LEFT JOIN (SELECT DISTINCT SecCode,MonthlyAvgVolume30D,MonthlyAvgVolume30Per30D FROM #TMP_SecADV) SA 
	ON TA.SecCode=SA.SecCode      
 WHERE 
	( [Description] = 'Equities'  ) -- P2422 Flter data for EQ for sheet 2    
	--AND TA.BucketSecType != 'FI'  
	AND  CollateralType NOT IN ('S','P')--Excluding Bilaterals for EQ 3/11 
 GROUP BY 
	TA.BrkGrpID,ReceivedOrDelivered,BucketSecType,CollateralBusinessIndicator,TA.SecCode,SecurityDesc,TA.CollCCYCode,TA.BrkGrpName,TLSUM.Principal,
	SA.MonthlyAvgVolume30D,SA.MonthlyAvgVolume30Per30D
 ORDER BY 
	TA.BrkGrpName,BucketSecType,TA.CollCCYCode DESC  
    
 --Cleanup         
 TRUNCATE TABLE #TMP_COLLATERALS        
 TRUNCATE TABLE #TMP_COLLATERAL_DETAILS   
 TRUNCATE TABLE #TMP_ALLOCATIONS        
        
SET NOCOUNT OFF        
         
END 




CREATE PROCEDURE [dbo].[p_GetLoansAndCollateralAllocations] 
(
	@AsOfStartDate 	   DATETIME,
	@AsOfEndDate 	   DATETIME,
	@AcctNbrList	   VARCHAR(MAX) = NULL,
	@ReportID		   SMALLINT = 0, 
	@BucketLoanType    CHAR(2) = 'NC',		-- 'NC' ( NON-CASH ), NULL ( ALL ), 'C' ( CASH )
	@TargetCurrency	   VARCHAR(3) = NULL,
	@Source			   VARCHAR(10) = NULL,	 --LOAN / MARK (AS DEFAULT )
	@IsFICCOnly		   BIT = 0, -- To get FICC traded data only,
	@RollupFICCBrokers BIT = 0
)
AS

BEGIN 
	SET NOCOUNT ON
	DECLARE @OfficialStartDate DATETIME

	DECLARE @DAY_CTR INT

	DECLARE @INCLUDE_BILATERALS AS BIT
	DECLARE @INCLUDE_TRIPARTIES AS BIT
	DECLARE @INCLUDE_REPOS AS BIT
	DECLARE @INCLUDE_RIGHTS AS BIT
	DECLARE @INCLUDE_FUTURE_COLLATERALS AS BIT
	DECLARE @INCLUDE_AGENT_DIRECT_LENDING_LOANS AS BIT
	DECLARE @INCLUDE_MTM_PENDING AS BIT
	DECLARE @USE_ACTUAL_RISK_WEIGHTS AS BIT
	DECLARE @INCLUDE_FUTURE_LOANS AS BIT
	DECLARE @IGNORE_MTM_CYCLE AS BIT	
	
	DECLARE @RPTID_RWA_FA_ACTUAL	AS INT
	DECLARE @RPTID_RWA_FA_WORSTCASE AS INT
	DECLARE @RPTID_RWA_BPP	 AS INT
	DECLARE @RPTID_RWA_FO	 AS INT
	DECLARE @RPTID_RWA_RECON AS INT
	DECLARE @RPTID_MOAR_RECON AS INT
	DECLARE @RPTID_RWA_BPP_WORSTCASE AS INT
	DECLARE @RPTID_RWA_FO_WORSTCASE AS INT
	DECLARE @RPTID_RWA_INDEMNITY AS INT
	DECLARE @RPTID_RWA_INDEMNITY_LOANS AS INT
	DECLARE @RPTID_RWA_INDEMNITY_COLLATERALS AS INT
	DECLARE @RPTID_EQUITY_COLLATERAL_MONITORING	 AS INT
	DECLARE @RPTID_FIXEDINCOME_COLLATERAL_MONITORING AS INT
	DECLARE @RPTID_RWA_MOAR AS INT
	DECLARE @RPTID_RWA_MOAR_RECON AS INT	
	DECLARE @RPTID_CBJ_MTM AS INT	
	DECLARE @RPTID_RWA_HAIRCUT_FA_ACTUAL AS INT
	DECLARE @RPTID_RWA_HAIRCUT_FA_WORSTCASE AS INT
	DECLARE @RPTID_RWA_HAIRCUT_FO_ACTUAL AS INT
	DECLARE @RPTID_RWA_HAIRCUT_FO_WORSTCASE AS INT
	DECLARE @RPTID_RWA_HAIRCUT_FO_WORSTCASE_CAPPED AS INT	
	DECLARE @RPTID_RWA_HAIRCUT_FO_ACTUAL_REALTIME AS INT
