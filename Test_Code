		GotoSTTEndDate,
		GotoTermDate,
		ResetDate,
		GotoProductCategory

	FROM
		BulkLoanDetail
	WHERE
		BulkNbr = @BulkNbr AND
		VersionNbr = @VersionNbr

	INSERT INTO #TempSecurity
	(
		SecID, 
		CUSIP,
		SEDOL,
		ISIN,
		SecCode,
		DateEx,
		RecordDate,
		DivRate,
		SecurityDesc1,
		SecurityDesc2,
		ISOCountry,
		TickSymb,
		CcyCode,
		CountryName,
		BucketSecType
	)
	SELECT DISTINCT
		Sec.SecID,
		Sec.CUSIP,
		Sec.SEDOL,
		Sec.ISIN,
		Sec.SecCode,
		NULL DateEx,		
		LoanBasDtl.DateRecord,--CONVERT(VARCHAR(10),SecRecDate.MaxRecordDate,101),
		NULL DivRate,
		Sec.SecurityDesc1,
		Sec.SecurityDesc2,
		CASE Sec.SecCategoryID  WHEN 3005 THEN 'US' ELSE Sec.ISOCountry END ISOCountry,
		RTRIM(LEFT(Sec.TickSymb, 5)) AS TickSymb,
		Sec.CcyCode,
		CASE Sec.SecCategoryID  WHEN 3005 THEN 'United States' ELSE Sec.CountryName END CountryName,
		Sec.BucketSecurityType	
	FROM 
		REFERENCE.dbo.Security Sec	
	INNER JOIN
		#TempLoanBasketDetail LoanBasDtl
	ON
		LoanBasDtl.SecID = Sec.SecID 		

--SELECT * FROM #TempSecurity

	IF (@Identifier = 'GET_CPREPORT_DATA')
	BEGIN

		SELECT 
			Sec.CUSIP,
			Sec.SEDOL,
			Sec.ISIN,
			Sec.TickSymb,					
			Sec.DivRate,
			Sec.SecurityDesc1,
--			Sec.SecurityDesc2,
			Sec.ISOCountry,
			CONVERT(VARCHAR(10),LoanBasDtl.DateRecord,101) RecordDate,
--			Sec.BucketSecType,
			LoanBasDtl.FaceAmount,
			LoanBasDtl.Price,
			CASE Sec.BucketSecType 
				WHEN 'FI' THEN 	ROUND((LoanBasDtl.FaceAmount * LoanBasDtl.Price) /100,2)
				ELSE 	(LoanBasDtl.FaceAmount * LoanBasDtl.Price) 
			END as MktValue,
			LoanBasDtl.BrokerLendable,
			CASE Sec.BucketSecType 
				WHEN 'FI' THEN 	ROUND((LoanBasDtl.BrokerLendable * LoanBasDtl.Price) /100,2)
				ELSE 	(LoanBasDtl.BrokerLendable * LoanBasDtl.Price) 
			END as PotentialPrincipal,
			LoanBasDtl.DivYield
		FROM
			#TempSecurity Sec	
		INNER JOIN
			#TempLoanBasketDetail LoanBasDtl
		ON
			LoanBasDtl.SecID = Sec.SecID
		
		SELECT @ERROR_NO = @@ERROR  
	END
	ELSE IF (@Identifier = 'GET_INTREPORT_DATA')
	BEGIN
		SELECT 
			Sec.CUSIP,
			Sec.SEDOL,
			Sec.ISIN,
			Sec.TickSymb,					
			Sec.DivRate,
			Sec.SecurityDesc1,
--			Sec.SecurityDesc2,
			Sec.ISOCountry,
			CONVERT(VARCHAR(10),LoanBasDtl.DateRecord,101) RecordDate,
--			Sec.BucketSecType,
			LoanBasDtl.FaceAmount,
			LoanBasDtl.Price,
			CASE Sec.BucketSecType 
				WHEN 'FI' THEN 	ROUND((LoanBasDtl.FaceAmount * LoanBasDtl.Price) /100,2)
				ELSE 	(LoanBasDtl.FaceAmount * LoanBasDtl.Price) 
			END as MktValue,
			LoanBasDtl.BrokerLendable,
			CASE Sec.BucketSecType 
				WHEN 'FI' THEN 	ROUND((LoanBasDtl.BrokerLendable * LoanBasDtl.Price) /100,2)
				ELSE 	(LoanBasDtl.BrokerLendable * LoanBasDtl.Price) 
			END as PotentialPrincipal,
			LoanBasDtl.DivYield,
			CONVERT(VARCHAR(10),LoanBasDtl.TermDate,101) TermDate,
			CONVERT(VARCHAR(10),LoanBasDtl.SettlementDate,101) SettlementDate,
			CONVERT(VARCHAR(10),LoanBasDtl.STTEndDate,101) STTEndDate,
			LoanBasDtl.STTLevel STTLevel,
			LoanBasDtl.Price USDPx,
			LoanBasDtl.RebateRate FeeRate
		FROM
			#TempSecurity Sec	
		INNER JOIN
			#TempLoanBasketDetail LoanBasDtl
		ON
			LoanBasDtl.SecID = Sec.SecID

		SELECT @ERROR_NO = @@ERROR  
	END
	ELSE
	BEGIN
		RETURN 2
	END

	SET NOCOUNT OFF
	
	IF @ERROR_NO = 0
		RETURN 0
	ELSE  
		RETURN 1
END



--p_GetData_BulkLoan_GetCancelledLoan

CREATE PROCEDURE [dbo].[p_GetData_BulkLoan_GetCancelledLoan]
(	
	@SQL_IDENTIFIER			VARCHAR(25) = '',		
	@SQL_CONDITION1			XML
)
AS
BEGIN
	DECLARE @ERROR_NO INT, @BussDate DATETIME

	SELECt @BussDate = CurrentBatchDate FROM GLOBALONE.dbo.vw_G1_System

	IF (@SQL_CONDITION1 IS NOT NULL)
	BEGIN
		DECLARE @TxnRefNbrTable AS TABLE
		(
			TxnRefNbr VARCHAR(100)
		)

		INSERT INTO @TxnRefNbrTable
		(
			TxnRefNbr
		)
		SELECT 
			DISTINCT s.value('.', 'VARCHAR(100)') AS [TxnRefNbr]
		FROM   
			@SQL_CONDITION1.nodes('/SelectedLoanId/TxnRefNbr') AS t(s)
	 END
		
	SELECT DISTINCT 
		Sec.CUSIP
		,Sec.ISIN
		,Sec.TickSymb
		,Sec.SEDOL
		,'' DivYield
		,'' NextExDate
		,'' NextRecDate
		,'' DivRate
		,TradePrice AS price
		,RebateRate REBFEE
		,FaceAmount
		,ProductCategory
		,'' ProductCategoryLoanType
		,'' ProductCategoryLoanDuration
		,'' STTDivRate
		,'' DesiredSTTLevel
		,STTLevel AS STTLevel
		,SettlementDate
		,STTEndDate
		,'' ScripEndDate
		,TermDate
		,Comments Remarks
		,'' ResetDate
		,'' GotoRate
		,'' GotoTermDate
		,'' GotoRemarks
		,'' GotoProductCategory
		,'' GotoProductCategoryLoanType
		,'' GotoProductCategoryLoanDuration
		,AsOfDate = 
			CASE Depository 
				WHEN 'DTC' 
					THEN CONVERT (VARCHAR(12),@BussDate,101) 
				ELSE 
					(
						CASE TransmitFlg 
							WHEN 'Y' 
								THEN CONVERT (VARCHAR(12),AsOfDate,101) 
							ELSE 
								CONVERT (VARCHAR(12),@BussDate,101) 
						END
					) 
			END
	FROM 
		ETICancelLoan Dtl
	INNER JOIN
		REFERENCE.dbo.Security Sec
	ON
		(Sec.SecCode = Dtl.SecCode  OR
	 	Sec.Isin = Dtl.SecCode  OR
	 	Sec.Sedol = Dtl.SecCode  OR
	 	Sec.Cusip = Dtl.SecCode  OR
		RTRIM(LEFT(Sec.TickSymb, 5)) = Dtl.SecCode)
	WHERE 
		Dtl.TxnRefNbr IN (SELECT TxnRefNbr FROM @TxnRefNbrTable) 

	SET @ERROR_NO = @@ERROR	

	IF @ERROR_NO <> 0 
		RAISERROR ( 'Error raised in p_GetData_BulkLoan_GetCancelledLoan', 16, 1 )
END


