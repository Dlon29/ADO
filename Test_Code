						--Eliminate accounts because of Collateral restriction
						/** Delete accounts from temp table which has collateral restriction **/
						DELETE FROM 
							#AcctAvailability
						WHERE 
							AcctNbr IN (SELECT AcctNbr FROM dbo.CtrAccountCollateralRestriction WHERE CollateralType = @LoanType)		

						END
--SELECT 'BEFORE    #AcctAvailability',@ASECheck as ASECheck,@SecId,* FROM #AcctAvailability
--select @PoolCount, @TmpisFITokyoRepo ,@TmpisFITokyoSecLend ,@TmpisFISTBUSA 

						-- Logic for Adjusting Quantity in '#AcctAvailability' table if 'ASE' Checkbox is checked from UI. Starts
						IF(@ASECheck = 1)
						BEGIN
							UPDATE
								#AcctAvailability
							SET
								UnitsLendableRem  =  UnitsLendableRem + ISNULL(LoanTbl.FaceAmount,0) + ISNULL(PendingTbl.FaceAmount,0) + ISNULL(LT.Units, 0),
								UnitsLendableRestrictedRem = UnitsLendableRestrictedRem + ISNULL(LoanTbl.FaceAmount,0) + ISNULL(PendingTbl.FaceAmount,0) + ISNULL(LT.Units, 0)
							FROM
								#AcctAvailability AcctAvailtbl
							LEFT JOIN 
								(
									SELECT
										AcctNbr,sum(FaceAmount) as FaceAmount
									FROM 
										GLOBALONE.DBO.Loan 
									WHERE 
										SecID = @SecId  AND IsStreetSide = 0 AND TxnType = 'L' AND isFuture = 0 AND AllocFlag != '0'
									GROUP BY AcctNbr
								)LoanTbl
							ON
								LoanTbl.AcctNbr = AcctAvailtbl.AcctNbr
							LEFT JOIN 
								(
									SELECT
										AcctNbr,sum(FaceAmount) as FaceAmount
									FROM 
										#PendingTbl 
									WHERE 
										SecID = @SecId  AND
										((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
									GROUP BY AcctNbr
								)PendingTbl
							ON
								PendingTbl.AcctNbr = AcctAvailtbl.AcctNbr
							LEFT JOIN
								(
									SELECT
										AcctNbr, SUM(Units) as Units
									FROM
										dbo.LendingTransactions
									WHERE
										AsOfDate >= CONVERT(VARCHAR(10),GETDATE(),101) AND --Consider only present and future buys
										TheoSettleDate <= @SettlementDate AND ----SettleDate for buys should be <= loan settle date
										TransactionTypeSN = 'TB' AND--Consider only buys
										SecID = @SecId  
									GROUP BY
										AcctNbr
								) LT
							ON
								LT.AcctNbr = AcctAvailtbl.AcctNbr AND
								AcctAvailtbl.SecID = @SecId AND
								((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						END -- end of IF(@ASECheck = 1)
--SELECT 'AFTER    #AcctAvailability',@ASECheck as ASECheck,@SecId,* FROM #AcctAvailability			
						-- Logic for Adjusting Quantity in '#AcctAvailability' table if 'ASE' Checkbox is checked from UI. Ends

						--The allocation logic uses variable UnitsLendableRestrictedRem in rest of the logic below
						--So assigning value of variable UnitsLendableRem to variable UnitsLendableRestrictedRem
						IF (@UseTraderLendable = 1)
						BEGIN
							UPDATE
								#AcctAvailability
							SET			
								UnitsLendableRestrictedRem = UnitsLendableRem
							WHERE
								SecID = @SecId
						END -- end of (@UseTraderLendable = 1)

						--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
						SELECT DISTINCT TOP 1 @TmpisFITokyoSecLend =  isFITokyoSecLend FROM #AcctAvailability where PoolId = @PoolCount AND ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON
-ADL AND ADL-Indemnified Accounts 
						SELECT DISTINCT TOP 1 @TmpisFISTBUSA =  isFISTBUSA FROM #AcctAvailability where PoolId = @PoolCount AND ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-
Indemnified Accounts 
						--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only

						--IF ((@TmpisFITokyoRepo = 1) OR (@FinderNbr = '0000NY' AND @TmpisFITokyoSecLend = 1))
						IF ((@LoanCategory = 'CR') OR (@LoanCategory = 'RR')) --Repo/Rev Repo loans
						BEGIN
							-- If fidner is '000OWN' then read broker credit limit from #CtrOwnRepoCreditLimit else read it from #ctrBrokerCreditLimit
							IF (@FinderNbr = '000OWN')
							BEGIN

								SELECT TOP 1 
									@AcctGrpID = Acc.AcctGrpID 
								FROM 
									MOBETTER.dbo.AcctCollTypeSchedule AcctColl
								INNER JOIN 
									MoBetter.dbo.Account  Acc 
								ON 
									Acc.AcctNbr = AcctColl.AcctNbr AND 
									ISNULL(Acc.IsDeleted,0) = 0 AND 
									(GETDATE() BETWEEN Acc.EffectiveDateBegin AND Acc.EffectiveDateEnd) AND
									AcctColl.CollSchedId = @CollSchedId AND
									Acctcoll.TriPartyGrpID = @TriPartyGrpID
									
								SELECT 
									@BrkCreditLimitRemUSD = ISNULL(CrLimitOwnRepoRem,0)
								FROM 
									#CtrOwnRepoCreditLimit
								WHERE 
									BrkCrGrpID = @BrkCrGrpID AND
									AcctGrpId = @AcctGrpID
--select @BrkCreditLimitRemUSD,@BrkCrGrpID,@AcctGrpID
							END
							ELSE
							BEGIN
								-- Logic For Cash Repo loans, Base on RepoSecurityTypeId, we  need to decide which Limits to used : Start
								-- To Decide, which Limit to used, Use Combination of TriPartyGrpID,CollSchedId, and RepoSecurityTypeId From 'LoanRepoSecTypeCollSchCrLimitMapping' Table
								DECLARE @SqlQuery VARCHAR(max),@ColumnName VARCHAR(150);
								
								SELECT 
									@ColumnName = ColumnCtrIntradayLimit 
								FROM
									@LoanRepoSecTypeCollSchCrLimitMapping
								WHERE
									RepoSecurityTypeID = @RepoSecurityTypeId AND 
									CollSchedId = @CollSchedId AND
									--(GETDATE() BETWEEN EffectiveDateBegin AND EffectiveDateEnd)  AND
									TriPartyGrpID = @TriPartyGrpID  --AND
									--IsDeleted = 0

							
								IF (@ColumnName IS NOT NULL) 
								BEGIN
									SET @SqlQuery = '
									DECLARE @Limit BIGINT , @Colname varchar(200)
									select @Limit = ' +  @ColumnName + ', @Colname = ''' + @ColumnName + ''' from #ctrBrokerCreditLimit 
									select @Limit,@Colname';
								END
								ELSE
								BEGIN
										SET @SqlQuery = '
										DECLARE @Limit int , @Colname varchar(100)
										SET @Limit = 0
										select @Limit,@Colname';
								END
		
								DECLARE @TempLimitTable TABLE 
								(
									Limit				BIGINT,
									TmpColname			varchar(200)
								)
								--print @SqlQuery
								insert into @TempLimitTable
								exec (@SqlQuery)
							
								SELECT 
									@BrkCreditLimitRemUSD = (SELECT Top 1 Limit FROM @TempLimitTable)
								FROM 
									#ctrBrokerCreditLimit
								WHERE 
									BrkCrGrpID = @BrkCrGrpID
							END
							-- Logic For Cash Repo loans, Base on RepoSecurityTypeId, we  need to decide which Limits to used : End

							-- For Repo loans, only one Broker Credit Limit is available.
							-- This is unlike other cases where Broker Credit Limit is broken into 2 buckets - Indemnified and NonIndemnified
							-- So setting isIndemnified = 0 for these accounts to make sure that appropriate broker credit limit is checked
							SELECT @BrkCreditLimitRemIndUSD = @BrkCreditLimitRemUSD
							SELECT @BrkCreditLimitRemNonIndUSD = @BrkCreditLimitRemUSD

							/** Get the remaining Usage Conc limit for the selected BrkCrGrp **/
							SELECT 
								--@UsageLimitRemUSD = TkyRepoLoanUsageRemUSD
								@UsageLimitRemUSD = @InifiniteVal
							FROM 
								#ctrUsageConcLimit
							WHERE 
								BrkCrGrpID = @BrkCrGrpID

							-- For Repo loans,only one Broker Credit Limit is available.
							-- This is unlike other cases where Broker Credit Limit is broken into 2 buckets - Indemnified and NonIndemnified
							-- So setting isIndemnified = 0 for these accounts to make sure that appropriate broker credit limit is checked
							-- Same logic is extended to Usage Conc Limit
							SELECT @UsageLimitRemIndUSD = @UsageLimitRemUSD
							SELECT @UsageLimitRemNonIndUSD = @UsageLimitRemUSD


						END  -- END OF IF (@LoanCategory = 'CR') 
						ELSE IF (@LoanCategory = 'L' AND @TmpisFITokyoSecLend = 1) --Sec lending loans for isFITokyoSecLend = 1 --(@TmpisFITokyoSecLend = 1 AND @FinderNbr <> '0000NY')
						BEGIN
							SELECT 
								@BrkCreditLimitRemUSD = CrLimitTkySecLendRem
							FROM 
								#ctrBrokerCreditLimit
							WHERE 
								BrkCrGrpID = @BrkCrGrpID

							-- For loans that are allocated to accounts that have isFITokyoSecLend set to true, only one Broker Credit Limit is available.
							-- This is unlike other cases where Broker Credit Limit is broken into 2 buckets - Indemnified and NonIndemnified
							-- So setting isIndemnified = 0 for these accounts to make sure that appropriate broker credit limit is checked
							SELECT @BrkCreditLimitRemIndUSD = @BrkCreditLimitRemUSD
							SELECT @BrkCreditLimitRemNonIndUSD = @BrkCreditLimitRemUSD

							/** Get the remaining Usage Conc limit for the selected BrkCrGrp **/
							SELECT 
								@UsageLimitRemUSD = TkySecLendLoanUsageRemUSD
							FROM 
								#ctrUsageConcLimit
							WHERE 
								BrkCrGrpID = @BrkCrGrpID
						
							-- For loans that are allocated to accounts that have isFITokyoSecLend set to true, only one Broker Credit Limit is available.
							-- This is unlike other cases where Broker Credit Limit is broken into 2 buckets - Indemnified and NonIndemnified
							-- So setting isIndemnified = 0 for these accounts to make sure that appropriate broker credit limit is checked
							-- Same logic is extended to Usage Conc Limit
							SELECT @UsageLimitRemIndUSD = @UsageLimitRemUSD
							SELECT @UsageLimitRemNonIndUSD = @UsageLimitRemUSD
						END  ---- END OF ELSE IF (@LoanCategory = 'L' AND @TmpisFITokyoSecLend = 1)
						ELSE IF (@LoanCategory = 'L' AND @TmpisFISTBUSA = 1) --Sec lending loans for isFISTBUSA = 1
						BEGIN
							/** Get the remaining Ind Broker Credit limit for the selected BrkCrGrp **/
							SELECT 
								@BrkCreditLimitRemIndUSD =					
									CASE @FinderNbr WHEN '000LDN'
										THEN CrLimitLndSecLendIndemnifiedRem 
										ELSE CrLimitUSSecLendIndemnifiedRem 
									END
							FROM 
								#ctrBrokerCreditLimit
							WHERE 
								BrkCrGrpID = @BrkCrGrpID

							/** Get the remaining Non-Ind Broker Credit limit for the selected BrkCrGrp **/
							SELECT 
								@BrkCreditLimitRemNonIndUSD = 
									CASE @FinderNbr WHEN '000LDN' 
										THEN CrLimitLndSecLendNonIndemnifiedRem
										ELSE CrLimitUSSecLendNonIndemnifiedRem 
									END
							FROM 
								#ctrBrokerCreditLimit
							WHERE 
								BrkCrGrpID = @BrkCrGrpID

							/** Get the remaining Ind Usage Conc limit for the selected BrkCrGrp **/
							SELECT 
								@UsageLimitRemIndUSD = LoanUsageIndemnifiedRemUSD 
							FROM 
								#ctrUsageConcLimit
							WHERE 
								BrkCrGrpID = @BrkCrGrpID
							
							/** Get the remaining Non-Ind Usage Conc limit for the selected BrkCrGrp **/
							SELECT 
								@UsageLimitRemNonIndUSD = LoanUsageNonIndemnifiedRemUSD 
							FROM 
								#ctrUsageConcLimit
							WHERE 
								BrkCrGrpID = @BrkCrGrpID
						END  -- END OF ELSE IF (@LoanCategory = 'L' AND @TmpisFISTBUSA = 1)

						--Logic added to adjust Broker Credit Limit, if 'Override Broker Credit Limit' CheckBox is checked from UI Starts..
						IF(@OverrideBrkCreditLmt = 1)
						BEGIN						
								SET @BrkCreditLimitRemIndUSD = @InifiniteVal
								SET @BrkCreditLimitRemNonIndUSD = @InifiniteVal
						END
						--Logic added to adjust Broker Credit Limit, if 'Override Broker Credit Limit' CheckBox is checked from UI Ends..

						--Logic added to adjust Limit, for 'Loaned Securities Service loan'
						IF(@IsLoanedSecurityServiceLoan = 1)
						BEGIN	
							SET @BrkCreditLimitRemIndUSD = @InifiniteVal
							SET @BrkCreditLimitRemNonIndUSD = @InifiniteVal


							SET @UsageLimitRemIndUSD = @InifiniteVal
							SET @UsageLimitRemNonIndUSD = @InifiniteVal
						END

						/** Sum of Ind acct availability in a pool **/
						SELECT 
							@PoolAvailIndQty = SUM(UnitsLendableRestrictedRem) 
						FROM 
							#AcctAvailability 
						WHERE 
							IsIndemnified = 1
							AND ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						/** Sum of NonInd acct availability in a pool **/
						SELECT 
							@PoolAvailNonIndQty = SUM(UnitsLendableRestrictedRem) 
						FROM 
							#AcctAvailability 
						WHERE 
							IsIndemnified = 0
							AND ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						/** Find min of : Indemnified BrkCreditLimitUSD, UsageCreditLimitUSD and PoolAvail **/
						SELECT
							@MinAvailAndBCLAndUCLIndQty = MIN(Limit)
						FROM
						(
							SELECT 
								CONVERT(BIGINT,ISNULL(@BrkCreditLimitRemIndUSD,0) / @PricePerUnit) BrkCreditLimitRemIndQty,
								CONVERT(BIGINT,ISNULL(@UsageLimitRemIndUSD,0) / @PricePerUnit) UsageLimitRemIndQty,
								@PoolAvailIndQty  PoolAvailIndQty
						) p
						UNPIVOT
						(
							Limit FOR AvailBCLUCL IN 
							(
								BrkCreditLimitRemIndQty,
								UsageLimitRemIndQty,
								PoolAvailIndQty
							)
						) AS unpvt		


						/** Find min of : Non-Indemnified BrkCreditLimitUSD, UsageCreditLimitUSD and PoolAvail **/
						SELECT
							@MinAvailAndBCLAndUCLNonIndQty = MIN(Limit)
						FROM
						(
							SELECT 
								CONVERT(BIGINT,ISNULL(@BrkCreditLimitRemNonIndUSD,0) / @PricePerUnit) BrkCreditLimitRemNonIndQty,
								CONVERT(BIGINT,ISNULL(@UsageLimitRemNonIndUSD,0) / @PricePerUnit) UsageLimitRemNonIndQty,
								@PoolAvailNonIndQty  PoolAvailNonIndQty
						) p
						UNPIVOT
						(
							Limit FOR AvailBCLUCL IN 
							(
								BrkCreditLimitRemNonIndQty,
								UsageLimitRemNonIndQty,
								PoolAvailNonIndQty
							)
						) AS unpvt	
						
						/** Get the Lending Limit and Concentration Limit for each account group of selected broker **/
						SET @AcctCount = 1 
						SELECT @TotalAcctCount = COUNT(*) FROM #AcctAvailability

							/** Loop thru all the Lending Limit groups of a selected pool
							Loop through Only Non ADL Accounts.**/
							WHILE (@AcctCount <= @TotalAcctCount) -- Loop through each account
							BEGIN
								SET @LendingLimitGrpID = NULL
								SET @TotalAvailForLendingLimitGrpQty = NULL
								SET @LendLimitGrpRemUSD = NULL
								SET @ConcLimitRemUSD = NULL
								SET @MinOfAvailAndLLAndCLQty = NULL
								SET @RowID = NULL
								SET @IsIndemnified = NULL

								SELECT 
									@RowID = RowID 
								FROM 
									#AcctAvailability  
								WHERE
									IsProcessed = 0 AND
									((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

								
								SELECT 
									@LendingLimitGrpID	= LendingLimitGrpID,
									@IsIndemnified		= IsIndemnified
								FROM 
									#AcctAvailability
								WHERE
									RowId = @RowID AND--@AcctCount			
									((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

								/** Get the Lending Limit group Availability **/
								SELECT 
									@TotalAvailForLendingLimitGrpQty = SUM(UnitsLendableRestrictedRem) 
								FROM 
									#AcctAvailability AccAva 
								WHERE
									LendingLimitGrpID = @LendingLimitGrpID AND
									((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

								/** Get Lending limit of a selected group -
									Accounts may or may not have lending limits. If accounts have lending limits, then don't exceed it. 
									If they don't have lending limit, then it is not a restriction. */
								--Client Lending Limit is applicable only for Sec Lending. So setting it to infinity for cash repo 
								IF (@LoanCategory != 'CR' AND @LoanCategory != 'RR') --Sec Lending
								BEGIN
								IF EXISTS(SELECT AcctLendGrpID FROM #ctrLendingLimit where AcctLendGrpID = @LendingLimitGrpID)
								BEGIN
									SELECT 
										@LendLimitGrpRemUSD = LendGrpLimitRemUSD 
									FROM 
										#ctrLendingLimit
									WHERE
										AcctLendGrpID = @LendingLimitGrpID
								END
								ELSE
								BEGIN
									SELECT @LendLimitGrpRemUSD = @InifiniteVal --IF @LendLimitGrpRemUSD IS NULL then set it to infinity
								END
								END
								ELSE --Cash Repo
								BEGIN
									SELECT @LendLimitGrpRemUSD = @InifiniteVal
								END
								
								/** Get Concentration limit of a selected group and broker id -
									Accounts may or may not have Concentration limits. If accounts have Concentration limits, make sure they don't exceed it. 
									If they don't have lending limit, then it is not a restriction **/
								--Client Broker Concentration Limit is applicable only for Sec Lending. So setting it to infinity for cash repo 
								IF (@LoanCategory != 'CR' AND @LoanCategory != 'RR') --Sec Lending
								BEGIN
								IF EXISTS(SELECT AcctLendGrpID FROM #ctrConcentrationLimit where AcctLendGrpID = @LendingLimitGrpID AND	BrkCrGrpID = @BrkCrGrpID)
								BEGIN
									SELECT 
										@ConcLimitRemUSD = ConcLimitRemUSD 
									FROM
										#ctrConcentrationLimit
									WHERE 
										AcctLendGrpID = @LendingLimitGrpID AND
										BrkCrGrpID = @BrkCrGrpID	
								END
								ELSE
								BEGIN
									SELECT @ConcLimitRemUSD = @InifiniteVal --IF @ConcLimitRemUSD IS NULL then set it to infinity
								END
								END
								ELSE --Cash Repo
								BEGIN
									SELECT @ConcLimitRemUSD = @InifiniteVal
								END

								--Logic added to adjust Limit, for 'Loaned Securities Service loan'
								IF(@IsLoanedSecurityServiceLoan = 1)
								BEGIN	
									SET @ConcLimitRemUSD = @InifiniteVal
									SET @LendLimitGrpRemUSD = @InifiniteVal
								END


								/** Find min of limits (USD):  Lending Limit, Conc Limit **/
								SELECT
									@MinLendLimAndConcLimUSD = MIN(Limit)
								FROM
								(
									SELECT 
										ISNULL(@LendLimitGrpRemUSD,@InifiniteVal) LendLimitGrpRemUSD ,
										ISNULL(@ConcLimitRemUSD,@InifiniteVal) ConcLimitRemUSD
								) p
								UNPIVOT
								(
									Limit FOR LLCL IN 
									(
										LendLimitGrpRemUSD ,
										ConcLimitRemUSD
									)
								) AS unpvt

								/** Find min of limits :  Acct Avail, Lending Limit, Conc Limit **/
								SELECT
									@MinOfAvailAndLLAndCLQty = MIN(Limit)
								FROM
								(
									SELECT 
										CONVERT(BIGINT,ISNULL(@LendLimitGrpRemUSD,@InifiniteVal) / @PricePerUnit) LendLimitGrpRemQty,
										CONVERT(BIGINT,ISNULL(@ConcLimitRemUSD,@InifiniteVal) / @PricePerUnit) ConcLimitRemQty,
										@TotalAvailForLendingLimitGrpQty TotalAvailForLendingLimitGrpQty
								) p
								UNPIVOT
								(
									Limit FOR LLCL IN 
									(
										LendLimitGrpRemQty,
										ConcLimitRemQty,
										TotalAvailForLendingLimitGrpQty
									)
								) AS unpvt
--SELECT @MinLendLimAndConcLimUSD,@Price,@LendLimitGrpRemUSD,@LendLimitGrpRemUSD/@Price,CONVERT(BIGINT,ISNULL(@LendLimitGrpRemUSD,0) / @Price),CONVERT(BIGINT,ISNULL(@ConcLimitRemUSD,0) / @Price),@TotalAvailForLendingLimitGrpQty,@MinOfAvailAndLLAndCLQty
								/** Insert selected group's data into a working table for further processing One record per account 
								Insert only Non ADL Accounts data **/
								INSERT INTO #WorkingTbl 
								( 
									PoolId,
									AcctPriority,
									LendingLimitGrpID,
									AcctId,
									AcctNbr,
									AcctSN,
									BrkCrGrpID,
									BrkNbr,
									BrkID,
									AcctAvailibityRem,
									AcctAvailibityRestricted,
									LoopAvailability,
									PoolAvailability,
									BrkCreditLimitUSD,
									UsageCreditLimitUSD,
									MinAvailAndBCLAndUCLQty,
									LendingLimitUSD,
									ConcLimitUSD,
									MinLendLimAndConcLimUSD,
									MinOfAvailAndLLAndCLQty,
									MinOfAllLimitLoopQty,
									MinOfAllLimitPoolQty,
									UnitsLendable,
									UnUsedUnits,
									IsAcctUsed,
									SecID,
									WLDepository,
									ISOCountry,
									IsIndemnified,
									Price,
									MktValuePositionUSD,
									MktValueLoanUSD,
									PercentOnLoan,
									CanUseAcctForCleanUp,
									IsPoolUpdated,
									--isFITokyoRepo,
									isFITokyoSecLend,
									IsFISTBUSA,
									SecLoc,
									IsAgentDirectLending,
									AcctGrpID,
									SettlementDate,
									CCYCode ,
									TriPartyGrpID
								)
								SELECT 
									@PoolCount, -- PoolId (OrgPoolPriority)
									1, -- AcctPriority -- dummy, will be updated after allocation algorithm
									@LendingLimitGrpID, -- LendingLimitGrpID
									avail.AcctId,
									avail.AcctNbr, -- AcctNbr
									avail.AcctSN,
									@BrkCrGrpID, -- BrkCrGrpID
									@BrkNbr, -- BrkNbr
									@BrkID, -- BrkID
									UnitsLendableRem, -- AcctAvailibityRem
									UnitsLendableRestrictedRem, -- AcctAvailibityRestricted
									CASE @IsIndemnified WHEN 1 THEN ISNULL(@PoolAvailIndQty,0)  ELSE ISNULL(@PoolAvailNonIndQty,0) END, -- LoopAvailability
									0, -- PoolAvailability
									CASE @IsIndemnified WHEN 1 THEN ISNULL(@BrkCreditLimitRemIndUSD,0) ELSE ISNULL(@BrkCreditLimitRemNonIndUSD,0) END, -- BrkCreditLimitUSD
									CASE @IsIndemnified WHEN 1 THEN ISNULL(@UsageLimitRemIndUSD,0) ELSE ISNULL(@UsageLimitRemNonIndUSD,0) END, -- UsageCreditLimitUSD
									CASE @IsIndemnified WHEN 1 THEN @MinAvailAndBCLAndUCLIndQty ELSE @MinAvailAndBCLAndUCLNonIndQty END, -- MinAvailAndBCLAndUCLQty
									--ISNULL(@LendLimitGrpRemUSD,@InifiniteVal),--@CurrentLendingGrpLimit, -- LendingLimitUSD					
									--ISNULL(@ConcLimitRemUSD,@InifiniteVal),--@CurrentConcLimit, -- ConcLimitUSD
									--ISNULL(@MinLendLimAndConcLimUSD,0), -- MinLendLimAndConcLimUSD
									CASE WHEN ( (ISNULL(avail.IsAgentDirectLending,0) = 1)  AND (ISNULL(avail.IsIndemnified,0) = 1) ) THEN @InifiniteVal ELSE ISNULL(@LendLimitGrpRemUSD,@InifiniteVal) END,	  -- -- LendingLimitUSD		 ( ADL-Indemnified Accounts has Infinity )
									CASE WHEN ( (ISNULL(avail.IsAgentDirectLending,0) = 1)  AND (ISNULL(avail.IsIndemnified,0) = 1) ) THEN @InifiniteVal ELSE ISNULL(@ConcLimitRemUSD,@InifiniteVal) END,		  -- ConcLimitUSD  ( ADL-Indemnified Accounts has Infinity )				
									CASE WHEN ( (ISNULL(avail.IsAgentDirectLending,0) = 1)  AND (ISNULL(avail.IsIndemnified,0) = 1) ) THEN @InifiniteVal ELSE ISNULL(@MinLendLimAndConcLimUSD,@InifiniteVal) END, -- MinLendLimAndConcLimUSD ( ADL-Indemnified Accounts has Infinity )
									ISNULL(@MinOfAvailAndLLAndCLQty,0), -- MinOfAvailAndLLAndCLQty
									0, -- MinOfAllLimitLoopQty
									0, -- MinOfAllLimitPoolQty
									0, -- UnitsLendable
									0, -- UnUsedUnits
									0, -- IsAcctUsed
									SecID, --SecurityID
									WLDepository,
									ISOCountry,	
									@IsIndemnified,
									@Price,
									0, -- MktValuePositionUSD
									0, -- MktValueLoanUSD
									0, -- PercentOnLoan,
									0, -- CanUseAcctForCleanUp
									0,  -- IsPoolUpdated
									--@TmpisFITokyoRepo,
									isFITokyoSecLend,--@TmpisFITokyoSecLend,--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
									isFISTBUSA,		 -- @TmpisFISTBUSA , --Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
									@WLDepoCode,
									ISNULL(avail.IsAgentDirectLending,0),--IsAgentDirectLending
									avail.AcctGrpId,
									@SettlementDate,
									@CCYCode,
									avail.TriPartyGrpID
								FROM 
									#AcctAvailability avail
					--			INNER JOIN 
					--				dbo.AcctSetup acct
					--			ON
					--				acct.AcctNbr = avail.AcctNbr AND  
								WHERE 
									LendingLimitGrpID = @LendingLimitGrpID  AND
									((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
								
								
								--===============================================================================================================================================================================								
								--Set Prepay Indicator default vs MTM Broker Maintenance MTM New Loans setup 
								--===============================================================================================================================================================================
								UPDATE 
									TMP_WT
								SET 
									IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
																  FROM #TMP_DEFPREPAY_MTM_NEW_LOANS AS TMP_DEF_PREPAY_MTMNEWLN
																  WHERE TMP_DEF_PREPAY_MTMNEWLN.SettlementDay = TMTMBRK.MTMNewLoans ) THEN 1 
													ELSE 0 
													END
								FROM 
									#WorkingTbl AS TMP_WT
									INNER JOIN MTMBroker AS TMTMBRK
										ON  ( TMP_WT.BrkNbr = TMTMBRK.BrkNbr )   AND  
											( ISNULL(TMTMBRK.IsDeleted, 0) = 0 ) AND  
											( @AsOfDate BETWEEN TMTMBRK.EffectiveDateBegin AND TMTMBRK.EffectiveDateEnd )

								--===============================================================================================================================================================================
								--Set Prepay Indicator default vs MTM Broker Maintenance Loan Country Exception setup 
								--===============================================================================================================================================================================
								UPDATE 
									TMP_WT
								SET 
									IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
																  FROM #TMP_DEFPREPAY_MTM_LNCTRY AS TMP_DEF_PREPAY_MTMLNCTRY
																  WHERE TMP_DEF_PREPAY_MTMLNCTRY.SettlementDay = TLCE.SettlementDays ) THEN 1 
													ELSE 0 
													END
								FROM 
									#WorkingTbl AS TMP_WT
									INNER JOIN MTMBrokerLoanCountryException AS TLCE  
										ON  
											( TMP_WT.BrkNbr = TLCE.BrkNbr ) AND  
											( TMP_WT.CCYCode = TLCE.LoanExcepCCY )  AND  
											( ISNULL(TLCE.IsDeleted, 0) = 0 ) AND  
											( @AsOfDate BETWEEN TLCE.EffectiveDateBegin AND TLCE.EffectiveDateEnd )
								WHERE 
											( ISNULL(TMP_WT.IsPrePay,0) = 0 ) 
								--===============================================================================================================================================================================


								UPDATE 
									#AcctAvailability
								SET 
									ISProcessed = 1
								WHERE 
									LendingLimitGrpID = @LendingLimitGrpID  AND
									((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
									--AND RowID = @RowID
								
								--Update SMODE in working table
								IF (@SQL_IDENTIFIER = 'BULKLOAN')
									BEGIN
									UPDATE 
										#WorkingTbl
										SET SMODE =  Depo.SMODE  --Depo.SMODE
										FROM 
											#WorkingTbl Work
										INNER JOIN GLOBALONE.dbo.DEPOT Depo
											ON  LTRIM(RTRIM(GLOBALONE.dbo.f_RemoveHeaderZero(Depo.CM_ACCT_NO))) = work.WLDepository	
									END
								ELSE
									BEGIN
									 UPDATE #WorkingTbl
										SET SMODE = CASE @LoanType WHEN 'T' THEN (CASE @SecLocCode WHEN 'SD' THEN REPLACE(Depo.SMODE,'US','') + 'CW' ELSE Depo.SMODE  END) ELSE Depo.SMODE  END
									 FROM #WorkingTbl Work
									 INNER JOIN GLOBALONE.dbo.DEPOT Depo
									 ON  LTRIM(RTRIM(GLOBALONE.dbo.f_RemoveHeaderZero(Depo.CM_ACCT_NO))) = work.WLDepository
									END

								/** Increase count **/
								SELECT 
									@AcctCount = MIN(RowId) --+ 1 
								FROM 
									#AcctAvailability 
								WHERE 
									--LendingLimitGrpID = @LendingLimitGrpID  AND 
									ISProcessed = 0 AND
									((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

							END -- Account table loop finishes -- end of WHILE (@AcctCount <= @TotalAcctCount) -- Loop through each account
						
						/*Update Pool level availability*/
						UPDATE 
							#WorkingTbl
						SET
							PoolAvailability = ISNULL(@PoolAvailIndQty, 0) + ISNULL(@PoolAvailNonIndQty, 0)
						WHERE
							PoolId = @PoolCount	AND
							((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						/** Find Min of All Limit for Ind Accounts **/
						SELECT 
							@MinOfAllLimitIndLoopQty = MIN(Limit)
						FROM
						(
							SELECT 
								MIN(temp.MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty,
								SUM(temp.MinOfAvailAndLLAndCLQty) SumOfAvailAndLLAndCLQty
							FROM
								(SELECT MIN(MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty, MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty,IsIndemnified FROM #WorkingTbl GROUP BY LendingLimitGrpID,PoolId,IsIndemnified  HAVING PoolId = @PoolCount AND IsIndemnified = 1) te
mp
						) p
						UNPIVOT
						(
							Limit FOR BCLUCL IN 
							(
								MinAvailAndBCLAndUCLQty,
								SumOfAvailAndLLAndCLQty
							)
						) AS unpvt		
					
						/** Update MinOfAllLimitLoopQty in working table **/
						UPDATE 
							#WorkingTbl
						SET
							MinOfAllLimitLoopQty = ISNULL(@MinOfAllLimitIndLoopQty,0)
						WHERE
							PoolId = @PoolCount AND 
							IsIndemnified = 1 AND
							((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						/** Find Min of All Limit for NonInd Accounts **/
						SELECT 
							@MinOfAllLimitNonIndLoopQty = MIN(Limit)
						FROM
						(
							SELECT --minbclnduclindqty,minbclnduclnonindqty
								MIN(temp.MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty,
								SUM(temp.MinOfAvailAndLLAndCLQty) SumOfAvailAndLLAndCLQty
							FROM
								(
									SELECT 
										MIN(MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty,MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty,IsIndemnified 
									FROM 
										#WorkingTbl  
									WHERE
										((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
									GROUP BY 
										LendingLimitGrpID,PoolId,IsIndemnified  
									HAVING
										PoolId = @PoolCount AND IsIndemnified = 0) temp
						) p
						UNPIVOT
						(
							Limit FOR BCLUCL IN 
							(
								MinAvailAndBCLAndUCLQty,
								SumOfAvailAndLLAndCLQty
							)
						) AS unpvt

						/** Update MinOfAllLimitLoopQty in working table **/
						UPDATE 
							#WorkingTbl
						SET
							MinOfAllLimitLoopQty = ISNULL(@MinOfAllLimitNonIndLoopQty,0)
						WHERE
							PoolId = @PoolCount AND 
							IsIndemnified = 0 AND
							((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						/** Update MinOfAllLimitPoolQty in working table **/
						UPDATE 
							#WorkingTbl
						SET
							MinOfAllLimitPoolQty = ISNULL(@MinOfAllLimitIndLoopQty,0) + ISNULL(@MinOfAllLimitNonIndLoopQty,0)
						WHERE
							PoolId = @PoolCount	 AND
							((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						SET @PoolCount = @PoolCount  + 1
					END -- end of WHILE (@PoolCount <= @TotalPoolCount)

					/** End of Loop for Non ADL Accounts - Group 1**/
--select * from #WorkingTbl

					/** Find the new pool priority **/
					TRUNCATE TABLE #PoolPriority

				/** Loop for ADL - (Agent Direct Lending) Accounts - Group 2**/
				/***********  Code Changes for ADL  Accounts Starts *********/
				/* Here we are calculating Pool limits. We will have pool loop for ADL Accoutns.
				   Inside Pool Loop, there is no Account loop.We are calculating account level data by direct quries base on IsIndemnified.
				   for ADL Accounts we have different IsIndemnified value base on  Account GroupID.
				*/

				SET @PoolCount = 1
				SELECT @TotalPoolCount = COUNT(*) FROM #PoolTable
				/** Loop thru all the pools of temp pool table FOR  ADL Accounts **/
				WHILE (@PoolCount <= @TotalPoolCount)
				BEGIN
				
					/** Truncate AcctAvailability table for each pool **/	
					TRUNCATE TABLE #AcctAvailability --Work with pool level data only

					/** Assign NULL values to variables  before using them **/
					SET @WLDepository = NULL
					SET @BrkNbr = NULL
					SET @BrkID = NULL
					SET @BrkCreditLimitRemIndUSD = NULL
					SET @BrkCreditLimitRemNonIndUSD = NULL
					SET @UsageLimitRemIndUSD = NULL
					SET @UsageLimitRemNonIndUSD = NULL
					SET @PoolAvailIndQty = NULL
					SET @PoolAvailNonIndQty= NULL
					SET @MinAvailAndBCLAndUCLIndQty = NULL
					SET @MinAvailAndBCLAndUCLNonIndQty = NULL

					SET	@BrkCreditLimitRemUSD = NULL
					SET	@UsageLimitRemUSD = NULL

					/** Read values in variables **/
					SELECT
						@WLDepository = WLDepository,
						--@IsIndemnified = IsIndemnified,
						@BrkNbr = BrkNbr,
						@BrkID = BrkID --,
						--@TmpisFITokyoRepo = isFITokyoRepo,
						--@TmpisFITokyoSecLend = isFITokyoSecLend,  --Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
						--@TmpisFISTBUSA = isFISTBUSA				--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
					FROM
						#PoolTable
					WHERE
						Priority = @PoolCount
					
					

					/** Insert AcctAvailability data of a selected pool into a temp table **/
					/* Consider only ADL -(Agent Direct Lending) Accounts*/

					INSERT INTO #AcctAvailability
						(
							PoolId,
							LendingLimitGrpID,
							AcctId,
							AcctNbr,
							AcctSN,
							SecID,
							WLDepository,
							ISOCountry,
							UnitsLendableRem,
							UnitsLendableRestrictedRem,
							MinOfAvailAndLLAndCLQty,
							--isFITokyoRepo,
							isFITokyoSecLend,
							isFISTBUSA,
							IsProcessed,
							IsIndemnified,
							IsAgentDirectLending,
							AcctGrpId,
							TriPartyGrpID
						)
						SELECT DISTINCT	
							@PoolCount,
							LendingLimitGrpID ,
							AcctID,
							AcctNbr,
							AcctSN,
							SecID,
							WLDepository,
							ISOCountry,
							UnitsLendableRem,
							UnitsLendableRestrictedRem ,
							0, -- MinOfAvailAndLLAndCLQty
							--isFITokyoRepo,
							isFITokyoSecLend,
							isFISTBUSA,
							0, -- IsProcessed
							IsIndemnified,
							ISNULL(IsAgentDirectLending,0),
							AcctGrpId,
							TriPartyGrpID
						FROM 
							#ctrAvailability
						WHERE 
							SecId = @SecId AND
							--IsIndemnified = @IsIndemnified AND
							WLDepository = @WLDepository AND
							--isFITokyoRepo = @TmpisFITokyoRepo  AND
							--isFITokyoSecLend = @TmpisFITokyoSecLend AND  --Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
							--isFISTBUSA = @TmpisFISTBUSA  AND				--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only			
							(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accounts   - Here we are considering ISNULL(IsIndemnified,0) != 1) because, we multiplied 'IsIndemnified' with dummy number at top'IsIndem
nified = (LendingLimitGrpID * 2)' where IsIndemnified = 0
						ORDER BY
							LendingLimitGrpID --Order by account lending group
							--isFISTBUSA -- this will pick US acct first

--select '#AcctAvailability - ADL tBL ' , * from #AcctAvailability

					---------For Reverse Repo, we will have only 1 Accout Row in AcctAvailability. So check whether the Acct Nbr is in the restricted tables-----------
						If (@IsRevRepoLoan = 1)
						BEGIN
							IF EXISTS (SELECT 1 FROM #ctrBrokerAccountRestriction WHERE BrkId = @BrkID AND AcctNbr IN (SELECT DISTINCT AcctNbr FROM #AcctAvailability))
							BEGIN
							     SET @IsRevRepoBrkAcctRestricted = 1
							END

							IF EXISTS (SELECT 1 FROM dbo.CtrAccountCollateralRestriction WHERE CollateralType = @LoanType AND AcctNbr IN (SELECT DISTINCT AcctNbr FROM #AcctAvailability))
							BEGIN
								SET @IsRevRepoAcctCollateralRestricted = 1
							END
						END
						ELSE
						BEGIN
							--broker-account legal entity restrictions
							/** Delete accounts from temp table with which Broker cannot do business **/
							DELETE FROM 
								#AcctAvailability
							WHERE 
								AcctNbr IN (SELECT AcctNbr FROM #ctrBrokerAccountRestriction WHERE BrkId = @BrkID)
		
							--Eliminate accounts because of Collateral restriction
							/** Delete accounts from temp table which has collateral restriction **/
							DELETE FROM 
								#AcctAvailability
							WHERE 
								AcctNbr IN (SELECT AcctNbr FROM dbo.CtrAccountCollateralRestriction WHERE CollateralType = @LoanType)
						END

					-- Logic for Adjusting Quantity in '#AcctAvailability' table if 'ASE' Checkbox is checked from UI. Starts
					IF(@ASECheck = 1)
					BEGIN
						UPDATE
							#AcctAvailability
						SET
							UnitsLendableRem  =  UnitsLendableRem + ISNULL(LoanTbl.FaceAmount,0) + ISNULL(PendingTbl.FaceAmount,0) + ISNULL(LT.Units, 0),
							UnitsLendableRestrictedRem = UnitsLendableRestrictedRem + ISNULL(LoanTbl.FaceAmount,0) + ISNULL(PendingTbl.FaceAmount,0) + ISNULL(LT.Units, 0)
						FROM
							#AcctAvailability AcctAvailtbl
						LEFT JOIN 
							(
								SELECT
									AcctNbr,sum(FaceAmount) as FaceAmount
								FROM 
									GLOBALONE.DBO.Loan 
								WHERE 
									SecID = @SecId  AND IsStreetSide = 0 AND TxnType = 'L' AND isFuture = 0 AND AllocFlag != '0'
								GROUP BY AcctNbr
							)LoanTbl
						ON
							LoanTbl.AcctNbr = AcctAvailtbl.AcctNbr
						LEFT JOIN 
							(
								SELECT
									AcctNbr,sum(FaceAmount) as FaceAmount
								FROM 
									#PendingTbl 
								WHERE 
									SecID = @SecId  AND
									(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accounts
								GROUP BY AcctNbr
							)PendingTbl
						ON
							PendingTbl.AcctNbr = AcctAvailtbl.AcctNbr
						LEFT JOIN
							(
								SELECT
									AcctNbr, SUM(Units) as Units
								FROM
									dbo.LendingTransactions
								WHERE
									AsOfDate >= CONVERT(VARCHAR(10),GETDATE(),101) AND --Consider only present and future buys
									TheoSettleDate <= @SettlementDate AND ----SettleDate for buys should be <= loan settle date
									TransactionTypeSN = 'TB' AND--Consider only buys
									SecID = @SecId  
								GROUP BY
									AcctNbr
							) LT
						ON
							LT.AcctNbr = AcctAvailtbl.AcctNbr AND
							AcctAvailtbl.SecID = @SecId  AND
							(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accounts
					END -- end of IF(@ASECheck = 1)

					--The allocation logic uses variable UnitsLendableRestrictedRem in rest of the logic below
					--So assigning value of variable UnitsLendableRem to variable UnitsLendableRestrictedRem
					IF (@UseTraderLendable = 1)
					BEGIN
						UPDATE
							#AcctAvailability
						SET			
							UnitsLendableRestrictedRem = UnitsLendableRem
						WHERE
							SecID = @SecId
					END -- end of (@UseTraderLendable = 1)

					----GET Broker Limit from New table

					-- Usage Limits FOR ADL Accounts
					/** Get the remaining Ind Usage Conc limit for the selected BrkCrGrp **/
					SELECT 
						@UsageLimitRemIndUSD = LoanUsageIndemnifiedRemUSD 
					FROM 
						#ctrUsageConcLimit
					WHERE 
						BrkCrGrpID = @BrkCrGrpID
															
					/** Get the remaining Non-Ind Usage Conc limit for the selected BrkCrGrp **/
					SELECT 
						@UsageLimitRemNonIndUSD = LoanUsageNonIndemnifiedRemUSD 
					FROM 
						#ctrUsageConcLimit
					WHERE 
						BrkCrGrpID = @BrkCrGrpID


					--Logic added to adjust Broker Credit Limit, if 'Override Broker Credit Limit' CheckBox is checked from UI Starts..
					IF(@OverrideBrkCreditLmt = 1)
					BEGIN						
						SET @BrkCreditLimitRemIndUSD = @InifiniteVal
						SET @BrkCreditLimitRemNonIndUSD = @InifiniteVal
					END

					--Logic added to adjust Limit, for 'Loaned Securities Service loan'
					IF(@IsLoanedSecurityServiceLoan = 1)
					BEGIN	
						SET @BrkCreditLimitRemIndUSD = @InifiniteVal
						SET @BrkCreditLimitRemNonIndUSD = @InifiniteVal


						SET @UsageLimitRemIndUSD = @InifiniteVal
						SET @UsageLimitRemNonIndUSD = @InifiniteVal
					END
				

					/** Insert ADL Accounts into Working table **/			
					INSERT INTO #WorkingTbl 
					( 
						PoolId,
						AcctPriority,
						LendingLimitGrpID,
						AcctId,
						AcctNbr,
						AcctSN,
						BrkCrGrpID,
						BrkNbr,
						BrkID,
						AcctAvailibityRem,
						AcctAvailibityRestricted,
						LoopAvailability,
						PoolAvailability,
						BrkCreditLimitUSD,
						UsageCreditLimitUSD,
						MinAvailAndBCLAndUCLQty,
						LendingLimitUSD,
						ConcLimitUSD,
						MinLendLimAndConcLimUSD,
						MinOfAvailAndLLAndCLQty,
						MinOfAllLimitLoopQty,
						MinOfAllLimitPoolQty,
						UnitsLendable,
						UnUsedUnits,
						IsAcctUsed,
						SecID,
						WLDepository,
						ISOCountry,
						IsIndemnified,
						Price,
						MktValuePositionUSD,
						MktValueLoanUSD,
						PercentOnLoan,
						CanUseAcctForCleanUp,
						IsPoolUpdated,
						--isFITokyoRepo,
						isFITokyoSecLend,
						IsFISTBUSA,
						SecLoc,
						IsAgentDirectLending,
						AcctGrpID,
						SettlementDate,
						CCYCode,
						TriPartyGrpID
					)
					SELECT 
						@PoolCount, -- PoolId (OrgPoolPriority)
						1, -- AcctPriority -- dummy, will be updated after allocation algorithm
						avail.LendingLimitGrpID, -- LendingLimitGrpID
						avail.AcctId,
						avail.AcctNbr, -- AcctNbr
						avail.AcctSN,
						@BrkCrGrpID, -- BrkCrGrpID
						@BrkNbr, -- BrkNbr
						@BrkID, -- BrkID
						UnitsLendableRem, -- AcctAvailibityRem
						UnitsLendableRestrictedRem, -- AcctAvailibityRestricted
						0, -- LoopAvailability
						0, -- PoolAvailability
						0, -- BrkCreditLimitUSD
						@UsageLimitRemNonIndUSD, -- UsageCreditLimitUSD		-- ADL Accounts Are NON Indemnified Only
						0, -- MinAvailAndBCLAndUCLQty
						@InifiniteVal,--@CurrentLendingGrpLimit, -- LendingLimitUSD					
						@InifiniteVal,--@CurrentConcLimit, -- ConcLimitUSD
						@InifiniteVal, -- MinLendLimAndConcLimUSD
						0, -- MinOfAvailAndLLAndCLQty
						0, -- MinOfAllLimitLoopQty
						0, -- MinOfAllLimitPoolQty
						0, -- UnitsLendable
						0, -- UnUsedUnits
						0, -- IsAcctUsed
						SecID, --SecurityID
						WLDepository,
						ISOCountry,	
						avail.IsIndemnified,	
						@Price,
						0, -- MktValuePositionUSD
						0, -- MktValueLoanUSD
						0, -- PercentOnLoan,
						0, -- CanUseAcctForCleanUp
						0,  -- IsPoolUpdated
						--@TmpisFITokyoRepo,
						isFITokyoSecLend,--@TmpisFITokyoSecLend, --Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
						isFISTBUSA, --@TmpisFISTBUSA ,	--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
						@WLDepoCode,
						ISNULL(avail.IsAgentDirectLending,0),--IsAgentDirectLending
						avail.AcctGrpId,
						@SettlementDate,
						@CCYCode,
						avail.TriPartyGrpID
					FROM 
						#AcctAvailability avail
					WHERE 
						(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accounts


					--===============================================================================================================================================================================								
					--Set Prepay Indicator default vs MTM Broker Maintenance MTM New Loans setup 
					--===============================================================================================================================================================================
					UPDATE 
						TMP_WT
					SET 
						IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
														FROM #TMP_DEFPREPAY_MTM_NEW_LOANS AS TMP_DEF_PREPAY_MTMNEWLN
														WHERE TMP_DEF_PREPAY_MTMNEWLN.SettlementDay = TMTMBRK.MTMNewLoans ) THEN 1 
										ELSE 0 
										END
					FROM 
						#WorkingTbl AS TMP_WT
						INNER JOIN MTMBroker AS TMTMBRK
							ON  ( TMP_WT.BrkNbr = TMTMBRK.BrkNbr )   AND  
								( ISNULL(TMTMBRK.IsDeleted, 0) = 0 ) AND  
								( @AsOfDate BETWEEN TMTMBRK.EffectiveDateBegin AND TMTMBRK.EffectiveDateEnd )

					--===============================================================================================================================================================================
					--Set Prepay Indicator default vs MTM Broker Maintenance Loan Country Exception setup 
					--===============================================================================================================================================================================
					UPDATE 
						TMP_WT
					SET 
						IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
														FROM #TMP_DEFPREPAY_MTM_LNCTRY AS TMP_DEF_PREPAY_MTMLNCTRY
														WHERE TMP_DEF_PREPAY_MTMLNCTRY.SettlementDay = TLCE.SettlementDays ) THEN 1 
										ELSE 0 
										END
					FROM 
						#WorkingTbl AS TMP_WT
						INNER JOIN MTMBrokerLoanCountryException AS TLCE  
							ON  
								( TMP_WT.BrkNbr = TLCE.BrkNbr ) AND  
								( TMP_WT.CCYCode = TLCE.LoanExcepCCY )  AND  
								( ISNULL(TLCE.IsDeleted, 0) = 0 ) AND  
								( @AsOfDate BETWEEN TLCE.EffectiveDateBegin AND TLCE.EffectiveDateEnd )
					WHERE 
								( ISNULL(TMP_WT.IsPrePay,0) = 0 ) 
					--===============================================================================================================================================================================


				-- Updates Parameters from 	#WorkingTbl	for ADL Accounts
				
				/* Update LoopAvailability	*/
				UPDATE 
					wrk
				SET
					wrk.LoopAvailability = tmpAvail.LoopAvailability
				FROM
					#WorkingTbl wrk
				INNER JOIN
					(
					SELECT 
						SUM(avail.UnitsLendableRestrictedRem)  as LoopAvailability,avail.IsIndemnified
					FROM 
						#AcctAvailability avail
					WHERE 
						(ISNULL(avail.IsAgentDirectLending,0) = 1 AND ISNULL(avail.IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accounts
					GROUP BY
						avail.IsIndemnified 
					)tmpAvail  
				ON
					wrk.PoolId = @PoolCount AND
					(ISNULL(wrk.IsAgentDirectLending,0) = 1 AND ISNULL(wrk.IsIndemnified,0) != 1)	AND			-- Consider only ADL Non Indemnified accountAND
					wrk.IsIndemnified = tmpAvail.IsIndemnified 



				-- Update BrkCreditLimitUSD for ADL accounts 
				
				UPDATE wrk
				SET
					wrk.BrkCreditLimitUSD = ISNULL(ADL.crLimitADL,0)
				FROM 
					#WorkingTbl wrk
				LEFT JOIN
					#CtrAgentDirectLendingCreditLimit ADL
				ON
					wrk.BrkCrGrpID = ADL.BrkCrGrpID AND
					wrk.AcctGrpID = ADL.AcctGrpId
				WHERE
					(ISNULL(wrk.IsAgentDirectLending,0) = 1 AND ISNULL(wrk.IsIndemnified,0) != 1)	AND			-- Consider only ADL Non Indemnified accountAND
					wrk.PoolId = @PoolCount 


				-- Update MinAvailAndBCLAndUCLQty from #working Table
				-- This is Minimum of UsageCreditLimitUSD/@PricePerUnit, BrkCreditLimitUSD/@PricePerUnit, PoolAvailability 
				UPDATE wrk
				SET 
					MinAvailAndBCLAndUCLQty = tmpWork.MinAvailAndBCLAndUCLQty
				FROM
					#WorkingTbl wrk
				INNER JOIN
				(
					SELECT 
						RowId, MIN(MinLimit) AS MinAvailAndBCLAndUCLQty  FROM
						(
							SELECT 
								RowId,
								CONVERT(BIGINT,(ISNULL(BrkCreditLimitUSD,0)/@PricePerUnit)) as BrkCreditLimitUSDQty,
								CONVERT(BIGINT,(ISNULL(UsageCreditLimitUSD,0)/@PricePerUnit)) as UsageCreditLimitUSDQty, 
								LoopAvailability
							FROM 
								#WorkingTbl 
							WHERE  
								(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)   -- Consider only ADL Non Indemnified accounts
						)tmpQty
					UNPIVOT 
						(MinLimit FOR MinVal IN (tmpQty.BrkCreditLimitUSDQty, tmpQty.UsageCreditLimitUSDQty, tmpQty.LoopAvailability )) AS u
					GROUP BY RowId
				)tmpWork	
				ON
					(ISNULL(wrk.IsAgentDirectLending,0) = 1 AND ISNULL(wrk.IsIndemnified,0) != 1) AND   -- Consider only ADL Non Indemnified accounts
					wrk.RowId  = tmpWork.RowId AND
					wrk.PoolId = @PoolCount 


				-- Update MinOfAvailAndLLAndCLQty from #working Table
				-- This is Minimum of @TotalAvailForLendingLimitGrpQty (Availibility Against each LendingLimitGrpID --  Which is currently  'LoopAvailability' , LendingLimitUSD, ConcLimitUSD 
				UPDATE wrk
				SET 
					MinOfAvailAndLLAndCLQty = tmpWork.MinOfAvailAndLLAndCLQty
				FROM
					#WorkingTbl wrk
				INNER JOIN
					(
					SELECT 
						RowId, MIN(MinLimit) AS MinOfAvailAndLLAndCLQty 
					FROM 
						#WorkingTbl 
					UNPIVOT 
						( MinLimit FOR MinVal IN (LoopAvailability , LendingLimitUSD, ConcLimitUSD )) AS u
					WHERE  
						(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accountAND
					GROUP BY RowId
					) tmpWork
				ON
					(ISNULL(wrk.IsAgentDirectLending,0) = 1  AND  ISNULL(wrk.IsIndemnified,0) != 1)	 AND
					wrk.RowId  = tmpWork.RowId AND
					wrk.PoolId = @PoolCount 
					

				
				-- Update MinOfAllLimitLoopQty from #working Table 
				-- BASE ON 'IsIndemnified' Find out Minimum of 'MinAvailAndBCLAndUCLQty' and 'SumOfAvailAndLLAndCLQty' and Update it in Working Table.
				UPDATE wrk
				SET 
					MinOfAllLimitLoopQty = tmpWork.MinOfAllLimitIndLoopQty
				FROM
					#WorkingTbl wrk
				INNER JOIN
				(
				SELECT 
					 MIN(Limit) as MinOfAllLimitIndLoopQty , IsIndemnified
				FROM
				(
					SELECT 
						MIN(temp.MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty,
						SUM(temp.MinOfAvailAndLLAndCLQty) SumOfAvailAndLLAndCLQty,
						IsIndemnified
					FROM
						(
							SELECT MIN(MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty, MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty,IsIndemnified FROM #WorkingTbl 
							WHERE (ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)			-- Consider only ADL Non Indemnified accountAND
							GROUP BY LendingLimitGrpID,PoolId,IsIndemnified  HAVING PoolId = @PoolCount 
						) temp
					GROUP BY IsIndemnified
				) p
				UNPIVOT
				(
					Limit FOR BCLUCL IN 
					(
						MinAvailAndBCLAndUCLQty,
						SumOfAvailAndLLAndCLQty
					)
					
				) AS unpvt	
				group by IsIndemnified

				) tmpWork
				ON
					(ISNULL(wrk.IsAgentDirectLending,0) = 1 AND ISNULL(wrk.IsIndemnified,0) != 1)	AND			-- Consider only ADL Non Indemnified accountAND
					wrk.PoolId = @PoolCount AND
					wrk.IsIndemnified  = tmpWork.IsIndemnified

			
				-- Update MinOfAllLimitPoolQty  - FOR BOTH  ADL( Agent Direct Lending) AND NON-ADL Accounts
				UPDATE wrk
				SET 
					MinOfAllLimitPoolQty = tmpWork.MinOfAllLimitPoolQty
				FROM
					#WorkingTbl wrk
				INNER JOIN
				(
					SELECT SUM(tmp.tmpMinOfAllLimitLoopQty) as MinOfAllLimitPoolQty ,tmp.PoolId FROM
					(
						SELECT 
							DISTINCT w.MinOfAllLimitLoopQty tmpMinOfAllLimitLoopQty,w.PoolId
						FROM
							#WorkingTbl w
						WHERE
							w.PoolId = @PoolCount
					) tmp
					GROUP BY PoolId
				) -- Inner join end
				tmpWork
				ON
					wrk.PoolId = @PoolCount


				-- Update PoolAvailIndQty for all accoutns for that pool. - FOR BOTH  ADL( Agent Direct Lending) AND NON-ADL Accounts
				UPDATE 
					wrk
				SET
					wrk.PoolAvailability = tmpwork.TotalLoopAvailability
				FROM
					#WorkingTbl wrk
				INNER JOIN
					(
					SELECT 
						 SUM(w.AcctAvailibityRestricted)  as TotalLoopAvailability,w.PoolId
					FROM 
						#WorkingTbl w
					GROUP BY
						w.PoolId
					)tmpwork
				ON
					wrk.PoolId = tmpwork.PoolId AND
					wrk.PoolId = @PoolCount 

				SET @PoolCount = @PoolCount  + 1		
							
				END -- end of WHILE (@PoolCount <= @TotalPoolCount)  --- FOR ADL accounts Pool Loop ends

				/** End of Loop for ADL Accounts - Group 2**/


--select '#WorkingTbl - ADL - After Uptates' , * from #WorkingTbl		
			
				/***********  code changes for ADL  Accounts Ends *********/

					INSERT INTO
						#PoolPriority
					(
						PoolId,
						MinOfAllLimitPoolQty 
					)
					SELECT DISTINCT 
						PoolId,
						MinOfAllLimitPoolQty 
					FROM 
						#WorkingTbl
					ORDER BY 
						PoolId

					SELECT @PoolCount =  MIN(PoolId) FROM #PoolPriority
					SELECT @TotalPoolCount = MAX(PoolId) FROM #PoolPriority
					
					SET @CanProcessLoanReq = 0
					SET @SelectedPoolQty = 0

					/** Loop through all pools **/
					WHILE (@PoolCount <= @TotalPoolCount AND @CanProcessLoanReq = 0)
					BEGIN
						SET @PoolQty = NULL				
							
						/** Get MinOfAllLimitLoopQty of selected pool **/
						SELECT 
							@PoolQty = MinOfAllLimitPoolQty
						FROM 
							#PoolPriority
						WHERE
							PoolId = @PoolCount

--SELECT @PoolQty,@FaceAmount
						/** If selected pool has sufficient qty and availability is more then FaceAmount requirement then proceed **/
						
						IF (
								@PoolQty >= @FaceAmount AND 
								(@SelectedPoolQty = 0 OR @PoolQty > @SelectedPoolQty)
							)
						BEGIN
							SET @SelectedPoolQty = @FaceAmount --@PoolQty
							SET @SelectedPool = @PoolCount

							/** If Availability is more than FaceAmount then select the pool and exit from the while loop (do not check next pool) **/
							SET @CanProcessLoanReq = 1
						END

						SET @PoolCount = @PoolCount + 1

					END --END OF  WHILE (@PoolCount <= @TotalPoolCount AND @CanProcessLoanReq = 0)

					/** Set priority to 1 of selected pool only and 999 of other pools **/
					/*IF (@CanProcessLoanReq = 1)
					BEGIN
						DELETE FROM #WorkingTbl WHERE PoolID <> @SelectedPool -- deleting the other pool data because we got required pool.	
					END	*/	

--	SELECT @CanProcessLoanReq

					/** If loan requested qty can be booked using available pool qty then only book the loan else reject request **/
					IF (@CanProcessLoanReq = 1)
					BEGIN
					
						/** Get the account priority based on percent on loan **/
						TRUNCATE TABLE #AccountPercentOnLoan


						INSERT INTO 
							#AccountPercentOnLoan
						SELECT DISTINCT 
							work.LendingLimitGrpID,
							perOnLoan.AcctId,
							perOnLoan.AcctNbr,
							perOnLoan.PercentOnLoan
						FROM 
							#ctrAccountPercentOnLoan perOnLoan
						INNER JOIN 
							#WorkingTbl work 
						ON 
							work.AcctNbr = perOnLoan.AcctNbr AND
							work.ISOCountry = perOnLoan.ISOCountry AND
							work.PoolId = @SelectedPool 
						ORDER BY 
							perOnLoan.PercentOnLoan,
							perOnLoan.AcctId


						UPDATE 
							#WorkingTbl
						SET 
							AcctPriority = perOnLoan.AcctPriority
						FROM
							#WorkingTbl avail
						INNER JOIN 
							#AccountPercentOnLoan perOnLoan
						ON 
							perOnLoan.LendingLimitGrpID = avail.LendingLimitGrpID AND
							perOnLoan.AcctNbr = avail.AcctNbr 


						/* Get the values in variables **/
						SELECT TOP 1
							@PoolId = PoolId--,
							--@TmpisFITokyoRepo = isFITokyoRepo,
							--@TmpisFITokyoSecLend = isFITokyoSecLend,  --Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
							--@TmpisFISTBUSA = isFISTBUSA   --Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
						FROM 
							#WorkingTbl 
						WHERE 
							PoolId = @SelectedPool	
						ORDER BY 
							AcctPriority

						SELECT TOP 1							   
							@MinOfAllLimitPoolQty = MinOfAllLimitPoolQty,  
							--@Price = Price,
							@BrkCrGrpID = BrkCrGrpID
						FROM 
							#WorkingTbl 
						WHERE 
							PoolId = @PoolId 
						
						SET @LoanQtyPool = (CASE 
												WHEN @MinOfAllLimitPoolQty < @FaceAmount 
													THEN @MinOfAllLimitPoolQty 
												ELSE @FaceAmount 
											END)

						/**	Get the following:
							a.	Targeted no of loan allocations
							b.	Min shares amount for loan allocations **/

						/** find min share for total sum that can be lend **/
						SELECT 
							@MinShare = MinShares 
						FROM 
							dbo.MinShareAllocation
						WHERE 
							@LoanQtyPool >= MinRange AND 
							@LoanQtyPool <= MaxRange AND 
							BucketSecType = @BucketSecType


						/** find targeted no of accounts for allocation for total sum that can be lend **/
						SELECT 
							@TargetAccNo = TargetNoOfAccounts 
						FROM 
							dbo.TargetAccountAllocation
						WHERE 
							@LoanQtyPool >= MinRange AND 
							@LoanQtyPool <= MaxRange AND 
							BucketSecType = @BucketSecType

								
						/** Call allocation algorithm for selected pool to assign the priority to accounts i.e. A1,A3,A4,A2,A6,A5 
							-- Insert data into #WorkingTbl table
							-- Update the priority of AcctNbr in #WorkingTbl table using #WorkingTbl table **/


						/** Create AcctNbr xml for allocation algo **/
						SELECT @AcctNbrNbrXML = 
						( 
							SELECT 
								LendingLimitGrpID AS [row/@LendingLimitGrpID],
								AcctNbr AS [row/@AcctNbr],
								AcctAvailibityRestricted AS [row/@AvailableQty],
								CONVERT(BIGINT,MinLendLimAndConcLimUSD / @PricePerUnit) AS [row/@MinLendLimAndConcLimQty]
							FROM
								#WorkingTbl
							WHERE 
								PoolId = @PoolId 								
							FOR XML PATH('')
						)


						/** Create Account Percent on Loan xml for allocation algo **/
						SELECT @AccountPercentOnLoanXML = 
						( 
							SELECT DISTINCT
								APOL.ISOCountry AS [row/@ISOCountry],
								APOL.AcctID AS [row/@AcctID],
								APOL.AcctNbr AS [row/@AcctNbr],
								APOL.MktValuePositionUSD AS [row/@MktValuePositionUSD],
								APOL.MktValueLoanUSD AS [row/@MktValueLoanUSD],
								APOL.PercentOnLoan AS [row/@PercentOnLoan]
							FROM
								#ctrAccountPercentOnLoan APOL
							INNER JOIN 
								#WorkingTbl work
							ON 
								work.AcctNbr = APOL.AcctNbr AND									
								work.ISOCountry = APOL.ISOCountry AND
								--isFITokyoRepo = @TmpisFITokyoRepo AND
								--isFITokyoSecLend = @TmpisFITokyoSecLend AND		--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
								--isFISTBUSA = @TmpisFISTBUSA AND		--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
								work.PoolId = @PoolId
							FOR XML PATH('')
						)
								
--SELECT @AcctNbrNbrXML,@AccountPercentOnLoanXML,@MinShare,@Price,@TargetAccNo,@LoanQtyPool,@PoolId,@PoolCount

						TRUNCATE TABLE #AcctNbrPriorityXML --pool level

--select '@MinShare',@MinShare,'@PricePerUnit',@PricePerUnit,'@TargetAccNo',@TargetAccNo,'@LoanQtyPool',@LoanQtyPool

						/** Call allocation algorithm to allocate loan to different accounts **/
						EXEC [dbo].[p_AllocationToAccount_Algo] 
								@AcctNbrNbrXML,
								@AccountPercentOnLoanXML,
								@MinShare,
								@PricePerUnit,
								@TargetAccNo,
								@LoanQtyPool,
								@AcctNbrPriorityXML OUTPUT -- allocation algo output

						/** Insert output of allocation algo into a temp table which will be used to update working table **/
						INSERT INTO #AcctNbrPriorityXML 
						(
							AcctPriority,
							LendingLimitGrpID,
							AcctNbr,
							MktValueSecHeld,
							MktValueSecOnLoans,
							PercentOnLoan,
							UnitsLendable,
							UnUsedUnits,
							IsAcctUsed,
							IsQtyAvail
						)	
						SELECT	
							t.value('./@AcctPriority','INTEGER') AS AcctPriority,
							t.value('./@LendingLimitGrpID', 'INTEGER') AS LendingLimitGrpID ,
							t.value('./@AcctNbr', 'VARCHAR(12)') AS AcctNbr,
							t.value('./@MktValueSecHeld','BIGINT') AS MktValueSecHeld,
							t.value('./@MktValueSecOnLoansAfterAlloc','BIGINT') AS MktValueSecOnLoans,
							t.value('./@PercentOnLoan','DECIMAL(10,2)') AS PercentOnLoan,
							t.value('./@UnitsLendable', 'BIGINT') AS UnitsLendable,
							t.value('./@UnUsedUnits','BIGINT') AS UnUsedUnits,
							t.value('./@IsAcctUsed', 'BIT') AS IsAcctUsed,
							t.value('./@IsQtyAvail','BIT') AS IsQtyAvail
						FROM	
							@AcctNbrPriorityXML.nodes('//row') x(t)

--SELECT '#AcctNbrPriorityXML- Table',* FROM #AcctNbrPriorityXML

						/** Update the Account priority, total lendable units of each account in working temp table for further processing **/
						UPDATE 
							#WorkingTbl
						SET 
			--				AcctPriority = tmpPriority.AcctPriority, 
							UnitsLendable = tmpPriority.UnitsLendable, 
							UnUsedUnits	= tmpPriority.UnUsedUnits,
							IsAcctUsed = tmpPriority.IsAcctUsed,
							MktValuePositionUSD = tmpPriority.MktValueSecHeld,
							MktValueLoanUSD = tmpPriority.MktValueSecOnLoans,
							PercentOnLoan = tmpPriority.PercentOnLoan,
							CanUseAcctForCleanUp = CASE WHEN (tmpPriority.IsAcctUsed = 0 AND tmpPriority.IsQtyAvail = 0  AND tmpPriority.UnUsedUnits > 0) 
															THEN 1 
														ELSE (CASE WHEN (tmpPriority.IsQtyAvail = 1 AND tmpPriority.UnUsedUnits > 0)  
																	THEN 1 ELSE 0
																END
															)
													END
						FROM
							#WorkingTbl avail
						INNER JOIN 
							#AcctNbrPriorityXML tmpPriority
						ON 
							tmpPriority.LendingLimitGrpID = avail.LendingLimitGrpID AND
							tmpPriority.AcctNbr = avail.AcctNbr AND								
							avail.PoolId = @PoolId 

						
--SELECT * from #AcctNbrPriorityXML

--select ' Before Cleanup',* from #WorkingTbl	

						/** CleanUp Start : If loan request is met, then skip this step
							Qty can be increased If allocated units to account < requested units and if there are some units unused remaining in account 
							then allocate those unused units to satisfy the loan request (from high to low acc priority order) **/

						/** Get the total units allocated to loan request **/
						SELECT @ReqTotalUnitsLended = SUM(UnitsLendable) FROM #WorkingTbl

						/** Get the total unused units in each account for an loan request **/
				--		SELECT @ReqUnsedUnitsInPool  = SUM(UnUsedUnits) FROM #WorkingTbl WHERE CanUseAcctForCleanUp = 1

						IF (@ReqTotalUnitsLended < @FaceAmount) 
						BEGIN

							/** Insert all accounts which have unused units **/
							TRUNCATE TABLE #TempAcctCleanUp

							/** Insert all accounts which have unused units **/
							INSERT INTO #TempAcctCleanUp (
									PoolId,
									AcctPriority,
									LendingLimitGrpID,
									AcctNbr,
									AcctAvailibityRem,
									AcctAvailibityRestricted,
									MinLendLimAndConcLimUSD,
									MinAvailAndBCLAndUCLQty,
									UnitsLendable,
									UnUsedUnits,
									IsAcctUsedCleanUp,
									IsIndemnified)
							SELECT 
									PoolId,
									AcctPriority,
									LendingLimitGrpID,
									AcctNbr,
									AcctAvailibityRem,
									AcctAvailibityRestricted,
									MinLendLimAndConcLimUSD,
									MinAvailAndBCLAndUCLQty,
									UnitsLendable,
									UnUsedUnits,
									0, -- IsAcctUsedCleanUp
									IsIndemnified
							FROM 
								#WorkingTbl
							WHERE 
								CanUseAcctForCleanUp = 1 AND
								PoolId = @PoolId --AND
								--isFITokyoRepo = @TmpisFITokyoRepo AND
								--isFITokyoSecLend = @TmpisFITokyoSecLend AND	--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
								--isFISTBUSA = @TmpisFISTBUSA			--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
							ORDER BY 
								AcctPriority -- use high priority account first and then low priority accounts

--SELECT * FROM #TempAcctCleanUp
								
							SELECT 
								@ReqAcctCount = MIN(RowId) 
							FROM 
								#TempAcctCleanUp 

							/** Get the total account which have unused quantity in a pool **/
							SELECT 
								@ReqAcctTotal = MAX(RowId)
							FROM 
								#TempAcctCleanUp 
							
							/** Loop thru all the accounts in a pool **/
							WHILE (@ReqAcctCount <= @ReqAcctTotal AND @ReqTotalUnitsLended < @FaceAmount)
							BEGIN

								SET @ReqUnitsLendable = NULL
								SET @ReqUnitsLendedInPoolsLoop = NULL
								SET @UnitsLendedInLendingLimitGrp = NULL
								SET @MinLendLimAndConcLimUSD = NULL
								SET @MinAvailAndBCLAndUCLQty = NULL				
								
								SELECT
									@ReqUnUsedUnits = UnUsedUnits,
									@LendingLimitGrpID = LendingLimitGrpID,
									@IsIndemnified = IsIndemnified
								FROM 
									#TempAcctCleanUp
								WHERE 
									RowId = @ReqAcctCount

								/** Get the total units lended within the selected lending limit group, MinLendLimAndConcLimUSD and MinAvailAndBCLAndUCLQty of selected lending limit group **/
								SELECT 
									@UnitsLendedInLendingLimitGrp = SUM(UnitsLendable),
									@MinLendLimAndConcLimUSD = MIN(MinLendLimAndConcLimUSD), --MIN is used to return only one record. One acct lending group has only one MinLendLimAndConcLimUSD
									@MinAvailAndBCLAndUCLQty = MIN(MinAvailAndBCLAndUCLQty) --MIN is used to return only one record. One pool has only one MinAvailAndBCLAndUCLQty
								FROM
									#WorkingTbl -- this table has all the accounts which have unused untis for allocation 
								WHERE 
									PoolId = @PoolId AND 
									IsIndemnified = @IsIndemnified AND
									LendingLimitGrpID = @LendingLimitGrpID

								/** Get the total qty lended in a selected pools loop **/
								SELECT 
									@ReqUnitsLendedInPoolsLoop = SUM(UnitsLendable)
								FROM 
									#WorkingTbl -- this table has all the accounts which have been used in allocation
								WHERE 
									PoolId = @PoolId AND
									IsIndemnified = @IsIndemnified

								/** Find MIN of MinAvailAndBCLAndUCLRemQty, MinLendLimAndConcLimRemQty and UnUsedUnits **/
								SELECT @ReqUnitsLendable = 
										MIN(Limit)
								FROM 
								(
									SELECT
										(ISNULL(@MinAvailAndBCLAndUCLQty,0) - ISNULL(@ReqUnitsLendedInPoolsLoop,0)) MinAvailAndBCLAndUCLRemQty,
										((CONVERT(BIGINT,ISNULL(@MinLendLimAndConcLimUSD,0) / @PricePerUnit))- ISNULL(@UnitsLendedInLendingLimitGrp,0)) MinLendLimAndConcLimRemQty,
										(@FaceAmount - ISNULL(@ReqTotalUnitsLended,0)) RequestedUnits,
										ISNULL(@ReqUnUsedUnits,0) UnUsedUnits
								)p
								UNPIVOT
								(
									Limit FOR AcctountGroup IN (
											MinAvailAndBCLAndUCLRemQty,
											MinLendLimAndConcLimRemQty, 
