			  LoanValue, LoanValueFX, LoanValueUSD, CollValue, CollValueFX, CollValueUSD, 
			  CollValue AS CollDist, CollValueFX AS CollDistFX,  CollValueUSD AS CollDistUSD, 
			  AdjMktValue AS AdjMktValueDist, AdjMktValueFX AS AdjMktValueDistFX,  AdjMktValueUSD AS AdjMktValueDistUSD, 
			  FinalExposure, FinalExposureFX, FinalExposureUSD, BucketSecType,
			  LendingType, ClientFICCID, IsFICCMatched
		INTO #TMP_LOAN_COLLATERAL_DIST
		FROM dbo.f_CreateCollateralDetailsSchema() 
