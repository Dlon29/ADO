namespace MoBetterReports.CustomerReports.BusinessLogic
{
    public class CBJMonitoringReportBLL : ReportBuilder, IGenerateCustomerReportBLL
    {
        private static ILog _logger = LogManager.GetLogger(typeof(CBJMonitoringReportBLL));
        private ICustomerReportDataDAL _ObjCBJMonitoringReportDAL;

        public CBJMonitoringReportBLL(CBJMonitoringReportDAL ObjCBJMonitoringReportDAL)
        {
            _ObjCBJMonitoringReportDAL = ObjCBJMonitoringReportDAL;
        }

        #region Report Generation Logic
        /// <summary>
        /// This method will generate CBJ Monitoring report using component one and will return the path of report generated
        /// </summary>
        /// <param name="reportSetupID">CRMM Setup ID for the current report</param>
        /// <param name="batchRunDate">Date for which report is to be generated</param>
        /// <returns></returns>
        public ReportPath GenerateReport(int reportSetupID, DateTime batchRunDate, string fileType, string source, SourceInfo sourceInfo, int appID, List<ReportRequestParams> requestParams)
        {
            try
            {
                string ReportPath = null;
                ReportSource = (Source)Convert.ToInt32(source);
                FileType = fileType;
                if (ReportSource == Source.Package)
                { PackagePath = sourceInfo.SourceInformation; }

                DataSet ObjSqlDataSet = new DataSet();

                if (fileType.ToUpper() == Filetype.pdf.ToString().ToUpper())
                {
                    //Note: Getting template file name and package filene
                    if (_ObjCBJMonitoringReportDAL.GetReportInformation(reportSetupID, batchRunDate, ref ObjSqlDataSet, fileType.ToUpper(), source, appID, new List<ReportRequestParams> { new ReportRequestParams { ParamName = "SQL_IDENTIFIER", ParamType = "string", ParamValue = "GET_CRMM_REPORT_DETAILS" } }))
                    {
                        ReportPath = BuildPDF(ObjSqlDataSet, reportSetupID, batchRunDate, source);
                    }
                }
                else if (_ObjCBJMonitoringReportDAL.GetReportData(reportSetupID, batchRunDate, ref ObjSqlDataSet, fileType.ToUpper(), source))
                {
                    bool hasTemplate = ObjSqlDataSet.Tables[0].Columns.Contains("TemplateFileName") && !string.IsNullOrWhiteSpace(Convert.ToString(ObjSqlDataSet.Tables[0].Rows[0]["TemplateFileName"])) ? true : false;
                    if (fileType.ToUpper() == Filetype.xlsx.ToString().ToUpper() || hasTemplate)
                        ReportPath = BuildWorkBook(ObjSqlDataSet);
                    else if (fileType.ToUpper() == Filetype.csv.ToString().ToUpper())
                        ReportPath = BuildCSV(ObjSqlDataSet);
                }

                //return ReportPath;
                return new Shared.Infrastructure.ReportPath { ReportFile = ReportFileName, ReportFolderPath = ReportFolderPath };
            }
            catch (Exception ex)
            {
                _logger.ErrorFormat("Exception occured while generating CBJ Balance Monitoring Report. ReportSetupID: {0}. Error: " + ex, reportSetupID.ToString());
                throw new Exception(string.IsNullOrEmpty(ReportGenerationExceptions(ex.Message)) ? ex.Message : ReportGenerationExceptions(ex.Message), ex);
            }
        }

        /// <summary>
        /// This function is used to update the formula for excel formatting
        /// </summary>
        public override void CleanUpTouchUpSection(ref C1XLBook workBook, ref XLSheet workSheet, string sheet, string section, ref int rowInsertCount, ref int colInsertCount, DataSet dataSet, DataTable dtSection, int sectionRepeatCount, DataTable dtHeaderSection = null, List<string> dBDynamicColumns = null, int? sheetIndex = null)
        {
            if (section == "Section6")
            {
                var sectionKey = sheet + section;
                var getSectionPosition = reportSections[sectionKey].SectionValue.Split(','); // Get starting Row and Column position from config collection.
                int secRow = Convert.ToInt32(getSectionPosition[(int)Cell.Row]);
                int secColumn = Convert.ToInt32(getSectionPosition[(int)Cell.Column]);

                int formulaStartRow = rowInsertCount + secRow + 3; // Increment row index by 3. Updating formula after section 6 and section 6 contains 3 rows.
                var resultSetNo = reportSections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section).Select(p => p.Value.SectionResultSetNo).ToList();
                DataTable dataTable = dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 3]; // getting dataTable for Account becuase formula updation is based on No of account in the resultset. 

                var getAcctSectionPosition = reportSections[sheet + "Section5"].SectionValue.Split(',');
                int acctSecStartRow = Convert.ToInt32(getAcctSectionPosition[(int)Cell.Row]) + 1;
                int acctSecEndRow = rowInsertCount + secRow - 1;

                string formula = null;
                for (int i = 0; i < dataTable.Rows.Count; i++)
                {
                    formula = formula + ",SUMPRODUCT(--(" + GetExcelColumnName(secColumn) + acctSecStartRow + ":" + GetExcelColumnName(secColumn) + acctSecEndRow + "<" + GetExcelColumnName(secColumn + 1) + acctSecStartRow + ":" + GetExcelColumnName(secColumn + 1) + acctSecEndRow + "))";
                    secColumn += 3; // Increment columnIndex by 3 to pointing to next account.
                }

                formula = formula.TrimStart(','); // removing first comma from formula string.
                workSheet[formulaStartRow, 0].Formula = "IF(SUM(" + formula + ")>0,\"LIMIT EXCEEDED\",\"\")";


                // Conditional Formattings
                int startRow = Convert.ToInt32(getAcctSectionPosition[(int)Cell.Row]);
                int endRow = Convert.ToInt32(getAcctSectionPosition[(int)Cell.Row]) + rowInsertCount;
                int columnIndex = Convert.ToInt32(getSectionPosition[(int)Cell.Column]) + 1;

                var conditionalFormat1 = new XLConditionalFormatting();
                for (int i = 0; i < dataTable.Rows.Count; i++)
                {
                    conditionalFormat1.Ranges.Add(new XLRange(startRow, columnIndex, endRow, columnIndex));
                    columnIndex += 3; // Increment columnIndex by 3 to pointing to next account.
                }
                conditionalFormat1.Rules.Add(workSheet.ConditionalFormattings[0].Rules[0]);

                var conditionalFormat2 = new XLConditionalFormatting();
                conditionalFormat2.Ranges.Add(new XLRange(startRow, Convert.ToInt32(getAcctSectionPosition[(int)Cell.Column]), endRow, Convert.ToInt32(getAcctSectionPosition[(int)Cell.Column])));

                var rule = new XLConditionalFormattingRule();
                rule.Type = XLConditionalFormattingType.Expression;
                rule.Operator = XLConditionalFormattingOperator.NoComparision;
                rule.FirstFormula = reportConfigKeys["CondFormtRule1"].Replace("[RowNo]", Convert.ToString((formulaStartRow + 1)));
                rule.SecondFormula = null;
                rule.Pattern = new XLPatternFormatting() { BackColor = Color.Red };
                conditionalFormat2.Rules.Add(rule);

                workSheet.ConditionalFormattings.Add(conditionalFormat1);
                workSheet.ConditionalFormattings.Add(conditionalFormat2);
            }
        }
        #endregion

    }

}
