                            }
                            if (nReturnValue == 3)
                            {
                                IsValid = false;
                                _ErrorString.Append(System.IO.Path.GetFileName(fileName).ToString() + " - " + Common.GetMessage("RepoRequest", "DuplicateRequest"));
                                _show_error_row = _ErrorInfoBlank;

                                File.Delete(savedFileNamePath);
                            }
                            else
                            {
                                if (objDS.Tables.Count > 0)
                                {
                                    if (objDS.Tables[0].Rows.Count > 0)
                                    {
                                        DataRow[] drDuplicate = objDS.Tables[0].Select("isDuplicate = 1");
                                        if (drDuplicate.Count() > 0)
                                        {
                                            _show_error_row = _ErrorInfoBlank;
                                            _ErrorString.Append(Common.GetMessage("RepoRequest", "PartialDuplicateRequest"));
                                        }
                                    }
                                }

                                txtUploadFileShortName.Text = "";
                                if (objDS.Tables.Count > 1)
                                {
                                    if (objDS.Tables[1].Rows.Count > 0)
                                    {
                                        isRepoAck = Convert.ToBoolean(objDS.Tables[1].Rows[0]["IsRepoUploadAckRequired"]);
                                    }
                                }

                                if (isRepoAck)
                                {
                                    SendRepoUploadAck(objDS);
                                }
                            }

                            //deleteFile = _ExportPath + System.IO.Path.GetFileNameWithoutExtension(savedFileNamePath) + Path.GetExtension(savedFileNamePath) + "_saveas" + Path.GetExtension(savedFileNamePath);
                            //File.Delete(deleteFile);
                        }
                        else
                        {
                            IsValid = false;
                            txtUploadFileShortName.Text = string.Empty;
                            chkSingleUploadDuplicate.Checked = true;
                            _ErrorString.Append(Common.GetMessage("RepoRequest", "RepoRequestNotFound") + System.IO.Path.GetFileName(fileName) + "<br/>");
                        }
                    }

                    LoadUploadRepoTemplates();
                }
            }
            catch (Exception Exc)
            {
                _show_error_row = _ErrorInfoBlank;
                _ErrorString = new StringBuilder("");
                _ErrorString.Append("<a href = \"#\" OnClick = SetFocus('flUpload');>\n");
                _ErrorString.Append(Exc.Message);
                _ErrorString.Append("</a> <br>\n");
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                IsValid = false;
            }

            return IsValid;
        }

        /// <summary>
        /// Send email for Repo Acknowledgement
        /// </summary>
        /// <param name="DS_Result"></param>
        private void SendRepoUploadAck(DataSet DS_Result)
        {
            DataRow[] drRecp;
            ArrayList arrToList = null;
            ArrayList arrCcList = null;
            ArrayList arrBccList = null;
            ArrayList arrAttachment = null;
            string subject = string.Empty;
            string emailBody = string.Empty;

            try
            {
                if (DS_Result != null)
                {
                    if (DS_Result.Tables.Count > 1)
                    {
                        if (DS_Result.Tables[1].Rows.Count > 0)
                        {
                            //drRecp = DS_Result.Tables[1].Select("EmailTypeID =" + (int)Common.EmailType.To);
                            drRecp = DS_Result.Tables[1].DefaultView.ToTable(true, "EmailTO").Select();
                            arrToList = new ArrayList();
                            foreach (DataRow drEmail in drRecp)
                            {
                                arrToList.Add(drEmail["EmailTO"]);
                            }

                            //drRecp = DS_Result.Tables[1].Select("EmailTypeID = " + (int)Common.EmailType.CC);
                            drRecp = DS_Result.Tables[1].DefaultView.ToTable(true, "EmailCC").Select();
                            arrCcList = new ArrayList();
                            foreach (DataRow drEmail in drRecp)
                            {
                                arrCcList.Add(drEmail["EmailCC"]);
                            }

                            //drRecp = DS_Result.Tables[1].Select("EmailTypeID = " + (int)Common.EmailType.BCC);
                            drRecp = DS_Result.Tables[1].DefaultView.ToTable(true, "EmailBCC").Select();
                            arrBccList = new ArrayList();
                            foreach (DataRow drEmail in drRecp)
                            {
                                arrBccList.Add(drEmail["EmailBCC"]);
                            }
                        }

                        if (DS_Result.Tables[2].Rows.Count > 0)
                        {
                            subject = DS_Result.Tables[2].Rows[0]["Value"].ToString();
                            emailBody = DS_Result.Tables[2].Rows[1]["Value"].ToString();
                        }

                        Common.SendMailWithAttachment(arrToList, arrCcList, null, false, subject, emailBody, true, arrAttachment ,"",true);
                    }
                }
            }
            catch (Exception exc)
            {
                throw exc;
            }
        }

