        #region Aysnc Method to Log user Requests

        //Aysnc Method to Log user Requests.
        public static void AsyncLogUserAction(string moduleName, UserInfo.enmUserActionType type, NameValueCollection parameter)
        {
            int _ModuleId;
            StringBuilder strParam = new StringBuilder();

            //Get ModuleID from Module Name             
            if (!string.IsNullOrEmpty(moduleName))
            {
                _ModuleId = Common.getModuleId(moduleName);
            }
            else
            {
                _ModuleId = DEFAULTMODULEID;
            }

            //Retrieve user Name 
            string _userName = HttpContext.Current.Request.ServerVariables["LOGON_USER"];
            _userName = _userName.Substring(_userName.IndexOf(@"\") + 1);

            strParam = UserInfo.QuerystringXML(parameter);

            DelegateLogUserAction del = new DelegateLogUserAction(LogUserAction);
            Result = del.BeginInvoke(_userName, _ModuleId, type, strParam.ToString(), null, null);

            if (type == enmUserActionType.Authorization_Success)
                _logger.InfoFormat("Successfully accessed module. User: {0}, Module: {1}", _userName, moduleName);
            else if (type == enmUserActionType.Authorization_Failure)
                _logger.WarnFormat("Module access is denied due to restrictions on the user. User: {0}, Module: {1}", _userName, moduleName);

        }

