                            colCount = Convert.ToInt32(getSection5MergedPosition[(int)Cell.Column]);

                            workSheetTemplate.MergedCells.Add(secRow, secColumn, rowCount, colCount);
                        }

                        if (dBTempHeader.CopyFormat == "1")//Note: Taking format from config sheet
                        {
                            dBTempHeader.Format = sectionDBColumn[colIndex].Format.Clone();
                            workSheetTemplate[secRow, secColumn].Style = dBTempHeader.Format;
                        }

                        if (dBTempHeader.DBColumn == "<Formula>")//Note:  Write formula or data
                        {
                            if (!string.IsNullOrWhiteSpace(dBTempHeader.Formula))//Note: Get formula from config sheet
                            {
                                workSheetTemplate[secRow, secColumn].Formula = dBTempHeader.Formula.Replace("$", (secRow + 1).ToString());
                            }
                            else//Note: Copying formula in dummy row.
                            {
                                workSheetTemplate.CopyFormula(Convert.ToInt32(getSectionPosition[(int)Cell.Row]), secColumn, secRow, secColumn);
                            }

                        }
