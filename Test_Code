        /// <summary>
        /// This method will includes actual business logic to write the excel report using Component One.
        /// </summary>
        /// <param name="dataSet">Dataset includes all the data to generate the excel</param>
        /// <returns>This method returns the shared path for generated report</returns>
        public virtual string BuildWorkBook(DataSet dataSet)
        {
            string confPath = null;

            /*
            string incFilePath = Path.GetFullPath(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "..\\"));
            string templateFilePath = ConfigurationSettings.AppSettings["ReportTemplatePath"];
            //Get Template file name from DB
            string templatefileName = dataSet.Tables[0].Rows[0]["TemplateFileName"].ToString();
            //string templatefileFullName = Path.Combine(incFilePath, templateFilePath, "On_Loan_Balance_Report_Template.xlsx");
            string templatefileFullName = Path.Combine(incFilePath, templateFilePath, templatefileName);
            //get File name from DB
            //string fileName = "OnLoanBalanceReport.xlsx";
            string fileName = dataSet.Tables[0].Rows[0]["FileName"].ToString();
            string confFilePath = ConfigurationSettings.AppSettings["ReportConfirmationPath"]; // Shared path for storing the report file
            */

            string fileName = String.Empty, templatefileFullName = String.Empty, confFilePath = String.Empty;

            try
            {
                LoadPaths(dataSet.Tables[0], ref fileName, ref templatefileFullName, ref confFilePath);


                #region Workbook

                C1XLBook workBookTemplate = new C1XLBook();
                workBookTemplate.Load(templatefileFullName);

                if (!Directory.Exists(confFilePath))
                {
                    Directory.CreateDirectory(confFilePath);
                }

                #region Worksheets


                XLSheet workSheetConfig = workBookTemplate.Sheets[0];

                Dictionary<int, XLCell> config = GetConfiguration(workSheetConfig);
                Dictionary<string, Sections> sections = GetSectionsFromConfig(config[(int)ConfigSectionKey.SectionPosition], workSheetConfig);
                List<DBTempHeader> dBColumns = GetDBColumnFromConfig(config[(int)ConfigSectionKey.DBColPosition], workSheetConfig);
                Dictionary<string, string> configKeys = GetConfigKeyFromConfig(config[(int)ConfigSectionKey.ConfigKeyPosition], workSheetConfig);
                List<string> dBDynamicHeaders = null;

                reportConfig = config;
                reportSections = sections;
                reportDBColumns = dBColumns;
                reportConfigKeys = configKeys;

                // DataTable dtReportHeader = dataSet.Tables[0];
                // DataTable dtSection2 = dataSet.Tables[1];

                var Sheets = sections.Select(p => p.Value.SectionOfSheet).Distinct().ToList();

                RemoveOptionalWorksheet(dataSet, workBookTemplate, Sheets, 1);

                foreach (string sheet in Sheets)
                {
                    int sheetNo = Convert.ToInt16(sheet.Substring(5));
                    XLSheet workSheetTemplate = workBookTemplate.Sheets[sheetNo];
                    RenameWorksheet(ref workSheetTemplate, null);

                    int rowInsertCount = 0;
                    int colInsertCount = 0;

                    var section = sections.Where(s => s.Value.SectionOfSheet == sheet).Select(p => p.Value.SectionName).Distinct().ToList();

                    //for (int i = 0; i < section.Count; i++)
                    //{
                    //    var sectionType = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section[i]).Select(p => p.Value.SectionType).FirstOrDefault();
                    //    var resultSetNo = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section[i]).Select(p => p.Value.SectionResultSetNo);

                    //    if (sectionType == SectionType.Header.ToString())
                    //    {
                    //        WriteReportHeader(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, ref workSheetTemplate, ref rowInserCount);
                    //    }

                    //    if (sectionType == SectionType.Table.ToString())
                    //    {
                    //        WriteSection(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, ref workSheetTemplate, ref rowInserCount);
                    //    }
                    //}

                    for (int i = 0; i < section.Count; i++)
                    {
                        var sectionType = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section[i]).Select(p => p.Value.SectionType).FirstOrDefault();
                        var resultSetNo = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section[i]).Select(p => p.Value.SectionResultSetNo).ToList();

                        if (sectionType == SectionType.Header.ToString())
                        {
                            WriteReportHeader(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, ref workSheetTemplate, ref rowInsertCount);
                        }
                        else if (sectionType == SectionType.Table.ToString())
                        {
                            WriteSection(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount);
                        }
                        if (sectionType == SectionType.Label.ToString())
                        {
                            WriteLabelSection(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, ref workSheetTemplate, ref rowInsertCount);
                        }
                        else if (sectionType == SectionType.DynamicTable.ToString())
                        {
                            WriteSection(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount, dBDynamicHeaders);
                        }
                        else if (sectionType == SectionType.GroupTable.ToString())
                        {
                            WriteSectionForGroup(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount);
                        }
                        else if (sectionType == SectionType.DynamicGroupTable.ToString())
                        {
                            WriteSectionForGroup(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount, dBDynamicHeaders);
                        }
                        else if (sectionType == SectionType.DynamicHeader.ToString())
                        {
                            dBDynamicHeaders = WriteDynamicColHeader(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref colInsertCount);
                        }
                        else if (sectionType == SectionType.PivotHeader.ToString())
                        {
                            dBDynamicHeaders = WritePivotHeader(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref colInsertCount);
                        }
                        else if (sectionType == SectionType.PivotTable.ToString())
                        {
                            var pivotHeaderResultSetNo = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section[i]).Select(p => p.Value.PivotHeaderResultSetNo);
                            WriteSectionForPivotGroup(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], dataSet.Tables[Convert.ToInt16(pivotHeaderResultSetNo.First()) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount, dBDynamicHeaders);
                            CleanUpTouchUpSection(ref workBookTemplate, ref workSheetTemplate, sheet, section[i], ref rowInsertCount, ref colInsertCount, dataSet, dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], 0, dataSet.Tables[Convert.ToInt16(pivotHeaderResultSetNo.First()) - 1], dBDynamicHeaders);
                        }
                        else if (sectionType == SectionType.CopySection.ToString())
                        {
                            WriteCopySection(sheet, section[i], Convert.ToInt16(resultSetNo.First()), sections, dBColumns, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount);
                        }
                        else if (sectionType == SectionType.VerticalTable.ToString())
                        {
                            WriteSectionVertically(sheet, section[i], dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount);
                        }

                        //Tochup Section
                        if (sectionType != SectionType.PivotTable.ToString())
                        {
                            CleanUpTouchUpSection(ref workBookTemplate, ref workSheetTemplate, sheet, section[i], ref rowInsertCount, ref colInsertCount, dataSet, dataSet.Tables[Convert.ToInt16(resultSetNo.First()) - 1], 0, null, dBDynamicHeaders);
                        }
                    }

                    CleanUpTouchUpSheet(ref workBookTemplate, ref workSheetTemplate, sheet, dataSet);

                }

                #endregion

                CleanUpTouchUpWorkBook(ref workBookTemplate, dataSet);

                RemoveOptionalWorksheet(dataSet, workBookTemplate, Sheets, 2);
                // workBookTemplate.Sheets.RemoveAt(0);
                // Remove configration sheet from workbook
                RemoveWorksheet(ref workBookTemplate, 0);

                if (FileType == Filetype.csv.ToString())
                {
                    workBookTemplate.Sheets[0].SaveCsv(confFilePath + fileName);
                    //workBookTemplate.Save(confFilePath + fileName.Replace("csv", "xlsx"));
                    //C1XLBook xLBook = new C1XLBook();
                    //xLBook.Load(confFilePath + fileName.Replace("csv", "xlsx"));
                    //xLBook.Sheets[0].SaveCsv(confFilePath + fileName);
                }
                else if (FileType == Filetype.xls.ToString())
                {
                    if (CreateDir(Path.GetDirectoryName(confFilePath + fileName)) == true)
                    {
                        workBookTemplate.Save(confFilePath + fileName, FileFormat.Biff8);
                    }
                }
                else if (FileType == Filetype.xml.ToString())
                {
                    if (CreateDir(Path.GetDirectoryName(confFilePath + fileName)) == true)
                    {
                        workBookTemplate.Save(confFilePath + fileName, FileFormat.OpenXmlTemplate);

                    }
                }
                else
                {
                    if (CreateDir(Path.GetDirectoryName(confFilePath + fileName)) == true)
                    {
                        workBookTemplate.Save(confFilePath + fileName);
                    }
                }
               

                //ProtectWorkbook(fileName, confFilePath);
                //Note: Protect File
                bool protectFile = (dataSet.Tables[0].Columns.Contains("Code") && dataSet.Tables[0].Rows[0]["Code"].ToString() != "") ? true : false;
                bool zipReport = (dataSet.Tables[0].Columns.Contains("Zip") && dataSet.Tables[0].Rows[0]["Zip"].ToString() != "") ? Convert.ToBoolean(Convert.ToInt16(dataSet.Tables[0].Rows[0]["Zip"])) : false;
                bool IsChangeZipFolderName = dataSet.Tables[0].Columns.Contains("ZipFolderName") && dataSet.Tables[0].Rows[0]["ZipFolderName"].ToString() != "" ? true : false;

                if (protectFile && !zipReport)
                {
                    string password = dataSet.Tables[0].Rows[0]["Code"].ToString();
                    ProtectWorkbook(fileName, confFilePath, password);
                }
                //_helper.CompressFiles(confFilePath, fileName);
                //Note: Zip File

                if (zipReport)
                {
                    string zipFolderName = null;
                    if (IsChangeZipFolderName)
                    {
                        var zipFileName = dataSet.Tables[0].Rows[0]["ZipFolderName"].ToString();
                        var toDate = dataSet.Tables[0].Columns.Contains("ToDate") ? Convert.ToDateTime(dataSet.Tables[0].Rows[0]["ToDate"].ToString()) : DateTime.Now;
                        zipFolderName = GetZipFileNameNFormat(zipFileName, IsGeneric, FileType.ToLower(), toDate);
                    }
                    string password = (protectFile ? dataSet.Tables[0].Rows[0]["Code"].ToString() : string.Empty);
                    CompressFileNFolder(confFilePath, fileName, password, zipFolderName);
                    fileName = zipFolderName != null ? zipFolderName : fileName;
                }

                #endregion Workbook

                ReportFileName = (zipReport ? Path.ChangeExtension(fileName, "Zip") : fileName);
                ReportFolderPath = confFilePath;

                confPath = confFilePath + fileName;
                return confPath;
            }
            catch (Exception EX)
            {
                throw new Exception(EX.Message + ReportGenerationExceptions(EX.Message), EX);
            }
        }

        public void RemoveOptionalWorksheet(DataSet dataSet, C1XLBook workBookTemplate, List<string> Sheets, int deleteFrom)
        {
            //Note: Remove optional worksheet.
            try
            {
                if (dataSet.Tables[0].Columns.Contains("OptionalWS1") && Convert.ToBoolean(dataSet.Tables[0].Rows[0]["OptionalWS1"]) == false)
                {
                    if (deleteFrom == 1)
                    {
                        if (Sheets.Count == 2)
                        {
                            Sheets.Remove(Sheets.Last());
                        }
                        else
                        {
                            Sheets.Remove(Sheets[Sheets.Count - 2]);
                        }
                    }

                    if (deleteFrom == 2)
                    {
                        if ((workBookTemplate.Sheets.Count - 1) == 2)
                        {
                            workBookTemplate.Sheets.RemoveAt(workBookTemplate.Sheets.Count - 1);
                        }
                        else
                        {
                            workBookTemplate.Sheets.RemoveAt(workBookTemplate.Sheets.Count - 2);
                        }
                    }
                }
                if (dataSet.Tables[0].Columns.Contains("OptionalWS2") && Convert.ToBoolean(dataSet.Tables[0].Rows[0]["OptionalWS2"]) == false)
                {
                    if (deleteFrom == 1)
                    {
                        Sheets.Remove(Sheets.Last());
                    }
                    else if (deleteFrom == 2)
                    {
                        workBookTemplate.Sheets.RemoveAt(workBookTemplate.Sheets.Count - 1);
                    }
                }
            }
            catch (Exception)
            {

                throw;
            }
        }

        /// <summary>
        /// This method will includes actual business logic to write the CSV report using Component One.
        /// </summary>
        /// <param name="dataSet">Dataset includes all the data to generate the excel</param>
        /// <returns>This method returns the shared path for generated report</returns>
        public virtual string BuildCSV(DataSet dataSet)
        {
            try
            {
                string confPath = null;
                string fileName = String.Empty, confFilePath = String.Empty;
                LoadPathForCSV(dataSet.Tables[0], ref fileName, ref confFilePath);

                if (CreateDir(Path.GetDirectoryName(confFilePath + fileName)) == true)
                {
                    ToCSV(dataSet, confFilePath + fileName);
                }

                ReportFileName = fileName;
                ReportFolderPath = confFilePath;
                confPath = confFilePath + fileName;

                return confPath;
            }
            catch (Exception)
            {

                throw;
            }
        }

        /// <summary>
        /// This method will includes actual business logic to generate PDF Report.
        /// </summary>
        /// <param name="dataTable">DataTable includes all the data to generate the report</param>
        /// <param name="reportSetupID">ReportSetupID to Generate report</param>
        /// <param name="batchRunDate">BatchRunDate to run the report</param>
        /// <returns>This method returns the shared path for generated report</returns>
        public virtual string BuildPDF(DataSet dataSet, int reportSetupID, DateTime batchRunDate, string source = "0", bool IsGeneric = false, List<ReportRequestParams> requestParams = null)
        {
            try
            {
                string confPath = null, sXportPath = null;
                bool reportSuccess = false;
                ReportDriver reportDriver = new ReportDriver();

                string fileName = String.Empty, templatefileFullName = String.Empty, confFilePath = String.Empty;

                LoadPaths(dataSet.Tables[0], ref fileName, ref templatefileFullName, ref confFilePath);

                sXportPath = confFilePath + fileName;
                //string _strXMLAcctSet = "<root><acct ID=\"1\" /><acct ID=\"2\" /><acct ID=\"3\" /><acct ID=\"4\" /><acct ID=\"5\" /><acct ID=\"6\" /><acct ID=\"7\" /></root>";

                if (CreateDir(Path.GetDirectoryName(sXportPath)) == true)
                {
                    reportSuccess = reportDriver.PrintReport(reportSetupID, batchRunDate, templatefileFullName, sXportPath, source, IsGeneric, requestParams);
                }
                //reportSuccess = reportDriver.PrintReport(reportSetupID, DateTime.Now, templatefileFullName, sXportPath);

                if (!reportSuccess)
                {
                    string ErrStr = null;
                    if (reportDriver.Errors.Count > 0)
                    {
                        ErrStr = reportDriver.Errors[0].Message;
                    }
                    throw new Exception(ErrStr); //"Error in creating report: " + ReportTitle) ;
                }

                bool protectFile = (dataSet.Tables[0].Columns.Contains("Code") && dataSet.Tables[0].Rows[0]["Code"].ToString() != "") ? true : false;
                bool zipReport = (dataSet.Tables[0].Columns.Contains("Zip") && dataSet.Tables[0].Rows[0]["Zip"].ToString() != "") ? Convert.ToBoolean(Convert.ToInt16(dataSet.Tables[0].Rows[0]["Zip"])) : false;

                //Note: Protect File and Zip File
                if (zipReport)
                {
                    string password = (protectFile ? dataSet.Tables[0].Rows[0]["Code"].ToString() : string.Empty);
                    CompressFileNFolder(confFilePath, fileName, password);
                }

                ReportFileName = (zipReport ? Path.ChangeExtension(fileName, "Zip") : fileName);
                ReportFolderPath = confFilePath;

                confPath = sXportPath;

                return confPath;
            }
            catch (Exception)
            {
                throw;
            }
        }

