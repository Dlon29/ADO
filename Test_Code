        /// <summary>
        /// This method will get data to generate excel report
        /// </summary>
        private void GetExcelExtract()
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            SqlDataReader dr = null;

            string[] SqlCondition = null;
            string CountryList = string.Empty;
            string ReallocateStatusList = string.Empty;
            string RecallStatusList = string.Empty;

            _ErrorString = new StringBuilder();
            MethodName = "GetExcelExtract()";

            try
            {
                if (clsDB.Open() == false)
                    return;

                clsReader.Connection = clsDB.Connection;

                string status = "";

                if (chkNothing.Checked)
                {
                    status = status + "1" + "|";
                }
                if (chkReallocate.Checked)
                {
                    status = status + "2" + "|";
                }
                if (chkPullBack.Checked)
                {
                    status = status + "3" + "|";
                }


                for (int i = 0; i < lstCountry2.Items.Count; i++)
                    CountryList = CountryList + lstCountry2.Items[i].Value + "|";

                //If check box is selected from frot end then only maintain the ReallocateStatus List
                if (chkReallocate.Checked)
                {
                    for (int i = 0; i < lstReallocateStatus.Items.Count; i++)
                    {
                        if (lstReallocateStatus.Items[i].Selected)
                            ReallocateStatusList = ReallocateStatusList + lstReallocateStatus.Items[i].Value + "|";
                    }
                }
                else
                    ReallocateStatusList = string.Empty;


                //If check box is selected from frot end then only maintain the RecallStatus List
                if (chkPullBack.Checked)
                {
                    for (int i = 0; i < lstRecallStatus.Items.Count; i++)
                    {
                        if (lstRecallStatus.Items[i].Selected)
                            RecallStatusList = RecallStatusList + lstRecallStatus.Items[i].Value + "|";
                    }
                }
                else
                    RecallStatusList = string.Empty;


                SqlCondition = new string[15] { "", "", "", "", "", "", "", "", "", "", "", "", "", "", "" };
                clsReader.SqlIdentifier = SqlIdentifier.SalesRecon_Report.ToString();

                SqlCondition[0] = this.txtSRRBatchRunDate.Text;
                SqlCondition[1] = ""; //AcctID
                SqlCondition[2] = "";// _AccountNbr;
                SqlCondition[3] = ""; //SecID
                SqlCondition[4] = "";// _secCode.Trim();
                SqlCondition[5] = "";// _TxnRefNbr.Trim();//LoanNbr
                SqlCondition[6] = "";// txtReallocationqty.Text.Replace(",", "").Trim();//ReallocaionQty
                SqlCondition[7] = this.cboBucketSecType.SelectedValue == "0" ? "" : this.cboBucketSecType.SelectedValue;// _secType.Trim(); //
                SqlCondition[8] = ""; //ModifiedBy
                SqlCondition[9] = ""; //SalesDataXML
                SqlCondition[10] = GetXML(status, "SaleStatus").ToString(); //SaleStatus
                SqlCondition[11] = CountryList.Length > 0 ? GetXML(CountryList, "Country").ToString() : string.Empty; // CountryList;
                SqlCondition[12] = ReallocateStatusList.Length > 0 ? GetXML(ReallocateStatusList, "ReallocateStatus").ToString() : string.Empty; // ReallocateStatusList;
                SqlCondition[13] = RecallStatusList.Length > 0 ? GetXML(RecallStatusList, "RecallStatus").ToString() : string.Empty; // RecallStatusList;
                SqlCondition[14] = ddlSaleCategoty.SelectedValue; // SaleCategory;


                if (clsReader.GetData(ref dr, SqlObjects.p_ETI_Reallocation, SqlCondition) == false)
                    return;

                Lava.ExcelTemplates.SalesRecon gxst = new Lava.ExcelTemplates.SalesRecon(dr);
                STBUSA.Excel.ExcelReportGenerator erg = new STBUSA.Excel.ExcelReportGenerator(gxst);
                byte[] temp = erg.Generate();

                if (temp != null)
                {
                    IsUI = false;
                    _show_error_row = "NONE";
                    Response.Clear();
                    Response.ClearContent();
                    Response.ClearHeaders();
                    Response.ContentType = "application/xls";
                    Response.AppendHeader("Content-Disposition", "attachment;filename=" + System.DateTime.Now.ToString("yyyyMMdd") + "_SalesRecon.xls");
                    Response.BinaryWrite(temp);
                    Response.Flush();
                }

                else
                {
                    Common.WriteJavascript("alert('" + Common.GetMessage("Common", "NoRecordsFound") + "');");
                }

            }
            catch (Exception Exc)
            {
                Response.ClearContent();
                Response.ContentType = "text/html";
                Information clsInfo = new Information();
                clsInfo.ErrNum = 5000;
                clsInfo.ErrStr = Exc.Message;
                clsInfo.ErrStack = Exc.StackTrace;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                Server.Transfer(Common.INFORMATIONPAGEURL, true);
                return;
            }
            finally
            {
                dr = null;
                clsReader.Dispose();
                clsDB.Dispose();
            }
        }

        /// <summary>
        /// This method will move selected item from one list to other list
        /// </summary>
        /// <param name="source"></param>
        /// <param name="dest"></param>
        /// <param name="ActionType"></param>
        private void MoveSelItems(ListBox source, ListBox dest, string ActionType)
        {
            List<ListItem> remove = new List<ListItem>();

            foreach (ListItem item in source.Items)
            {
                if (item.Selected && item.Value != "0" && (ActionType == "OL" || ActionType == "OR"))
                {
                    dest.Items.Add(item);
                    remove.Add(item);
                }
                else if (item.Value != "0" && (ActionType == "AL" || ActionType == "AR"))
                {
                    dest.Items.Add(item);
                    remove.Add(item);
                }
            }

            foreach (var item in remove)
            {
                source.Items.Remove(item);
            }


        }

