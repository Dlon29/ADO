public struct XLConditionalFormattingType
{
    private readonly NativeXLConditionalFormattingType _value;

    private XLConditionalFormattingType(NativeXLConditionalFormattingType value)
    {
        _value = value;
    }

    public static readonly XLConditionalFormattingType Expression =
        new XLConditionalFormattingType(NativeXLConditionalFormattingType.Expression);

    public static implicit operator NativeXLConditionalFormattingType(
        XLConditionalFormattingType value)
    {
        return value._value;
    }

    public static implicit operator XLConditionalFormattingType(
        NativeXLConditionalFormattingType value)
    {
        return new XLConditionalFormattingType(value);
    }
}




