                var appName = Globals.appInfo.Where(m => m.AppID == AppID).Select(m => m.AppName).ToList()[0];
                fileNameNFormat = toDate.ToString("yyyyMMdd") + "_" + appName + "_" + fileName + "." + fileType;
            }

            return fileNameNFormat;
        }

        /// <summary>
        /// This method is used to get the zip file name with format based on format passed by report setup
        /// </summary>
        /// <param name="fileName">fileName contains File name/Report name to generate report</param>
        /// <param name="isGeneric">isGeneric is used to identify report type generic or not</param>
        /// <param name="fileType">fileType contains the format (xlsx, csv and pdf)</param>
        /// <returns></returns>
        public virtual string GetZipFileNameNFormat(string zipFileName, bool isGeneric, string fileType, DateTime toDate)
        {
            string zipFileNameNFormat = string.Empty;
            var date = string.Empty;
            var pattern = @"\[(.*?)\]";

            if (isGeneric == false && ReportSource == Source.Package)
            {
                if (Regex.IsMatch(Path.GetFileNameWithoutExtension(zipFileName), pattern))
                {
                    var zipFileNDateFormat = Regex.Matches(Path.GetFileNameWithoutExtension(zipFileName), pattern)[0].Groups[1].Value.ToLower().Replace("m", "M");
                    date = toDate.ToString(zipFileNDateFormat);
                    DateTime dateTime;
                    if (DateTime.TryParseExact(date, zipFileNDateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out dateTime))
                        zipFileNameNFormat = Regex.Replace(Path.GetFileNameWithoutExtension(zipFileName), pattern, date) + "." + fileType;
                }
                else
                    zipFileNameNFormat = Path.GetFileNameWithoutExtension(zipFileName) + "." + fileType;
            }
            else if (isGeneric == false && ReportSource == Source.UI)
            {
                if (Regex.IsMatch(Path.GetFileNameWithoutExtension(zipFileName), pattern))
                    zipFileNameNFormat = Regex.Replace(Path.GetFileNameWithoutExtension(zipFileName), pattern, toDate.ToString("yyyyMMdd")) + "." + fileType;
                else
                    zipFileNameNFormat = Path.GetFileNameWithoutExtension(zipFileName) + "." + fileType;
            }

            return zipFileNameNFormat;
        }

