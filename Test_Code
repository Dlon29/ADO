									UnUsedUnits = CP.AcctAvailibityRestricted -  (work.UnitsLendable + ISNULL(@ReqUnitsLendable,0)), 
									PercentOnLoan = (CONVERT(DECIMAL,(MktValueLoanUSD + (@PricePerUnit * ISNULL(@ReqUnitsLendable,0)))) / CONVERT(DECIMAL,MktValuePositionUSD)), 
