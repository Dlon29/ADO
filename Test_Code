						work.AcctNbr = perOnLoan.AcctNbr AND
						work.ISOCountry = perOnLoan.ISOCountry AND
						work.PoolId = @SelectedPool 
					ORDER BY 
						perOnLoan.PercentOnLoan,
						perOnLoan.AcctId

					UPDATE 
						#WorkingTbl
					SET 
						AcctPriority = perOnLoan.AcctPriority
					FROM
						#WorkingTbl avail
					INNER JOIN 
						#AccountPercentOnLoan perOnLoan
					ON 
						perOnLoan.LendingLimitGrpID = avail.LendingLimitGrpID AND
						perOnLoan.AcctNbr = avail.AcctNbr 

				--SELECT * FROM #WorkingTbl order BY AcctPriority
					
					/* Get the values in variables **/
					SELECT TOP 1
						@PoolId = PoolId
					FROM 
						#WorkingTbl 
					WHERE 
						PoolId = @SelectedPool	
					ORDER BY 
						AcctPriority

					SELECT TOP 1							   
						@MinOfAllLimitPoolQty = MinOfAllLimitPoolQty,  
						@Price = Price,
						@BrkCrGrpID = BrkCrGrpID
					FROM 
						#WorkingTbl 
					WHERE 
						PoolId = @PoolId 
						
					SET @LoanQtyPool = (CASE 
											WHEN @MinOfAllLimitPoolQty < @FaceAmount 
												THEN @MinOfAllLimitPoolQty 
											ELSE @FaceAmount 
										END)

					/**	Get the following:
						a.	Targeted no of loan allocations
						b.	Min shares amount for loan allocations **/

					/** find min share for total sum that can be lend **/
					SELECT 
						@MinShare = MinShares 
					FROM 
						dbo.MinShareAllocation
					WHERE 
						@LoanQtyPool >= MinRange AND 
						@LoanQtyPool <= MaxRange AND 
						BucketSecType = @BucketSecType

					/** find targeted no of accounts for allocation for total sum that can be lend **/
					SELECT 
						@TargetAccNo = TargetNoOfAccounts 
					FROM 
						dbo.TargetAccountAllocation
					WHERE 
						@LoanQtyPool >= MinRange AND 
						@LoanQtyPool <= MaxRange AND 
						BucketSecType = @BucketSecType
							
					/** Call allocation algorithm for selected pool to assign the priority to accounts i.e. A1,A3,A4,A2,A6,A5 
						-- Insert data into #WorkingTbl table
						-- Update the priority of AcctNbr in #WorkingTbl table using #WorkingTbl table **/

					/** Create AcctNbr xml for allocation algo **/
					SELECT @AcctNbrNbrXML = 
					( 
						SELECT 
							LendingLimitGrpID AS [row/@LendingLimitGrpID],
							AcctNbr AS [row/@AcctNbr],
							AcctAvailibityRestricted AS [row/@AvailableQty],				
							CONVERT(BIGINT,MinLendLimAndConcLimUSD / @Price) AS [row/@MinLendLimAndConcLimQty]
						FROM
							#WorkingTbl
						WHERE 
							PoolId = @PoolId AND
							DivRate = ( @DivRateAlloc * 100) 								
						FOR XML PATH('')
					)
							
					/** Create Account Percent on Loan xml for allocation algo **/
					SELECT @AccountPercentOnLoanXML = 
					( 
						SELECT DISTINCT
							APOL.ISOCountry AS [row/@ISOCountry],
							APOL.AcctID AS [row/@AcctID],
							APOL.AcctNbr AS [row/@AcctNbr],
							APOL.MktValuePositionUSD AS [row/@MktValuePositionUSD],
							APOL.MktValueLoanUSD AS [row/@MktValueLoanUSD],
							APOL.PercentOnLoan AS [row/@PercentOnLoan]
						FROM
							#ctrAccountPercentOnLoan APOL
						INNER JOIN 
							#WorkingTbl work
						ON 
							work.AcctNbr = APOL.AcctNbr AND
							work.ISOCountry = APOL.ISOCountry AND									
							work.PoolId = @PoolId--@PoolCount
						FOR XML PATH('')
					)
							
--SELECT @AcctNbrNbrXML,@AccountPercentOnLoanXML,@MinShare,@Price,@TargetAccNo,@LoanQtyPool,@PoolId,@PoolCount
					TRUNCATE TABLE #AcctNbrPriorityXML --loop level

					/** Call allocation algorithm to allocate loan to different accounts **/
					EXEC [dbo].[p_AllocationToAccount_Algo] 
							@AcctNbrNbrXML,
							@AccountPercentOnLoanXML,
							@MinShare,
							@Price,
							@TargetAccNo,
							@LoanQtyPool,
							@AcctNbrPriorityXML OUTPUT -- allocation algo output

