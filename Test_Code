        protected void chkRecall_CheckedChanged(object sender, EventArgs e)
        {
            string chkBoxID = ((CheckBox)sender).ID;
            TextBox txtSharesToRecall = null;
            MethodName = "chkRecall_CheckedChanged()";

            try
            {
                if (chkBoxID == "chkExcludeRecall")
                {
                    CheckBox chkExcludeRecallSender = (System.Web.UI.WebControls.CheckBox)sender;
                    //chkExcludeRecall.Checked = true;

                    DataGridItem dgi = chkExcludeRecallSender.Parent.Parent as DataGridItem;

                    //Added by Serina on 18/07/2014 for checking or unchecking all the rows when single row is checked/unchecked
                    dgLoanRecall = dgi.Parent.Parent as DataGrid;

                    if (dgi != null)
                    {
                        for (int i = 0; i < dgLoanRecall.Items.Count; i++)
                        {
                            //Added by Serina on 18/07/2014 for checking or unchecking all the rows when single row is checked/unchecked
                            CheckBox chkCreateRecall = (CheckBox)dgLoanRecall.Items[i].Cells[(int)dgLoanRecallMapping.chkCreateRecall].FindControl("chkCreateRecall");
                            CheckBox chkExcludeRecall = (CheckBox)dgLoanRecall.Items[i].Cells[(int)dgLoanRecallMapping.chkExcludeRecall].FindControl("chkExcludeRecall");

                            if (chkExcludeRecallSender != null)
                            {
                                if (chkExcludeRecallSender.Checked)
                                {
                                    chkExcludeRecall.Checked = true;
                                    chkCreateRecall.Checked = false;
                                }
                                else //Added code by Neelima on 18-March-2014
                                {
                                    chkExcludeRecall.Checked = false;
                                    chkCreateRecall.Checked = true;
                                }
                            }

                            //Added by Serina on 18/07/2014 for checking or unchecking all the rows when single row is checked/unchecked
