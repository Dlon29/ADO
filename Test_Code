                            Label lblSecID = (Label)dgi.Cells[(int)dgLoanRecallMapping.SecId].FindControl("lblSecID");
                            Label lblQtyPendingToRecall = (Label)dgi.Cells[(int)dgLoanRecallMapping.QtyPendingToRecall].FindControl("lblQtyPendingToRecall");

                            if (lblQtyPendingToRecall != null)
                                QtyPendingToRecall += Convert.ToInt64(lblQtyPendingToRecall.Text.Replace(",", ""));

                            dgLoanData = (DataGrid)dgi.Cells[(int)dgLoanRecallMapping.SecId].FindControl("dgLoanData");

                            if (dgLoanData != null && chkCreateRecall.Checked)
                            {

                                string prvsProdCat = string.Empty;
                                Int64 TotalQtyRecalledSale = 0;

                                for (int iLoanDataRowCount = 0; iLoanDataRowCount < dgLoanData.Items.Count; iLoanDataRowCount++)
                                {
