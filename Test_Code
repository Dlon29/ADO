            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.FaceAmount.ToString());
            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.Other.ToString());

            try
            {
                if (flUpload.PostedFile.FileName == "")
                {
                    _show_error_row = _ErrorInfoBlank;
                    _ErrorString.Append("<a href = \"#\" OnClick = SetFocus('flUpload');>\n");
                    _ErrorString.Append(Common.GetMessage("RepoRequest", "SelectFileToUpload"));
                    _ErrorString.Append("</a> <br>\n");
                    IsValid = false;
                }

                if (IsValid == true)
                {
                    string fileName = flUpload.PostedFile.FileName;

                    string _ExportPath = STBUSA_APP_FILES + clsUI.NTUserName + @"\";


                    _ExportPath += DateTime.Now.ToString("MM-dd-yyyy") + @"\";

                    if (!Directory.Exists(_ExportPath))
                        System.IO.Directory.CreateDirectory(_ExportPath);

                    string savedFileNamePath = _ExportPath + System.IO.Path.GetFileNameWithoutExtension(fileName) + "_" + DateTime.Now.ToString("HHmmss") + System.IO.Path.GetExtension(fileName);

                    flUpload.PostedFile.SaveAs(savedFileNamePath);
                    flUpload.PostedFile.InputStream.Flush();
                    flUpload.PostedFile.InputStream.Close();
                    flUpload.PostedFile.InputStream.Dispose();

                    _logger.InfoFormat("Successfully saved a copy of the Repo request file. Filename: {0}", savedFileNamePath);

                    Byte[] bytes; 
                    using (FileStream fs = new FileStream(savedFileNamePath, FileMode.Open, FileAccess.Read))
                    {
                        using (BinaryReader br = new BinaryReader(fs))
                        { 
                            bytes = br.ReadBytes((Int32)fs.Length);
                            br.Close();
                        }
                        fs.Close();
                    }
                    //Read Excel Data

                    using (C1XLBook wbExcel = new C1XLBook())
                    {
                        if (Path.GetExtension(savedFileNamePath) == ".xls")
                        {
                            wbExcel.Load(savedFileNamePath, FileFormat.Biff8);
                        }
                        else
                        {
                            wbExcel.Load(savedFileNamePath, FileFormat.OpenXml);
                        }

                        NoOfSheets = wbExcel.Sheets.Count;
                        decimal n;

                        for (int i = 0; i < NoOfSheets; i++)  // Loop For Sheets
                        {
                            XLSheet sheet = wbExcel.Sheets[i];

                            clientName = Regex.Replace(sheet.GetCell(2, 1).Value.ToString(), @"\s", "").Replace(".", "");

                            for (int row = 7; row <= 11; row++)
                            {
                                if (!String.IsNullOrEmpty(sheet[row, 1].Text.Trim().ToString()))
                                {
                                    DataRow _row = DT.NewRow();

                                    _row[enumRepoColumnsNameFromUploadTemplate.RepoUploadSheetNbr.ToString()] = i;
                                    _row[enumRepoColumnsNameFromUploadTemplate.Customer.ToString()] = sheet[row, 1].Text;
                                    _row[enumRepoColumnsNameFromUploadTemplate.AccountNbr.ToString()] = sheet[row, 2].Text;
                                    _row[enumRepoColumnsNameFromUploadTemplate.Trade_Date.ToString()] = sheet[row, 3].Text;
                                    _row[enumRepoColumnsNameFromUploadTemplate.Start_Date.ToString()] = sheet[row, 4].Text;
                                    _row[enumRepoColumnsNameFromUploadTemplate.End_Date.ToString()] = sheet[row, 5].Text;
                                    _row[enumRepoColumnsNameFromUploadTemplate.SecCategory.ToString()] = sheet[row, 6].Text;
                                    _row[enumRepoColumnsNameFromUploadTemplate.Security_ISIN.ToString()] = sheet[row, 7].Text;
                                    _row[enumRepoColumnsNameFromUploadTemplate.CCY.ToString()] = sheet[row, 8].Text;
                                    _row[enumRepoColumnsNameFromUploadTemplate.FaceAmount.ToString()] = decimal.TryParse(sheet[row, 9].Text, out n) == false ? "0" : sheet[row, 9].Text.ToString();
                                    _row[enumRepoColumnsNameFromUploadTemplate.Other.ToString()] = sheet[row, 10].Text;

                                    DT.Rows.Add(_row);
                                }
                            }

                        } // For loop End  of Sheets
                    }

