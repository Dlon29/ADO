using System;
using System.IO;
using C1.C1Excel;

namespace STBUSA.Excel.Util.Wrapper
{
	/// <summary>
	/// Summary description for WorkBook.
	/// </summary>
	public class WorkBook {
		
        private C1XLBook _wb;
		private WorkSheets _cws;
		public WorkBook(ref object wb){
            if (wb is C1XLBook)
            {
				if(this._wb == null){
                    this._wb = (C1XLBook)wb;
				}
			}
		}

        public static void SaveAs(string strFileDestination)
        {
            
            C1XLBook workBook = new C1XLBook();
            try
            {
                using (FileStream fs = new FileStream(strFileDestination, FileMode.Open, FileAccess.ReadWrite))
                {                    
                    workBook.Load(fs);                    
                    workBook.Save(fs, FileFormat.Biff8);
                    fs.Close();
                }                
            }
            catch (Exception e)
            {                
                throw e;
            }
            finally
            {
                
                workBook.Dispose();
                GC.Collect(); 
            }
        }

		~WorkBook(){
			if(this._wb != null){				
                this._wb.Dispose();
				this._wb = null;
			}
		}

		public WorkSheets Sheets{
			get{
				if(this._cws == null){
					object t = (object)this._wb;
                    _cws = new WorkSheets(ref t);
				}
				return _cws;
			}
		}
	}

    public class WorkSheets
    {
        private WorkSheet _ws;        
        private C1XLBook _wb;

        public WorkSheets(ref object wb)
        {
            if (wb is C1XLBook)
            {
                if (this._wb == null)
                {
                    this._wb = (C1XLBook)wb;
                }
            }
        }

        ~WorkSheets()
        {
            if (this._wb != null)
            {                
                this._wb.Dispose();
                this._wb = null;
            }
        }

        public WorkSheet this[object index]
        {
            get
            {
                if (this._wb == null)
                    throw new ApplicationException("Object reference to workbook not set");
                object t = null;
                if (index is string)
                {
                    t = _wb.Sheets[(string)index];
                }
                else
                {
                    t = _wb.Sheets[(int)index - 1];
                }
                _ws = new WorkSheet(t);
                return _ws;
            }
        }

        public int Count
        {
            get
            {
                return this._wb.Sheets.Count;
            }
        }

        public string[] Names
        {
            get
            {
                int count = this._wb.Sheets.Count;
                string[] names = new string[count];

                for (int i = 0; i < count; i++)
                {
                    names[i] = this._wb.Sheets[i].Name;
                }

                return names;
            }
        }
    }

	public class WorkSheet{
		//private msExcel.Worksheet _ws;
        private XLSheet _ws;
		private Cells _cc;

		public WorkSheet(object ws){
            if (ws is XLSheet)
            {
				if(_ws != null){					
                    this._ws = null;
				}
                this._ws = (XLSheet)ws;
			}
		}

		~WorkSheet(){
			if(_ws != null){				
				this._ws = null;
			}
		}

		public Cells Cells{
			get{
				object t = (object)this._ws;
				this._cc = new Cells(ref t);
				return this._cc;
			}
		}
	}

	public class Cells{
		//private msExcel.Worksheet _ws;
        private XLSheet _ws;
		private Range _r;
		
		public Cells(ref object ws){
            if (ws is XLSheet)
            {
				if(_ws != null){					
					this._ws = null;
				}
                this._ws = (XLSheet)ws;
			}
		}

		~Cells(){
			if(_ws != null){				
				this._ws = null;
			}
		}

		public Range this[object rowIndex, object columnIndex] {
			get {
				if(this._ws == null)
					throw new ApplicationException("Object reference to worksheet not set");
				object t = _ws.GetCell((int)rowIndex -1, (int)columnIndex -1);
				this._r = new Range(ref t);
				return this._r;
			}			
		}
	}

	public class Range{		
        private XLCell _r;
		public enum RangeFormat {Text, Number, Date}; 
 
		public Range(ref object r){
            if (r is XLCell)
            {
				if(this._r != null){					
					_r = null;
				}
                this._r = (XLCell)r;
			}
		}

		~Range(){
			if(this._r != null){				
				_r = null;
			}
		}

		public object Text{
			get{
				return this._r.Text.ToString().Trim();
			}
		}

        public object Self
        {
            get
            {
                return this._r;
            }
        }

		public void Format(RangeFormat format){			
            this._r.Style.Format = "@";
		}
	}
}
