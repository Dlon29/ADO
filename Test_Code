        public static void LogUserAction(string Userid, int _ModuleId, UserInfo.enmUserActionType enmUserActionType, string parameter)
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();

            clsDB.IsNewDBSource = true;

            if (clsDB.Open() == true)
            {
                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_SaveData_UserActionLog;
                clsReader.LogUserAction(Userid, _ModuleId, enmUserActionType, parameter);
            }
