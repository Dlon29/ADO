using System;
using System.Collections.Generic;
using System.Linq;
using Common.Logging;
//using RabbitMQAdmin.Client;
using SMTBUSA.Messaging;

namespace CAPS
{
    public class MessageQueue
    {
        #region static readonly variables declarations
        private const string rabbitMQSection = "giRabbitMQ";
        private static RabbitMQClient _rabbitMQClientGIIn = null;
        #endregion

        #region Private Variables
        private static ILog _logger = LogManager.GetLogger(typeof(MessageQueue));
        #endregion

        #region InitializeRabbitMQ service
       /// <summary>
        /// This method is used to intialize RabbitMQ admin service and test loop back method.
       /// </summary>
       /// <param name="sectionName"></param>
       /// <param name="queueName"></param>
       /// <returns></returns>
        public static bool InitializeRabbitMQSettings(string sectionName, string queueName)
        {
            bool isLoopBackSuccess_GI = false;
            try
            {
                RabbitMQAdminServiceClient rbqAdminService = RabbitMQAdmin.Client.ServiceProxyFactory.Instance.CreateRabbitMQAdminServiceProxy();
                List<RabbitMQSettings> rabbitMQSettingsList = rbqAdminService.GetAndInitializeRabbitMQSettingsListBySection(rabbitMQSection);

                Dictionary<string, RabbitMQSettings> rabbitMQSettingsDict = rabbitMQSettingsList.ToDictionary(rbMQSettings => rbMQSettings.BindingID);
                isLoopBackSuccess_GI = QueueLoopBackTest(rabbitMQSettingsDict[queueName]);
            }
            catch (Exception e)
            {
                _logger.Error("Error occurred in InitializeRabbitMQSettings - MessageQueue", e);
                throw e;
            }

            return isLoopBackSuccess_GI;

        }
        #endregion

        #region Queue Methods
       /// <summary>
        /// This method ckecks loopback method of RabbitMQ.
       /// </summary>
       /// <param name="objRabbitMQSettings"></param>
       /// <returns></returns>
        public static bool QueueLoopBackTest(RabbitMQSettings objRabbitMQSettings)
        {
            bool isChkSuccess = false;
            try
            {
                HealthCheck queueCheck = new HealthCheck(objRabbitMQSettings.HostName, objRabbitMQSettings.PortNumber, objRabbitMQSettings.Username, objRabbitMQSettings.Password, objRabbitMQSettings.VHost);
                queueCheck.ExchangeName = objRabbitMQSettings.ExchangeName;
                queueCheck.QueueName = objRabbitMQSettings.QueueName;
                isChkSuccess = queueCheck.LoopBack();

            }
            catch (Exception ex)
            {
                _logger.Error("Error occurred in QueueLoopBackTest - MessageQueue", ex);
                throw ex;
            }
            return isChkSuccess;
        }

        /// <summary>
        /// This method posts GI message in TRACR GI queue.
        /// </summary>
        /// <param name="queueMessage"></param>
        /// <param name="queueName"></param>
        /// <returns></returns>
        public static bool PostGIMessageInQueue(string queueMessage, string queueName)
        {
            bool isSuccess = false;
            try
            {
                RabbitMQAdminServiceClient rbqAdminService = RabbitMQAdmin.Client.ServiceProxyFactory.Instance.CreateRabbitMQAdminServiceProxy();
                List<RabbitMQSettings> rabbitMQSettingsList = rbqAdminService.GetAndInitializeRabbitMQSettingsListBySection(rabbitMQSection);

                Dictionary<string, RabbitMQSettings> rabbitMQSettingsDict = rabbitMQSettingsList.ToDictionary(rbMQSettings => rbMQSettings.BindingID);
                RabbitMQClient _rabbitMQClientGIIn = new RabbitMQClient(rabbitMQSettingsDict[queueName]);
                _rabbitMQClientGIIn.PostMQMessage(queueMessage);
                isSuccess = true;
            }
            catch (Exception e)
            {
                _logger.Error("Error occurred in PostGIMessageInQueue - MessageQueue", e);
                throw e;
            }
            return isSuccess;
        }        
        #endregion

    }
}





