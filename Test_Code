		FROM dbo.f_CreateCollateralSummarySchema() 
	END	
	
	IF OBJECT_ID('tempdb..#TMP_LOAN_COLLATERAL_DIST','U') IS NULL	-- Collateral Distribution by Loan
	BEGIN
