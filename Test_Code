

--METHOD - 1
CREATE TABLE #ValidTxnRefs
(
    TxnRefNbr INT
)

INSERT INTO #ValidTxnRefs
(
	TxnRefNbr
)
SELECT DISTINCT
       E.TxnRefNbr
FROM ETIDetailRecord E
WHERE E.StatusId = 140
  AND E.ProcessedRecordID = 2
  AND E.RecordTypeId = 3


CREATE TABLE #TempCloseRebookLoan
(
    RawDataId INT
)
INSERT INTO #TempCloseRebookLoan
(
	RawDataId
)
SELECT DISTINCT E.RawDataId
FROM ETIDetailRecord E
INNER JOIN #ValidTxnRefs V
    ON V.TxnRefNbr = (CASE WHEN E.RecordTypeId = 23 THEN
       CAST(SUBSTRING(E.BgnRef, 2, 11) AS INT) ELSE E.BgnRef END)
   AND (E.RecordTypeId = 1 OR E.RecordTypeId = 23)
   AND E.StatusId = 0




--METHOD - 2

CREATE TABLE #tempCloseRebookLoan
(
    RawDataId <same datatype as ETIDetailRecord.RawDataId>
);

INSERT INTO #tempCloseRebookLoan (RawDataId)
SELECT DISTINCT
       ETIDet2.RawDataId
FROM ETIDetailRecord ETIDet1
INNER JOIN ETIDetailRecord ETIDet2
    ON ETIDet1.TxnRefNbr =
       CASE
           WHEN ETIDet2.RecordTypeId = 23
               THEN CAST(SUBSTRING(ETIDet2.AgrRef, 2, 11) AS INT)
           ELSE ETIDet2.BgnRef
       END
WHERE ETIDet1.StatusId = 140
  AND ETIDet1.ProcessedRecordID = 2
  AND ETIDet2.RecordTypeId IN (1, 23)
  AND ETIDet2.StatusId = 0;


--METHOD - 3
CREATE FUNCTION dbo.fn_GetCloseRebookRawDataIds()
RETURNS TABLE
AS
RETURN
(
    WITH ValidTxnRefs AS (
        SELECT DISTINCT E.TxnRefNbr
        FROM ETIDetailRecord E
        WHERE E.RecordTypeId = 3        -- RSL
          AND E.StatusId = 140
          AND E.ProcessedRecordID = 2
    )
    SELECT DISTINCT E.RawDataId
	FROM ETIDetailRecord E
	INNER JOIN ValidTxnRefs V
    ON V.TxnRefNbr = (CASE WHEN E.RecordTypeId = 23 THEN
       CAST(SUBSTRING(E.BgnRef, 2, 11) AS INT) ELSE E.BgnRef END)
   AND E.RecordTypeId IN (1,23)
   AND E.StatusId = 0
);
GO

-- 1. Explicitly define the table structure
CREATE TABLE #TempCloseRebookLoan
(
    RawDataId BIGINT NOT NULL
);

-- 2. Insert the data via the function
INSERT INTO #TempCloseRebookLoan (RawDataId)
SELECT RawDataId
FROM dbo.fn_GetCloseRebookRawDataIds();
