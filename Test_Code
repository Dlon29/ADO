        /// <summary>
        /// This method will set parameter
        /// </summary>
        /// <returns></returns>
        private bool GetParameter()
        {
            MethodName = "GetParameter()";
            try
            {
                PageNofM = _PageNo.ToString() + " of " + _TotPage.ToString();

                if (_SearchClicked)
                {
                    _PageNo = 1;
                    _BatchRunDate = Request.Form["txtBatchRunDate"];
                }

                if (_BatchRunDate == null || _BatchRunDate.Length == 0)
                {
                    _BatchRunDate = DateTime.Today.ToShortDateString();
                }
                hdnGLBatchRunDate.Value = _BatchRunDate;
                this.txtBatchRunDate2.Text = _BatchRunDate;

                if (this.txtSRRBatchRunDate.Text == string.Empty)
                    this.txtSRRBatchRunDate.Text = _BatchRunDate;

                if (this.txtSRSBatchRunDate.Text == string.Empty)
                    this.txtSRSBatchRunDate.Text = _BatchRunDate;

                if (this.txtNSRSBatchRunDate.Text == string.Empty)
                    this.txtNSRSBatchRunDate.Text = _BatchRunDate;

                if (this.txtGRLBatchRunDate.Text == string.Empty)
                    this.txtGRLBatchRunDate.Text = _BatchRunDate;

                if (this.txtSRLBatchRunDate.Text == string.Empty)
                    this.txtSRLBatchRunDate.Text = _BatchRunDate;

                if (this.txtEQRecallBatchRunDate.Text == string.Empty)
                    this.txtEQRecallBatchRunDate.Text = _BatchRunDate;

                return true;
            }
            catch (Exception Exc)
            {
                Information clsInfo = new Information();
                clsInfo.ErrNum = 5000;
                clsInfo.ErrStr = Exc.Message;
                clsInfo.ErrStack = Exc.StackTrace;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                Response.Redirect(Common.INFORMATIONPAGEURL);
                clsInfo = null;
                return false;
            }
        }

