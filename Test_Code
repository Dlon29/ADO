        /// <summary>
        /// Download File
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void DownloadFile(object sender, EventArgs e)
        {
            MethodName = "DownloadFile()";
            try
            {
                string FilePath = (sender as LinkButton).CommandArgument;
                string FileName = Path.GetFileName(FilePath);

                using (FileStream fs = new FileStream(FilePath, FileMode.Open, FileAccess.Read))
                {
                    HttpContext.Current.Response.Charset = "";
                    HttpContext.Current.Response.ContentType = "application/vnd.ms-excel";
                    HttpContext.Current.Response.AddHeader("Content-Disposition", "attachment;filename=" + FileName + "");

                    byte[] temp = new byte[fs.Length];
                    fs.Read(temp, 0, temp.Length);
                    HttpContext.Current.Response.BinaryWrite(temp);
                    fs.Close();
                }
            }
            catch (Exception ex)
            {
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(ex.Message);
                _show_info_row = _ErrorInfoNone;
                _show_error_row = _ErrorInfoBlank;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, ex));
            }
        }

        /// <summary>
        /// Used for calling p_GetData_UploadedRepoRequest sp
        /// </summary>
        /// <param name="Identifier"></param>
        /// <param name="Param0"></param>
        /// <returns></returns>
        private DataSet GetMethodCall(string Identifier)
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet objDS = new DataSet();
            string[] SqlCondition = new string[1] { "" };
            MethodName = "GetMethodCall()";

            try
            {
                if (clsDB.Open() == false)
                    return null;

                clsReader.Connection = clsDB.Connection;
                clsReader.SqlIdentifier = Identifier;

                SqlCondition[0] = txtAsOfDate.Text;

                // get the data from either current or history table.
                if (clsReader.GetData(ref objDS, SqlObjects.p_GetData_UploadedRepoRequest, SqlCondition) == false)
                    return null;
                else
                    return objDS;
            }

            catch (Exception Exc)
            {
                _show_error_row = _ErrorInfoBlank;
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                return null;
            }
            finally
            {
                clsDB.Dispose();
            }
        }


        /// <summary>
        /// Used for calling p_SaveData_UploadRepoRequest sp
        /// </summary>
        /// <param name="Identifier"></param>
        /// <param name="Param0"></param>
        /// <param name="IsValid"></param>
        /// <param name="nReturnValue"></param>
        /// <param name="savedFileNamePath"></param>
        /// <param name="RepoDataXML"></param>
        /// <param name="UserName"></param>
        /// <param name="FileNameToSave"></param>
        /// <param name="FileShortName"></param>
        /// <returns></returns>
        private DataSet SaveMethodCall(string Identifier, ref Boolean IsValid, ref int nReturnValue, string savedFileNamePath, string RepoDataXML, string UserName, string FileNameToSave, string FileShortName, bool doNotAllowDuplicate, string clientName, Byte[] excelFileBytes)
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            string[] SqlCondition = new string[8] { "", "", "", "", "", "", "", "" };
            MethodName = "SaveMethodCall()";
            DataSet ds = new DataSet();

            try
            {
                if (clsDB.Open() == false)
                    return null;

                clsReader.Connection = clsDB.Connection;
                clsReader.SqlIdentifier = Identifier;

                SqlCondition[0] = savedFileNamePath;
                SqlCondition[1] = RepoDataXML;
                SqlCondition[2] = UserName;
                SqlCondition[3] = FileNameToSave;
                SqlCondition[4] = FileShortName;
                SqlCondition[5] = doNotAllowDuplicate.ToString();
                SqlCondition[6] = clientName;
                SqlCondition[7] = excelFileBytes == null ? "" : Convert.ToBase64String(excelFileBytes);

                // get the data from either current or history table.
                if (clsReader.GetData(ref ds, SqlObjects.p_SaveData_UploadRepoRequest, ref nReturnValue, SqlCondition) == false)
                {
                    IsValid = false;
                    _logger.Error(Common.GetMessage("Common", "ErrorExecSP") + SqlObjects.p_SaveData_UploadRepoRequest);
                    return null;
                }
                else
                {
                    _logger.InfoFormat("Successfully uploaded Repo Request file into LAVA via {0}.", SqlObjects.p_SaveData_UploadRepoRequest.ToString());
                    IsValid = true;
                    return ds;
                }
            }
            catch (Exception Exc)
            {
                _show_error_row = _ErrorInfoBlank;
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                return null;
            }
            finally
            {
                clsDB.Dispose();
            }
        }




