namespace MoBetterReports.CustomerReports.BusinessLogic
{
    public class InvoiceDetailsRepoReportBLL : ReportBuilder, IGenerateCustomerReportBLL
    {
        private static ILog _logger = LogManager.GetLogger(typeof(InvoiceDetailsRepoReportBLL));
        private ICustomerReportDataDAL _ObjInvoiceDetailsRepoReportDAL;

        public InvoiceDetailsRepoReportBLL(InvoiceDetailsRepoReportDAL ObjInvoiceDetailsRepoReportDAL)
        {
            _ObjInvoiceDetailsRepoReportDAL = ObjInvoiceDetailsRepoReportDAL;
        }

        #region Report Generation Logic
        /// <summary>
        /// This method will generate Repo Invoice Details Report using component one and will return the path of report generated
        /// </summary>
        /// <param name="reportSetupID">CRMM Setup ID for the current report</param>
        /// <param name="batchRunDate">Date for which report is to be generated</param>
        /// <returns></returns>
        public ReportPath GenerateReport(int reportSetupID, DateTime batchRunDate, string fileType, string source, SourceInfo sourceInfo, int appID, List<ReportRequestParams> requestParams)
        {
            try
            {
                string ReportPath = null;
                ReportSource = (Source)Convert.ToInt32(source);
                FileType = fileType;
                if (ReportSource == Source.Package)
                { PackagePath = sourceInfo.SourceInformation; }

                DataSet ObjSqlDataSet = new DataSet();

                if (fileType.ToUpper() == Filetype.pdf.ToString().ToUpper())
                {
                    //Note: Getting template file name and package filene
                    if (_ObjInvoiceDetailsRepoReportDAL.GetReportInformation(reportSetupID, batchRunDate, ref ObjSqlDataSet, fileType.ToUpper(), source, appID, new List<ReportRequestParams> { new ReportRequestParams { ParamName = "SQL_IDENTIFIER", ParamType = "string", ParamValue = "GET_CRMM_REPORT_DETAILS" } }))
                    {
                        ReportPath = BuildPDF(ObjSqlDataSet, reportSetupID, batchRunDate,source);
                    }
                }
                else if (_ObjInvoiceDetailsRepoReportDAL.GetReportData(reportSetupID, batchRunDate, ref ObjSqlDataSet, fileType.ToUpper(), source))
                {
                    //string FileType = String.Empty;
                    //fileType = ObjSqlDataSet.Tables[0].Rows[0]["FileType"].ToString(); NOTE: File type can also be fetched from DB
                    bool hasTemplate = ObjSqlDataSet.Tables[0].Columns.Contains("TemplateFileName") && !string.IsNullOrWhiteSpace(Convert.ToString(ObjSqlDataSet.Tables[0].Rows[0]["TemplateFileName"])) ? true : false;
                    if (fileType.ToUpper() == Filetype.xlsx.ToString().ToUpper() || hasTemplate)
                        ReportPath = BuildWorkBook(ObjSqlDataSet);
                    else if (fileType.ToUpper() == Filetype.csv.ToString().ToUpper())
                        ReportPath = BuildCSV(ObjSqlDataSet);
                }

                //return ReportPath;
                return new Shared.Infrastructure.ReportPath { ReportFile = ReportFileName, ReportFolderPath = ReportFolderPath };
            }
            catch (Exception ex)
            {
                _logger.ErrorFormat("Exception occured while generating Repo Invoice Details Report. ReportSetupID: {0}. Error: " + ex, reportSetupID.ToString());
                throw;
            }
        }

        public override void RenameWorksheet(ref XLSheet workSheetTemplate, string sheetName)
        {
            base.RenameWorksheet(ref workSheetTemplate, sheetName);

            var fileNDateFormat = workSheetTemplate.Name.Split('{', '}');

            workSheetTemplate.Name = workSheetTemplate.Name.Replace("{" + fileNDateFormat[1] + "}", DateTime.Now.ToString(fileNDateFormat[1]));
        }


        #endregion
    }

}




