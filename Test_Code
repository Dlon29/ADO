using STBUSA.Excel.Util.C1Compatibility;
using Common.Logging;
using MoBetterReports.CustomerReports.DataAccess;
using MoBetterReports.Shared.Infrastructure;
using MoBetterReports.Shared.Report;
using System;
using System.Collections.Generic;
using System.Data;

namespace MoBetterReports.CustomerReports.BusinessLogic
{
    public class TeachersCollPerReportBLL : ReportBuilder, IGenerateCustomerReportBLL
    {
        private static ILog _logger = LogManager.GetLogger(typeof(TeachersCollPerReportBLL));
        private ICustomerReportDataDAL _ObjTeachersCollPerReportDAL;

        public TeachersCollPerReportBLL(TeachersCollPerReportDAL ObjTeachersCollPerReportDAL)
        {
            _ObjTeachersCollPerReportDAL = ObjTeachersCollPerReportDAL;
        }


        #region Report Generation Logic
        /// <summary>
        /// This method will generate teachers collateral percentage report using component one and will return the path of report generated
        /// </summary>
        /// <param name="reportSetupID">CRMM Setup ID for the current report</param>
        /// <param name="batchRunDate">Date for which report is to be generated</param>
        /// <returns></returns>
        public ReportPath GenerateReport(int reportSetupID, DateTime batchRunDate, string fileType, string source, SourceInfo sourceInfo, int appID, List<ReportRequestParams> requestParams)
        {
            try
            {
                string ReportPath = string.Empty;
                ReportSource = (Source)Convert.ToInt32(source);
                FileType = fileType;
                if (ReportSource == Source.Package)
                { PackagePath = sourceInfo.SourceInformation; }

                DataSet ObjSqlDataSet = new DataSet();

                if (fileType.ToUpper() == Filetype.pdf.ToString().ToUpper())
                {
                    //Note: Getting template file name and package filene
                    if (_ObjTeachersCollPerReportDAL.GetReportInformation(reportSetupID, batchRunDate, ref ObjSqlDataSet, fileType.ToUpper(), source, appID, new List<ReportRequestParams> { new ReportRequestParams { ParamName = "SQL_IDENTIFIER", ParamType = "string", ParamValue = "GET_CRMM_REPORT_DETAILS" } }))
                    {
                        ReportPath = BuildPDF(ObjSqlDataSet, reportSetupID, batchRunDate, source);
                    }
                }
                else if (_ObjTeachersCollPerReportDAL.GetReportData(reportSetupID, batchRunDate, ref ObjSqlDataSet, fileType.ToUpper(), source))
                {
                    //Now pass this object to another report for report genaration using component one.
                    bool hasTemplate = ObjSqlDataSet.Tables[0].Columns.Contains("TemplateFileName") && !string.IsNullOrWhiteSpace(Convert.ToString(ObjSqlDataSet.Tables[0].Rows[0]["TemplateFileName"])) ? true : false;
                    if (fileType.ToUpper() == Filetype.xlsx.ToString().ToUpper() || hasTemplate)
                        ReportPath = BuildWorkBook(ObjSqlDataSet);
                    else if (fileType.ToUpper() == Filetype.csv.ToString().ToUpper())
                        ReportPath = BuildCSV(ObjSqlDataSet);
                }

                //return ReportPath;
                return new Shared.Infrastructure.ReportPath { ReportFile = ReportFileName, ReportFolderPath = ReportFolderPath };
            }
            catch (Exception ex)
            {
                _logger.ErrorFormat("Exception occured while generating Teachers Collateral Percentage Report. ReportSetupID: {0}. Error: " + ex, reportSetupID.ToString());
                throw;
            }
        }

        public override void CopyCellsFromSourceToDest(XLSheet xLSheetSource, ref XLSheet xLSheetDest, string[] sourceLocation, string[] destinationLocation, ref int rowInsertCount, bool cut, int copyDestinationStyle = 0)
        {
            base.CopyCellsFromSourceToDest(xLSheetSource, ref xLSheetDest, sourceLocation, destinationLocation, ref rowInsertCount, cut);

            if (reportConfigKeys.ContainsKey("CopySectionMergeKey1"))
            {
                string[] loc = reportConfigKeys["CopySectionMergeKey1"].Split(',');
                xLSheetDest.MergedCells.Add(Convert.ToInt16(loc[0]), Convert.ToInt16(loc[1]), Convert.ToInt16(loc[2]), Convert.ToInt16(loc[3]));
                xLSheetDest[Convert.ToInt16(loc[0]) + 1, 0].Style.BorderBottom = XLLineStyleEnum.Thin;
            }

            if (reportConfigKeys.ContainsKey("CopySectionMergeKey2"))
            {
                string[] loc = reportConfigKeys["CopySectionMergeKey2"].Split(',');
                xLSheetDest.MergedCells.Add(Convert.ToInt16(loc[0]), Convert.ToInt16(loc[1]), Convert.ToInt16(loc[2]), Convert.ToInt16(loc[3]));
            }

            //xLSheetDest[5, 0].Style.BorderBottom = XLLineStyleEnum.Thin;

            for (int i = (Convert.ToInt16(sourceLocation[0]) + rowInsertCount); i <= (Convert.ToInt16(sourceLocation[2]) + rowInsertCount); i++)
            {
                //xLSheetDest.Rows.Remove(xLSheetDest.Rows[i]);
                xLSheetDest.Rows.Remove(xLSheetDest.Rows[Convert.ToInt16(sourceLocation[0]) + rowInsertCount]);
            }
        }

        #endregion
    }
}




