        {
            DateTime currQtrDate = DateTime.Now;

            if ((Month)DateTime.Now.Month <= Month.March)
                //go to last quarter of previous year
                currQtrDate = GetEndOfQuarter(DateTime.Now.Year - 1, Quarter.Fourth);
            else if (((Month)DateTime.Now.Month >= Month.April) && ((Month)DateTime.Now.Month <= Month.June))
                //go to first quarter of Current year
                currQtrDate = GetEndOfQuarter(DateTime.Now.Year, Quarter.First);
            else if (((Month)DateTime.Now.Month >= Month.July) && ((Month)DateTime.Now.Month <= Month.September))
                //go to Second quarter of Current year
                currQtrDate = GetEndOfQuarter(DateTime.Now.Year, Quarter.Second);
            else //go to Third quarter of Current year
                currQtrDate = GetEndOfQuarter(DateTime.Now.Year, Quarter.Third);

            if (DateTime.Now.ToShortDateString() == _QtrEndDate1)
                currQtrDate = Convert.ToDateTime(_QtrEndDate1);
            else if (DateTime.Now.ToShortDateString() == _QtrEndDate2)
                currQtrDate = Convert.ToDateTime(_QtrEndDate2);
            else if (DateTime.Now.ToShortDateString() == _QtrEndDate3)
                currQtrDate = Convert.ToDateTime(_QtrEndDate3);
