        protected void Page_Load(object sender, EventArgs e)
        {
            try
            {
                MethodName = "Page_Load";
                _AccessTypeCode = getUserAppAccessTypeCode(_ModuleName, clsUI.NTUserName);
                _AccessTypeCode = _AccessTypeCode == Common.UserAccessCode.F.ToString() ? getUserAppAccessTypeCode(_ModuleName, clsUI.NTUserName) : _AccessTypeCode;

                _show_error_row = _ErrorInfoNone;

                if (_AccessTypeCode == Common.UserAccessCode.R.ToString())
                {
                    _UserAccess = Common.UserAccess.ReadOnly.ToString();
                    EnableDisablePageButtons(false);
                }
                else if (_AccessTypeCode == Common.UserAccessCode.N.ToString())
                {
                    Response.Redirect(string.Format("~/Error/PageDenied.aspx?{0}&{1}", "AuthorizationFail", _page));
                }

                RetainSessionValues();

                legHardBlock.Style.Add("background-color", ConfigurationManager.AppSettings["RepoRequest_HardBlock"]);
                legSoftBlock.Style.Add("background-color", ConfigurationManager.AppSettings["RepoRequest_SoftBlock"]);                

                if (!Page.IsPostBack)
                {
                    txtAsOfDate.Text = _BussDate;
                    LoadUploadRepoTemplates();
                    lnkBulkLocation.HRef = ConfigurationManager.AppSettings["RepoTemplateBulkUploadPath"];
                    lnkBulkLocation.InnerText = ConfigurationManager.AppSettings["RepoTemplateBulkUploadPath"];
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                _show_error_row = "";
            }

        }

        private void EnableDisablePageButtons(bool val)
        {
            this.cmdUploadNewRepo.Enabled = false;
            this.btnFetchFiles.Enabled = false;
            this.btnUploadFiles.Enabled = false;
            this.cmdDeleteRepoTemplate.Enabled = false;
        }

        private void RetainSessionValues()
        {
            try
            {
                // take pageing information from hidden controls
                if (Request["hdnPageNo"] != null)
                {
                    _PageNo = Int32.Parse(Request["hdnPageNo"].ToString());
                }

                if (Request["hdnTotPage"] != null)
                {
                    _TotPage = Int32.Parse(Request["hdnTotPage"].ToString());
                }
            }
            catch (Exception)
            {
                _PageNo = 0;
                _TotPage = 0;
            }
            PageNofM = _PageNo.ToString() + " of " + _TotPage.ToString();

            return;
        }

        /// <summary>
        /// Button click for all the button commands
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void Button_Click(object sender, System.Web.UI.WebControls.CommandEventArgs e)
        {
            MethodName = "Button_Click()";
            DataTable dtRepo = new DataTable();
            dtRepo.Columns.Add("FilePath");
            dtRepo.Columns.Add("FileName");

            try
            {
                _ErrorString = new StringBuilder("");
                switch (e.CommandName.ToUpper())
                {
                    // Upload Repo Ticket from 1st TAB.
                    case UPLOAD_NEW_REPO:
                        if (ValidateUploadNewRepoRequest() == false)
                        {
                            _show_error_row = _ErrorInfoBlank;
                            return;
                        }
                        else
                        {
                            _show_error_row = _ErrorInfoNone;
                            _show_info_row = _ErrorInfoBlank;
                            _ErrorString.Append(Common.GetMessage("RepoRequest", "NewTicketsUploaded"));
                        }
                        break;

                    case DELETE_REPO_TEMPLATE:
                        if (DeleteRepoTemplate() == false)  //false -- error
                        {
                            _show_error_row = _ErrorInfoBlank;
                            return;
                        }
                        else
                        {
                            _show_error_row = _ErrorInfoNone;
                            _show_info_row = _ErrorInfoBlank;
                            _ErrorString.Append(Common.GetMessage("RepoRequest", "DeleteRepoTickets"));
                        }
                        break;

                    case FETCH_FILES:
                        string repoPath = ConfigurationManager.AppSettings["RepoTemplateBulkUploadPath"].ToString();
                        string[] Extn = ConfigurationManager.AppSettings["RepoFileExtensionAllowed"].ToString().Split(",".ToCharArray());

                        if (System.IO.Directory.Exists(repoPath))
                        {
                            foreach (string file in Directory.GetFiles(repoPath))
                            {
                                if (Extn.Contains(Path.GetExtension(file)))
                                {
                                    DataRow dr = dtRepo.NewRow();
                                    dr["FileName"] = file.ToString().Substring(file.LastIndexOf("\\") + 1);
                                    dr["FilePath"] = file.Replace("\\", "\\\\");
                                    dtRepo.Rows.Add(dr);
                                }
                            }

                            if (dtRepo.Rows.Count > 0)
                            {
                                pnlFetchFiles.Visible = false;
                                grdBulkRepoFileSelect.DataSource = dtRepo;
                                grdBulkRepoFileSelect.DataBind();
                                btnFetchFiles.Enabled = false;
                            }
                            else
                            {
                                pnlFetchFiles.Visible = true;
                                btnFetchFiles.Enabled = true;
                            }
                        }
                        else
                        {
                            System.IO.Directory.CreateDirectory(repoPath);
                            //_ErrorString = new StringBuilder("");
                            //_show_error_row = _ErrorInfoBlank;
                            //_show_info_row = _ErrorInfoNone;
                            //_ErrorString.Append(Common.GetMessage("RepoRequest", "PathDoesntExist"));
                        }
                        LoadUploadRepoTemplates();
                        break;

                    case UPLOAD_FILES:
                        StringBuilder strMsg = new StringBuilder();
                        btnFetchFiles.Enabled = true;
                        for (int iRowCount = 0; iRowCount < grdBulkRepoFileSelect.Rows.Count; iRowCount++)
                        {
                            GridViewRow row = grdBulkRepoFileSelect.Rows[iRowCount];
                            CheckBox chkFileSelect = row.FindControl("chkFileSelect") as CheckBox;

                            if (chkFileSelect.Checked)
                            {
                                Label lblFileName = row.FindControl("lblFileName") as Label;
                                HiddenField hdnFilePath = row.FindControl("hdnFilePath") as HiddenField;

                                DataRow dr = dtRepo.NewRow();
                                dr["FileName"] = lblFileName.Text;
                                dr["FilePath"] = hdnFilePath.Value;
                                dtRepo.Rows.Add(dr);
                            }
                        }

                        BulkUploadNewRepoRequest(dtRepo, ref strMsg);
                        if (strMsg.Length > 0)
                        {
                            _show_error_row = _ErrorInfoBlank;
                            _ErrorString.Append(Common.GetMessage("RepoRequest", "BulkUploadFailure") + "<br/>" + strMsg);
                        }
                        else
                        {
                            _show_error_row = _ErrorInfoNone;
                            _show_info_row = _ErrorInfoBlank;
                            _ErrorString.Append(Common.GetMessage("RepoRequest", "BulkUploadSuccess"));
                        }

                        break;

                    case SEARCH_REPO:
                        LoadUploadRepoTemplates();

                        break;

                    case GOTO_DASHBOARD:
                        Response.Redirect(Common.REPODASHBOARDPAGEURL);
                        break;

                }


            }
            catch (Exception ex)
            {
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(ex.Message);
                _show_info_row = _ErrorInfoNone;
                _show_error_row = _ErrorInfoBlank;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, ex));
            }
        }

        private Boolean DeleteRepoTemplate()
        {
            DataSet DS = new DataSet();
            DataTable DT = new DataTable("repoData");
            DT.Columns.Add("RepoExcelUploadId", typeof(int));

            bool isValid = false;
            bool isSaveSuccessful = false;
            int nReturnValue = 0;
            MethodName = "DeleteRepoTemplate()";
            Byte[] byteData = null;
            try
            {

                for (int iRowCount = 0; iRowCount < grdRepoUpload.Rows.Count; iRowCount++)
                {
                    GridViewRow row = grdRepoUpload.Rows[iRowCount];
                    CheckBox chkInclude = row.FindControl("chkInclude") as CheckBox;


                    if (chkInclude.Checked)
                    {
                        Label RepoExcelUploadId = row.FindControl("lblRepoExcelUploadId") as Label;

                        DataRow DR = DT.NewRow();
                        DR["RepoExcelUploadId"] = Convert.ToInt32(RepoExcelUploadId.Text);
                        DT.Rows.Add(DR);
                    }
                }


                StringWriter sw = new StringWriter();
                DT.WriteXml(sw);

                DS = SaveMethodCall(enumSaveSQLIdentifier.DELETE_UPLOADED_REPO_REQUEST.ToString(), ref isValid, ref nReturnValue, "", sw.ToString(), clsUI.NTUserName, "", "", true, "", byteData);
                isSaveSuccessful = isValid;

                if (isValid)
                    LoadUploadRepoTemplates();
            }
            catch (Exception Exc)
            {
                _show_error_row = _ErrorInfoBlank;
                _ErrorString = new StringBuilder("");
                _ErrorString.Append("<a href = \"#\" OnClick = SetFocus('flUpload');>\n");
                _ErrorString.Append(Exc.Message);
                _ErrorString.Append("</a> <br>\n");
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                isSaveSuccessful = false;
            }
            return isSaveSuccessful;
        }


