                                    prvsProdCat = lblProductCategory.Text.Trim();

                                //if (prvsProdCat != lblProductCategory.Text.Trim() && lblProductCategory.Text.Trim() == "STT")
                                //{
                                //    blnDAProdCatFound = true;
                                //}

                                if (txtSharesToRecall.Text != string.Empty && txtSharesToRecall.Text != "0" /*&& blnDAProdCatFound == false*/)
                                {
                                    TotalQtyRecalled += Convert.ToInt64(txtSharesToRecall.Text.Replace(",", ""));
                                    SharesToRecall = Convert.ToInt64(txtSharesToRecall.Text.Replace(",", ""));
                                }


                                if (SharesToRecall > Convert.ToInt64(NSTotalQtyRecalled) /*&& blnDAProdCatFound == false*/ && blnResult == true)
                                {
                                    blnResult = false;
                                    _ErrorString = new StringBuilder();
