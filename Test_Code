								MinAvailAndBCLAndUCLQty,
								UnitsLendable,
								UnUsedUnits,
			--					MaxCleanUpUnits,
								IsAcctUsedCleanUp,
								IsIndemnified)
						SELECT 
								PoolId,
								AcctPriority,
								LendingLimitGrpID,
								AcctNbr,
								AcctAvailibityRem,
								AcctAvailibityRestricted,
								MinLendLimAndConcLimUSD,
								MinAvailAndBCLAndUCLQty,
								UnitsLendable,
								UnUsedUnits,
			--					0, --MaxCleanUpUnits,
								0, -- IsAcctUsedCleanUp
								IsIndemnified
						FROM 
							#WorkingTbl
						WHERE 
							CanUseAcctForCleanUp = 1 AND
							PoolId = @PoolId 
						ORDER BY 
							AcctPriority -- use high priority account first and then low priority accounts

			--select @ReqTotalUnitsLended , @FaceAmount,* from #TempAcctCleanUp

						SELECT 
							@ReqAcctCount = MIN(RowId) 
						FROM 
							#TempAcctCleanUp 

						/** Get the total account which have unused quantity in a pool **/
						SELECT 
							@ReqAcctTotal = MAX(RowId)
						FROM 
							#TempAcctCleanUp			

						/** Loop thru all the accounts in a pool **/
						WHILE (@ReqAcctCount <= @ReqAcctTotal AND @ReqTotalUnitsLended < @FaceAmount) -- Modified on 12/12/2011
						BEGIN

							SET @ReqUnitsLendable = NULL
							SET @ReqUnitsLendedInPoolsLoop = NULL
							SET @UnitsLendedInLendingLimitGrp = NULL
							SET @MinLendLimAndConcLimUSD = NULL
							SET @MinAvailAndBCLAndUCLQty = NULL				

							/** Get the UnUsed qty of a selected account **/
							SELECT
								@ReqUnUsedUnits = UnUsedUnits,
								@LendingLimitGrpID = LendingLimitGrpID,
								@IsIndemnified = IsIndemnified
							FROM 
								#TempAcctCleanUp
							WHERE 
								RowId = @ReqAcctCount

							/** Get the total units lended within the selected lending limit group, MinLendLimAndConcLimUSD and MinAvailAndBCLAndUCLQty of selected lending limit group **/
							SELECT 
								@UnitsLendedInLendingLimitGrp = SUM(UnitsLendable),
								@MinLendLimAndConcLimUSD = MIN(MinLendLimAndConcLimUSD), --MIN is used to return only one record. One acct lending group has only one MinLendLimAndConcLimUSD
								@MinAvailAndBCLAndUCLQty = MIN(MinAvailAndBCLAndUCLQty) --MIN is used to return only one record. One pool has only one MinAvailAndBCLAndUCLQty
							FROM
								#WorkingTbl -- this table has all the accounts which have unused untis for allocation 
							WHERE 
								PoolId = @PoolId AND 
								IsIndemnified = @IsIndemnified AND
								LendingLimitGrpID = @LendingLimitGrpID

							/** Get the total qty lended in a selected pools loop **/
							SELECT 
								@ReqUnitsLendedInPoolsLoop = SUM(UnitsLendable)
							FROM 
								#WorkingTbl -- this table has all the accounts which have been used in allocation
							WHERE 
								PoolId = @PoolId AND
								IsIndemnified = @IsIndemnified

							/** Find MIN of MinAvailAndBCLAndUCLRemQty, MinLendLimAndConcLimRemQty and UnUsedUnits **/
							SELECT @ReqUnitsLendable = 
									MIN(Limit)
							FROM 
							(
								SELECT
									(ISNULL(@MinAvailAndBCLAndUCLQty,0) - ISNULL(@ReqUnitsLendedInPoolsLoop,0)) MinAvailAndBCLAndUCLRemQty,
									((CONVERT(BIGINT,ISNULL(@MinLendLimAndConcLimUSD,0) / @Price))- ISNULL(@UnitsLendedInLendingLimitGrp,0)) MinLendLimAndConcLimRemQty,
									(@FaceAmount - ISNULL(@ReqTotalUnitsLended,0)) RequestedUnits,
									ISNULL(@ReqUnUsedUnits,0) UnUsedUnits
							)p
							UNPIVOT
							(
								Limit FOR AcctountGroup IN (
										MinAvailAndBCLAndUCLRemQty,
										MinLendLimAndConcLimRemQty, 
										RequestedUnits,
										UnUsedUnits)
							)AS unpvt

							UPDATE 
								#WorkingTbl
							SET 
								UnitsLendable = work.UnitsLendable + ISNULL(@ReqUnitsLendable,0) ,
								UnUsedUnits = CP.AcctAvailibityRestricted - (work.UnitsLendable + ISNULL(@ReqUnitsLendable,0)), 
			--					UnitsLendable = @ReqUnitsLendable, 
			--					UnUsedUnits = CP.AcctAvailibityRestricted -  @ReqUnitsLendable, 
								PercentOnLoan = (CONVERT(DECIMAL,(MktValueLoanUSD + (@Price * ISNULL(@ReqUnitsLendable,0)))) / CONVERT(DECIMAL,MktValuePositionUSD)), 
								MktValueLoanUSD = MktValueLoanUSD + (@Price * ISNULL(@ReqUnitsLendable,0)), -- need to confirm
								IsAcctUsed = 1,
								CanUseAcctForCleanUp = 0
							FROM 
