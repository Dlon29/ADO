        /// <summary>
        /// This function is used to write the dynamic columns header and getting the dynamic columns which is used for next section to write the same column.
        /// </summary>
        /// <param name="sheet">current sheet no</param>
        /// <param name="section">current section no</param>
        /// <param name="dtSection">datatable which required to write the data for current section</param>
        /// <param name="configSections">collection of config to retirve the section data from configuration</param>
        /// <param name="dbColumns">It contains the information about database columns</param>
        /// <param name="configKeys">config keys for current section</param>
        /// <param name="workSheetTemplate">worksheet template which we need to write the data and generate the excel</param>
        /// <param name="colInsertCount">Insert count for dynamic columns</param>
        /// <returns></returns>
        public virtual List<string> WriteDynamicColHeader(string sheet, string section, DataTable dtSection, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, Dictionary<string, string> configKeys, ref XLSheet workSheetTemplate, ref int colInsertCount)
        {
            try
            {
                var sectionKey = sheet + section;
                var getSectionPosition = configSections[sectionKey].SectionValue.Split(',');  // Get starting Row and Column position from config collection.
                int SecRow = Convert.ToInt32(getSectionPosition[(int)Cell.Row]), SecColumn = Convert.ToInt32(getSectionPosition[(int)Cell.Column]);
                var sectionDBColumn = dbColumns.Where(p => p.Section == configSections[sectionKey].SectionName && p.SectionOfSheet == sheet).ToList(); //Retrive the Section 1 from DB columns collection

                XLStyle xLStyle;
                List<string> dBDynamicColumns = null;
                DBTempHeader dBTempHeader = null;

                if (dtSection.Rows.Count > 0)
                {
                    dBDynamicColumns = new List<string>();

                    for (int i = 0; i < dtSection.Rows.Count; i++)
                    {

                        if (i + 1 != dtSection.Rows.Count)
                        {
                            workSheetTemplate.Columns.Insert(SecColumn); //Note: Inserting dynamic column
                            workSheetTemplate.Columns.RemoveAt(workSheetTemplate.Columns.Count - 1);//Note:This line will avoid Excel error.
                            colInsertCount++;

                            workSheetTemplate.Columns[SecColumn].Width = workSheetTemplate.Columns[SecColumn - 1].Width;
                            for (int row = 0; row <= workSheetTemplate.Rows.Count - 1; row++)
                            {
                                //Note: Copying data with style from previous column to current inserted column.
                                workSheetTemplate[row, SecColumn].SetValue(workSheetTemplate[row, SecColumn - 1].Value, workSheetTemplate[row, SecColumn - 1].Style);
                            }
                        }

                        for (int j = 0; j < sectionDBColumn.Count; j++)
                        {
                            dBTempHeader = new DBTempHeader();
                            dBTempHeader.DBColumn = sectionDBColumn[j].DBColumn;
                            var ColIndex = Convert.ToInt32(sectionDBColumn[j].Index);

                            //Note: Write the dynamic currency header based on condition. only first two columns is used to write the header.
                            // Third one is a currency column name and here adding into list "dBDynamicColumns" which is required to write next section .
                            if (ColIndex != Convert.ToInt32(configKeys["CurrencyColIndexFromDB"]))
                            {
                                xLStyle = workSheetTemplate.GetCell((SecRow + ColIndex), Convert.ToInt32(getSectionPosition[(int)Cell.Column])).Style.Clone();
                                workSheetTemplate[(SecRow + ColIndex), SecColumn].SetValue((string.IsNullOrWhiteSpace(Convert.ToString(dtSection.Rows[i][dBTempHeader.DBColumn])) == false ? dtSection.Rows[i][dBTempHeader.DBColumn] : dBTempHeader.DBNullValue), xLStyle);
                            }
                            else
                            {
                                dBDynamicColumns.Add(dtSection.Rows[i][dBTempHeader.DBColumn].ToString());
                            }

                        }
                        SecColumn++;
                    }
                }
                else
                {
                    workSheetTemplate.Columns.RemoveAt(Convert.ToInt32(configKeys["DynamicColIndex"]));
                }

                return dBDynamicColumns;
            }
            catch (Exception EX)
            {
                throw new Exception(sheet + " " + section + ": " + EX.Message + ReportGenerationExceptions(EX.Message), EX);
            }
        }

        public virtual List<string> WritePivotHeader(string sheet, string section, DataTable dtSection, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, Dictionary<string, string> configKeys, ref XLSheet workSheetTemplate, ref int colInsertCount)
        {
            try
            {
                var sectionKey = sheet + section;
                var getSectionPosition = configSections[sectionKey].SectionValue.Split(',');  // Get starting Row and Column position from config collection.
                int SecRow = Convert.ToInt32(getSectionPosition[(int)Cell.Row]), SecColumn = Convert.ToInt32(getSectionPosition[(int)Cell.Column]);
                var sectionDBColumn = dbColumns.Where(p => p.Section == configSections[sectionKey].SectionName && p.SectionOfSheet == sheet).ToList(); //Retrive the Section 1 from DB columns collection
                int pivotHeaderWidth = dbColumns.Where(p => p.Section == configSections[sectionKey].SectionName && p.SectionOfSheet == sheet).Sum(s => Convert.ToInt16(s.MergedCells.Split(',')[1]));

                XLStyle xLStyle;
                List<string> dBDynamicColumns = null;
                DBTempHeader dBTempHeader = null;

                string altColor = (configKeys.ContainsKey("PivotHeaderAltColor") && !String.IsNullOrWhiteSpace(Convert.ToString(configKeys["PivotHeaderAltColor"]))) ? Convert.ToString(configKeys["PivotHeaderAltColor"]) : null;
                string dynamicColColor = (configKeys.ContainsKey("PivotDynamicHeaderColor") && !String.IsNullOrWhiteSpace(Convert.ToString(configKeys["PivotDynamicHeaderColor"]))) ? Convert.ToString(configKeys["PivotDynamicHeaderColor"]) : null;


                if (dtSection.Rows.Count > 0)
                {
                    dBDynamicColumns = new List<string>();

                    if (configKeys.ContainsKey("StaticPivotHeaders") && (dtSection.Rows.Count - configKeys["StaticPivotHeaders"].Split(',').Count() == 0))
                    {
                        workSheetTemplate.Columns.RemoveAt(SecColumn);
                        UpdateStaticHeaderDependentFormula(configKeys, workSheetTemplate);
                    }

                    for (int i = 0; i < dtSection.Rows.Count; i++)
                    {
                        if (!(configKeys.ContainsKey("StaticPivotHeaders") && configKeys["StaticPivotHeaders"].Split(',').Contains(dtSection.Rows[i][1].ToString())))
                        {
                            if (i + 1 != dtSection.Rows.Count)
                            {
                                for (int ph = 0; ph < pivotHeaderWidth; ph++)
                                {
                                    if (dtSection.Columns.Contains("Width"))
                                    {
                                        pivotHeaderWidth = Convert.ToInt32(dtSection.Rows[i]["Width"]);
                                    }

                                    int newSecColumn = SecColumn + ph;
                                    workSheetTemplate.Columns.Insert(newSecColumn); //Note: Inserting dynamic column
                                    workSheetTemplate.Columns.RemoveAt(workSheetTemplate.Columns.Count - 1);//Note:This line will avoid Excel error.
                                    dBDynamicColumns.Add(dtSection.Rows[i][1].ToString());
                                    colInsertCount++;

                                    workSheetTemplate.Columns[newSecColumn].Width = workSheetTemplate.Columns[newSecColumn + ph + 1].Width;
                                    for (int row = 0; row <= workSheetTemplate.Rows.Count - 1; row++)
                                    {
                                        //Note: Copying data with style from previous column to current inserted column.
                                        workSheetTemplate[row, newSecColumn].Value = workSheetTemplate[row, newSecColumn + ph + 1].Value;
                                        if (workSheetTemplate[row, newSecColumn + ph + 1].Style != null)
                                        {
                                            workSheetTemplate[row, newSecColumn].Style = workSheetTemplate[row, newSecColumn + ph + 1].Style.Clone();
                                        }
                                        workSheetTemplate.CopyFormula(row, newSecColumn + ph + 1, row, newSecColumn);
                                    }
                                }
                            }

                            for (int j = 0; j < sectionDBColumn.Count; j++)
                            {
                                dBTempHeader = new DBTempHeader();
                                dBTempHeader.DBColumn = sectionDBColumn[j].DBColumn;
                                dBTempHeader.MergedCells = sectionDBColumn[j].MergedCells;
                                dBTempHeader.CopyFormat = sectionDBColumn[j].CopyFormat;

                                var ColIndex = Convert.ToInt32(sectionDBColumn[j].Index);

                                //Merge cells
                                if (string.IsNullOrWhiteSpace(dBTempHeader.MergedCells) == false)
                                {
                                    var getSection5MergedPosition = dBTempHeader.MergedCells.Split(',');
                                    int rowCount = Convert.ToInt32(getSection5MergedPosition[(int)Cell.Row]);
                                    int colCount = Convert.ToInt32(getSection5MergedPosition[(int)Cell.Column]);

                                    workSheetTemplate.MergedCells.Add(SecRow, SecColumn, 1, pivotHeaderWidth);
                                }

                                workSheetTemplate[SecRow, SecColumn].Value = (string.IsNullOrWhiteSpace(Convert.ToString(dtSection.Rows[i][dBTempHeader.DBColumn])) == false ? dtSection.Rows[i][dBTempHeader.DBColumn] : dBTempHeader.DBNullValue);
                                //TO DO: Dynamic styling not working
                                if (dBTempHeader.CopyFormat == "1")
                                {

                                    dBTempHeader.Format = sectionDBColumn[j].Format.Clone();
                                    xLStyle = dBTempHeader.Format.Clone();
                                    workSheetTemplate[SecRow, SecColumn].Style = xLStyle;
                                }
                                /*
                                //Note: Write the dynamic currency header based on condition. only first two columns is used to write the header.
                                // Third one is a currency column name and here adding into list "dBDynamicColumns" which is required to write next section .
                                if (ColIndex != Convert.ToInt32(configKeys["CurrencyColIndexFromDB"]))
                                {
                                    xLStyle = workSheetTemplate.GetCell((SecRow + ColIndex), Convert.ToInt32(getSectionPosition[(int)Cell.Column])).Style.Clone();
                                    workSheetTemplate[(SecRow + ColIndex), SecColumn].SetValue((string.IsNullOrWhiteSpace(Convert.ToString(dtSection.Rows[i][dBTempHeader.DBColumn])) == false ? dtSection.Rows[i][dBTempHeader.DBColumn] : dBTempHeader.DBNullValue), xLStyle);
                                }
                                else
                                {
                                    dBDynamicColumns.Add(dtSection.Rows[i][dBTempHeader.DBColumn].ToString());
                                }
                                */

                            }

                            if (i + 1 != dtSection.Rows.Count)
                            {
                                SecColumn = SecColumn + pivotHeaderWidth;
                            }
                        }
                    }

                    //Note:Coloring tthe headers
                    int tempSecCol = Convert.ToInt32(getSectionPosition[(int)Cell.Column]);
                    string headerColor = !String.IsNullOrWhiteSpace(dynamicColColor) ? dynamicColColor : altColor;
                    if (!string.IsNullOrWhiteSpace(headerColor))
                    {
                        for (int i = 0; i < dtSection.Rows.Count; i++)
                        {
                            if (!(configKeys.ContainsKey("StaticPivotHeaders") && configKeys["StaticPivotHeaders"].Split(',').Contains(dtSection.Rows[i][1].ToString())))
                            {
                                //if (i > 1)
                                //{
                                //    workSheetTemplate[SecRow, SecColumn].Style.BackColor = System.Drawing.ColorTranslator.FromHtml(dynamicColColor);
                                //}
                                if (!String.IsNullOrWhiteSpace(dynamicColColor))
                                {
                                    workSheetTemplate[SecRow, tempSecCol].Style.BackColor = (i > 0) ? System.Drawing.ColorTranslator.FromHtml(headerColor) : workSheetTemplate[SecRow, tempSecCol].Style.BackColor;
                                }
                                else
                                {
                                    workSheetTemplate[SecRow, tempSecCol].Style.BackColor = ((i % 2) > 0) ? System.Drawing.ColorTranslator.FromHtml(headerColor) : workSheetTemplate[SecRow, tempSecCol].Style.BackColor;
                                }
                                tempSecCol = tempSecCol + pivotHeaderWidth;
                            }
                        }
                    }
                }

                return dBDynamicColumns;
            }
            catch (Exception EX)
            {
                throw new Exception(sheet + " " + section + ": " + EX.Message + ReportGenerationExceptions(EX.Message), EX);
            }
        }

        /// <summary>
        /// This function is used to update the formula for dependent static header
        /// </summary>
        /// <param name="configKeys">collection for config keys</param>
        /// <param name="workSheetTemplate">current worksheet object</param>
        private void UpdateStaticHeaderDependentFormula(Dictionary<string, string> configKeys, XLSheet workSheetTemplate)
        {
            try
            {
                if (configKeys.ContainsKey("StaticHeaderDependentFormula") && configKeys.ContainsKey("StaticHeaderDependentFormulaLoc"))
                {
                    var formulaLoc = configKeys["StaticHeaderDependentFormulaLoc"].Split(',');
                    var row = Convert.ToInt32(formulaLoc[0]); var col = Convert.ToInt32(formulaLoc[1]);
                    workSheetTemplate[row, col].Formula = configKeys["StaticHeaderDependentFormula"];
                }
            }
            catch (Exception)
            {

                throw;
            }
        }


        /// <summary>
        /// This method write a report section based on configuration read from config sheet
        /// </summary>
        /// <param name="sheet">current sheet no</param>
        /// <param name="section">current section no</param>
        /// <param name="dtSection">Data table contains section data</param>
        /// <param name="configSections">It contains section wise configuration</param>
        /// <param name="dbColumns">It contains the information about database columns</param>
        /// <param name="configKeys">config keys for current section</param>
        /// <param name="workSheetTemplate">worksheet template which we need to write the data and generate the excel</param>
        /// <param name="workBookTemplate">wokrbook template which we need to write the total formula to dynamic sheets</param>
        /// <param name="rowInsertCount">Insert count for rows</param>
        /// <param name="dBDynamicColumns">List of dynamic columns</param>
        /// <param name="sheetIndex">Index of the sheet. Used for dynamic sheets</param>

        public virtual void WriteSection(string sheet, string section, DataTable dtSection, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, Dictionary<string, string> configKeys, ref XLSheet workSheetTemplate, ref C1XLBook workBookTemplate, ref int rowInsertCount, List<string> dBDynamicColumns = null, int? sheetIndex = null)
        {
            //Data Section
            try
            {
                var sectionKey = sheet + section;
                var getSectionPosition = configSections[sectionKey].SectionValue.Split(','); // Get starting Row and Column position from config collection.
                int SecRow = Convert.ToInt32(getSectionPosition[(int)Cell.Row]), SecColumn = Convert.ToInt32(getSectionPosition[(int)Cell.Column]);
                var sectionDBCol = dbColumns.Where(p => p.Section == configSections[sectionKey].SectionName && p.SectionOfSheet == sheet).ToList(); //Retrive the Section from DB columns collection.
                bool hasGrandTotal = String.IsNullOrWhiteSpace(configSections[sectionKey].HasGrandTotal) == true ? false : Convert.ToBoolean(Convert.ToInt16(configSections[sectionKey].HasGrandTotal.Split(',')[0]));
                var grandTotalRows = (hasGrandTotal == true) ? configSections[sectionKey].HasGrandTotal.Split(',') : null;

                //Update the location of the dummy data row to latest location
                getSectionPosition[(int)Cell.Row] = (SecRow + rowInsertCount).ToString();
                SecRow += rowInsertCount;

                int rowStartIndex = SecRow;

                var dynamicColCount = 0;
                var dynamicFormula = string.Empty;
                //Note: Adding dynamic columns and updating existing column index.
                UpdateDynamicColIndex(sheet, section, configKeys, dBDynamicColumns, SecRow, sectionDBCol, ref dynamicColCount, ref dynamicFormula);


                //Get Maximum number of columns in a section. This dummy row cells will be used for styles when adding rows and applying styles to them.
                //int maxCol = Convert.ToInt32(dbColumns.Where(p => p.Section == configSections[sectionKey].SectionName && p.SectionOfSheet == sheet).Max(xx => xx.Index));//10/31
                int maxCol = Convert.ToInt32(sectionDBCol.Max(xx => Convert.ToInt32(xx.Index)));

                //Updating the formula in Total Columns of the next section
                if (IsDynamicSheet && rowInsertCount > 0)
                {
                    int rowsToUpdate = 0;
                    if (grandTotalRows != null)
                    {
                        rowsToUpdate = Convert.ToInt32(grandTotalRows.Last());
                    }
                    UpdateNextSectionFormulas(ref workSheetTemplate, rowInsertCount, SecRow, SecColumn, maxCol, rowsToUpdate);
                }

                XLCell[] dummyRow = new XLCell[maxCol + 1];
                XLCell[] dummyGTRow = new XLCell[maxCol + 1];//Note: Not in use
                for (int d = 0; d <= maxCol; d++)
                {
                    dummyRow[d] = workSheetTemplate[Convert.ToInt32(getSectionPosition[(int)Cell.Row]), SecColumn + d].Clone();
                    dummyGTRow[d] = workSheetTemplate[Convert.ToInt32(getSectionPosition[(int)Cell.Row]) + 1, SecColumn + d].Clone();
                    dummyGTRow[d].Formula = workSheetTemplate[Convert.ToInt32(getSectionPosition[(int)Cell.Row]) + 1, SecColumn + d].Formula;
                }


                /*
                //cyclic
                for (int jj = 0; jj < sectionDBCol.Count; jj++)
                {
                    var colIndex = Convert.ToInt32(sectionDBCol[jj].Index);
                    //Making Grand Total Formula cyclic. This code can help us avoid writing cyclic formula

