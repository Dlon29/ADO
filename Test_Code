    $(document).ready(function () {
        //$('input[name$="txtAmount"]').attr('disabled', 'disabled');
        $('input[name$="txtUnits"],input[name$="txtPrice"]').change(function () {


            var Amount = "0.00";
            var Units = $('input[name$="txtUnits"]').val() == '' ? "0.00" : $('input[name$="txtUnits"]').val();
            var Price = $('input[name$="txtPrice"]').val() == '' ? "0.00" : $('input[name$="txtPrice"]').val();


            if (Units != '' && Price != '')
                Amount = parseInt(replaceAll(Units, ',', '')) * parseFloat(replaceAll(Price, ',', ''));

            
            if (Math.abs(parseFloat(Amount)) > 0) {
                $('input[name$="txtAmount"]').val(addCommas(Amount));
            }
            else {
                $('input[name$="txtAmount"]').val('');
            }

        });

        var grd = $('#<%=grdEquityMovement.ClientID %>');

        $('input[type=hidden][name$="hdnActionType"]', grd).each(function () {

            var txtTradeDate = $(this).closest('tr').find('input[name$="txtTradeDate"]');
            var txtLoanDate = $(this).closest('tr').find('input[name$="txtLoanDate"]');
            var txtRemarks = $(this).closest('tr').find('input[name$="txtRemarks"]');

            if ($(this).val() == "EDIT") {
                $(this).closest('tr').css("background-color", "#AACDA0");
            }
            else if ($(this).val() == "NEW") {
                $(this).closest('tr').css("background-color", "Lime");
            }
            else if ($(this).val() == "DELETE") {
                $(this).closest('tr').css("background-color", "Red");
                $(this).closest('tr').css("color", "#FFFFFF");
                txtTradeDate.attr('disabled', 'disabled');
                txtTradeDate.css("background-color", "#e0e0e0");
                txtLoanDate.attr('disabled', 'disabled');
                txtLoanDate.css("background-color", "#e0e0e0");
                txtRemarks.attr('disabled', 'disabled');
                txtRemarks.css("background-color", "#e0e0e0");
            }
        });


        grd.find('input[type=image][name$="ImgDelete"]').click(function (e) {
            var txtRemarks = $(this).closest('tr').find('input[name$="txtRemarks"]');
            if (txtRemarks.val() == "" || txtRemarks.val() == "Recon Error") {
                if (confirm("Do you want to delete this loan record")) {
                    $(this).closest('tr').css("background-color", "Red");
                    $(this).closest('tr').css("color", "#FFFFFF");
                    txtRemarks.val('Deleted');
                }
                else {
                    return false;
                }
            }
            else if (txtRemarks.val() == "Deleted") {

                if (confirm("Do you want to un-delete this loan record")) {
                    $(this).closest('tr').css("background-color", "#FFFFFF");
                    $(this).closest('tr').css("color", "black");
                    txtRemarks.val('');
                }
                else {
                    return false;
                }
            }

        });
    });

