		CcyCode,
		PriceBaseCurrency,
		--Price as org,
		CASE @BucketSecType WHEN 'FI' THEN dbo.f_Get_FI_PriceRounded(Price) ELSE Price END  Price, -- Price
		0 DivYield, -- need to calcultate
		CASE WHEN FxRate > 0 THEN CONVERT(DECIMAL (19,8), 1/FxRate) ELSE 0 END FxRate,
		TotalHolding,
		USOnLoan,
		LdnOnLoan,
		TotalOnLoan,
		USTraderLendable,
		LdnTraderLendable,
		TotalTraderLendable,
		TotalTraderLendableAfterAllRest,
		UnitsAvailToLend TraderLendable,
		USBrokerLendable, 
		LdnBrokerLendable, 
		TotalBrokerLendable,
		TotalBrokerLendableAfterAllRest,
		UnitsAvailToLendRest BrokerLendable,
		CONVERT(INT,0) BulkNbr, 
		CONVERT(INT,0) VersionNbr,
		CONVERT(DECIMAL,0) DivRate,
		CONVERT(BIGINT,0) FaceAmount,
		CONVERT(DECIMAL,0) RebateRate,
		CONVERT(BIGINT,0) BasketMarketCap,
		CONVERT(DECIMAL,0) AllocationPerc,
		CONVERT(DECIMAL,0) Principal,
		'' ProductCategory, 
		'' ProductCategoryLoanType,
		'' ProductCategoryLoanDuration,
		'' SettlementDate, 
		'' TermDate, 
		CONVERT(DECIMAL,0) STTLevel, 
		'' STTEndDate, 
		CONVERT(DECIMAL,0) STTDivRate,
		''ScripEndDate,
		'' ErrorMessage,
		'' Remarks,
		'' GotoRemarks,
		CONVERT(INT,0) LIBORRate,
		CONVERT(DECIMAL,0) GotoRepoRate,
		CONVERT(DECIMAL,0) GotoSTTLevel,
		CONVERT(DECIMAL,0) GotoSTTDivRate,
		'' GotoProductCategoryLoanType,
