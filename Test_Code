--select '#WorkingTbl - after calculation' ,* from #WorkingTbl
--select '@CanProcessLoanReq',@CanProcessLoanReq
				-- Update AcctPriority in #WorkingTbl
				
				/** If loan requested qty can be booked using available pool qty then only book the loan else reject request **/
				IF (@CanProcessLoanReq = 1)
				BEGIN
					/** Get the account priority based on percent on loan **/
					TRUNCATE TABLE #AccountPercentOnLoan

					INSERT INTO 
						#AccountPercentOnLoan
					SELECT DISTINCT 
						work.LendingLimitGrpID,
						perOnLoan.AcctId,
						perOnLoan.AcctNbr,
						perOnLoan.PercentOnLoan
					FROM 
						#ctrAccountPercentOnLoan perOnLoan
					INNER JOIN 
