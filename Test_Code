        /// <summary>
        /// This method will validate data
        /// </summary>
        /// <param name="ActionType"></param>
        /// <returns></returns>
        private bool ValidateData(string ActionType)
        {
            bool blnResult = true;

            if (ActionType != enumActionType.RECALLSETUPFROMNONSALETAB.ToString() && ActionType != enumActionType.CREATERECALL.ToString() && ActionType != enumActionType.NSRSCREATERECALL.ToString() && ActionType != enumActionType.RETURNQUEUE.ToString())  //Neelima 
            {

                string SaleStatus = null;
                CheckBox chkInclude = null;

                foreach (DataGridItem item in grdSalesRecord.Items)
                {
                    SaleStatus = item.Cells[(int)grdSalesRecordMapping.SaleStatus].Text.ToString();
                    chkInclude = (CheckBox)item.Cells[(int)grdSalesRecordMapping.chkInclude].FindControl("chkInclude");

                    if (SaleStatus != null && chkInclude != null && chkInclude.Checked == true && blnResult == true && SaleStatus == "2" && ActionType.ToUpper() == "RECALLSETUP")
                    {
                        blnResult = false;
                        _ErrorString = new StringBuilder();
                        _ErrorString.Append(Common.GetMessage("Sales", "SelectRecallRecords"));
                    }
                    else if (SaleStatus != null && chkInclude != null && chkInclude.Checked == true && blnResult == true && SaleStatus == "3" && ActionType.ToUpper() == "REALLOCATE")
                    {
                        blnResult = false;
                        _ErrorString = new StringBuilder();
                        _ErrorString.Append(Common.GetMessage("Sales", "SelectReallocateRecords"));
                    }
                }
            }
            else if (ActionType == enumActionType.RECALLSETUPFROMNONSALETAB.ToString())
            {
                if (cboNSBrokerCrGroup.SelectedValue == "0" && cboNSBrokerGroup.SelectedValue == "0" && cboNSBroker.SelectedValue == "0" && txtNSSecCode.Text.Trim() == string.Empty && txtNSLoanNbr.Text.Trim() == string.Empty)
                {
                    blnResult = false;
                    _ErrorString = new StringBuilder();
                    _ErrorString.Append(Common.GetMessage("Sales", "NonSaleSearchMsg"));
                }
            }
            else if (ActionType == enumActionType.RETURNQUEUE.ToString())   //Neelima 
            {
                if (txtRQRrecallDate.Text.Trim() == string.Empty)
                {
                    blnResult = false;
                    _ErrorString = new StringBuilder();
                    _ErrorString.Append(Common.GetMessage("Sales", "NonSaleSearchMsg"));
                }
            }
            else if (ActionType == enumActionType.CREATERECALL.ToString())
            {
                Control container = null;
                DataGridItem dgi = null;
                for (int iSaleRecallCount = 0; iSaleRecallCount < dgSalesRecall.Items.Count; iSaleRecallCount++)
