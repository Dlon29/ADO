        /// <param name="source"></param>
        /// <param name="e"></param>
        private void grdDetail_ItemDataBound(object sender, System.Web.UI.WebControls.DataGridItemEventArgs e)
        {
            /*
            * Column 6 - ImgEdit 
            * Column 7 - ImgDelete 
            */
            MethodName = "grdDetail_ItemDataBound()";

            try
            {
                if (e.Item.ItemType == ListItemType.Item ||
                        e.Item.ItemType == ListItemType.AlternatingItem ||
                        e.Item.ItemType == ListItemType.SelectedItem)
                {
                    string AcctId = e.Item.Cells[0].Text;
                    bool IsDeleted = !Convert.ToBoolean(e.Item.Cells[5].Text);
                    string EditScript = null;
                    string DeleteScript = null;

                    if (e.Item.ItemType == ListItemType.AlternatingItem)
                        DeleteScript = Common.HIGHLIGHTROW_TRUE_JAVASCRIPT.ToString();
                    else if (e.Item.ItemType == ListItemType.Item)
                        DeleteScript = Common.HIGHLIGHTROW_FALSE_JAVASCRIPT.ToString();

                    ImageButton ImgEdit = new ImageButton();
                    ImageButton ImgDelete = new ImageButton();

                    // Edit image button 
                    EditScript = DeleteScript;
                    ImgEdit = (ImageButton)e.Item.Cells[6].FindControl("ImgEdit");
                    ImgEdit.Attributes.Add("OnClick", EditScript);
                    ImgEdit.CommandName = "Edit";
                    ImgEdit.ToolTip = "Edit";
                    ImgEdit.CommandArgument = AcctId;

                    // Delete image button 
                    if (_IsDeleteAllowed)
                    {
                        DeleteScript += "return confirm('" + Common.GetMessage("Common", "ErrorRowDeletion") + "');";
                    }
                    else
                    {
                        DeleteScript += "alert('" + Common.GetMessage("Common", "InsuffDeletionRights") + "'); return false;";
                    }

                    ImgDelete = (ImageButton)e.Item.Cells[7].FindControl("ImgDelete");
                    ImgDelete.Attributes.Add("OnClick", DeleteScript);
                    ImgDelete.CommandName = "Delete";
                    ImgDelete.ToolTip = "Delete";
                    ImgDelete.CommandArgument = AcctId;

                    // mark the row as deleted
                    if (IsDeleted)
                    {
                        StringBuilder QueryString = new StringBuilder();

                        QueryString.Append("?AcctId=");
                        QueryString.Append(AcctId);
                        QueryString.Append("&BatchRunDate=");
                        QueryString.Append(_BatchRunDate);

                        string temp = e.Item.Cells[1].Text;
                        e.Item.Cells[1].Text = "<a href=\"Javascript: PopUpWindow('/LAVA/Maintenance/SaleReconUploadProblems.aspx" + QueryString.ToString() + "', '', 'width=800,height=500,scrollbars,resizable=no,screenX=0,screenY=0,left=0,top=0');\">" + temp + "</a>";
                        e.Item.CssClass = Common.enumStyleCSS.DeletedItemStyle.ToString();
                        ImgEdit.ToolTip = "Correct";

                    }
                }
            }
            catch (Exception Exc)
            {
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
            }
        }

