
using System.Collections.Generic;
using System.Linq;

namespace SMTBUSA.Messaging
{
    public class RabbitMQAdminQueueManager
    {
        /// <summary>
        /// Retrieves RabbitMQ settings for the specified section and queue.
        /// </summary>
        public RabbitMQSettings GetRabbitMQSettings(
            string sectionName,
            string queueName)
        {
            var rabbitMQAdminService =
                RabbitMQAdmin.Client.ServiceProxyFactory.Instance
                    .CreateRabbitMQAdminServiceProxy();

            List<RabbitMQSettings> rabbitMQSettingsList =
                rabbitMQAdminService
                    .GetAndInitializeRabbitMQSettingsListBySection(
                        sectionName);

            Dictionary<string, RabbitMQSettings> rabbitMQSettingsDict =
                rabbitMQSettingsList.ToDictionary(
                    settings => settings.BindingID);

            return rabbitMQSettingsDict[queueName];
        }

        /// <summary>
        /// Posts a GI message into the specified RabbitMQ queue.
        /// </summary>
        public bool PostGIMessageInQueue(
            string sectionName,
            string queueMessage,
            string queueName)
        {
            RabbitMQSettings rabbitMQSettings =
                GetRabbitMQSettings(sectionName, queueName);

            RabbitMQClient rabbitMQClient =
                new RabbitMQClient(rabbitMQSettings);

            rabbitMQClient.PostMQMessage(queueMessage);

            return true;
        }
    }
}











using System;
using Common.Logging;
using SMTBUSA.Messaging;

namespace CAPS
{
    public class MessageQueue
    {
        #region Static readonly variables declarations

        private const string rabbitMQSection = "giRabbitMQ";

        private static readonly RabbitMQAdminQueueManager
            _rabbitMQQueueManager = new RabbitMQAdminQueueManager();

        #endregion

        #region Private Variables

        private static ILog _logger =
            LogManager.GetLogger(typeof(MessageQueue));

        #endregion

        #region InitializeRabbitMQ service

        /// <summary>
        /// This method is used to initialize RabbitMQ settings
        /// and test the loopback method.
        /// </summary>
        /// <param name="sectionName"></param>
        /// <param name="queueName"></param>
        /// <returns></returns>
        public static bool InitializeRabbitMQSettings(
            string sectionName,
            string queueName)
        {
            bool isLoopBackSuccess_GI = false;

            try
            {
                RabbitMQSettings rabbitMQSettings =
                    _rabbitMQQueueManager.GetRabbitMQSettings(
                        rabbitMQSection,
                        queueName);

                isLoopBackSuccess_GI =
                    QueueLoopBackTest(rabbitMQSettings);
            }
            catch (Exception e)
            {
                _logger.Error(
                    "Error occurred in InitializeRabbitMQSettings - MessageQueue",
                    e);

                throw;
            }

            return isLoopBackSuccess_GI;
        }

        #endregion

        #region Queue Methods

        /// <summary>
        /// This method checks the loopback method of RabbitMQ.
        /// </summary>
        /// <param name="objRabbitMQSettings"></param>
        /// <returns></returns>
        public static bool QueueLoopBackTest(
            RabbitMQSettings objRabbitMQSettings)
        {
            bool isChkSuccess = false;

            try
            {
                HealthCheck queueCheck =
                    new HealthCheck(
                        objRabbitMQSettings.HostName,
                        objRabbitMQSettings.PortNumber,
                        objRabbitMQSettings.Username,
                        objRabbitMQSettings.Password,
                        objRabbitMQSettings.VHost);

                queueCheck.ExchangeName =
                    objRabbitMQSettings.ExchangeName;

                queueCheck.QueueName =
                    objRabbitMQSettings.QueueName;

                isChkSuccess = queueCheck.LoopBack();
            }
            catch (Exception ex)
            {
                _logger.Error(
                    "Error occurred in QueueLoopBackTest - MessageQueue",
                    ex);

                throw;
            }

            return isChkSuccess;
        }

        /// <summary>
        /// This method posts GI message in TRACR GI queue.
        /// </summary>
        /// <param name="queueMessage"></param>
        /// <param name="queueName"></param>
        /// <returns></returns>
        public static bool PostGIMessageInQueue(
            string queueMessage,
            string queueName)
        {
            bool isSuccess = false;

            try
            {
                isSuccess =
                    _rabbitMQQueueManager.PostGIMessageInQueue(
                        rabbitMQSection,
                        queueMessage,
                        queueName);
            }
            catch (Exception e)
            {
                _logger.Error(
                    "Error occurred in PostGIMessageInQueue - MessageQueue",
                    e);

                throw;
            }

            return isSuccess;
        }

        #endregion
    }
}
