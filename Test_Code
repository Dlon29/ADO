        static bool fncReadConfiguration()
        {
            try
            {
                // application root directory
                if (_AppRoot == null)
                    _AppRoot = ConfigurationManager.AppSettings["appRoot"];

                // application version
                if (_AppVersion == null)
                    _AppVersion = ConfigurationManager.AppSettings["appVersion"];

                // Assembly version
                if (_AssemblyVersion == null)
                {
                    Version vs = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version;
                    _AssemblyVersion = vs.Major.ToString() + "." + vs.Minor.ToString() + "." + vs.Build.ToString() + "." + vs.Revision.ToString();
                }



                /********************************************/
                /*		DATABASE CONNECTION INFORMATION		*/
                /********************************************/
                #region  Added New Code for Connection string From web.config
                string connectionString = ConfigurationManager.ConnectionStrings["MoBetterConn"].ConnectionString;

                _AppConnectionString = connectionString;
                SqlConnectionStringBuilder builder = new SqlConnectionStringBuilder(connectionString);


                string database = builder.InitialCatalog;
                _DBServerName = builder.DataSource;
                _DBName = builder.InitialCatalog;
                _DBUserID = builder.UserID;
                _DBPassword = builder.Password;
                _DBIntegratedSecurity = builder.IntegratedSecurity;

                #endregion

                // application server 
                if (_AppRuntimeServer == null)
                {
                    if (ConfigurationManager.AppSettings["appRuntimeServer"] == "")
                        _AppRuntimeServer = HttpContext.Current.Server.MachineName;
                    else
                        _AppRuntimeServer = ConfigurationManager.AppSettings["appRuntimeServer"];
                }

                // application server 
                if (_AppFileServer == null)
                {
                    if (ConfigurationManager.AppSettings["appFileServer"] == "")
                        _AppFileServer = _AppRuntimeServer;
                    else
                        _AppFileServer = ConfigurationManager.AppSettings["appFileServer"];
                }

                if (_ServerConfigPath == null)
                {
                    _ServerConfigPath = ConfigurationManager.AppSettings["server.config.path"];
                }

                //HttpContext.Current.Response.Write("_AppLogFile:" + _AppLogFile);
                //System.Web.HttpContext.Current.Server.MapPath(@"../")

                //get application code
                if (_AppCode == null)
                    _AppCode = ConfigurationManager.AppSettings["appCode"];

                //get environment code D/P/Q
                if (_AppEnvironment == null)
                    _AppEnvironment = ConfigurationManager.AppSettings["appEnvironment"];

                if (_DRSYN == null)
                {
                    _DRSYN = ConfigurationManager.AppSettings["drs"];

                    if (_DRSYN.Length > 0)
                    {
                        if (_DRSYN.Trim().Substring(0, 1).ToUpper() == "Y")
                            _IsDRS = true;
                        else
                            _IsDRS = false;
                    }
                    else
                        _IsDRS = false;
                }

                //get tracelevel
                string sTraceLevel = null;
                sTraceLevel = ConfigurationManager.AppSettings["traceLevel"];
                try
                {
                    _TraceLevel = Convert.ToInt32(sTraceLevel);
                }
                catch (FormatException)
                {
                    _TraceLevel = 0;
                }

                if (string.IsNullOrEmpty(_environment))
                { _environment = ConfigurationManager.AppSettings["MOBETTEREnvironment"] ?? string.Empty; }

                if (string.IsNullOrEmpty(_environmentKeyColor))
                { _environmentKeyColor = ConfigurationManager.AppSettings["MOBETTEREnvironmentForecolor"] ?? string.Empty; }
            }

            catch (Exception)
            {
                return false;
            }

            return true;
        }


        #endregion


    }

