        public static void WriteJavascript(string js)
        {
            StringBuilder scr = new StringBuilder();
            try
            {
                scr.Append("<script language = \"JavaScript\">\n");
                scr.Append(js);
                scr.Append("\t\t</script>\n");
                HttpContext.Current.Response.Write(scr.ToString());
            }

            catch (Exception e)
            {
                scr.Length = 0;
                scr.Append("<script language = \"JavaScript\">\n");
                scr.Append("alert('The following error occured while writing javascript :\\n");
                scr.Append(e.Message);
                scr.Append("')");
                scr.Append("\t\t</script>\n");
                HttpContext.Current.Response.Write(scr.ToString());
                return;
            }

            finally
