        /// <summary>
        /// This method will create XML
        /// </summary>
        /// <param name="itemList"></param>
        /// <param name="AttributeName"></param>
        /// <returns></returns>
        private StringBuilder GetXML(string itemList, string AttributeName)
        {
            StringBuilder XmlDoc = new StringBuilder();
            string[] list = null;
            int RecCount = 0;

            XmlDoc.Append("<ROOT>\n");

            if (itemList != null && itemList != string.Empty)
            {
                list = itemList.Split('|');

                foreach (string item in list)
                {
                    // innerList = item.Split('|');
                    if (item != string.Empty)
                    {

                        XmlDoc.Append("\t<record ");

                        XmlDoc.Append(AttributeName + "=");
                        XmlDoc.Append("\"");
                        XmlDoc.Append(item.ToString());
                        XmlDoc.Append("\" ");

                        XmlDoc.Append(">");
                        XmlDoc.Append("</record>\n");
                        RecCount++;
                    }
                }
            }

            XmlDoc.Append("</ROOT>\n");

            if (RecCount == 0)
            {
                XmlDoc.Length = 0;
                return XmlDoc;
            }
            return XmlDoc;
        }

