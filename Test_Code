							MktValueLoanUSD,
							PercentOnLoan,
							CanUseAcctForCleanUp,
							IsPoolUpdated,
							--isFITokyoRepo,
							isFITokyoSecLend,
							IsFISTBUSA,
							blnUnitsAvail,
							SecLoc,
							SMODE,
							IsAgentDirectLending,
							AcctGrpID,
