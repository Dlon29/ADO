		SEDOL							VARCHAR(7),
		ISIN							VARCHAR(12),
		SecCode							VARCHAR(12),
		BucketSecType					VARCHAR(5),
		DateEX							DATETIME,
		RecordDate						DATETIME,
		DivRate							DECIMAL(15,8),
		SecurityDesc1					VARCHAR(40),
		SecurityDesc2					VARCHAR(40),
		ISOCountry						VARCHAR(100),
		TickSymb						VARCHAR(12),
		CcyCode							VARCHAR(3),
		PriceBaseCurrency				DECIMAL (15,8),
		Price							DECIMAL (15,8),
		FxRate							DECIMAL (19,8)	DEFAULT 1, --FXRate is defaulted for 1 to avoid divide by zero error for securities w/o price
		TotalHolding					BIGINT,
		USOnLoan						BIGINT,
		LdnOnLoan						BIGINT,
		TotalOnLoan						BIGINT,
		USTraderLendable				BIGINT,	--Units available to lend for US before availability restrictions and after deducting loans
		LdnTraderLendable				BIGINT, --Units available to lend for London before availability restrictions and after deducting loans
		TotalTraderLendable				BIGINT, --Total Units available to lend before availability restrictions and after deducting loans
		TotalTraderLendableAfterAllRest	BIGINT, --Total Units available to lend after all other restrictions and after deducting loans
		UnitsAvailToLend				BIGINT,	--Total Units available to lend to (US or London)after deducting loans and considering Finder restriction flag
		USBrokerLendable				BIGINT, --Units available to lend for US after availability restrictions and after deducting loans
		LdnBrokerLendable				BIGINT, --Units available to lend for London after availability restrictions and after deducting loans
		TotalBrokerLendable				BIGINT, --Total Units available to lend after availability restrictions and after deducting loans
		TotalBrokerLendableAfterAllRest	BIGINT, --Total Units available to lend after availability and all other restrictions and after deducting loans
		UnitsAvailToLendRest			BIGINT,	--Total Units available to lend to (US or London)after availability restrictions and after deducting loans and considering Finder restriction flag
		Is_DedicatedMarginCollateral_FISecurity INT DEFAULT 0,
