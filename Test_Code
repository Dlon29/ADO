        public static string ReportGenerationExceptions(string exc)
        {
            switch (exc)
            {
                case string x when x.Contains("does not belong to table Table") && !x.Contains("This can be due to incorrect Database column Name mapping for this section"):
                    return " This can be due to incorrect Database column Name mapping for this section.";
                    break;
                case string x when x.Contains("'name' argument cannot be null.\r\nParameter name: name") && !x.Contains("This can be due to missing Database column Name mapping for this section"):
                    return " This can be due to missing Database column Name mapping for this section.";
                    break;
                case string x when x.Contains("Sequence contains no elements") && !x.Contains("This can be due to missing Database configuration for this section"):
                    return " This can be due to missing Database configuration for this section.";
                    break;
                case string x when x.Contains("Cannot find table") && !x.Contains("This can be due to missing (on incorrectly mapped) Database table for a section"):
                    return " This can be due to missing (on incorrectly mapped) Database table for a section.";
                    break;
                case string x when x.Contains("Unknown error: No accounts found on supplied parameters") && !x.Contains("No accounts found on supplied parameters."):
                    return "No accounts found on supplied parameters.";
                    break;
                default:
                    return "";

            }
        }
