                                    if (!chkFullRecall.Checked && chkFullRecall.Visible)
                                        TxnRefNbr = lnkTxnRefNbr.Text;

                                    if (txtSharesToRecall != null && hdnSharesToRecall != null && TxnRefNbr == lnkTxnRefNbr.Text)
                                        txtSharesToRecall.Text = hdnSharesToRecall.Value.Trim();
                                }
                            }

                        }
                    }
                }

                else if (chkBoxID == "chkNSFullRecall")
                {
                    CheckBox chkFullRecall = (System.Web.UI.WebControls.CheckBox)sender;
                    Label lblLoanQtyAllocatedTOAcct = null;
                    HyperLink lnkTxnRefNbr = null;
                    string TxnRefNbr = string.Empty;

                    if (((CheckBox)sender).Checked)
                    {
                        for (int i = 0; i < dgNSLoanData.Items.Count; i++)
                        {
                            txtSharesToRecall = (TextBox)dgNSLoanData.Items[i].Cells[(int)dgNSLoanDataMapping.SharesToRecall].FindControl("txtNSSharesToRecall");
                            lblLoanQtyAllocatedTOAcct = (Label)dgNSLoanData.Items[i].Cells[(int)dgNSLoanDataMapping.LoanQtyAllocatedTOAcct].FindControl("lblNSLoanQtyAllocatedTOAcct");
                            lnkTxnRefNbr = (HyperLink)dgNSLoanData.Items[i].Cells[(int)dgNSLoanDataMapping.TxnRefNbr].FindControl("lnkNSTxnRefNbr");
                            chkFullRecall = (CheckBox)dgNSLoanData.Items[i].Cells[(int)dgNSLoanDataMapping.TxnRefNbr].FindControl("chkNSFullRecall");

                            if (chkFullRecall.Checked)
                                TxnRefNbr = lnkTxnRefNbr.Text;

                            if (txtSharesToRecall != null && lblLoanQtyAllocatedTOAcct != null && TxnRefNbr == lnkTxnRefNbr.Text)
                                txtSharesToRecall.Text = lblLoanQtyAllocatedTOAcct.Text.Trim();
                        }
                    }
                    else
                    {
                        for (int i = 0; i < dgNSLoanData.Items.Count; i++)
                        {
                            txtSharesToRecall = (TextBox)dgNSLoanData.Items[i].Cells[(int)dgNSLoanDataMapping.SharesToRecall].FindControl("txtNSSharesToRecall");
                            lblLoanQtyAllocatedTOAcct = (Label)dgNSLoanData.Items[i].Cells[(int)dgNSLoanDataMapping.LoanQtyAllocatedTOAcct].FindControl("lblNSLoanQtyAllocatedTOAcct");
                            lnkTxnRefNbr = (HyperLink)dgNSLoanData.Items[i].Cells[(int)dgNSLoanDataMapping.TxnRefNbr].FindControl("lnkNSTxnRefNbr");
                            chkFullRecall = (CheckBox)dgNSLoanData.Items[i].Cells[(int)dgNSLoanDataMapping.TxnRefNbr].FindControl("chkNSFullRecall");

                            if (!chkFullRecall.Checked && chkFullRecall.Visible)
                                TxnRefNbr = lnkTxnRefNbr.Text;

                            if (txtSharesToRecall != null && lblLoanQtyAllocatedTOAcct != null && TxnRefNbr == lnkTxnRefNbr.Text)
                                txtSharesToRecall.Text = "";
                        }
                    }
                }



                if (chkBoxID == "chkExcludeRecall" || chkBoxID == "chkCreateRecall")
                {
                    CheckBox chkCheckedItem = (System.Web.UI.WebControls.CheckBox)sender;
                    DataGridItem dgItem = chkCheckedItem.Parent.Parent as DataGridItem;
                    int iExcludeRecallCount = 0;

                    if (dgItem != null)
                    {
                        dgLoanRecall = (DataGrid)dgItem.Parent.Parent;

                        if (dgLoanRecall != null)
                        {

                            for (int i = 0; i < dgLoanRecall.Items.Count; i++)
                            {
                                CheckBox chkExcludeRecall = (CheckBox)dgLoanRecall.Items[i].Cells[(int)dgLoanRecallMapping.chkExcludeRecall].FindControl("chkExcludeRecall");


                                if (chkExcludeRecall != null && chkExcludeRecall.Checked)
                                {
                                    iExcludeRecallCount += 1;
                                }
                            }

                            if (iExcludeRecallCount > 0)
                            {
                                _blnRecallExcluded = true;
                                hdnExcludeRecall.Value = "true";
                            }
                            else
                            {
                                _blnRecallExcluded = false;
                                hdnExcludeRecall.Value = "false";
                            }
                        }
                    }

                    //Commented by Neelima on 16-July-2014 To remove Recalculate functionality and Enable the Create Recall button.
                    //    cmdSRSCreateRecall1.Enabled =
                    //        cmdSRSCreateRecall2.Enabled = false;

                }
            }
            catch (Exception Exc)
            {
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
            }

        }

        #endregion
        
    }
