		'' UseTraderLendable,
		'' UseAmount,
		'' as DesiredSTTLevel,
		'' as IsProjectedDividend,
		CONVERT(DECIMAL,NULL) as ProjectedDividendAmount,
		'' as ISOCountry,
		@ErrorRowSeq RowSeq,
		'' as DivRateForAlloc,
		IsBlocked = dbo.f_IsSecurityBlocked (SecID,@BussDate),
		0 AS isQtyGreaterThanBrkLendable	,
		Is_DedicatedMarginCollateral_FISecurity ,
		Is_FISecurity_Matured ,
		Default_Open_TPUID AS TPUID,
		Default_Open_TPUID,		
		Default_Term_TPUID,
		IsPrePay 
	FROM 
		@USVsLndAvailability 
	ORDER BY 
		RecordDate DESC





	DROP TABLE #TempSecurity
	DROP TABLE #PendingTbl
END



