        public static bool IsTime(string strToCheck)
        {
            /*
			 * Function to Check for Time for 24 Clock Time and AM/PM             			 
			 * */

            Regex objDatePattern = new Regex(@" ^((0?[1-9]|1[012])(:[0-5]\d){0,2}(\ [AP]M))$|^([01]\d|2[0-3])(:[0-5]\d){0,2}$");
