        public static DateTime GetPreviousQuarterEndDate()
        {
            DateTime PrevQtrDate = DateTime.Now;

            if ((Month)DateTime.Now.Month <= Month.March)
                //go to last quarter of previous year
                PrevQtrDate = GetStartOfQuarter(DateTime.Now.Year - 1, Quarter.Fourth).AddDays(-1);
            else if (((Month)DateTime.Now.Month >= Month.April) && ((Month)DateTime.Now.Month <= Month.June))
                //go to first quarter of Current year
                PrevQtrDate = GetStartOfQuarter(DateTime.Now.Year, Quarter.First).AddDays(-1);
            else if (((Month)DateTime.Now.Month >= Month.July) && ((Month)DateTime.Now.Month <= Month.September))
                //go to Second quarter of Current year
                PrevQtrDate = GetStartOfQuarter(DateTime.Now.Year, Quarter.Second).AddDays(-1);
            else //go to Third quarter of Current year
                PrevQtrDate = GetStartOfQuarter(DateTime.Now.Year, Quarter.Third).AddDays(-1);

            if (DateTime.Now.ToShortDateString() == _QtrEndDate1)
                PrevQtrDate = GetStartOfQuarter(DateTime.Now.Year, Quarter.First).AddDays(-1);
            else if (DateTime.Now.ToShortDateString() == _QtrEndDate2)
                PrevQtrDate = Convert.ToDateTime(_QtrEndDate1);
            else if (DateTime.Now.ToShortDateString() == _QtrEndDate3)
                PrevQtrDate = Convert.ToDateTime(_QtrEndDate2);
            else if (DateTime.Now.ToShortDateString() == _QtrEndDate4)
                PrevQtrDate = Convert.ToDateTime(_QtrEndDate3);

            return PrevQtrDate;
        }



