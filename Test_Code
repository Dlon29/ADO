                    /*roup Group Total Formula  Wont work with Pivot Table
                    //Note: Updating the Group Total row end index on pivoting the data
                    groupTotalRowLocation[3] = Convert.ToString(Convert.ToInt32(groupTotalRowLocation[3]) + (headersCount - 1) * pivotColumns.Count());
                    */


                    DBTempHeader dBTempHeader;
