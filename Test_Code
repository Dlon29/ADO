                        //            {
                        //                if (startRow == Convert.ToInt32(getSectionPosition[(int)Cell.Row]))
                        //                    workSheetTemplate[startRow, (SecColumn + colIndex)].Formula = dBTempHeader.Formula.Replace("$", (startRow + 1).ToString());
                        //                else
                        //                    workSheetTemplate[startRow, (SecColumn + colIndex)].Formula = dBTempHeader.Formula.Replace("$", (startRow + 1 + 1).ToString());
                        //            }
                        //            else
