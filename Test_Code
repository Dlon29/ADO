        /// <summary>
        /// This function is used to change the Group row line format.
        /// </summary>
        /// <param name="XlGroupRowStyleValue">Group row line format name coming from template config key section</param>
        /// <returns></returns>
        private XLLineStyleEnum ConvertStringToXlLineStyleEnum(string XlGroupRowStyleValue)
        {
            switch (XlGroupRowStyleValue.ToLower())
            {
                case "none":
                    return XLLineStyleEnum.None;
                case "thin":
                    return XLLineStyleEnum.Thin;
                case "medium":
                    return XLLineStyleEnum.Medium;
                case "dashed":
                    return XLLineStyleEnum.Dashed;
                case "dotted":
                    return XLLineStyleEnum.Dotted;
                case "thick":
                    return XLLineStyleEnum.Thick;
                case "double":
                    return XLLineStyleEnum.Double;
                case "hair":
                    return XLLineStyleEnum.Hair;
                case "mediumdashed":
                    return XLLineStyleEnum.MediumDashed;
                case "thindashdotted":
                    return XLLineStyleEnum.ThinDashDotted;
                case "mediumdashdotted":
                    return XLLineStyleEnum.MediumDashDotted;
                case "thindashdotdotted":
                    return XLLineStyleEnum.ThinDashDotDotted;
                case "mediumdashdotdotted":
                    return XLLineStyleEnum.MediumDashDotDotted;
                case "slantedmediumdashdotted":
                    return XLLineStyleEnum.SlantedMediumDashDotted;
                default:
                    return XLLineStyleEnum.Thin;
            }
        }

        public virtual void WriteSectionForPivotGroup(string sheet, string section, DataTable dtSection, DataTable dtHeaderSection, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, Dictionary<string, string> configKeys, ref XLSheet workSheetTemplate, ref C1XLBook workBookTemplate, ref int rowInsertCount, List<string> dBDynamicColumns = null, int? sheetIndex = null)
        {
            try
            {
                //Data Section
                //Variables for Generic reports
                var sectionKey = sheet + section;
                var getSectionPosition = configSections[sectionKey].SectionValue.Split(','); // Get starting Row and Column position from config collection.
                int SecRow = Convert.ToInt32(getSectionPosition[(int)Cell.Row]), SecColumn = Convert.ToInt32(getSectionPosition[(int)Cell.Column]);
