        void backgroundWorker1_DoWork(object sender, DoWorkEventArgs e)
        {
            DateTime currentDateTime;
            TimeSpan? StartTime = null;
            TimeSpan? EndTime = null;
            bool IsWeekendEnabled = false;
            bool isConsuming = true;

            iMaxRetries = Convert.ToInt32(appConfig.AppSettings.Settings["MaxRetries"].Value);
            string StartHour = string.IsNullOrEmpty(appConfig.AppSettings.Settings["SleepStartHour"].Value) ? "" : appConfig.AppSettings.Settings["SleepStartHour"].Value;
            string EndHour = string.IsNullOrEmpty(appConfig.AppSettings.Settings["SleepEndHour"].Value) ? "" : appConfig.AppSettings.Settings["SleepEndHour"].Value;
            string SleepDays = string.IsNullOrEmpty(appConfig.AppSettings.Settings["SleepDays"].Value) ? "" : appConfig.AppSettings.Settings["SleepDays"].Value;

            iRetries = iMaxRetries;

            if (StartHour.Contains(":") && EndHour.Contains(":"))
            {
                StartTime = new TimeSpan(Convert.ToInt32(StartHour.Substring(0, StartHour.IndexOf(@":"))), Convert.ToInt32(StartHour.Substring(StartHour.IndexOf(@":") + 1)), 0);
                EndTime = new TimeSpan(Convert.ToInt32(EndHour.Substring(0, EndHour.IndexOf(@":"))), Convert.ToInt32(EndHour.Substring(EndHour.IndexOf(@":") + 1)), 0);
            }
            else
            {
                log.ErrorFormat(" FOR EquilendERPAIntranet_Sub Service on {0}. Invalid Sleep Start or End Hour format.Please specify in 24 hours (HH:MM) format.", Environment.MachineName);
            }



            string HostName = appConfig.AppSettings.Settings["HostName"].Value;
            int Port = Convert.ToInt32(appConfig.AppSettings.Settings["Port"].Value);
            string UserName = appConfig.AppSettings.Settings["UserName"].Value;
            string PassWord = appConfig.AppSettings.Settings["PassWord"].Value;
            string vHost = appConfig.AppSettings.Settings["vHost"].Value;
            string ExchangeName = appConfig.AppSettings.Settings["ExchangeName"].Value;
            string QueueName = appConfig.AppSettings.Settings["QueueName"].Value;
            string QueueKey = appConfig.AppSettings.Settings["QueueKey"].Value;


            while (true)
            {
                currentDateTime = DateTime.Now;
                IsWeekendEnabled = false;

                try
                {
                    foreach (string sleepDay in SleepDays.Split(new string[] { "||" }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        if (sleepDay.Length == 1 && (int)currentDateTime.DayOfWeek == Convert.ToInt32(sleepDay))
                        {
                            log.Info(" EquilendERPAIntranet_Sub Service will not execute on weekends");
                            IsWeekendEnabled = true;
                        }
                    }

                    if (!IsWeekendEnabled)
                    {
                        if (IsServiceSleeping(currentDateTime, StartTime, EndTime))
                        {
                            log.InfoFormat(" EquilendERPAIntranet_Sub Service will not execute from {0} to {1}.", StartHour.ToString(), EndHour.ToString());

                        }
                        else
                        {
                            ConnectionFactory connectionFactory = new ConnectionFactory()
                            {
                                HostName = HostName,
                                Port = Port,
                                UserName = UserName,
                                Password = PassWord,
                                VirtualHost = vHost,
                                RequestedHeartbeat = 1
                            };        

                            
                            //creating connection to mq broker.
                            using (IConnection conn = connectionFactory.CreateConnection())
                            {
                                //creating channel.
                                using (IModel ch = conn.CreateModel())
                                {

                                    
                                    log.Info(" MQ Connection successfully established.");

                                    ////declare exchange
                                    ch.ExchangeDeclare(ExchangeName, ExchangeType.Direct, true);
                                    ////declare queue
                                    ch.QueueDeclare(QueueName, true, false, false, null);

                                    ////bind to queue
                                    ch.QueueBind(QueueName, ExchangeName, QueueKey); 

                                    //Remove all messages from the queues
                                    //ch.QueuePurge(appConfig.AppSettings.Settings["QueueName"].Value, true);
                                    //creating basic consumer
                                    QueueingBasicConsumer consumer = new QueueingBasicConsumer(ch);
                                    //start consuming at active channel.
                                    log.Info(" Waiting to Consume MQ Message");
                                    //ch.BasicConsume(appConfig.AppSettings.Settings["QueueName"].Value, true, consumer);
                                    ch.BasicConsume(appConfig.AppSettings.Settings["QueueName"].Value, false, consumer);    //SN to make it similar to TriParty Sub
                                    ch.BasicQos(0, 1, false);

                                    while (conn.IsOpen)
                                    {
                                        try
                                        {
                                            // RabbitMQ.Client.Events.BasicDeliverEventArgs bdea =
                                            //    (RabbitMQ.Client.Events.BasicDeliverEventArgs)consumer.Queue.Dequeue();

                                            object result = null;
                                            //retrieving message
                                            isConsuming = consumer.Queue.Dequeue(Convert.ToInt32(appConfig.AppSettings.Settings["MQBusTimeoutMilliseconds"].Value), out result);
                                            RabbitMQ.Client.Events.BasicDeliverEventArgs bdea = result as RabbitMQ.Client.Events.BasicDeliverEventArgs;

                                            if (bdea != null)
                                            {
                                                IBasicProperties props = bdea.BasicProperties;
                                                props.Expiration = appConfig.AppSettings.Settings["MQBusTimeoutMilliseconds"].Value;        //New SN added to give time-out..
                                                // to avoid duplicates
                                                //ch.BasicReject(bdea.DeliveryTag, false);
                                                //retrieving message body
                                                byte[] body = bdea.Body;
                                                // ... process the message
                                                if (body != null)
                                                {
                                                    //ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
                                                    log.Info(" Start processing MQ notification");
                                                    //processing mq message
                                                    ProcessMQMessage(System.Text.Encoding.UTF8.GetString(body));
                                                    log.Info(" End processing MQ notification");
                                                }
                                                //confirming receive of the mq message
                                                ch.BasicAck(bdea.DeliveryTag, false);
                                                log.Info(" confirming receive of the mq message");
                                            }
                                            else
                                            {
                                                //if (sftp != null) sftp.Close();
                                                if (ch != null && ch.IsOpen) ch.Close(200, "Goodbye");
                                                if (conn != null && conn.IsOpen) conn.Close();
                                                break;
                                            }
                                            iRetries = iMaxRetries;
                                        }
                                        catch (OperationInterruptedException oie)
                                        {
                                            // The consumer was removed, either through
                                            // channel or connection closure, or through the
                                            // action of IModel.BasicCancel().
                                            log.ErrorFormat(" FOR EquilendERPAIntranet_Sub Service on {0}. MQ process Operation Interrupted.  {1} ", oie, Environment.MachineName, oie.Message);
                                            if (iRetries == 0)
                                            {
                                                log.FatalFormat(" FOR EquilendERPAIntranet_Sub Service on {0}. MQ process Operation Interrupted.  {1} ", oie, Environment.MachineName, oie.Message);
                                                iRetries = iMaxRetries;
                                            }
                                            else
                                            {
                                                if (iRetries > 0) --iRetries;
                                            }
                                            break;
                                        }
                                        catch (Exception ex)
                                        {
                                            log.ErrorFormat(" FOR EquilendERPAIntranet_Sub Service on {0}. General Exception acknowledging MQ Message.  {1} ", ex, Environment.MachineName, ex.Message);
                                            if (iRetries == 0)
                                            {
                                                log.FatalFormat(" FOR EquilendERPAIntranet_Sub Service on {0}. General Exception acknowledging MQ Message.  {1} ", ex, Environment.MachineName, ex.Message);
                                                iRetries = iMaxRetries;
                                            }
                                            else
                                            {
                                                if (iRetries > 0) --iRetries;
                                            }
                                            break;
                                        }
                                    }
                                    if (ch != null && ch.IsOpen) ch.Close(200, "Goodbye");
                                }
                                if (conn != null && conn.IsOpen) conn.Close();
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    log.ErrorFormat(" FOR EquilendERPAIntranet_Sub Service on {0}.Service Interrupted for the following reason. {1} ", ex, Environment.MachineName, ex.Message);
                    if (iRetries == 0)
                    {
                        log.FatalFormat(" FOR EquilendERPAIntranet_Sub Service on {0}.Service Interrupted for the following reason. {1} ", ex, Environment.MachineName, ex.Message);
                        iRetries = iMaxRetries;
                    }
                    else
                    {
                        if (iRetries > 0) --iRetries;
                    }
                }
                finally
                {
                    //if (sftp != null) sftp.Close();
                    System.Threading.Thread.Sleep(Convert.ToInt32(appConfig.AppSettings.Settings["ThreadSuspendTimeout"].Value));
                }
            }
        }

        private void ProcessMQMessage(string messageJSON)
        {
            Dictionary<string, string> values = null;
            //ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);

            try
            {
                //deserializing json message
                values = JsonConvert.DeserializeObject<Dictionary<string, string>>(messageJSON);
                //values = (Dictionary<string, object>)JSON.Instance.ToObject(messageJSON);
            }
            catch (Exception e)
            {
                log.FatalFormat(" FOR EquilendERPAIntranet_Sub Service on {0}.Error process MQ Message {1} for the following reason. {2} ", e, Environment.MachineName, messageJSON, e.Message);
            }
            string[] files = new string[1];
            string localFilePath = string.Empty;
            bool Status = false;

            switch (values["TransferType"].ToUpper())
            {
                case "SCP":
                    try
                    {
                        files[0] = values["FileToTransfer"];
                        log.Info(" Start SCP file process");
                        localFilePath = appConfig.AppSettings.Settings["DestinationFolder"].Value + files[0];
                        //Status = SCPFileFromRemoteServer(ref appConfig, localFilePath, appConfig.AppSettings.Settings["LocalFileStore"].Value + files[0]);

                    }
                    catch (Exception e)
                    {
                        log.FatalFormat(" FOR EquilendERPAIntranet_Sub Service on {0}.Error in SCP process. {1} ", e, Environment.MachineName, e.Message);
                    }
                    finally
                    {
                        log.Info(" End SCP file process");
                    }
                    break;
                case "SFTP":
                    try
                    {
                        files[0] = values["FileToTransfer"];
                        log.Info("Start SFTP file process");
                        localFilePath = appConfig.AppSettings.Settings["DestinationFolder"].Value + files[0];
                        //     Status = SFTPFilesFromRemoteServer(ref appConfig, localFilePath, appConfig.AppSettings.Settings["LocalFileStore"].Value + files[0]);
                        //>>>>
                        String SftpUserRootFolder = appConfig.AppSettings.Settings["SFTPUserRootFolder"].Value;
                        String remoteFilePath = values["RemoteFolder"];     //SN added to trip SFTP Root folder from DMZ file location..
                        log.Info("Remote File Path in the Message :[" + remoteFilePath + "]");

                        if (remoteFilePath.Contains(SftpUserRootFolder))        //Trim SFTP Root folder to get relative path from SFTP user home account..
                        {
                            remoteFilePath = remoteFilePath.Substring(remoteFilePath.IndexOf(SftpUserRootFolder) + SftpUserRootFolder.Length) + files[0];
                            remoteFilePath = remoteFilePath.Replace('\\', '/');
                        }
                        else
                        {
                            remoteFilePath += files[0];
                        }
                        ///
                        ///>>>>>


                        //Status = SFTPFilesFromRemoteServer(ref appConfig, localFilePath, appConfig.AppSettings.Settings["LocalFileStore"].Value + files[0]);      //SN modified
                        Status = SFTPFilesFromRemoteServer(ref appConfig, localFilePath, remoteFilePath);

                        //>>>>
                    }
                    catch (Exception e)
                    {
                        log.FatalFormat(" FOR EquilendERPAIntranet_Sub Service on {0}.Error in SFTP process. {1} ", e, Environment.MachineName, e.Message);
                    }
                    finally
                    {
                        log.Info(" End SFTP file process");
                    }
                    break;
                default:
                    log.Info(String.Format(" {0} transfer type not implemented yet", values["TransferType"]).ToUpper());
                    break;
            }

            try
            {
                // new Thread (new ThreadStart(() => { if (Status) processFile(localFilePath); })).Start() ;
                taskFactory.StartNew(() => { if (Status) processFile(localFilePath); });
            }
            catch (Exception e)
            {
                log.FatalFormat(" FOR EquilendERPAIntranet_Sub Service on {0}.Error in processing file. {1} ", e, Environment.MachineName, e.Message);

            }
        }

        private void processFile(string fileLocation)
        {
            //ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
            log.Info(" Start file processing");

            try
            {
                FileInfo theFile = new FileInfo(fileLocation);
                if (!theFile.Exists)
                {
                    log.FatalFormat(" EquilendERPAIntranet_Sub Service on {0}.Process file not available on destination folder {1} ", Environment.MachineName, fileLocation);
                    return;
                }

                using (StreamReader file = new StreamReader(fileLocation, true))
                {
                    string line = string.Empty;
                    string[] headers = null, values = null;
                    char[] separator = { ',' };
                    StringBuilder sb = new StringBuilder();
                    string fileName = string.Empty;
                    string filePrefix = string.Empty;
                    fileName = theFile.Name;
                    //string filePrefix = filePrefix.Substring(0, filePrefix.LastIndexOf('.') - 1);
                    filePrefix = fileName.Substring(0, fileName.IndexOf('_'));

                    XElement root = null;
                    switch (filePrefix)
                    {
                        case "OOIN-ABIN": //auto borrow initial request
                        case "SHTT-ABCO": //shared tickets
                        case "RTCS-IN": // returns contract specific 
                        case "RTCB-IN": // return criteria based
                        case "ORAC-ABCA": //cancelation 
                        case "RTAC-RECO": //returns Reject Confirmation    
                        case "RTAC-ACCO": //returns Accept Confirmation    
                        case "RCAC-AC":     // recall Accept
                        case "RCAC-RE":     // recall Reject
                        case "RCCB-INCO":   // recall request conf
                        case "RCCS-INCO":   // recall request conf
                        case "RCAC-CACO":

                            // prepare xml body
                            root = new XElement("root");

                            //sb.Append("<root>");
                            for (int i = 0; (line = file.ReadLine()) != null; i++)
                            {
                                if (i == 0)
                                {
                                    headers = line.Split(separator);
                                }
                                else
                                {
                                    if (line.ToLower().Contains("equilendid") || line.ToLower().Contains("equilendreturnid") || line.ToLower().Contains("equilendrecallid") || line.Length == 0) continue; // Skip records with headers duplicated.
                                    values = line.Split(separator);
                                }

                                if (values != null && values.Length > 0)
                                {
                                    XElement record = new XElement("record");
                                    //sb.Append("<record");
                                    for (int j = 0; j < headers.Length; j++)
                                    {
                                        XAttribute atr = new XAttribute(headers[j].ToUpper(), values[j]);

                                        //sb.Append(" " + headers[j] + "=\"" + values[j] + "\"");
                                        record.Add(atr);
                                    }
                                    root.Add(record);
                                    //sb.Append("/>");
                                }
                            }
                            //sb.Append("</root>");
                            break;
                        case "ERPA-NO": // error payload
                            //XmlDocument doc = new XmlDocument();
                            //doc.Load(fileLocation.ToLower().Replace(".out",".xml")); 
                            //XmlCDataSection cDataNode = (XmlCDataSection)(doc.SelectSingleNode("EQL_Message/EQL_Body/errorPayload/msgdata").ChildNodes[0]);
                            //root = XElement.Parse(cDataNode.Data);
                            //sb.Append(cDataNode.Data);
                            // Load Only EQL_Body Section in XElement object Memory                            
                           
                            string tmp = null;
                            //Convert XML File to String and get rid of unprintable characters.
                            using (TextReader ERPAreader = new StreamReader(fileLocation))
                            {
                                 tmp = ERPAreader.ReadToEnd();
                            }

                            root = XElement.Parse(getRidOfUnprintablesAndUnicode(tmp)).Element("EQL_Body");    
                            //root = XElement.Load(fileLocation).Element("EQL_Body");
                            break;
                       
                    }
                    file.Close();
                    if (UpdateDatabase(fileName, filePrefix, ref root))
                    {
                        if (theFile.Directory.GetDirectories().Count(d => d.Name.ToLower() == "processedfiles") == 0)
                        {
                            theFile.Directory.CreateSubdirectory("ProcessedFiles");
                        }
                        string filePath = Path.Combine(theFile.Directory.FullName, "ProcessedFiles", fileName);


                        if (!File.Exists(filePath)) theFile.MoveTo(filePath);
                    }
                }
            }
            catch (Exception e)
            {
                log.FatalFormat(" FOR EquilendERPAIntranet_Sub Service on {0}.Error in executing file process.{1} ", e, Environment.MachineName, e.Message);

            }
            log.Info(" End file processing");
        }

