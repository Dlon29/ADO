using System.Collections.Generic;

// Add the RabbitMQAdmin namespace imports required by these types.
// Use the actual namespaces from your existing references.

namespace SMTBUSA.Messaging
{
    public class RabbitMQMessagePublisher
    {
        public void PostMessage(
            string logId,
            string mqSection,
            string mqId)
        {
            var rabbitMQAdminService =
                RabbitMQAdmin.Client.ServiceProxyFactory.Instance
                    .CreateRabbitMQAdminServiceProxy();

            Dictionary<string, RabbitMQSettings> settings =
                rabbitMQAdminService
                    .GetAndInitializeRabbitMQSettingsListBySection(mqSection);

            RabbitMQClient requestQueue =
                new RabbitMQClient(settings[mqId]);

            requestQueue.PostMQMessage(logId);
        }
    }
}










using System;
using SMTBUSA.Messaging;

namespace SLIC.BusinessLogic.Messaging
{
    public class MQHandler
    {
        public MQHandler()
        {
        }

        public void PostMessage(
            string pstrLogid,
            string pstrMqSection,
            string pstrMqId)
        {
            RabbitMQMessagePublisher publisher =
                new RabbitMQMessagePublisher();

            publisher.PostMessage(
                pstrLogid,
                pstrMqSection,
                pstrMqId);
        }
    }
}
