using NativeXLRange = C1.C1Excel.XLRange;
using NativeXLConditionalFormatting = C1.C1Excel.XLConditionalFormatting;
using NativeXLConditionalFormattingCollection = C1.C1Excel.XLConditionalFormattingCollection;
using NativeXLConditionalFormattingRangeCollection = C1.C1Excel.XLConditionalFormattingRangeCollection;
using NativeXLConditionalFormattingRule = C1.C1Excel.XLConditionalFormattingRule;
using NativeXLConditionalFormattingRuleCollection = C1.C1Excel.XLConditionalFormattingRuleCollection;
using NativeXLPatternFormatting = C1.C1Excel.XLPatternFormatting;
using NativeXLConditionalFormattingType = C1.C1Excel.XLConditionalFormattingType;
using NativeXLConditionalFormattingOperator = C1.C1Excel.XLConditionalFormattingOperator;




public enum XLConditionalFormattingType
{
    AboveAverage,
    BelowAverage,
    Bottom10,
    Bottom10Percent,
    CellIs,
    ContainsText,
    DuplicateValues,
    EndsWith,
    Expression,
    TimePeriod,
    Top10,
    Top10Percent,
    Unknown
}

public enum XLConditionalFormattingOperator
{
    Between,
    Equal,
    GreaterThan,
    GreaterThanOrEqual,
    LessThan,
    LessThanOrEqual,
    NoComparision,
    NotBetween,
    NotEqual
}




public XLConditionalFormattingCollection ConditionalFormattings
{
    get
    {
        return new XLConditionalFormattingCollection(
            _sheet.ConditionalFormattings);
    }
}



public string Formula
{
    get { return _cell.Formula; }
    set { _cell.Formula = value; }
}




#region Conditional formatting

public sealed class XLRange
{
    private readonly NativeXLRange _range;

    internal NativeXLRange NativeRange
    {
        get { return _range; }
    }

    public XLRange(int rowFirst, int colFirst, int rowLast, int colLast)
    {
        _range = new NativeXLRange(
            rowFirst,
            colFirst,
            rowLast,
            colLast);
    }

    internal XLRange(NativeXLRange range)
    {
        _range = range;
    }
}

public sealed class XLPatternFormatting
{
    private readonly NativeXLPatternFormatting _pattern;

    internal NativeXLPatternFormatting NativePattern
    {
        get { return _pattern; }
    }

    public XLPatternFormatting()
    {
        _pattern = new NativeXLPatternFormatting();
    }

    internal XLPatternFormatting(NativeXLPatternFormatting pattern)
    {
        _pattern = pattern;
    }

    public Color BackColor
    {
        get { return _pattern.BackColor; }
        set { _pattern.BackColor = value; }
    }

    public Color ForeColor
    {
        get { return _pattern.ForeColor; }
        set { _pattern.ForeColor = value; }
    }
}

public sealed class XLConditionalFormattingRule
{
    private readonly NativeXLConditionalFormattingRule _rule;

    internal NativeXLConditionalFormattingRule NativeRule
    {
        get { return _rule; }
    }

    public XLConditionalFormattingRule()
    {
        _rule = new NativeXLConditionalFormattingRule();
    }

    internal XLConditionalFormattingRule(
        NativeXLConditionalFormattingRule rule)
    {
        _rule = rule;
    }

    public XLConditionalFormattingType Type
    {
        get
        {
            return (XLConditionalFormattingType)Enum.Parse(
                typeof(XLConditionalFormattingType),
                _rule.Type.ToString());
        }
        set
        {
            _rule.Type =
                (NativeXLConditionalFormattingType)Enum.Parse(
                    typeof(NativeXLConditionalFormattingType),
                    value.ToString());
        }
    }

    public XLConditionalFormattingOperator Operator
    {
        get
        {
            return (XLConditionalFormattingOperator)Enum.Parse(
                typeof(XLConditionalFormattingOperator),
                _rule.Operator.ToString());
        }
        set
        {
            _rule.Operator =
                (NativeXLConditionalFormattingOperator)Enum.Parse(
                    typeof(NativeXLConditionalFormattingOperator),
                    value.ToString());
        }
    }

    public string FirstFormula
    {
        get { return _rule.FirstFormula; }
        set { _rule.FirstFormula = value; }
    }

    public string SecondFormula
    {
        get { return _rule.SecondFormula; }
        set { _rule.SecondFormula = value; }
    }

    public XLPatternFormatting Pattern
    {
        get
        {
            return _rule.Pattern == null
                ? null
                : new XLPatternFormatting(_rule.Pattern);
        }
        set
        {
            _rule.Pattern = value == null
                ? null
                : value.NativePattern;
        }
    }
}

public sealed class XLConditionalFormattingRangeCollection
{
    private readonly NativeXLConditionalFormattingRangeCollection _ranges;

    internal XLConditionalFormattingRangeCollection(
        NativeXLConditionalFormattingRangeCollection ranges)
    {
        _ranges = ranges;
    }

    public int Count
    {
        get { return _ranges.Count; }
    }

    public void Add(XLRange range)
    {
        if (range == null)
            throw new ArgumentNullException("range");

        _ranges.Add(range.NativeRange);
    }
}

public sealed class XLConditionalFormattingRuleCollection
{
    private readonly NativeXLConditionalFormattingRuleCollection _rules;

    internal XLConditionalFormattingRuleCollection(
        NativeXLConditionalFormattingRuleCollection rules)
    {
        _rules = rules;
    }

    public int Count
    {
        get { return _rules.Count; }
    }

    public XLConditionalFormattingRule this[int index]
    {
        get
        {
            NativeXLConditionalFormattingRule rule = _rules[index];

            return rule == null
                ? null
                : new XLConditionalFormattingRule(rule);
        }
    }

    public void Add(XLConditionalFormattingRule rule)
    {
        if (rule == null)
            throw new ArgumentNullException("rule");

        _rules.Add(rule.NativeRule);
    }
}

public sealed class XLConditionalFormatting
{
    private readonly NativeXLConditionalFormatting _formatting;

    internal NativeXLConditionalFormatting NativeFormatting
    {
        get { return _formatting; }
    }

    public XLConditionalFormatting()
    {
        _formatting = new NativeXLConditionalFormatting();
    }

    internal XLConditionalFormatting(
        NativeXLConditionalFormatting formatting)
    {
        _formatting = formatting;
    }

    public XLConditionalFormattingRangeCollection Ranges
    {
        get
        {
            return new XLConditionalFormattingRangeCollection(
                _formatting.Ranges);
        }
    }

    public XLConditionalFormattingRuleCollection Rules
    {
        get
        {
            return new XLConditionalFormattingRuleCollection(
                _formatting.Rules);
        }
    }
}

public sealed class XLConditionalFormattingCollection
{
    private readonly NativeXLConditionalFormattingCollection _formattings;

    internal XLConditionalFormattingCollection(
        NativeXLConditionalFormattingCollection formattings)
    {
        _formattings = formattings;
    }

    public int Count
    {
        get { return _formattings.Count; }
    }

    public XLConditionalFormatting this[int index]
    {
        get
        {
            NativeXLConditionalFormatting formatting = _formattings[index];

            return formatting == null
                ? null
                : new XLConditionalFormatting(formatting);
        }
    }

    public void Add(XLConditionalFormatting formatting)
    {
        if (formatting == null)
            throw new ArgumentNullException("formatting");

        _formattings.Add(formatting.NativeFormatting);
    }
}

#endregion
