    public class MQConsumer : MQBase
    {
        private bool _continueConsuming;
        private static ILog _logger = LogManager.GetLogger(typeof(MQConsumer));
        private const string MQCONSUMER_CONSUME_MESSAGE_ACTIVITYID = "SMTBUSA.Messaging.MQConsumer.ConsumeMessageActivity";

        #region Events
        public delegate void MQMessageReceivedHandler(object sender, MQMessageReceivedArgs args);
        public delegate void MQOnStopConsumingEventHandler(object sender, MQOnStopConsumingEventArgs args);
        public delegate void MQDequeueCompletedEventHandler(object sender);

        public event MQMessageReceivedHandler MQMessageReceived;
        public event MQOnStopConsumingEventHandler MQOnStopConsumingEvent;
        public event MQDequeueCompletedEventHandler MQDequeueCompleted;
        public event OnFailHandler MQConsumerCompositeRetry;
        #endregion 

        #region MQ Subscriber Properties
        public int QueueTimeout { get; set; }        //Dequeue timeout
        public bool IsAutoAck { get; set; }
        public ushort PrefetchCount { get; set; }
        #endregion 

        #region Constructor
        public MQConsumer (string hostName, int portNumber, string userName, string passWord, string vHost) : base(hostName, portNumber, userName, passWord, vHost) 
        {
            PrefetchCount = 1;
        }
        #endregion 

        #region Methods
        public void ConsumeMessages()
        {
            try
            {
                _continueConsuming = true;
                this.SafeInvokeConsumeMessages();
            }
            catch 
            {
                throw;
            }
        }

        public void ConsumeSingleMessage()
        {
            try
            {
                _continueConsuming = false;
                this.SafeInvokeConsumeMessages();
            }
            catch 
            {
                throw;
            }
        }

        public void StopConsuming()
        {
            _logger.InfoFormat("Stop consuming request received. Host: {0}, Port: {1}, Exchange: {2}, Queue: {3}", this.HostName, this.Port, this.ExchangeName, this.QueueName);
            _continueConsuming = false;
        }

        private void SafeInvokeConsumeMessages()
        {
            try
            {
                Action consumeMessagesAction = () => { DoConsumeMessages(); };
                FailSafeActivity failSafeConsume = new FailSafeActivity(MQCONSUMER_CONSUME_MESSAGE_ACTIVITYID);
                

                failSafeConsume.OnFail += new OnFailHandler((object sender, OnFailEventArgs failArgs) =>
                                                            {
                                                                _logger.Error(failArgs.Exception);
                                                            });
                
                failSafeConsume.OnCompositeRetry += new OnFailHandler((object sender, OnFailEventArgs failArgs) =>
                {
                    if (MQConsumerCompositeRetry != null)
                    {
                        MQConsumerCompositeRetry(this, failArgs);
                    }
                });


                failSafeConsume.OnSuccess += new Action(() => { });
                failSafeConsume.Invoke(consumeMessagesAction);
            }
            catch
            {
                throw;
            }
        }

        private void DoMQDequeueCompleted()
        {

            if (MQDequeueCompleted == null) { return; }
            try
            {
                MQDequeueCompleted(this);
            }
            catch 
            {
                throw;
            }
        }

        private void DoMQMessageReceived(MQMessageReceivedArgs args)
        {
            if (MQMessageReceived == null) { return; } 

            try
            {
                MQMessageReceived(this, args);
            }
            catch
            {
                throw;
            }
        }

        private void DoMQOnStopConsuming(ShutdownEventArgs reason)
        {
            _logger.WarnFormat("RabbitMQ connection is shutting down. {0}. {1}. Exchange: {2}, Quueue: {3}", reason.ReplyText, reason.ToString(), this.ExchangeName, this.QueueName);

            if (MQOnStopConsumingEvent == null)
                return;

            try
            {
                MQOnStopConsumingEvent(this, new MQOnStopConsumingEventArgs() { 
                                                                                Reason = string.Format("{0} {1}",reason.ReplyText, reason.ToString())
                                                                              });
            }
            catch
            {
                throw;
            }
        }

        private void DoConsumeMessages()
        {
            do
            {
                try
                {
                    _logger.InfoFormat("Consuming messages. Host: {0}, Port: {1}, QueueName: {2}", this.HostName, this.Port, this.QueueName);

                    ConnectionFactory connectionFactory = new ConnectionFactory()
                    {
                        HostName = this.HostName,
                        Port = this.Port,
                        UserName = this.UserName,
                        Password = this.Password,
                        VirtualHost = this.VHost,
                        RequestedHeartbeat = this.HeartBeat
                    };

                    using (IConnection conn = connectionFactory.CreateConnection())
                    {
                        //conn.ConnectionShutdown += new ConnectionShutdownEventHandler(ConnectionShutdown);
                        conn.ConnectionShutdown += (connection1, reason) =>
                            {
                                try
                                {
                                    DoMQOnStopConsuming(reason);
                                }
                                catch
                                {
                                    throw;
                                }
                            };

                        using (IModel channel = conn.CreateModel())
                        {
                            channel.QueueBind(QueueName, ExchangeName, RoutingKey);

                            QueueingBasicConsumer consumer = new QueueingBasicConsumer(channel);
                            channel.BasicConsume(QueueName, IsAutoAck, consumer);
                            channel.BasicQos(0, PrefetchCount, false);              //TODO: verify the QoS args
                            object result = null;

                            while (true)
                            {
                                bool isConsuming = consumer.Queue.Dequeue(QueueTimeout, out result);
                                BasicDeliverEventArgs deliverEventArgs = result as BasicDeliverEventArgs;

                                this.DoMQDequeueCompleted();

                                if (deliverEventArgs != null)
                                {
                                    _logger.DebugFormat("MQ message read from queue. DeliveryTag: {0}", deliverEventArgs.DeliveryTag);
                                    try
                                    {
                                        MQMessageReceivedArgs msgRecvdArgs = new MQMessageReceivedArgs()
                                        {
                                            DeliveryTag = deliverEventArgs.DeliveryTag,
                                            MessageBody = deliverEventArgs.Body,
                                            HeaderProperties = ( deliverEventArgs.BasicProperties != null ) ? deliverEventArgs.BasicProperties.Headers : null,
                                            ContinueConsuming = true
                                        };

                                        this.DoMQMessageReceived(msgRecvdArgs);

                                        if (!IsAutoAck)
                                        {
                                            if (msgRecvdArgs.IsAcknowledge)
                                            {
                                                _logger.InfoFormat("Acknowledging message. DeliveryTag: {0},  MessageText: {1}", deliverEventArgs.DeliveryTag, msgRecvdArgs.ToString());
                                                channel.BasicAck(deliverEventArgs.DeliveryTag, false);
                                            }
                                            else if (msgRecvdArgs.IsRejectMessage)
                                            {
                                                if (deliverEventArgs.Redelivered)
                                                {
                                                    _logger.InfoFormat("Nacking message. No requeue. DeliveryTag: {0}, MessageText: {1}", deliverEventArgs.DeliveryTag, msgRecvdArgs.ToString());
                                                    channel.BasicNack(deliverEventArgs.DeliveryTag, false, false);
                                                }
                                                else
                                                {
                                                    _logger.InfoFormat("Nacking message. Re-queuing. DeliveryTag: {0}, MessageText: {1}", deliverEventArgs.DeliveryTag, msgRecvdArgs.ToString());
                                                    channel.BasicNack(deliverEventArgs.DeliveryTag, false, true);
                                                }
                                            }
                                        }

                                        if (!msgRecvdArgs.ContinueConsuming)
                                        {
                                            this.StopConsuming();
                                        }
                                    }
                                    catch
                                    {
                                        throw;
                                    }
                                }

                                if (!_continueConsuming) break;
                            }

                            if (conn.IsOpen)
                            {
                                conn.Close();
                            }
                        }
                    }
                }
                catch 
                {
                    throw;
                }

            } while (_continueConsuming);            
 
        }

        private void ConnectionShutdown(IConnection connection, ShutdownEventArgs reason)
        {
            try
            {
                DoMQOnStopConsuming(reason);
            }
            catch 
            {
                throw;
            }
        }
        #endregion 
    }
}



















