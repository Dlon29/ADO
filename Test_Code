        //Checks ActiveDirectory Group User
        public void checkADGroupUser(string ModuleName)
        {
            string[] loginId = HttpContext.Current.User.Identity.Name.Trim().Split(new string[] { "\\" }, StringSplitOptions.None);
            string NTUserId = loginId[(loginId.Length - 1)];
            UserData CurrentUser = null;

            ADSIUtil adUtil = new ADSIUtil();

            try
            {
                if (adUtil.checkUserList(ADGroupName, NTUserId)) // Check Application Main ADGroupName.
                {
                    _IsApplicationUser = true;
                    try
                    {
                        CurrentUser = UserData.Authenticate(NTUserId); // Authenticate User against Database.
                        if (CurrentUser != null)
                        {
                            _IsSuperUser = CurrentUser.IsSuperUser;
                            _RoleName = CurrentUser.RoleName;
                            _IsActive = CurrentUser.IsActive;
                        }
                    }
                    catch (Exception Exc)
                    {
                        throw Exc;
                    }
                }
            }
            catch // Ignore Exception handle later.
            {

                //HttpContext.Current.Response.Redirect(string.Format("~/Error/AccessDenied.aspx?{0}", "AuthenticationFail"));
            }
            finally
            {
                if (_IsApplicationUser) // Check if User is application user and Setup as Active user with defined roles in database
                {
                    if (CurrentUser != null)
                    {
                        if (!_IsActive) // Check if user is Inactive in database
                        {
                            UserInfo.AsyncLogUserAction(ModuleName, UserInfo.enmUserActionType.Authorization_Failure, HttpContext.Current.Request.QueryString);// Authentication  Fail
                            HttpContext.Current.Response.Redirect(string.Format("~/Error/AccessDenied.aspx?{0}", "AuthorizationFail"));
                        }
                    }
                    else //User not setup on the database.
                    {
                        UserInfo.AsyncLogUserAction(ModuleName, UserInfo.enmUserActionType.Authorization_Failure, HttpContext.Current.Request.QueryString);// Authentication  Fail
                        HttpContext.Current.Response.Redirect(string.Format("~/Error/AccessDenied.aspx?{0}", "AuthorizationFail"));
                    }
                }
                else // user not found in Application ADGroup
                {
                    UserInfo.AsyncLogUserAction(ModuleName, UserInfo.enmUserActionType.Authentication_Failure, HttpContext.Current.Request.QueryString);// Authentication  Fail
                    HttpContext.Current.Response.Redirect(string.Format("~/Error/AccessDenied.aspx?{0}", "AuthenticationFail"));
                }
            }
        }




        #region Convert Querystring to XML

        public static StringBuilder QuerystringXML(NameValueCollection QueryString)
        {
            StringBuilder strParam = new StringBuilder();
            strParam.Append(UserInfo.START_TAG_ROOT);
            foreach (String key in QueryString.AllKeys)
            {
                if (key != null && key != "")
                {
                    strParam.Append(UserInfo.START_TAG_QUERYSTRING);
                    strParam.Append(UserInfo.START_TAG_PARAMETERNAME + key.ToString() + UserInfo.END_TAG_PARAMETERNAME);
                    strParam.Append(UserInfo.START_TAG_PARAMETERVALUE + QueryString[key].ToString() + UserInfo.END_TAG_PARAMETERVALUE);
                    strParam.Append(UserInfo.END_TAG_QUERYSTRING);
                }
            }
            strParam.Append(UserInfo.END_TAG_ROOT);
            return strParam;
        }

        #endregion

