)
AS
BEGIN
	
	SET NOCOUNT ON;
	DECLARE @ERROR_NO INT,@hdoc INT, @BulkNbr INT,  @VersionNbr INT, @RowCount  INT, @TotalRowCount INT, @NewBulkNbr INT, @NewVersionNbr INT

	DECLARE @TempBasketData TABLE
	(
