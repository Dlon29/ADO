using STBUSA.Excel.Util.C1Compatibility;
using System;
using System.Collections.Generic;
using System.Data;
using System.IO;
using System.Linq;

namespace MoBetterReports.Shared.Report
{
    public class ReportBuilderDynamicSection : ReportBuilder
    {
        /// <summary>
        /// This method will includes actual business logic to write the excel report using Component One.
        /// </summary>
        /// <param name="dataSet">Dataset includes all the data to generate the excel</param>
        /// <returns>This method returns the shared path for generated report</returns>
        public override string BuildWorkBook(DataSet dataSet)
        {
            try
            {
                string confPath = null;

                string fileName = String.Empty, templatefileFullName = String.Empty, confFilePath = String.Empty;

                LoadPaths(dataSet.Tables[0], ref fileName, ref templatefileFullName, ref confFilePath);

                #region Workbook

                C1XLBook workBookTemplate = new C1XLBook();
                workBookTemplate.Load(templatefileFullName);

                if (!Directory.Exists(confFilePath))
                {
                    Directory.CreateDirectory(confFilePath);
                }

                #region Worksheets


                //workBookTemplate.Sheets.Add("dummyxLSheet");

                XLSheet workSheetConfig = workBookTemplate.Sheets[0];
                /*
                //Copying default section data from config to another dynamic sheet.
                XLSheet xLSheetSource = workBookTemplate.Sheets[1];
                XLSheet xLSheetDest = workBookTemplate.Sheets[workBookTemplate.Sheets.Count - 1];
                CopyCellsFromSourceToDest(xLSheetSource, xLSheetDest);
                */

                //Creating copy of sheet with dynamic sections.
                //XLSheet xLSheet = workBookTemplate.Sheets[1].Clone();
                //xLSheet.Name = "dummyxLSheet";
                //workBookTemplate.Sheets.Add(xLSheet);


                Dictionary<int, XLCell> config = GetConfiguration(workSheetConfig);
                Dictionary<string, Sections> sections = GetSectionsFromConfig(config[(int)ConfigSectionKey.SectionPosition], workSheetConfig);
                List<DBTempHeader> dBColumns = GetDBColumnFromConfig(config[(int)ConfigSectionKey.DBColPosition], workSheetConfig);
                Dictionary<string, string> configKeys = GetConfigKeyFromConfig(config[(int)ConfigSectionKey.ConfigKeyPosition], workSheetConfig);
                List<string> dBDynamicHeaders = null;

                reportConfig = config;
                reportSections = sections;
                reportDBColumns = dBColumns;
                reportConfigKeys = configKeys;

                // DataTable dtReportHeader = dataSet.Tables[0];
                // DataTable dtSection2 = dataSet.Tables[1];

                var Sheets = sections.Select(p => p.Value.SectionOfSheet).Distinct().ToList();

                //Note: Remove optional worksheet.
                //if (dataSet.Tables[0].Rows[0]["OptionlWS1"].ToString() == "0")
                //{
                //    Sheets.Remove(Sheets.Last());
                //    workBookTemplate.Sheets.RemoveAt(workBookTemplate.Sheets.Count - 1);
                //}

                RemoveOptionalWorksheet(dataSet, workBookTemplate, Sheets, 1);

                DataSet ds = dataSet;
                foreach (string sheet in Sheets)
                {
                    int sheetNo = Convert.ToInt16(sheet.Substring(5));

                    var dynamicSection = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.IsDynamic == "1").Select(p => p.Value.SectionName).Distinct().ToList();

                    if (dynamicSection.Count > 0)
                    {
                        XLSheet xLSheet = workBookTemplate.Sheets[sheetNo].Clone();
                        xLSheet.Name = "dummyXl" + sheet;
                        workBookTemplate.Sheets.Add(xLSheet);
                    }

                    XLSheet workSheetTemplate = workBookTemplate.Sheets[sheetNo];

                    if (configKeys.ContainsKey("IsSheetResultSetSaperate") && configKeys["IsSheetResultSetSaperate"] == "0")
                    {
                        ds = new DataSet();

                        for (int i = 0; i < dataSet.Tables.Count; i++)
                        {
                            if (dataSet.Tables[i].Rows.Count > 0 && dataSet.Tables[i].Columns.Contains("SheetNo"))
                            {
                                var dataTableBySheet = dataSet.Tables[i].AsEnumerable()
                                .Where(r => r.Field<int>("SheetNo") == sheetNo);
                                var dt = dataTableBySheet.Any() ? dataTableBySheet.CopyToDataTable() : dataSet.Tables[i].Clone();
                                ds.Tables.Add(dt);
                            }
                            else
                                ds.Tables.Add(dataSet.Tables[i].Copy());
                        }
                    }

                    RenameWorksheet(ref workSheetTemplate, null);

                    int rowInsertCount = 0, colInsertCount = 0;

                    var section = sections.Where(s => s.Value.SectionOfSheet == sheet).Select(p => p.Value.SectionName).Distinct().ToList();

                    bool IsDynamicGroupCalled = false;
                    List<string> dynamicGrpSections = GetDynamicGroupSectionsByKey(configKeys, sheet, dynamicSection); // getting dynamic group sections.

                    for (int secCount = 0; secCount < section.Count; secCount++)
                    {
                        var isDynamic = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section[secCount]).Select(p => p.Value.IsDynamic).FirstOrDefault();
                        if (isDynamic != "1")
                        {
                            var sectionType = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section[secCount]).Select(p => p.Value.SectionType).FirstOrDefault();
                            var resultSetNo = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section[secCount]).Select(p => p.Value.SectionResultSetNo).FirstOrDefault();

                            SelectSectionType(sheet, ds, sections, dBColumns, configKeys, ref dBDynamicHeaders, ref workBookTemplate, ref workSheetTemplate, ref rowInsertCount, ref colInsertCount, section[secCount], sectionType, resultSetNo, null, 0, 0);
                        }
                        else
                        {
                            //writing Non group dynamic sections here if the DynamicSectionsGroupKey is not present
                            if ((dynamicSection.Count > 0 && dynamicSection != null) && string.IsNullOrWhiteSpace(configKeys["DynamicSectionsGroupKey"]))
                            {
                                rowInsertCount = AdjustDynamicSecDifference(sections, sheet, rowInsertCount, section, secCount);
                                WriteNonGroupedSections(ds, ref workBookTemplate, sections, dBColumns, configKeys, ref dBDynamicHeaders, sheet, ref workSheetTemplate, ref rowInsertCount, ref colInsertCount, section, secCount);
                            }
                            else
                            {
                                //writing group sections here if the DynamicSectionsGroupKey is present
                                if (dynamicGrpSections != null && dynamicGrpSections.Contains(section[secCount]))
                                {
                                    if (IsDynamicGroupCalled == false)
                                    {
                                        rowInsertCount = AdjustDynamicSecDifference(sections, sheet, rowInsertCount, section, secCount);
                                        IsDynamicGroupCalled = true;
                                        WriteGroupedSections(ds, ref workBookTemplate, sections, dBColumns, configKeys, ref dBDynamicHeaders, sheet, ref workSheetTemplate, ref rowInsertCount, ref colInsertCount, dynamicGrpSections);
                                    }
                                }
                                else //writing dynamic sections(Non Group) if the section is not present in the dynamicGrpSections
                                {
                                    rowInsertCount = AdjustDynamicSecDifference(sections, sheet, rowInsertCount, section, secCount);
                                    WriteNonGroupedSections(ds, ref workBookTemplate, sections, dBColumns, configKeys, ref dBDynamicHeaders, sheet, ref workSheetTemplate, ref rowInsertCount, ref colInsertCount, section, secCount);
                                }
                            }
                        }
                    }
                    CleanUpTouchUpSheet(ref workBookTemplate, ref workSheetTemplate, sheet, dataSet);

                    if (workBookTemplate.Sheets.Contains("dummyXl" + sheet))
                        workBookTemplate.Sheets.Remove("dummyXl" + sheet);
                }

                #endregion

                CleanUpTouchUpWorkBook(ref workBookTemplate, dataSet);

                RemoveOptionalWorksheet(dataSet, workBookTemplate, Sheets, 2);
                // workBookTemplate.Sheets.RemoveAt(0);
                // Remove configration sheet from workbook
                RemoveWorksheet(ref workBookTemplate, 0);

                // workBookTemplate.Sheets.Remove("dummyxLSheet");

                if (CreateDir(Path.GetDirectoryName(confFilePath + fileName)) == true)
                {
                    workBookTemplate.Save(confFilePath + fileName);
                }

                //ProtectWorkbook(fileName, confFilePath);
                //Note: Protect File
                bool protectFile = (dataSet.Tables[0].Columns.Contains("Code") && dataSet.Tables[0].Rows[0]["Code"].ToString() != "") ? true : false;
                bool zipReport = (dataSet.Tables[0].Columns.Contains("Zip") && dataSet.Tables[0].Rows[0]["Zip"].ToString() != "") ? Convert.ToBoolean(Convert.ToInt16(dataSet.Tables[0].Rows[0]["Zip"])) : false;
                bool IsChangeZipFolderName = dataSet.Tables[0].Columns.Contains("ZipFolderName") && dataSet.Tables[0].Rows[0]["ZipFolderName"].ToString() != "" ? true : false;

                if (protectFile && !zipReport)
                {
                    string password = dataSet.Tables[0].Rows[0]["Code"].ToString();
                    ProtectWorkbook(fileName, confFilePath, password);
                }
                //_helper.CompressFiles(confFilePath, fileName);
                //Note: Zip File

                if (zipReport)
                {
                    string zipFolderName = null;
                    if (IsChangeZipFolderName)
                    {
                        var zipFileName = dataSet.Tables[0].Rows[0]["ZipFolderName"].ToString();
                        var toDate = dataSet.Tables[0].Columns.Contains("ToDate") ? Convert.ToDateTime(dataSet.Tables[0].Rows[0]["ToDate"].ToString()) : DateTime.Now;
                        zipFolderName = GetZipFileNameNFormat(zipFileName, IsGeneric, FileType.ToLower(), toDate);
                    }
                    string password = (protectFile ? dataSet.Tables[0].Rows[0]["Code"].ToString() : string.Empty);
                    CompressFileNFolder(confFilePath, fileName, password, zipFolderName);
                    fileName = zipFolderName != null ? zipFolderName : fileName;
                }

                #endregion Workbook

                ReportFileName = fileName;
                ReportFolderPath = confFilePath;

                confPath = confFilePath + fileName;
                return confPath;
            }
            catch (Exception EX)
            {
                throw new Exception(EX.Message + ReportGenerationExceptions(EX.Message), EX);
            }
        }
    }
}





