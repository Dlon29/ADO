		GotoRemarks,
		0,--CASE LEN(LIBORRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(5,2),LIBORRate) END,
		CASE WHEN (LEN(GotoRate) = 0 OR GotoRate = '') THEN NULL ELSE CONVERT(DECIMAL(20,7),GotoRate) END,
