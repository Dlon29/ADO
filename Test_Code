							INNER JOIN
								#TempAcctCleanUp CP
							ON 
								work.PoolId = CP.PoolId AND
								work.AcctNbr = CP.AcctNbr AND
								work.CanUseAcctForCleanUp = 1 AND
								CP.RowId = @ReqAcctCount

							SET @ReqAcctCount = @ReqAcctCount + 1

							/** Get the total units allocated to loan request **/
							SELECT @ReqTotalUnitsLended = SUM(UnitsLendable) FROM #WorkingTbl

						END -- end of WHILE (@ReqAcctCount <= @ReqAcctTotal AND @ReqTotalUnitsLended < @FaceAmount)

