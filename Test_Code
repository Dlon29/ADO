--select * from @TempXMLTable

	SELECT @SecCount = MIN(RowID) FROM @TempXMLTable
	SELECT @TotalSecCount = MAX(RowID) FROM @TempXMLTable

	WHILE (@SecCount <= @TotalSecCount)
	BEGIN		

		SET @SecCode = NULL
		SET @BucketSecType = NULL
		SET @SecID = NULL
		SET @Price = NULL
		SET @FinderNbr = NULL
		SET @BrkCrGrpID = NULL
		SET @blnValidSec = 1
		SET @blnValidCollSched = 1
		SET @UseTraderLendable = 0
		SET @DivRateAlloc = NULL
		SET @bIsValidActiveTradingSec = 1

		/** Get the values in variables **/
		SELECT 
			@SecCode = SecCode,
			@BucketSecType = CASE WHEN BucketSecType = 'RI' THEN 'EQ' ELSE BucketSecType END,
			@SecID = SecID,
			--@Price = CASE WHEN BucketSecType = 'RI' THEN 0.01 ELSE Price END,
			@Price = CASE WHEN Price <= 0 THEN @DefaultPrice ELSE Price END,
			@FinderNbr = FinderNbr,
			@FaceAmount = FaceAmount,
			@WLDepository = WLDepository,
			@BrkNbr = BrkNbr,
			@IsDivRateRestriction = IsDivRateRestriction,
			@CollSchedId = CollSchedId,
			@BrkCrGrpID = BrkCrGrpID,
			@BrkID = BrkID,
			@LoanType = LoanType,
			@BrkBusinessInd = BusinessInd,
			@TriPartyGrpID = ISNULL(TriPartyGrpID,0),
			@UseTraderLendable = ISNULL(UseTraderLendable, 0),
			@DivRateAlloc = DivRateAlloc,
			@SettlementDate = SettlementDate,
			@CCYCode = PriceCurr,
			@AsOfDate = AsOfDate 
		FROM 
			@TempXMLTable  
		WHERE 
			RowID = @SecCount								

		-- both broker and security should be either EQ or FI
		IF (@BrkBusinessInd <> @BucketSecType)
		BEGIN
			RAISERROR('Invalid Broker - Security combination.', 16, 1)
			RETURN 1
		END

		/*If SecType is 0 or 2 or 6 in GLOBALONE.dbo.Security table - for such securities, 
		 If a borrower wants to borrow 120 mln, we need to break it in 3 chunks/loans */
		SELECT 
			@SmType = Type ,
			@SecCode = CUSIP 
		FROM
			GLOBALONE.dbo.vw_G1_Security 
		WHERE 
			SecID = @SecId
				
		--The allocation logic uses variable UnitsLendableRestrictedRem in rest of the logic below
		--So assigning value of variable UnitsLendableRem to variable UnitsLendableRestrictedRem
		IF (@UseTraderLendable = 1)
		BEGIN
			UPDATE
				#TempAccAvail
			SET			
				UnitsLendableRestrictedRem = UnitsLendableRem
			WHERE
				SecID = @SecId
		END -- end of (@UseTraderLendable = 1)

				
	--SELECT * from #TempAccAvail

		SELECT	@TotalIndNonIndUnitsRem  = ISNULL(SUM(UnitsLendableRem),0) , 
				@TotalIndNonIndUnitsRestrictedRem = ISNULL(SUM(UnitsLendableRestrictedRem),0)
		FROM 
			#TempAccAvail	
		WHERE 
			SecID = @SecId	  

	    --SELECT * from #ctrAvailability
		
		SET @blnUnitsAvail = 0

		-- Check if security exists in ctrAvail table. If not that means Accounts which have security are not mapped with collateral schedule. Do not proceed with the selected security.
		IF EXISTS(SELECT SecID FROM #ctrAvailability where SecID = @SecId)
		BEGIN
			SET @blnValidCollSched = 1
			--==========================================================================================================
			-- Check if Availability exists in CBJIndemnified NonActiveTrading acct TMP table for given security. 
			-- If not remove active trading security from availability.Do not proceed with selected security for the acct.	
			/* 
				-- Acct Types
				1 - ActiveTradingAcct
				2 - CBJ Non-Ind (NonActiveTrading Acct) 
				3 - CBJInd NonActiveTrading Acct 

				TMP1 (#ctrAvailability - All acct types)
				TMP2 ( #CBJIndmnNonActiveAcctAvail - only acct type 3)
				
				TMP 1 availability	
				1      - (False) 
				2      - (True)
				3      - (True)
				1,2    - (False)
				2,3    - (True)
				1,3    - (True)
				1,2,3  - (True)
			*/
			--===========================================================================================================		  			
			IF EXISTS ( SELECT AcctNbr FROM #ctrAvailability WHERE ( IsFrequentTrading = 1 ) AND ( SecID = @SecId ) )
			BEGIN			
				IF NOT EXISTS
				(
					SELECT AcctNbr FROM #ctrAvailability WHERE ( SecID = @SecId ) 
					INTERSECT
					SELECT AcctNbr FROM #CBJIndmnNonActiveAcctAvail WHERE ( SecID = @SecId ) 
				)
				BEGIN
					DELETE FROM	#ctrAvailability  			
					WHERE			
						( IsFrequentTrading = 1 )  AND
						( SecID = @SecId )
																			   
					SET @bIsValidActiveTradingSec = 0						
				END			
			END
		END
		ELSE 
		BEGIN
			SET @blnValidCollSched = 0
		END

		IF (@blnValidCollSched = 1)
		BEGIN

			IF (@FaceAmount > @TotalIndNonIndUnitsRestrictedRem)		
				SET @blnUnitsAvail = 0
			ELSE 
				SET @blnUnitsAvail = 1	

			IF (@SecCode IS NULL OR @SecCode = '')
			BEGIN
				SET @blnValidSec = 0
			END	

			IF (@blnValidSec = 1)
			BEGIN
				UPDATE
					#ctrAvailability
				SET
					DivRate = AcctDivRate.DivRate
				FROM
					#ctrAvailability Acct
				INNER JOIN
					#ctrAccountDividendRate AcctDivRate
				ON 
					Acct.AcctNbr = AcctDivRate.AcctNbr AND 
					AcctDivRate.ISOCOuntry = Acct.ISOCOuntry AND
					Acct.SecID = @SecID

				/** If more then one depository exists then delete the accounts from temp account table for which div rate is higher **/
				IF (((SELECT DISTINCT COUNT(WLDepository) FROM #ctrAvailability WHERE SecID = @SecId) > 1) AND @IsDivRateRestriction = 1)
				BEGIN

					SELECT 
						@MinDivRate = MIN(DivRate) 
					FROM 
						#ctrAvailability
					WHERE 
						SecID = @SecId

					DELETE FROM 
						#ctrAvailability 
					WHERE 
						DivRate > @MinDivRate AND
						SecID = @SecId	

				END	


				/*** get all pools for one loan request**/
				TRUNCATE TABLE #PoolTable
				TRUNCATE TABLE #WorkingTbl

				/** Insert data into temp Pool table for a selected loan request **/
				IF (@WLDepository IS NOT NULL AND @WLDepository != '')
				BEGIN
					INSERT INTO #PoolTable 
					(
						WLDepository,
			--			IsIndemnified,
						BrkNbr,
						BrkID,
						Priority
					)
					SELECT 
						@WLDepository,
			--			@IsIndemnified,
						@BrkNbr,
						@BrkID,
						1
				END
				ELSE
				BEGIN
					INSERT INTO #PoolTable 
					(
						WLDepository,
			--			IsIndemnified,
						BrkNbr,
						BrkID,
						Priority
					)
					SELECT DISTINCT
						Avai.WLDepository,
			--			Avai.IsIndemnified,
						@BrkNbr,
						@BrkID,
						ISNULL(dp.Priority, 0)
					FROM 
						#ctrAvailability Avai
					LEFT JOIN 
						dbo.DepositoryPriority dp 
					ON 
						Avai.WLDepository = dp.WLDepository
					WHERE 
						Avai.SecID = @SecID --AND
			--			IsIndemnified = @IsIndemnified
					ORDER BY 
						ISNULL([Priority], 0)

					IF ((SELECT COUNT(*) FROM #PoolTable WHERE Priority = 0) > 1)
					--IF EXISTS(SELECT PoolId FROM #PoolTable WHERE Priority = 0) 
					BEGIN
						-- we have multiple depositories and they dont have entry in DepositoryPriority table.
						UPDATE 
							#PoolTable
						SET 
							Priority = PoolId,
							IsPriorityChanged = 1
					END
					ELSE --IF ((SELECT COUNT(*) FROM #PoolTable WHERE Priority = 0) = 0)
					BEGIN
						-- we have multiple depositories and they have entry in DepositoryPriority table or we have one depository and it doesnt have entry in DepositoryPriority table .
						UPDATE 
							#PoolTable
						SET 
							Priority = PoolId
					END
--select '#PoolTable', * from #PoolTable
			--SELECT * FROM #PoolTable
					TRUNCATE TABLE #TempAcctPriority
					TRUNCATE TABLE #TempPoolPriority

					IF 
					(
						--((SELECT COUNT(*) FROM #PoolTable) > 1 ) AND
						((SELECT COUNT(*) FROM #PoolTable WHERE IsPriorityChanged = 1) > 1) -- we have multiple depositories and they dont have entry in DepositoryPriority table.
					)
					BEGIN

						INSERT INTO #TempAcctPriority 
						(
							AcctNbr,
							WLDepository,
							ISOCountry,
							PercentOnLoan
						)
						SELECT DISTINCT 
							Avail.AcctNbr,
							Avail.WLDepository,
							Avail.ISOCountry,
							PercentOnLoan.PercentOnLoan
						FROM 
							#ctrAvailability Avail
						INNER JOIN 
							#ctrAccountPercentOnLoan PercentOnLoan
						ON 
							PercentOnLoan.AcctNbr = Avail.AcctNbr AND
							PercentOnLoan.ISOCountry = Avail.ISOCountry
						WHERE 
							Avail.SecID = @SecID --AND
			--				IsIndemnified = @IsIndemnified
						ORDER BY 
							PercentOnLoan.PercentOnLoan ASC

						INSERT INTO	#TempPoolPriority
						(
							AcctPriority,
							WLDepository 
						)
						SELECT
							MIN(AcctPriority),
							WLDepository 
						FROM 
							#TempAcctPriority
						GROUP BY 
							WLDepository 
						ORDER BY 
							MIN(AcctPriority)

			--SELECT '#TempAcctPriority',* FROM #TempAcctPriority
			--SELECT '#TempPoolPriority',* FROM #TempPoolPriority

						DELETE pool
						FROM 
							#PoolTable	Pool
						INNER JOIN
						(
							SELECT WLDepository 
							FROM #PoolTable
							EXCEPT 
							SELECT WLDepository 
							FROM #TempPoolPriority
						) temp
						ON 
							temp.WLDepository = pool.WLDepository

						UPDATE 
							#PoolTable
						SET 
							Priority = Tmp.PoolPriority
						FROM 
							#PoolTable Pool
						INNER JOIN 
							#TempPoolPriority Tmp
						ON 
							Tmp.WLDepository = Pool.WLDepository

			--SELECT * FROM #PoolTable
					END

				END
				
				/** Loop for Non ADL Accounts - Group 1**/
				SET @PoolCount = 1
				SELECT @TotalPoolCount = COUNT(*) FROM #PoolTable
						
				/** Loop thru all the pools of temp pool table **/
				-- In this pool we are processing  NON-ADL Accounts AND (ADL Accounts with isIdemnified = 1)
				-- For ADL (Agent Direct Lending)with isIdemnified = 0, we will be having different Loop.
				WHILE (@PoolCount <= @TotalPoolCount)
				BEGIN
				
					/** Truncate AcctAvailability table for each pool **/	
					TRUNCATE TABLE #AcctAvailability --Work with pool level data only

					/** Assign NULL values to variables  before using them **/
					SET @WLDepository = NULL
			--		SET @IsIndemnified = NULL
					SET @BrkNbr = NULL
					SET @BrkID = NULL
					SET @BrkCreditLimitRemIndUSD = NULL
					SET @BrkCreditLimitRemNonIndUSD = NULL
					SET @UsageLimitRemIndUSD = NULL
					SET @UsageLimitRemNonIndUSD = NULL
					SET @PoolAvailIndQty = NULL
					SET @PoolAvailNonIndQty= NULL
					SET @MinAvailAndBCLAndUCLIndQty = NULL
					SET @MinAvailAndBCLAndUCLNonIndQty = NULL

					SET	@BrkCreditLimitRemUSD = NULL
					SET	@UsageLimitRemUSD = NULL

					/** Read values in variables **/
					SELECT
						@WLDepository = WLDepository,
			--			@IsIndemnified = IsIndemnified,
						@BrkNbr = BrkNbr,
						@BrkID = BrkID
					FROM
						#PoolTable
					WHERE
			--			PoolID = @PoolCount
						Priority = @PoolCount
					
					SELECT DISTINCT @WLDepoCode = CM_INTERFACE_TYPE FROM GLOBALONE.dbo.DEPOT where CM_ACCT_NO LIKE '%' + @WLDepository + '%'

					IF (@SmType = 'B')
					BEGIN
						SET @WLDepoCode = @WLDepoCode + 'D' 
					END
					ELSE 
					BEGIN
						SET @WLDepoCode = @WLDepoCode + 'X' 
					END


					-- Eliminate broker and hence pools for that broker if settlement instruction is missing for broker-country (country of security)
					-- Add logic here for above cond
					--
					--
					--
					--
					--		
					/** Insert AcctAvailability data of a selected pool into a temp table **/
					-- Here Consider only NON-ADL AND ADL-Indemnified Accounts.
					INSERT INTO #AcctAvailability
					(
						PoolId,
						LendingLimitGrpID,
						AcctId,
						AcctNbr,
						AcctSN,
						SecID,
						WLDepository,
						ISOCountry,
						UnitsLendableRem,
						UnitsLendableRestrictedRem,
						MinOfAvailAndLLAndCLQty,
						IsProcessed,
						DivRate,
						IsIndemnified,
						IsAgentDirectLending,
						AcctGrpId,
						TriPartyGrpID
					)
					SELECT DISTINCT	
						@PoolCount,
						LendingLimitGrpID ,
						AcctID,
						AcctNbr,
						AcctSN,
						SecID,
						WLDepository,
						ISOCountry,
						UnitsLendableRem,
						UnitsLendableRestrictedRem ,
						0, -- MinOfAvailAndLLAndCLQty
						0, -- IsProcessed
						DivRate,
						IsIndemnified,
						ISNULL(IsAgentDirectLending,0),
						AcctGrpId,
						TriPartyGrpID
					FROM 
						#ctrAvailability
					WHERE 
						SecId = @SecId AND
			--			IsIndemnified = @IsIndemnified AND
						WLDepository = @WLDepository AND
						((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
					ORDER BY
						LendingLimitGrpID --Order by account lending group

					--broker-account legal entity restrictions
					/** Delete accounts from temp table with which Broker cannot do business **/
					DELETE FROM 
						#AcctAvailability
					WHERE 
						AcctNbr IN (SELECT AcctNbr FROM #ctrBrokerAccountRestriction WHERE BrkId = @BrkID)

					--Eliminate accounts because of Collateral restriction
					/** Delete accounts from temp table which has collateral restriction **/
					DELETE FROM 
						#AcctAvailability
					WHERE 
						AcctNbr IN (SELECT AcctNbr FROM dbo.CtrAccountCollateralRestriction WHERE CollateralType = @LoanType)

					--The allocation logic uses variable UnitsLendableRestrictedRem in rest of the logic below
					--So assigning value of variable UnitsLendableRem to variable UnitsLendableRestrictedRem
					IF (@UseTraderLendable = 1)
					BEGIN
						UPDATE
							#AcctAvailability
						SET			
							UnitsLendableRestrictedRem = UnitsLendableRem
						WHERE
							SecID = @SecId
					END -- end of (@UseTraderLendable = 1)


					/** Get the remaining Ind Broker Credit limit for the selected BrkCrGrp **/
					SELECT 
						@BrkCreditLimitRemIndUSD =					
							CASE @FinderNbr WHEN '000LDN'
								THEN CrLimitLndSecLendIndemnifiedRem
								ELSE CrLimitUSSecLendIndemnifiedRem 
							END
					FROM 
						#ctrBrokerCreditLimit
					WHERE 
						BrkCrGrpID = @BrkCrGrpID

					/** Get the remaining Non-Ind Broker Credit limit for the selected BrkCrGrp **/
					SELECT 
						@BrkCreditLimitRemNonIndUSD = 
								CASE @FinderNbr WHEN '000LDN' 
									THEN CrLimitLndSecLendNonIndemnifiedRem
									ELSE CrLimitUSSecLendNonIndemnifiedRem 
								END
					FROM 
						#ctrBrokerCreditLimit
					WHERE 
						BrkCrGrpID = @BrkCrGrpID
					
					/** Get the remaining Ind Usage Conc limit for the selected BrkCrGrp **/
					SELECT 
						@UsageLimitRemIndUSD = LoanUsageIndemnifiedRemUSD 
					FROM 
						#ctrUsageConcLimit
					WHERE 
						BrkCrGrpID = @BrkCrGrpID

					/** Get the remaining Non-Ind Usage Conc limit for the selected BrkCrGrp **/
					SELECT 
						@UsageLimitRemNonIndUSD = LoanUsageNonIndemnifiedRemUSD 
					FROM 
						#ctrUsageConcLimit
					WHERE 
						BrkCrGrpID = @BrkCrGrpID

					--Logic added to adjust Limit, for 'Loaned Securities Service loan'
					IF(@IsLoanedSecurityServiceLoan = 1)
					BEGIN	
						SET @BrkCreditLimitRemIndUSD = @InifiniteVal
						SET @BrkCreditLimitRemNonIndUSD = @InifiniteVal


						SET @UsageLimitRemIndUSD = @InifiniteVal
						SET @UsageLimitRemNonIndUSD = @InifiniteVal
					END
--select '#AcctAvailability', * from #AcctAvailability					
					/** Sum of Ind acct availability in a pool **/
					SELECT 
						@PoolAvailIndQty = SUM(UnitsLendableRestrictedRem) 
					FROM 
						#AcctAvailability 
					WHERE 
						IsIndemnified = 1
						AND ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

					/** Sum of NonInd acct availability in a pool **/
					SELECT 
						@PoolAvailNonIndQty = SUM(UnitsLendableRestrictedRem) 
					FROM 
						#AcctAvailability 
					WHERE 
						IsIndemnified = 0
						AND ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
					
					/** Find min of : Indemnified BrkCreditLimitUSD, UsageCreditLimitUSD and PoolAvail **/
					SELECT
						@MinAvailAndBCLAndUCLIndQty = MIN(Limit)
					FROM
					(
						SELECT 
							CONVERT(BIGINT,ISNULL(@BrkCreditLimitRemIndUSD,0) / @Price) BrkCreditLimitRemIndQty,
							CONVERT(BIGINT,ISNULL(@UsageLimitRemIndUSD,0) / @Price) UsageLimitRemIndQty,
							@PoolAvailIndQty  PoolAvailIndQty
					) p
					UNPIVOT
					(
						Limit FOR AvailBCLUCL IN 
						(
							BrkCreditLimitRemIndQty,
							UsageLimitRemIndQty,
							PoolAvailIndQty
						)
					) AS unpvt		
--select '@MinAvailAndBCLAndUCLIndQty',@MinAvailAndBCLAndUCLIndQty
					/** Find min of : Non-Indemnified BrkCreditLimitUSD, UsageCreditLimitUSD and PoolAvail **/
					SELECT
						@MinAvailAndBCLAndUCLNonIndQty = MIN(Limit)
					FROM
					(
						SELECT 
							CONVERT(BIGINT,ISNULL(@BrkCreditLimitRemNonIndUSD,0) / @Price) BrkCreditLimitRemNonIndQty,
							CONVERT(BIGINT,ISNULL(@UsageLimitRemNonIndUSD,0) / @Price) UsageLimitRemNonIndQty,
							@PoolAvailNonIndQty  PoolAvailNonIndQty
					) p
					UNPIVOT
					(
						Limit FOR AvailBCLUCL IN 
						(
							BrkCreditLimitRemNonIndQty,
							UsageLimitRemNonIndQty,
							PoolAvailNonIndQty
						)
					) AS unpvt	
					
--select '@@MinAvailAndBCLAndUCLNonIndQty',@MinAvailAndBCLAndUCLNonIndQty
					/** Get the Lending Limit and Concentration Limit for each account group of selected broker **/
					SET @AcctCount = 1 
					SELECT @TotalAcctCount = COUNT(*) FROM #AcctAvailability WHERE ((ISNULL(IsAgentDirectLending,0) = 0) OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
--select '#AcctAvailability', * from #AcctAvailability
			--SELECT @Depository ,@IsIndemnified ,@BrkNbr ,@BrkID ,@BrkCreditLimitRemUSD,@UsageLimitRemUSD,CONVERT(BIGINT,ISNULL(@UsageLimitRemUSD,0) / @Price)	

					/** Loop thru all the Lending Limit groups of a selected pool . 
						Loop through Only Non ADL Accounts  AND ADL-Indemnified Accounts.**/
					WHILE (@AcctCount <= @TotalAcctCount) --Loop through each account
					BEGIN
						SET @LendingLimitGrpID = NULL
						SET @TotalAvailForLendingLimitGrpQty = NULL
						SET @LendLimitGrpRemUSD = NULL
						SET @ConcLimitRemUSD = NULL
						SET @MinOfAvailAndLLAndCLQty = NULL
						SET @RowID = NULL
						SET @IsIndemnified = NULL
						
						SELECT 
							@RowID = RowID 
						FROM 
							#AcctAvailability  
						WHERE
							IsProcessed = 0 AND
							((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						SELECT 
							@LendingLimitGrpID	= LendingLimitGrpID,
							@IsIndemnified		= IsIndemnified
						FROM 
							#AcctAvailability
						WHERE
							RowId = @RowID AND --@AcctCount
							((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						/** Get the Lending Limit group Availability **/
						SELECT 
							@TotalAvailForLendingLimitGrpQty = SUM(UnitsLendableRestrictedRem) 
						FROM 
							#AcctAvailability AccAva 
						WHERE
							LendingLimitGrpID = @LendingLimitGrpID AND
							((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
							
						/** Get Lending limit of a selected group **/
						SELECT 
							@LendLimitGrpRemUSD = LendGrpLimitRemUSD --/ @Price
						FROM 
							#ctrLendingLimit
						WHERE
							AcctLendGrpID = @LendingLimitGrpID

						/** Get Concentration limit of a selected group and broker id **/
						SELECT 
							@ConcLimitRemUSD = ConcLimitRemUSD --/ @Price
						FROM
							#ctrConcentrationLimit
						WHERE 
							AcctLendGrpID = @LendingLimitGrpID AND
							BrkCrGrpID = @BrkCrGrpID


						--Logic added to adjust Limit, for 'Loaned Securities Service loan'
						IF(@IsLoanedSecurityServiceLoan = 1)
						BEGIN	
							SET @LendLimitGrpRemUSD = @InifiniteVal
							SET @ConcLimitRemUSD = @InifiniteVal
						END

						/** Find min of limits (USD):  Lending Limit, Conc Limit **/
						SELECT
							@MinLendLimAndConcLimUSD = MIN(Limit)
						FROM
						(
							SELECT 
								@LendLimitGrpRemUSD LendLimitGrpRemUSD ,
								@ConcLimitRemUSD ConcLimitRemUSD
						) p
						UNPIVOT
						(
							Limit FOR LLCL IN 
							(
								LendLimitGrpRemUSD ,
								ConcLimitRemUSD
							)
						) AS unpvt

						/** Find min of limits :  Acct Avail, Lending Limit, Conc Limit **/
						SELECT
							@MinOfAvailAndLLAndCLQty = MIN(Limit)
						FROM
						(
							SELECT 
								CONVERT(BIGINT,ISNULL(@LendLimitGrpRemUSD,0) / @Price) LendLimitGrpRemQty,
								CONVERT(BIGINT,ISNULL(@ConcLimitRemUSD,0) / @Price) ConcLimitRemQty,
								@TotalAvailForLendingLimitGrpQty TotalAvailForLendingLimitGrpQty
						) p
						UNPIVOT
						(
							Limit FOR LLCL IN 
							(
								LendLimitGrpRemQty,
								ConcLimitRemQty,
								TotalAvailForLendingLimitGrpQty
							)
						) AS unpvt

			--SELECT @MinLendLimAndConcLimUSD,@Price,@LendLimitGrpRemUSD,@LendLimitGrpRemUSD/@Price,CONVERT(BIGINT,ISNULL(@LendLimitGrpRemUSD,0) / @Price),CONVERT(BIGINT,ISNULL(@ConcLimitRemUSD,0) / @Price),@TotalAvailForLendingLimitGrpQty,@MinOfAvailAndLLAndCLQty

						/** Insert selected group's data into a working table for further processing One record per account . 
							Insert only Non ADL Accounts data ANd ADL-Indemnified account**/
						INSERT INTO #WorkingTbl 
						( 
							PoolId,
							AcctPriority,
							LendingLimitGrpID,
							AcctId,
							AcctNbr,
							AcctSN,				
							BrkNbr,
							BrkID,
							AcctAvailibityRem,
							AcctAvailibityRestricted,
							LoopAvailability,
							PoolAvailability,
							BrkCrGrpID,
							BrkCreditLimitUSD,
							UsageCreditLimitUSD,				
							MinAvailAndBCLAndUCLQty,
							LendingLimitUSD,
							ConcLimitUSD,
							MinLendLimAndConcLimUSD,
							MinOfAvailAndLLAndCLQty,
							MinOfAllLimitLoopQty,
							MinOfAllLimitPoolQty,	
							UnitsLendable,
							UnUsedUnits,
							IsAcctUsed,
							SecID,
							WLDepository,
							ISOCountry,
							IsIndemnified,
							Price,
							MktValuePositionUSD,
							MktValueLoanUSD,
							PercentOnLoan,
							CanUseAcctForCleanUp,
							IsPoolUpdated,
							DivRate,
							SecLoc,
							IsAgentDirectLending,
							AcctGrpID,
							SettlementDate,
							CCYCode,
							IsPrePay,
							TriPartyGrpID
						)
						SELECT 
							@PoolCount, -- PoolId (OrgPoolPriority)
							1, -- AcctPriority -- dummy, will be updated after allocation algorithm
							@LendingLimitGrpID, -- LendingLimitGrpID
							avail.AcctId,
							avail.AcctNbr, -- AcctNbr
							avail.AcctSN,				
							@BrkNbr, -- BrkNbr
							@BrkID, -- BrkID
							UnitsLendableRem, -- AcctAvailibityRem
							UnitsLendableRestrictedRem, -- AcctAvailibityRestricted
							CASE @IsIndemnified WHEN 1 THEN ISNULL(@PoolAvailIndQty,0)  ELSE ISNULL(@PoolAvailNonIndQty,0) END, -- LoopAvailability
							0, -- PoolAvailability
							@BrkCrGrpID, -- BrkCrGrpID
							CASE @IsIndemnified WHEN 1 THEN ISNULL(@BrkCreditLimitRemIndUSD,0) ELSE ISNULL(@BrkCreditLimitRemNonIndUSD,0) END, -- BrkCreditLimitUSD
							CASE @IsIndemnified WHEN 1 THEN ISNULL(@UsageLimitRemIndUSD,0) ELSE ISNULL(@UsageLimitRemNonIndUSD,0) END, -- UsageCreditLimitUSD				
							CASE @IsIndemnified WHEN 1 THEN @MinAvailAndBCLAndUCLIndQty ELSE @MinAvailAndBCLAndUCLNonIndQty END, -- MinAvailAndBCLAndUCLQty
							--ISNULL(@LendLimitGrpRemUSD,0),--@CurrentLendingGrpLimit, -- LendingLimitUSD					
							--ISNULL(@ConcLimitRemUSD,0),--@CurrentConcLimit, -- ConcLimitUSD
							--ISNULL(@MinLendLimAndConcLimUSD,0), -- MinLendLimAndConcLimUSD
							CASE WHEN ( (ISNULL(avail.IsAgentDirectLending,0) = 1)  AND (ISNULL(avail.IsIndemnified,0) = 1) ) THEN @InifiniteVal ELSE ISNULL(@LendLimitGrpRemUSD,0) END, -- BrkCreditLimitUSD ( ADL-Indemnified Accounts has Infinity )
							CASE WHEN ( (ISNULL(avail.IsAgentDirectLending,0) = 1)  AND (ISNULL(avail.IsIndemnified,0) = 1) ) THEN @InifiniteVal ELSE ISNULL(@ConcLimitRemUSD,0) END, -- UsageCreditLimitUSD  ( ADL-Indemnified Accounts has Infinity )				
							CASE WHEN ( (ISNULL(avail.IsAgentDirectLending,0) = 1)  AND (ISNULL(avail.IsIndemnified,0) = 1) ) THEN @InifiniteVal ELSE ISNULL(@MinLendLimAndConcLimUSD,0) END, -- MinAvailAndBCLAndUCLQty ( ADL-Indemnified Accounts has Infinity )
							ISNULL(@MinOfAvailAndLLAndCLQty,0), -- MinOfAvailAndLLAndCLQty
							0, -- MinOfAllLimitLoopQty
							0, -- MinOfAllLimitPoolQty
							0, -- UnitsLendable
							0, -- UnUsedUnits
							0, -- IsAcctUsed
							SecID, --SecurityID
							WLDepository,
							ISOCountry,	
							@IsIndemnified,
							@Price,
							0, -- MktValuePositionUSD
							0, -- MktValueLoanUSD
							0, -- PercentOnLoan,
							0, -- CanUseAcctForCleanUp
							0,  -- IsPoolUpdated
							DivRate,
							@WLDepoCode,
							ISNULL(avail.IsAgentDirectLending,0),--IsAgentDirectLending
							avail.AcctGrpId,
							@SettlementDate,
							@CCYCode,
							0 as IsPrePay ,
							avail.TriPartyGrpID
						FROM 
							#AcctAvailability avail
						WHERE 
							LendingLimitGrpID = @LendingLimitGrpID AND
							((ISNULL(avail.IsAgentDirectLending,0) = 0)	OR (ISNULL(avail.IsAgentDirectLending,0) = 1  AND ISNULL(avail.IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						--===============================================================================================================================================================================								
						--Set Prepay Indicator default vs MTM Broker Maintenance MTM New Loans setup 
						--===============================================================================================================================================================================
						UPDATE 
							TMP_WT
						SET 
							IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
														  FROM #TMP_DEFPREPAY_MTM_NEW_LOANS AS TMP_DEF_PREPAY_MTMNEWLN
														  WHERE TMP_DEF_PREPAY_MTMNEWLN.SettlementDay = TMTMBRK.MTMNewLoans ) THEN 1 
											ELSE 0 
											END
						FROM 
							#WorkingTbl AS TMP_WT
							INNER JOIN MTMBroker AS TMTMBRK
								ON  ( TMP_WT.BrkNbr = TMTMBRK.BrkNbr )   AND  
									( ISNULL(TMTMBRK.IsDeleted, 0) = 0 ) AND  
									( @AsOfDate BETWEEN TMTMBRK.EffectiveDateBegin AND TMTMBRK.EffectiveDateEnd )

						--===============================================================================================================================================================================
						--Set Prepay Indicator default vs MTM Broker Maintenance Loan Country Exception setup 
						--===============================================================================================================================================================================
						UPDATE 
							TMP_WT
						SET 
							IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
														  FROM #TMP_DEFPREPAY_MTM_LNCTRY AS TMP_DEF_PREPAY_MTMLNCTRY
														  WHERE TMP_DEF_PREPAY_MTMLNCTRY.SettlementDay = TLCE.SettlementDays ) THEN 1 
											ELSE 0 
											END
						FROM 
							#WorkingTbl AS TMP_WT
							INNER JOIN MTMBrokerLoanCountryException AS TLCE  
								ON  
									( TMP_WT.BrkNbr = TLCE.BrkNbr ) AND  
									( TMP_WT.CCYCode = TLCE.LoanExcepCCY )  AND  
									( ISNULL(TLCE.IsDeleted, 0) = 0 ) AND  
									( @AsOfDate BETWEEN TLCE.EffectiveDateBegin AND TLCE.EffectiveDateEnd )
						WHERE 
									( ISNULL(TMP_WT.IsPrePay,0) = 0 ) 
						--===============================================================================================================================================================================
						
						UPDATE  
							#AcctAvailability
						SET 
							ISProcessed = 1
						WHERE 
							LendingLimitGrpID = @LendingLimitGrpID  AND 
							((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

						 --Update SMODE in working table
						 IF (@SQL_IDENTIFIER = 'BULKLOAN')
							 BEGIN
								UPDATE 
									#WorkingTbl
								SET SMODE =  Depo.SMODE  --Depo.SMODE
								FROM 
									#WorkingTbl Work
								INNER JOIN GLOBALONE.dbo.DEPOT Depo
									ON  LTRIM(RTRIM(GLOBALONE.dbo.f_RemoveHeaderZero(Depo.CM_ACCT_NO))) = work.WLDepository
							END
						ELSE
							BEGIN
								 UPDATE 
									#WorkingTbl
								 SET 
									SMODE = CASE @LoanType WHEN 'T' THEN (CASE work.SecLoc WHEN 'SD' THEN REPLACE(Depo.SMODE,'US','') + 'CW' ELSE Depo.SMODE  END) ELSE Depo.SMODE  END--Depo.SMODE
								 FROM
									#WorkingTbl Work
								 INNER JOIN 
									GLOBALONE.dbo.DEPOT Depo
								 ON 
									LTRIM(RTRIM(GLOBALONE.dbo.f_RemoveHeaderZero(Depo.CM_ACCT_NO))) = work.WLDepository

							END
						/** Increase count **/
						SELECT 
							@AcctCount = MIN(RowId) --+ 1 
						FROM 
							#AcctAvailability 
						WHERE 
							--LendingLimitGrpID = @LendingLimitGrpID  AND 
							ISProcessed = 0 AND
							((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

					END -- Account table loop finishes -- endof while (@AcctCount <= @TotalAcctCount) --Loop through each account

					/*Update Pool level availability*/
					UPDATE 
						#WorkingTbl
					SET
						PoolAvailability = ISNULL(@PoolAvailIndQty, 0) + ISNULL(@PoolAvailNonIndQty, 0)
					WHERE
						PoolId = @PoolCount  AND
						((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 



					/** Find Min of All Limit for Ind Accounts **/
					SELECT 
						@MinOfAllLimitIndLoopQty = MIN(Limit)
					FROM
					(
						SELECT 
							MIN(temp.MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty,
							SUM(temp.MinOfAvailAndLLAndCLQty) SumOfAvailAndLLAndCLQty
						FROM
							(
								SELECT 
									MIN(MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty, MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty,IsIndemnified 
								FROM 
									#WorkingTbl 
								WHERE
									((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
								GROUP BY
									LendingLimitGrpID,PoolId,IsIndemnified,DivRate  
								HAVING
									PoolId = @PoolCount AND IsIndemnified = 1 AND DivRate = ( @DivRateAlloc * 100)
							) temp
					) p
					UNPIVOT
					(
						Limit FOR BCLUCL IN 
						(
							MinAvailAndBCLAndUCLQty,
							SumOfAvailAndLLAndCLQty
						)
					) AS unpvt		
				
					/** Update MinOfAllLimitLoopQty in working table **/
					UPDATE 
						#WorkingTbl
					SET
						MinOfAllLimitLoopQty = ISNULL(@MinOfAllLimitIndLoopQty,0)
					WHERE
						PoolId = @PoolCount AND 
						IsIndemnified = 1 AND
						((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

					/** Find Min of All Limit for NonInd Accounts **/
					SELECT 
						@MinOfAllLimitNonIndLoopQty = MIN(Limit)
					FROM
					(
						SELECT --minbclnduclindqty,minbclnduclnonindqty
							MIN(temp.MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty,
							SUM(temp.MinOfAvailAndLLAndCLQty) SumOfAvailAndLLAndCLQty
						FROM
							(
								SELECT 
									MIN(MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty,MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty,IsIndemnified 
								FROM 
									#WorkingTbl 
								WHERE
									((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
								GROUP BY 
									LendingLimitGrpID,PoolId,IsIndemnified,DivRate 
								HAVING
									PoolId = @PoolCount AND IsIndemnified = 0 AND DivRate = ( @DivRateAlloc * 100)) temp
					) p
					UNPIVOT
					(
						Limit FOR BCLUCL IN 
						(
							MinAvailAndBCLAndUCLQty,
							SumOfAvailAndLLAndCLQty
						)
					) AS unpvt

					/** Update MinOfAllLimitLoopQty in working table **/
					UPDATE 
						#WorkingTbl
					SET
						MinOfAllLimitLoopQty = ISNULL(@MinOfAllLimitNonIndLoopQty,0)
					WHERE
						PoolId = @PoolCount AND 
						IsIndemnified = 0	AND
						((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 


					/** Update MinOfAllLimitPoolQty in working table **/
					UPDATE 
						#WorkingTbl
					SET
						MinOfAllLimitPoolQty = ISNULL(@MinOfAllLimitIndLoopQty,0) + ISNULL(@MinOfAllLimitNonIndLoopQty,0)
					WHERE
						PoolId = @PoolCount AND
						((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

					SET @PoolCount = @PoolCount  + 1
				END -- end of WHILE (@PoolCount <= @TotalPoolCount)

				/** End of Loop for Non ADL Accounts - Group 1**/

			--select * FROM #AcctAvailability

				/** Find the new pool priority **/
				TRUNCATE TABLE #PoolPriority

				/** Loop for ADL - (Agent Direct Lending) Accounts - Group 2**/
				/***********  Code Changes for ADL  Accounts Starts *********/
				/* Here we are calculating Pool limits. We will have pool loop for ADL Accoutns.
				   Inside Pool Loop, there is no Account loop.We are calculating account level data by direct quries base on IsIndemnified.
				   for ADL Accounts we have different IsIndemnified value base on  Account GroupID.
				*/

				SET @PoolCount = 1
				SELECT @TotalPoolCount = COUNT(*) FROM #PoolTable
				/** Loop thru all the pools of temp pool table FOR  ADL Accounts **/
				WHILE (@PoolCount <= @TotalPoolCount)
				BEGIN
				
					/** Truncate AcctAvailability table for each pool **/	
					TRUNCATE TABLE #AcctAvailability --Work with pool level data only

				/** Assign NULL values to variables  before using them **/
					SET @WLDepository = NULL
					SET @BrkNbr = NULL
					SET @BrkID = NULL
					SET @BrkCreditLimitRemIndUSD = NULL
					SET @BrkCreditLimitRemNonIndUSD = NULL
					SET @UsageLimitRemIndUSD = NULL
					SET @UsageLimitRemNonIndUSD = NULL
					SET @PoolAvailIndQty = NULL
					SET @PoolAvailNonIndQty= NULL
					SET @MinAvailAndBCLAndUCLIndQty = NULL
					SET @MinAvailAndBCLAndUCLNonIndQty = NULL

					SET	@BrkCreditLimitRemUSD = NULL
					SET	@UsageLimitRemUSD = NULL

					/** Read values in variables **/
					SELECT
						@WLDepository = WLDepository,
						@BrkNbr = BrkNbr,
						@BrkID = BrkID
					FROM
						#PoolTable
					WHERE
						Priority = @PoolCount
					
					SELECT DISTINCT @WLDepoCode = CM_INTERFACE_TYPE FROM GLOBALONE.dbo.DEPOT where CM_ACCT_NO LIKE '%' + @WLDepository + '%'

					IF (@SmType = 'B')
					BEGIN
						SET @WLDepoCode = @WLDepoCode + 'D' 
					END
					ELSE 
					BEGIN
						SET @WLDepoCode = @WLDepoCode + 'X' 
					END

					/** Insert AcctAvailability data of a selected pool into a temp table **/
					/* Consider only ADL -(Agent Direct Lending) Accounts*/
					INSERT INTO #AcctAvailability
					(
						PoolId,
						LendingLimitGrpID,
						AcctId,
						AcctNbr,
						AcctSN,
						SecID,
						WLDepository,
						ISOCountry,
						UnitsLendableRem,
						UnitsLendableRestrictedRem,
						MinOfAvailAndLLAndCLQty,
						IsProcessed,
						DivRate,
						IsIndemnified,
						IsAgentDirectLending,
						AcctGrpId,
						TriPartyGrpID
					)
					SELECT DISTINCT	
						@PoolCount,
						LendingLimitGrpID ,
						AcctID,
						AcctNbr,
						AcctSN,
						SecID,
						WLDepository,
						ISOCountry,
						UnitsLendableRem,
						UnitsLendableRestrictedRem ,
						0, -- MinOfAvailAndLLAndCLQty
						0, -- IsProcessed
						DivRate,
						IsIndemnified,
						ISNULL(IsAgentDirectLending,0),
						AcctGrpId,
						TriPartyGrpID
					FROM 
						#ctrAvailability
					WHERE 
						SecId = @SecId AND
						WLDepository = @WLDepository AND
						(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accounts - Here we are considering ISNULL(IsIndemnified,0) != 1) because, we multiplied 'IsIndemnified' with dummy number at top'IsIndemni
fied = (LendingLimitGrpID * 2)' where IsIndemnified = 0
					ORDER BY
						LendingLimitGrpID --Order by account lending group
--SELECT * FROM #ctrAvailability
--select '#AcctAvailability - ADL tBL ' , * from #AcctAvailability
					--broker-account legal entity restrictions
					/** Delete accounts from temp table with which Broker cannot do business **/
					DELETE FROM 
						#AcctAvailability
					WHERE 
						AcctNbr IN (SELECT AcctNbr FROM #ctrBrokerAccountRestriction WHERE BrkId = @BrkID)
		
					--Eliminate accounts because of Collateral restriction
					/** Delete accounts from temp table which has collateral restriction **/
					DELETE FROM 
						#AcctAvailability
					WHERE 
						AcctNbr IN (SELECT AcctNbr FROM dbo.CtrAccountCollateralRestriction WHERE CollateralType = @LoanType)


					--The allocation logic uses variable UnitsLendableRestrictedRem in rest of the logic below
					--So assigning value of variable UnitsLendableRem to variable UnitsLendableRestrictedRem
					IF (@UseTraderLendable = 1)
					BEGIN
						UPDATE
							#AcctAvailability
						SET			
							UnitsLendableRestrictedRem = UnitsLendableRem
						WHERE
							SecID = @SecId
					END -- end of (@UseTraderLendable = 1)


					/** Get the remaining Ind Usage Conc limit for the selected BrkCrGrp **/
					SELECT 
						@UsageLimitRemIndUSD = LoanUsageIndemnifiedRemUSD 
					FROM 
						#ctrUsageConcLimit
					WHERE 
						BrkCrGrpID = @BrkCrGrpID

					/** Get the remaining Non-Ind Usage Conc limit for the selected BrkCrGrp **/
					SELECT 
						@UsageLimitRemNonIndUSD = LoanUsageNonIndemnifiedRemUSD 
					FROM 
						#ctrUsageConcLimit
					WHERE 
						BrkCrGrpID = @BrkCrGrpID


					--Logic added to adjust Limit, for 'Loaned Securities Service loan'
					IF(@IsLoanedSecurityServiceLoan = 1)
					BEGIN	
						SET @BrkCreditLimitRemIndUSD = @InifiniteVal
						SET @BrkCreditLimitRemNonIndUSD = @InifiniteVal


						SET @UsageLimitRemIndUSD = @InifiniteVal
						SET @UsageLimitRemNonIndUSD = @InifiniteVal
					END

				/** Insert ADL Accounts into Working table **/			
				INSERT INTO #WorkingTbl 
						( 
							PoolId,
							AcctPriority,
							LendingLimitGrpID,
							AcctId,
							AcctNbr,
							AcctSN,				
							BrkNbr,
							BrkID,
							AcctAvailibityRem,
							AcctAvailibityRestricted,
							LoopAvailability,
							PoolAvailability,
							BrkCrGrpID,
							BrkCreditLimitUSD,
							UsageCreditLimitUSD,				
							MinAvailAndBCLAndUCLQty,
							LendingLimitUSD,
							ConcLimitUSD,
							MinLendLimAndConcLimUSD,
							MinOfAvailAndLLAndCLQty,
							MinOfAllLimitLoopQty,
							MinOfAllLimitPoolQty,	
							UnitsLendable,
							UnUsedUnits,
							IsAcctUsed,
							SecID,
							WLDepository,
							ISOCountry,
							IsIndemnified,
							Price,
							MktValuePositionUSD,
							MktValueLoanUSD,
							PercentOnLoan,
							CanUseAcctForCleanUp,
							IsPoolUpdated,
							DivRate,
							SecLoc,
							IsAgentDirectLending,
							AcctGrpID,
							SettlementDate,
							CCYCode,
							IsPrePay,
							TriPartyGrpID
						)
						SELECT 
							@PoolCount, -- PoolId (OrgPoolPriority)
							1, -- AcctPriority -- dummy, will be updated after allocation algorithm
							avail.LendingLimitGrpID, -- LendingLimitGrpID
							avail.AcctId,
							avail.AcctNbr, -- AcctNbr
							avail.AcctSN,				
							@BrkNbr, -- BrkNbr
							@BrkID, -- BrkID
							UnitsLendableRem, -- AcctAvailibityRem
							UnitsLendableRestrictedRem, -- AcctAvailibityRestricted
							0, -- LoopAvailability
							0, -- PoolAvailability
							@BrkCrGrpID, -- BrkCrGrpID
							0, -- BrkCreditLimitUSD
							@UsageLimitRemNonIndUSD, -- UsageCreditLimitUSD			-- ADL Accounts Are NON Indemnified Only
							0, -- MinAvailAndBCLAndUCLQty
							@InifiniteVal,--@CurrentLendingGrpLimit, -- LendingLimitUSD					
							@InifiniteVal,--@CurrentConcLimit, -- ConcLimitUSD
							@InifiniteVal, -- MinLendLimAndConcLimUSD
							0, -- MinOfAvailAndLLAndCLQty
							0, -- MinOfAllLimitLoopQty
							0, -- MinOfAllLimitPoolQty
							0, -- UnitsLendable
							0, -- UnUsedUnits
							0, -- IsAcctUsed
							SecID, --SecurityID
							WLDepository,
							ISOCountry,	
							avail.IsIndemnified,
							@Price,
							0, -- MktValuePositionUSD
							0, -- MktValueLoanUSD
							0, -- PercentOnLoan,
							0, -- CanUseAcctForCleanUp
							0,  -- IsPoolUpdated
							DivRate,
							@WLDepoCode,
							ISNULL(avail.IsAgentDirectLending,0),--IsAgentDirectLending
							avail.AcctGrpID,
							@SettlementDate,
							@CCYCode,
							0 as IsPrePay ,
							avail.TriPartyGrpID
						FROM 
							#AcctAvailability avail
						WHERE 
							(ISNULL(avail.IsAgentDirectLending,0) = 1 AND ISNULL(avail.IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accounts

				-- Updates Parameters from 	#WorkingTbl	for ADL Accounts



				--===============================================================================================================================================================================								
				--Set Prepay Indicator default vs MTM Broker Maintenance MTM New Loans setup 
				--===============================================================================================================================================================================
				UPDATE 
					TMP_WT
				SET 
					IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
													FROM #TMP_DEFPREPAY_MTM_NEW_LOANS AS TMP_DEF_PREPAY_MTMNEWLN
													WHERE TMP_DEF_PREPAY_MTMNEWLN.SettlementDay = TMTMBRK.MTMNewLoans ) THEN 1 
									ELSE 0 
									END
				FROM 
					#WorkingTbl AS TMP_WT
					INNER JOIN MTMBroker AS TMTMBRK
						ON  ( TMP_WT.BrkNbr = TMTMBRK.BrkNbr )   AND  
							( ISNULL(TMTMBRK.IsDeleted, 0) = 0 ) AND  
							( @AsOfDate BETWEEN TMTMBRK.EffectiveDateBegin AND TMTMBRK.EffectiveDateEnd )

				--===============================================================================================================================================================================
				--Set Prepay Indicator default vs MTM Broker Maintenance Loan Country Exception setup 
				--===============================================================================================================================================================================
				UPDATE 
					TMP_WT
				SET 
					IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
													FROM #TMP_DEFPREPAY_MTM_LNCTRY AS TMP_DEF_PREPAY_MTMLNCTRY
													WHERE TMP_DEF_PREPAY_MTMLNCTRY.SettlementDay = TLCE.SettlementDays ) THEN 1 
									ELSE 0 
									END
				FROM 
					#WorkingTbl AS TMP_WT
					INNER JOIN MTMBrokerLoanCountryException AS TLCE  
						ON  
							( TMP_WT.BrkNbr = TLCE.BrkNbr ) AND  
							( TMP_WT.CCYCode = TLCE.LoanExcepCCY )  AND  
							( ISNULL(TLCE.IsDeleted, 0) = 0 ) AND  
							( @AsOfDate BETWEEN TLCE.EffectiveDateBegin AND TLCE.EffectiveDateEnd )
				WHERE 
							( ISNULL(TMP_WT.IsPrePay,0) = 0 ) 


				/* Update LoopAvailability	*/
				UPDATE 
					wrk
				SET
					wrk.LoopAvailability = tmpAvail.LoopAvailability
				FROM
					#WorkingTbl wrk
				INNER JOIN
					(
					SELECT 
						 SUM(avail.UnitsLendableRestrictedRem)  as LoopAvailability,avail.IsIndemnified
					FROM 
						#AcctAvailability avail
					WHERE 
						(ISNULL(avail.IsAgentDirectLending,0) = 1 AND ISNULL(avail.IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accounts
					GROUP BY
						avail.IsIndemnified 
					)tmpAvail  
				ON
					wrk.PoolId = @PoolCount AND
					(ISNULL(wrk.IsAgentDirectLending,0) = 1 AND ISNULL(wrk.IsIndemnified,0) != 1)	AND		-- Consider only ADL Non Indemnified accounts
					wrk.IsIndemnified = tmpAvail.IsIndemnified 



				-- Update BrkCreditLimitUSD for ADL accounts 
				
				UPDATE wrk
				SET
					wrk.BrkCreditLimitUSD = ISNULL(ADL.crLimitADL,0)
				FROM 
					#WorkingTbl wrk
				LEFT JOIN
					#CtrAgentDirectLendingCreditLimit ADL
				ON
					wrk.BrkCrGrpID = ADL.BrkCrGrpID AND
					wrk.AcctGrpID = ADL.AcctGrpId
				WHERE
					(ISNULL(wrk.IsAgentDirectLending,0) = 1 AND ISNULL(wrk.IsIndemnified,0) != 1 ) AND -- Consider only ADL Non Indemnified accounts
					wrk.PoolId = @PoolCount 

	
				-- Update MinAvailAndBCLAndUCLQty from #working Table
				-- This is Minimum of UsageCreditLimitUSD/@Price, BrkCreditLimitUSD/@Price, PoolAvailability 
				UPDATE wrk
				SET 
					MinAvailAndBCLAndUCLQty = tmpWork.MinAvailAndBCLAndUCLQty
				FROM
					#WorkingTbl wrk
				INNER JOIN
				(
					SELECT 
						RowId, MIN(MinLimit) AS MinAvailAndBCLAndUCLQty  FROM
						(
							SELECT 
								RowId,
								CONVERT(BIGINT,(ISNULL(BrkCreditLimitUSD,0)/@Price)) as BrkCreditLimitUSDQty,
								CONVERT(BIGINT,(ISNULL(UsageCreditLimitUSD,0)/@Price)) as UsageCreditLimitUSDQty, 
								LoopAvailability
							FROM 
								#WorkingTbl 
							WHERE  
								(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)   -- Consider only ADL Non Indemnified accounts
						)tmpQty
					UNPIVOT 
						(MinLimit FOR MinVal IN (tmpQty.BrkCreditLimitUSDQty, tmpQty.UsageCreditLimitUSDQty, tmpQty.LoopAvailability )) AS u
					GROUP BY RowId
				)tmpWork	
				ON
					(ISNULL(wrk.IsAgentDirectLending,0) = 1 AND ISNULL(wrk.IsIndemnified,0) != 1) AND   -- Consider only ADL Non Indemnified accounts
					wrk.RowId  = tmpWork.RowId AND
					wrk.PoolId = @PoolCount 



				-- Update MinOfAvailAndLLAndCLQty from #working Table
				-- This is Minimum of @TotalAvailForLendingLimitGrpQty (Availibility Against each LendingLimitGrpID --  Which is currently  'LoopAvailability' , LendingLimitUSD, ConcLimitUSD 
				UPDATE wrk
				SET 
					MinOfAvailAndLLAndCLQty = tmpWork.MinOfAvailAndLLAndCLQty
				FROM
					#WorkingTbl wrk
				INNER JOIN
					(
					SELECT 
						RowId, MIN(MinLimit) AS MinOfAvailAndLLAndCLQty 
					FROM 
						#WorkingTbl 
					UNPIVOT 
						( MinLimit FOR MinVal IN (LoopAvailability , LendingLimitUSD, ConcLimitUSD )) AS u
					WHERE  
						(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)		-- Consider only ADL Non Indemnified accounts
					GROUP BY RowId
					) tmpWork
				ON
					(ISNULL(wrk.IsAgentDirectLending,0) = 1 AND ISNULL(wrk.IsIndemnified,0) != 1) AND			-- Consider only ADL Non Indemnified accounts
					wrk.RowId  = tmpWork.RowId AND
					wrk.PoolId = @PoolCount 
					

				
				-- Update MinOfAllLimitLoopQty from #working Table 
				-- BASE ON 'IsIndemnified' Find out Minimum of 'MinAvailAndBCLAndUCLQty' and 'SumOfAvailAndLLAndCLQty' and Update it in Working Table.
				UPDATE wrk
				SET 
					MinOfAllLimitLoopQty = tmpWork.MinOfAllLimitIndLoopQty
				FROM
					#WorkingTbl wrk
				INNER JOIN
				(
				SELECT 
					 MIN(Limit) as MinOfAllLimitIndLoopQty , IsIndemnified
				FROM
				(
					SELECT 
						MIN(temp.MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty,
						SUM(temp.MinOfAvailAndLLAndCLQty) SumOfAvailAndLLAndCLQty,
						IsIndemnified
					FROM
						(
							SELECT 
								MIN(MinAvailAndBCLAndUCLQty) MinAvailAndBCLAndUCLQty, MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty,IsIndemnified 
							FROM 
								#WorkingTbl 
							WHERE 
								(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)			-- Consider only ADL Non Indemnified accounts
							GROUP BY 
								LendingLimitGrpID,PoolId,IsIndemnified,DivRate 
							HAVING 
								PoolId = @PoolCount AND DivRate = ( @DivRateAlloc * 100)
						) temp
					GROUP BY IsIndemnified
				) p
				UNPIVOT
				(
					Limit FOR BCLUCL IN 
					(
						MinAvailAndBCLAndUCLQty,
						SumOfAvailAndLLAndCLQty
					)
					
				) AS unpvt	
				group by IsIndemnified

				) tmpWork
				ON
					(ISNULL(wrk.IsAgentDirectLending,0) = 1 AND ISNULL(wrk.IsIndemnified,0) != 1) AND    -- Consider only ADL Non Indemnified accounts
					wrk.PoolId = @PoolCount AND
					wrk.IsIndemnified  = tmpWork.IsIndemnified

			
				UPDATE wrk
				SET 
					MinOfAllLimitPoolQty = tmpWork.MinOfAllLimitPoolQty
				FROM
					#WorkingTbl wrk
				INNER JOIN
				(
					SELECT SUM(tmp.tmpMinOfAllLimitLoopQty) as MinOfAllLimitPoolQty ,tmp.PoolId FROM
					(
						SELECT 
							DISTINCT w.MinOfAllLimitLoopQty tmpMinOfAllLimitLoopQty,w.PoolId
						FROM
							#WorkingTbl w
						WHERE
							w.PoolId = @PoolCount AND w.DivRate = ( @DivRateAlloc * 100)
					) tmp
					GROUP BY PoolId
				) -- Inner join end
				tmpWork
				ON
					wrk.PoolId = @PoolCount


				-- Update PoolAvailIndQty for all accoutns for that pool. 
				UPDATE 
					wrk
				SET
					wrk.PoolAvailability = tmpwork.TotalLoopAvailability
				FROM
					#WorkingTbl wrk
				INNER JOIN
					(
					SELECT 
						 SUM(w.AcctAvailibityRestricted)  as TotalLoopAvailability,w.PoolId
					FROM 
						#WorkingTbl w
					GROUP BY
						w.PoolId
					)tmpwork
				ON
					wrk.PoolId = tmpwork.PoolId AND
