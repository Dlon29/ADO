        public void CheckProcessMessage()
        {
         //   DateTime currentDateTime;
       //     TimeSpan? StartTime = null;
          //  TimeSpan? EndTime = null;
       //     bool IsWeekendEnabled = false;
            bool isConsuming = true;

            iMaxRetries = Convert.ToInt32(appConfig.AppSettings.Settings["MaxRetries"].Value);
            string StartHour = string.IsNullOrEmpty(appConfig.AppSettings.Settings["SleepStartHour"].Value) ? "" : appConfig.AppSettings.Settings["SleepStartHour"].Value;
            string EndHour = string.IsNullOrEmpty(appConfig.AppSettings.Settings["SleepEndHour"].Value) ? "" : appConfig.AppSettings.Settings["SleepEndHour"].Value;
            string SleepDays = string.IsNullOrEmpty(appConfig.AppSettings.Settings["SleepDays"].Value) ? "" : appConfig.AppSettings.Settings["SleepDays"].Value;

            string HostName = appConfig.AppSettings.Settings["HostName"].Value;
            int Port = Convert.ToInt32(appConfig.AppSettings.Settings["Port"].Value);
            string UserName = appConfig.AppSettings.Settings["UserName"].Value;
            string PassWord = appConfig.AppSettings.Settings["PassWord"].Value;
            string vHost = appConfig.AppSettings.Settings["vHost"].Value;
            string ExchangeName = appConfig.AppSettings.Settings["ExchangeName"].Value;
            string QueueName = appConfig.AppSettings.Settings["QueueName"].Value;
            string QueueKey = appConfig.AppSettings.Settings["QueueKey"].Value;
            string HeartBeatInterval = appConfig.AppSettings.Settings["HeartBeatInterval"].Value;

            iRetries = iMaxRetries;

            ConnectionFactory connectionFactory = new ConnectionFactory()
            {
                HostName = HostName,
                Port = Port,
                UserName = UserName,
                Password = PassWord,
                VirtualHost = vHost,
                RequestedHeartbeat = ushort.Parse(HeartBeatInterval)
            };

            //creating connection to mq broker.
            using (IConnection conn = connectionFactory.CreateConnection())
            {
                //creating channel.
                using (IModel ch = conn.CreateModel())
                {


                    log.Info("Message Connection successfully established.");


                    ////declare exchange
                    ch.ExchangeDeclare(ExchangeName, ExchangeType.Direct, true);
                    ////declare queue
                    ch.QueueDeclare(QueueName, true, false, false, null);

                    ////bind to queue
                    ch.QueueBind(QueueName, ExchangeName, QueueKey);

                    //declare exchange

                    //Remove all messages from the queues
                    //ch.QueuePurge(appConfig.AppSettings.Settings["QueueName"].Value, true);
                    //creating basic consumer
                    QueueingBasicConsumer consumer = new QueueingBasicConsumer(ch);
                    //start consuming at active channel.
                    log.Info("Waiting to Consume any MQ Message");

                    //  ch.BasicConsume(appConfig.AppSettings.Settings["QueueName"].Value, true, consumer);
                    ch.BasicConsume(appConfig.AppSettings.Settings["QueueName"].Value, false, consumer);   //SN to make it same as noAck=false  TriParty Sub
                    ch.BasicQos(0, 1, false);

                    while (conn.IsOpen)
                    {
                        try
                        {
                            //retrieving message
                            // RabbitMQ.Client.Events.BasicDeliverEventArgs bdea =
                            //    (RabbitMQ.Client.Events.BasicDeliverEventArgs)consumer.Queue.Dequeue();
                            object result = null;
                            isConsuming = consumer.Queue.Dequeue(Convert.ToInt32(appConfig.AppSettings.Settings["MQBusTimeoutMilliseconds"].Value), out result);
                            RabbitMQ.Client.Events.BasicDeliverEventArgs bdea = result as RabbitMQ.Client.Events.BasicDeliverEventArgs;

                            if (bdea != null)
                            {
                                IBasicProperties props = bdea.BasicProperties;
                                // to avoid duplicates
                                //ch.BasicReject(bdea.DeliveryTag, false);
                                props.Expiration = appConfig.AppSettings.Settings["MQBusTimeoutMilliseconds"].Value;        //SN added timeout..
                                //retrieving message body
                                byte[] body = bdea.Body;
                                // ... process the message
                                if (body != null)
                                {
                                    //ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
                                    log.Info(" Start processing MQ notification");
                                    //processing mq message
                                    ProcessMQMessage(System.Text.Encoding.UTF8.GetString(body));
                                    log.Info(" End processing MQ notification");
                                }
                                //confirming receive of the mq message
                                ch.BasicAck(bdea.DeliveryTag, false);
                                log.Info(" confirming receive of the MQ message");
                            }
                            else
                            {
                                //if (sftp != null) sftp.Close();

                                if (ch != null && ch.IsOpen) ch.Close(200, "Goodbye");
                                if (conn != null && conn.IsOpen) conn.Close();
                                break;
                            }
                            iRetries = iMaxRetries;
                        }
                        catch (OperationInterruptedException oie)
                        {
                            // The consumer was removed, either through
                            // channel or connection closure, or through the
                            // action of IModel.BasicCancel().
                            log.ErrorFormat(" FOR EquilendDMZ_Sub Service on {0}. MQ process Operation Interrupted.  {1} ", oie, Environment.MachineName, oie.Message);
                            if (iRetries == 0)
                            {
                                log.FatalFormat(" FOR EquilendDMZ_Sub Service on {0}. MQ process Operation Interrupted.  {1} ", oie, Environment.MachineName, oie.Message);
                                iRetries = iMaxRetries;
                            }
                            else
                            {
                                if (iRetries > 0) --iRetries;
                            }
                            break;
                        }
                        catch (Exception ex)
                        {
                            log.ErrorFormat(" FOR EquilendDMZ_Sub Service on {0}. General Exception acknowledging MQ Message.  {1} ", ex, Environment.MachineName, ex.Message);
                            if (iRetries == 0)
                            {
                                log.FatalFormat(" FOR EquilendDMZ_Sub Service on {0}. General Exception acknowledging MQ Message.  {1} ", ex, Environment.MachineName, ex.Message);
                                iRetries = iMaxRetries;
                            }
                            else
                            {
                                if (iRetries > 0) --iRetries;
                            }
                            break;
                        }
                    }
                    if (ch != null && ch.IsOpen) ch.Close(200, "Goodbye");
                }
                if (conn != null && conn.IsOpen) conn.Close();
            }
        }

        void backgroundWorker1_DoWork(object sender, DoWorkEventArgs e)
        {
            DateTime currentDateTime;
            TimeSpan? StartTime = null;
            TimeSpan? EndTime = null;
            bool IsWeekendEnabled = false;
            bool isConsuming = true;

            iMaxRetries = Convert.ToInt32(appConfig.AppSettings.Settings["MaxRetries"].Value);
            string StartHour = string.IsNullOrEmpty(appConfig.AppSettings.Settings["SleepStartHour"].Value) ? "" : appConfig.AppSettings.Settings["SleepStartHour"].Value;
            string EndHour = string.IsNullOrEmpty(appConfig.AppSettings.Settings["SleepEndHour"].Value) ? "" : appConfig.AppSettings.Settings["SleepEndHour"].Value;
            string SleepDays = string.IsNullOrEmpty(appConfig.AppSettings.Settings["SleepDays"].Value) ? "" : appConfig.AppSettings.Settings["SleepDays"].Value;                        

            string HostName = appConfig.AppSettings.Settings["HostName"].Value;
            int Port = Convert.ToInt32(appConfig.AppSettings.Settings["Port"].Value);
            string UserName = appConfig.AppSettings.Settings["UserName"].Value;
            string PassWord = appConfig.AppSettings.Settings["PassWord"].Value;
            string vHost = appConfig.AppSettings.Settings["vHost"].Value;
            string ExchangeName = appConfig.AppSettings.Settings["ExchangeName"].Value;
            string QueueName = appConfig.AppSettings.Settings["QueueName"].Value;
            string QueueKey = appConfig.AppSettings.Settings["QueueKey"].Value; 

            iRetries = iMaxRetries;

            if (StartHour.Contains(":") && EndHour.Contains(":"))
            {
                StartTime = new TimeSpan(Convert.ToInt32(StartHour.Substring(0, StartHour.IndexOf(@":"))), Convert.ToInt32(StartHour.Substring(StartHour.IndexOf(@":") + 1)), 0);
                EndTime = new TimeSpan(Convert.ToInt32(EndHour.Substring(0, EndHour.IndexOf(@":"))), Convert.ToInt32(EndHour.Substring(EndHour.IndexOf(@":") + 1)), 0);
            }
            else
            {
                log.ErrorFormat(" FOR EquilendDMZ_Sub Service on {0}. Invalid Sleep Start or End Hour format.Please specify in 24 hours (HH:MM) format.", Environment.MachineName);
            }
            
            
            while (true)
            {
                currentDateTime = DateTime.Now;
                IsWeekendEnabled = false;
                
                try
                {
                    foreach (string sleepDay in SleepDays.Split(new string[] { "||" }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        if (sleepDay.Length == 1 && (int)currentDateTime.DayOfWeek == Convert.ToInt32(sleepDay))
                        {
                            log.Info(" EquiLendDMZ_Pub Service will not execute on weekends");
                            IsWeekendEnabled = true;
                        }
                    }

                    if (!IsWeekendEnabled)
                    {
                        if (IsServiceSleeping(currentDateTime, StartTime, EndTime))
                        {
                            log.InfoFormat(" EquilendDMZ_Sub Service will not execute from {0} to {1}.", StartHour.ToString(), EndHour.ToString());
                        }
                        else
                        {
                            CheckProcessMessage();
                      
                        }
                    }
                }
                catch (Exception ex)
                {
                    log.ErrorFormat(" FOR EquilendDMZ_Sub Service on {0}.Service Interrupted for the following reason. {1} ", ex, Environment.MachineName, ex.Message);
                    if (iRetries == 0)
                    {
                        log.FatalFormat(" FOR EquilendDMZ_Sub Service on {0}.Service Interrupted for the following reason. {1} ", ex, Environment.MachineName, ex.Message);
                        iRetries = iMaxRetries;
                    }
                    else
                    {
                        if (iRetries > 0) --iRetries;
                    }
                    
                }
                finally
                {
                    //if (sftp != null) sftp.Close();
                    System.Threading.Thread.Sleep(Convert.ToInt32(appConfig.AppSettings.Settings["ThreadSuspendTimeout"].Value));                    
                }
            }           
                       
        }

        private bool IsServiceSleeping(DateTime currDate, TimeSpan? startTime, TimeSpan? endTime)
        {

            bool IsServiceIdle = false;

            if (startTime.HasValue && endTime.HasValue)
            {

                DateTime start = DateTime.Today.Add(startTime.Value);
                DateTime end = DateTime.Today.Add(endTime.Value);
                // Cope with a start hour later than an end hour - we just
                // want to invert the normal result.
                bool invertResult = end < start;
                // Now check for the current time within the time period
                // IsServiceIdle = (start <= currDate && currDate <= end) ^ invertResult;

                if (start <= currDate && currDate <= end)
                {
                    IsServiceIdle = true;
                }
                else if (invertResult && (start.AddDays(-1) <= currDate && currDate <= end))
                {
                    IsServiceIdle = true;
                }
                else if (invertResult && (start <= currDate && currDate <= end.AddDays(1)))
                {
                    IsServiceIdle = true;
                }
            }
            return IsServiceIdle;
        }

        private void ProcessMQMessage(string messageJSON)
        {
            Dictionary<string, string> values = null;            
            try
            {
                //deserializing json message                
                values = JsonConvert.DeserializeObject<Dictionary<string, string>>(messageJSON);
                //values = JSON.Instance.Parse(messageJSON) as Dictionary<string, object>;
            }
            catch (Exception e)
            {
                log.FatalFormat(" FOR EquilendDMZ_Sub Service on {0}.Error processing MQ Message {1} for the following reason. {2} ", e, Environment.MachineName, messageJSON, e.Message);
            }

            string[] files = new string[1];
            string localFilePath = string.Empty;
            bool Status = false;

            switch (values["TransferType"].ToUpper())
            {
                
                case "FTP":   
                 
                    try
                    {
                        files[0] = values["FileToTransfer"];
                        log.Info(" Start encrypting file process");
                        //localFilePath = appConfig.AppSettings.Settings["DestinationFolder"].Value + files[0];     
                        localFilePath = appConfig.AppSettings.Settings["LocalFileStore"].Value + files[0];      //SN changed to LocalFileStore.. Message should contain any relative path info required..
                        localFilePath.Replace('/', '\\');   //Relative path to absolute path..
                        //SCPFileFromRemoteServer(ref appConfig, localFilePath, appConfig.AppSettings.Settings["LocalFileStore"].Value + files[0]);
                        //taskFactory.StartNew(() => { EncryptFile(localFilePath); });                        
                    }
                    catch (Exception e)
                    {
                        log.FatalFormat(" FOR EquilendDMZ_Sub Service on {0}.Error in FTP process.  {1} ", e, Environment.MachineName, e.Message);                        
                    }
                    finally
                    {
                        log.Info(" End encrypting file process");
                    }

                    break;
                case "SCP":
                
                    try
                    {
                        files[0] = values["FileToTransfer"];
                        log.Info(" Start SCP file process");
                        localFilePath = appConfig.AppSettings.Settings["LocalFileStore"].Value + files[0];      //SN to delete DestinationFolder appsetting
                        //SCPFileToRemoteServer(ref appConfig, localFilePath);
                        if (File.Exists(localFilePath)) File.Delete(localFilePath);                        
                    }
                    catch (Exception e)
                    {
                        log.FatalFormat(" FOR EquilendDMZ_Sub Service on {0}.Error in SCP process. {1} ", e, Environment.MachineName, e.Message);                          
                    }
                    finally
                    {
                        log.Info(" End SCP file process");
                    }
                    break;
                  
                case "SFTP":
                    try
                    {
                        files[0] = values["FileToTransfer"];
                        log.Info(" Start SFTP file process");
                        //if (!String.IsNullOrEmpty(values["RemoteFolder"]))
                        //{
                        string RelativePath = values["RemoteFolder"].Trim() ?? "";
                        //localFilePath = appConfig.AppSettings.Settings["DestinationFolder"].Value + files[0];         //SN changed to LocalFileStore...
                        //}
                        //else localFilePath = appConfig.AppSettings.Settings["DestinationFolder"].Value + files[0];

                        if (RelativePath.StartsWith ("/") || RelativePath.StartsWith ("\\")) {
                            RelativePath = RelativePath.Substring(1);
                        }

                        //files[0] = files[0].Substring(files[0].LastIndexOf('/') + 1);       

                        localFilePath = appConfig.AppSettings.Settings["LocalFileStore"].Value + RelativePath + files[0];     //LocalFileStore should contain trailing "/" and RelativePath should contain head and trailing "/" chars in the path..

                        localFilePath = localFilePath.Replace("/", @"\");   //Relative path to absolute path..

                        Status = SFTPFileToRemoteServer(ref appConfig, localFilePath);
                        if (Status && File.Exists(localFilePath)) File.Delete(localFilePath);                        
                    }
                    catch (Exception e)
                    {   
                        log.FatalFormat(" FOR EquilendDMZ_Sub Service on {0}.Error in SFTP process. {1} ", e, Environment.MachineName, e.Message);                       
                    }
                    finally
                    {
                        log.Info(" End SFTP file process");
                    }
                    break;
                default:
                    log.Info(String.Format(" {0} transfer type not implemented yet", Convert.ToString(values["TransferType"]).ToUpper()));
                    break;
            }
        }

