		NULL,--CASE GotoScripEndDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL  ELSE GotoScripEndDate END,
		NULL,--CASE GotoSTTEndDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL  ELSE GotoSTTEndDate END,	
