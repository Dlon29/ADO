                    sectionDBCol.Where(r => Convert.ToInt32(r.Index) >= Convert.ToInt32(configKeys["DynamicColIndex"])).ToList().ForEach(i => i.Index = (Convert.ToInt32(i.Index) + dBDynamicColumns.Count).ToString());
                    for (int i = 0; i < dBDynamicColumns.Count; i++)
                    {
                        DBTempHeader dBDynamicHeader = new DBTempHeader();
                        dBDynamicHeader.SectionOfSheet = sheet;
                        dBDynamicHeader.Section = section;
                        dBDynamicHeader.DBColumn = dBDynamicColumns[i];
                        dBDynamicHeader.Index = (Convert.ToInt32(configKeys["DynamicColIndex"]) + i).ToString();
                        var colName = GetExcelColumnName(Convert.ToInt32(dBDynamicHeader.Index));
                        dynamicFormula += "+(" + colName + (SecRow + 1) + "*" + colName + "$" + (Convert.ToInt32(configKeys["FxRateRowPosition"]) + 1) + ")";

                        sectionDBCol.Add(dBDynamicHeader);
                        dynamicColCount++;
                    }
                }
            }
            catch (Exception)
            {

                throw;
            }
        }

