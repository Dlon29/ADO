		GotoTermDate datetime,		
		GotoComments varchar(20),
	--	GotoSTTLevel decimal(5, 2),
	--	GotoSTTDivRate decimal(13, 6),
	--	GotoSTTEndDate datetime,		
	--	GotoScripEndDate datetime,
		GotoProductCategory varchar(3),
		GotoProductCategoryLoanType varchar(20),
		GotoProductCategoryLoanDuration varchar(20),
		DesiredSTTLevel		VARCHAR(100), 
		IsProjectedDividend		BIT,	
		ProjectedDividendAmount	VARCHAR(100),
		UseAmountCheck		BIT,
		Principal			VARCHAR(50),
		NetDividendPercentage	DECIMAL(6,2),
		TraderAgreed VARCHAR(5),
		TraderConfirmationEmail VARCHAR(MAX),
		EmailSupressedFlag INT,
		SFTRCancelledLoanRefNbr VARCHAR(7),
		TPUID VARCHAR(20),
		IsPrePay BIT,
		AllocationChangeReason INT
	)

	EXEC SP_XML_REMOVEDOCUMENT @hdoc

	------------------For Bulk loan, SFTRCancelledLoanRefNbr should always be NULL------------------------------
	IF (@SQL_IDENTIFIER = 'BULKLOAN')
	BEGIN
		UPDATE 
			@TempXMLTable
		SET 
			SFTRCancelledLoanRefNbr = NULL
	END

--	select * from @TempXMLTable

	--Batch date from LAVA single loan request/Bulk loan screen may be incorrect. So use it from G1
	/** Get G1 batch date **/
	SELECT 
		@BatchDate = CurrentBatchDate 
	FROM 
		GLOBALONE.dbo.vw_G1_System	

	/* Get the common values in variables */
	SELECT TOP 1
--		@AsOfDate = AsOfDate,
--		@SecType = BucketSecType,
		@BrkNbr = BrkNbr,
		@RecordTypeID = RecordTypeID,
		@ModifiedBy = ModifiedBy,
		@UseAmountCheck = UseAmountCheck
	FROM 
		@TempXMLTable 	
	
--select @SecId		

	SELECT 
--		@BusinessInd = b.BusinessInd,
		@BrkID = b.BrkID,
		@BrkGrpID	= bg.BrkGrpID, 
		@BrkCrGrpID = bg.BrkCrGrpID
	FROM
		dbo.Broker b
	INNER JOIN 
		dbo.BrokerGroup bg
	ON
		bg.BrkGrpID = b.BrkGrpID and
		(b.EffectiveDateBegin BETWEEN bg.EffectiveDateBegin AND bg.EffectiveDateEnd) AND 
		ISNULL(bg.IsDeleted,0) = 0
	WHERE
		BrkNbr = @BrkNbr AND
		@BatchDate BETWEEN b.EffectiveDateBegin AND b.EffectiveDateEnd AND 
		ISNULL(b.IsDeleted,0) = 0		
	
	SELECT @G1UserCode = dbo.f_GetG1LavaUserMapping (@ModifiedBy) 
	
	/* Set default values to be inserted*/
	SELECT	
		@ModifiedDate		= GETDATE(),
		@RecordIndicator	= 'DTL',
		@TOE				= 'TSL',
		@ModifiedBy			= ISNULL(@ModifiedBy, SUSER_SNAME()),
		@GPTransmit		= 'Y'
	 

	/* Get the status id for Return Loan upload schedule*/
	SET @StatusId = 40 ---dbo.f_GetETIProcessFlowStatus (@RecordTypeID, 'Verified')

	SELECT 
		DISTINCT Depo.SMODE, ISNULL(LTRIM(RTRIM(GLOBALONE.dbo.f_RemoveHeaderZero(Depo.CM_ACCT_NO))), '') Depository, Temp.WLDepository,Temp.SecID 
	INTO 
		#TempSMODeDepo 
	FROM 
		@TempXMLTable Temp
	INNER JOIN
		GLOBALONE.dbo.DEPOT Depo 
	ON
		Depo.SMODE = Temp.SettlementCCY
	WHERE 
		Temp.UnitsAllocated > 0

	-- If settlement mode and depository does not match then loan cannot be booked.
	IF EXISTS(SELECT * FROM #TempSMODeDepo WHERE Depository <> WLDepository GROUP BY SecID)
	BEGIN		
		RAISERROR('Invalid Settlement Mode and Depository Combination.', 16, 1)
		RETURN 1
	END

	-- Get G1 CUSIP
	SELECT DISTINCT
		Sec.CUSIP, temp.SecID,temp.SecCode
	INTO
		#TempG1SecCode
	FROM 
		@TempXMLTable temp
	LEFT JOIN 
		GLOBALONE.dbo.vw_G1_Security Sec
	ON 
		temp.SecID = Sec.SecID
	INNER JOIN
		GLOBALONE.dbo.Availability Avail
	ON
		Avail.SecCode = sec.CUSIP AND
		temp.WLDepository = Avail.WLDepository

	-- If security does not exists in G1 then do not book the loan	
	IF EXISTS(SELECT * FROM #TempG1SecCode WHERE ISNULL(CUSIP,'') = '')
	BEGIN
		
		SELECT 
			@SecCodeList = COALESCE(@SecCodeList + ', ', '') + CAST(SecCode AS VARCHAR(2000)) 
		FROM 
			#TempG1SecCode
		WHERE 
			ISNULL(CUSIP,'') = ''
		
		RAISERROR (N'This Security does not exist in G1.', 16, 1)
		RETURN 1
	END

	--- Update G1 CUSIP in temp table
	UPDATE 
		@TempXMLTable
	SET 
		SecCode = Sec.CUSIP
	FROM 
		@TempXMLTable temp
	INNER JOIN 
		#TempG1SecCode Sec
	ON 
		temp.SecID = Sec.SecID
		
	/* Get BrkId based on BrkNbr*/
	/*IF @BrkNbr IS NOT NULL
	BEGIN
		INSERT INTO #BrkTbl 
		(
			BrkId,
			BrkNbr
		)
		SELECT 
			BrkID,
			BrkNbr
		FROM 
			dbo.[Broker] 
		WHERE 
			BrkNbr = @BrkNbr AND 
			@BatchDate BETWEEN EffectiveDateBegin AND EffectiveDateEnd AND 
			ISNULL(IsDeleted,0) = 0
	END	*/
		
	/* Get all the accounts */
	INSERT INTO #AllocationTbl 
	(
		SecID,
		AcctId,
		AcctNbr,		
		BrkNbr,
		FaceAmountFromAlloc,
		FaceAmountActual,
		AvailRestOverriden,
		AllocationChangeReason
	)
	SELECT DISTINCT 
		SecID,
		AcctId,
		Acctnbr,		
		BrkNbr,
		FaceAmountFromAlloc,
		FaceAmountActual,
		AvailRestOverriden,
		AllocationChangeReason
	FROM 
		@TempXMLTable	

--SELECT * FROM #AllocationTbl

	----Validation added for checking whether the Loan Reference Number used for UTI generation is valid-----------------------
	-----------i.e. Same Security, Broker, FaceAmount, Principal, Dates. Also it is not Pending/Outstanding trade--------------
	-----------Currently we are doing validation only in case of Single Loan booking so picking up the top record from tmp table after grouping by SecID. If we have to implement it for Bulk then we have to loop through the records in temp--------------------
------
		IF (@SQL_IDENTIFIER = 'SINGLELOAN')
		BEGIN
			-----Fetch the details for current Loan-----------------
			SELECT TOP 1
				@SFTRCancelledLoanRefNbr = SFTRCancelledLoanRefNbr,
				@CurrentLoanBrkNbr = BrkNbr, 
				@CurrentLoanSecId = SecID,	
				@CurrentLoanPrincipal = AVG(CONVERT(DECIMAL(17,2),Principal)), 
				@CurrentLoanFaceAmount = SUM(FaceAmountActual),
				@CurrentLoanSettlementDate = SettlementDate
			FROM 
				@TempXMLTable
			GROUP BY
				SFTRCancelledLoanRefNbr,BrkNbr,SecID, SettlementDate

			IF (@SFTRCancelledLoanRefNbr IS NOT NULL)
			BEGIN
			------------Fetch the details for the loan which is referred from the UI via field "LoanReferenceNumber"---------------------
			------------Apply the conditions for checking whether the loan is a Cancelled Loan and not outstanding--------------
				SELECT * INTO 
					#TempGCIErrorLog 
				FROM 
					dbo.f_GetG1ErrorMessage (0,0,'')

				SELECT
					 @RefLoanBrkNbr = Dtl.BrkNbr, 
					 @RefLoanSecId = Dtl.SecID , 
					 @RefLoanFaceAmount = ISNULL(ETICancel.FaceAmount, PLoanHist.FaceAmount), --ABS(act.FaceAmount),     -- Take FaceAmount / principal from cancelled Loan
					 @RefLoanPrincipal = ISNULL(ETICancel.Principal, PLoanHist.Principal), --act.NewPrincipal,
					 @RefLoanSentToPirum = Dtl.SendErrToPirum,
					 @RefLoanSettlementDate = ISNULL(ETICancel.SettlementDate, PLoanHist.SettlementDate)
				FROM   
					 dbo.ETIDetailRecord Dtl 
				INNER JOIN
					 #TempGCIErrorLog ErrMsg 
				ON
					  ErrMsg.RawDataID = Dtl.RawDataID  AND           
					  ErrMsg.MessageCategory = 1 -- only success
				LEFT JOIN
				(
					SELECT FaceAmount, Principal, TxnRefNbrNew,BatchDate, SettlementDate FROM ETIDetailRecord
					WHERE
						RecordTypeID IN (1) 
				) ETICancel
				ON
					ETICancel.TxnRefNbrNew = @SFTRCancelledLoanRefNbr AND
					ETICancel.BatchDate = @BatchDate
				LEFT JOIN
				(
					SELECT SUM(FaceAmount) AS FaceAmount, SUM(Principal) AS Principal, TxnRefNbr , AsOfDate, 
					CASE WHEN SettleDate IS NOT NULL THEN SettleDate ELSE RepoFromDate END AS SettlementDate FROM MOBETTER.DBO.ProcessedLoanHist
					GROUP BY TxnRefNbr, AsOfDate, SettleDate, RepoFromDate
					HAVING		
						TxnRefNbr = @SFTRCancelledLoanRefNbr AND
						AsOfDate = dbo.f_GetPrevBizDay(@BatchDate)
				) PLoanHist
				ON
					PLoanHist.TxnRefNbr = @SFTRCancelledLoanRefNbr AND
					PLoanHist.AsOfDate = dbo.f_GetPrevBizDay(@BatchDate)
				WHERE         
					  Dtl.RecordTypeId = 13 AND 
					  Dtl.StatusId = 140 AND
					  --act.AcctNbr = 'OMNI' AND
					  --act.TOE = 'CSL' AND
					  Dtl.TxnRefNbr = @SFTRCancelledLoanRefNbr AND
					  Dtl.AsOfDate = @BatchDate    -----------Get the Loans cancelled on same business day

				DROP TABLE #TempGCIErrorLog

				------------If above query does not return any record means, the Loan is a Future/Pending/Outstanding-----------------------
				IF (@RefLoanBrkNbr IS NULL)
				BEGIN
					SET @blnValidLoanRefNbr = 0
					SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Loan should not be Outstanding/Pending/Future.'
					RAISERROR(@InValidLoanRefNbrMessage, 16, 1)
					RETURN 1
				END
				ELSE
				BEGIN
					IF (@RefLoanBrkNbr IS NULL OR @CurrentLoanBrkNbr != @RefLoanBrkNbr)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Broker of the current loan should match the Broker of the referenced loan.'
					END
				
					IF (@RefLoanSecId IS NULL OR @CurrentLoanSecId != @RefLoanSecId)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Security of the current loan should match the Security of the referenced loan.'
					END

					IF (@RefLoanPrincipal IS NULL OR @CurrentLoanPrincipal != @RefLoanPrincipal)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Principal of the current loan should match the Principal of the referenced loan.'
					END

					IF (@RefLoanFaceAmount IS NULL OR @CurrentLoanFaceAmount != @RefLoanFaceAmount)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Quantity of the current loan cannot be greater than Quantity of the referenced loan.'
					END

					----------------------------Check for "Sent To Pirum" flag condition. If True then LoanRefNbr cant be used-----------------------
					IF (@RefLoanSentToPirum = 1)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Sent To Pirum should be "No" for Cancelled Loan.'
					END

					IF (@RefLoanSettlementDate IS NULL OR @CurrentLoanSettlementDate != @RefLoanSettlementDate)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Settlement Date of the current loan should match the Settlement Date of the referenced loan.'
					END

					----------------------------Check for Allocation of Cancelled Loan and New Loan(Current Loan). If same then CancelledLoanRefNbr can be used-----------------------
					----------------------------Insert the allocation details of Cancelled Loan ref Number into temp table-----------------------
					INSERT INTO
						#AllocationCancelledLoan
					(
						AcctNbr,
						BrkNbr,
						FaceAmount,
						AllocationMatched
					)
					SELECT
						ISNULL(ETICancel.AcctNbr, PLoanHist.AcctNbr),
						ISNULL(ETICancel.BrkNbr, PLoanHist.BrkNbr),
						ISNULL(ETICancel.FaceAmount, PLoanHist.FaceAmount),
						0
					FROM
						ETIDetailRecord eti
					LEFT JOIN
					(
						SELECT AcctNbr, BrkNbr, FaceAmount, TxnRefNbrNew, BatchDate FROM ETIDetailRecord
						WHERE
							RecordTypeID IN (2) 
					) ETICancel
					ON
						ETICancel.TxnRefNbrNew = @SFTRCancelledLoanRefNbr AND
						ETICancel.BatchDate = @BatchDate
					LEFT JOIN
						(
							SELECT AcctNbr, BrkNbr, FaceAmount, TxnRefNbr, AsOfDate FROM MOBETTER.DBO.ProcessedLoanHist
							WHERE TxnRefNbr = @SFTRCancelledLoanRefNbr AND
								  AsOfDate = dbo.f_GetPrevBizDay(@BatchDate)
						) PLoanHist
					ON
						PLoanHist.TxnRefNbr = @SFTRCancelledLoanRefNbr AND
						PLoanHist.AsOfDate = dbo.f_GetPrevBizDay(@BatchDate)
					WHERE
						 eti.RecordTypeID IN (13) AND	-- Allocation from Cancelled loan for current business date					 
					     eti.TxnRefNbr = @SFTRCancelledLoanRefNbr AND
						 eti.BatchDate = @BatchDate

					---------------------------Compare details of Cancelled Loan ref Number and Current Loan and update the "AllocationMatched" flag accordingly-----------------------
					UPDATE
						AL
					SET
						AL.AcctGrpID = A.AcctGrpID
					FROM
						#AllocationTbl AL
					INNER JOIN
						MOBETTER.dbo.Account A
					ON
						AL.AcctNbr = A.AcctNbr
					WHERE
						A.IsDeleted = 0 AND
						A.EffectiveDateEnd = '12/31/9999'

					UPDATE
						ACL
					SET
						ACL.AcctGrpID = A.AcctGrpID
					FROM
						#AllocationCancelledLoan ACL
					INNER JOIN
						MOBETTER.dbo.Account A
					ON
						ACL.AcctNbr = A.AcctNbr
					WHERE
						A.IsDeleted = 0 AND
						A.EffectiveDateEnd = '12/31/9999'

     -- Check Total Quantity of Cancelled Loan with Loan Reference total quanties within the Principal (Account Group)
					UPDATE
						ACL
					SET
						AllocationMatched = CASE WHEN ABS(ACLPrincipal.FaceAmount) = ABS(ALPrincipal.FaceAmount) THEN 1 ELSE 0 END
					FROM
						#AllocationCancelledLoan ACL
					INNER JOIN
					(
					    SELECT AcctGrpID , SUM(FaceAmount) AS FaceAmount FROM #AllocationCancelledLoan
						GROUP BY AcctGrpID
					) AS ACLPrincipal
					ON
						ACL.AcctGrpID = ACLPrincipal.AcctGrpID
					INNER JOIN
					(
					    SELECT AcctGrpID , SUM(FaceAmountActual) AS FaceAmount FROM	#AllocationTbl
						GROUP BY AcctGrpID
					) AS ALPrincipal
					ON
						ACL.AcctGrpID = ALPrincipal.AcctGrpID

					-- Check if Principal (AccountGroup) matches for Cancelled & Current Loan.
					UPDATE
						ACL
					SET
						AllocationMatched = 0
					FROM
						#AllocationCancelledLoan ACL
					WHERE
						AcctGrpID NOT IN ( SELECT DISTINCT AcctGrpID FROM #AllocationTbl WHERE FaceAmountActual > 0 )
					 
					 
					IF EXISTS(SELECT 1 FROM #AllocationCancelledLoan WHERE AllocationMatched = 0)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Total allocated quantity for current Loan should match with the total Quantity for the reference loan within the same principal (Account Group).'
					END

					IF (@blnValidLoanRefNbr = 0)
					BEGIN
						RAISERROR(@InValidLoanRefNbrMessage, 16, 1)
						RETURN 1
					END
				END
			END
		END

	/***** 1st step : Insert into dbo.ETITranUploadHistLog table ***/	
	SET @Ret = 1

	IF (@SQL_IDENTIFIER = 'SINGLELOAN')
		SET @FileName = 'Single Loan (EQ) from Availability'
	ELSE IF (@SQL_IDENTIFIER = 'BULKLOAN')
		SET @FileName = 'Bulk Loan (EQ) from Availability'

	INSERT INTO ETITranUploadHistLog
	(
		[TemplateID],
		[BrkCrGrpID],
		[BrkGrpID],
		[BrkID],
		[RecordTypeID],
		[FileName],
		[AsOfDate],
		[IsSuccess],
		[ModifiedBy],
		[ModifiedDate]
	)
	SELECT 
		DISTINCT 0,
		@BrkCrGrpID,
		@BrkGrpID,
		@BrkID,--b.BrkId,
		@RecordTypeID,
		@FileName,
		@BatchDate,
		@Ret,
		@ModifiedBy,
		@ModifiedDate

	SET @SourceID = @@IDENTITY
