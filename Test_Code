        /// <summary>
        /// This method write a report header based on configuration read from config sheet
        /// </summary>
        /// <param name="sheet">current sheet no</param>
        /// <param name="section">current section no</param>
        /// <param name="dtReportHeader">Data table contains report header data</param>
        /// <param name="configSections">It contains section wise configuration</param>
        /// <param name="dbColumns">It contains the information about database columns</param>
        /// <param name="workSheetTemplate">worksheet template which we need to write the data and generate the excel</param>
        public virtual void WriteReportHeader(string sheet, string section, DataTable dtReportHeader, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, ref XLSheet workSheetTemplate, ref int rowInsertCount)
        {
            //Header Section 1
            try
            {
                var sectionKey = sheet + section;
                var getSectionPosition = configSections[sectionKey].SectionValue.Split(',');  // Get starting Row and Column position from config collection.
                int secRow = Convert.ToInt32(getSectionPosition[(int)Cell.Row]), secColumn = Convert.ToInt32(getSectionPosition[(int)Cell.Column]);
                var sectionDBColumn = dbColumns.Where(p => p.Section == configSections[sectionKey].SectionName && p.SectionOfSheet == sheet).ToList(); //Retrive the Section 1 from DB columns collection

                for (int i = 0; i < dtReportHeader.Rows.Count; i++)
                {
                    for (int j = 0; j < sectionDBColumn.Count; j++)
                    {
                        WriteValue(SectionType.Header, dtReportHeader, workSheetTemplate, rowInsertCount, getSectionPosition, secRow, secColumn, sectionDBColumn, i, j);
                    }
                }
            }
            catch (Exception EX)
            {
                throw new Exception(sheet + " " + section + ": " + EX.Message + ReportGenerationExceptions(EX.Message), EX);
            }
        }
        /// This method write a report Label section based on configuration read from config sheet
        /// </summary>
        /// <param name="secNo">section no for retriving data from DB config based on section</param>
        /// <param name="dtReportHeader">Data table contains report header data</param>
        /// <param name="configSections">It contains section wise configuration</param>
        /// <param name="dbColumns">It contains the information about database columns</param>
        /// <param name="workSheetTemplate">worksheet template which we need to write the data and generate the excel</param>
        public virtual void WriteLabelSection(string sheet, string section, DataTable dtLabelSection, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, ref XLSheet workSheetTemplate, ref int rowInsertCount)
        {
            //Header Section 1
            try
            {
                var sectionKey = sheet + section;
                var getSectionPosition = configSections[sectionKey].SectionValue.Split(',');  // Get starting Row and Column position from config collection.
                int secRow = Convert.ToInt32(getSectionPosition[(int)Cell.Row]), secColumn = Convert.ToInt32(getSectionPosition[(int)Cell.Column]);
                var sectionDBColumn = dbColumns.Where(p => p.Section == configSections[sectionKey].SectionName && p.SectionOfSheet == sheet).ToList(); //Retrive the Section 1 from DB columns collection

                //DBTempHeader dBTempHeader;
                for (int i = 0; i < dtLabelSection.Rows.Count; i++)
                {
                    for (int j = 0; j < sectionDBColumn.Count; j++)
                    {
                        WriteValue(SectionType.Label, dtLabelSection, workSheetTemplate, rowInsertCount, getSectionPosition, secRow, secColumn, sectionDBColumn, i, j);

                    }
                }
                //Clear the labels if no data available
                if (dtLabelSection.Rows.Count <= 0)
                {
                    for (int j = 0; j < sectionDBColumn.Count; j++)
                    {
                        DBTempHeader dBTempHeader = new DBTempHeader();

                        dBTempHeader.DBColumn = sectionDBColumn[j].DBColumn;
                        dBTempHeader.DBNullValue = sectionDBColumn[j].DBNullValue;
                        //dBTempHeader.Formula = sectionDBColumn[j].Formula;
                        //dBTempHeader.MergedCells = sectionDBColumn[j].MergedCells;
                        //dBTempHeader.CopyFormat = sectionDBColumn[j].CopyFormat;
                        //dBTempHeader.Image = sectionDBColumn[j].Image;

                        var getSection1DynamicPosition = sectionDBColumn[j].Location.Split(',');
                        secRow = Convert.ToInt32(getSection1DynamicPosition[(int)Cell.Row]) + rowInsertCount;
                        secColumn = Convert.ToInt32(getSection1DynamicPosition[(int)Cell.Column]);

                        workSheetTemplate[secRow, secColumn].SetValue(dBTempHeader.DBNullValue, workSheetTemplate.GetCell(secRow, secColumn).Style);

                        dBTempHeader = null;
                    }
                }
            }
            catch (Exception EX)
            {
                throw new Exception(sheet + " " + section + ": " + EX.Message + ReportGenerationExceptions(EX.Message), EX);
            }
        }
        //This method writes value in a cell.
        public void WriteValue(SectionType sectionType, DataTable dtSection, XLSheet workSheetTemplate, int rowInsertCount, string[] sectionPosition, int secRow, int secColumn, List<DBTempHeader> sectionDBColumn, int rowIndex, int colIndex)
        {
            try
            {
                DBTempHeader dBTempHeader = new DBTempHeader();
                dBTempHeader.DBColumn = sectionDBColumn[colIndex].DBColumn;
                dBTempHeader.DBNullValue = sectionDBColumn[colIndex].DBNullValue;
                dBTempHeader.Formula = sectionDBColumn[colIndex].Formula;
                dBTempHeader.MergedCells = sectionDBColumn[colIndex].MergedCells;
                dBTempHeader.CopyFormat = sectionDBColumn[colIndex].CopyFormat;
                dBTempHeader.Image = sectionDBColumn[colIndex].Image;

                var getSection1DynamicPosition = sectionDBColumn[colIndex].Location.Split(',');
                secRow = Convert.ToInt32(getSection1DynamicPosition[(int)Cell.Row]) + rowInsertCount;
                secColumn = Convert.ToInt32(getSection1DynamicPosition[(int)Cell.Column]);

                //Merge cells
                if (string.IsNullOrWhiteSpace(dBTempHeader.MergedCells) == false)
                {
                    var getSection5MergedPosition = dBTempHeader.MergedCells.Split(',');
                    int rowCount = Convert.ToInt32(getSection5MergedPosition[(int)Cell.Row]);
                    int colCount = Convert.ToInt32(getSection5MergedPosition[(int)Cell.Column]);

                    workSheetTemplate.MergedCells.Add(secRow, secColumn, rowCount, colCount);
                }

                if (dBTempHeader.DBColumn == "<Formula>")//Note:  Write formula or data
                {
                    if (!string.IsNullOrWhiteSpace(dBTempHeader.Formula))//Note: Get formula from config sheet
                    {
                        workSheetTemplate[secRow, secColumn].Formula = dBTempHeader.Formula.Replace("$", (secRow + 1).ToString());
                    }
                    else//Note: Copying formula in dummy row.
                    {
                        workSheetTemplate.CopyFormula(Convert.ToInt32(sectionPosition[(int)Cell.Row]), secColumn, secRow, secColumn);
                    }

                }
                else if (!string.IsNullOrWhiteSpace(dBTempHeader.Image))
                {

                    XLPictureShape xLPicture;
                    string imageName = Convert.ToString(dtSection.Rows[rowIndex][dBTempHeader.DBColumn]);
                    xLPicture = GenerateImage(dBTempHeader, imageName);
                    workSheetTemplate[secRow, secColumn].Value = xLPicture;
                }
                else
                {
                    if (sectionType == SectionType.Header)
                    {
                        //Append existing old cell value with new value
                        object value = (workSheetTemplate.GetCell(secRow, secColumn).Text) == "" ? dtSection.Rows[rowIndex][dBTempHeader.DBColumn] : workSheetTemplate.GetCell(secRow, secColumn).Text + dtSection.Rows[rowIndex][dBTempHeader.DBColumn].ToString();
                        workSheetTemplate[secRow, secColumn].SetValue((string.IsNullOrWhiteSpace(Convert.ToString(dtSection.Rows[rowIndex][dBTempHeader.DBColumn])) == false ? value : dBTempHeader.DBNullValue), workSheetTemplate.GetCell(secRow, secColumn).Style);
                    }
                    else if (sectionType == SectionType.Label)
                    {
                        workSheetTemplate[secRow, secColumn].SetValue((string.IsNullOrWhiteSpace(Convert.ToString(dtSection.Rows[rowIndex][dBTempHeader.DBColumn])) == false ? dtSection.Rows[rowIndex][dBTempHeader.DBColumn] : dBTempHeader.DBNullValue), workSheetTemplate.GetCell(secRow, secColumn).Style);
                    }
                }

                if (dBTempHeader.CopyFormat == "1")//Note: Taking format from config sheet
                {
                    dBTempHeader.Format = sectionDBColumn[colIndex].Format.Clone();
                    workSheetTemplate[secRow, secColumn].Style = dBTempHeader.Format.Clone();
                }

                dBTempHeader = null;
            }
            catch (Exception)
            {

                throw;
            }
        }


        public void WriteReportColumns(string sheet, string section, DataTable dtReportHeader, Dictionary<string, Sections> configSections, List<DBTempHeader> dbColumns, ref XLSheet workSheetTemplate)
        {
            try
