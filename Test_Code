                                    {
                                        blnResult = false;
                                        _ErrorString = new StringBuilder();
                                        _ErrorString.Append(Common.GetMessage("Sales", "NonSaleCreateRecallInvalidData"));
                                    }

                                }

                                if (TotalQtyRecalled == 0 && dgLoanData.Items.Count > 0 /*&& blnDAProdCatFound == false*/)
                                {
                                    blnResult = false;
                                    _ErrorString = new StringBuilder();
                                    _ErrorString.Append(Common.GetMessage("Sales", "NonSaleCreateRecallEmptyData"));
                                }

                            }

                        }
                    }

                }
            }
            else if (ActionType == enumActionType.NSRSCREATERECALL.ToString())
            {
                for (int iLoanDataRowCount = 0; iLoanDataRowCount < dgNSLoanData.Items.Count; iLoanDataRowCount++)
                {
                    CheckBox chkCreateRecall = (CheckBox)dgNSLoanData.Items[iLoanDataRowCount].Cells[(int)dgNSLoanDataMapping.chkNSCreateRecall].FindControl("chkNSCreateRecall");
                    HyperLink lnkNSPrvsTxnRefNbr = (HyperLink)dgNSLoanData.Items[iLoanDataRowCount].Cells[(int)dgNSLoanDataMapping.TxnRefNbr].FindControl("lnkNSTxnRefNbr");

                    if (chkCreateRecall.Checked)
                    {
                        Int64 TotalQtyRecalled = 0;
                        string prvsProdCat = string.Empty;

                        for (int iLoanAcctDataRowCount = 0; iLoanAcctDataRowCount < dgNSLoanData.Items.Count; iLoanAcctDataRowCount++)
                        {
                            HyperLink lnkNSTxnRefNbr = (HyperLink)dgNSLoanData.Items[iLoanAcctDataRowCount].Cells[(int)dgNSLoanDataMapping.TxnRefNbr].FindControl("lnkNSTxnRefNbr");

