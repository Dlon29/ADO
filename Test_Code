                //				HttpContext.Current.Response.Write("RightPart<" + scalStr + "><br>") ;
                //
                //				if (precStr.Length > precision && Convert.ToInt64(precStr) > 0)
                //					retValue = 1 ;
                //
                //				if (scalStr.Length > scale && Convert.ToInt64(scalStr) > 0)
                //					retValue += 2 ;		

                if (precStr.Length > precision && Convert.ToInt64(precStr) > 0 ||
                    scalStr.Length > scale && Convert.ToInt64(scalStr) > 0)
                    retValue = -2;				// overflow

                if (inValue == 0)
                    retValue = 1;				// zero

                if (inValue < 0)
                    retValue = 2;				// negative
            }
            catch (Exception)
