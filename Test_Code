            try
            {
                if (clsDB.Open() == false)
                    return false;

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_EquityMovementReport;

                string[] SqlCondition = new string[9] { "", "", "52", "0", "0", "1", "RESET", "0","" };

                SqlCondition[0] = txtAsOfDate.Text;
                SqlCondition[3] = (_ReportAction == "EXCEL") ? "1" : "0";
                SqlCondition[6] = string.IsNullOrEmpty(_ReportAction) ? "RESET" : _ReportAction;
                SqlCondition[7] = "0";
                SqlCondition[8] = clsUI.NTUserName;
               

                if (clsReader.GetData(ref objDS, SqlObjects.p_EquityMovementReport, SqlCondition) == false)
                {
                    return false;
                }

                _IsEquityMovementCompleted = Common.GetEquityMovementStatus(txtAsOfDate.Text);

                //if (objDS.Tables[1].Rows.Count == 1)
                //    _IsEquityMovementCompleted = Convert.ToBoolean(objDS.Tables[1].Rows[0]["IsEquityMovementCompleted"].ToString());
                //else
                //    _IsEquityMovementCompleted = false;
                

                this.vwEquityMovement = objDS.Tables[0];
                _TotUnits = objDS.Tables[0].Compute("Sum (FaceAmtChange)", "IsDeleted = 0");

                grdEquityMovement.DataSource = vwEquityMovement;
                grdEquityMovement.DataBind();

                if (vwEquityMovement.Rows.Count > 0)
                {
                    pnlMsg.Visible = false;
                }
                else
                {
                    pnlMsg.Visible = true;
                }
            }
            catch (Exception Exc)
