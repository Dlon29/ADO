		Comments,
		BasketMarketCap,
		PriceBaseCurrency,
		FXRate,
		Price,
		DivYield,
		DateEx,
		DateRecord,
		DivPaymentRate,
		RebateRate,
		FaceAmount,
		Principal,
		ProductCategory,
		ProductCategoryLoanType, --LoanType
		ProductCategoryLoanDuration,
		SettlementDate,
		AsOfDate,
		TermDate,
		Remarks,
