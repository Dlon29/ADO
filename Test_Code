        /// </summary>
        /// <returns></returns>
        private bool GetExcelMapping()
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            SqlDataReader clsDR = null;

            bool result = true;

            string[] SqlCondition = new string[1] { "" };
            MethodName = "GetExcelMapping()";

            try
            {
                if (clsDB.Open() == false)
                    return false;

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance;

                // fill up the reason code combo box
                clsReader.SqlIdentifier = SqlIdentifier.GET_SALES_RECON_EXCEL_CONFIG_MAPPING.ToString();

                if (clsReader.GetData(ref clsDR, SqlCondition) == false)
                    return false;

                while (clsDR.Read())
                {
                    excelMapping.Add(new ExcelMapping()
                    {
                        ColumnIndex = Convert.ToInt32(clsDR["ColumnIndex"]),
                        ColumnName = clsDR["ColumnName"].ToString(),
                        ColumnType = clsDR["ColumnType"].ToString()
                    });
                }

                clsDR.NextResult();

                while (clsDR.Read())
                {
                    int excelConfigValue = Convert.ToInt32(clsDR["ConfigValue"]);
                    string excelConfigName = clsDR["ConfigName"].ToString();

                    excelConfig[excelConfigName] = excelConfigValue;
                }

            }
            catch (Exception Exc)
            {
                Information clsInfo = new Information();
                clsInfo.ErrNum = 5000;
                clsInfo.ErrStr = Exc.Message;
                clsInfo.ErrStack = Exc.StackTrace;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                Response.Redirect(Common.INFORMATIONPAGEURL);
            }
            finally
            {
                clsDB.Dispose();
            }
            return result;
        }

