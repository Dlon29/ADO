		CASE LEN(FXRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(13,6),FXRate) END,
		CASE LEN(Price) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(14,7),Price) END,
		CASE LEN(DivYield) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(13,6),DivYield) END,
		CASE DateEx WHEN '1900-01-01 00:00:00.000' THEN NULL ELSE DateEx END, 
		CASE DateRecord WHEN '1900-01-01 00:00:00.000' THEN NULL ELSE DateRecord END,
		CASE LEN(DivPaymentRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(15,8),DivPaymentRate) END,
