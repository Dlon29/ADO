
using System.Collections.Generic;
using System.Linq;

namespace SMTBUSA.Messaging
{
    public class RabbitMQAdminMessagePublisher
    {
        /// <summary>
        /// Posts a message using RabbitMQAdmin settings.
        /// Used by the first consuming application.
        /// </summary>
        public void PostMessage(
            string pstrLogid,
            string pstrMqSection,
            string pstrMqId)
        {
            PublishMessage(
                pstrMqSection,
                pstrLogid,
                pstrMqId);
        }

        /// <summary>
        /// Posts a GI message into the specified RabbitMQ queue.
        /// Used by the CAPS consuming application.
        /// </summary>
        public bool PostGIMessageInQueue(
            string sectionName,
            string queueMessage,
            string queueName)
        {
            PublishMessage(
                sectionName,
                queueMessage,
                queueName);

            return true;
        }

        /// <summary>
        /// Retrieves RabbitMQ settings and publishes the message.
        /// Common implementation used by both public methods.
        /// </summary>
        private void PublishMessage(
            string sectionName,
            string message,
            string bindingID)
        {
            var rabbitMQAdminService =
                RabbitMQAdmin.Client.ServiceProxyFactory.Instance
                    .CreateRabbitMQAdminServiceProxy();

            List<RabbitMQSettings> rabbitMQSettingsList =
                rabbitMQAdminService
                    .GetAndInitializeRabbitMQSettingsListBySection(
                        sectionName);

            Dictionary<string, RabbitMQSettings> rabbitMQSettingsDict =
                rabbitMQSettingsList.ToDictionary(
                    settings => settings.BindingID);

            RabbitMQClient rabbitMQClient =
                new RabbitMQClient(
                    rabbitMQSettingsDict[bindingID]);

            rabbitMQClient.PostMQMessage(message);
        }
    }
}

