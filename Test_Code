							#WorkingTbl

					END --end of IF (@CanProcessLoanReq = 1)
					ELSE IF (@CanProcessLoanReq = 0 AND @SQL_IDENTIFIER = 'BULKLOAN')
					BEGIN
						INSERT INTO #FinalWorkingTbl
						(
							PoolId,
							AcctPriority,
							LendingLimitGrpID,
							AcctId,
							AcctNbr,
							AcctSN,
							BrkNbr,
							BrkID,
							FaceAmount,
							AcctAvailibityRem,
							AcctAvailibityRestricted,
							LoopAvailability,
							PoolAvailability,
							BrkCrGrpID,
							BrkCreditLimitUSD,
							UsageCreditLimitUSD,
							MinAvailAndBCLAndUCLQty,
							LendingLimitUSD,
							ConcLimitUSD,
							MinLendLimAndConcLimUSD,
							MinOfAvailAndLLAndCLQty,
							MinOfAllLimitLoopQty,
							MinOfAllLimitPoolQty,
							UnitsLendable,
							UnUsedUnits,
							IsAcctUsed,
							BucketSecType,
							SecCode,
							SecID,
							WLDepository,
							ISOCountry,
							IsIndemnified,
							Price,
							MktValuePositionUSD,
							MktValueLoanUSD,
							PercentOnLoan,
							CanUseAcctForCleanUp,
							IsPoolUpdated,
							--isFITokyoRepo,
							isFITokyoSecLend,
							IsFISTBUSA,
							blnUnitsAvail,
