        /// <summary>
        /// This function is used to Copy all cells value with style from one sheet/Location to another.
        /// </summary>
        /// <param name="xLSheetSource">source sheet for the copy cells value</param>
        /// <param name="xLSheetDest">destination sheet to paste cells value</param>
        public virtual void CopyCellsFromSourceToDest(XLSheet xLSheetSource, XLSheet xLSheetDest)
        {
            try
            {
                for (int row = 0; row <= xLSheetSource.Rows.Count - 1; row++)
                {
                    xLSheetDest.Rows[row].Height = xLSheetSource.Rows[row].Height;
                    for (int col = 0; col <= xLSheetSource.Columns.Count - 1; col++)
                    {
                        xLSheetDest.Columns[col].Width = xLSheetSource.Columns[col].Width;
                        if (string.IsNullOrWhiteSpace(xLSheetSource[row, col].Formula))
                            xLSheetDest[row, col].Value = xLSheetSource[row, col].Value;
                        else
                            xLSheetDest[row, col].Formula = xLSheetSource[row, col].Formula;

                        if (xLSheetSource[row, col].Style != null)
                            xLSheetDest[row, col].Style = xLSheetSource[row, col].Style;
                    }
                }
            }
            catch (Exception)
            {

                throw;
            }
        }

        /// <summary>
        /// This function is used to Copy all cells value with style from one sheet/Location to another.
        /// </summary>
        /// <param name="xLSheetSource">source sheet for the copy cells value</param>
        /// <param name="xLSheetDest">destination sheet to paste cells value</param>
        public virtual void CopyCellsFromSourceToDest(XLSheet xLSheetSource, ref XLSheet xLSheetDest, string[] sourceLocation, string[] destinationLocation, ref int rowInsertCount, bool cut, int copyDestinationStyle = 0)
        {
            try
            {
                int rowStart = Convert.ToInt32(sourceLocation[0]) + (xLSheetSource.Name == xLSheetDest.Name ? rowInsertCount : 0);
                int colStart = Convert.ToInt32(sourceLocation[1]);
                int rowEnd = Convert.ToInt32(sourceLocation[2]) + (xLSheetSource.Name == xLSheetDest.Name ? rowInsertCount : 0);
                int colEnd = Convert.ToInt32(sourceLocation[3]);
                int destRow = Convert.ToInt32(destinationLocation[0]);
                int destCol = 0;

                for (int row = rowStart; row <= rowEnd; row++)
                {
                    destCol = Convert.ToInt32(destinationLocation[1]);
                    if (copyDestinationStyle == 0)
                    {
                        xLSheetDest.Rows[destRow].Height = xLSheetSource.Rows[row].Height;
                    }

                    for (int col = colStart; col <= colEnd; col++)
                    {
                        if (copyDestinationStyle == 0)
                        {
                            xLSheetDest.Columns[destCol].Width = xLSheetSource.Columns[col].Width;
                        }

                        if (string.IsNullOrWhiteSpace(xLSheetSource[row, col].Formula))
                            xLSheetDest[destRow, destCol].Value = xLSheetSource[row, col].Value;
                        else
                            xLSheetDest[destRow, destCol].Formula = xLSheetSource[row, col].Formula;

                        if (xLSheetSource[row, col].Style != null)
                        {
                            xLSheetDest[destRow, destCol].Style = xLSheetSource[row, col].Style;
                        }

                        if (cut)
                        {
                            xLSheetSource[row, col].Value = null;
                            xLSheetSource[row, col].Style = null;
                        }
                        destCol++;
                    }
                    destRow++;
                }
            }
            catch (Exception)
            {

                throw;
            }
        }

        /// <summary>
        /// This method is used to create the csv file from data table
        /// </summary>
        /// <param name="dtDataTable">Data table which contains the data which we need to create csv</param>
        /// <param name="strFilePath">File path to save csv</param>
        public virtual void ToCSV(DataSet dataSet, string strFilePath)
        {
            try
            {
                StreamWriter sw = new StreamWriter(strFilePath, false);

                for (int k = 1; k < dataSet.Tables.Count; k++)
                {
                    var dtDataTable = dataSet.Tables[k];
                    bool showHeader = true;
                    //headers   
                    //Note: if "ShowHeader" value is true then print column name (headres) else skip the headers.
                    if (dtDataTable.Columns.Contains("ShowHeader") && Convert.ToBoolean(dtDataTable.Rows[0]["ShowHeader"]) == false)
                    {
                        showHeader = false;
                        dtDataTable.Columns.Remove("ShowHeader");
                        dtDataTable.AcceptChanges();
                    }

                    if (showHeader == true)
                    {
                        for (int i = 0; i < dtDataTable.Columns.Count; i++)
                        {
                            sw.Write(dtDataTable.Columns[i]);
                            if (i < dtDataTable.Columns.Count - 1)
                            {
                                sw.Write(",");
                            }
                        }

                        sw.Write(sw.NewLine);
                    }

                    //row data
                    foreach (DataRow dr in dtDataTable.Rows)
                    {
                        for (int i = 0; i < dtDataTable.Columns.Count; i++)
                        {
                            if (!Convert.IsDBNull(dr[i]))
                            {
                                string value = dr[i].ToString();
                                if (value.Contains(','))
                                {
                                    value = String.Format("\"{0}\"", value);
                                    sw.Write(value);
                                }
                                else
                                {
                                    sw.Write(dr[i].ToString());
                                }
                            }
                            if (i < dtDataTable.Columns.Count - 1)
                            {
                                sw.Write(",");
                            }
                        }

                        sw.Write(sw.NewLine);
                    }
                    sw.Write(sw.NewLine);
                }
                sw.Close();
            }
            catch (Exception)
            {

                throw;
            }
        }

