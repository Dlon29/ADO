            }

            return retValue;
        }

        public static int ValidateDate(string dateString)
        {
            // date validation
            try
            {
                Convert.ToDateTime(dateString);

                if (!IsDate(dateString))
                    return -1;	//malformed date string
                else if (Convert.ToDateTime(dateString) > DateTime.Today)
                    return 1;	// if the date is greater than today
                else if (Convert.ToDateTime(dateString) < DateTime.Today)
                    return 2;	// if the date is less than today
                else
                    return 0;	// if the date is equal today
            }
            catch (Exception)
            {
                return -1;		// if the date is invalid
            }
        }

