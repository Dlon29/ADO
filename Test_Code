		GotoComments,		  		
		NULL,--GotoSTTLevel,
		NULL,--GotoSTTDivRate,  		  
		NULL,--GotoSTTEndDate,
		NULL, --GotoScripEndDate,
		CASE WHEN (LEN(GotoProductCategory) = 0 OR GotoProductCategory = '')  THEN NULL ELSE GotoProductCategory END,--GotoProductCategory,
		CASE WHEN (LEN(GotoProductCategoryLoanType) = 0 OR GotoProductCategoryLoanType = '')  THEN NULL ELSE GotoProductCategoryLoanType END,--GotoProductCategoryLoanType, 
		CASE WHEN (LEN(GotoProductCategoryLoanDuration) = 0 OR GotoProductCategoryLoanDuration = '')  THEN NULL ELSE GotoProductCategoryLoanDuration END,--GotoProductCategoryLoanDuration
		CASE WHEN (LEN(DesiredSTTLevel) = 0 OR DesiredSTTLevel = '') THEN NULL ELSE CONVERT(DECIMAL(5,2),DesiredSTTLevel) END, 
		ISNULL(IsProjectedDividend, 0),
		CASE WHEN (LEN(ProjectedDividendAmount) = 0 OR ProjectedDividendAmount = '') THEN NULL ELSE CONVERT(DECIMAL(15,8),ProjectedDividendAmount) END,
		UseAmountCheck,
		CASE WHEN (LEN(Principal) = 0 OR Principal = '') THEN NULL ELSE CONVERT(DECIMAL(17,2),Principal) END,
		NetDividendPercentage,
		CASE WHEN TraderAgreed = '' THEN NULL ELSE TraderAgreed END,
		CASE WHEN TraderConfirmationEmail = '' THEN NULL ELSE TraderConfirmationEmail END,
		CASE WHEN EmailSupressedFlag = 1 THEN @EmailSupressedFlagTSL	  ----When checkbox = checked i.e "1" from UI then pick up the suppressed flag set fpr TSL from table "DashBoardEmailActivityType"
			 WHEN (EmailSupressedFlag = 0 AND TraderAgreed = '' AND TraderConfirmationEmail = '') THEN NULL	  ----When checkbox = Not Checked, i.e "0" from UI then check for TraderAgreed and TraderConfirmationEmail columns. If the other 2 columns are '' means Trad
ers are not configured for Broker. Update EmailSupressedFlag to NULL. 
			 ELSE EmailSupressedFlag END,
		CASE WHEN SFTRCancelledLoanRefNbr = '' THEN NULL ELSE SFTRCancelledLoanRefNbr END,
		CASE WHEN TPUID = '' THEN NULL ELSE TPUID END,
		ISNULL(IsPrePay, 0),
		NULLIF(AllocationChangeReason,0)
	FROM 
	OPENXML(@hdoc, '/NewLoan/FieldName', 1)
	WITH
	(
