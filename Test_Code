		Comments			VARCHAR(20),
		SettlementInstr		VARCHAR(30),
		SettlementCCY		VARCHAR(6),
		ModifiedBy			VARCHAR(50),
		MaxLotNbr			INT,
		AvailRestOverriden	BIT,
		TriPartyGrpID		VARCHAR(3),
		CollSchedID			INT, --Change FOR P-1775 from VARCHAR(3) TO INT
		ProductCategory		VARCHAR(3),
		LowDivRate			BIT,
		STTLevel		VARCHAR(30),
		STTEndDate		DATETIME,
		STTDivRate		VARCHAR(30),
		BulkNbr			INT,
		ScripEndDate		DATETIME,
		ProductCategoryLoanType		VARCHAR(20),	--LoanType
		ProductCategoryLoanDuration	VARCHAR(20),
		BasketNbr INT,
		LIBORRate VARCHAR(100),
		ResetDate datetime,
