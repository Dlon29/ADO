	SET @INCLUDE_MTM_PENDING = ISNULL(dbo.f_GetReportParameterValue(@ReportID, '@IncludeMTMPending'), 0)		
	SET @USE_ACTUAL_RISK_WEIGHTS = CONVERT(BIT,ISNULL(dbo.f_GetReportParameterValue(@ReportID, '@UseActualRiskWeights'), 0))
	SET @INCLUDE_FUTURE_LOANS = ISNULL(dbo.f_GetReportParameterValue(@ReportID, '@IncludeFutureLoans'), 0)
	SET @IGNORE_MTM_CYCLE = ISNULL(dbo.f_GetReportParameterValue(@ReportID, '@IgnoreMTMCycle'), 0)

	SET @Source = ISNULL(@Source,'MARK')


	--Get accounts 
	IF ( OBJECT_ID('tempdb..#TMP_RWA_REPORT_ALL_ACCTS','U') IS NULL ) 
	BEGIN
		SELECT * 
		INTO #TMP_RWA_REPORT_ALL_ACCTS
		FROM dbo.f_CreateRWAReportAccountsSchema() 
