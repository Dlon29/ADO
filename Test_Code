                    AsOfDate = txtSRSBatchRunDate.Text;
                    SecCode = lnkSecCode.Text;
                    SecType = e.Item.Cells[(int)dgLoanRecallMapping.BucketSecType].Text.Trim();

                    if (SecType != "&nbsp;")
                    {
                        if (SecType.Equals(Common.enumSecType.EQ.ToString()))
                            ActionID = Common.enumActionID.GET_EQ_DETAILS.ToString();
                        else if (SecType.Equals(Common.enumSecType.FI.ToString()))
                            ActionID = Common.enumActionID.GET_FI_DETAILS.ToString();
                        else
                            ActionID = Common.enumActionID.GET_OTHER_DETAILS.ToString();

                        //pass the sec code and other required parameters here
                        QueryString3.Append("?AsOfDate=");
                        QueryString3.Append(AsOfDate);

                        QueryString3.Append("&SecCode=");
