
using System.Collections.Generic;
using System.Linq;

namespace SMTBUSA.Messaging
{
    public class RabbitMQAdminMessagePublisher
    {
        public void PostMessage(
            string pstrLogid,
            string pstrMqSection,
            string pstrMqId)
        {
            var rabbitMQAdminService =
                RabbitMQAdmin.Client.ServiceProxyFactory.Instance
                    .CreateRabbitMQAdminServiceProxy();

            // Retrieve RabbitMQ settings as a List
            List<RabbitMQSettings> ftpRabbitMQSettingsList =
                rabbitMQAdminService
                    .GetAndInitializeRabbitMQSettingsListBySection(
                        pstrMqSection);

            // Convert List into Dictionary using BindingID as the key
            Dictionary<string, RabbitMQSettings> ftpRabbitMQSettingsDict =
                ftpRabbitMQSettingsList.ToDictionary(
                    settings => settings.BindingID);

            // Retrieve the required RabbitMQ configuration
            RabbitMQClient requestQueue =
                new RabbitMQClient(
                    ftpRabbitMQSettingsDict[pstrMqId]);

            // Publish the message
            requestQueue.PostMQMessage(pstrLogid);
        }
    }
}
