			WLDepository,
			SecID,
			BucketSecType,
			ISOCountry,
			BrkID,
			BrkNbr,
			BrkCrGrpID,
			CollCcyCode,
			FaceAmount,
			TradePrice,
			Principal,
			CollCCYtoUSDExchRate,	
			PrincipalUSD,
			FinderNbr,
			LoanType,
			--isTermRepo,
			TriPartyGrpID,
			CollSchedID,
			LoanCategory,
			RepoSecurityTypeID
		)
		SELECT
			'PSL',--TOE,
			12,--RecordTypeID,
			'LoanPosition', --Source
			LP.TxnRefNbr,
			140,--StatusID, [ since these PSLs are booked in LAVA with ETIDetailRecord table StatusID as 140 after G1 successful booking , the status is set to 140]
			LP.AcctNbr,
			0, --AcctID
			0, --AcctLendGrpID
			NULL, -- isIndemnified
			--NULL, -- isFITokyoRepo
			NULL, -- isFITokyoSecLend
			NULL, -- IsFISTBUSA
			NULL,--Depository,
			NULL,--SecID,
			'', --BucketSecType
			'', --ISOCountry
			NULL,--BrkID,
			LP.BrkNbr,
			0, --BrkCrGrpID
			LP.CollCcyCode,
			LP.Quantity,
			NULL,--TradePrice,
			NULL,--Principal,
			0, --CollCCYtoUSDExchRate
			NULL,--Principal, --PrincipalUSD
			NULL,--FinderNbr,
			NULL,--LoanType,
			--NULL, --isTermRepo
			NULL,--ISNULL(TriPartyGrpID, 0),
			NULL,--ISNULL(CollSchedID, 0),
			NULL,--ISNULL(LoanCategory,'L'),
			NULL--ISNULL(RepoSecurityTypeID,0)
		FROM
			GLOBALONE.dbo.LoanPosition LP
		INNER JOIN 
			MOBETTER.dbo.Account Acc
		ON
			LP.AcctNbr = Acc.AcctNbr
		WHERE
			LP.TOE = 'PSL' AND --Only pending returns
			LP.SettleDate <= @SettlementDate AND --pending returns with Settle date <= Loan booking Settle date (future loans)
			--Acc.AcctType = 'FI' AND --Only Fixed Income
			ISNULL(Acc.IsDeleted, 0) = 0 AND
			ISNULL(Acc.IsCollateral,0) = 0 AND
			(GETDATE() BETWEEN Acc.EffectiveDateBegin AND Acc.EffectiveDateEnd) 

	END
		

	--Obtain remaining loan attributes
	UPDATE
		#PendingTbl
	SET
		WLDepository = L.ClearAgentNbr,
		SecID = L.SecID,
		--BrkID = L.BrkID,
		TradePrice = L.TradePrice,
		Principal = (CONVERT(DECIMAL(20,10),(L.TradePrice/100)))*PT.FaceAmount, --Price is in multiple of 100 units for FI
		PrincipalUSD = NULL, -- L.Principal,  -- PrincipalUSD will populated later based on Collateral CCY Code.
		FinderNbr = L.FinderNbr,
		LoanType = L.LoanType,
		TriPartyGrpID = L.TriPartyGrpID,
		CollSchedID = L.CollSchedID,
		LoanCategory = L.LoanCategory,
		RepoSecurityTypeID = L.RepoSecurityTypeID
	FROM
		#PendingTbl PT
	LEFT JOIN
		GLOBALONE.dbo.Loan L
	ON
		PT.TxnRefNbrNew = L.TxnRefNbr AND
		PT.AcctNbr = L.AcctNbr
	WHERE
		PT.TOE = 'PSL'

	--Obtain BucketSecType and ISOCountry
	UPDATE
		#PendingTbl
	SET
		BucketSecType = CASE WHEN S.BucketSecurityType <> 'RI' THEN S.BucketSecurityType ELSE 'EQ' END,
		ISOCountry = S.ISOCountry
	FROM
		#PendingTbl PT
	INNER JOIN
		Reference.dbo.Security S
	ON
		PT.SecID = S.SecID
	WHERE
		PT.TOE = 'PSL'

	--Retain only FI records
	DELETE FROM
		#PendingTbl
	WHERE
		BucketSecType != 'FI'

	--Obtain Other Coll CCY(currently EUR and AUD) to USD conversion exchange rate
	UPDATE 
		#PendingTbl 
	SET 
		CollCCYtoUSDExchRate = LAVA.dbo.f_Get_FX_Rate ('USD', CollCcyCode, (CONVERT(VARCHAR(10),GETDATE(),101)))
	WHERE
		CollCcyCode != 'USD' AND
		TOE = 'PSL'

	--CONVERT principal to USD if collateral currency code is not USD , otherwise do not convert.
	UPDATE 
		#PendingTbl 
	SET 
		PrincipalUSD = CASE WHEN (CollCcyCode != 'USD' ) THEN  Principal * CollCCYtoUSDExchRate ELSE Principal END
	WHERE
	--	CollCcyCode != 'USD' AND
		TOE = 'PSL'

	--Obtain AcctID, AcctlendingGrpID and Indemnified flag from Account table
	UPDATE
		#PendingTbl
	SET
		AcctID = A.AcctID,
		AcctGrpID = A.AcctGrpID,
		AcctLendGrpID = A.LendingLimitGrpID,
		IsFISTBUSA = ISNULL(A.IsFISTBUSA,0),
		isIndemnified =  ISNULL(A.isIndemnified,0),
		--isFITokyoRepo = ISNULL(A.IsFIRepo,0),
		isFITokyoSecLend = ISNULL(A.IsFITokio,0)
		--isTermRepo = ISNULL(A.isTermRepo,0)
	FROM
		#PendingTbl PT
	INNER JOIN
		MoBetter.dbo.Account A
	ON
		PT.AcctNbr = A.AcctNbr AND
		ISNULL(A.isDeleted,0) = 0 AND
		ISNULL(isCollateral,0) = 0 AND
		GETDATE() BETWEEN A.EffectiveDateBegin and A.EffectiveDateEnd
	WHERE
		PT.TOE = 'PSL'

	-- For Cash Repo Loan and for FI SecLend Tokyo loans , only one Broker Credit Limit is available.
	-- This is unlike other cases where Broker Credit Limit is broken into 2 buckets - Indemnified and NonIndemnified
	-- So setting isIndemnified = 0 for these accounts to make sure that appropriate broker credit limit is checked
	UPDATE
		#PendingTbl
	SET
		isIndemnified = 0		--(a dummy value)
	WHERE
		BucketSecType = 'FI' AND
		(LoanCategory = 'CR' OR LoanCategory = 'RR' OR isFITokyoSecLend = 1)  AND
		TOE = 'PSL'

	--Update Broker Credit Group
	UPDATE
		#PendingTbl
	SET
		BrkCrGrpID = Brk.BrkCrGrpID
	FROM
		#PendingTbl PT
	INNER JOIN
	(
		SELECT 
			B.BrkID, B.BrkNbr, B.BrkGrpID, BG.BrkCrGrpID
		FROM
			MoBetter.dbo.Broker B
		INNER JOIN
			MoBetter.dbo.BrokerGroup BG
		ON
			B.BrkGrpID = BG.BrkGrpID AND
			ISNULL(B.isDeleted,0) = 0 AND
			GETDATE() BETWEEN B.EffectiveDateBegin and B.EffectiveDateEnd AND
			ISNULL(BG.isDeleted,0) = 0 AND
			GETDATE() BETWEEN BG.EffectiveDateBegin and BG.EffectiveDateEnd
	) Brk
	ON
		PT.BrkNbr = Brk.BrkNbr
	WHERE
		TOE = 'PSL'

	--Set FinderNbr = '' for non-London trades
	UPDATE
		#PendingTbl		
	SET
		FinderNbr = ''
	WHERE
		ISNULL(FinderNbr,0) != '000LDN' AND
		TOE = 'PSL'

	-- Update 'IsAgentDirectLending' from #PendingTbl
	UPDATE
		#PendingTbl
	SET
		IsAgentDirectLending = ISNULL(A.IsAgentDirectLending,0)
	FROM
		#PendingTbl PT
	INNER JOIN
		MoBetter.dbo.Account A
	ON
		PT.AcctNbr = A.AcctNbr AND
		ISNULL(A.isDeleted,0) = 0 AND
		ISNULL(isCollateral,0) = 0 AND
		GETDATE() BETWEEN A.EffectiveDateBegin and A.EffectiveDateEnd
	

	--Obtain information for pending returns (PSL) : END


	--Updating Broker Credit LIMTS For FI-SEC LENDING starts
	UPDATE
		#ctrBrokerCreditLimit
	SET
		CrLimitUSSecLendIndemnifiedRem = CrLimitUSSecLendIndemnifiedRem - ISNULL(PT.USSecLendIndemnified,0),
		CrLimitUSSecLendNonIndemnifiedRem = CrLimitUSSecLendNonIndemnifiedRem - ISNULL(PT.USSecLendNonIndemnified,0),
		CrLimitLndSecLendIndemnifiedRem = CrLimitLndSecLendIndemnifiedRem - ISNULL(PT.LndSecLendIndemnified,0),
		CrLimitLndSecLendNonIndemnifiedRem = CrLimitLndSecLendNonIndemnifiedRem - ISNULL(PT.LndSecLendNonIndemnified,0),
		CrLimitTkySecLendRem = CrLimitTkySecLendRem - ISNULL(PT.PTCrLimitTkySecLendRem,0)
	FROM
		#ctrBrokerCreditLimit ctrBCL
	LEFT JOIN
	(
		SELECT
			BrkCrGrpID,
			BucketSecType,
			USSecLendIndemnified = SUM(CASE WHEN (IsFISTBUSA = 1 AND isIndemnified = 1 AND FinderNbr != '000LDN') THEN PrincipalUSD ELSE 0 END),
			USSecLendNonIndemnified = SUM(CASE WHEN (IsFISTBUSA = 1 AND isIndemnified = 0 AND FinderNbr != '000LDN') THEN PrincipalUSD ELSE 0 END),
			LndSecLendIndemnified = SUM(CASE WHEN (IsFISTBUSA = 1 AND isIndemnified = 1 AND FinderNbr = '000LDN') THEN PrincipalUSD ELSE 0 END),
			LndSecLendNonIndemnified = SUM(CASE WHEN (IsFISTBUSA = 1 AND isIndemnified = 0 AND FinderNbr = '000LDN') THEN PrincipalUSD ELSE 0 END),
			PTCrLimitTkySecLendRem = SUM(CASE WHEN isFITokyoSecLend = 1 THEN PrincipalUSD ELSE 0 END)
		FROM 
			#PendingTbl
		WHERE
			LoanCategory = 'L'   --FI SEC LENDING only and not repo
			AND ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts
		GROUP BY
			BrkCrGrpID,
			BucketSecType
	) PT
	ON
		ctrBCL.BrkCrGrpID = PT.BrkCrGrpID AND
		ctrBCL.CrType = PT.BucketSecType
	--Updating Broker Credit LIMTS For FI-SEC LENDING ENDS

	-- -- Calculation for Agent repo Lending Start
	UPDATE
		#CtrAgentDirectLendingCreditLimit
	SET
		crLimitADL  = ctrADL.crLimitADL - ISNULL(PT.PrincipalUSD,0)
	FROM
		#CtrAgentDirectLendingCreditLimit ctrADL
	LEFT JOIN
	(
		SELECT
			l.BrkCrGrpID,
			l.AcctGrpId,
			l.BucketSecType,
			PrincipalUSD = sum(ISNULL(l.PrincipalUSD, 0))
		FROM 
			#PendingTbl l 
		WHERE
			l.BucketSecType = 'FI' AND
			(ISNULL(l.IsAgentDirectLending,0) = 1 AND ISNULL(l.IsIndemnified,0) = 0)			-- Consider only ADL Non Indemnified accounts
		GROUP BY
			l.BrkCrGrpID,
			l.AcctGrpId,
			l.BucketSecType
	) PT
	ON
		ctrADL.BrkCrGrpID = PT.BrkCrGrpID AND
		ctrADL.AcctGrpId = PT.AcctGrpId AND
		ctrADL.CrType = PT.BucketSecType  AND
		ctrADL.CrType  = 'FI'
	-- -- Calculation for Agent repo Lending End




	--Updating Broker Credit LIMTS For FI-Repo LENDING starts
	DECLARE @LoanRepoSecTypeCollSchCrLimitMapping TABLE
	(
		RepoSecurityTypeID INT NULL,
		ColumnCtrIntradayLimit VARCHAR(500) NULL,
		TriPartyGrpID	INT NULL,
		CollSchedID		INT NULL
	)

	--Insert mapping between security type and credit limit for repo loans into temp table
	INSERT INTO 
		@LoanRepoSecTypeCollSchCrLimitMapping
	SELECT DISTINCT 
		RepoSecurityTypeID,
		ColumnCtrIntradayLimit,
		TriPartyGrpID,
		CollSchedID
	FROM
		LoanRepoSecTypeCollSchCrLimitMapping
	WHERE
		ISNULL(ISDELETED, 0) = 0 AND
		GETDATE() BETWEEN EffectiveDateBegin and EffectiveDateEnd	

	DECLARE @TMP_FI_REPO_LIMITS TABLE
	(
		BrkCrGrpID SMALLINT NULL,
		CrLimitTkyRepoRem BIGINT,
		CrLimitCorpRepoRem BIGINT,			
		CrLimitSupraRepoRem BIGINT,
		CrLimitUSRepoRem BIGINT
		)

	INSERT INTO @TMP_FI_REPO_LIMITS
	SELECT * from 
		(
		SELECT 
			l.BrkCrGrpID, sum(ISNULL(l.PrincipalUSD, 0)) PrincipalUSD, map.ColumnCtrIntradayLimit
		FROM 
			#PendingTbl l
		INNER JOIN 
			@LoanRepoSecTypeCollSchCrLimitMapping  map 
		ON 
			--For repo loans booking - ReposecurityTypeID, TriPartyGrpID and CollSchedID is used to determine which credit limit and account to use
			map.TriPartyGrpID = l.TriPartyGrpID 						
			AND map.CollSchedID = l.CollSchedID 
			AND map.ReposecurityTypeID = l.ReposecurityTypeID --AND map.ReposecurityTypeID = l.ReposecurityTypeID 
		WHERE 
			l.loanCategory IN ('CR','RR') ----FI Repo/Rev Repo only and not SEC LENDING
		GROUP BY 
			l.BrkCrGrpID,map.ColumnCtrIntradayLimit
		) src
		pivot
		(
			SUM(PrincipalUSD)
			for ColumnCtrIntradayLimit in ([CrLimitTkyRepoRem],[CrLimitCorpRepoRem],[CrLimitSupraRepoRem],[CrLimitUSRepoRem])
		) piv;

	UPDATE
		#ctrBrokerCreditLimit
	SET
		CrLimitUSRepoRem = ctrBCL.CrLimitUSRepoRem - ISNULL(PT.CrLimitUSRepoRem,0),
		CrLimitTkyRepoRem = ctrBCL.CrLimitTkyRepoRem - ISNULL(PT.CrLimitTkyRepoRem,0),
		CrLimitCorpRepoRem = ctrBCL.CrLimitCorpRepoRem - ISNULL(PT.CrLimitCorpRepoRem,0),			
		CrLimitSupraRepoRem = ctrBCL.CrLimitSupraRepoRem - ISNULL(PT.CrLimitSupraRepoRem,0)
	FROM
		#ctrBrokerCreditLimit ctrBCL
	LEFT JOIN
		@TMP_FI_REPO_LIMITS PT
	ON
		ctrBCL.BrkCrGrpID = PT.BrkCrGrpID AND
		ctrBCL.CrType = 'FI'

	-- Calculation for Own Repo Start
	DECLARE @TMP_FI_OWNREPO_LIMITS TABLE
	(
		BrkCrGrpID SMALLINT NULL,
		AcctGrpId INT NULL,
		CrLimitOwnRepoRem BIGINT
	)
	
	INSERT INTO @TMP_FI_OWNREPO_LIMITS
	SELECT * from 
	(
		SELECT 
			l.BrkCrGrpID,l.AcctGrpId,sum(ISNULL(l.PrincipalUSD, 0)) PrincipalUSD--,orcl.crLimitOwnRepo
		FROM 
			#PendingTbl l
		INNER JOIN 
			[MOBETTER].[dbo].[OwnRepoCreditLimit]  orcl 
		ON 						
			orcl.BrkCrGrpID = l.BrkCrGrpID 						
			AND orcl.AcctGrpId = l.AcctGrpId
			AND ISNULL(orcl.Isdeleted,0) = 0
			AND GETDATE() BETWEEN orcl.EffectiveDateBegin AND orcl.EffectiveDateEnd
		WHERE 
			l.loanCategory = 'CR' and FinderNbr = '000OWN'
		GROUP BY 
			l.BrkCrGrpID,l.AcctGrpId
	) src
	

	UPDATE
		#CtrOwnRepoCreditLimit
	SET
		CrLimitOwnRepoRem  = ctrBCL.CrLimitOwnRepoRem - ISNULL(PT.CrLimitOwnRepoRem,0)
	FROM
		#CtrOwnRepoCreditLimit ctrBCL
	LEFT JOIN
		@TMP_FI_OWNREPO_LIMITS PT
	ON
		ctrBCL.BrkCrGrpID = PT.BrkCrGrpID AND
		ctrBCL.AcctGrpId = PT.AcctGrpId AND
		ctrBCL.CrType = 'FI'

	-- Calculation for Own Repo End
	--Updating Broker Credit LIMTS For FI-Repo LENDING ENDS

	--Updating Usage Conc limits : Start
	UPDATE
		#ctrUsageConcLimit
	SET
		LoanUsageIndemnifiedRemUSD = LoanUsageIndemnifiedRemUSD - ISNULL(PT.LoanUsageIndemnifiedUSD,0),
		LoanUsageNonIndemnifiedRemUSD = LoanUsageNonIndemnifiedRemUSD - ISNULL(PT.LoanUsageNonIndemnifiedUSD,0),
		TkySecLendLoanUsageRemUSD = TkySecLendLoanUsageRemUSD - ISNULL(PT.TkySecLendLoanUsageUSD,0)--,
		--TkyRepoLoanUsageRemUSD = TkyRepoLoanUsageRemUSD - ISNULL(PT.TkyRepoLoanUsageUSD,0)
	FROM
		#ctrUsageConcLimit ctrUCL
	LEFT JOIN
	(
		SELECT
			BrkCrGrpID,
			BucketSecType,
			LoanUsageIndemnifiedUSD = SUM(CASE WHEN (IsFISTBUSA = 1 AND isIndemnified = 1 AND LoanCategory = 'L') THEN PrincipalUSD ELSE 0 END),
			LoanUsageNonIndemnifiedUSD = SUM(CASE WHEN (IsFISTBUSA = 1 AND isIndemnified = 0 AND LoanCategory = 'L') THEN PrincipalUSD ELSE 0 END),
			TkySecLendLoanUsageUSD = SUM(CASE WHEN (isFITokyoSecLend = 1  AND LoanCategory = 'L') THEN PrincipalUSD ELSE 0 END)--,
			--TkyRepoLoanUsageUSD = SUM(CASE WHEN (LoanCategory = 'CR') THEN PrincipalUSD ELSE 0 END)
		FROM 
			#PendingTbl
		GROUP BY
			BrkCrGrpID,
			BucketSecType
	) PT
	ON
		ctrUCL.BrkCrGrpID = PT.BrkCrGrpID AND
		ctrUCL.CrType = PT.BucketSecType
	--Updating Usage Conc limits : End

	--Updating Lending limits : Start
	--Applicable only for FI Sec Lending and not for Repo
	UPDATE
		#ctrLendingLimit
	SET
		LendGrpLimitRemUSD = LendGrpLimitRemUSD - ISNULL(PT.LendGrpLimitUsedUSD,0)
	FROM
		#ctrLendingLimit ctrLL
	LEFT JOIN
	(
		SELECT
			AcctLendGrpID, 
			LendGrpLimitUsedUSD = SUM(PrincipalUSD)
		FROM
			#PendingTbl
		WHERE
			( 
				--(isTermRepo = 1 AND LoanType != 'C') OR
				--(isTermRepo = 0)		
				LoanCategory = 'L'
				--AND ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
				AND (ISNULL(IsAgentDirectLending,0) = 0) -- Consider Lending Limits only for Non-ADL Accts
			)
		GROUP BY 
			AcctLendGrpID
	) PT
	ON
		ctrLL.AcctLendGrpID = PT.AcctLendGrpID
	--Updating Lending limits : End
	

	--Updating Conc limits : Start
	--Applicable only for FI Sec Lending and not for Repo
	UPDATE
		#ctrConcentrationLimit
	SET
		ConcLimitRemUSD = ConcLimitRemUSD - ISNULL(PT.ConcLimitUsedUSD,0)
	FROM
		#ctrConcentrationLimit ctrCL
	LEFT JOIN
	(
		SELECT
			BrkCrGrpID,
			AcctLendGrpID,
			ConcLimitUsedUSD = SUM(PrincipalUSD)
		FROM
			#PendingTbl 
		WHERE
			( 
				--(isTermRepo = 1 AND LoanType != 'C') OR
				--(isTermRepo = 0)
				LoanCategory = 'L'
				--AND ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
				AND (ISNULL(IsAgentDirectLending,0) = 0) -- Consider Lending Limits only for Non-ADL Accts
			)
		GROUP BY 
			BrkCrGrpID,
			AcctLendGrpID
	) PT
	ON
		ctrCL.BrkCrGrpID = PT.BrkCrGrpID AND
		ctrCL.AcctLendGrpID = PT.AcctLendGrpID
	--Updating Conc limits : End

	-- Adjust temp control table for account percent on loan
	UPDATE
		#ctrAccountPercentOnLoan
	SET
		MktValueLoanUSD = MktValueLoanUSD + ISNULL(PT.MktValueSecuritiesLoanPend,0),
		PercentOnLoan = ROUND(CONVERT(DECIMAL,(MktValueLoanUSD + ISNULL(PT.MktValueSecuritiesLoanPend,0)))/CONVERT(DECIMAL,MktValuePositionUSD),4)
	FROM
		#ctrAccountPercentOnLoan ctrAPOL
	LEFT JOIN
	(
		SELECT 
			ISOCountry, 
			AcctID, 
			MktValueSecuritiesLoanPend = SUM(PrincipalUSD)
		FROM 
			#PendingTbl
		GROUP BY
			ISOCountry, 
			AcctID
	) PT
	ON
		ctrAPOL.ISOCountry = PT.ISOCountry AND
		ctrAPOL.AcctID = PT.AcctID

	/*	
		Here logic is to calculate LendingLimitGrpID for ADL (Agent Direct Lending) accounts.
		We are taking Max of lendinglimitgrpid from account table and then,increment by 1000 (to get unique value accross all records). 
		here 1000 is a dummy number.It is used to differentiate ADL -(Agent Direct Lending) AcctGroups from NON-ADL AcctGroups.
		So for each AccountGroupId we will have unique LendingLimitGrpID in table.
	*/

	SELECT 	
		@ADLLimitAcctGrpID = MAX(ISNULL(LendingLimitGrpID,0)) + 1000 
	FROM 
		MOBETTER.dbo.Account 
	WHERE
		ISNULL(IsDeleted,0) = 0 AND
		GETDATE() BETWEEN EffectiveDateBegin AND EffectiveDateEnd

	/* Below logic will get the unique row id for each account group.*/
	INSERT INTO #TempAcctAgentDirectLending
	(
		ROWID, 
		AcctGrpID, 
		AcctID,
		LendingLimitGrpID
	)
	SELECT DISTINCT 
		DENSE_RANK() OVER(ORDER BY AcctGrpID), -- Get Unique RowID for each Account Group ID
		AcctGrpID, 
		AcctId, 
		@ADLLimitAcctGrpID	--CASE WHEN ISNULL(LendingLimitGrpID,0) = 0 THEN @ADLLimitAcctGrpID ELSE LendingLimitGrpID END
	FROM
		#ctrAvailability 
	WHERE		
		(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) = 0)				-- Consider only ADL Non Indemnified accounts

	
	/*Update pending temp table with the max lendinglimitgrpid for AgentDirectLending Accounts. */
	UPDATE 
		pendTbl
	SET 
		AcctLendGrpID = acct.LendingLimitGrpID + acct.ROWID  -- Row ID will be unique at account group level
	FROM
		#PendingTbl pendTbl
	INNER JOIN
		#TempAcctAgentDirectLending acct
	ON
		pendTbl.AcctId = acct.AcctID		
	WHERE 
		AcctLendGrpID IS NULL  AND
		(ISNULL(pendTbl.IsAgentDirectLending,0) = 1 AND ISNULL(pendTbl.IsIndemnified,0) = 0)				-- Consider only ADL Non Indemnified accounts


	/*Update availability temp table with the max lendinglimitgrpid for AgentDirectLending Account. */
	UPDATE 
		avail
	SET 
		LendingLimitGrpID = acct.LendingLimitGrpID + acct.ROWID -- Row ID will be unique at account group level
	FROM
		#ctrAvailability avail
	INNER JOIN
		#TempAcctAgentDirectLending acct
	ON
		avail.AcctId = acct.AcctID
	WHERE
		(ISNULL(avail.IsAgentDirectLending,0) = 1 AND ISNULL(avail.IsIndemnified,0) = 0)				-- Consider only ADL Non Indemnified accounts

	
	/*	SET IsIndemnified value for each ADL - (Agent Direct Lending) accounts. 
		For Non-ADL accounts there would be 2 loops i.e. IsIndemnified = 0 and IsIndemnified = 1.(We will have only 2 values  IsIndemnified = 0 and IsIndemnified = 1)
		For ADL (Agent Direct Lending) Accounts, each AccountGroupID will have different IsIndemnified value.
		For ADL (Agent Direct Lending) Accounts, each AccountGroupID will have different LendingLimitGrpID value.
		LendingLimitGrpID is calculated from AccountGroupID, 
		To find out unique IsIndemnified value base on AccountGroupID, we are multiplying LendingLimitGrpID by 2, ( here 2 is dummy Value)
		As a result, we will have unique combination for  each AccountGroupId - LendingLimitGrpID - IsIndemnified.
	*/
	UPDATE  
		ctr
	SET 
		IsIndemnified = (LendingLimitGrpID * 2) -- Multiplied	 LendingLimitGrpID by 2 just to keep IsIdemnified unique at account group level
	FROM
		#ctrAvailability ctr
	WHERE 
		(ISNULL(ctr.IsAgentDirectLending,0) = 1 AND ISNULL(ctr.IsIndemnified,0) = 0)				-- Consider only ADL Non Indemnified accounts


