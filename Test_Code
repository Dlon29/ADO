		GotoTermDate,
		ResetDate,
		GotoProductCategory,
		DesiredSTTLevel,
		DivRateForAlloc,
		TPUID,
		IsPrePay
	)	
	SELECT 
		BulkNbr,
		VersionNbr,
		SecID,
		BucketSecType,
		BrkID,
		BrkName,
		TriPartyID,
		BrkNbr,
		BrokerLendable,
		CASE LEN(TriPartyGrpID) WHEN 0 THEN NULL ELSE CONVERT(INT,TriPartyGrpID) END,--TriPartyGrpID,
		CASE LEN(CollSchedID) WHEN 0 THEN NULL ELSE CONVERT(INT,CollSchedID) END,--CollSchedID,
		CollCCYCode,	
		FinderNbr,
		FinderAvailabilityOnly,
		LowDivRate,
		Comments,
		BasketMarketCap,
		CASE LEN(PriceBaseCurrency) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(14,7),PriceBaseCurrency) END,
		CASE LEN(FXRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(13,6),FXRate) END,
		CASE LEN(Price) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(14,7),Price) END,
		CASE LEN(DivYield) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(13,6),DivYield) END,
		CASE DateEx WHEN '1900-01-01 00:00:00.000' THEN NULL ELSE DateEx END, 
		CASE DateRecord WHEN '1900-01-01 00:00:00.000' THEN NULL ELSE DateRecord END,
		CASE LEN(DivPaymentRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(15,8),DivPaymentRate) END,
		CASE LEN(RebateRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(9,6),RebateRate) END,
		FaceAmount,
		CASE LEN(Principal) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(17,2),Principal) END, 
