        /// <summary>
        /// Page navigation click
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void PageNavigation_Click(object sender, System.Web.UI.WebControls.CommandEventArgs e)
        {
            MethodName = "PageNavigation_Click()";

            try
            {
                grdDetail.SelectedIndex = -1;
                GetParameter();

                switch (e.CommandName.ToUpper())
                {
                    case "FIRST":
                        _PageNo = 1;
                        break;

                    case "PREVIOUS":
                        _PageNo--;
                        if (_PageNo < 1)                //prev
                            _PageNo = 1;
                        break;

                    case "NEXT":
                        _PageNo++;
                        if (_PageNo > _TotPage)     //next
                            _PageNo = _TotPage;
                        break;

                    case "LAST":
                        _PageNo = _TotPage;
                        break;

                    case "GOTO1":
                        _PageNo = Int32.Parse(this.txtGoTo1.Text);
                        break;

                    case "GOTO2":
                        _PageNo = Int32.Parse(this.txtGoTo2.Text);
                        break;
                }

                // refresh the page based on the navigation
                GetRecords(enumActionType.SRR.ToString());
            }
            catch (Exception Exc)
            {
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
            }
        }

        /// <summary>
        /// Grid item command event
        /// </summary>
        /// <param name="source"></param>
        /// <param name="e"></param>
        private void grdDetail_ItemCommand(object source, System.Web.UI.WebControls.DataGridCommandEventArgs e)
        {
            MethodName = "grdDetail_ItemCommand()";

            try
            {
                grdDetail.SelectedIndex = -1;

                if (e.Item.ItemType == ListItemType.Item ||
                    e.Item.ItemType == ListItemType.AlternatingItem ||
                    e.Item.ItemType == ListItemType.SelectedItem)
                {
                    // Highlight the current row being edited.
                    if (_PrevRowHighlighted >= 0)
                    {
                        if (_IsPrevRowAlternate)
                            grdDetail.Items[_PrevRowHighlighted].CssClass = Common.enumStyleCSS.AlternatingItemStyle.ToString();
                        else
                            grdDetail.Items[_PrevRowHighlighted].CssClass = Common.enumStyleCSS.ItemStyle.ToString();
                    }

                    e.Item.CssClass = Common.enumStyleCSS.SelectedItemStyle.ToString();

                    if (e.Item.ItemType == ListItemType.AlternatingItem)
                        _IsPrevRowAlternate = true;
                    else
                        _IsPrevRowAlternate = false;

                    _PrevRowHighlighted = e.Item.ItemIndex;

                    // display in the detail section
                    cboAcctNbr.ClearSelection();
                    cboAcctNbr.Items.FindByValue(e.Item.Cells[0].Text).Selected = true;

                    this.txtBatchRunDate2.Text = e.Item.Cells[4].Text.Trim();
                    this.lblFileDetails.Text = e.Item.Cells[3].Text;

                    //Audit info
                    _AuditInfo = "Last Updated: " + e.Item.Cells[9].Text + " by " + e.Item.Cells[8].Text;

                    _SalesUploadHeaderId = Convert.ToInt16(e.Item.Cells[10].Text);
                    // enable detail controls
                    EnableDetail(true);

                    if (e.CommandName == "Delete")
                    {
                        _ActionFlag = "D";

                        if (SaveRecord() == true)
                        {
                            // Put user code to initialize the page here
                            if (GetParameter() == false)
                                Response.Write(Common.GetMessage("Common", "ErrorGetParam"));

                            if (GetRecords("") == false)
                                Response.Write(Common.GetMessage("Common", "ErrorReadingData"));
                        }
                        _ActionFlag = "";
                    }
                    else
                    {   //modify
                        // if deleted record
                        if (!Convert.ToBoolean(e.Item.Cells[5].Text))
                        {
                            // disable detail controls
                            EnableDetail(false);

                            this.cmdSave.Text = "Correct";
                            _ActionFlag = "U";
                            _ActionMode = "Edit";
                        }
                        else
                        {
                            this.cmdSave.Text = "Save";
                            _ActionFlag = "U";
                            _ActionMode = "Edit";
                        }

                        GetParameter();
                        _DetailShow = "";
                    }
                }
            }
            catch (Exception Exc)
            {
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
            }
        }

        /// <summary>
