        /// <summary>
        /// This method will create Recall
        /// </summary>
        /// <param name="Module"></param>
        private void CreateRecall(string Module)
        {
            string xml = string.Empty;
            Database clsDB = new Database();
            DataCommand clsCmd = new DataCommand();
            DataReader clsReader = new DataReader();
            DataSet ds = new DataSet();
            string[] SqlCondition;
            bool blnStatus = false;
            MethodName = "CreateRecall(" + Module + ")";

            if (Module == "S")
            {
                hiddenTab.Value = enumActionType.SRS.ToString();
                xml = AddNodeToXMLFile("CREATERESALECALL", string.Empty);
            }
            else
            {
                hiddenTab.Value = enumActionType.NSRS.ToString();
                xml = AddNodeToXMLFile("CREATERENONSALECALL", string.Empty);
            }



            if (xml == string.Empty)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Common.GetMessage("Recall", "SelectRecall"));
                return;
            }

            try
            {

                SqlCondition = new string[4] { "", "", "", "" };

                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.SqlIdentifier = "";
                SqlCondition[0] = enumActionType.CREATERECALL.ToString();
                SqlCondition[1] = xml;
                SqlCondition[2] = string.Empty;
                SqlCondition[3] = string.Empty;

                if (clsReader.GetData(ref ds, SqlObjects.p_SaveData_Sales_Recall, SqlCondition) == false)
                {
                    blnStatus = false;
                    _logger.Debug(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                    throw new Exception(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                }
                else
                {
                    blnStatus = true;
                }

                //Code added by Neelima on 17-July to store the Save Excludede Recalls.
                if (Module == "S")
                {
                    hiddenTab.Value = enumActionType.SRS.ToString();
                    xml = AddNodeToXMLFile(enumActionType.SAVEEXCLUDERECALL.ToString(), string.Empty);

                    if (xml != string.Empty)
                    {

                        SqlCondition = new string[4] { "", "", "", "" };

                        if (clsDB.Open() == false)
                        {
                            _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                            throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                        }

                        clsReader.Connection = clsDB.Connection;
                        clsReader.SqlIdentifier = "";
                        SqlCondition[0] = enumActionType.SAVEEXCLUDERECALL.ToString();
                        SqlCondition[1] = xml;
                        SqlCondition[2] = string.Empty;
                        SqlCondition[3] = string.Empty;

                        if (clsReader.GetData(ref ds, SqlObjects.p_SaveData_Sales_Recall, SqlCondition) == false)
                        {
                            blnStatus = false;
                            _logger.Debug(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                            throw new Exception(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                        }
                        else
                        {
                            blnStatus = true;
                        }

                    }
                }

                //Code added by Neelima on 17-July to store the Save Excludede Recalls ENDS.


                if (blnStatus)
                {
                    ConfirmMessage(Common.GetMessage("Sales", "RecallSubmitted"), Module);

                    if (Module == "S")
                    {
                        hiddenTab.Value = enumActionType.SRS.ToString();
                    }
                    else
                    {
                        hiddenTab.Value = enumActionType.NSRS.ToString();
                        GetRecords(enumActionType.RECALLSETUPFROMNONSALETAB.ToString());
                    }
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
            }
        }

