		DivRateForAlloc			DECIMAL(8,5),
		TPUID				VARCHAR(20),
		IsPrePay			BIT
	)

	EXEC SP_XML_PREPAREDOCUMENT @hdoc output, @SQL_CONDITION1	

	INSERT INTO	@TempBasketData
	(
		BulkNbr,
		VersionNbr,
		SecID,
		BucketSecType,
		BrkID,
		BrkName,
		TriPartyID,
		BrkNbr,
		BrokerLendable,
		TriPartyGrpID,
		CollSchedID,
		CollCCYCode,	
		FinderNbr,
		FinderAvailabilityOnly,
