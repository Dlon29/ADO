                bool hasGrandTotal = String.IsNullOrWhiteSpace(configSections[sectionKey].HasGrandTotal) == true ? false : Convert.ToBoolean(Convert.ToInt16(configSections[sectionKey].HasGrandTotal.Split(',')[0]));
                var grandTotalRows = (hasGrandTotal == true) ? configSections[sectionKey].HasGrandTotal.Split(',') : null;

                //Variables for Group and Merging Reports
                var groupKey = !String.IsNullOrWhiteSpace(configSections[sectionKey].GroupKey) ? configSections[sectionKey].GroupKey.Trim() : null;
