    function fnFormatNumber(txtObject) {        
        if (txtObject.value != '') {
            var Qty = parseInt(txtObject.value);
            if (Qty.toString() == "NaN") {
                txtObject.value = 0;
            }
            else {
                var number = '';
                number = addCommas(parseInt(replaceAll(txtObject.value, ',', '')));
                txtObject.value = number;
            }
        }
    }

    function replaceAll(text, findStr, replaceStr) {
        return text.replace(new RegExp(findStr, "g"), replaceStr);
    }

    function fnIsNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode != 45 && charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 44 && charCode != 46) // charCode = 44 for ','// charCode = 46 for '.'
            return false;

        return true;
    }

    function fnCheckDecimalNumber(evt, Object, noOfDigits) {        
        var charCode = (evt.which) ? evt.which : event.keyCode

        if (charCode != 45 && charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 44 && charCode != 46) // 1) charCode = 44 for ',' 2) charCode = 46 for '.'
            return false;
        else {
            var arr = Object.value.split('.');
            if (arr.length > 1) {
                if (arr[1].length < noOfDigits)
                    return true;
                else
                    return false;
            }
        }
    }

    function addCommas(nStr) {
        nStr += '';
        x = nStr.split('.');
        x1 = x[0];
        x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1)) {
            x1 = x1.replace(rgx, '$1' + ',' + '$2');
        }
        return x1 + x2;
    }

    function HighLightRow(dataGridItem, alternateItem) {
        var Row = document.getElementById(dataGridItem);
        var PrevRow = document.getElementById(PrevRowHighlighted);

        if (PrevRow != null) {
