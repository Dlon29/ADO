SELECT
    SERVERPROPERTY('ProductVersion') AS ProductVersion,
    SERVERPROPERTY('ProductLevel') AS ProductLevel,
    SERVERPROPERTY('Edition') AS Edition,
    compatibility_level
FROM sys.databases
WHERE name = DB_NAME();



SELECT TOP 100
    broker.BrkID,
    LEN(CAST(broker.BrkID AS VARCHAR(MAX))) AS BrkIDLength,

    bkrGrp.BrkGrpCode,
    LEN(CAST(bkrGrp.BrkGrpCode AS VARCHAR(MAX))) AS BrkGrpCodeLength,

    Sec.BucketSecurityType,
    LEN(CAST(Sec.BucketSecurityType AS VARCHAR(MAX))) AS BucketSecurityTypeLength,

    Loan.LoanType,
    CASE Loan.LoanType
        WHEN 'C' THEN 'C'
        ELSE 'NC'
    END AS NewLoanType,
    LEN(CASE Loan.LoanType
        WHEN 'C' THEN 'C'
        ELSE 'NC'
    END) AS LoanTypeLength
FROM GLOBALONE.dbo.Loan Loan
INNER JOIN REFERENCE.dbo.Security Sec
    ON Sec.SecID = Loan.SecID
INNER JOIN Mobetter.dbo.Broker broker
    ON Loan.BrkNbr = broker.BrkNbr
INNER JOIN Mobetter.dbo.BrokerGroup bkrGrp
    ON broker.BrkGrpID = bkrGrp.BrkGrpID
WHERE Loan.LoanType <> 'C';
