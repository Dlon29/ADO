            return blnResult;
        }

        /// <summary>
        /// This method will validate input
        /// </summary>
        /// <param name="actionType"></param>
        /// <returns></returns>
        private bool ValidateInputs(string actionType)
        {
            bool IsError = false;
            string strDate = "";
            int retValue = 0;
            _ErrorString = new StringBuilder("");

            switch (actionType.ToUpper())
            {
                case "SEARCH":
                case "PRINT":
                    // input date validation

                    strDate = Request.Form["txtBatchRunDate"];
                    retValue = Common.ValidateDate(strDate);

                    switch (retValue)
                    {
                        case -1:
                            IsError = true;
                            _ErrorString.Append("<a href = \"#\" OnClick = SetFocus('txtBatchRunDate');>\n");
                            _ErrorString.Append("\t" + Common.GetMessage("Common", "ErrorValidBussDate") + "\n");
                            _ErrorString.Append("</a> <br>\n");
                            break;
                    }
                    break;
                case "SAVE":

                    if (this.cboAcctNbr.SelectedValue == "0")
                    {
                        IsError = true;
                        _ErrorString.Append("<a href = \"#\" OnClick = SetFocus('cboAcctNbr');>\n");
                        _ErrorString.Append("\t" + Common.GetMessage("Common", "InvalidAccount") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }

                    // Effective from date
                    strDate = this.txtBatchRunDate2.Text;
                    retValue = Common.ValidateDate(strDate);

                    switch (retValue)
                    {
                        case -1:        // invalid date
                            IsError = true;
                            _ErrorString.Append("<a href = \"#\" OnClick = SetFocus('txtBatchRunDate2');>\n");
                            _ErrorString.Append("\t" + Common.GetMessage("Common", "ErrorEffectiveFrom") + "\n");
                            _ErrorString.Append("</a> <br>\n");
                            break;
                    }

                    PostFilePath = this.flUpload.PostedFile.FileName;
                    //ValidateDBProfile(actionType);

                    if (PostFilePath.Length <= 0)
                    {
                        IsError = true;
                        _ErrorString.Append("<a href = \"#\" OnClick = SetFocus('flUpload');>\n");
                        _ErrorString.Append("\t" + Common.GetMessage("Common", "ErrorUploadFile") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }

                    if (!allowedFileExtensions.ToLower().Contains(Path.GetExtension(PostFilePath).ToLower()))
                    {
                        IsError = true;
                        _ErrorString.Append("<a href = \"#\" OnClick = SetFocus('flUpload');>\n");
                        _ErrorString.Append("\t" + Common.GetMessage("Common", "InvalidTemplate") + "\n" +"Allowed Extensions are : " + allowedFileExtensions);
                        _ErrorString.Append("</a> <br>\n");
                    }
                    break;

            }

            return !IsError;
        }

        private bool ValidateBulkInputs(string actionType, RequestFile requestFile = null)
