			BrkCreditLimitUSD,
			UsageCreditLimitUSD,
			MinAvailAndBCLAndUCLQty,
			LendingLimitUSD,
			ConcLimitUSD,
			MinLendLimAndConcLimUSD,
			MinOfAvailAndLLAndCLQty,
			MinOfAllLimitLoopQty,
			MinOfAllLimitPoolQty,
			UnitsLendable,
			UnUsedUnits,
			IsAcctUsed,
			BucketSecType,
			SecCode,
			SecID,
			WLDepository,
			ISOCountry,
			IsIndemnified,
			Price,
			MktValuePositionUSD,
			MktValueLoanUSD,
			PercentOnLoan,
			CanUseAcctForCleanUp,
			IsPoolUpdated,
			isFITokyoSecLend,
			IsFISTBUSA,
			blnUnitsAvail,
			SecLoc,
			SMODE,
			IsAgentDirectLending,
			AcctGrpID,
			IsPrePay,
			TriPartyGrpID
		)		
		SELECT 
			1 PoolId,
			1 AcctPriority,
			LendingLimitGrpID,
			AcctId,
			AcctNbr,
			AcctSN,
			@BrkNbr,
			@BrkID,
			@FaceAmount FaceAmount,
			UnitsLendableRem,
			UnitsLendableRestrictedRem,
			NULL LoopAvailability,
			NULL PoolAvailability,
			@BrkCrGrpID,
			NULL BrkCreditLimitUSD,
			NULL UsageCreditLimitUSD,
			NULL MinAvailAndBCLAndUCLQty,
			NULL LendingLimitUSD,
			NULL ConcLimitUSD,
			NULL MinLendLimAndConcLimUSD,
			NULL MinOfAvailAndLLAndCLQty,
			NULL MinOfAllLimitLoopQty,
			NULL MinOfAllLimitPoolQty,
			0 UnitsLendable,
			0 UnUsedUnits,
			0 IsAcctUsed,
			@BucketSecType,
			@SecCode,
			SecID,
			WLDepository,
			ISOCountry,
			IsIndemnified,
			@Price Price,
			NULL MktValuePositionUSD,
			NULL MktValueLoanUSD,
			NULL PercentOnLoan,
			NULL CanUseAcctForCleanUp,
			NULL IsPoolUpdated,
			0 isFITokyoSecLend,
			0 IsFISTBUSA,
			CASE WHEN @FaceAmount > @TotalIndNonIndUnitsRestrictedRem THEN 0 ELSE 1 END,
			NULL SecLoc,
			NULL SMODE,
			IsAgentDirectLending,
			AcctGrpID,
			NULL IsPrePay,
			TriPartyGrpID
		FROM 
			#AcctNotAllowedToTrade 
		WHERE
			AcctNbr NOT IN ( SELECT AcctNbr FROM #FinalWorkingTbl )	

		-- Adding "NetLendableCPTY" on the grid to show it is allowed to trade or not only in case of single loan booking	
		SELECT 
			FWT.*, 
			CASE WHEN FWT.AcctGrpID IN (SELECT CAST(PARAMETER AS smallint) As AcctGrpID FROM LAVA.DBO.f_ParseParameters(@ActiveTradingCBJAcctGrpID)) THEN			
				CASE WHEN NetLendableCPTY= 'ATT' THEN 'Allowed to Trade' ELSE 'Not Allowed to Trade' END 
			ELSE '' END AS NetLendableCPTY
		FROM 
			#FinalWorkingTbl FWT
		LEFT JOIN
			#TempCtrLendableCPTY TCLCP
		ON
			FWT.AcctNbr= TCLCP.AcctNbr AND
			FWT.BrkCrGrpID = TCLCP.BrkCrGrpID 
		ORDER BY
			PoolId ,isFITokyoSecLend ,isFISTBUSA 
       	
		--SELECT * FROM #FinalWorkingTbl ORDER BY PoolId ,isFITokyoSecLend ,isFISTBUSA 

		--------------For Reverse Repo the Loans will be spilt based on Collateral lots hence skip this check-----------------------------
		IF (@IsRevRepoLoan = 1)
		BEGIN
			SET @IsLoanBreak = 0

			SELECT
				@RevRepoLendLimitRemUSD = LendingLimitUSD,
				@RevRepoBrkCreditLimitRemUSD = BrkCreditLimitUSD
			FROM
				#FinalWorkingTbl	
		END
		ELSE
		BEGIN
			IF ((@SMSecType = '0' OR @SMSecType = '2' OR @SMSecType = '6') AND @FaceAmount > 50000000)
			BEGIN
				SET @IsLoanBreak = 1
			END
		END

		SELECT @IsLoanBreak IsLoanBreak

		SELECT DISTINCT @WLDepository = WLDepository 
		FROM #FinalWorkingTbl 
		WHERE (ISNULL(UnitsLendable,0) > 0 )
	
		--SELECT @WLDepoCode DepoCode,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
		SELECT @TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
	
		SELECT @TotalUnitsLendable = ISNULL(SUM(UnitsLendable),0) FROM #FinalWorkingTbl

		IF (@blnValidCollSched = 0 AND @IsRevRepoLoan = 0)         --------Skip this check for Reverse Repo
		BEGIN
			SELECT 'Insufficient availability across the accounts (for the selected collateral schedule)' InfoMessage,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
		END
		ELSE IF (@blnValidSec = 0)
		BEGIN
			SELECT 'This Security cannot be loaned because CUSIP does not exist' InfoMessage,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
		END
		ELSE IF (@TotalUnitsLendable = 0)
		BEGIN

			/* getting poolid = 1 data because if this loop is executed that means we cannot book the requested quantity.*/
			
			-- Calculate PoolAvailability
			SELECT 
				@PoolAvailability = ISNULL(SUM(DISTINCT(PoolAvailability)),0)
			FROM 
				#WorkingTbl --#FinalWorkingTbl
			WHERE 
				PoolId = 1--@PoolId 

			-- Calculate MinOfAvailAndLLAndCLQty
			SELECT 
				@MinOfAvailAndLLAndCLQty = ISNULL(SUM(temp.MinOfAvailAndLLAndCLQty),0)
			FROM
			(
				SELECT DISTINCT LendingLimitGrpID, MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty
				FROM 
					#WorkingTbl --#FinalWorkingTbl
				WHERE 
					PoolId = 1--@PoolId 
				GROUP BY LendingLimitGrpID
			) temp	

--		SELECT @BrkCreditLimitRemUSD,@UsageLimitRemUSD,@PoolAvailability,@MinOfAvailAndLLAndCLQty

			-----Changes done in the below conditions such that If Reverse Repo Loan then only Broker Limit/Broker Conc Limit/Client Lending Limit/Client Conc Limit should be checked------
			-----Other checks should be skipped------
			IF (@IsRevRepoLoan = 0)
			BEGIN
				IF (@blnUnitsAvail = 1)
					IF (@FaceAmount > ISNULL(@PoolAvailability,0))			
						SELECT 'Insufficient availability across the accounts (for the selected collateral schedule)' InfoMessage,@TotalUnitsLendable TotalUnitsLendable 
					ELSE IF (@FaceAmount > @MinOfAvailAndLLAndCLQty)
						SELECT 'Insufficient availability because of ClientAccount Lending Limit or ClientAccount-Broker Concentration Limit'  InfoMessage, @TotalUnitsLendable TotalUnitsLendable
					ELSE
						SELECT 'Insufficient availability because of Broker Credit Limit OR Broker Usage Concentration Limit' InfoMessage,@TotalUnitsLendable TotalUnitsLendable 
				ELSE IF (@blnUnitsAvail = 0)
					SELECT 'Insufficient availability across all the accounts' InfoMessage,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
			END
			ELSE
			BEGIN
				IF (@FaceAmount > @RevRepoLendLimitRemUSD)
					SELECT 'Insufficient availability because of ClientAccount Lending Limit'  InfoMessage, @TotalUnitsLendable TotalUnitsLendable
				ELSE IF (@FaceAmount > @RevRepoBrkCreditLimitRemUSD)
					SELECT 'Insufficient availability because of Broker Credit Limit' InfoMessage,@TotalUnitsLendable TotalUnitsLendable 
			END
		END -- end of IF (@TotalUnitsLendable = 0)
		ELSE IF (@blnUnitsAvail = 0 AND @IsRevRepoLoan = 0)
			SELECT 'Insufficient availability across all the accounts' InfoMessage,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
		ELSE IF (@CanProcessLoanReq = 0 AND @IsRevRepoLoan = 0)
			SELECT 'Loan request cannot be booked' InfoMessage,@TotalUnitsLendable TotalUnitsLendable 

		-------Check Broker-Acct Restriction flag and Account-Collateral Schedule Restriction flag only in case of Reverse Repo Loans-------------
		IF (@IsRevRepoLoan = 1)
		BEGIN
			IF (@IsRevRepoBrkAcctRestricted = 1)
			BEGIN
				SELECT 'Broker - Account combination Restricted' InfoMessage
			END

			IF (@IsRevRepoAcctCollateralRestricted = 1)
			BEGIN
				SELECT 'Collateral Schedule - Account combination Restricted' InfoMessage 
			END
		END

		IF (@IsRevRepoLoan = 0)
		BEGIN
			SELECT TOP 1 @SecId = SecID FROM #FinalWorkingTbl

			INSERT INTO #TempSale (SecID,AcctNbr,Units,/*AsOfDate,*/RecordSource)
			SELECT DISTINCT SecID,AcctNbr,Units,/*AsOfDate,*/RecordSource 
			FROM [dbo].[f_GetSaleSecurityData] (@BatchDate,@SecId) 		

			IF EXISTS (SELECT SecID FROM #TempSale WHERE SecId = @SecID)
			BEGIN
				SELECT @AcctNbrList = STUFF((SELECT DISTINCT ',' + AcctNbr, +' (Qty:'+ Format(Units, '##,##0') +')' FROM #TempSale WHERE SecId = @SecID FOR XML PATH('')) ,1,1,'')

				SELECT 'Pending Sale activity for account(s) ' + @AcctNbrList + ' in last 3 days' InfoMessage,1 blnSaleExists
			END
		END
	--ELSE --Loan request can be fulfilled
	END -- end of IF (@SQL_IDENTIFIER = 'SINGLELOAN')
	
	ELSE IF (@SQL_IDENTIFIER = 'BULKLOAN')
	BEGIN
		
		UPDATE #FinalWorkingTbl 
		 SET 
			Is_DedicatedMarginCollateral_FISecurity = 1
		 FROM
			LAVA.dbo.DedicatedMarginCollateral TDMC
		INNER JOIN
			#FinalWorkingTbl TMPFINAL
		ON
			( TDMC.SecId = TMPFINAL.SecID ) AND
			( TDMC.AcctGrpID = TMPFINAL.AcctGrpID ) AND
			( @BatchDate BETWEEN TDMC.EffectiveDateBegin AND TDMC.EffectiveDateEnd ) AND
			( ISNULL(TDMC.IsDeleted,0) = 0 ) AND
			( TMPFINAL.UnitsLendable > 0 )
       	
		INSERT INTO #TempSecIDTbl (SecID,RowSeq,BucketSecType,SecCode,WLDepository,SumUnitsLendable,IsValidSec)
		SELECT DISTINCT SecID,0,BucketSecType,SecCode,WLDepository,ISNULL(SUM(UnitsLendable),0),1
		FROM #FinalWorkingTbl
		WHERE (ISNULL(UnitsLendable,0) > 0 )
		GROUP BY SecID,BucketSecType,SecCode,WLDepository
--		HAVING ISNULL(SUM(UnitsLendable),0) > 0

		SELECT @SecIDCnt = MIN(RowID) FROM #TempSecIDTbl WHERE IsValidSec = 1 AND IsProcessed = 0
		SELECT  @TotalSecIDCnt = MAX (RowID) FROM #TempSecIDTbl WHERE IsValidSec = 1 AND IsProcessed = 0

		WHILE (@SecIDCnt <= @TotalSecIDCnt)
		BEGIN
			SELECT 
				@SecID = SecID ,
				@TotalUnitsLendable = SumUnitsLendable,
				@WLDepository = WLDepository
			FROM 
				#TempSecIDTbl 
			WHERE 
				RowID = @SecIDCnt

			SELECT TOP 1
				@FaceAmount = FaceAmount,
				@blnUnitsAvail = blnUnitsAvail
			FROM 
				#FinalWorkingTbl 
			WHERE 
				SecID = @SecID AND
				WLDepository = @WLDepository

			INSERT INTO #TempSale (SecID,AcctNbr,Units,/*AsOfDate,*/RecordSource)
			SELECT DISTINCT SecID,AcctNbr,Units,/*AsOfDate,*/RecordSource 
			FROM [dbo].[f_GetSaleSecurityData] (@BatchDate,@SecId) 		

			IF (@TotalUnitsLendable = 0)
			BEGIN

				/* getting poolid = 1 data because if this loop is executed that means we cannot book the requested quantity.*/	
				-- Calculate PoolAvailability
				SELECT 
					@PoolAvailability = ISNULL(SUM(DISTINCT(PoolAvailability)),0)
				FROM 
					#FinalWorkingTbl
				WHERE 
					SecID = @SecID AND
					WLDepository = @WLDepository --PoolId = 1--@PoolId 

				-- Calculate MinOfAvailAndLLAndCLQty
				SELECT 
					@MinOfAvailAndLLAndCLQty = ISNULL(SUM(temp.MinOfAvailAndLLAndCLQty),0)
				FROM
				(
					SELECT DISTINCT LendingLimitGrpID, MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty
					FROM 
						#FinalWorkingTbl
					WHERE 
						SecID = @SecID AND
						WLDepository = @WLDepository --PoolId = 1--@PoolId 
					GROUP BY LendingLimitGrpID
				) temp

				IF (@blnUnitsAvail = 1)
				BEGIN
					IF (@FaceAmount > ISNULL(@PoolAvailability,0))
					BEGIN
						UPDATE #TempSecIDTbl
						SET ErrorMessage = 'Insufficient availability across the accounts (for the selected collateral schedule)',
						RowSeq = @ErrorRowSeq
						WHERE SecID = @SecID AND WLDepository = @WLDepository 
					END
					ELSE IF (@FaceAmount > @MinOfAvailAndLLAndCLQty)
					BEGIN
						UPDATE #TempSecIDTbl
						SET ErrorMessage = 'Insufficient availability because of ClientAccount Lending Limit or ClientAccount-Broker Concentration Limit',
						RowSeq = @ErrorRowSeq
						WHERE SecID = @SecID AND WLDepository = @WLDepository 
					END
					ELSE
					BEGIN
						UPDATE #TempSecIDTbl
						SET ErrorMessage = 'Insufficient availability because of Broker Credit Limit OR Broker Usage Concentration Limit',
						RowSeq = @ErrorRowSeq
						WHERE SecID = @SecID AND WLDepository = @WLDepository 
					END
				END
				ELSE IF (@blnUnitsAvail = 0)
				BEGIN
					UPDATE #TempSecIDTbl
					SET ErrorMessage = 'Insufficient availability across all the accounts',
					RowSeq = @ErrorRowSeq
					WHERE SecID = @SecID AND WLDepository = @WLDepository 
				END
			END -- end of IF (@TotalUnitsLendable = 0)
			ELSE IF (@blnUnitsAvail = 0)
			BEGIN
				UPDATE #TempSecIDTbl
				SET ErrorMessage = 'Insufficient availability across all the accounts',
				RowSeq = @ErrorRowSeq
				WHERE SecID = @SecID AND WLDepository = @WLDepository 
			END

			IF EXISTS (SELECT SecID FROM #TempSale WHERE SecId = @SecID)
			BEGIN
				SELECT @AcctNbrList = STUFF((SELECT DISTINCT ',' + AcctNbr, +' (Qty:'+ Format(Units, '##,##0') +')' FROM #TempSale WHERE SecId = @SecID FOR XML PATH('')) ,1,1,'')

				UPDATE #TempSecIDTbl
				SET ErrorMessage = 'Pending Sale activity for account(s) ' + @AcctNbrList + ' in last 3 days',
					RowSeq = 1
				WHERE SecID = @SecID AND WLDepository = @WLDepository 				
			END

			UPDATE #TempSecIDTbl
			SET IsProcessed = 1 
			WHERE SecID = @SecID AND WLDepository = @WLDepository 
	
--			SET @SecIDCnt = @SecIDCnt + 1
			SELECT @SecIDCnt = MIN(RowID) FROM #TempSecIDTbl WHERE IsValidSec = 1 AND IsProcessed = 0
		END	 --end of WHILE (@SecIDCnt <= @TotalSecIDCnt)

		-- Delete multiple depository security where depository is not used for allocation
		DELETE FROM #TempSecIDTbl WHERE SumUnitsLendable = 0 AND (ErrorMessage IS NULL OR ErrorMessage = '')

		SELECT DISTINCT 
			tempSec.SecID ,			
			tempsec.RowSeq,
			tempSec.SumUnitsLendable,
			tempSec.ErrorMessage,
            tempSec.BucketSecType,
            tempSec.SecCode,
            Work.Price,
            Work.FaceAmount,
            (Work.Price * tempSec.SumUnitsLendable)/100 Principal,
            0.00 RebateRate,
            '' ProductCategory,
			'' ProductCategoryLoanType,
			'' ProductCategoryLoanDuration,
            0.00 STTLevel,
			0.00 STTDivRate,
            tempSec.WLDepository,
            '' AsOfDate,
			'' SettlementDate,
            '' STTEndDate,
			'' ScripEndDate,
            '' TermDate,
            '' CollateralDate,
            '' GoodFundsDate,
            Work. SecLoc,
			'' SettInstr,			   
            '' ResetDate,
            '' GotoRepoRate,
            '' GotoTermDate,
            '' GotoRemarks,
            '' GotoProductCategory,
            '' GotoProductCategoryLoanType,
            '' GotoProductCategoryLoanDuration,
			'' Remarks,
			'' BasketNbr,
			'' LoanReqStatus,
			work.SMODE,
			ISNULL(work.IsPrePay,0) AS IsPrePay,
			TriPartyGrpID
		FROM 
			#TempSecIDTbl tempSec
		LEFT JOIN
			#FinalWorkingTbl Work
		ON
			work.SecID = tempSec.SecID AND
			work.WLDepository = tempSec.WLDepository

		SELECT *
		FROM 
			#FinalWorkingTbl 
		ORDER BY 
			SecID
		
	END  -- END of ELSE IF (@SQL_IDENTIFIER = 'BULKLOAN')

	DROP TABLE #ctrAvailability
	DROP TABLE #WorkingTbl
	DROP TABLE #ctrBrokerCreditLimit 
	DROP TABLE #ctrLendingLimit
	DROP TABLE #ctrConcentrationLimit
	DROP TABLE #ctrAccountPercentOnLoan 
	DROP TABLE #AcctNbrPriorityXML
	DROP TABLE #ctrUsageConcLimit
	DROP TABLE #AcctAvailability
	DROP TABLE #PoolTable
	DROP TABLE #PoolPriority
	DROP TABLE #TempAcctCleanUp 
	DROP TABLE #TempPoolPriority
	DROP TABLE #TempLoopsInPool
	DROP TABLE #AccountPercentOnLoan
	DROP TABLE #PendingTbl
	DROP TABLE #TempAccAvail
	DROP TABLE #FinalWorkingTbl
	DROP TABLE #TempSecIDTbl
	DROP TABLE #CtrAgentDirectLendingCreditLimit
	DROP TABLE #AcctNotAllowedToTrade
	DROP TABLE #TempCtrLendableCPTY
END



--p_GetData_BulkLoanConfigurationReports



CREATE PROCEDURE [dbo].[p_GetData_BulkLoanConfigurationReports]
(
	@Identifier		VARCHAR(100),
	@BulkNbr		INT,
	@VersionNbr		INT
)
AS  
BEGIN   

 SET QUOTED_IDENTIFIER OFF
 SET NOCOUNT ON  

	DECLARE  @ERROR_NO INT

	CREATE TABLE #TempSecurity
	(
		SecID 				INT, 
		CUSIP				VARCHAR(9),
		SEDOL				VARCHAR(7),
		ISIN				VARCHAR(12),
		SecCode				VARCHAR(12),
		DateEx				DATETIME,
		RecordDate			DATETIME,
		DivRate				DECIMAL(15,8),
		SecurityDesc1		VARCHAR(40),
		SecurityDesc2		VARCHAR(40),
		ISOCountry			VARCHAR(100),
		TickSymb			VARCHAR(12),
		CcyCode				VARCHAR(3),
		CountryName			VARCHAR(100),
		BucketSecType		VARCHAR(5)
	)

	CREATE TABLE #TempLoanBasketDetail
	(
		BulkNbr			INT,
		VersionNbr			INT,
		SecID				INT,
		BrokerLendable		BIGINT,
		PriceBaseCurrency	DECIMAL(14,7),
		FXRate				DECIMAL(19,8),
		Price				DECIMAL(14,7),
		DivYield			DECIMAL(13,6),
		DateEx				DATETIME,
		DateRecord			DATETIME,
		DivPaymentRate		DECIMAL(15,8),
		RebateRate			DECIMAL(9,6),
		FaceAmount			BIGINT,
		Principal			DECIMAL(17,2),
		ProductCategory		VARCHAR(3),
		SettlementDate		DATETIME,
		TermDate			DATETIME,
		STTLevel		DECIMAL(5,2),
		STTEndDate		DATETIME,
		STTDivRate		DECIMAL(13,6),
		StatusID			INT,
		ModifiedBy			VARCHAR(50),
		ModifiedDate		DATETIME,

		GotoRemarks varchar(20) NULL,
		LIBORRate decimal(20, 10) NULL,
		GotoRepoRate decimal(20, 7) NULL,
		GotoSTTLevel decimal(5, 2) NULL,
		GotoSTTDivRate decimal(13, 6) NULL,
		GotoProductCategoryLoanType varchar(20) NULL,
		GotoProductCategoryLoanDuration varchar(20) NULL,
		GotoScripEndDate datetime NULL,
		GotoSTTEndDate datetime NULL,
		GotoTermDate datetime NULL,
		ResetDate datetime NULL,
		GotoProductCategory varchar(3) NULL


	)

	INSERT INTO #TempLoanBasketDetail
	(
		BulkNbr,
		VersionNbr,
		SecID,
		BrokerLendable,
		PriceBaseCurrency,
		FXRate,
		Price,
		DivYield,
		DateEx,
		DateRecord,
		DivPaymentRate,
		RebateRate,
		FaceAmount,
		Principal,
		ProductCategory,
		SettlementDate,
		TermDate,
		STTLevel,
		STTEndDate,
		STTDivRate,
		StatusID,
		ModifiedBy,
		ModifiedDate,

		GotoRemarks,
		LIBORRate,
		GotoRepoRate,
		GotoSTTLevel,
		GotoSTTDivRate,
		GotoProductCategoryLoanType,
		GotoProductCategoryLoanDuration,
		GotoScripEndDate,
		GotoSTTEndDate,
		GotoTermDate,
		ResetDate,
		GotoProductCategory

	)
	SELECT 
		BulkNbr,
		VersionNbr,
		SecID,
		BrokerLendable,
		PriceBaseCurrency,
		FXRate,
		Price,
		DivYield,
		DateEx,
		DateRecord,
		DivPaymentRate,
		RebateRate,
		FaceAmount,
		Principal,
		ProductCategory,
		SettlementDate,
		TermDate,
		STTLevel,
		STTEndDate,
		STTDivRate,
		StatusID,
		ModifiedBy,
		ModifiedDate,

		GotoRemarks,
		LIBORRate,
		GotoRepoRate,
		GotoSTTLevel,
		GotoSTTDivRate,
		GotoProductCategoryLoanType,
		GotoProductCategoryLoanDuration,
		GotoScripEndDate,
		GotoSTTEndDate,
		GotoTermDate,
		ResetDate,
		GotoProductCategory

	FROM
		BulkLoanDetail
	WHERE
		BulkNbr = @BulkNbr AND
		VersionNbr = @VersionNbr

	INSERT INTO #TempSecurity
	(
		SecID, 
		CUSIP,
		SEDOL,
		ISIN,
		SecCode,
		DateEx,
		RecordDate,
		DivRate,
		SecurityDesc1,
		SecurityDesc2,
		ISOCountry,
		TickSymb,
		CcyCode,
		CountryName,
		BucketSecType
	)
	SELECT DISTINCT
		Sec.SecID,
		Sec.CUSIP,
		Sec.SEDOL,
		Sec.ISIN,
		Sec.SecCode,
		NULL DateEx,		
		LoanBasDtl.DateRecord,--CONVERT(VARCHAR(10),SecRecDate.MaxRecordDate,101),
		NULL DivRate,
		Sec.SecurityDesc1,
		Sec.SecurityDesc2,
		CASE Sec.SecCategoryID  WHEN 3005 THEN 'US' ELSE Sec.ISOCountry END ISOCountry,
		RTRIM(LEFT(Sec.TickSymb, 5)) AS TickSymb,
		Sec.CcyCode,
		CASE Sec.SecCategoryID  WHEN 3005 THEN 'United States' ELSE Sec.CountryName END CountryName,
		Sec.BucketSecurityType	
	FROM 
		REFERENCE.dbo.Security Sec	
	INNER JOIN
		#TempLoanBasketDetail LoanBasDtl
	ON
		LoanBasDtl.SecID = Sec.SecID 		

--SELECT * FROM #TempSecurity

	IF (@Identifier = 'GET_CPREPORT_DATA')
	BEGIN

		SELECT 
			Sec.CUSIP,
			Sec.SEDOL,
			Sec.ISIN,
			Sec.TickSymb,					
			Sec.DivRate,
			Sec.SecurityDesc1,
--			Sec.SecurityDesc2,
			Sec.ISOCountry,
			CONVERT(VARCHAR(10),LoanBasDtl.DateRecord,101) RecordDate,
--			Sec.BucketSecType,
			LoanBasDtl.FaceAmount,
			LoanBasDtl.Price,
			CASE Sec.BucketSecType 
				WHEN 'FI' THEN 	ROUND((LoanBasDtl.FaceAmount * LoanBasDtl.Price) /100,2)
				ELSE 	(LoanBasDtl.FaceAmount * LoanBasDtl.Price) 
			END as MktValue,
			LoanBasDtl.BrokerLendable,
			CASE Sec.BucketSecType 
				WHEN 'FI' THEN 	ROUND((LoanBasDtl.BrokerLendable * LoanBasDtl.Price) /100,2)
				ELSE 	(LoanBasDtl.BrokerLendable * LoanBasDtl.Price) 
			END as PotentialPrincipal,
			LoanBasDtl.DivYield
		FROM
			#TempSecurity Sec	
		INNER JOIN
			#TempLoanBasketDetail LoanBasDtl
		ON
			LoanBasDtl.SecID = Sec.SecID
		
		SELECT @ERROR_NO = @@ERROR  
	END
	ELSE IF (@Identifier = 'GET_INTREPORT_DATA')
	BEGIN
		SELECT 
			Sec.CUSIP,
			Sec.SEDOL,
			Sec.ISIN,
			Sec.TickSymb,					
			Sec.DivRate,
			Sec.SecurityDesc1,
--			Sec.SecurityDesc2,
			Sec.ISOCountry,
			CONVERT(VARCHAR(10),LoanBasDtl.DateRecord,101) RecordDate,
--			Sec.BucketSecType,
			LoanBasDtl.FaceAmount,
			LoanBasDtl.Price,
			CASE Sec.BucketSecType 
				WHEN 'FI' THEN 	ROUND((LoanBasDtl.FaceAmount * LoanBasDtl.Price) /100,2)
				ELSE 	(LoanBasDtl.FaceAmount * LoanBasDtl.Price) 
			END as MktValue,
			LoanBasDtl.BrokerLendable,
			CASE Sec.BucketSecType 
				WHEN 'FI' THEN 	ROUND((LoanBasDtl.BrokerLendable * LoanBasDtl.Price) /100,2)
				ELSE 	(LoanBasDtl.BrokerLendable * LoanBasDtl.Price) 
			END as PotentialPrincipal,
			LoanBasDtl.DivYield,
			CONVERT(VARCHAR(10),LoanBasDtl.TermDate,101) TermDate,
			CONVERT(VARCHAR(10),LoanBasDtl.SettlementDate,101) SettlementDate,
			CONVERT(VARCHAR(10),LoanBasDtl.STTEndDate,101) STTEndDate,
			LoanBasDtl.STTLevel STTLevel,
			LoanBasDtl.Price USDPx,
			LoanBasDtl.RebateRate FeeRate
		FROM
			#TempSecurity Sec	
		INNER JOIN
			#TempLoanBasketDetail LoanBasDtl
		ON
			LoanBasDtl.SecID = Sec.SecID

		SELECT @ERROR_NO = @@ERROR  
	END
	ELSE
	BEGIN
		RETURN 2
	END

	SET NOCOUNT OFF
	
	IF @ERROR_NO = 0
		RETURN 0
	ELSE  
		RETURN 1
END



--p_GetData_BulkLoan_GetCancelledLoan

CREATE PROCEDURE [dbo].[p_GetData_BulkLoan_GetCancelledLoan]
(	
	@SQL_IDENTIFIER			VARCHAR(25) = '',		
	@SQL_CONDITION1			XML
)
AS
BEGIN
	DECLARE @ERROR_NO INT, @BussDate DATETIME

	SELECt @BussDate = CurrentBatchDate FROM GLOBALONE.dbo.vw_G1_System

	IF (@SQL_CONDITION1 IS NOT NULL)
	BEGIN
		DECLARE @TxnRefNbrTable AS TABLE
		(
			TxnRefNbr VARCHAR(100)
		)

		INSERT INTO @TxnRefNbrTable
		(
			TxnRefNbr
		)
		SELECT 
			DISTINCT s.value('.', 'VARCHAR(100)') AS [TxnRefNbr]
		FROM   
			@SQL_CONDITION1.nodes('/SelectedLoanId/TxnRefNbr') AS t(s)
	 END
		
	SELECT DISTINCT 
		Sec.CUSIP
		,Sec.ISIN
		,Sec.TickSymb
		,Sec.SEDOL
		,'' DivYield
		,'' NextExDate
		,'' NextRecDate
		,'' DivRate
		,TradePrice AS price
		,RebateRate REBFEE
		,FaceAmount
		,ProductCategory
		,'' ProductCategoryLoanType
		,'' ProductCategoryLoanDuration
		,'' STTDivRate
		,'' DesiredSTTLevel
		,STTLevel AS STTLevel
		,SettlementDate
		,STTEndDate
		,'' ScripEndDate
		,TermDate
		,Comments Remarks
		,'' ResetDate
		,'' GotoRate
		,'' GotoTermDate
		,'' GotoRemarks
		,'' GotoProductCategory
		,'' GotoProductCategoryLoanType
		,'' GotoProductCategoryLoanDuration
		,AsOfDate = 
			CASE Depository 
				WHEN 'DTC' 
					THEN CONVERT (VARCHAR(12),@BussDate,101) 
				ELSE 
					(
						CASE TransmitFlg 
							WHEN 'Y' 
								THEN CONVERT (VARCHAR(12),AsOfDate,101) 
							ELSE 
								CONVERT (VARCHAR(12),@BussDate,101) 
						END
					) 
			END
	FROM 
		ETICancelLoan Dtl
	INNER JOIN
		REFERENCE.dbo.Security Sec
	ON
		(Sec.SecCode = Dtl.SecCode  OR
	 	Sec.Isin = Dtl.SecCode  OR
	 	Sec.Sedol = Dtl.SecCode  OR
	 	Sec.Cusip = Dtl.SecCode  OR
		RTRIM(LEFT(Sec.TickSymb, 5)) = Dtl.SecCode)
	WHERE 
		Dtl.TxnRefNbr IN (SELECT TxnRefNbr FROM @TxnRefNbrTable) 

	SET @ERROR_NO = @@ERROR	

	IF @ERROR_NO <> 0 
		RAISERROR ( 'Error raised in p_GetData_BulkLoan_GetCancelledLoan', 16, 1 )
END




