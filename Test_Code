                string FingerPrint = appConfig.AppSettings.Settings["FingerPrint"].Value;
                string PrivateKeyPath = appConfig.AppSettings.Settings["PrivateKeyPath"].Value;

                SessionOptions sessionOptions = new SessionOptions
                {
                    Protocol = Protocol.Sftp,
                    HostName = HostName,
                    UserName = UserName,
                    Password = PassWord,
                    SshHostKeyFingerprint = FingerPrint,
                    SshPrivateKeyPath = PrivateKeyPath
                };

                using (Session winSCPSession = new Session())
                {
                    TransferOptions transferOptions = new TransferOptions();
                    transferOptions.TransferMode = TransferMode.Binary;

                    winSCPSession.Open(sessionOptions);
