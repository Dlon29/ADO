							WHERE 
								SecId = @SecID AND
								PoolID = @ReqPoolCount AND
								IsIndemnified = @IsIndemnified AND
								(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)			-- Consider only ADL Non Indemnified accounts
								

		--select 'bfr update', @TotalQuantityLendedInLoop,* from #ctrBrokerCreditLimit
							/** Update temp Broker Credit Limit control table **/
							IF (@IsIndemnified = 1) -- Ind
							BEGIN
								IF (@FinderNbr = '000LDN') -- London sec
								BEGIN 
									UPDATE 
										#ctrBrokerCreditLimit
									SET 
										CrLimitLndSecLendIndemnifiedRem = CrLimitLndSecLendIndemnifiedRem - (ISNULL(@TotalQuantityLendedInLoop,0) * @Price)
									FROM 
										#ctrBrokerCreditLimit
									WHERE
										BrkCrGrpID = @BrkCrGrpID 
								END
								ELSE -- US Sec
								BEGIN
									UPDATE 
										#ctrBrokerCreditLimit
									SET 
										CrLimitUSSecLendIndemnifiedRem = CrLimitUSSecLendIndemnifiedRem - (ISNULL(@TotalQuantityLendedInLoop,0) * @Price)
									FROM 
										#ctrBrokerCreditLimit BCL
									WHERE
										BrkCrGrpID = @BrkCrGrpID
								END
							END
							ELSE IF (@IsIndemnified = 0)  -- Non ind for Non ADL Accounts
							BEGIN
								IF (@FinderNbr = '000LDN') -- London sec
								BEGIN
									UPDATE 
										#ctrBrokerCreditLimit
									SET 
										CrLimitLndSecLendNonIndemnifiedRem = CrLimitLndSecLendNonIndemnifiedRem - (ISNULL(@TotalQuantityLendedInLoop,0) * @Price) 
									FROM 
										#ctrBrokerCreditLimit
									WHERE
										BrkCrGrpID = @BrkCrGrpID
								END
								ELSE -- US Sec
								BEGIN
									UPDATE 
										#ctrBrokerCreditLimit
									SET
										CrLimitUSSecLendNonIndemnifiedRem = CrLimitUSSecLendNonIndemnifiedRem - (ISNULL(@TotalQuantityLendedInLoop,0) * @Price) 
									FROM 
										#ctrBrokerCreditLimit 
									WHERE
										BrkCrGrpID = @BrkCrGrpID

								END
							END -- end of IF (@IsIndemnified = 1)
							ELSE /** Below limit is calculated for ADL Accounts where @IsIndemnified will be differnt from 0 and 1, and  unique for each AccountGroupId **/
							BEGIN
									UPDATE 
										#CtrAgentDirectLendingCreditLimit
									SET
										crLimitADL = crLimitADL - (ISNULL(@TotalQuantityLendedInLoop,0) * @Price) 
									FROM 
										#CtrAgentDirectLendingCreditLimit 
									WHERE
										BrkCrGrpID = @BrkCrGrpID AND
										AcctGrpId = @AcctGrpID
							END
		--select 'afr update', * from #ctrBrokerCreditLimit

							/** Update temp Usage Conc Limit control table **/
							IF (@IsIndemnified = 1) -- Ind
							BEGIN
								UPDATE 
									#ctrUsageConcLimit
								SET 
									LoanUsageIndemnifiedRemUSD = LoanUsageIndemnifiedRemUSD - (ISNULL(@TotalQuantityLendedInLoop,0) * @Price)
								WHERE
									BrkCrGrpID = @BrkCrGrpID
							END
							ELSE --non ind
							BEGIN	
								UPDATE 
									#ctrUsageConcLimit
								SET 
									LoanUsageNonIndemnifiedRemUSD = LoanUsageNonIndemnifiedRemUSD - (ISNULL(@TotalQuantityLendedInLoop,0) * @Price)
								WHERE
									BrkCrGrpID = @BrkCrGrpID
							END
						
							/** Update temp Account Lending Limit control table : Decrease limit **/
							UPDATE 
								#ctrLendingLimit
							SET 
								LendGrpLimitRemUSD = LendGrpLimitRemUSD - (ISNULL(work.UnitsLendable,0) * @Price) 
							FROM 
								#ctrLendingLimit LL
							INNER JOIN
							(
								SELECT 
									SecID,PoolID, IsIndemnified, LendingLimitGrpID, SUM(UnitsLendable) UnitsLendable
								FROM 
									#FinalWorkingTbl 
								WHERE
									--((ISNULL(IsAgentDirectLending,0) = 0) OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) 			-- Consider Only NON-ADL AND ADL-Indemnified Accounts 
									((ISNULL(IsAgentDirectLending,0) = 0)) -- Consider Lending Limits only for Non-ADL Accts
								GROUP BY 
									SecID,PoolID, IsIndemnified, LendingLimitGrpID
								HAVING 						
									SecId = @SecID AND	
									PoolID = @ReqPoolCount AND
									IsIndemnified = @IsIndemnified 
							) work
							ON 
								LL.AcctLendGrpID = work.LendingLimitGrpID
								

							/** Update temp Conc Limit control table : Decrease limit **/
							UPDATE 
								#ctrConcentrationLimit
							SET 
								ConcLimitRemUSD = (ConcLimitRemUSD - (ISNULL(work.UnitsLendable,0) * @Price)) 
							FROM 
								#ctrConcentrationLimit CL
							INNER JOIN
							(
								SELECT 
									SecID,PoolID, IsIndemnified, LendingLimitGrpID, BrkCrGrpID, SUM(UnitsLendable) UnitsLendable
								FROM 
									#FinalWorkingTbl 
								WHERE
									--((ISNULL(IsAgentDirectLending,0) = 0) OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) 			-- Consider Only NON-ADL AND ADL-Indemnified Accounts 
									((ISNULL(IsAgentDirectLending,0) = 0)) -- Consider Concentration Lending Limits only for Non-ADL Accts
								GROUP BY 
									SecID,PoolID, IsIndemnified, LendingLimitGrpID, BrkCrGrpID
								HAVING 	
									SecId = @SecID AND						
									PoolID = @ReqPoolCount AND
									IsIndemnified = @IsIndemnified  
							) work
							ON 
								CL.AcctLendGrpID = work.LendingLimitGrpID AND
								CL.BrkCrGrpID = work.BrkCrGrpID

							/** Update temp Account Percent on Loan table : Increase Market Value of Loan and Percent on Loan **/
							UPDATE 
								#ctrAccountPercentOnLoan 
							SET 
								MktValueLoanUSD = work.MktValueLoanUSD, 
								PercentOnLoan = work.PercentOnLoan
							FROM 
								#ctrAccountPercentOnLoan POL
							INNER JOIN
								#FinalWorkingTbl work
							ON 
								work.AcctNbr = POL.AcctNbr AND
								work.PoolID = @ReqPoolCount AND
								work.IsIndemnified = @IsIndemnified AND
								work.ISOCOuntry = POL.ISOCOuntry AND
								work.SecId = @SecID
		--select 'bfr update',* from #ctrAvailability

							/** Update availablitiy within account : Decrease total units ledable remaining **/
							UPDATE 
								#ctrAvailability
							SET 
								UnitsLendableRem =	CASE 
														WHEN (ctrAva.UnitsLendableRem - ISNULL(work.UnitsLendable,0)) > 0 
															THEN (ctrAva.UnitsLendableRem - ISNULL(work.UnitsLendable,0))  
															ELSE 0 
													END
							FROM 
								#ctrAvailability ctrAva
							INNER JOIN
								#FinalWorkingTbl work
							ON
								work.AcctNbr = ctrAva.AcctNbr AND
								work.SecID = ctrAva.SecID AND
								work.IsIndemnified = @IsIndemnified AND
								work.WLDepository = ctrAva.WLDepository AND
								work.SecId = @SecID


							SET @LoopCount = @LoopCount + 1
						END -- end of WHILE (@LoopCount <= @TotalNoOfLoops)

						SELECT @ReqPoolCount = MIN(PoolID) FROM #FinalWorkingTbl WHERE PoolID > @ReqPoolCount AND SecId = @SecID
					END --end of WHILE (@ReqPoolCount <= @ReqPoolTotal)

				END -- end of IF (@SQL_IDENTIFIER = 'BULKLOAN' AND @CanProcessLoanReq = 1)
			END -- end of IF (@blnValidSec = 1)
			ELSE
			BEGIN

				INSERT INTO #TempSecIDTbl (SecID,RowSeq,BucketSecType,SecCode,WLDepository,SumUnitsLendable,ErrorMessage,IsValidSec,IsProcessed)
				SELECT DISTINCT @SecID,@ErrorRowSeq,@BucketSecType,@SecCode,'',0,'This Security cannot be loaned because CUSIP does not exist',0,1
				
			END
		END -- end of IF (@blnValidCollSched = 1)
		ELSE
		BEGIN

			INSERT INTO #TempSecIDTbl (SecID,RowSeq,BucketSecType,SecCode,WLDepository,SumUnitsLendable,ErrorMessage,IsValidSec,IsProcessed)
			SELECT DISTINCT @SecID,@ErrorRowSeq,@BucketSecType,@SecCode,'',0,'Insufficient availability across the accounts (for the selected collateral schedule)',0,1
			
		END

		SET @SecCount = @SecCount + 1
	END	-- end of WHILE (@SecCount <= @TotalSecCount)

	IF (@SQL_IDENTIFIER = 'SINGLELOAN')
	BEGIN

		--Single Loan Allocation - Display all CBJ Agent account filtered out for Acct availability not allowed to trade for Allocation grid display.
		INSERT INTO #FinalWorkingTbl
		(
			PoolId,
			AcctPriority,
			LendingLimitGrpID,
			AcctId,
			AcctNbr,
			AcctSN,
			BrkNbr,
			BrkID,
			FaceAmount,
			AcctAvailibityRem,
			AcctAvailibityRestricted,
			LoopAvailability,
			PoolAvailability,
			BrkCrGrpID,
			BrkCreditLimitUSD,
			UsageCreditLimitUSD,
			MinAvailAndBCLAndUCLQty,
			LendingLimitUSD,
			ConcLimitUSD,
			MinLendLimAndConcLimUSD,
			MinOfAvailAndLLAndCLQty,
			MinOfAllLimitLoopQty,
			MinOfAllLimitPoolQty,
			UnitsLendable,
			UnUsedUnits,
			IsAcctUsed,
			SecID,
			BucketSecType,
			SecCode,
			WLDepository,
			ISOCountry,
			IsIndemnified,
			Price,
			MktValuePositionUSD,
			MktValueLoanUSD,
			PercentOnLoan,
			CanUseAcctForCleanUp,
			IsPoolUpdated,
			DivRate,
			blnUnitsAvail,
			SecLoc,
			SMODE,
			IsAgentDirectLending,
			AcctGrpID,
			IsPrePay,
			TriPartyGrpID
		)		
		SELECT 
			1 PoolId,
			1 AcctPriority,
			LendingLimitGrpID,
			AcctId,
			AcctNbr,
			AcctSN,
			@BrkNbr,
			@BrkID,
			@FaceAmount FaceAmount,
			UnitsLendableRem,
			UnitsLendableRestrictedRem,
			NULL LoopAvailability,
			NULL PoolAvailability,
			@BrkCrGrpID,
			NULL BrkCreditLimitUSD,
			NULL UsageCreditLimitUSD,
			NULL MinAvailAndBCLAndUCLQty,
			NULL LendingLimitUSD,
			NULL ConcLimitUSD,
			NULL MinLendLimAndConcLimUSD,
			NULL MinOfAvailAndLLAndCLQty,
			NULL MinOfAllLimitLoopQty,
			NULL MinOfAllLimitPoolQty,
			0 UnitsLendable,
			0 UnUsedUnits,
			0 IsAcctUsed,
			SecID,
			@BucketSecType,
			@SecCode,
			WLDepository,
			ISOCountry,
			IsIndemnified,
			@Price Price,
			NULL MktValuePositionUSD,
			NULL MktValueLoanUSD,
			NULL PercentOnLoan,
			NULL CanUseAcctForCleanUp,
			NULL IsPoolUpdated,
			ISNULL(DivRate,100.00),
			CASE WHEN @FaceAmount > @TotalIndNonIndUnitsRestrictedRem THEN 0 ELSE 1 END,
			NULL SecLoc,
			NULL SMODE,
			IsAgentDirectLending,
			AcctGrpID,
			NULL IsPrePay,
			TriPartyGrpID
		FROM 
			#AcctNotAllowedToTrade 
		WHERE
			AcctNbr NOT IN ( SELECT AcctNbr FROM #FinalWorkingTbl )	

		-- Adding "NetLendableCPTY" on the grid to show it is allowed to trade or not only in case of single loan booking
		SELECT 
			FWT.*, 
			CASE WHEN FWT.AcctGrpID IN (SELECT CAST(PARAMETER AS smallint) As AcctGrpID FROM LAVA.DBO.f_ParseParameters(@ActiveTradingCBJAcctGrpID)) THEN			
				CASE WHEN NetLendableCPTY= 'ATT' THEN 'Allowed to Trade' ELSE 'Not Allowed to Trade' END 
			ELSE '' END AS NetLendableCPTY
		FROM 
			#FinalWorkingTbl FWT
		LEFT JOIN #TempCtrLendableCPTY TCLCP
		ON
			FWT.AcctNbr= TCLCP.AcctNbr AND
			FWT.BrkCrGrpID = TCLCP.BrkCrGrpID 
		ORDER BY 
			UnitsLendable Desc,PoolId,AcctPriority	
		
		--SELECT * FROM #FinalWorkingTbl ORDER BY UnitsLendable Desc,PoolId,AcctPriority

		SELECT 0 IsLoanBreak

		SET @WLDepository = ''

		SELECT DISTINCT @WLDepository = WLDepository 
		FROM #FinalWorkingTbl 
		WHERE (ISNULL(UnitsLendable,0) > 0 )
		
		SELECT DISTINCT @WLDepoCode = CM_INTERFACE_TYPE FROM GLOBALONE.dbo.DEPOT where CM_ACCT_NO LIKE '%'+@WLDepository+'%'

		IF (@SmType = 'B')
		BEGIN
			SET @WLDepoCode = @WLDepoCode + 'D' 
		END
		ELSE 
		BEGIN
			SET @WLDepoCode = @WLDepoCode + 'X' 
		END

		SELECT @WLDepoCode DepoCode,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail

		SELECT @TotalUnitsLendable = ISNULL(SUM(UnitsLendable),0) FROM #FinalWorkingTbl

		IF (@bIsValidActiveTradingSec = 0 )
		BEGIN
			SELECT 'Security is blocked for Active Trading account since no shares is available for any CBJ Indemnified accounts (for G1 SecCode: ' + @SecCode + ' )' InfoMessage,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalInd
NonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
		END
		ELSE IF (@blnValidCollSched = 0)
		BEGIN
			SELECT 'Insufficient availability across the accounts (for the selected collateral schedule)' InfoMessage, @TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
		END
		ELSE IF (@blnValidSec = 0)
		BEGIN
			SELECT 'This Security cannot be loaned because CUSIP does not exist' InfoMessage,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
		END
		ELSE IF (@TotalUnitsLendable = 0)
		BEGIN

			/* getting poolid = 1 data because if this loop is executed that means we cannot book the requested quantity.*/	
			-- Calculate PoolAvailability
			SELECT 
				@PoolAvailability = ISNULL(SUM(DISTINCT(PoolAvailability)),0)
			FROM 
				#FinalWorkingTbl
			WHERE 
				PoolId = 1--@PoolId 

			-- Calculate MinOfAvailAndLLAndCLQty
			SELECT 
				@MinOfAvailAndLLAndCLQty = ISNULL(SUM(temp.MinOfAvailAndLLAndCLQty),0)
			FROM
			(
				SELECT DISTINCT LendingLimitGrpID, MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty
				FROM 
					#FinalWorkingTbl
				WHERE 
					PoolId = 1--@PoolId 
				GROUP BY LendingLimitGrpID
			) temp

			IF (@blnUnitsAvail = 1)
				IF (@FaceAmount > ISNULL(@PoolAvailability,0))
					SELECT 'Insufficient availability across the accounts (for the selected collateral schedule)' InfoMessage,@TotalUnitsLendable TotalUnitsLendable 
				ELSE IF (@FaceAmount > @MinOfAvailAndLLAndCLQty)
					SELECT 'Insufficient availability because of ClientAccount Lending Limit or ClientAccount-Broker Concentration Limit'  InfoMessage, @TotalUnitsLendable TotalUnitsLendable
				ELSE
					SELECT 'Insufficient availability because of Broker Credit Limit OR Broker Usage Concentration Limit' InfoMessage,@TotalUnitsLendable TotalUnitsLendable 
			ELSE IF (@blnUnitsAvail = 0)
				SELECT 'Insufficient availability across all the accounts' InfoMessage,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail			
		END -- end of IF (@TotalUnitsLendable = 0)
		ELSE IF (@blnUnitsAvail = 0)
			SELECT 'Insufficient availability across all the accounts' InfoMessage,@TotalIndNonIndUnitsRem TotalUnitsLendable, @TotalIndNonIndUnitsRestrictedRem TotalIndNonIndUnitsRestrictedRem, @blnUnitsAvail IsUnitsAvail
		ELSE IF (@CanProcessLoanReq = 0)
			SELECT 'Loan request cannot be booked' InfoMessage,@TotalUnitsLendable TotalUnitsLendable 
		--ELSE --Loan request can be fulfilled

		SELECT TOP 1 @SecId = SecID FROM #FinalWorkingTbl

		INSERT INTO #TempSale (SecID,AcctNbr,Units,/*AsOfDate,*/RecordSource)
		SELECT DISTINCT SecID,AcctNbr,Units,/*AsOfDate,*/RecordSource 
		FROM [dbo].[f_GetSaleSecurityData] (@BatchDate,@SecId) 		

		IF EXISTS (SELECT SecID FROM #TempSale WHERE SecId = @SecID)
		BEGIN
			SELECT @AcctNbrList = STUFF((SELECT DISTINCT ',' + AcctNbr, +' (Qty:'+ Format(Units, '##,##0') +')' FROM #TempSale WHERE SecId = @SecID FOR XML PATH('')) ,1,1,'')

			SELECT 'Pending Sale activity for account(s) ' + @AcctNbrList + ' in last 3 days' InfoMessage,1 blnSaleExists
		END

	END -- end of IF (@SQL_IDENTIFIER = 'SINGLELOAN')
	ELSE IF (@SQL_IDENTIFIER = 'BULKLOAN')
	BEGIN 

		INSERT INTO #TempSecIDTbl (SecID,RowSeq,BucketSecType,SecCode,WLDepository,SumUnitsLendable,IsValidSec)
		SELECT DISTINCT SecID,0, BucketSecType, SecCode, WLDepository, ISNULL(SUM(UnitsLendable),0),1
		FROM #FinalWorkingTbl	
		WHERE (ISNULL(UnitsLendable,0) > 0 )
		GROUP BY SecID,BucketSecType,SecCode,WLDepository
--		HAVING ISNULL(SUM(UnitsLendable),0) > 0

		SELECT @SecIDCnt = MIN(RowID) FROM #TempSecIDTbl WHERE IsValidSec = 1 AND IsProcessed = 0
		SELECT  @TotalSecIDCnt = MAX (RowID) FROM #TempSecIDTbl WHERE IsValidSec = 1 AND IsProcessed = 0


		WHILE (@SecIDCnt <= @TotalSecIDCnt)
		BEGIN

			SELECT 
				@SecID = SecID ,
				@TotalUnitsLendable = SumUnitsLendable,
				@WLDepository = WLDepository
			FROM 
				#TempSecIDTbl 
			WHERE 
				RowID = @SecIDCnt

			SELECT TOP 1
				@FaceAmount = FaceAmount,
				@blnUnitsAvail = blnUnitsAvail
			FROM 
				#FinalWorkingTbl 
			WHERE 
				SecID = @SecID AND
				WLDepository = @WLDepository

			INSERT INTO #TempSale (SecID,AcctNbr,Units,/*AsOfDate,*/RecordSource)
			SELECT DISTINCT SecID,AcctNbr,Units,/*AsOfDate,*/RecordSource 
			FROM [dbo].[f_GetSaleSecurityData] (@BatchDate,@SecId) 		

			IF (@TotalUnitsLendable = 0)
			BEGIN

				/* getting poolid = 1 data because if this loop is executed that means we cannot book the requested quantity.*/	
				-- Calculate PoolAvailability
				SELECT 
					@PoolAvailability = ISNULL(SUM(DISTINCT(PoolAvailability)),0)
				FROM 
					#FinalWorkingTbl
				WHERE 
					SecID = @SecID AND
					WLDepository = @WLDepository --PoolId = 1--@PoolId 

				-- Calculate MinOfAvailAndLLAndCLQty
				SELECT 
					@MinOfAvailAndLLAndCLQty = ISNULL(SUM(temp.MinOfAvailAndLLAndCLQty),0)
				FROM
				(
					SELECT DISTINCT LendingLimitGrpID, MIN(MinOfAvailAndLLAndCLQty) MinOfAvailAndLLAndCLQty
					FROM 
						#FinalWorkingTbl
					WHERE 
						SecID = @SecID AND
						WLDepository = @WLDepository --PoolId = 1--@PoolId 
					GROUP BY LendingLimitGrpID
				) temp

				IF (@blnUnitsAvail = 1)
				BEGIN
					IF (@FaceAmount > ISNULL(@PoolAvailability,0))
					BEGIN
						UPDATE #TempSecIDTbl
						SET ErrorMessage = 'Insufficient availability across the accounts (for the selected collateral schedule)',
							RowSeq = @ErrorRowSeq
						WHERE SecID = @SecID AND WLDepository = @WLDepository 
					END
					ELSE IF (@FaceAmount > @MinOfAvailAndLLAndCLQty)
					BEGIN
						UPDATE #TempSecIDTbl
						SET ErrorMessage = 'Insufficient availability because of ClientAccount Lending Limit or ClientAccount-Broker Concentration Limit',
						RowSeq = @ErrorRowSeq
						WHERE SecID = @SecID AND WLDepository = @WLDepository 
					END
					ELSE
					BEGIN
						UPDATE #TempSecIDTbl
						SET ErrorMessage = 'Insufficient availability because of Broker Credit Limit OR Broker Usage Concentration Limit',
						RowSeq = @ErrorRowSeq
						WHERE SecID = @SecID AND WLDepository = @WLDepository 
					END
				END
				ELSE IF (@blnUnitsAvail = 0)
				BEGIN
					UPDATE #TempSecIDTbl
					SET ErrorMessage = 'Insufficient availability across all the accounts',
					RowSeq = @ErrorRowSeq
					WHERE SecID = @SecID AND WLDepository = @WLDepository 
				END
			END -- end of IF (@TotalUnitsLendable = 0)
			ELSE IF (@blnUnitsAvail = 0)
			BEGIN
				UPDATE #TempSecIDTbl
				SET ErrorMessage = 'Insufficient availability across all the accounts',
				RowSeq = @ErrorRowSeq
				WHERE SecID = @SecID AND WLDepository = @WLDepository 
			END

			IF EXISTS (SELECT SecID FROM #TempSale WHERE SecId = @SecID)
			BEGIN
				SELECT @AcctNbrList = STUFF((SELECT DISTINCT ',' + AcctNbr, +' (Qty:'+ Format(Units, '##,##0') +')' FROM #TempSale WHERE SecId = @SecID FOR XML PATH('')) ,1,1,'')

				UPDATE #TempSecIDTbl
				SET ErrorMessage = 'Pending Sale activity for account(s) ' + @AcctNbrList + ' in last 3 days',
					RowSeq = 1
				WHERE SecID = @SecID AND WLDepository = @WLDepository 
				--SELECT 'There is Sale exists for the selected security.' InfoMessage,1 blnSaleExists
			END

			UPDATE #TempSecIDTbl
			SET IsProcessed = 1 
			WHERE SecID = @SecID AND WLDepository = @WLDepository 
	
--			SET @SecIDCnt = @SecIDCnt + 1
			SELECT @SecIDCnt = MIN(RowID) FROM #TempSecIDTbl WHERE IsValidSec = 1 AND IsProcessed = 0
		END	 --end of WHILE (@SecIDCnt <= @TotalSecIDCnt)

		-- Delete multiple depository security where depository is not used for allocation
		DELETE FROM #TempSecIDTbl WHERE SumUnitsLendable = 0 AND (ErrorMessage IS NULL OR ErrorMessage = '')
		
		SELECT DISTINCT 
			tempSec.SecID,	
			tempsec.RowSeq,
			tempSec.SumUnitsLendable,
			tempSec.ErrorMessage,
            tempSec.BucketSecType,
            tempSec.SecCode,
            Work.Price,
            Work.FaceAmount,
            (Work.Price * tempSec.SumUnitsLendable) Principal,
            0.00 RebateRate,
            '' ProductCategory,
			'' ProductCategoryLoanType,
			'' ProductCategoryLoanDuration,
            0.00 STTLevel,
			0.00 STTDivRate,
            tempSec.WLDepository,
            '' AsOfDate,
			'' SettlementDate,
            '' STTEndDate,
			'' ScripEndDate,
            '' TermDate,
            '' CollateralDate,
            '' GoodFundsDate,
            Work. SecLoc,
			'' SettInstr,
            '' ResetDate,
            0.00 GotoRepoRate,
            '' GotoTermDate,
            '' GotoRemarks,
            '' GotoProductCategory,
            '' GotoProductCategoryLoanType,
            '' GotoProductCategoryLoanDuration,
			'' Remarks,
			'' BasketNbr,
			'' LoanReqStatus,
			work.SMODE,
			Work.IsPrePay,
			work.TriPartyGrpID
			
		FROM 
			#TempSecIDTbl tempSec
		LEFT JOIN
			#FinalWorkingTbl Work
		ON
			work.SecID = tempSec.SecID AND
			work.WLDepository = tempSec.WLDepository
		ORDER BY 
			tempSec.ErrorMessage

		SELECT *
		FROM 
			#FinalWorkingTbl 
		ORDER BY 
			SecID
		
	END			

