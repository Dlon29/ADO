                                Int64 SharesToRecall = 0;
                                Int64 NSTotalQtyRecalled = Convert.ToInt64(lblNSLoanQtyAllocatedTOAcct.Text.Replace(",", "")) - (Convert.ToInt64(lblNSSaleQtyRecalled.Text.Replace(",", "")) + Convert.ToInt64(lblNSNonSaleQtyRecalled.Text.Replace(",", "")));

