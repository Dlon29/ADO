        private bool fncGetUserInfo()
        {
            // record username\computername
            try
            {
                _NTUserName = HttpContext.Current.Request.ServerVariables["LOGON_USER"];
                _ComputerName = HttpContext.Current.Request.ServerVariables["REMOTE_HOST"];
                _DomainName = _NTUserName.Substring(0, _NTUserName.IndexOf(@"\"));

                if (_DomainName == "")
                {
                    _DomainName = System.Environment.MachineName;

                }
                _NTUserName = _NTUserName.Substring(_NTUserName.IndexOf(@"\") + 1);

                if (_ADGroupName.Equals(""))
                {
                    _ADGroupName = ConfigurationManager.AppSettings["AppUsersGroupName"];
                }


                if (ConfigurationManager.AppSettings["AppUsersDefaultRole"] != null)
                {
                    _ApplicationRole = ConfigurationManager.AppSettings["AppUsersDefaultRole"].Replace(" ", "").ToLower().Trim();
                }


                //Edwin Stephenraj, 07/31/2006
                try
                {
                    //Session will be available only after any page_load event.
                    HttpContext.Current.Session["UserName"] = _NTUserName;
                    HttpContext.Current.Session["ComputerName"] = _ComputerName;
                }
                catch (Exception)
                {
                    //ok to ignore: Need more research on this.
                }
            }
            catch (Exception)
            {
                return false;
            }

            return true;
        }

