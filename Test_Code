                    Int64 QtyPendingToRecall = 0;
                    Int64 TotalQtyRecalled = 0;

                    if (dgLoanRecall != null && blnResult == true)
                    {
                        // this will loop thru all records of a data table
                        for (int iRowCount = 0; iRowCount < dgLoanRecall.Items.Count; iRowCount++)
                        {
                            dgi = this.dgLoanRecall.Items[iRowCount];

