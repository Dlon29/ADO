// The consumer just drops each delivery into a thread-safe queue,
// so the rest of the loop keeps working like the old Dequeue-with-timeout.
var deliveries = new BlockingCollection<Tuple<ulong, byte[]>>();
var consumer = new EventingBasicConsumer(ch);
consumer.Received += (s, ea) =>
{
    // MUST copy the body here: in 6.x the memory behind ea.Body is reused
    // by the library once this handler returns.
    deliveries.Add(Tuple.Create(ea.DeliveryTag, ea.Body.ToArray()));
};

log.Info(" Waiting to Consume MQ Message");
ch.BasicConsume(appConfig.AppSettings.Settings["QueueName"].Value, false, consumer);
ch.BasicQos(0, 1, false);

while (conn.IsOpen)
{
    try
    {
        Tuple<ulong, byte[]> delivery;
        isConsuming = deliveries.TryTake(out delivery,
            Convert.ToInt32(appConfig.AppSettings.Settings["MQBusTimeoutMilliseconds"].Value));

        if (isConsuming)
        {
            byte[] body = delivery.Item2;
            if (body != null)
            {
                log.Info(" Start processing MQ notification");
                ProcessMQMessage(System.Text.Encoding.UTF8.GetString(body));
                log.Info(" End processing MQ notification");
            }
            ch.BasicAck(delivery.Item1, false);
            log.Info(" confirming receive of the mq message");
        }
        else
        {
            if (ch != null && ch.IsOpen) ch.Close(200, "Goodbye");
            if (conn != null && conn.IsOpen) conn.Close();
            break;
        }
        iRetries = iMaxRetries;
    }
