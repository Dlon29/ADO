public RabbitMQSettings InitializeRabbitMQSettings(string sectionName,string queueName)
{
    var rabbitMQAdminService =RabbitMQAdmin.Client.ServiceProxyFactory.Instance.CreateRabbitMQAdminServiceProxy();
    List<RabbitMQSettings> rabbitMQSettingsList = rabbitMQAdminService.GetAndInitializeRabbitMQSettingsListBySection(sectionName);

    Dictionary<string, RabbitMQSettings> rabbitMQSettingsDict = rabbitMQSettingsList.ToDictionary(settings => settings.BindingID);
    return rabbitMQSettingsDict[queueName];
}

