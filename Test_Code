        /// <summary>
        /// This function is used to get the Dynamic gorupd sections based on the "DynamicSectionsGroupKey". Used for dynamic grouped sections.
        /// </summary>
        /// <param name="configKeys">key colletion to get the specific key value</param>
        /// <param name="sheet">current sheet</param>
        /// <param name="dynamicSection">list of all dynamic sections for current sheet</param>
        /// <returns></returns>
        public static List<string> GetDynamicGroupSectionsByKey(Dictionary<string, string> configKeys, string sheet, List<string> dynamicSection)
        {
            try
            {
                List<string> dynamicGrpSections = null;
                List<string> grpSections = new List<string>();
                if (string.IsNullOrWhiteSpace(configKeys["DynamicSectionsGroupKey"]) == false)
                {
                    if (dynamicSection.Count > 2)
                    {
                        var secGroups = configKeys["DynamicSectionsGroupKey"];
                        var secGroupsBySheets = secGroups.Split(',');
                        var currentSecGroup = Array.Find(secGroupsBySheets, element => element.StartsWith(sheet));
                        if (string.IsNullOrWhiteSpace(currentSecGroup) == false)
                        {
                            string regex = @"[\[\(\{](.*?)[\]\)\}]";
                            var grpValue = Regex.Matches(currentSecGroup, regex).GetEnumerator();
                            grpValue.MoveNext();
                            grpSections = ((Match)grpValue.Current).Groups[1].Value.Split('+').ToList();
                            dynamicGrpSections = dynamicSection.Where(o => grpSections.Any(s => o.Contains("Section" + s))).ToList();
                        }
                    }
                    else
                    {
                        dynamicGrpSections = dynamicSection;
                    }
                }

                return dynamicGrpSections;
            }
            catch (Exception)
            {

                throw;
            }
        }

        /// <summary>
        /// This function is used to adjust the diff between sections and added nto the rowInserCount in case of dynamic. Used for dynamic sections.
        /// </summary>
        /// <param name="sections">sections config collection</param>
        /// <param name="sheet">current sheet</param>
        /// <param name="rowInsertCount">rowInsertCount to add the sec difference</param>
        /// <param name="section">curent section</param>
        /// <param name="secCount">current section index</param>
        /// <returns></returns>
        public static int AdjustDynamicSecDifference(Dictionary<string, Sections> sections, string sheet, int rowInsertCount, List<string> section, int secCount)
        {
            try
            {
                var currentSectionKey = sheet + section[secCount];
                if (secCount == 0)
                {
                    var getSectionPosition = sections[currentSectionKey].SectionValue.Split(',');  // Get starting Row and Column position from config collection.
                    int startRow = Convert.ToInt32(getSectionPosition[(int)Cell.Row]);
                    rowInsertCount = startRow;
                }
                else
                {
                    var isPreviousSectionDynamic = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == section[secCount - 1]).Select(p => p.Value.IsDynamic).FirstOrDefault();
                    var PrevSectionKey = sheet + section[secCount - 1]; // Prev section key
                    var getCurrentSectionPosition = sections[currentSectionKey].SectionValue.Split(',');  // Get starting Row and Column position from config collection.
                    int startRow = Convert.ToInt32(getCurrentSectionPosition[(int)Cell.Row]); // Current section startRow
                    var getPrevSectionPosition = sections[PrevSectionKey].SectionValue.Split(',');
                    int endRow = (getPrevSectionPosition.Length > 2 ? Convert.ToInt32(getPrevSectionPosition[2]) : 0); // Prev section endRow
                    rowInsertCount += (startRow - endRow) - (isPreviousSectionDynamic == "1" ? 1 : 0);
                }

                return rowInsertCount;
            }
            catch (Exception)
            {

                throw;
            }
        }

        //Writing Group sections based on database count and dynamicGrpSections count. Called from BuildWorkbook. Used for dynamic sections.
        public virtual void WriteGroupedSections(DataSet dataSet, ref C1XLBook workBookTemplate, Dictionary<string, Sections> sections, List<DBTempHeader> dBColumns, Dictionary<string, string> configKeys, ref List<string> dBDynamicHeaders, string sheet, ref XLSheet workSheetTemplate, ref int rowInsertCount, ref int colInsertCount, List<string> dynamicGrpSections)
        {
            try
            {
                int sectionRepeatCount = 0;
                for (int row = 0; row < dataSet.Tables[Convert.ToInt32(configKeys["DynamicSectionKeyResultSetNo"]) - 1].Rows.Count; row++)
                {
                    for (int i = 0; i < dynamicGrpSections.Count; i++)
                    {
                        var sectionType = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == dynamicGrpSections[i]).Select(p => p.Value.SectionType).FirstOrDefault();
                        var resultSetNo = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == dynamicGrpSections[i]).Select(p => p.Value.SectionResultSetNo).FirstOrDefault();
                        var dynamicSectionKey = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == dynamicGrpSections[i]).Select(p => p.Value.DynamicSectionKey).FirstOrDefault();

                        SelectSectionType(sheet, dataSet, sections, dBColumns, configKeys, ref dBDynamicHeaders, ref workBookTemplate, ref workSheetTemplate, ref rowInsertCount, ref colInsertCount, dynamicGrpSections[i], sectionType, resultSetNo, dynamicSectionKey, row, sectionRepeatCount);
                    }
                    sectionRepeatCount++;
                }
            }
            catch (Exception)
            {

                throw;
            }
        }

