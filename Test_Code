CREATE TABLE #ValidTxnRefs
(
    TxnRefNbr INT
)

INSERT INTO #ValidTxnRefs
(
	TxnRefNbr
)
SELECT DISTINCT
       E.TxnRefNbr
FROM ETIDetailRecord E
WHERE E.StatusId = 140
  AND E.ProcessedRecordID = 2
  AND E.RecordTypeId = 3


CREATE TABLE #TempCloseRebookLoan
(
    RawDataId INT
)
INSERT INTO #TempCloseRebookLoan
(
	RawDataId
)
SELECT DISTINCT E.RawDataId
FROM ETIDetailRecord E
INNER JOIN #ValidTxnRefs V
    ON V.TxnRefNbr = (CASE WHEN E.RecordTypeId = 23 THEN
       CAST(SUBSTRING(E.BgnRef, 2, 11) AS INT) ELSE E.BgnRef END)
   AND (E.RecordTypeId = 1 OR E.RecordTypeId = 23)
   AND E.StatusId = 0




