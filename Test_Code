        /// <summary>
        /// This method is used to get the data from sales recon template and converted into xml format.
        /// </summary>
        /// <param name="savedFileNamePath"></param>
        /// <param name="exportPath"></param>
        /// <returns></returns>
        public string GenerateXml(string savedFileNamePath, string exportPath, string acctNbr)
        {
            XmlTextWriter _xmlDataOutput;
            string OutputFile = exportPath + "Output" + DateTime.Now.ToString("MMddyyyy");
            string saveAsFileName = null;
            C1XLBook excelWrkB = new C1XLBook();
            C1XLBook excelSaveAsWrkB = new C1XLBook();

            excelWrkB.Load(savedFileNamePath);

            saveAsFileName = Path.GetDirectoryName(savedFileNamePath) + "\\" + Path.GetFileName(savedFileNamePath) + "_saveas" + Path.GetExtension(savedFileNamePath);
            excelWrkB.Save(saveAsFileName);
            excelSaveAsWrkB.Load(saveAsFileName);

            int sheetIndex = excelConfig["SheetIndex"] - 1, rowStartIndex = excelConfig["RowStartIndex"] - 1, colStartIndex = excelConfig["ColumnStartIndex"] - 1;

            try
            {
                _xmlDataOutput = new XmlTextWriter(OutputFile, Encoding.UTF8);
            }
            catch (Exception ex)
            {
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, ex));
                throw new Exception(Common.GetMessage("Common", "FailedToCreateOPFile"));
            }

            try
            {
                _xmlDataOutput.WriteStartDocument(true);
                _xmlDataOutput.WriteStartElement("data");
            }
            catch (Exception ex)
            {
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, ex));
                throw new Exception(Common.GetMessage("Common", "FailedToWriteOPFile"));
            }

            try
            {
                object cellValue = null;
                for (int row = rowStartIndex; !string.IsNullOrEmpty(excelSaveAsWrkB.Sheets[sheetIndex][row, colStartIndex]?.Text); row++)
                {
                   
                    _xmlDataOutput.WriteStartElement("pool");

                    _xmlDataOutput.WriteStartAttribute("acct_nbr", null);
                    _xmlDataOutput.WriteString(acctNbr.ToString());
                    _xmlDataOutput.WriteEndAttribute();

                    foreach (var excel in excelMapping)
                    {
                        cellValue = excelSaveAsWrkB.Sheets[sheetIndex][row, excel.ColumnIndex - 1].Value;

                        switch (excel.ColumnType.ToUpper())
                        {
                            case "STRING":
                                _xmlDataOutput.WriteStartAttribute(excel.ColumnName, null);
                                _xmlDataOutput.WriteString(cellValue.ToString().Trim());
                                _xmlDataOutput.WriteEndAttribute();
                                break;
                            case "DATETIME":
                                _xmlDataOutput.WriteStartAttribute(excel.ColumnName, null);
                                _xmlDataOutput.WriteString(Convert.ToDateTime(GetConvertedDate(cellValue)).ToShortDateString());
                                _xmlDataOutput.WriteEndAttribute();
                                break;
                        }
                    }
                    _xmlDataOutput.WriteEndElement();

                }
            }
            catch (Exception ex)
            {
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, ex));
                throw new Exception(Common.GetMessage("Common", "InvalidFile"));
            }
            finally
            {
                try
                {
                    _xmlDataOutput.WriteEndElement();
                    _xmlDataOutput.WriteEndDocument();
                    _xmlDataOutput.Flush();
                }
                catch (Exception ex)
                {
                    _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, ex));
                    throw new Exception(Common.GetMessage("Common", "FailedToWriteOPFile"));
                }

                try
                {
                    _xmlDataOutput.Close();
                    _xmlDataOutput.Dispose();
                    excelWrkB.Dispose();
                    excelWrkB = null;
                    excelSaveAsWrkB.Dispose();
                    excelSaveAsWrkB = null;
                }
                catch (Exception ex)
                {
                    _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, ex));
                    throw new Exception(Common.GetMessage("Common", "FailedToCloseFile"));
                }
                try
                {

                    string xmlDataContent = XmlTextWriterToString(OutputFile);
                    if (!(xmlDataContent.Contains("pool")))
                    {
                        throw new Exception(Common.GetMessage("Recall", "InvalidRecallTemplate"));
                    }

                }
                catch (Exception ex)
                {
                    _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, ex));
                    throw new Exception(Common.GetMessage("Recall", "InvalidRecallTemplate"));
                }
            }
            return OutputFile;
        }

        /// <summary>
        /// This method is used to convert the date into the correct format.
        /// </summary>
        /// <param name="cellValue"></param>
        /// <returns></returns>
        private static object GetConvertedDate(object cellValue)
        {
            object record = null;

            if (cellValue.ToString().Trim().Length > 0)
            {
                switch (cellValue.ToString().Trim().Length)
                {
                    case 8:
                        if (cellValue.ToString().IndexOf("/") == -1)
                        {
                            string date = cellValue.ToString().Trim().Substring(4, 2) + @"/" + cellValue.ToString().Trim().Substring(6) + @"/" + cellValue.ToString().Trim().Substring(0, 4);

                            record = Convert.ToDateTime(date);
                        }
                        else
                            record = Convert.ToDateTime(cellValue.ToString().Trim());
                        break;
                    default:
                        record = Convert.ToDateTime(cellValue.ToString().Trim());
                        break;
                }
            }
            else
            {
                record = Convert.ToDateTime(DateTime.UtcNow.AddHours(-9.0).AddDays(3.0).ToShortDateString());
            }

            return record;
        }



