		Default_Open_TPUID		VARCHAR(20),
		Default_Term_TPUID		VARCHAR(20), 
		IsPrepay				BIT 
	)	

	Declare @LoanDetails table 
	(
		SecID 				INT, 
		CUSIP				VARCHAR(9),
		SEDOL				VARCHAR(7),
		ISIN				VARCHAR(12),
		RecordDate			DATETIME,
		SecurityDesc1		VARCHAR(40),
		SecurityDesc2		VARCHAR(40),
		ISOCountry			VARCHAR(100),
		TxnRefNbr			VARCHAR(10), 
		AcctNbr				VARCHAR(12),		
		FaceAmount 			BIGINT,
		IsLnd 				BIT, 
		IsPendingLoan		BIT
	)


	CREATE TABLE #PendingTbl
	(
		TOE					VARCHAR(3),
		RecordTypeID		INT,
		Source				VARCHAR(20),
		TxnRefNbrNew		INT,
		StatusID			SMALLINT,
		AcctNbr				VARCHAR(12),
		AcctID				INT,
		isIndemnified		BIT,
--		isFITokyoRepo		BIT,
		isFITokyoSecLend	BIT,
		IsFISTBUSA			BIT,
		AcctLendGrpID		INT,
		WLDepository		VARCHAR(12),
		SecID				INT,
		BucketSecType		CHAR(2),
		ISOCountry			CHAR(2),
		BrkID				INT,
		BrkNbr				VARCHAR(6),
		BrkCrGrpID			INT,
		CollCcyCode			VARCHAR(3),
		FaceAmount			BIGINT,
		TradePrice			DECIMAL(14,7),
		Principal			BIGINT,
		CollCCYtoUSDExchRate DECIMAL(13,6),	
		PrincipalUSD		BIGINT,
		FinderNbr			VARCHAR(6),
		LoanType			CHAR(1),
--		isTermRepo			BIT,
		TriPartyGrpID		INT,
		CollSchedID			INT,
		LoanCategory		VARCHAR(2),
		RepoSecurityTypeID	INT
	)


	DECLARE @DomainLookupDefaultPrepayMTMNewLoan AS VARCHAR(100) 
	DECLARE @DomainLookupDefaultPrepayMTMLoanCountryException AS VARCHAR(100) 

	
	--======================================================================================================================================================================================================
	--Read Default Prepay Indicator Setup from Domain Lookup 
	--======================================================================================================================================================================================================
	SET @DomainLookupDefaultPrepayMTMNewLoan = LAVA.DBO.f_GetDomainLookupValue('DEFAULT_PREPAY_INDICATOR_SETUP','MTMNEWLOAN')
	SET @DomainLookupDefaultPrepayMTMLoanCountryException = LAVA.DBO.f_GetDomainLookupValue('DEFAULT_PREPAY_INDICATOR_SETUP','MTMLOANCOUNTRYEXCEPTION')

	SELECT Parameter AS SettlementDay
	INTO #TMP_DEFPREPAY_MTM_NEW_LOANS 
	FROM LAVA.DBO.f_ParseParameters(@DomainLookupDefaultPrepayMTMNewLoan)
	
	SELECT Parameter AS SettlementDay
	INTO #TMP_DEFPREPAY_MTM_LNCTRY
	FROM LAVA.DBO.f_ParseParameters(@DomainLookupDefaultPrepayMTMLoanCountryException)
	--======================================================================================================================================================================================================


	SET @ErrorRowSeq = 1
	SET @Maturity_Days = 30

	/** Get Previous business date for AsOfDate**/
	SELECT @PrevBizDay = dbo.f_GetPrevBizDay (@BussDate)	

	/** Get Previous business date of previous business date **/
	SELECT @PrevOfPrevBizDay = dbo.f_GetPrevBizDay (@PrevBizDay)	

	-- CONVERT ADRs Securities as US Securities
	INSERT INTO #TempSecurity
	(
		SecID, 
		CUSIP,
		SEDOL,
		ISIN,
		SecCode,
		DateEx,
		RecordDate,
		DivRate,
		SecurityDesc1,
		SecurityDesc2,
		ISOCountry,
		TickSymb,
		CcyCode,
		CountryName,
		BucketSecType,
		MaturityDate
	)
	SELECT DISTINCT
		Sec.SecID,
		Sec.CUSIP,
		Sec.SEDOL,
		Sec.ISIN,
		Sec.SecCode,
		NULL DateEx,		
		SecRecDate.MaxRecordDate,--CONVERT(VARCHAR(10),SecRecDate.MaxRecordDate,101),
		NULL DivRate,
		Sec.SecurityDesc1,
		Sec.SecurityDesc2,
		CASE Sec.SecCategoryID  WHEN 3005 THEN 'US' ELSE Sec.ISOCountry END ISOCountry,
		RTRIM(LEFT(Sec.TickSymb, 5)) AS TickSymb,
		Sec.CcyCode,
		CASE Sec.SecCategoryID  WHEN 3005 THEN 'United States' ELSE Sec.CountryName END CountryName,
		Sec.BucketSecurityType,
		MaturityDate =  ISNULL(convert(varchar(10),Sec.MaturityDate,101),'N/A')
	FROM 
		REFERENCE.dbo.Security Sec
	LEFT JOIN
	(
		SELECT 
			SecID,MAX(CASE DateRecord WHEN '12/31/9999' THEN NULL ELSE DateRecord END) MaxRecordDate 
		FROM 
			REFERENCE.dbo.CaHist 
		GROUP BY 
			secid
	)SecRecDate
	ON
		Sec.SecID = SecRecDate.SecID
	INNER JOIN
		dbo.LendingPosition Loan
	ON
		Loan.AsOfDate = @BussDate AND
		Loan.SecID	= Sec.SecID AND
		Sec.BucketSecurityType = @BucketSecType AND			
		(
			ISNULL(@SecCode,'') = '' OR
			(	Sec.SecCode = @SecCode OR
	 			Sec.Isin = @SecCode OR
	 			Sec.Sedol = @SecCode OR
	 			Sec.Cusip = @SecCode OR
				RTRIM(LEFT(Sec.TickSymb, 5)) = @SecCode
			) 
		)


	--Retain data only for selected countries
	IF (@xmlCountrySelected IS NOT NULL AND @xmlCountrySelected != '')
	BEGIN
		DECLARE @TempCountryTable TABLE 
		(
			RowID		INT IDENTITY(1,1),
			CountrySN	VARCHAR(2)
		)

		EXEC SP_XML_PREPAREDOCUMENT @hdocCountry OUTPUT, @xmlCountrySelected

		INSERT INTO @TempCountryTable 
		(
			CountrySN
		)
		SELECT FieldName
		FROM 
			OPENXML(@hdocCountry, '/ROOT/record', 1)
		WITH 
		( 
			FieldName		VARCHAR(2)
		)

		EXEC SP_XML_REMOVEDOCUMENT @hdocCountry	

		DELETE FROM 
			#TempSecurity
		WHERE
			ISOCountry
		NOT IN
			(SELECT CountrySN FROM @TempCountryTable)

	END	

	--Retain data only for selected securities
	IF (@xmlSecIdList IS NOT NULL AND @xmlSecIdList != '')
	BEGIN
		DECLARE @TempSecIDTable TABLE 
		(
			RowID	INT IDENTITY(1,1),
			SecID	INT
		)

		EXEC SP_XML_PREPAREDOCUMENT @hdocSecId OUTPUT, @xmlSecIdList

		INSERT INTO @TempSecIDTable 
		(
			SecID
		)
		SELECT FieldName
		FROM 
			OPENXML(@hdocSecId, '/ROOT/record', 1)
		WITH 
		( 
			FieldName			INT
		)

		EXEC SP_XML_REMOVEDOCUMENT @hdocSecId	

		DELETE FROM 
			#TempSecurity 
		WHERE 
			SecID 
		NOT IN 
			(SELECT SecID FROM @TempSecIDTable)
			

	END
	
	-- Update Ex Date and Div Rate for max (Record Date)
	UPDATE 
		#TempSecurity
	SET 
		DateEX = CaHist.DateEX,
		DivRate = CaHist.PaymentRate
	FROM
		#TempSecurity Sec
	INNER JOIN
		REFERENCE.dbo.CaHist
	ON
		Sec.SecID = CaHist.SecID AND
		Sec.RecordDate = CaHist.DateRecord

	-- Get Position Details
	INSERT @PositionDetails
	(
		SecID, 
		CUSIP,
		SEDOL,
		ISIN,
		SecCode,
		BucketSecType,
		AcctNbr,
		DateEX,
		RecordDate,
		DivRate,
		SecurityDesc1,
		SecurityDesc2,
		ISOCountry,
		TickSymb,
		CcyCode,
		UnitsTotal,
--		UnitsLendable,
		UnitsTraderLendable,
		UnitsBrokerLendable,		
		Security_Maturity_Date
	)
	SELECT
		Sec.SecID,
		Sec.CUSIP,
		Sec.SEDOL,
		Sec.ISIN,
		Sec.SecCode,
		Sec.BucketSecType,
		LP.AcctNbr,
		Sec.DateEX,
		Sec.RecordDate,
		Sec.DivRate,
		Sec.SecurityDesc1,
		Sec.SecurityDesc2,
		Sec.ISOCountry + ' (' + Sec.CountryName + ')' ISOCountry,
		TickSymb,
		Sec.CcyCode,
		UnitsTotal 	= ISNULL(LP.UnitsAvailableProcessed, 0),
--		UnitsLendable 	= ISNULL(LP.UnitsLendableProcessed, LP.UnitsLendableRestricted),
		UnitsTraderLendable = ISNULL (LP.UnitsLendableProcessed, 0),
		UnitsBrokerLendable = ISNULL (LP.UnitsLendableRestricted, ISNULL(LP.UnitsLendableProcessed, 0)),
		Sec.MaturityDate
	FROM 
		#TempSecurity Sec
	INNER JOIN
		dbo.LendingPosition LP
	ON
		LP.AsOfDate = @BussDate AND
