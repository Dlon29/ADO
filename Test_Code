						)
						SELECT 
							PoolId,
							AcctPriority,
							LendingLimitGrpID,
							AcctId,
							AcctNbr,
							AcctSN,
							BrkNbr,
							BrkID,
							@FaceAmount,
							AcctAvailibityRem,
							AcctAvailibityRestricted,
							LoopAvailability,
							PoolAvailability,
							BrkCrGrpID,
							BrkCreditLimitUSD,
							UsageCreditLimitUSD,
							MinAvailAndBCLAndUCLQty,
							LendingLimitUSD,
							ConcLimitUSD,
							MinLendLimAndConcLimUSD,
							MinOfAvailAndLLAndCLQty,
							MinOfAllLimitLoopQty,
							MinOfAllLimitPoolQty,
							UnitsLendable,
							UnUsedUnits,
							IsAcctUsed,
							@BucketSecType,
							@SecCode,
							SecID,
							WLDepository,
							ISOCountry,
							IsIndemnified,
							Price,
							MktValuePositionUSD,
							MktValueLoanUSD,
							PercentOnLoan,
							CanUseAcctForCleanUp,
							IsPoolUpdated,
							--isFITokyoRepo,
							isFITokyoSecLend,
							IsFISTBUSA,
							CASE WHEN @FaceAmount > @TotalIndNonIndUnitsRestrictedRem THEN 0 ELSE 1 END,
							SecLoc,
							SMODE,
							IsAgentDirectLending,
							AcctGrpID,
							IsPrePay,
							TriPartyGrpID
						FROM 
							#WorkingTbl

					END -- end of ELSE IF (@CanProcessLoanReq = 0 AND @SQL_IDENTIFIER = 'BULKLOAN')

					--For bulk loans, we now need to reduce Avalibility, Broker Credit Limtis, Usage Conc Limit, Lending Limits and Acct-Broker Conc limts etc.
					--This needs to be done so next set of securities can be booked with the correct limits
					--We book bulk loans only for Sec Lending and NOT for Repo. So doing it only for bulk loans 
					--This wont be applicable for loans booked from single loan booking screen

					IF (@SQL_IDENTIFIER = 'BULKLOAN' AND @CanProcessLoanReq = 1)  
					BEGIN
						SET @ReqPoolCount = NULL
						SET @ReqPoolTotal = NULL

						SELECT @ReqPoolCount = MIN(PoolID) FROM #FinalWorkingTbl WHERE SecId = @SecID 
						SELECT @ReqPoolTotal = MAX(PoolID) FROM #FinalWorkingTbl WHERE SecId = @SecID 

						
						/** loop thru all the pools of a request to adjust the limits for next reqests **/
						WHILE (@ReqPoolCount <= @ReqPoolTotal)
						BEGIN

							TRUNCATE TABLE #TempLoopsInPool

							INSERT INTO 
								#TempLoopsInPool (IsIndemnified)
							SELECT 
								DISTINCT IsIndemnified
							FROM
								#FinalWorkingTbl 
							WHERE 
								PoolID = @ReqPoolCount AND
								SecId = @SecID

							SELECT @LoopCount =  MIN(RowId) FROM #TempLoopsInPool
							SELECT @TotalNoOfLoops = MAX(RowId) FROM #TempLoopsInPool

							/** Loop thru all loops in a pool **/
							WHILE (@LoopCount <= @TotalNoOfLoops) --Loop through each loop (indemnified or non-indemnified in a pool)
							BEGIN
								SET	@IsIndemnified = NULL
								SET @IsADLAccount = 0
								SET @TmpisFISTBUSA = 0
								SET @TmpisFITokyoSecLend = 0

								SELECT 
									@IsIndemnified = IsIndemnified
								FROM 
									#TempLoopsInPool 
								WHERE 
									RowId = @LoopCount

								/** Calculate total units lendable and total units inc/dcr in loop (Ind or NonInd) **/
								SELECT 
									@TotalQuantityLendedInLoop = SUM (UnitsLendable)
			--						@TotalUnitsIncDcr = SUM (UnitsIncDcr)
								FROM 
									#FinalWorkingTbl 
								WHERE 
									SecId = @SecID AND
									PoolID = @ReqPoolCount AND
									IsIndemnified = @IsIndemnified

								/*Get Distinct AcctGrpID for ADL - (Agent Direct Lending) Accounts. 
								This is used for reducing limits in #CtrAgentDirectLendingCreditLimit for ADL Accounts
								*/
								SELECT DISTINCT TOP 1
									@AcctGrpID = AcctGrpID,
									@IsADLAccount = ISNULL(IsAgentDirectLending,0) 
								FROM 
									#FinalWorkingTbl 
								WHERE 
									SecId = @SecID AND
									PoolID = @ReqPoolCount AND
									IsIndemnified = @IsIndemnified AND
									(ISNULL(IsAgentDirectLending,0) = 1 AND ISNULL(IsIndemnified,0) != 1)				-- Consider only ADL Non Indemnified accountAND

								--Commented code, Consider  IsFISTBUSA and isFITokyoSecLend while calculation of limits only
								-- For NON_ADL account get value for @TmpisFISTBUSA and @TmpisFITokyoSecLend for further limit reduction
								SELECT DISTINCT TOP 1
									@TmpisFISTBUSA = IsFISTBUSA,
									@TmpisFITokyoSecLend = isFITokyoSecLend
								FROM 
									#FinalWorkingTbl 
								WHERE 
									SecId = @SecID AND
									PoolID = @ReqPoolCount AND
									IsIndemnified = @IsIndemnified AND
									((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 

--select 'bfr update', @TotalQuantityLendedInLoop,* from #ctrBrokerCreditLimit
								IF(ISNULL(@IsADLAccount,0) = 0) -- FOR NON ADL Account 
								BEGIN
									--Need to change for isFITokyoRepo, isFITokyoSecLend, IsFISTBUSA
									/** Update temp Broker Credit Limit control table **/
									IF (@LoanCategory = 'L' AND @TmpisFISTBUSA = 1)
									BEGIN
										IF (@IsIndemnified = 1) -- Ind
										BEGIN
											IF (@FinderNbr = '000LDN') -- London sec
											BEGIN 
												UPDATE 
													#ctrBrokerCreditLimit
												SET 
													CrLimitLndSecLendIndemnifiedRem = CrLimitLndSecLendIndemnifiedRem - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit)
												FROM 
													#ctrBrokerCreditLimit
												WHERE
													BrkCrGrpID = @BrkCrGrpID 
											END
											ELSE -- US Sec
											BEGIN
												UPDATE 
													#ctrBrokerCreditLimit
												SET 
													CrLimitUSSecLendIndemnifiedRem = CrLimitUSSecLendIndemnifiedRem - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit)
												FROM 
													#ctrBrokerCreditLimit BCL
												WHERE
													BrkCrGrpID = @BrkCrGrpID
											END
										END
										ELSE -- non ind
										BEGIN
											IF (@FinderNbr = '000LDN') -- London sec
											BEGIN
												UPDATE 
													#ctrBrokerCreditLimit
												SET 
													CrLimitLndSecLendNonIndemnifiedRem = CrLimitLndSecLendNonIndemnifiedRem - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit) 
												FROM 
													#ctrBrokerCreditLimit
												WHERE
													BrkCrGrpID = @BrkCrGrpID
											END
											ELSE -- US Sec
											BEGIN
												UPDATE 
													#ctrBrokerCreditLimit
												SET
													CrLimitUSSecLendNonIndemnifiedRem = CrLimitUSSecLendNonIndemnifiedRem - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit) 
												FROM 
													#ctrBrokerCreditLimit 
												WHERE
													BrkCrGrpID = @BrkCrGrpID

											END
										END -- end of IF (@IsIndemnified = 1)
									END -- end of IF (@LoanCategory = 'L' AND @TmpisFITokyoSecLend = 1)
									ELSE IF (@LoanCategory = 'L' AND @TmpisFITokyoSecLend = 1)
									BEGIN
										UPDATE 
											#ctrBrokerCreditLimit
										SET
											CrLimitTkySecLendRem = CrLimitTkySecLendRem - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit) 
										FROM 
											#ctrBrokerCreditLimit 
										WHERE
											BrkCrGrpID = @BrkCrGrpID
									END -- end of ELSE IF (@LoanCategory = 'L' AND @TmpisFITokyoSecLend = 1)

--select 'afr update', * from #ctrBrokerCreditLimit

									/** Update temp Usage Conc Limit control table **/
									IF (@LoanCategory = 'L' AND @TmpisFISTBUSA = 1)
									BEGIN
										IF (@IsIndemnified = 1) -- Ind
										BEGIN
											UPDATE 
												#ctrUsageConcLimit
											SET 
												LoanUsageIndemnifiedRemUSD = LoanUsageIndemnifiedRemUSD - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit)
											WHERE
												BrkCrGrpID = @BrkCrGrpID
										END
										ELSE --non ind
										BEGIN	
											UPDATE 
												#ctrUsageConcLimit
											SET 
												LoanUsageNonIndemnifiedRemUSD = LoanUsageNonIndemnifiedRemUSD - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit)
											WHERE
												BrkCrGrpID = @BrkCrGrpID
										END
									END --end of IF (@LoanCategory = 'L' AND @TmpisFISTBUSA = 1)
									ELSE IF (@LoanCategory = 'L' AND @TmpisFITokyoSecLend = 1)
									BEGIN
										UPDATE 
											#ctrUsageConcLimit
										SET 
											TkySecLendLoanUsageRemUSD = TkySecLendLoanUsageRemUSD - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit)
										WHERE
											BrkCrGrpID = @BrkCrGrpID
									END -- end of (@LoanCategory = 'L' AND @TmpisFITokyoSecLend = 1)

								END  --- END OF IF(ISNULL(@IsADLAccount,0) = 0) -- FOR NON ADL Account 
								/* FOR ADL Account, @TmpisFISTBUSA and  @TmpisFISTBUSA is always 0, so it will not go inside of above loop.
								   FOR ADL accounts,we have different table -'#CtrAgentDirectLendingCreditLimit',  from which limits should get reduce. 
								   below logic will reduce limit for ADL Accounts, Here we are reducing Broker and Usage limit.
								*/
								ELSE IF(ISNULL(@IsADLAccount,0) = 1) -- FOR ADL Account 
								BEGIN

									/** Below limit is calculated for ADL Accounts where @IsIndemnified will be differnt from 0 and 1, and  unique for each AccountGroupId **/																																																														
									
									UPDATE 
										#CtrAgentDirectLendingCreditLimit
									SET
										crLimitADL = crLimitADL - (ISNULL(@TotalQuantityLendedInLoop,0) * @Price) 
									FROM 
										#CtrAgentDirectLendingCreditLimit 
									WHERE
										BrkCrGrpID = @BrkCrGrpID AND
										AcctGrpId = @AcctGrpID


									/** Update temp Usage Conc Limit control table **/
									UPDATE 
										#ctrUsageConcLimit
									SET 
										LoanUsageIndemnifiedRemUSD = LoanUsageIndemnifiedRemUSD - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit)
									WHERE
										BrkCrGrpID = @BrkCrGrpID


									UPDATE 
										#ctrUsageConcLimit
									SET 
										LoanUsageNonIndemnifiedRemUSD = LoanUsageNonIndemnifiedRemUSD - (ISNULL(@TotalQuantityLendedInLoop,0) * @PricePerUnit)
									WHERE
										BrkCrGrpID = @BrkCrGrpID
								
								END  -- END OF IF(@IsADLAccount = 1) -- FOR ADL Account 


								/** Update temp Account Lending Limit control table : Decrease limit **/
								UPDATE 
									#ctrLendingLimit
								SET 
									LendGrpLimitRemUSD = LendGrpLimitRemUSD - (ISNULL(work.UnitsLendable,0) * @PricePerUnit) 
								FROM 
									#ctrLendingLimit LL
								INNER JOIN
								(
									SELECT 
										SecID,PoolID, IsIndemnified, LendingLimitGrpID, SUM(UnitsLendable) UnitsLendable
									FROM 
										#FinalWorkingTbl 
									WHERE
										-- ((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
										(ISNULL(IsAgentDirectLending,0) = 0) -- Consider Lending Limits only for Non-ADL Accts
									GROUP BY 
										SecID,PoolID, IsIndemnified, LendingLimitGrpID
									HAVING 						
										SecId = @SecID AND	
										PoolID = @ReqPoolCount AND
										IsIndemnified = @IsIndemnified 

								) work
								ON 
									LL.AcctLendGrpID = work.LendingLimitGrpID


								/** Update temp Conc Limit control table : Decrease limit **/
								UPDATE 
									#ctrConcentrationLimit
								SET 
									ConcLimitRemUSD = ConcLimitRemUSD - (ISNULL(work.UnitsLendable,0) * @PricePerUnit)
								FROM 
									#ctrConcentrationLimit CL
								INNER JOIN
								(
									SELECT 
										SecID,PoolID, IsIndemnified, LendingLimitGrpID, BrkCrGrpID, SUM(UnitsLendable) UnitsLendable
									FROM 
										#FinalWorkingTbl 
									WHERE
										--((ISNULL(IsAgentDirectLending,0) = 0)	OR (ISNULL(IsAgentDirectLending,0) = 1  AND ISNULL(IsIndemnified,0) = 1)) -- Consider Only NON-ADL AND ADL-Indemnified Accounts 
										(ISNULL(IsAgentDirectLending,0) = 0) -- Consider Concentration Lending Limits only for Non-ADL Accts
									GROUP BY 
										SecID,PoolID, IsIndemnified, LendingLimitGrpID, BrkCrGrpID
									HAVING 	
										SecId = @SecID AND						
										PoolID = @ReqPoolCount AND
										IsIndemnified = @IsIndemnified 
								) work
								ON 
									CL.AcctLendGrpID = work.LendingLimitGrpID AND
									CL.BrkCrGrpID = work.BrkCrGrpID


								/** Update temp Account Percent on Loan table : Increase Market Value of Loan and Percent on Loan **/
								UPDATE 
									#ctrAccountPercentOnLoan 
								SET 
									MktValueLoanUSD = work.MktValueLoanUSD, 
									PercentOnLoan = work.PercentOnLoan
								FROM 
									#ctrAccountPercentOnLoan POL
								INNER JOIN
									#FinalWorkingTbl work
								ON 
									work.AcctNbr = POL.AcctNbr AND
									work.PoolID = @ReqPoolCount AND
									work.IsIndemnified = @IsIndemnified AND
									work.ISOCOuntry = POL.ISOCOuntry AND
									work.SecId = @SecID
--select 'bfr update',* from #ctrAvailability


								/** Update availablitiy within account : Decrease total units ledable remaining **/
								UPDATE 
									#ctrAvailability
								SET 
									UnitsLendableRem =	CASE 
															WHEN (ctrAva.UnitsLendableRem - ISNULL(work.UnitsLendable,0)) > 0 
																THEN (ctrAva.UnitsLendableRem - ISNULL(work.UnitsLendable,0))  
																ELSE 0 
														END
								FROM 
									#ctrAvailability ctrAva
								INNER JOIN
									#FinalWorkingTbl work
								ON
									work.AcctNbr = ctrAva.AcctNbr AND
									work.SecID = ctrAva.SecID AND
									work.IsIndemnified = @IsIndemnified AND
									work.WLDepository = ctrAva.WLDepository AND
									work.SecId = @SecID


								SET @LoopCount = @LoopCount + 1
							END -- end of WHILE (@LoopCount <= @TotalNoOfLoops)

							SELECT @ReqPoolCount = MIN(PoolID) FROM #FinalWorkingTbl WHERE PoolID > @ReqPoolCount AND SecId = @SecID
						END --end of WHILE (@ReqPoolCount <= @ReqPoolTotal)

					END -- end of IF(@SQL_IDENTIFIER = 'BULKLOAN' AND @CanProcessLoanReq = 1)

				END -- end of IF (@blnValidSec = 1)
				ELSE
				BEGIN

					INSERT INTO #TempSecIDTbl (SecID,RowSeq,BucketSecType,SecCode,WLDepository,SumUnitsLendable,ErrorMessage,IsValidSec,IsProcessed)
					SELECT DISTINCT @SecID,@ErrorRowSeq,@BucketSecType,@SecCode,'',0,'This Security cannot be loaned because CUSIP does not exist',0,1
					
				END
			END -- end of IF (@blnValidCollSched = 1)
			ELSE
			BEGIN

				INSERT INTO #TempSecIDTbl (SecID,RowSeq,BucketSecType,SecCode,WLDepository,SumUnitsLendable,ErrorMessage,IsValidSec,IsProcessed)
				SELECT DISTINCT @SecID,@ErrorRowSeq,@BucketSecType,@SecCode,'',0,'Insufficient availability across the accounts (for the selected collateral schedule)',0,1
				
			END
		SET @SecCount = @SecCount + 1
	END	-- end of WHILE (@SecCount <= @TotalSecCount)


--DELETE FROM #WorkingTbl
	IF (@SQL_IDENTIFIER = 'SINGLELOAN')
	BEGIN

		 UPDATE #FinalWorkingTbl 
		 SET 
			Is_DedicatedMarginCollateral_FISecurity = 1
		 FROM
