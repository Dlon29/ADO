	    CASE WHEN (LEN(GotoRate) = 0 OR GotoRate = '') THEN NULL ELSE CONVERT(DECIMAL(20,7),GotoRate) END,
	    GotoTermDate,
	    CASE WHEN (LEN(GotoComments) = 0 OR GotoComments = '')  THEN NULL ELSE GotoComments END,--GotoComments,		  			    
	    CASE WHEN (LEN(GotoProductCategory) = 0 OR GotoProductCategory = '')  THEN NULL ELSE GotoProductCategory END,--GotoProductCategory,
	    CASE WHEN (LEN(GotoProductCategoryLoanType) = 0 OR GotoProductCategoryLoanType = '')  THEN NULL ELSE GotoProductCategoryLoanType END,--GotoProductCategoryLoanType, 
	    CASE WHEN (LEN(GotoProductCategoryLoanDuration) = 0 OR GotoProductCategoryLoanDuration = '')  THEN NULL ELSE GotoProductCategoryLoanDuration END,--GotoProductCategoryLoanDuration
		ASECheck,
		CASE WHEN (LEN(RepoSecurityTypeID) = 0 OR RepoSecurityTypeID = '')  THEN NULL ELSE RepoSecurityTypeID END,  --RepoSecurityTypeID,
		CASE WHEN (LEN(RepoTicketID) = 0 OR RepoTicketID = '')  THEN NULL ELSE RepoTicketID END,  --RepoTicketID
		CASE WHEN (LEN(HairCut) = 0 OR HairCut = '') THEN NULL ELSE CONVERT(DECIMAL(21,9),HairCut) END,
		FactorAtBooking = CASE WHEN (LEN(Factor) = 0 OR Factor = '') THEN NULL ELSE CONVERT(DECIMAL(22,10),Factor) END,
		CASE WHEN (LEN(CashBidPrice) = 0 OR CashBidPrice = '') THEN NULL ELSE CONVERT(DECIMAL(14,7),CashBidPrice) END,
		Is_GNMA_Security,
		UseAmountCheck,
		CASE WHEN (LEN(Principal) = 0 OR Principal = '') THEN NULL ELSE CONVERT(DECIMAL(17,2),Principal) END,
		TripartyRepoShellNbr,
		CASE WHEN (LEN(CashPoolRate) = 0 OR ISNULL(CashPoolRate,'') = '') THEN NULL ELSE CONVERT(DECIMAL(9,6),CashPoolRate) END,
		CASE WHEN (LEN(TripartyRepoCUSIP) = 0 OR ISNULL(TripartyRepoCUSIP,'') = '') THEN NULL ELSE TripartyRepoCUSIP END,
		CASE WHEN (LEN(TripartyRepoStructure) = 0 OR ISNULL(TripartyRepoStructure,'') = '') THEN NULL ELSE TripartyRepoStructure END,
		CASE WHEN (LEN(TripartyRepoAccount) = 0 OR ISNULL(TripartyRepoAccount,'') = '') THEN NULL ELSE TripartyRepoAccount END,
		CASE WHEN (LEN(TripartyRepoNoticePeriod) = 0 OR ISNULL(TripartyRepoNoticePeriod,'') = '') THEN NULL ELSE CONVERT(INT,TripartyRepoNoticePeriod) END,
		CASE WHEN (LEN(TripartyRepoTranType) = 0 OR ISNULL(TripartyRepoTranType,'') = '') THEN NULL ELSE TripartyRepoTranType END,
		CASE WHEN (LEN(TripartyRepoPID) = 0 OR ISNULL(TripartyRepoPID,'') = '') THEN NULL ELSE TripartyRepoPID END,
		CASE WHEN (LEN(ClientFICCID) = 0 OR ISNULL(ClientFICCID,'') = '') THEN NULL ELSE ClientFICCID END,
		CASE WHEN (LEN(BrokerFICCID) = 0 OR ISNULL(BrokerFICCID,'') = '') THEN NULL ELSE BrokerFICCID END,
		CASE WHEN (LEN(ISFICCTransmitChecked) = 0 OR ISNULL(ISFICCTransmitChecked,'') = '') THEN NULL ELSE ISFICCTransmitChecked END,
		CASE WHEN TraderAgreed = '' THEN NULL ELSE TraderAgreed END,
		CASE WHEN TraderConfirmationEmail = '' THEN NULL ELSE TraderConfirmationEmail END,
		CASE WHEN EmailSupressedFlag = 1 THEN @EmailSupressedFlagTSL	  ----When checkbox = checked i.e "1" from UI then pick up the suppressed flag set fpr TSL from table "DashBoardEmailActivityType"
		WHEN (EmailSupressedFlag = 0 AND TraderAgreed = '' AND TraderConfirmationEmail = '') THEN NULL	  ----When checkbox = Not Checked, i.e "0" from UI then check for TraderAgreed and TraderConfirmationEmail columns. If the other 2 columns are '' means Trader
s are not configured for Broker. Update EmailSupressedFlag to NULL. 
		ELSE EmailSupressedFlag END,
        ISNULL(TripartyRepoTradeDtl,0),
		CASE WHEN SFTRCancelledLoanRefNbr = '' THEN NULL ELSE SFTRCancelledLoanRefNbr END,
		CASE WHEN (LEN(BookingCouponRate) = 0 OR BookingCouponRate = '') THEN NULL ELSE CONVERT(DECIMAL(10,8),BookingCouponRate) END,
		CASE WHEN TPUID = '' THEN NULL ELSE TPUID END,
		CASE WHEN RRLinkRefNbr = '' THEN NULL ELSE RRLinkRefNbr END,
		ISNULL(IsPrePay,0),
		CASE WHEN (LEN(CLOAccruedInterestAtBooking) = 0 OR CLOAccruedInterestAtBooking = '') THEN NULL ELSE CONVERT(DECIMAL(11,2),CLOAccruedInterestAtBooking) END,	 --CLOAccruedInterestAtBooking
		NULLIF(AllocationChangeReason,0)
	FROM 
	OPENXML(@hdoc, '/NewLoan/FieldName', 1)
	WITH
	(
		AsOfDate							DATETIME,
		SettlementDate						DATETIME,
		SecCode								VARCHAR(12),
		SecID								INT,
		BucketSecType						CHAR(2),	
		WLDepository						VARCHAR(12),			
		IsIndemnified						BIT,			
		UnitsAllocated						BIGINT,
		MaxLimit							BIGINT,
		MinLimit							BIGINT, 
		Incr								INT,
		BrkID								INT,	
		BrkNbr								VARCHAR(12),
		AcctId								INT,
		AcctNbr								VARCHAR(12),
		FaceAmountFromAlloc					BIGINT,
		FaceAmountActual					BIGINT,	
		Price								NUMERIC(20,7),  --// Neelima-- change in code to make Price as 7 Decimal From Decimal(20,6)
		PriceCurr							VARCHAR(3),
		RecordTypeID						INT,
		BatchDate							DATETIME,
		TransmitFlg							VARCHAR(1),
		FinderNbr							VARCHAR(10),
		TermDate							DATETIME,
		SecLocCode							VARCHAR(12),
		CollateralDate						DATETIME,
		GoodFundDate						DATETIME,
		CollCCY								VARCHAR(3),
		Disclosure							VARCHAR(1),
		RebateRate							DECIMAL(9,6),
		CleanUpFlg							VARCHAR(1),
		CollateralNo						VARCHAR(12),
		CMPool								VARCHAR(6),  --// Neelima-- change in code to make CMPool as Varchar(6) from  Varchar(3) 
		Comments							VARCHAR(20),
		SettlementInstr						VARCHAR(30),
		SettlementCCY						VARCHAR(6),
		ModifiedBy							VARCHAR(50),
		MaxLotNbr							INT,
		AvailRestOverriden					BIT,
		AcctAvailibity						BIGINT,
		UnUsedUnits							BIGINT,
		AcctPriority						INT,
		TriPartyGrpID						VARCHAR(3), 
		CollSchedID							INT,  -- Modified for P-1775 FROM VARCHAR(3) TO INT
		ProductCategory						VARCHAR(3),
		ProductCategoryLoanType				VARCHAR(20),
		ProductCategoryLoanDuration			VARCHAR(20),
		BasketNbr							INT,	    
		LoanCategory						VARCHAR(2),
		LIBORRate							VARCHAR(100),
		ResetDate							datetime,
		GotoRate							VARCHAR(100),
		GotoTermDate						datetime,		
		GotoComments						varchar(20),	
		GotoProductCategory					varchar(3),
		GotoProductCategoryLoanType			varchar(20),
		GotoProductCategoryLoanDuration		varchar(20),
		ASECheck							BIT,
		RepoSecurityTypeID					INT,
		RepoTicketID						INT,
		HairCut								varchar(25),
		Factor								varchar(25),
		CashBidPrice						varchar(25),
		Is_GNMA_Security					BIT,
		UseAmountCheck						BIT,
		Principal							varchar(50),
		TripartyRepoShellNbr				VARCHAR(6),
		CashPoolRate						varchar(50),
		TripartyRepoCUSIP					VARCHAR(9),
		TripartyRepoStructure				VARCHAR(20),
		TripartyRepoAccount					VARCHAR(12),
		TripartyRepoNoticePeriod			INT,
		TripartyRepoTranType				VARCHAR(3),
		TripartyRepoPID						VARCHAR(10), 
		ClientFICCID						VARCHAR(10),
		BrokerFICCID						VARCHAR(10),
		ISFICCTransmitChecked               BIT,
		TraderAgreed						VARCHAR(5),
		TraderConfirmationEmail				VARCHAR(MAX),
		EmailSupressedFlag					INT,
        TripartyRepoTradeDtl				INT,
		SFTRCancelledLoanRefNbr				VARCHAR(7),
		BookingCouponRate					VARCHAR(25),
		TPUID								VARCHAR(20),
		RRLinkRefNbr						VARCHAR(8),
		IsPrePay							BIT,
		CLOAccruedInterestAtBooking			VARCHAR(13),
		AllocationChangeReason			INT
	)

	EXEC SP_XML_REMOVEDOCUMENT @hdoc

	------------------For Bulk loan, SFTRCancelledLoanRefNbr should always be NULL------------------------------
	IF (@SQL_IDENTIFIER = 'BULKLOAN')
	BEGIN
		UPDATE 
			@TempXMLTable
		SET 
			SFTRCancelledLoanRefNbr = NULL
	END

	--SET @SQL_CONDITION2 = '1'  -- Always Split Loan for MaxLoanAmount Settings

	SET @IsLoanBreak = CONVERT(BIT,@SQL_CONDITION2)
	SET @MaxLoanAmount = 50000000
	SET @GPTransmit = 'Y'
	SET @BatchNbr = 0
--select @IsLoanBreak,* from @TempXMLTable
	-- Logic added to call Adjust Availibility Proc if 'ASECheck is set from UI'--  Starts
	IF EXISTS(SELECT ASECheck FROM @TempXMLTable where ASECheck = 1)
		BEGIN
			exec p_ETIUploadAdjustAvailability @SQL_CONDITION3,@SQL_CONDITION4
		END
	-- Logic added to call Adjust Availibility Proc if 'ASECheck is set from UI'--  ENDS

	--SET @BatchNbr = (SELECT ISNULL(MAX(BatchNbr),0) + 1 FROM ETIDetailRecord)

	SET @Count = 1 
	SELECT @TotalCount = COUNT(*) FROM @TempXMLTable

	-----------Start P2420 : Reverse Repo Changes---------------------------
	----------Fetch the Sec and Broker details and LoanCategory field from @TempXMLTable to indentify current request is for Reverse Repo or not---------------
	SELECT TOP 1
			@SecIdRevRepo = SecId,
			@BrkNbrRevRepo = BrkNbr,
			@LoanCategory = LoanCategory,
			@RepoTicketID = RepoTicketID
		FROM 
			@TempXMLTable
		
	SELECT @CurrentRecLendingProcessTypeID = LendingProcessType FROM RepoTicket WHERE RepoTicketID = @RepoTicketID

	IF (@CurrentRecLendingProcessTypeID = @RevRepoLendingProcessID)
	BEGIN
		SET @IsRevRepoLoan = 1
	END 
	-----------End P2420 : Reverse Repo Changes---------------------------


	/*Loop thru all the loan requests*/
	/*Single loan screen of LAVA will have only one loan request*/
	WHILE (@Count <= @TotalCount)
	BEGIN

		SET @AsOfDate = NULL
		SET @SettlementDate = NULL 
		SET @SecCode = NULL
		SET @SecType = NULL
		SET @BrkNbr = NULL
		SET @Quantity = NULL
		SET @RecordTypeID = NULL
		SET @BatchDate = NULL
		SET @TransmitFlg = NULL
		SET @TradePrice = NULL
		SET @ModifiedBy = NULL
		SET @BrkCrGrpID = NULL
		SET @BrkGrpID = NULL
		SET @BrkID = NULL
		SET @TripartyRepoShellNbr = NULL
		SET @RRLinkRefNbr = NULL

		-----------Start P2420 : Reverse Repo Changes---------------------------
		----------In the below loop, Security and broker combination is considered as 1 Loan. ------------
		----------But for Reverse Repo Loans, Security and Broker are same for all the Loans and with below check all the rows would be considered as single Loan------------
		----------Hence to consider all the rows in XML as differnt Loans, we will update the SecID and BrkNbr of other records(other than that is being processed) to NULL--------------------- 
		IF (@IsRevRepoLoan = 1)
		BEGIN
			UPDATE
				@TempXMLTable 
			SET
				SecID = CASE WHEN RowID = @Count THEN @SecIdRevRepo ELSE NULL END,
				BrkNbr = CASE WHEN RowID = @Count THEN @BrkNbrRevRepo ELSE NULL END
		END

		-----------End P2420 : Reverse Repo Changes---------------------------

		/* Get the values in variables */
		SELECT 
			@AsOfDate = AsOfDate,
			@SettlementDate = SettlementDate,
			--@SecCode = SecCode,
			@SecId = SecId,
			@SecType = BucketSecType,
			@BrkNbr = BrkNbr,
			@Quantity = FaceAmountActual,
			@TradePrice = Price,
			@RecordTypeID = RecordTypeID,
			--@BatchDate = BatchDate, --Batch date from LAVA single loan request screen may be incorrect. So use it from G1
			@TransmitFlg = TransmitFlg,
			@ModifiedBy = ModifiedBy,
			@LoanCategory = LoanCategory,
			@UseAmountCheck = UseAmountCheck,
			@TripartyRepoShellNbr = TripartyRepoShellNbr,
			@RRLinkRefNbr = RRLinkRefNbr
		FROM 
			@TempXMLTable 
		WHERE 
			RowID = @Count

		SELECT TOP 1
			@WLDepository = WLDepository
		FROM
			@TempXMLTable 
		WHERE
			SecId = @SecId AND
			UnitsAllocated > 0

		-- for bulk loan case, use this quantity to check if loan break is requried or not.
		SELECT 
			@Quantity = SUM(ISNULL(FaceAmountActual,0))
		FROM
			@TempXMLTable 
		WHERE
			SecId = @SecId 

		TRUNCATE TABLE #TempSMODeDepo

		INSERT INTO #TempSMODeDepo
		(
			SecId,
			Depository,
			WLDepository,
			SMODE
		)
		SELECT 
			DISTINCT Temp.SecID , ISNULL(LTRIM(RTRIM(GLOBALONE.dbo.f_RemoveHeaderZero(Depo.CM_ACCT_NO))), '') Depository, Temp.WLDepository,Depo.SMODE
		FROM 
			@TempXMLTable Temp
		INNER JOIN
			GLOBALONE.dbo.DEPOT Depo 
		ON
			-- from UI, receive SettlementCCY as 'FEDCW' for LoanType = 'T' and in G1 Depot table SMODE for Same is 'USFED'
			Depo.SMODE = CASE WHEN CHARINDEX('CW',Temp.SettlementCCY) > 0 THEN 'US' + REPLACE (Temp.SettlementCCY,'CW','') ELSE Temp.SettlementCCY END --Temp.SettlementCCY
		WHERE 
			Temp.SecId = @SecId AND
			Temp.UnitsAllocated > 0

		-- If settlement mode and depository does not match then loan cannot be booked.
		IF ((SELECT COUNT(*) FROM #TempSMODeDepo) > 0)
		BEGIN
			IF NOT EXISTS(SELECT * FROM #TempSMODeDepo WHERE Depository = @WLDepository)
			BEGIN		
				RAISERROR('Invalid Settlement Mode and Depository Combination.', 16, 1)
				RETURN 1
			END
		END

		IF EXISTS ( SELECT 1 from MOBETTER.dbo.Broker 
					WHERE Brknbr = @BrkNbr AND IsTripartyRepo = 1)
		BEGIN
			IF(@TripartyRepoShellNbr IS NULL OR @TripartyRepoShellNbr = '')
			BEGIN
				SELECT @TripartyRepoShellNbr = dbo.f_GetTripartyRepoShellNumber (@BrkNbr)

				IF(@TripartyRepoShellNbr = '' OR @TripartyRepoShellNbr IS NULL)
				BEGIN
					SET @TripartyRepoShellNbr = 'T00001'
				END
			END
		END
		
		--Batch date from LAVA single loan request screen may be incorrect. So use it from G1
		/** Get G1 batch date **/
		SELECT 
			@BatchDate = CurrentBatchDate 
		FROM 
			GLOBALONE.dbo.vw_G1_System	

		SELECT 
			@BusinessInd = b.BusinessInd,
			@BrkID = b.BrkID,
			@BrkGrpID	= bg.BrkGrpID, 
			@BrkCrGrpID = bg.BrkCrGrpID
		FROM
			dbo.Broker b
		INNER JOIN 
			dbo.BrokerGroup bg
		ON
			bg.BrkGrpID = b.BrkGrpID and
			b.EffectiveDateBegin BETWEEN bg.EffectiveDateBegin AND bg.EffectiveDateEnd AND
			ISNULL(b.IsDeleted,0) = 0
		WHERE
			BrkNbr = @BrkNbr AND
			@BatchDate BETWEEN b.EffectiveDateBegin AND b.EffectiveDateEnd AND 
			ISNULL(b.IsDeleted,0) = 0

		

		--- WL ETI accepts only CUSIP
		SELECT 
			@SecCode = CUSIP,
			@SmSecType = SecType 
		FROM
			GLOBALONE.dbo.vw_G1_Security
		WHERE 
			SecID = @SecId

		IF (@SecCode IS NULL OR @SecCode = '')
		BEGIN
			RAISERROR('This Security cannot be loaned because CUSIP does not exist', 16, 1)
			RETURN 1
		END
	
		/* Set @IsLoanBreak flag based on SecType and FaceAmount in case of Bulk Loan booking*/
		IF ((@SQL_IDENTIFIER = 'BULKLOAN') AND (@SmSecType = '0' OR @SmSecType = '2' OR @SmSecType = '6') AND @Quantity > @MaxLoanAmount)
		BEGIN
			SET @IsLoanBreak = 1
		END
	
		SELECT @G1UserCode = dbo.f_GetG1LavaUserMapping (@ModifiedBy)
		
		/* Set default values to be inserted*/
		SELECT	
			@ModifiedDate		= GETDATE(),
			@RecordIndicator	= 'DTL',
			@TOE				= 'TSL',
			@ModifiedBy			= ISNULL(@ModifiedBy, SUSER_SNAME())
		
		
		/* Get the status id for Return Loan upload schedule*/
		IF(ISNULL(@StatusID , 0 ) = 0)
			SET @StatusId = 40--dbo.f_GetETIProcessFlowStatus (@RecordTypeID, 'Verified')
			
		TRUNCATE TABLE #BrkTbl
		TRUNCATE TABLE #AcctTbl
		TRUNCATE TABLE #TempAcctTbl

		/* Get BrkId based on BrkNbr*/
		IF @BrkNbr IS NOT NULL
		BEGIN
			INSERT INTO #BrkTbl 
			(
				BrkId,
				BrkNbr
			)
			SELECT 
				BrkID,
				BrkNbr
			FROM 
				dbo.[Broker] 
			WHERE 
				BrkNbr = @BrkNbr AND 
				@BatchDate BETWEEN EffectiveDateBegin AND EffectiveDateEnd AND 
				ISNULL(IsDeleted,0) = 0
		END

		/* If no record found in Broker table for selected loan, then do not proceed further*/
		IF ((SELECT COUNT(*) FROM #BrkTbl) = 0)
		BEGIN
			RAISERROR('Invalid broker.', 16, 1)
			RETURN 1
		END
		
		/* Get all the accounts */
		INSERT INTO #AcctTbl 
		(
			SecID,			
			AcctId,			
			AcctNbr,
			BrkNbr,
			FaceAmountFromAlloc,
			FaceAmountActual,
			AvailRestOverriden,
			IsProcessed,
			AllocationChangeReason
		)
		SELECT DISTINCT 
			temp.SecID,	
			temp.AcctId,		
			temp.Acctnbr,
			temp.BrkNbr,
			temp.FaceAmountFromAlloc,
			temp.FaceAmountActual,
			temp.AvailRestOverriden,
			0, --IsProcessed
			AllocationChangeReason
		FROM 
			@TempXMLTable temp						
		WHERE	
			BrkNbr = @BrkNbr AND
			SecID = @SecId  
		ORDER BY 
			temp.FaceAmountActual DESC
		
		SET @RemFaceAmount = 0

--select * from #AcctTbl

			----Validation added for checking whether the Loan Reference Number used for UTI generation is valid-----------------------
	-----------i.e. Same Security, Broker, FaceAmount, Principal, Dates. Also it is not Pending/Outstanding trade--------------
	-----------Currently we are doing validation only in case of Single Loan booking so picking up the top record from tmp table after grouping by SecID. If we have to implement it for Bulk then we have to loop through the records in temp--------------------
------
		IF (@SQL_IDENTIFIER = 'SINGLELOAN')
		BEGIN
			-----Fetch the details for current Loan-----------------
			SELECT TOP 1
				@SFTRCancelledLoanRefNbr = SFTRCancelledLoanRefNbr,
				@CurrentLoanBrkNbr = BrkNbr, 
				@CurrentLoanSecId = SecID,	
				@CurrentLoanPrincipal = AVG(CONVERT(DECIMAL(17,2),Principal)), 
				@CurrentLoanFaceAmount = SUM(FaceAmountActual),
				@CurrentLoanSettlementDate = SettlementDate
			FROM 
				@TempXMLTable
			GROUP BY
				SFTRCancelledLoanRefNbr, BrkNbr, SecID, SettlementDate

			IF (@SFTRCancelledLoanRefNbr IS NOT NULL)
			BEGIN
			------------Fetch the details for the loan which is referred from the UI via field "LoanReferenceNumber"---------------------
			------------Apply the conditions for checking whether the loan is a Cancelled Loan and not outstanding--------------
				SELECT * INTO 
					#TempGCIErrorLog 
				FROM 
					dbo.f_GetG1ErrorMessage (0,0,'')

				SELECT
					 @RefLoanBrkNbr = Dtl.BrkNbr, 
					 @RefLoanSecId = Dtl.SecID , 
					 @RefLoanFaceAmount = ISNULL(ETICancel.FaceAmount, PLoanHist.FaceAmount), --ABS(act.FaceAmount),     -- Take FaceAmount / principal from cancelled Loan
					 @RefLoanPrincipal = ISNULL(ETICancel.Principal, PLoanHist.Principal), --act.NewPrincipal,
					 @RefLoanSentToPirum = Dtl.SendErrToPirum,
					 @RefLoanSettlementDate = ISNULL(ETICancel.SettlementDate, PLoanHist.SettlementDate)
				FROM   
					 dbo.ETIDetailRecord Dtl 
				INNER JOIN
					 #TempGCIErrorLog ErrMsg 
				ON
					  ErrMsg.RawDataID = Dtl.RawDataID  AND           
					  ErrMsg.MessageCategory = 1 -- only success
				LEFT JOIN
				(
					SELECT FaceAmount, Principal, TxnRefNbrNew, BatchDate, SettlementDate FROM ETIDetailRecord
					WHERE
						RecordTypeID IN (1) 
				) ETICancel
				ON
					ETICancel.TxnRefNbrNew = @SFTRCancelledLoanRefNbr AND
					ETICancel.BatchDate = @BatchDate
				LEFT JOIN
				(
					SELECT SUM(FaceAmount) AS FaceAmount, SUM(Principal) AS Principal, TxnRefNbr , AsOfDate, 
					CASE WHEN SettleDate IS NOT NULL THEN SettleDate ELSE RepoFromDate END AS SettlementDate FROM MOBETTER.DBO.ProcessedLoanHist
					GROUP BY TxnRefNbr, AsOfDate, SettleDate, RepoFromDate
					HAVING		
						TxnRefNbr = @SFTRCancelledLoanRefNbr AND
						AsOfDate = dbo.f_GetPrevBizDay(@BatchDate)
				) PLoanHist
				ON
					PLoanHist.TxnRefNbr = @SFTRCancelledLoanRefNbr AND
					PLoanHist.AsOfDate = dbo.f_GetPrevBizDay(@BatchDate)
				WHERE         
					  Dtl.RecordTypeId = 13 AND 
					  Dtl.StatusId = 140 AND
					  --act.AcctNbr = 'OMNI' AND
					  --act.TOE = 'CSL' AND
					  Dtl.TxnRefNbr = @SFTRCancelledLoanRefNbr AND
					  Dtl.AsOfDate = @BatchDate    -----------Get the Loans cancelled on same business day

				DROP TABLE #TempGCIErrorLog

				------------If above query does not return any record means, the Loan is a Future/Pending/Outstanding-----------------------
				IF (@RefLoanBrkNbr IS NULL)
				BEGIN
					SET @blnValidLoanRefNbr = 0
					SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Loan should not be Outstanding/Pending/Future.'
					RAISERROR(@InValidLoanRefNbrMessage, 16, 1)
					RETURN 1
				END
				ELSE
				BEGIN
					IF (@RefLoanBrkNbr IS NULL OR @CurrentLoanBrkNbr != @RefLoanBrkNbr)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Broker of the current loan should match the Broker of the referenced loan.'
					END
				
					IF (@RefLoanSecId IS NULL OR @CurrentLoanSecId != @RefLoanSecId)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Security of the current loan should match the Security of the referenced loan.'
					END

					IF (@RefLoanPrincipal IS NULL OR @CurrentLoanPrincipal != @RefLoanPrincipal)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Principal of the current loan should match the Principal of the referenced loan.'
					END

					IF (@RefLoanFaceAmount IS NULL OR @CurrentLoanFaceAmount != @RefLoanFaceAmount)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Quantity of the current loan should match the Quantity of the referenced loan.'
					END

					----------------------------Check for "Sent To Pirum" flag condition. If True then LoanRefNbr cant be used-----------------------
					IF (@RefLoanSentToPirum = 1)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Sent To Pirum should be "No" for Cancelled Loan.'
					END

					IF (@RefLoanSettlementDate IS NULL OR @CurrentLoanSettlementDate != @RefLoanSettlementDate)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Settlement Date of the current loan should match the Settlement Date of the referenced loan.'
					END

					----------------------------Check for Allocation of Cancelled Loan and New Loan(Current Loan). If same then CancelledLoanRefNbr can be used-----------------------
					----------------------------Insert the allocation details of Cancelled Loan ref Number into temp table-----------------------
					INSERT INTO
						#AllocationCancelledLoan
					(
						AcctNbr,
						BrkNbr,
						FaceAmount,
						AllocationMatched
					)
					SELECT
						ISNULL(ETICancel.AcctNbr, PLoanHist.AcctNbr),
						ISNULL(ETICancel.BrkNbr, PLoanHist.BrkNbr),
						ISNULL(ETICancel.FaceAmount, PLoanHist.FaceAmount),
						0
					FROM
						ETIDetailRecord eti
					LEFT JOIN
						(
							SELECT AcctNbr, BrkNbr, FaceAmount, TxnRefNbrNew, BatchDate FROM ETIDetailRecord
							WHERE
								RecordTypeID IN (2) 
						) ETICancel
						ON
							ETICancel.TxnRefNbrNew = @SFTRCancelledLoanRefNbr AND
							ETICancel.BatchDate = @BatchDate
					LEFT JOIN
						(
							SELECT AcctNbr, BrkNbr, FaceAmount, TxnRefNbr, AsOfDate FROM MOBETTER.DBO.ProcessedLoanHist
							WHERE TxnRefNbr = @SFTRCancelledLoanRefNbr AND
								  AsOfDate = dbo.f_GetPrevBizDay(@BatchDate)
						) PLoanHist
					ON
						PLoanHist.TxnRefNbr = @SFTRCancelledLoanRefNbr AND
						PLoanHist.AsOfDate = dbo.f_GetPrevBizDay(@BatchDate)
					WHERE
						 eti.RecordTypeID IN (13) AND	-- Allocation from Cancelled loan for current business date					 
					     eti.TxnRefNbr = @SFTRCancelledLoanRefNbr AND
						 eti.BatchDate = @BatchDate

					---------------------------Compare details of Cancelled Loan ref Number and Current Loan and update the "AllocationMatched" flag accordingly-----------------------

					UPDATE
						AL
					SET
						AL.AcctGrpID = A.AcctGrpID
					FROM
						#AcctTbl AL
					INNER JOIN
						MOBETTER.dbo.Account A
					ON
						AL.AcctNbr = A.AcctNbr
					WHERE
						A.IsDeleted = 0 AND
						A.EffectiveDateEnd = '12/31/9999'

					UPDATE
						ACL
					SET
						ACL.AcctGrpID = A.AcctGrpID
					FROM
						#AllocationCancelledLoan ACL
					INNER JOIN
						MOBETTER.dbo.Account A
					ON
						ACL.AcctNbr = A.AcctNbr
					WHERE
						A.IsDeleted = 0 AND
						A.EffectiveDateEnd = '12/31/9999'

                    -- Check Total Quantity of Cancelled Loan with Loan Reference total quanties within the Principal (Account Group)
					UPDATE
						ACL
					SET
						AllocationMatched = CASE WHEN ABS(ACLPrincipal.FaceAmount) =  ABS(ALPrincipal.FaceAmount) THEN 1 ELSE 0 END
					FROM
						#AllocationCancelledLoan ACL
					INNER JOIN
					(
					    SELECT AcctGrpID , SUM(FaceAmount) AS FaceAmount FROM	#AllocationCancelledLoan
						GROUP BY AcctGrpID
					) AS ACLPrincipal
					ON
						ACL.AcctGrpID = ACLPrincipal.AcctGrpID
					INNER JOIN
					(
					    SELECT AcctGrpID , SUM(FaceAmountActual) AS FaceAmount FROM	#AcctTbl
						GROUP BY AcctGrpID
					) AS ALPrincipal
					ON
						ACL.AcctGrpID = ALPrincipal.AcctGrpID

					-- Check if Principal (AccountGroup) matches for Cancelled & Current Loan.
					UPDATE
						ACL
					SET
						AllocationMatched = 0
					FROM
						#AllocationCancelledLoan ACL
					WHERE
						 AcctGrpID NOT IN ( SELECT DISTINCT AcctGrpID FROM #AcctTbl WHERE FaceAmountActual > 0 )

					IF EXISTS(SELECT 1 FROM #AllocationCancelledLoan WHERE AllocationMatched = 0)
					BEGIN
						SET @blnValidLoanRefNbr = 0
						SET @InValidLoanRefNbrMessage = 'Please enter valid Loan Reference Number for UTI generation. Total allocated quantity for current Loan should match with the total Quantity for the reference loan within the same principal (Account Group).'
					END

					IF (@blnValidLoanRefNbr = 0)
					BEGIN
						RAISERROR(@InValidLoanRefNbrMessage, 16, 1)
						RETURN 1
					END
				END
			END
		END

		IF 
		(
			@IsLoanBreak = 1 --AND 
			--((SELECT COUNT(*) FROM #AcctTbl WHERE FaceAmount = 0) > 0) --AND
--			((SELECT SUM(FaceAmount) FROM #AcctTbl WHERE FaceAmount = 0) > @MaxLoanAmount)
		)
		BEGIN
			SET @RowCount  = 1
			SET @AcctCount = 1
			SELECT @TotalAcctCount = MAX(RowId) FROM #AcctTbl WHERE secID = @SecId AND FaceAmountActual > 0 --COUNT(*) FROM #AcctTbl
			
			WHILE (@AcctCount <= @TotalAcctCount OR ((SELECT COUNT(*) FROM #AcctTbl WHERE IsProcessed = 0  AND secID = @SecId AND FaceAmountActual > 0) > 0))
			BEGIN

				SET @NeedFaceAmount = @MaxLoanAmount	
				SET @RemFaceAmount = 0
				SET @AcctFaceAmountSum = 0

				SELECT TOP 1 
						@Acctnbr = Acctnbr, 
						@AcctId = AcctId ,
						@TempFaceAmount = FaceAmountActual,
						@TempFaceAmountFromAlloc = FaceAmountFromAlloc, 
						@TempAvailRestOverriden = AvailRestOverriden,
						@AllocationChangeReason = AllocationChangeReason
				FROM 
					#AcctTbl 
				WHERE 
					IsProcessed = 0 AND 
					secID = @SecId AND 
					FaceAmountActual > 0 
				ORDER BY 
					Acctnbr


				WHILE (@NeedFaceAmount > 0  AND ISNULL(@AcctFaceAmountSum,0) < @MaxLoanAmount AND ((SELECT COUNT(*) FROM #AcctTbl WHERE IsProcessed = 0 AND secID = @SecId AND FaceAmountActual > 0) > 0))
				BEGIN
					SELECT @AcctFaceAmountSum = SUM(FaceAmountActual) FROM #TempAcctTbl WHERE LoanNbr = @RowCount  AND secID = @SecId  

					IF (@TempFaceAmount > @MaxLoanAmount AND ISNULL(@AcctFaceAmountSum,0) = 0)
					BEGIN
						INSERT INTO #TempAcctTbl (AcctId,secID,AcctNbr,BrkNbr,FaceAmountFromAlloc,FaceAmountActual,AvailRestOverriden,LoanNbr,IsProcessed,AllocationChangeReason)
						VALUES (@AcctId,@SecId,@Acctnbr,@BrkNbr,@TempFaceAmountFromAlloc,@MaxLoanAmount,@TempAvailRestOverriden,@RowCount,0,@AllocationChangeReason)

						UPDATE #AcctTbl SET IsProcessed = 1 WHERE Acctnbr = @Acctnbr AND secID = @SecId
						SET @RemFaceAmount = @TempFaceAmount - @MaxLoanAmount--0

						INSERT INTO #AcctTbl (AcctId,secID,AcctNbr,BrkNbr,FaceAmountFromAlloc,FaceAmountActual,AvailRestOverriden,IsProcessed,AllocationChangeReason)
						VALUES (@AcctId,@SecId,@Acctnbr,@BrkNbr,@TempFaceAmountFromAlloc,@RemFaceAmount,@TempAvailRestOverriden,0,@AllocationChangeReason)
					END
					ELSE 
					BEGIN
						IF ((ISNULL(@AcctFaceAmountSum,0) + @TempFaceAmount) > @MaxLoanAmount)
						BEGIN
							INSERT INTO #TempAcctTbl (AcctId,secID,AcctNbr,BrkNbr,FaceAmountFromAlloc,FaceAmountActual,AvailRestOverriden,LoanNbr,IsProcessed,AllocationChangeReason)
							VALUES (@AcctId,@SecId,@Acctnbr,@BrkNbr,@TempFaceAmountFromAlloc,
								CASE WHEN @TempFaceAmount < @NeedFaceAmount THEN @TempFaceAmount ELSE @NeedFaceAmount END ,@TempAvailRestOverriden,@RowCount,0,@AllocationChangeReason)

							SET @RemFaceAmount = @TempFaceAmount - @NeedFaceAmount
							UPDATE #AcctTbl SET IsProcessed = 1 WHERE Acctnbr = @Acctnbr  AND secID = @SecId

							INSERT INTO #AcctTbl (AcctId,secID,AcctNbr,BrkNbr,FaceAmountFromAlloc,FaceAmountActual,AvailRestOverriden,IsProcessed,AllocationChangeReason)
							VALUES (@AcctId,@SecId,@Acctnbr,@BrkNbr,@TempFaceAmountFromAlloc,@RemFaceAmount,@TempAvailRestOverriden,0,@AllocationChangeReason)
						END
						ELSE
						BEGIN
							INSERT INTO #TempAcctTbl (AcctId,secID,AcctNbr,BrkNbr,FaceAmountFromAlloc,FaceAmountActual,AvailRestOverriden,LoanNbr,IsProcessed,AllocationChangeReason)
							VALUES (@AcctId,@SecId,@Acctnbr,@BrkNbr,@TempFaceAmountFromAlloc,@TempFaceAmount,@TempAvailRestOverriden,@RowCount,0,@AllocationChangeReason)

							UPDATE #AcctTbl SET IsProcessed = 1 WHERE Acctnbr = @Acctnbr  AND secID = @SecId
							SET @RemFaceAmount = 0
						END
					END -- END OF IF(@TempFaceAmount > @MaxLoanAmount AND ISNULL(@AcctFaceAmountSum,0) = 0)

					SELECT 
						@AcctFaceAmountSum = SUM(FaceAmountActual) 
					FROM 
						#TempAcctTbl 
					WHERE 
						LoanNbr = @RowCount  AND 
						secID = @SecId

					SET @NeedFaceAmount = 
								CASE WHEN (@NeedFaceAmount - ISNULL(@AcctFaceAmountSum,0)) > 0 THEN (@NeedFaceAmount - ISNULL(@AcctFaceAmountSum,0) )
									ELSE ( CASE WHEN (ISNULL(@AcctFaceAmountSum,0) - @NeedFaceAmount) = 0 THEN @MaxLoanAmount - @NeedFaceAmount ELSE   (ISNULL(@AcctFaceAmountSum,0) - @NeedFaceAmount) END)
								END

					SELECT TOP 1 
							@Acctnbr = Acctnbr ,
							@TempFaceAmount = FaceAmountActual,
							@TempFaceAmountFromAlloc = FaceAmountFromAlloc, 
							@TempAvailRestOverriden = AvailRestOverriden,
							@AllocationChangeReason = AllocationChangeReason
					FROM 
						#AcctTbl 
					WHERE  
						IsProcessed = 0  AND 
						secID = @SecId AND 
						FaceAmountActual > 0 
					ORDER BY 
						Acctnbr

				END  -- END of WHILE (@NeedFaceAmount > 0  AND ISNULL(@AcctFaceAmountSum,0) < @MaxLoanAmount AND ((SELECT COUNT(*) FROM #AcctTbl WHERE IsProcessed = 0 AND secID = @SecId) > 0))
				SET @RowCount = @RowCount + 1

				SELECT @AcctCount = MIN(rowid) FROM #AcctTbl WHERE IsProcessed = 0  AND secID = @SecId AND FaceAmountActual > 0 --@AcctCount + 1
			END  --END of WHILE (@AcctCount <= @TotalAcctCount OR ((SELECT COUNT(*) FROM #AcctTbl WHERE IsProcessed = 0  AND secID = @SecId) > 0))

		END -- END of IF (@IsLoanBreak = 1)
		ELSE
		BEGIN

--		TRUNCATE TABLE #TempAcctTbl

			INSERT INTO #TempAcctTbl 
			(
				secID,				
				AcctId,
				AcctNbr,
				BrkNbr,
				FaceAmountFromAlloc,
				FaceAmountActual,
				AvailRestOverriden,
				LoanNbr,
				IsProcessed,
				AllocationChangeReason
			)
			SELECT 
				@SecId,
				AcctId,
				AcctNbr,
				BrkNbr,
				FaceAmountFromAlloc,
				FaceAmountActual,
				AvailRestOverriden,
				1, --LoanNbr default to 1 becasue only one loan per req
				0,-- IsProcessed 
				AllocationChangeReason
			FROM 
				#AcctTbl 
			WHERE 
				secID = @SecId
			ORDER BY 
				FaceAmountActual DESC
		END

--DELETE FROM #TempAcctTbl WHERE FaceAmount = 0
--
--SELECT * from #AcctTbl
--SELECT * FROM #TempAcctTbl

		/***** 1st step : Insert into dbo.ETITranUploadHistLog table ***/	
		SET @Ret = 1
/**/
		IF (@SQL_IDENTIFIER = 'SINGLELOAN')
			SET @FileName = 'Single Loan (FI) from Availability'
		ELSE IF (@SQL_IDENTIFIER = 'BULKLOAN')
			SET @FileName = 'Bulk Loan (FI) from Availability'
	
		/* If selected BrkId is not in temp HistLogTbl(more then one record could be present in the @TempXMLTable table for Return loan) 
		then insert record into ETITranUploadHistLog table for selected Broker--one entry for each broker*/
		IF ((SELECT COUNT(*) FROM @HistLogTbl WHERE BrkID = @BrkID) = 0 )
		BEGIN				
			INSERT INTO ETITranUploadHistLog
			(
				[TemplateID],
				[BrkCrGrpID],
				[BrkGrpID],
				[BrkID],
				[RecordTypeID],
				[FileName],
				[AsOfDate],
				[IsSuccess],
				[ModifiedBy],
				[ModifiedDate]
			)
			SELECT 
				DISTINCT 0,
				@BrkCrGrpID,
				@BrkGrpID,
				@BrkID,--b.BrkId,
				@RecordTypeID,
				@FileName,
				@BatchDate,
				@Ret,
				@ModifiedBy,
				@ModifiedDate

			SET @SourceID = @@IDENTITY
			SET @ERROR_NO = @@ERROR	

			/* Insert SourceId for selected brkoer in temp HistLogTbl for further processing*/
			INSERT INTO @HistLogTbl 
			(
				SourceId,
				BrkCrGrpId,
				BrkId
			)
			SELECT DISTINCT
				@SourceID,
				@BrkCrGrpId,
				@BrkID
		END
		
		/***** 2nd step : Insert into dbo.ETIRawData table ****/

		SET @HistlogCount = 1
		SELECT @TotalHistlogCount = COUNT(*) FROM @HistLogTbl

		/* Loop thru all the record which are in @HistLogTbl*/
		WHILE (@HistlogCount <= @TotalHistlogCount)
		BEGIN
			/* Insert data into ETIRawData table
			 insert only those loan which are valid. It is possible that for some loan, there is no loan information available in temp acc and loan tablesl*/
			SELECT 
				@SourceId = SourceId 
			FROM 
				@HistLogTbl 
			WHERE 
				RowId = @HistlogCount

			IF (@IsLoanBreak = 0) -- do not break in multiple loans
			BEGIN
				SELECT 
					@FaceAmount = SUM(FaceAmountActual)
				FROM 
					#TempAcctTbl
				WHERE 
					SecID = @SecId
				
				INSERT INTO dbo.ETIRawData
				(
					[SourceID],
					[SecID],
					[BrkID],
					[TxnRefNbr],
					[RecordTypeID],
					[SecLocID],
					[SecLocCode],
					[SecCode],
					[FaceAmount],
					[Price],
					[PriceOverride],
					[Principal],
					[CCYCode],
					[CollCcyCode],
					[SettlementDate],
					[TermDate],
					[BrkNbr],
					[Depository],
					[LoanType],
					[DisclosureType],
					[RebateRate],
					[BatchDate],
					[AsOfDate],
					[IsValid],
					[ErorBitMap],
					[StatusID],
					[TransmitFlg],
					[BasketNbr],
					[ModifiedBy],
					[ModifiedDate]
				)
				SELECT 
					DISTINCT @SourceId,
					@SecId,
					@BrkId,
					0,-- TxnRefNbr
					@RecordTypeID,	
					NULL,
					temp.SecLocCode,
					@SecCode,
					@FaceAmount,
					temp.Price, -- Price
					NULL, -- PriceOverride
					CASE WHEN @UseAmountCheck = 1 THEN temp.Principal ELSE ROUND((@FaceAmount * temp.Price) / 100, 2, 1) END, -- Principal
					ISNULL(temp.PriceCurr, ''),
					temp.CollCCY, -- CollateralCCY
					temp.SettlementDate,
					temp.termDate,
					temp.BrkNbr,
					temp.WLDepository,
					bs.LoanType,
					temp.Disclosure,
					temp.RebateRate,
					@BatchDate,
					temp.AsOfDate,
					1, -- IsValid
					0, -- ErrorBitMap
					@StatusId,
					temp.TransmitFlg,
					temp.BasketNbr,
					temp.ModifiedBy,
					@ModifiedDate
				FROM 
					@TempXMLTable temp 
				LEFT JOIN 
					dbo.Broker b 
				ON 
					b.BrkID = @BrkID AND 
					@BatchDate BETWEEN b.EffectiveDateBegin AND b.EffectiveDateEnd
				LEFT JOIN 
					dbo.BrokerGroup bg 
				ON
					b.BrkGrpID = bg.BrkGrpID AND 
					@BatchDate BETWEEN bg.EffectiveDateBegin AND bg.EffectiveDateEnd
				LEFT JOIN 
					MOBETTER.dbo.BrokerCreditGroup bcg
				ON
					bg.BrkCrGrpID = bcg.BrkCrGrpID
					AND @BatchDate BETWEEN bcg.EffectiveDateBegin AND bcg.EffectiveDateEnd
				LEFT JOIN 
					MOBETTER.DBO.Broker bs 
				ON	
					bs.BrkID = @BrkID AND
					@BatchDate BETWEEN bs.EffectiveDateBegin AND bs.EffectiveDateEnd AND
					ISNULL(bs.IsDeleted,0) = 0
				WHERE 
					temp.FaceAmountActual > 0 AND --insert only account allocated records.
					SecID = @SecId


				SELECT @RawDataID = @@IDENTITY

				UPDATE 
					#TempAcctTbl
				SET 
					RawDataId = @RawDataID,
					SourceID = rawData.SourceID,
					BatchDate = rawData.BatchDate,
					RecordTypeID = rawData.RecordTypeID,
					AccountAllocationChanged = CASE WHEN FaceAmountFromAlloc <> FaceAmountActual THEN 1 ELSE 0 END,
					ModifiedBy = rawData.ModifiedBy,
					ModifiedDate = rawData.ModifiedDate
				FROM 
					ETIRawData rawData 
				WHERE 
					rawData.SourceID = @SourceId AND
					rawData.SecID = @SecId

				/***** 3rd step : Insert into dbo.ETIAllocation table ****/
				INSERT INTO dbo.ETIAllocation
				(
					[RawDataID],
					[SourceID],
					[SecID],
					[BrkID],
					[AcctId],
					[AcctNbr],
					[RecordTypeID],
					[SecLocID],
					[SecCode],
					[FaceAmount],
					[Price],
					[Principal],
					[CCYCode],
					[CollCCYCode],
					[SettlementDate],
					[BrkNbr],
					[SecLocCode],
					[Depository],
					[LoanType],
					[RebateRate],
					[TxnRefNbr],
					[StatusID]
				)
				SELECT	
					DISTINCT rd.ID,
						rd.SourceID,
						rd.SecId,
						rd.BrkID,
						acc.AcctId,
						acc.AcctNbr,
						(@RecordTypeID + 1),
						NULL,
						rd.SecCode,
						acc.FaceAmountActual,
						CASE WHEN rd.PriceOverride IS NOT NULL THEN rd.PriceOverride ELSE rd.Price END,
						CASE WHEN @UseAmountCheck = 1 THEN rd.Principal ELSE ROUND((acc.FaceAmountActual * rd.Price) / 100, 2, 1) END, -- Principal
						rd.CCYCode,
						rd.CollCCYCode,
						rd.SettlementDate,
						rd.BrkNbr,
						rd.SecLocCode,
						rd.Depository,
						rd.LoanType,
						rd.RebateRate,
						0,--a.TxnRefNbr,
						@StatusId
				FROM 
					dbo.ETIRawData rd 
				INNER JOIN   
					#TempAcctTbl acc 
				ON 
					acc.SecID = rd.SecId AND
					acc.BrkNbr = rd.BrkNbr AND
					acc.FaceAmountActual > 0 
				INNER JOIN 
					@HistLogTbl hist 
				ON 
					hist.SourceID = rd.SourceID AND
					hist.BrkId = rd.BrkId
				WHERE 
					acc.FaceAmountActual > 0 AND --insert only account allocated records.
					acc.SecID = @SecId AND
					((@IsRevRepoLoan = 0) OR ((@IsRevRepoLoan = 1) AND (rd.ID = @RawDataID))) ------This condition is added for Reverse Repo, Duplicate entries were getting inserted in ETIAllocation table
																						      -------- because SecID and BRkNbr is same for all the Loans booked for 1 RRLinkRefNbr
				
			END -- end of IF (@IsLoanBreak = 0)
			ELSE
			BEGIN -- this loop will break loan in 50 mln chunk
				SELECT @AcctCount = MIN(LoanNbr) FROM #TempAcctTbl WHERE SecID = @SecId
				SELECT @TotalAcctCount = MAX(LoanNbr) FROM #TempAcctTbl WHERE SecID = @SecId--COUNT(*) FROM #TempAcctTbl

				SELECT @MaxLoanNbr = MAX(LoanNbr) FROM #TempAcctTbl

				-- if UseAmountCheck is checked then principal should be inserted based on FaceAmount of each loan.
				IF (@UseAmountCheck = 1)
				BEGIN
					WHILE (@AcctCount <= @TotalAcctCount)
					BEGIN
						SELECT TOP 1 
							@LoanNbr = LoanNbr 
						FROM 
							#TempAcctTbl
						WHERE
							IsProcessed = 0 AND 
							SecID = @SecId 
						ORDER BY
							LoanNbr						

						SELECT 
							@FaceAmount = SUM(FaceAmountActual)
						FROM 
							#TempAcctTbl
						WHERE
							LoanNbr = @LoanNbr AND 
							SecID = @SecId 																

						-- Calculate the sum of FaceAmount
						SELECT 
							@TempFaceAmountSum = SUM(FaceAmountActual) 
						FROM 
							#TempAcctTbl 
						WHERE 
							SecID = @SecId

						-- Read the total principal from @TempXMLTable 
						SELECT 
							TOP 1 @TempPrincipalSum  = Principal 
						FROM 
							@TempXMLTable 
						WHERE 
							SecID = @SecId AND 
							FaceAmountActual > 0 

						-- Calculate Price based on the Principal and FaceAmount
						SELECT 
							@TempPrice = (@TempPrincipalSum / @TempFaceAmountSum) * 100

						-- for 50mln loans, calculate price nearest to 1/8 and principal based on the new price
						IF (@LoanNbr < @MaxLoanNbr)
						BEGIN

							SET @TempPrice = ROUND(@TempPrice / 0.125,0) * 0.125 -- to get the nearest 1/8

							UPDATE 
								#TempAcctTbl 
							SET 
								Price = @TempPrice, 
								Principal = (@TempPrice* @FaceAmount)  / 100 
							WHERE 
								LoanNbr = @LoanNbr AND 
								SecID = @SecId --AND @FaceAmount = @MaxLoanAmount
						END
						ELSE -- for remaining Faceamount loan, use price and principal as (total principal - sum of principal of 50 mln loans)
						BEGIN

							SELECT 
								@TempPrincipal50MlnSum = SUM(Principal) 
							FROM 
								#TempAcctTbl 
							WHERE 
								SecID = @SecId AND 
								--FaceAmountActual = @MaxLoanAmount
								LoanNbr <> @LoanNbr

							UPDATE 
								#TempAcctTbl 
							SET 
								Price = ((@TempPrincipalSum - @TempPrincipal50MlnSum) / @FaceAmount) * 100, 
								Principal = @TempPrincipalSum - @TempPrincipal50MlnSum
							WHERE 
								LoanNbr = @LoanNbr AND 
								SecID = @SecId 
						END

						UPDATE 
							#TempAcctTbl
						SET 
							IsProcessed = 1
						WHERE 
							LoanNbr = @LoanNbr  AND
							SecID = @SecId

						SELECT @TotalAcctCount = MIN(LoanNbr) FROM #TempAcctTbl WHERE IsProcessed = 0 AND SecID = @SecId

						--SET @AcctCount = @AcctCount + 1
					END -- end of WHILE (@AcctCount <= @TotalAcctCount)		
				END -- end of IF (@UseAmountCheck = 1)

				UPDATE 
					#TempAcctTbl
				SET 
					IsProcessed = 0

				SELECT @AcctCount = MIN(LoanNbr) FROM #TempAcctTbl WHERE SecID = @SecId
				SELECT @TotalAcctCount = MAX(LoanNbr) FROM #TempAcctTbl WHERE SecID = @SecId--COUNT(*) FROM #TempAcctTbl

				WHILE (@AcctCount <= @TotalAcctCount)
				BEGIN

					SELECT TOP 1 
						@LoanNbr = LoanNbr 
					FROM 
						#TempAcctTbl
					WHERE
						IsProcessed = 0 AND 
						SecID = @SecId 
					ORDER BY
						LoanNbr
			
					SELECT 
						@FaceAmount = SUM(FaceAmountActual),
						@TempPrice = MIN(Price),
						@TempPrincipal = MIN(Principal)
					FROM 
						#TempAcctTbl
					WHERE
						LoanNbr = @LoanNbr AND 
						SecID = @SecId 

					IF @FaceAmount > 0
					BEGIN
					
						INSERT INTO dbo.ETIRawData
						(
							[SourceID],
							[SecID],
							[BrkID],
							[TxnRefNbr],
							[RecordTypeID],
							[SecLocID],
							[SecLocCode],
							[SecCode],
							[FaceAmount],
							[Price],
							[PriceOverride],
							[Principal],
							[CCYCode],
							[CollCcyCode],
							[SettlementDate],
							[TermDate],
							[BrkNbr],
							[Depository],
							[LoanType],
							[DisclosureType],
							[RebateRate],
							[BatchDate],
							[AsOfDate],
							[IsValid],
							[ErorBitMap],
							[StatusID],
							[TransmitFlg],
							[BasketNbr],
							[ModifiedBy],
							[ModifiedDate]
						)
						SELECT 
							DISTINCT @SourceId,
							@SecId,
							@BrkId,
							0,-- TxnRefNbr
							@RecordTypeID,	
							NULL,
							temp.SecLocCode,
							@SecCode,
							@FaceAmount,
							CASE WHEN @UseAmountCheck = 1 THEN @TempPrice ELSE temp.Price END, -- Price
							NULL, -- PriceOverride
