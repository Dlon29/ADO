        /// <summary>
        /// Validate While uploading New Repo Request from Excel
        /// </summary>
        /// <returns></returns>
        private bool ValidateUploadNewRepoRequest()  // False error
        {
            _show_error_row = _ErrorInfoNone;
            _ErrorString = new StringBuilder("");
            bool IsValid = true;
            DataSet objDS = new DataSet();
            string clientName = string.Empty;
            MethodName = "ValidateUploadNewRepoRequest()";
            int NoOfSheets;
            DataTable DT = new DataTable("repoData");
            bool isRepoAck = false;
            string deleteFile = string.Empty;

            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.RepoUploadSheetNbr.ToString());
            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.Customer.ToString());
            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.AccountNbr.ToString());
            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.Trade_Date.ToString());
            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.Start_Date.ToString());
            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.End_Date.ToString());
            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.SecCategory.ToString());
            DT.Columns.Add(enumRepoColumnsNameFromUploadTemplate.Security_ISIN.ToString());
