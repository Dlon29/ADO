                    // then all should get excluded from the screen....
                    DataTable dt = ViewState["SaleData"] as DataTable;
                    if (dt.Select(string.Format("[SecID] = '{0}' and [RecallStatus] = '{1}'", SecID, 2)).ToList<DataRow>().Count > 0)
                    {
                        chkCreateRecall.Checked = false;
                        chkExcludeRecall.Checked = true;
                    }


