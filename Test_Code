        private void SendMQNotification(string localfilePath, string filename)       //SN changed to include local path in name..
        {
            //initialize logger interface            
            log.Info(" Start sending MQ notification.");
            StringBuilder sb = new StringBuilder();


//            string filePrefix = filePath.Substring(filePath.LastIndexOf('\\') + 1);
            string filePrefix = filename.Substring(filename.LastIndexOf('\\') + 1);
            filePrefix = filePrefix.Substring(0, filePrefix.IndexOf('_')).ToUpper();

            string HostName = appConfig.AppSettings.Settings["HostName"].Value;
            int Port = Convert.ToInt32(appConfig.AppSettings.Settings["Port"].Value);
            string UserName = appConfig.AppSettings.Settings["UserName"].Value;
            string PassWord = appConfig.AppSettings.Settings["PassWord"].Value;
            string vHost = appConfig.AppSettings.Settings["vHost"].Value;
            string ExchangeName = appConfig.AppSettings.Settings["ExchangeName"].Value;
            string HeartBeatInterval = appConfig.AppSettings.Settings["HeartBeatInterval"].Value;

            Dictionary<string, string> values = new Dictionary<string, string>();

            values.Add("Publisher", Environment.MachineName);
//            values.Add("MQBus", appConfig.AppSettings.Settings["MQBus"].Value);       //SN changed to remove MQBus appsetting..
            values.Add("MQBus", HostName + ":" + appConfig.AppSettings.Settings["Port"].Value);
            values.Add("TransferType", "SFTP");
            //values.Add("FileToTransfer", filePath.Substring(filePath.LastIndexOf('\\') + 1));
            values.Add("FileToTransfer", filename.Substring(filename.LastIndexOf('\\') + 1));   //if contains slashes in filename (should not contain).
            values.Add("RemoteFolder", localfilePath);      //New Queue member SN added.

            QueueName = (filePrefix != "ERPA-NO") ? appConfig.AppSettings.Settings["QueueName1"].Value : appConfig.AppSettings.Settings["QueueName2"].Value;
            QueueKey = (filePrefix != "ERPA-NO") ? appConfig.AppSettings.Settings["QueueKey1"].Value : appConfig.AppSettings.Settings["QueueKey2"].Value;
            log.DebugFormat(" FilePrefix : {0} , QueueName : {1} , QueueKey : {2} ", filePrefix, QueueName, QueueKey);
            
            try
            {
                sb.Append(JsonConvert.SerializeObject(values));
                //sb.Append(JSON.Instance.ToJSON(values));
            }
            catch (Exception e)
            {

                log.FatalFormat(" FOR EquilendDMZ_Pub Service on {0}.Failed to Serialize JSON object {1} for the following reason {2} ", e, Environment.MachineName, values.ToString(), e.Message);               
                //throw e;
            }

            try
            {
                ConnectionFactory connectionFactory = new ConnectionFactory()
                {
                    HostName = HostName,
                    Port = Port,
                    UserName = UserName,
                    Password = PassWord,
                    VirtualHost = vHost,
                    RequestedHeartbeat = ushort.Parse(HeartBeatInterval)
                };

                using (IConnection conn = connectionFactory.CreateConnection())
                {
                    using (IModel ch = conn.CreateModel())
                    {
                        //declare exchange
                        ch.ExchangeDeclare(ExchangeName, ExchangeType.Direct, true);
                        //declare queue
                        ch.QueueDeclare(QueueName, true, false, false, null);

                        ////bind to queue
                        ch.QueueBind(QueueName, ExchangeName, QueueKey); 

                        byte[] messageBodyBytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
                        IBasicProperties prop = ch.CreateBasicProperties();
                        prop.ContentType = "application/json";
                        prop.DeliveryMode = 2;
                        log.Info(" Start Publishing MQ Mesaage.");
                        ch.BasicPublish(appConfig.AppSettings.Settings["ExchangeName"].Value, QueueKey, prop, messageBodyBytes);
                        log.Info(" End Publishing MQ Message.");
                        if (ch != null && ch.IsOpen) ch.Close(200, "Goodbye");
                    }
                    if (conn != null && conn.IsOpen) conn.Close();
                }
                log.Info(" MQ Message process check successfull.");                
            }
            catch (Exception e)
            {
                log.FatalFormat(" FOR EquilendDMZ_Pub Service on {0}.Error Sending MQ Message for the following reason. {1} ", e, Environment.MachineName, e.Message);                          
                //throw e;
            }
            log.Info(" End sending MQ notification.");
        }

      
