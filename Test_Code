        public static int ValidateNumber(string numberString, int precision, int scale)
        {
            int retValue = 0;
            int decPosition = 0;
            decimal inValue = 0;
            string numStr = numberString.Replace(",", "").Trim();
            string precStr = "";
            string scalStr = "";
            try
            {
                inValue = Convert.ToDecimal(numStr);
                decPosition = numStr.IndexOf(".");

                switch (decPosition)
                {
                    case -1:			// not found		(eg 12345)
                        precStr = numStr;
                        break;
                    case 0:				// first position	(eg .12345)
                        scalStr = numStr.Substring(decPosition + 1);
                        break;
                    default:			// found with real	(eg 12345.12345)
                        precStr = numStr.Substring(0, decPosition);
                        scalStr = numStr.Substring(decPosition + 1);
                        break;
                }

                //				HttpContext.Current.Response.Write("ActualNumber<" + numStr + "><br>") ;	
                //				HttpContext.Current.Response.Write("decPosition<" + decPosition.ToString() + ">pos<br>") ;	
