                        QueryString4.Append("Javascript: PopUpWindow('" + Common.POSITIONDETAILPAGEURL + "");
                        QueryString4.Append(argsPopUpMenu);
                        QueryString4.Append("', '', '" + Common.POSITIONDETAILPOPUPWINPOSITION + "')");

                        fncCaller.Append("('show',this.id,'");
                        fncCaller.Append(argsPopUpMenu);
                        fncCaller.Append("')");

                        //lnkSecurity.Attributes.Add("onMouseOut","PopUpRightMenu('hide', this.id,'')");
                        lnkSecCode.NavigateUrl = QueryString4.ToString();

                        lnkSecCode.ToolTip = SecDesc;
                    }

                    #endregion


                    if (null != dgLoanData)
                    {
                        TextBox txtSharesToRecall = null;


                        PrevSecID = SecID;
                        LoanRecallCount++;

                        DataTable dtRecallData = ViewState["RecallData"] as DataTable;
                        Panel pnlSRSMsg = (Panel)e.Item.FindControl("pnlSRSMsg");

                        dtRecallData.DefaultView.RowFilter = "SecID = " + SecID;

                        if (LoanRecallCount == SecCount)
                        {

                            if (dtRecallData.DefaultView.ToTable().Rows.Count > 0)
                            {
                                dgLoanData.DataSource = dtRecallData;
                                dgLoanData.DataBind();


                                for (int i = 0; i < dgLoanData.Items.Count; i++)
                                {
                                    txtSharesToRecall = (TextBox)dgLoanData.Items[i].Cells[(int)dgLoanDataMapping.SharesToRecall].FindControl("txtSharesToRecall");

                                    if (txtSharesToRecall != null && IsSaleExcluded == true)
