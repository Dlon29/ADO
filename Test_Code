        public virtual void UpdateNextSectionFormulas(ref XLSheet workSheetTemplate, int rowInsertCount, int SecRow, int SecColumn, int maxCol, int rowsToUpdate)
        {
            try
            {
                for (int r = 0; r <= rowsToUpdate; r++)
                {
                    for (int d = 0; d <= maxCol; d++)
                    {
                        var formula = workSheetTemplate[SecRow + r, SecColumn + d].Formula;


                        if (!string.IsNullOrWhiteSpace(formula))
                        {


                            //Note: Get Cell position and increment it to the number of rows added above (rowInsertCount)
                            string patternRange = @"([A-Za-z])(\d{1,}($|(?=[^\d])))";//

                            Regex regRange = new Regex(patternRange);
                            foreach (Match match in regRange.Matches(formula))
                            {
                                //Get the number Part
                                int OldRLoc = Convert.ToInt32(Regex.Match(match.Value, @"\d+").Value);
                                //Increment the number part
                                //Replace the old number part with new nuumber part
                                string newLoc = match.Value.Replace(OldRLoc.ToString(), Convert.ToString(OldRLoc + rowInsertCount));
                                formula = formula.Replace(match.Value, newLoc);
                            }
                            workSheetTemplate[SecRow + r, SecColumn + d].Formula = formula;

                        }

                    }
                }
            }
            catch (Exception)
            {

                throw;
            }
        }

