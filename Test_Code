--select 'workingTbl Table  - Before Cleanup' , * from #workingTbl
					
					/** CleanUp Start : If loan request is met, then skip this step
					Qty can be increased If allocated units to account < requested units and if there are some units unused remaining in account 
					then allocate those unused units to satisfy the loan request (from high to low acc priority order) **/		

					/** Get the total units allocated to loan request **/
					SELECT @ReqTotalUnitsLended = SUM(UnitsLendable) FROM #WorkingTbl

			--		/** Get the total unused units in each account for a loan request **/
			--		SELECT @ReqUnsedUnitsInPool  = SUM(UnUsedUnits) FROM #WorkingTbl WHERE CanUseAcctForCleanUp = 1 AND PoolId = @PoolId
			--select @ReqTotalUnitsLended , @FaceAmount
