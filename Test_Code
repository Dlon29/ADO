--SELECT * FROM @PositionDetails

	--We are substracting 1 unit to leave it in inbox for Corporate Actions for EQ
	UPDATE
		@PositionDetails
	SET
		UnitsTraderLendable = UnitsTraderLendable - 1
	WHERE
		BucketSecType IN ('EQ','RI')
	
	-- Assign Broker Lendable qty to Trader Lendable qty for Accounts which are present in 'AcctClientRestriction' Table
	UPDATE
		@PositionDetails
	SET
		UnitsTraderLendable = UnitsBrokerLendable
	WHERE
		AcctNbr IN (
					SELECT 
						AcctNbr 
					FROM 
						AcctClientRestriction 
					WHERE ISNULL(IsDeleted,0) = 0 AND GETDATE() BETWEEN EffectiveDateBegin AND EffectiveDateEnd
				)
	
	-- Get Loan Details
	INSERT @LoanDetails
	(
		SecID, 
		CUSIP,
		SEDOL,
		ISIN,
		RecordDate,
		SecurityDesc1,
		SecurityDesc2,
		ISOCountry,
		TxnRefNbr,
		AcctNbr,
		FaceAmount,
		IsLnd
		--IsPendingLoan
	)
	SELECT 
		Sec.SecID, 
		Sec.CUSIP,
		Sec.SEDOL,
		Sec.ISIN,
		Sec.RecordDate,
		Sec.SecurityDesc1,
		Sec.SecurityDesc2,
		Sec.ISOCountry + ' (' + Sec.CountryName + ')' ISOCountry,
		TxnRefNbr = CONVERT(VARCHAR, G1Loan.TxnRefNbr),
		G1Loan.AcctNbr,
		G1Loan.FaceAmount,
		IsLnd = CASE G1Loan.FinderNbr WHEN '000LDN' THEN 1 ELSE 0 END
		--IsPendingLoan = 0
	FROM 
		#TempSecurity Sec	
	INNER JOIN 
		GLOBALONE.dbo.Loan G1Loan
	ON
		G1Loan.SecID = Sec.SecID AND
		G1Loan.IsStreetSide = 0 AND
		G1Loan.TxnType = 'L'
	UNION -- join FutureSettlement (manually entered loans)
	SELECT
		Sec.SecID, 
		Sec.CUSIP,
		Sec.SEDOL,
		Sec.ISIN,
		Sec.RecordDate,
		Sec.SecurityDesc1,
		Sec.SecurityDesc2,
		Sec.ISOCountry,
		TxnRefNbr = 'N/A',
		fs.AcctNbr,
		fs.FaceAmount,
		IsLnd = CASE fs.FinderNbr WHEN '000LDN' THEN 1 ELSE 0 END
		--IsPendingLoan = 0
	FROM
		#TempSecurity Sec 
	INNER JOIN 
		MoBetter.dbo.FutureSettlementManualEntry fs	-- history data
	ON
		fs.LoanDate > @BussDate AND 
		fs.SecId = Sec.SecId AND 
		fs.IsReverseRepo = CONVERT(BIT, 0)


	-- Populate #PendingTbl with pending loans from ETI table
	EXEC dbo.p_GetData_PendingLoanDetails 'P'

	IF @@ERROR <> 0
	  RAISERROR ('Error raised in p_GetData_PendingLoanDetails', 16, 1)


	--Apply pending logic on @PositionDetails
	UPDATE 
		@PositionDetails
	SET
		UnitsTraderLendable = UnitsTraderLendable - ISNULL(PT.FaceAmount, 0),
		UnitsBrokerLendable = UnitsBrokerLendable - ISNULL(PT.FaceAmount, 0)
	FROM
		@PositionDetails PD
	LEFT JOIN
	(
		SELECT
			SecID, AcctNbr, FaceAmount = ISNULL(SUM(FaceAmount), 0)
		FROM
			#PendingTbl 
		GROUP BY 
			SecID, AcctNbr
	) PT
	ON
		PD.SecID = PT.SecID AND
		PD.AcctNbr = PT.AcctNbr


	--For FI, US vs Ldn allocation doesn't matter as only US does FI loans
	--So retain only those accounts in @PositionDetails for the selected collateral schedule
	IF (@BucketSecType = 'FI')
	BEGIN
		--Delete based on Account COllateral Schedule
		DELETE FROM 
			@PositionDetails 
		WHERE 
			ACCTNBR NOT IN (
								SELECT 
									ACCTNBR 
								FROM 
									MoBetter.dbo.AcctCollTypeSchedule 
								WHERE 
									TriPartyGrpID = @TriPartyGrpID AND 
									CollSchedID = @CollSchedID AND 
									(@BussDate BETWEEN EffectiveDateBegin AND EffectiveDateEND) AND 
									ISNULL(isDeleted, 0) = 0
							)
	END

	-- Get US and London Percent On loan
	SELECT 
		@USPercent = USPercent,
		@LndPercent = LdnPercent 
	FROM 
		AvailabilityAllocationUSLondon 
	WHERE 
		BucketSecType = @BucketSecType AND 
		(@BussDate BETWEEN EffectiveDateBegin AND EffectiveDateEND)

		   
	SELECT @LoanType = LoanType from MOBETTER.DBO.Broker 
								where BrkNbr = @BrkNbr AND
									(@BussDate BETWEEN EffectiveDateBegin AND EffectiveDateEND) AND 
									ISNULL(isDeleted, 0) = 0

	--Delete accounts based on Account Collateral Restriction
	DELETE FROM 
		@PositionDetails 
	WHERE 
		ACCTNBR IN (SELECT ACCTNBR FROM CtrAccountCollateralRestriction WHERE CollateralType = @LoanType)

	--Delete based on Broker Account Restriction
	DELETE FROM 
		@PositionDetails 
	WHERE 
		ACCTNBR IN (SELECT ACCTNBR FROM CtrBrokerAccountRestriction WHERE BrkNbr = @BrkNbr)

	--Delete based on Account COllateral Schedule
	DELETE FROM 
		@PositionDetails 
	WHERE 
		ACCTNBR NOT IN (
							SELECT 
								ACCTNBR 
							FROM 
								MoBetter.dbo.AcctCollTypeSchedule 
							WHERE 
								TriPartyGrpID = @TriPartyGrpID AND 
								CollSchedID = @CollSchedID AND 
								(@BussDate BETWEEN EffectiveDateBegin AND EffectiveDateEND) AND 
								ISNULL(isDeleted, 0) = 0
						)
	
	INSERT INTO @USVsLndAvailability
	(
		SecID,
		CUSIP,
		SEDOL,
		ISIN,
		SecCode,
		BucketSecType,
		DateEX,
		RecordDate,
		DivRate,
		SecurityDesc1,
		SecurityDesc2,
		ISOCountry,
		TickSymb,
		CcyCode,
		TotalHolding,
		Security_Maturity_Date
	)
	SELECT  
		SecID,
		CUSIP,
		SEDOL,
		ISIN,
		SecCode,
		BucketSecType,
		DateEX,
		RecordDate,--CONVERT(VARCHAR(10),ISNULL(RecordDate,''),101),
		DivRate,
		SecurityDesc1,
		SecurityDesc2,
		ISOCountry,
		TickSymb,
		CcyCode,
		ISNULL(SUM(UnitsTotal), 0),--(CASE SUM(UnitsTotal) WHEN 0 THEN 1 ELSE SUM(UnitsTotal) END)
		Security_Maturity_Date
	FROM 
		@PositionDetails
	GROUP BY 
		SeciD,
		CUSIP,
		SEDOL,
		ISIN,
		SecCode,
		BucketSecType,
		DateEX,
		RecordDate,
		DivRate,
		SecurityDesc1,
		SecurityDesc2,
		ISOCountry,
		TickSymb,
		CcyCode,
		Security_Maturity_Date

	--Obtain price (1 business day old) for security with same currency as CollCCYCode
	UPDATE
		@USVsLndAvailability
	SET
		Price = (CASE @BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END),
		FxRate = 1, --FXRate will be same for security with same currency as CollCCYCode
		PriceBaseCurrency = (CASE @BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END)
	FROM
		@USVsLndAvailability Report
	INNER JOIN	
		REFERENCE.dbo.Price Pr
	ON
		Report.SecID = Pr.SecID 
	WHERE
		Report.CCYCode = @CollCCYCode AND --Report.CCYCode = 'USD' AND
		Pr.PricingDate >= @PrevBizDay

	--Obtain price (1 business day old) for security with currency different from CollCCYCode
	UPDATE
		@USVsLndAvailability
	SET 
		Price = (( CASE @BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END )/((CASE fx.Rate WHEN 0 THEN NULL ELSE fx.Rate END) /100)),
		FxRate = ((CASE fx.Rate WHEN 0 THEN NULL ELSE fx.Rate END) /100),
		PriceBaseCurrency = (CASE @BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END) 
	FROM
		@USVsLndAvailability Report
	INNER JOIN
		REFERENCE.dbo.Price Pr
	ON
		Report.SecID = Pr.SecID 
	LEFT JOIN 
		REFERENCE.dbo.ForeignExchange fx
	ON 
		fx.CCYCode = Pr.CCYCode AND 
		fx.BaseCCYCode = @CollCCYCode AND  --fx.BaseCCYCode = 'USD' AND 
		FXDate >= @PrevBizDay
	WHERE
		Report.CCYCode <> @CollCCYCode AND --Report.CCYCode <> 'USD' AND
		Pr.PricingDate >= @PrevBizDay

	--Obtain price (2 business day old) for security with same currency as CollCCYCode
	UPDATE
		@USVsLndAvailability
	SET
		Price = (CASE @BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END),
		FxRate = 1, --FXRate will be same for security with same currency as CollCCYCode
		PriceBaseCurrency = (CASE @BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END)
	FROM
		@USVsLndAvailability Report
	INNER JOIN	
		REFERENCE.dbo.Price Pr
	ON
		Report.SecID = Pr.SecID 
	WHERE
		Report.CCYCode = @CollCCYCode AND --Report.CCYCode = 'USD' AND
		Pr.PricingDate >= @PrevOfPrevBizDay AND
		(Report.Price IS NULL OR Report.Price = 0)

	--Obtain price (2 business day old) for security with currency different from CollCCYCode
	UPDATE
		@USVsLndAvailability
	SET 
		Price = (( CASE @BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END )/((CASE fx.Rate WHEN 0 THEN NULL ELSE fx.Rate END) /100)),
		FxRate = ((CASE fx.Rate WHEN 0 THEN NULL ELSE fx.Rate END) /100),
		PriceBaseCurrency = (CASE @BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END)
	FROM
		@USVsLndAvailability Report
	INNER JOIN
		REFERENCE.dbo.Price Pr
	ON
		Report.SecID = Pr.SecID 
	LEFT JOIN 
		REFERENCE.dbo.ForeignExchange fx
	ON 
		fx.CCYCode = Pr.CCYCode AND 
		fx.BaseCCYCode = @CollCCYCode AND 
		FXDate >= @PrevOfPrevBizDay
	WHERE
		Report.CCYCode <> @CollCCYCode AND --Report.CCYCode <> 'USD' AND
		Pr.PricingDate >= @PrevOfPrevBizDay AND
		(Report.Price IS NULL OR Report.Price = 0)
--	END

	-- Calculate USOnLoan
	UPDATE 
		@USVsLndAvailability
	SET 
		USOnLoan = ISNULL(Loan.USOnLoan, 0)
	FROM 
		@USVsLndAvailability Position
	LEFT JOIN
		(
			SELECT 
				SecId, SUM(ISNULL(FaceAmount, 0)) USOnLoan 
			FROM 
				@LoanDetails 
			WHERE 
				IsLnd = 0 
			GROUP BY SecId
		) Loan
	ON
		Position.SecId = Loan.SecId 

	-- Apply pending logic on USOnLoan
	UPDATE 
		@USVsLndAvailability
	SET 
		USOnLoan = USOnLoan + ISNULL(FaceAmount, 0)
	FROM 
		@USVsLndAvailability Position
	LEFT JOIN
	(
		SELECT
			SecID, FaceAmount = ISNULL(SUM(FaceAmount), 0)
		FROM
			#PendingTbl 
		WHERE
			FinderNbr = ''
		GROUP BY 
			SecID
	) PT
	ON
		Position.SecID = PT.SecID


	-- Calculate LdnOnLoan
	UPDATE 
		@USVsLndAvailability
	SET 
		LdnOnLoan = ISNULL(Loan.LdnOnLoan, 0)
	FROM 
		@USVsLndAvailability Position
	LEFT JOIN
		(SELECT 
			SecId,SUM(ISNULL(FaceAmount, 0)) LdnOnLoan 
		FROM 
			@LoanDetails 
		WHERE 
			IsLnd = 1 
		GROUP BY 
			SecId
		) Loan
	ON
		Position.SecId = Loan.SecId 

	-- Apply pending logic on LdnOnLoan
	UPDATE 
		@USVsLndAvailability
	SET 
		LdnOnLoan = LdnOnLoan + ISNULL(FaceAmount, 0)
	FROM 
		@USVsLndAvailability Position
	LEFT JOIN
	(
		SELECT
			SecID, FaceAmount = ISNULL(SUM(FaceAmount), 0)
		FROM
			#PendingTbl 
		WHERE
			FinderNbr = '000LDN'
		GROUP BY 
			SecID
	) PT
	ON
		Position.SecID = PT.SecID


	-- Calculate USTraderLendable,LdnTraderLendable
	UPDATE 
		@USVsLndAvailability
	SET 
		--USTraderLendable = ROUND((TotalHolding * @USPercent) - USOnLoan, 0),
		USTraderLendable =  ROUND(((((USOnLoan + LdnOnLoan) + ISNULL(UnitsTraderLendable,0)) * @USPercent) - USOnLoan),0),
		--LdnTraderLendable = ROUND((TotalHolding * @LndPercent) - LdnOnLoan, 0)
		LdnTraderLendable =  ROUND(((((USOnLoan + LdnOnLoan) + ISNULL(UnitsTraderLendable,0)) * @LndPercent) - LdnOnLoan),0)
	FROM 
		@USVsLndAvailability Loan
	INNER JOIN
		(SELECT SecId, SUM(UnitsTraderLendable) UnitsTraderLendable FROM @PositionDetails GROUP BY SecId) Position
	ON
		Position.SecId = Loan.SecId

		
	-- Calculate USBrokerLendable,LdnBrokerLendable
	UPDATE 
		@USVsLndAvailability
	SET 
		USBrokerLendable =  ROUND(((((USOnLoan + LdnOnLoan) + ISNULL(UnitsBrokerLendable,0)) * @USPercent) - USOnLoan),0),
		LdnBrokerLendable =  ROUND(((((USOnLoan + LdnOnLoan) + ISNULL(UnitsBrokerLendable,0)) * @LndPercent) - LdnOnLoan),0)
	FROM 
		@USVsLndAvailability Loan
	INNER JOIN
		(SELECT SecId, SUM(UnitsBrokerLendable) UnitsBrokerLendable FROM @PositionDetails GROUP BY SecId) Position
	ON
		Position.SecId = Loan.SecId

	-- Calculate TotalOnLoan,TotalTraderLendable,TotalBrokerLendable
	UPDATE 
		@USVsLndAvailability
	SET  
		TotalOnLoan			= USOnLoan + LdnOnLoan,
		TotalTraderLendable = USTraderLendable + LdnTraderLendable,
		TotalBrokerLendable = USBrokerLendable + LdnBrokerLendable

	-- Calculate USTraderLendable, LdnTraderLendable, USBrokerLendable, LdnBrokerLendable
	UPDATE 
		@USVsLndAvailability
	SET  
		RecordDate			= ISNULL(RecordDate, ''),
		DateEx				= ISNULL(DateEx, ''),
		DivRate				= ISNULL(DivRate, 0),
		Price				= ISNULL(Price, 0),
		PriceBaseCurrency	= ISNULL(PriceBaseCurrency,0),
		FxRate				= ISNULL(FxRate,0),
		USTraderLendable	= CASE WHEN TotalTraderLendable < USTraderLendable THEN TotalTraderLendable ELSE USTraderLendable END, --Select min of US Trader Lendable and Total Trader Lendable
		LdnTraderLendable	= CASE WHEN TotalTraderLendable < LdnTraderLendable THEN TotalTraderLendable ELSE LdnTraderLendable END, --Select min of Ldn Trader Lendable and Total Trader Lendable
		USBrokerLendable	= CASE WHEN TotalBrokerLendable < USBrokerLendable THEN TotalBrokerLendable ELSE USBrokerLendable END, --Select min of US Broker Lendable and Total Broker Lendable
		LdnBrokerLendable	= CASE WHEN TotalBrokerLendable < LdnBrokerLendable THEN TotalBrokerLendable ELSE LdnBrokerLendable END --Select min of London Broker Lendable and Total Broker Lendable
	


	--Update TotalTraderLendableAfterAllRest, TotalBrokerLendableAfterAllRest
	UPDATE
		@USVsLndAvailability
	SET
		TotalTraderLendableAfterAllRest = ISNULL(UnitsTraderLendable, 0),
		TotalBrokerLendableAfterAllRest = ISNULL(UnitsBrokerLendable, 0)
	FROM 
		@USVsLndAvailability Loan
	INNER JOIN
		(SELECT SecId, SUM(UnitsTraderLendable) UnitsTraderLendable, SUM(UnitsBrokerLendable) UnitsBrokerLendable FROM @PositionDetails GROUP BY SecId) Position
	ON
		Position.SecId = Loan.SecId

	--Update UnitsAvailToLend	
	UPDATE
		@USVsLndAvailability
	SET 
		UnitsAvailToLend = CASE 
								WHEN @FinderNbr != '000LDN' and @FinderAvailOnly = 1 THEN CASE WHEN TotalTraderLendableAfterAllRest < USTraderLendable THEN TotalTraderLendableAfterAllRest ELSE USTraderLendable END
								WHEN @FinderNbr != '000LDN' and @FinderAvailOnly = 0 THEN CASE WHEN TotalTraderLendableAfterAllRest < TotalTraderLendable THEN TotalTraderLendableAfterAllRest ELSE TotalTraderLendable END
								WHEN @FinderNbr = '000LDN' and @FinderAvailOnly = 1 THEN CASE WHEN TotalTraderLendableAfterAllRest < LdnTraderLendable THEN TotalTraderLendableAfterAllRest ELSE LdnTraderLendable END
								WHEN @FinderNbr = '000LDN' and @FinderAvailOnly = 0 THEN CASE WHEN TotalTraderLendableAfterAllRest < TotalTraderLendable THEN TotalTraderLendableAfterAllRest ELSE TotalTraderLendable END
							END

	--Update UnitsAvailToLendRest	
	UPDATE
		@USVsLndAvailability
	SET 
		UnitsAvailToLendRest = CASE 
									WHEN @FinderNbr != '000LDN' and @FinderAvailOnly = 1 THEN CASE WHEN TotalBrokerLendableAfterAllRest < USBrokerLendable THEN TotalBrokerLendableAfterAllRest ELSE USBrokerLendable END
									WHEN @FinderNbr != '000LDN' and @FinderAvailOnly = 0 THEN CASE WHEN TotalBrokerLendableAfterAllRest < TotalBrokerLendable THEN TotalBrokerLendableAfterAllRest ELSE TotalBrokerLendable END
									WHEN @FinderNbr = '000LDN' and @FinderAvailOnly = 1 THEN CASE WHEN TotalBrokerLendableAfterAllRest < LdnBrokerLendable THEN TotalBrokerLendableAfterAllRest ELSE LdnBrokerLendable END
									WHEN @FinderNbr = '000LDN' and @FinderAvailOnly = 0 THEN CASE WHEN TotalBrokerLendableAfterAllRest < TotalBrokerLendable THEN TotalBrokerLendableAfterAllRest ELSE TotalBrokerLendable END
								END
	/* Update Is_FISecurity_Matured to 1 if Security maturity is within 30 days of trade date */
	
	 UPDATE @USVsLndAvailability 
	 SET 
		Is_FISecurity_Matured = CASE WHEN ( BucketSecType <> 'FI' ) 
								THEN 0 ELSE ( 
										( CASE WHEN ( DATEDIFF(dd, @BussDate, ISNULL(Security_Maturity_Date,@BussDate)) < @Maturity_Days ) THEN 1 ELSE 0 END ) ) END	
	 WHERE
		Security_Maturity_Date <> 'N/A'

	/* Update TPUID for Default Open and Default Term Loans */
	
	 UPDATE @USVsLndAvailability 
	 SET 
		Default_Open_TPUID = TPUID
	FROM
		MTMTripartyManualEntry TBL_MTMTRI
	 WHERE
		( TBL_MTMTRI.BrkNbr = @BrkNbr ) AND
		( TBL_MTMTRI.CollSchedId = @CollSchedID ) AND		
		( TBL_MTMTRI.IsDefaultOpen = 1 )

		UPDATE @USVsLndAvailability 
	 SET 
		Default_Term_TPUID = TPUID
	FROM
		MTMTripartyManualEntry TBL_MTMTRI
	 WHERE
		( TBL_MTMTRI.BrkNbr = @BrkNbr ) AND
		( TBL_MTMTRI.CollSchedId = @CollSchedID ) AND		
		( TBL_MTMTRI.IsDefaultTerm = 1 )



	--===============================================================================================================================================================================								
	--Set Prepay Indicator default vs MTM Broker Maintenance MTM New Loans setup 
	--===============================================================================================================================================================================
	UPDATE 
		@USVsLndAvailability
	SET 
		IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
									  FROM #TMP_DEFPREPAY_MTM_NEW_LOANS AS TMP_DEF_PREPAY_MTMNEWLN
								   	  WHERE TMP_DEF_PREPAY_MTMNEWLN.SettlementDay = TMTMBRK.MTMNewLoans ) THEN 1 
						ELSE 0 
						END
	FROM 
		MTMBroker AS TMTMBRK
	WHERE 
		( BrkNbr = @BrkNbr ) AND 
		( ISNULL(TMTMBRK.IsDeleted, 0) = 0 ) AND  
		( @BussDate BETWEEN TMTMBRK.EffectiveDateBegin AND TMTMBRK.EffectiveDateEnd )

	--===============================================================================================================================================================================
	--Set Prepay Indicator default vs MTM Broker Maintenance Loan Country Exception setup 
	--===============================================================================================================================================================================
	UPDATE 
		@USVsLndAvailability
	SET 
		IsPrePay = CASE WHEN EXISTS ( SELECT SettlementDay 
									  FROM #TMP_DEFPREPAY_MTM_LNCTRY AS TMP_DEF_PREPAY_MTMLNCTRY
									  WHERE TMP_DEF_PREPAY_MTMLNCTRY.SettlementDay = TLCE.SettlementDays ) THEN 1 
						ELSE 0 
						END
	FROM 
		@USVsLndAvailability AS TMP_AVAIL
		INNER JOIN MTMBrokerLoanCountryException AS TLCE  
			ON  
				( TLCE.BrkNbr = @BrkNbr ) AND 
			    ( TMP_AVAIL.CcyCode = TLCE.LoanExcepCCY ) AND 
				( ISNULL(TLCE.IsDeleted, 0) = 0 ) AND  
				( @BussDate BETWEEN TLCE.EffectiveDateBegin AND TLCE.EffectiveDateEnd ) 
	WHERE 
		( IsPrepay = 0 ) 

	--===============================================================================================================================================================================

	-- Select data to show on screen
	SELECT 
		@BussDate AsOfDate,
		'<nobr>' + ISOCountry + '</nobr>' Market,
		TickSymb,
		SecID,
		CUSIP,
		SEDOL,
		ISIN,
		SecCode,
		BucketSecType,
		--DateEX, --CONVERT(VARCHAR(10),LoanBasDtl.DateRecord,101) RecordDate,
		DateEX,
