                        }

                    }

                }
                rowInsertCount += secRowDiff + 1; //Added row diff beetween sections and increament by 1 to pointing next row
            }
            catch (Exception EX)
            {
                throw new Exception(sheet + " " + section + ": " + EX.Message + ReportGenerationExceptions(EX.Message), EX);
            }
        }

        public virtual void ApplyMerging(XLSheet workSheetTemplate, XLSheet xLSheetdummy, int startRow, int endRow, int dummysecStartRow)
        {
            try
            {
                XLCellRangeCollection xLMergedCellRange = xLSheetdummy.MergedCells;
                foreach (XLCellRange range in xLMergedCellRange)
                {
                    if (range.RowFrom >= startRow && range.RowFrom <= endRow)
                    {
                        workSheetTemplate.MergedCells.Add(range.RowFrom + (dummysecStartRow - startRow), range.ColumnFrom, range.RowCount, range.ColumnCount);
                    }
                }
            }
            catch (Exception)
            {

                throw;
            }
        }

