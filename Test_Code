                        {
                            //Append existing old cell value with new value
                            object value = (workSheetTemplate.GetCell(secRow, secColumn).Text) == "" ? dtReportHeader.Rows[i][dBTempHeader.DBColumn] : workSheetTemplate.GetCell(secRow, secColumn).Text + dtReportHeader.Rows[i][dBTempHeader.DBColumn].ToString();
