                clsDB.Dispose();
            }

            return true;
        }

        private bool SaveRecords()
        {
            Database clsDB = new Database();
            DataCommand clsCmd = new DataCommand();
            bool blnStatus = false;
            string Message = "loan records saved successfully";

            try
            {
                if (this.grdEquityMovement.Items.Count == 0) return false;
                StringBuilder xmlDoc = new StringBuilder();

                if (_ActionFlag == "E")
                {
                    xmlDoc = GetXML4UpdateBulk();
                    if (xmlDoc.ToString() == string.Empty)
                        return false;
                }
                else if (_ActionFlag == "N")
                {
                    xmlDoc = GetXML4NewLoan();
                    if (xmlDoc.ToString() == string.Empty)
                        return false;
                }
                else if (_ActionFlag == "D")
                {
                    Message = "Loan records saved successfully";
                }

                DataReader clsReader = new DataReader();
                DataSet ds = new DataSet();

                string[] SqlCondition = new string[7] { "", "","", "","" ,"",""};


                if (clsDB.Open() == false)
                {
                    _logger.Error("Can't open database");
                    throw new Exception("Can't open database");
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_SaveEquityMovementReport;

                SqlCondition[0] = string.IsNullOrEmpty(txtId.Text) ? "0" : txtId.Text.Trim();
                SqlCondition[1] = _ActionFlag;
                SqlCondition[2] = txtAsOfDate.Text.Trim();
                SqlCondition[3] = "52";
                SqlCondition[4] = clsUI.NTUserName;
                SqlCondition[5] = (_ActionFlag == "E") ? xmlDoc.ToString() : string.Empty;
                SqlCondition[6] = (_ActionFlag == "N") ? xmlDoc.ToString() : string.Empty;

                if (clsReader.GetData(ref ds, SqlObjects.p_SaveEquityMovementReport, SqlCondition) == false)
                {
                    blnStatus = false;
                    _logger.Error("Can't execute stored proc: " + clsCmd.StoredProcedure);
                    throw new Exception("Can't execute stored proc: " + clsCmd.StoredProcedure);
                }
                else
                {
                    blnStatus = true;
                    ClearDetail();
                }

                if (blnStatus)
                    ConfirmBatch(Message);

                _ReportAction = "SNAPSHOT";
                                
                return blnStatus;

            }
            catch (Exception ex)
            {
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(ex.Message);
                _show_error_row = "";
                _logger.Error(ex.Message);
                return false;
            }
         
        }

