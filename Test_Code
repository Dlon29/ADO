        //This method is used to decide the method to be called for writing the section based on its type.
        public virtual void SelectSectionType(string sheet, DataSet dataSet, Dictionary<string, Sections> sections, List<DBTempHeader> dBColumns, Dictionary<string, string> configKeys, ref List<string> dBDynamicHeaders, ref C1XLBook workBookTemplate, ref XLSheet workSheetTemplate, ref int rowInsertCount, ref int colInsertCount, string currentSection, string sectionType, string resultSetNo, string dynamicSectionKey, int rowIndex, int sectionRepeatCount)
        {
            try
            {
                var isDynamic = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == currentSection).Select(p => p.Value.IsDynamic).FirstOrDefault();

                DataTable dtBySection = null;
                if (isDynamic == "1" && dataSet.Tables[Convert.ToInt16(resultSetNo) - 1].Rows.Count > 0) //Filtered data based on DynamicSectionkey If the section is Dynamic else nothing 
                {
                    var dtBySeprator = dataSet.Tables[Convert.ToInt16(resultSetNo) - 1].AsEnumerable()
                   .Where(r => r.Field<string>(dynamicSectionKey) == dataSet.Tables[Convert.ToInt32(configKeys["DynamicSectionKeyResultSetNo"]) - 1].Rows[rowIndex][dynamicSectionKey].ToString());
                    dtBySection = dtBySeprator.Any() ? dtBySeprator.CopyToDataTable() : dataSet.Tables[Convert.ToInt16(resultSetNo) - 1].Clone();
                }
                else
                {
                    dtBySection = dataSet.Tables[Convert.ToInt16(resultSetNo) - 1];
                }

                if (sectionType == SectionType.Header.ToString())
                {
                    if (isDynamic == "1")
                        WriteReportHeader(sheet, currentSection, dtBySection, sections, dBColumns, ref workBookTemplate, ref rowInsertCount);
                    else
                        WriteReportHeader(sheet, currentSection, dtBySection, sections, dBColumns, ref workSheetTemplate, ref rowInsertCount);
                }
                if (sectionType == SectionType.Label.ToString())
                {
                    if (isDynamic == "1")
                        WriteLabelSection(sheet, currentSection, dtBySection, sections, dBColumns, ref workBookTemplate, ref rowInsertCount);
                    else
                        WriteLabelSection(sheet, currentSection, dtBySection, sections, dBColumns, ref workSheetTemplate, ref rowInsertCount);
                }
                else if (sectionType == SectionType.Table.ToString())
                {
                    WriteSection(sheet, currentSection, dtBySection, sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount);
                }
                else if (sectionType == SectionType.DynamicTable.ToString())
                {
                    WriteDynamicSection(sheet, currentSection, dtBySection, sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount, dBDynamicHeaders);
                }
                else if (sectionType == SectionType.GroupTable.ToString())
                {
                    WriteSectionForGroup(sheet, currentSection, dtBySection, sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount);
                }
                else if (sectionType == SectionType.DynamicGroupTable.ToString())
                {
                    WriteSectionForGroup(sheet, currentSection, dtBySection, sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount, dBDynamicHeaders);
                }
                else if (sectionType == SectionType.DynamicHeader.ToString())
                {
                    dBDynamicHeaders = WriteDynamicColHeader(sheet, currentSection, dataSet.Tables[Convert.ToInt16(resultSetNo) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref colInsertCount);
                }
                else if (sectionType == SectionType.PivotHeader.ToString())
                {
                    dBDynamicHeaders = WritePivotHeader(sheet, currentSection, dataSet.Tables[Convert.ToInt16(resultSetNo) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref colInsertCount);
                }
                else if (sectionType == SectionType.PivotTable.ToString())
                {
                    var pivotHeaderResultSetNo = sections.Where(s => s.Value.SectionOfSheet == sheet && s.Value.SectionName == currentSection).Select(p => p.Value.PivotHeaderResultSetNo).First();
                    WriteSectionForPivotGroup(sheet, currentSection, dataSet.Tables[Convert.ToInt16(resultSetNo) - 1], dataSet.Tables[Convert.ToInt16(pivotHeaderResultSetNo) - 1], sections, dBColumns, configKeys, ref workSheetTemplate, ref workBookTemplate, ref rowInsertCount, dBDynamicHeaders);
