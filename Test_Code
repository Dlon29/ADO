							TriPartyGrpID
						)
						SELECT 
							PoolId,
							AcctPriority,
							LendingLimitGrpID,
							AcctId,
							AcctNbr,
							AcctSN,
							BrkNbr,
							BrkID,
							@FaceAmount,
							AcctAvailibityRem,
							AcctAvailibityRestricted,
							LoopAvailability,
							PoolAvailability,
							BrkCrGrpID,
							BrkCreditLimitUSD,
							UsageCreditLimitUSD,
							MinAvailAndBCLAndUCLQty,
							LendingLimitUSD,
							ConcLimitUSD,
							MinLendLimAndConcLimUSD,
							MinOfAvailAndLLAndCLQty,
							MinOfAllLimitLoopQty,
							MinOfAllLimitPoolQty,
							UnitsLendable,
							UnUsedUnits,
							IsAcctUsed,
							SecID,
							@BucketSecType,
							@SecCode,
							WLDepository,
							ISOCountry,
							IsIndemnified,
							Price,
							MktValuePositionUSD,
							MktValueLoanUSD,
							PercentOnLoan,
							CanUseAcctForCleanUp,
							IsPoolUpdated,
							--isFITokyoRepo,
							isFITokyoSecLend,
