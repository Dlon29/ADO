	-- TMP table to hold any CBJ Indemnified account has shares either on loan OR not on loan for a given security
	/***************************************************************************************************************/
	SELECT
		lp.SecID, Acc.AcctNbr, --ISNULL(Acc.IsFrequentTrading,0) AS IsFrequentTrading,	
		SUM(UnitsOnLoan) AS UnitsOnLoanTotal, SUM(UnitsLendable) AS UnitsLendableTotal, SUM(UnitsSettled) AS UnitsSettledTotal 
	INTO
		#CBJIndmnNonActiveAcctAvail
	FROM 
		LAVA.dbo.LendingPosition lp
	INNER JOIN 
		Mobetter.dbo.Account Acc
	ON
		lp.AcctNbr = Acc.AcctNbr 		
	INNER JOIN
		@TempCtrIntradayLoanRequestAvailabilityAllSecurities CtrILoanReqAva
	ON
		CtrILoanReqAva.SecID = lp.SecID 	
	INNER JOIN
		@TempXMLTable temp
	ON
		temp.SecId = CtrILoanReqAva.SecId
	WHERE
		( lp.AsOfDate = CtrILoanReqAva.BatchDate ) AND
		( temp.BatchDate between Acc.EffectiveDateBegin AND Acc.EffectiveDateEnd ) AND
		( CtrILoanReqAva.IsStreetSide = 0 ) AND
		( ISNULL(Acc.IsDeleted,0) = 0 )  AND		
		( Acc.AcctGrpID  IN (SELECT CAST(PARAMETER AS smallint) As AcctGrpID FROM LAVA.DBO.f_ParseParameters(@ActiveTradingCBJAcctGrpID)) )  AND  -- CBJ Agent
		( ISNULL(Acc.IsIndemnified,0) = 1 ) AND-- CBJAgent Indemnified 
		( IsNUll(Acc.IsFrequentTrading,0) = 0 )
	GROUP BY
		 lp.SecID , Acc.AcctNbr --, IsNUll(Acc.IsFrequentTrading,0)
	HAVING 
		(  SUM(UnitsOnLoan) > 0 OR SUM(UnitsLendable) > 0 OR  SUM(UnitsSettled) > 0 )
	ORDER BY
		 lp.SecID , Acc.AcctNbr --, IsNUll(Acc.IsFrequentTrading,0)

