        private bool FillComboBoxes()
        {
            ListItem lstItem = new ListItem("--Select--", "0");

            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            SqlDataReader clsDR = null;
            string[] SqlCondition = new string[3] { "", "", "" };

            try
            {
                if (clsDB.Open() == false)
                    return false;

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Reports;

                // fill up the reason code combo box
                clsReader.SqlIdentifier = "CBO_ACCOUNT";
                SqlCondition[0] = _BatchRunDate;
                SqlCondition[1] = "EQ"; // Equity Accounts
                
                if (clsReader.GetData(ref clsDR, SqlCondition) == false)
                    return false;

                cboAcctNbr.DataSource = clsDR;
                cboAcctNbr.DataTextField = "AcctNameCode";
                cboAcctNbr.DataValueField = "AcctNbr";
                cboAcctNbr.DataBind();
                cboAcctNbr.Items.Insert(0, lstItem);
                clsDR.Close();

                // fill up the reason code combo box
                clsReader.SqlIdentifier = "CBO_CURRENCY";

                if (clsReader.GetData(ref clsDR, SqlCondition) == false)
                    return false;

                cboCCYCode.DataSource = clsDR;
                cboCCYCode.DataTextField = "CurrencySN";
                cboCCYCode.DataValueField = "CurrencySN";
                cboCCYCode.DataBind();
                cboCCYCode.Items.Insert(0, lstItem);
                clsDR.Close();
            
            }
            catch (Exception Exc)
            {
                Information clsInfo = new Information();
                clsInfo.ErrNum = 5000;
                clsInfo.ErrStr = Exc.Message;
                clsInfo.ErrStack = Exc.StackTrace;
                Response.Redirect(errPage);
            }
            finally
            {
                if (!clsDR.IsClosed)
                    clsDR.Close();

                clsDR = null;

                clsReader.Dispose();
                clsDB.Dispose();
            }
            return true;
        }

        private bool ValidateInputs(string actionType)
        {
            bool IsError = false;
            string strDate = "";
            int retValue = 0;
            _ErrorString = new StringBuilder("");

            switch (actionType.ToUpper())
            {
                case "SEARCH":
                case "PRINT":
                    // input date validation
                    strDate = _BatchRunDate;
                    retValue = Common.ValidateDate(strDate);

                    switch (retValue)
                    {
                        case -1:
                            IsError = true;
                            _ErrorString.Append("<a class=\"ErrorMsg\" href = \"#\" OnClick = SetFocus('txtAsOfDate');>\n");
                            _ErrorString.Append("\tPlease enter a valid business date. The format is mm/dd/yyyy.\n");
                            _ErrorString.Append("</a> <br>\n");
                            break;
                    }
                    break;
                case "SAVE":

                    strDate = this.txtNewTradeDate.Text;
                    if (Common.ValidateDate(strDate) == -1)
                    {
                            IsError = true;
                            _ErrorString.Append("<a class=\"ErrorMsg\" href = \"#\" OnClick = SetFocus('txtNewTradeDate');>\n");
                            _ErrorString.Append("\tPlease enter a valid 'TRADE DATE'. The format is mm/dd/yyyy.\n");
                            _ErrorString.Append("</a> <br>\n");
                            
                    }

                    strDate = this.txtNewLoanDate.Text;
                    if (Common.ValidateDate(strDate) == -1)
                    {
                            IsError = true;
                            _ErrorString.Append("<a class=\"ErrorMsg\" href = \"#\" OnClick = SetFocus('txtNewLoanDate');>\n");
                            _ErrorString.Append("\tPlease enter a valid 'AS OF DATE'. The format is mm/dd/yyyy.\n");
                            _ErrorString.Append("</a> <br>\n");
                            
                    }

                    if (_ActionFlag == "N")
                    {

                        // account number
                        if (this.cboAcctNbr.SelectedIndex == 0)
                        {
                            IsError = true;
                            _ErrorString.Append("<a class=\"ErrorMsg\" href = \"#\" OnClick = SetFocus('cboAcctNbr');>\n");
                            _ErrorString.Append("\tPlease choose valid ACCT #.\n");
                            _ErrorString.Append("</a> <br>\n");
                        }

                        // MKT-CTY
                        if (this.cboCCYCode.SelectedIndex == 0)
                        {
                            IsError = true;
                            _ErrorString.Append("<a class=\"ErrorMsg\" href = \"#\" OnClick = SetFocus('cboCCYCode');>\n");
                            _ErrorString.Append("\tPlease choose valid MKT-CTY.\n");
                            _ErrorString.Append("</a> <br>\n");
                        }
                        // UNITS
                        
                        if (txtUnits.Text.Trim() == string.Empty || Math.Abs(Convert.ToInt64(txtUnits.Text.Replace(",", "").Trim())) < 0)
                        {
                            IsError = true;
                            _ErrorString.Append("<a class=\"ErrorMsg\" href = \"javascript: document.forms[0].txtUnits.focus();\">\n");
                            _ErrorString.Append("\tUNITS has incorrect value.\n");
                            _ErrorString.Append("</a> <br>\n");
                        }
                        // PRICE
                        if (txtPrice.Text.Trim() == string.Empty)
                        {
                            IsError = true;
                            _ErrorString.Append("<a class=\"ErrorMsg\" href = \"javascript: document.forms[0].txtPrice.focus();\">\n");
                            _ErrorString.Append("\tPRICE has incorrect value.\n");
                            _ErrorString.Append("</a> <br>\n");
                        }
                        // AMOUNT
                        if (txtAmount.Text.Trim() == string.Empty)
                        {
                            IsError = true;
                            _ErrorString.Append("<a class=\"ErrorMsg\" href = \"javascript: document.forms[0].txtAmount.focus();\">\n");
                            _ErrorString.Append("\tAMOUNT has incorrect value.\n");
                            _ErrorString.Append("</a> <br>\n");
                        }
                        // LOAN #
                        if (string.IsNullOrEmpty(this.txtTxnRefNbr.Text))
                        {
                            IsError = true;
                            _ErrorString.Append("<a class=\"ErrorMsg\" href = \"#\" OnClick = SetFocus('txtTxnRefNbr');>\n");
                            _ErrorString.Append("\tPlease enter a valid LOAN#.\n");
                            _ErrorString.Append("</a> <br>\n");
                        }
                    }
                    break;
            }

            return !IsError;
        }

