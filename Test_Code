                                if (!reportExtn.Contains(relativeRequestUrl.ToString().Substring(relativeRequestUrl.ToString().LastIndexOf(dotchar), 4)))
                                {
                                    clsError = new InjectionError();
                                    clsError.ErrNum = 5000;
                                    clsError.ErrStr = ERROR_MSG_INVALID_REQUEST;
                                    clsError.ErrStack = ERROR_MSG_INVALID_REQUEST;
                                    clsError.WindowStyle = "";
                                    _logger.ErrorFormat("Reject1 [PeriodCheck] RelativeUrl={0}", relativeRequestUrl);
                                    HttpContext.Current.Response.Redirect(_errInjectionPage);
                                    
                                    return;
                                }
                            }
                            else
                            {
                                clsError = new InjectionError();
                                clsError.ErrNum = 5000;
                                clsError.ErrStr = ERROR_MSG_INVALID_REQUEST;
                                clsError.ErrStack = ERROR_MSG_INVALID_REQUEST;
                                clsError.WindowStyle = "";
                                _logger.ErrorFormat("Reject2 [PeriodCheck] RelativeUrl={0}", relativeRequestUrl);
                                HttpContext.Current.Response.Redirect(_errInjectionPage);

                                return;
                            }
                        }
                    }
                }                                

                for (int recform = 0; recform < formPostParam.Count; recform++)
                {
                    if (formPostParam.Keys[recform] != null)
                    {                        

                        if (formPostParam[recform] != null)
                        {
                            postValue = formPostParam[recform].ToString().ToLower();
                            prevChar = nextChar = "";

                            //Check start for LDAP Injections
                            if (arrLDAPControls.Any(Convert.ToString(formPostParam.Keys[recform]).Contains))
                            {
                                if (arrLDAPFilters.Any(postValue.Contains))
                                {
                                    clsError = new InjectionError();
                                    clsError.ErrNum = 5000;
                                    clsError.ErrStr = ERROR_MSG_INVALID_REQUEST;
                                    clsError.ErrStack = ERROR_MSG_INVALID_REQUEST;
                                    clsError.WindowStyle = "";
                                    _logger.ErrorFormat("Reject3 [LDAP] Field={0} Value={1}", formPostParam.Keys[recform], postValue);
                                    HttpContext.Current.Response.Redirect(_errInjectionPage);

                                    return;
                                }
                            }
                            //Check end for LDAP Injections

                            //Check whether the form post parameter contains the strings present in the Web.Config list.

                            string fieldName = formPostParam.Keys[recform];
                            if (fieldName == "__VIEWSTATE")
                            {
                                try
                                {
                                    object decoded = new LosFormatter().Deserialize(formPostParam[recform]);
                                    postValue = decoded.ToString().ToLower();      
                                                                       

                                    
                                    try
                                    {
                                        string logText = postValue;                
                                        string kw = arrstrFilterString.FirstOrDefault(f => logText.Contains(f.ToString().ToLower()));

                                        if (kw != null)
                                        {
                                            int idx = logText.IndexOf(kw);
                                            int start = Math.Max(0, idx - 100);
                                            int end = Math.Min(logText.Length, idx + kw.Length + 100);
                                            string prev = idx != 0 ? logText.Substring(idx - 1, 1) : "";
                                            string next = logText.Length > idx + kw.Length ? logText.Substring(idx + kw.Length, 1) : "";

                                            _logger.InfoFormat("VS-DECODED1 Field={0} Keyword={1} Prev={2} Next={3} Len={4} Excerpt={5}",
                                                fieldName, kw, prev, next, logText.Length, logText.Substring(start, end - start));
                                        }
                                        else
                                        {
                                            _logger.InfoFormat("VS-DECODED2 Field={0} Keyword=none Len={1} Start={2}",
                                                fieldName, logText.Length, logText.Substring(0, Math.Min(200, logText.Length)));
                                        }
                                    }
                                    catch (Exception) { }                                    
                                }
                                catch (Exception)
                                {
                                    continue;
                                }
                            }
                                  




                            //if (formPostParam.Keys[recform] == "__VIEWSTATE")
                            //{
                            //    //object decoded = new LosFormatter().Deserialize(formPostParam[recform]);
                            //    //_logger.Info(decoded);
                            //    postValue = new LosFormatter().Deserialize(formPostParam[recform]).ToString().ToLower();                                
                            //}                            

                            if (arrstrFilterString.Any(postValue.Contains))
                            {
                                ////If the Keyword mentioned in Web.Config list is found, then fetch the exact Keyword that is found in Post Parameter. 
                                specialKeyword = arrstrFilterString.FirstOrDefault(filter => postValue.Contains(filter.ToString().ToLower()));

                                if (IsAlphaNumeric(specialKeyword))
                                {
                                    //Check the character present before and after this special Keyword, If it is alphanumeric/space 
                                    //i.e. not special char then Process the request else reject the request and Redirect to Information.aspx page.
                                    if (postValue.IndexOf(specialKeyword) != 0)
                                    {
                                        prevChar = postValue.Substring(postValue.IndexOf(specialKeyword) - 1, 1);
                                    }

                                    if (postValue.Length > (postValue.IndexOf(specialKeyword) + specialKeyword.Length))
                                    {
                                        nextChar = postValue.Substring((postValue.IndexOf(specialKeyword) + specialKeyword.Length), 1);
                                    }

                                    if ((IsAlphaNumeric(prevChar) || prevChar == BLANK_SPACE) && (IsAlphaNumeric(nextChar) || nextChar == BLANK_SPACE))
                                    {
                                        continue;  //goto next posted Value
                                    }
                                    else
                                    {
                                        clsError = new InjectionError();
                                        clsError.ErrNum = 5000;
                                        clsError.ErrStr = ERROR_MSG_INVALID_REQUEST;
                                        clsError.ErrStack = ERROR_MSG_INVALID_REQUEST;
                                        clsError.WindowStyle = "";
                                        _logger.ErrorFormat("Reject4 [SQL] Field={0} Keyword={1} Prev={2} Next={3} Value={4}", formPostParam.Keys[recform], specialKeyword, prevChar, nextChar, postValue);
                                        HttpContext.Current.Response.Redirect(_errInjectionPage);

                                        return;
                                    }
                                }
                                else
                                {
                                    clsError = new InjectionError();
                                    clsError.ErrNum = 5000;
                                    clsError.ErrStr = ERROR_MSG_INVALID_REQUEST;
                                    clsError.ErrStack = ERROR_MSG_INVALID_REQUEST;
                                    clsError.WindowStyle = "";
                                    _logger.ErrorFormat("Reject5 [SQL] Field={0} Keyword={1} Prev={2} Next={3} Value={4}", formPostParam.Keys[recform], specialKeyword, prevChar, nextChar, postValue);
                                    HttpContext.Current.Response.Redirect(_errInjectionPage);

                                    return;
                                }

                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.ErrorFormat("Exception in ValidateRequestAgainstInjection:", ex);
            }
            finally
            {
                if (clsError != null)
                {
                    clsError.Dispose();
                    clsError = null;
                }
            }

        }

        /// <summary>
        /// Get Next Business Date
        /// </summary>
        /// <param name="dtBatchDate"></param>
        /// <returns></returns>
        public static string GetNextBusinessDate(string dtBatchDate)
        {
            Database clsDB = new Database();
            DataCommand clsCommand = new DataCommand();
            string RetVal = "";
            try
            {
                if (clsDB.Open() == false)
                    return RetVal;
                clsCommand.Connection = clsDB.Connection;
                clsCommand.StoredProcedure = SqlObjectsStaticClass.p_GetData_Misc;
                clsCommand.SqlIdentifier = "GET_BUSINESS_DATE";
                RetVal = clsCommand.GetBusinessDate(dtBatchDate);
            }
            catch (Exception Exc)
            {
                Information clsInfo = new Information();
                clsInfo.ErrNum = 5000;
                clsInfo.ErrStr = Exc.Message;
                clsInfo.ErrStack = Exc.StackTrace;
                clsInfo.WindowStyle = "";
                HttpContext.Current.Server.Transfer(_errPage, true);
            }
            finally
            {
                clsDB.Dispose();
            }
            return RetVal;
        }
