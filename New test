        /// <summary>
        /// This method will fetch Upload summary
        /// </summary>
        /// <returns></returns>
        private bool GetUploadSummary()
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet objDS = new DataSet();
            string[] SqlCondition = new string[1];
            MethodName = "GetUploadSummary()";

            try
            {
                if (clsDB.Open() == false)
                    return false;

                clsReader.Connection = clsDB.Connection;
                SqlCondition[0] = _BatchRunDate;

                if (clsReader.GetData(ref objDS, SqlObjects.op_GetUploadInfo, SqlCondition) == false)
                    return false;

                DataTable dtInfo = new DataTable();
                dtInfo = objDS.Tables[0];

                if (dtInfo.Rows.Count > 0)
                {
                    DataView dv = new DataView(dtInfo);
                    dv.RowFilter = "DatabaseName = 'GLOBALONE'";

                    if (dv.Count > 0)
                    {
                        litG1LastDownload.Text = dv[0]["EndTime"].ToString();
                        string _G1DownloadStatus = dv[0]["JobStatus"].ToString();
                        _g1Remarks = dv[0]["Remarks"].ToString();

                        switch (_G1DownloadStatus.ToUpper())
                        {
                            case "START":
                                _g1StatusSummary = "<Font color = 'red'>" + Common.GetMessage("Default", "UploadProcess") + "</font>";
                                break;
                            case "FAIL":
                                _g1StatusSummary = "<Font color = 'red'>" + Common.GetMessage("Default", "ErrorUploadProcess") + "</Font>";
                                break;
                            default:
                                break;
                        }

                        if (_g1Remarks.Length > 0)
                            _g1Remarks = "<Font color = 'red'>" + _g1Remarks + "</font>";
                        else
                            _g1Remarks = string.Empty;
                    }

                    dv.RowFilter = "DatabaseName = 'Lava'";


                    if (dv.Count > 0)
                    {
                        litGPLastDownload.Text = dv[0]["EndTime"].ToString();
                        string _glpDownloadStatus = dv[0]["JobStatus"].ToString();
                        _gpRemarks = dv[0]["Remarks"].ToString();

                        switch (_glpDownloadStatus.ToUpper())
                        {
                            case "START":
                                _gpStatusSummary = "<Font color = 'red'>" + Common.GetMessage("Default", "UploadProcess") + "</font>";
                                break;
                            case "FAIL":
                                _gpStatusSummary = "<Font color = 'red'>" + Common.GetMessage("Default", "ErrorUploadProcess") + "</Font>";
                                break;
                            default:
                                break;
                        }

                        if (_gpRemarks.Length > 0)
                            _gpRemarks = "<Font color = 'red'>" + _gpRemarks + "</font>";
                        else
                            _gpRemarks = string.Empty;
                    }

                }
                dtInfo.Dispose();

                DataTable dtGPInfo = new DataTable();
                dtGPInfo = objDS.Tables[1];

                if (dtGPInfo.Rows.Count > 0)
                {
                    litLavaAsOfDate.Text = dtGPInfo.Rows[0]["AsOfDate"].ToString();
                    litGPBatchID.Text = dtGPInfo.Rows[0]["BatchID"].ToString();
                    litGPSecRowCount.Text = dtGPInfo.Rows[0]["seCount"].ToString();
                    litGPTxnRowCount.Text = dtGPInfo.Rows[0]["trCount"].ToString();
                    litGPPosRowCount.Text = dtGPInfo.Rows[0]["poCount"].ToString();
                }
                else
                {
                    litGPBatchID.Text = "N/A";
                    litGPSecRowCount.Text = "0";
                    litGPTxnRowCount.Text = "0";
                    litGPPosRowCount.Text = "0";
                }

                dtGPInfo.Dispose();

                DataTable dtG1Info = new DataTable();
                dtG1Info = objDS.Tables[2];

                if (dtG1Info.Rows.Count > 0)
                {
                    System.DateTime G1AsOfDate = new DateTime();
                    G1AsOfDate = Convert.ToDateTime(dtG1Info.Rows[0]["AsOfDate"].ToString());

                    litG1LoanRowCount.Text = dtG1Info.Rows[0]["LoanRowCount"].ToString();
                    litG1AsOfDate.Text = G1AsOfDate.ToShortDateString();
                    litG1LastProcessed.Text = dtG1Info.Rows[0]["CreatedDate"].ToString();
                }
                dtG1Info.Dispose();

            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
