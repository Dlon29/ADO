        /// <summary>
        /// This method will select top data row from result set
        /// </summary>
        /// <param name="dt"></param>
        /// <param name="count"></param>
        /// <returns></returns>
        private DataTable SelectTopDataRow(DataTable dt, int count)
        {
            // Filter records which have been successfully completed
            dt.DefaultView.RowFilter = "StatusId = 140 AND IsBatchSuccessfull = 1";

            DataTable TempDt = dt.DefaultView.ToTable();
            DataTable dtn = dt.Clone();
            int TotalCount = 0;
            MethodName = "SelectTopDataRow()";

            try
            {
                if (TempDt.Rows.Count > 0)
                {
                    TotalCount = TempDt.Rows.Count > count ? count : TempDt.Rows.Count;

                    for (int i = 0; i < TotalCount; i++)
                    {
                        dtn.ImportRow(TempDt.Rows[i]);
                    }
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _show_error_row = string.Empty;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
            }

            return dtn;
        }

