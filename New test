        private bool GenerateOnLoanReconExcel(String asOfDate)
        {
            _ErrorString = new StringBuilder("");

            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet ds = new DataSet();
            DataSet dsOnLoanReconViewfilter = new DataSet();

            MethodName = "GenerateOnLoanReconExcel()";

            try
            {
                if (!clsDB.Open())
                    return false;

                clsReader.Connection = clsDB.Connection;
                clsReader.SqlIdentifier = SqlIdentifier.FROM_HOME_PAGE.ToString();

                string[] sqlcondition = new string[5];

                sqlcondition[0] = asOfDate;
                sqlcondition[1] = "";
                sqlcondition[2] = "";
                sqlcondition[3] = "0"; 
                sqlcondition[4] = "1"; 

                if (!clsReader.GetData(ref ds, SqlObjects.p_GetData_OnLoanRecon, sqlcondition))
                   
                return false;

                dsOnLoanReconViewfilter.Tables.Add(ds.Tables[0].DefaultView.ToTable());

                //Excel template
                Lava.ExcelTemplates.OnLoanRecon template = new ExcelTemplates.OnLoanRecon(dsOnLoanReconViewfilter);
                STBUSA.Excel.ExcelReportGenerator generator = new STBUSA.Excel.ExcelReportGenerator(template);

                byte[] file = generator.Generate();

                if(file != null)
                {
                    IsUI = false;
                    _show_error_row = show_section;
                    Response.Clear();
                    Response.ContentType = "application/vnd.ms-excel";
