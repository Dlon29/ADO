        /// <summary>
        /// This method will be called to confirm Miscategorized loan
        /// </summary>
        private void ConfirmMiscategorizedLoan()
        {
            int rowCount = 0;
            int i = 0;
            string xmlLoanDetails = string.Empty;
            bool containsConfirmedRec = false;
            MethodName = "ConfirmMiscategorizedLoan()";
            try
            {
                if (ValidateInputMiscategorizedLoan(enummoduleMiscategorizedLoan.CONFIRM.ToString()) == true)
                {
                    _show_error_row = "";
                    return;
                }

                _ErrorString = new StringBuilder("");

                XElement xloanDetails = new XElement("MiscategorizedLoans");

                rowCount = grdMiscategorizedLoan.Items.Count;

                ////Loop through grid to get the checked record collection
                for (i = 0; i < rowCount; i++)
                {
                    if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.chkSelectLoan].FindControl("chkSelectLoan") as CheckBox).Checked == true)
                    {
                        if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.StatusID].FindControl("lblMisLoanStatusID") as Label).Text == ((int)enummisccategorizedLoanStatus.Confirmed).ToString())
                        {
                            containsConfirmedRec = true;
                        }
                        else
                        {
                            xloanDetails.Add(new XElement("MiscategorizedLoan", new XAttribute("TxnRefNbr", (grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.TxnRefNbr].FindControl("lblMisLoanTxnRefNbr") as HyperLink).Text), new XAttribute("Comments", (grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.ConfirmedComments].FindControl("txtMisLoanConfirmedComments") as TextBox).Text)));
                        }
                    }
                }

                if (containsConfirmedRec)
                    ScriptManager.RegisterStartupScript(this.Page, this.GetType(), "LAVA - Confirm", "<script type='text/javascript'>alert('" + Common.GetMessage("Default", "MisCatLoanConfirmed") + "');</script>", false);

                if (xloanDetails.HasElements)
                {
                    xmlLoanDetails = xloanDetails.ToString();

                    if (UpdateMiscategorizedLoanStatus(xmlLoanDetails, ((int)enummisccategorizedLoanStatus.New).ToString(), clsUI.NTUserName) == true)
                    {
                        ScriptManager.RegisterStartupScript(this.Page, this.GetType(), "LAVA", "<script type='text/javascript'>alert('" + Common.GetMessage("Default", "MisCatLoanSuccess") + "');</script>", false);
                        GetMiscategorizedLoanInfo();
                    }
                    else
                    {
                        ScriptManager.RegisterStartupScript(this.Page, this.GetType(), "LAVA", "<script type='text/javascript'>alert('" + Common.GetMessage("Default", "MisCatLoanFailure") + "');</script>", false);
                    }
                }
            }
            catch (Exception Exc)
            {
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                _show_error_row = "";
            }
        }

        /// <summary>
        /// This method will be called to Approve Miscategorized loan
        /// </summary>
        private void ApproveMiscategorizedLoan()
        {
            int rowCount = 0;
            int i = 0;
            string xmlLoanDetails = string.Empty;
            bool containsNotConfirmedRec = false;
            bool isConfirmUser = false;
            string validationMsg = string.Empty;
            MethodName = "ApproveMiscategorizedLoan()";
            try
            {
                if (ValidateInputMiscategorizedLoan(enummoduleMiscategorizedLoan.APPROVE.ToString()) == true)
                {
                    _show_error_row = "";
                    return;
                }

                _ErrorString = new StringBuilder("");

                XElement xloanDetails = new XElement("MiscategorizedLoans");

                rowCount = grdMiscategorizedLoan.Items.Count;

                ////Loop through grid to get the checked record collection
                for (i = 0; i < rowCount; i++)
                {
                    if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.chkSelectLoan].FindControl("chkSelectLoan") as CheckBox).Checked == true)
                    {
                        if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.StatusID].FindControl("lblMisLoanStatusID") as Label).Text == ((int)enummisccategorizedLoanStatus.New).ToString())
                            containsNotConfirmedRec = true;
                        else
                        {
                            if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.ConfirmedBy].FindControl("lblMisLoanConfirmedBy") as Label).Text == clsUI.NTUserName.ToString())
                                isConfirmUser = true;
                            else
                                xloanDetails.Add(new XElement("MiscategorizedLoan", new XAttribute("TxnRefNbr", (grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.TxnRefNbr].FindControl("lblMisLoanTxnRefNbr") as HyperLink).Text), new XAttribute("Comments", (grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.ApprovedComments].FindControl("txtMisLoanApprovedComments") as TextBox).Text)));
                        }
                    }

                }

                if (containsNotConfirmedRec)
                    validationMsg += Common.GetMessage("Default", "MisCatLoanApproved");


                if (isConfirmUser)
                    validationMsg += Common.GetMessage("Default", "MisCatLoanConfirm");


                if (containsNotConfirmedRec || isConfirmUser)
                    ScriptManager.RegisterStartupScript(this.Page, this.GetType(), "LAVA - Approve", "<script type='text/javascript'>alert('" + validationMsg + "');</script>", false);

                if (xloanDetails.HasElements)
                {
                    xmlLoanDetails = xloanDetails.ToString();

                    if (UpdateMiscategorizedLoanStatus(xmlLoanDetails, ((int)enummisccategorizedLoanStatus.Confirmed).ToString(), clsUI.NTUserName) == true)
                    {
                        ScriptManager.RegisterStartupScript(this.Page, this.GetType(), "LAVA", "<script type='text/javascript'>alert('" + Common.GetMessage("Default", "MisCatLoanApproveSuccess") + "');</script>", false);
