        /// <summary>
        /// Generate Multiple Seccode link with comma separated and return as a single string.
        /// </summary>
        /// <param name="secCode"></param>
        private string GenerateMultiLink(string secCode)
        {
            string[] arrCode = secCode.Split(',');
            int codeCount = arrCode.Length;
            int count = 1;
            StringBuilder secCodeUrl = new StringBuilder();
            foreach (string code in arrCode)
            {
                string appendSecCode = code + (count < codeCount ? "," : "");
                secCodeUrl.Append($"<a href=\"{AddSecCodelink(code)}\">{appendSecCode} </a>");
                count++;
            }
            return Convert.ToString(secCodeUrl);
        }

