                    cell.ColumnSpan = headerColSpan;
                    cell.CssClass = "TRADEVERTripartyHeaderCellStyle";
                    headerRow.Cells.Add(cell);

                    cell = new TableCell();
                    cell.Text = bilateralText;
                    cell.ColumnSpan = headerColSpan;
                    cell.CssClass = "TRADEVERHeaderCellStyle";
                    headerRow.Cells.Add(cell);

                    grdTradeVerificationDashboard.Controls[0].Controls.AddAt(0, headerRow);
                }

                if (e.Item.ItemType == ListItemType.Item ||
                        e.Item.ItemType == ListItemType.AlternatingItem ||
                        e.Item.ItemType == ListItemType.SelectedItem)
                {
                    drData = (DataRowView)e.Item.DataItem;
                    dv = drData.DataView;

                    totalNotChecked = dv.Table.AsEnumerable().Where(y => y.Field<int>(colLoanStatusID) == (int)enumTradeVerficationStatusCodes.NotChecked).Select(s => s.Field<int>(colTotal)).FirstOrDefault();
                    totalUnVerified = dv.Table.AsEnumerable().Where(y => y.Field<int>(colLoanStatusID) == (int)enumTradeVerficationStatusCodes.UnVerified).Select(s => s.Field<int>(colTotal)).FirstOrDefault();
