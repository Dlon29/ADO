                    }
                }
            }
            catch (Exception Exc)
            {
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                _show_error_row = "";
            }
        }

        /// <summary>
        /// This method will be called to Validate Miscategorized loan
        /// </summary>
        /// <param name="moduleName"></param>
        /// <returns></returns>
        private bool ValidateInputMiscategorizedLoan(string moduleName)
        {
            bool isChecked = false;
            bool isBlankComment = false;
            bool isExceedComment = false;
            bool IsError = false;
            MethodName = "ValidateInputMiscategorizedLoan('" + moduleName + "')";
            try
            {
                _ErrorString = new StringBuilder("");
                if (grdMiscategorizedLoan.Items.Count > 0)
                {
                    for (int i = 0; i < grdMiscategorizedLoan.Items.Count; i++)
                    {
                        if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.chkSelectLoan].FindControl("chkSelectLoan") as CheckBox).Checked == true)
                        {
                            isChecked = true;

                            if (moduleName.ToUpper() == enummoduleMiscategorizedLoan.CONFIRM.ToString())
                            {
                                if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.ConfirmedComments].FindControl("txtMisLoanConfirmedComments") as TextBox).Text.Trim() == "")
                                {
                                    isBlankComment = true;
                                }

                                if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.ConfirmedComments].FindControl("txtMisLoanConfirmedComments") as TextBox).Text.ToString().Length > 40)
                                {
                                    isExceedComment = true;
                                }
                            }
                            else if (moduleName.ToUpper() == enummoduleMiscategorizedLoan.APPROVE.ToString())
                            {
                                if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.ApprovedComments].FindControl("txtMisLoanApprovedComments") as TextBox).Text.Trim() == "")
                                {
                                    isBlankComment = true;
                                }

                                if ((grdMiscategorizedLoan.Items[i].Cells[(int)grdMiscategorizedLoanDataMapping.ApprovedComments].FindControl("txtMisLoanApprovedComments") as TextBox).Text.ToString().Length > 40)
                                {
                                    isExceedComment = true;
                                }
                            }
                        }
                    }
                }

                if (!isChecked)
                {
                    IsError = true;
                    _ErrorString.Append("<a class=\"ErrorMsg\" href = \"#\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("Default", "MisCatLoanSelect") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }
                if (isBlankComment)
                {
                    IsError = true;
                    _ErrorString.Append("<a class=\"ErrorMsg\" href = \"#\">\n");
                    if (moduleName.ToUpper() == enummoduleMiscategorizedLoan.CONFIRM.ToString())
                        _ErrorString.Append("\t" + Common.GetMessage("Default", "MisCatLoanConfirmedComments") + "\n");
                    else if (moduleName.ToUpper() == enummoduleMiscategorizedLoan.APPROVE.ToString())
                        _ErrorString.Append("\t" + Common.GetMessage("Default", "MisCatLoanApprovedComments") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }
                if (isExceedComment)
                {
                    IsError = true;
                    _ErrorString.Append("<a class=\"ErrorMsg\" href = \"#\">\n");
                    if (moduleName.ToUpper() == enummoduleMiscategorizedLoan.CONFIRM.ToString())
                        _ErrorString.Append("\t" + Common.GetMessage("Default", "MisCatLoanConfirmedCommentsLen") + "\n");
                    else if (moduleName.ToUpper() == enummoduleMiscategorizedLoan.APPROVE.ToString())
                        _ErrorString.Append("\t" + Common.GetMessage("Default", "MisCatLoanApprovedCommentsLen") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                _show_error_row = string.Empty;
            }

            return IsError;
        }

        /// <summary>
