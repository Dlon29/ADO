                    //CSS applied to show thick top line for total row
                    if (e.Item.Cells[0].Text.Trim().ToUpper() == tradeTotal.ToUpper())
                    {
                        for (int colCount = 0; colCount < e.Item.Cells.Count; colCount++)
                        {
                            if (colCount == cellIndexTripartyLoan) //9 is the cell index for triparty loan
                            {
                                e.Item.Cells[colCount].CssClass = "ItemStyleTripartyTotal";
                            }
                            else
                            {
                                e.Item.Cells[colCount].CssClass = "ItemStyleTotal";
                            }
                        }
                    }
                }

                //Merge cells in footer to show total
                if (e.Item.ItemType == ListItemType.Footer)
                {
                    int Columnscount = grdTradeVerificationDashboard.Columns.Count;

                    Label lblNotChecked = (Label)e.Item.FindControl("lblNotChecked");
                    lblNotChecked.Text = lblNotChecked.Text + totalNotChecked.ToString();

                    Label lblUnVerified = (Label)e.Item.FindControl("lblUnVerified");
                    lblUnVerified.Text = lblUnVerified.Text + totalUnVerified.ToString();

                    Label lblVerified = (Label)e.Item.FindControl("lblVerified");
                    lblVerified.Text = lblVerified.Text + totalVerified.ToString();

                    //css applied to Remove gridlines from footer
                    for (int colCount = 0; colCount < Columnscount; colCount++)
                    {
                        e.Item.Cells[colCount].CssClass = "TVFooterStyleBorder";
                    }

                    //Colspan the column in footer row and remove extra column added
                    e.Item.Cells[3].ColumnSpan = footerColSpan;

                    for (int removeCell = Columnscount - 1; removeCell > Columnscount - footerColSpan; removeCell--)
                    {
                        e.Item.Cells.RemoveAt(removeCell);
                    }
                }

            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Error(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                _show_error_row = string.Empty;
            }
