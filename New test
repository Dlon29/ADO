        /// <summary>
        /// This method will fetch Holds data
        /// </summary>
        /// <param name="BgnRefPrefix"></param>
        /// <returns></returns>
        private bool GetHoldsData(string BgnRefPrefix)
        {
            Database clsDB = new Database();
            DataCommand clsCommand = new DataCommand();
            Hashtable htMain = new Hashtable();
            DataSet objDS = new DataSet();
            MethodName = "GetHoldsData(" + BgnRefPrefix + ")";
            try
            {
                if (clsDB.Open() == false)
                    return false;

                clsCommand.Connection = clsDB.Connection;
                clsCommand.StoredProcedure = SqlObjectsStaticClass.p_GetData_HoldDetails;

                htMain.Add("@BgnRefPrefix", new Hashtable());
                ((Hashtable)htMain["@BgnRefPrefix"]).Add("Value", BgnRefPrefix);
                ((Hashtable)htMain["@BgnRefPrefix"]).Add("IsReportParameter", true);

                if (!clsCommand.ExecuteStoreProc(ref objDS, htMain))
                    return false;

                int count = objDS.Tables[0].Rows.Count;

                if (BgnRefPrefix == "H" && count > 0)
                {
                    hlnkRegularHold.Text = count.ToString() + " Regular holds entered. Click here to view.";
                    hlnkRegularHold.NavigateUrl = String.Format("javascript:PopUpWindow('/LAVA/Home/HoldData.aspx?BgnRefPrefix={0}', '', 'width=screen.width,height=screen.height,scrollbars=yes,resizable=no,screenX=0,screenY=0,left=0,top=0', true);", BgnRefPrefix);

                }
                else if (BgnRefPrefix == "P" && count > 0)
                {
                    hlnkPayToHold.Text = count.ToString() + " Pay to holds entered. Click here to view.";
                    hlnkPayToHold.NavigateUrl = String.Format("javascript:PopUpWindow('/LAVA/Home/HoldData.aspx?BgnRefPrefix={0}', '', 'width=screen.width,height=screen.height,scrollbars=yes,resizable=no,screenX=0,screenY=0,left=0,top=0', true);", BgnRefPrefix);
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _show_error_row = string.Empty;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                return false;
            }
            finally
            {
                clsDB.Dispose();
            }
            return true;
        }

