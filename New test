        /// <param name="statusID"></param>
        /// <param name="userID"></param>
        /// <returns></returns>
        private bool UpdateMiscategorizedLoanStatus(string recordsXML, string statusID, string userID)
        {
            MethodName = "UpdateMiscategorizedLoanStatus('" + recordsXML + "','" + statusID + "','" + userID + "')";
            bool result = false;
            try
            {
                Database clsDB = new Database();
                DataReader clsReader = new DataReader();
                DataSet objDS = new DataSet();
                string[] SqlCondition = new string[3];

                if (clsDB.Open() == false)
                    return false;

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_SaveData_LoanMiscategorizedStatus;

                SqlCondition[0] = recordsXML;
                SqlCondition[1] = statusID;
                SqlCondition[2] = userID;

                if (clsReader.GetData(ref objDS, SqlObjects.p_SaveData_LoanMiscategorizedStatus, SqlCondition) == false)
                    result = false;
                else
                    result = true;
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                _show_error_row = string.Empty;
                result = false;
            }
            return result;
        }

