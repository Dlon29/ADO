                }
                else
                {
                    //SECURITY NOT FOUND
                    litSecId.Text = "0";
                    litSecurityHeader.Text = "<font color='red'>SECURITY NOT FOUND!!! </font>";
                    litSecuritySpecial.Text = "";
                    litSecurityComment.Text = "";
                    litPrice.Text = "";
                    litPriceAsOfDate.Text = "";
                    litPriceFX.Text = "";
                    litPriceUSD.Text = "";
                    litCcyCode.Text = "";
                    litTotalUnits.Text = "";
                    litTotalLendable.Text = "";
                    litSecurityLoc.Text = "";
                }

                // if security type found, then use it otherwise use the passed security type.
                _secType = litSecType.Text.Trim().Equals("") ? _secType : litSecType.Text.Trim();

                //Bind Div Rate dropdown to filter allcount in allocation
                if (_secType == Common.enumSecType.EQ.ToString() || _secType == Common.enumSecType.RI.ToString())
                {
                    clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance;
                    clsReader.SqlIdentifier = SqlIdentifier.GET_DivRate.ToString();

                    SqlCondition = new string[1] { "" };
                    SqlCondition[0] = litCountryCode.Text.ToString();

                    if (clsReader.GetData(ref clsDR, SqlCondition) == false)
                        return false;

                    cboDivRate.DataSource = clsDR;
                    cboDivRate.DataTextField = "DivRate";
                    cboDivRate.DataValueField = "DivRateVal";
                    cboDivRate.DataBind();
                    cboDivRate.Items.Insert(0, new ListItem("-- Select --", "0"));
                    clsDR.Close();

                    if (cboDivRate.Items.Count == 2)
                    {
                        cboDivRate.SelectedIndex = 1;
                    }
                }

            }
            catch (Exception Exc)
            {
                _show_error_row = "";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                this.ajxTimer.Enabled = false;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
            finally
            {
                ds.Dispose();
                dtSecInfo.Dispose();
                clsReader.Dispose();
                clsDB.Dispose();
            }

            return true;
        }

