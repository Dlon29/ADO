private static void EnsureIsEquilendColumn(DataTable dt)
{
    if (dt == null || dt.Columns.Contains("IsEquilend")) return;
    dt.Columns.Add(new DataColumn("IsEquilend", typeof(string)));
    foreach (DataRow r in dt.Rows) r["IsEquilend"] = "N";
}

private static string ToEquilendId(object isEquilend)
{
    return Convert.ToString(isEquilend).Trim().ToUpper() == "Y" ? "1" : "0";
}





