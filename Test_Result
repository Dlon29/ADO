    public sealed class C1XLBook : IDisposable
    {
        private readonly NativeC1XLBook _book;
        private bool _disposed;

        public C1XLBook() { _book = new NativeC1XLBook(); }

        internal NativeC1XLBook NativeBook
        {
            get { EnsureNotDisposed(); return _book; }
        }

        public void Load(string path)
        {
            EnsureNotDisposed();
            _book.Load(path);
        }

        public void Load(string path, FileFormat format)
        {
            EnsureNotDisposed();
            _book.Load(path, ToNativeFormat(format));
        }

        public void Save(string path)
        {
            EnsureNotDisposed();
            _book.Save(path);
        }

        public void Save(string path, FileFormat format)
        {
            EnsureNotDisposed();
            _book.Save(path, ToNativeFormat(format));
        }

        public XLSheets Sheets
        {
            get { EnsureNotDisposed(); return new XLSheets(_book); }
        }

        public XLNamedRangeCollection NamedRanges
        {
            get
            {
                EnsureNotDisposed();
                return _book.NamedRanges == null ? null : new XLNamedRangeCollection(_book.NamedRanges);
            }
        }

        private static NativeFileFormat ToNativeFormat(FileFormat format)
        {
            switch (format)
            {
                case FileFormat.Biff8: return NativeFileFormat.Biff8;
                case FileFormat.OpenXml: return NativeFileFormat.OpenXml;
                case FileFormat.OpenXmlMacro: return NativeFileFormat.OpenXmlMacro;
                    //MoBetter API
                case FileFormat.OpenXmlTemplate: return NativeFileFormat.OpenXmlTemplate;
                default: throw new ArgumentOutOfRangeException("format");
            }
        }

        private void EnsureNotDisposed()
        {
            if (_disposed) throw new ObjectDisposedException("C1XLBook");
        }

        public void Dispose()
        {
            if (_disposed) return;
            _book.Dispose();
            _disposed = true;
        }
    }

