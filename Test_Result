        /// <summary>
        /// Page Load - Fill fields
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void Page_Load(object sender, EventArgs e)
        {
            try
            {
                _AccessTypeCode = getUserAppAccessTypeCode("Availability", clsUI.NTUserName);
                _AccessTypeCode = _AccessTypeCode == "F" ? getUserAppAccessTypeCode(_ModuleName, clsUI.NTUserName) : _AccessTypeCode;

                MethodName = "Page_Load()";


                if (_AccessTypeCode == "R")
                {
                    _UserAccess = "ReadOnly";
                }

                else if (_AccessTypeCode == "N")
                {
                    //Logging Activity Code For Authorization, base on ModuleName
                    LogUserAuthorization(_ModuleName, _AccessTypeCode);

                    Response.Redirect(string.Format(Common.ACCESSDENIEDPAGE, Common.AUTHORIZATIONFAIL, _page));
                }

                AddJSAttributes();

                if (grdBasketAvailRecords.Items.Count == 0)
                {
                    divBasketAvailRecords.Visible = false;
                    pnlMsg.Visible = true;
                }
                else
                {
                    divBasketAvailRecords.Visible = true;
                    pnlMsg.Visible = false;
                }

                if (grdSelectedBasket.Items.Count == 0)
                {
                    divSelectedBaskets.Visible = false;
                    pnlSavedBasketMsg.Visible = true;
                }
                else
                {
                    divSelectedBaskets.Visible = true;
                    pnlSavedBasketMsg.Visible = false;
                }

                if (grdBookLoanRecords.Items.Count == 0)
                {
                    pnlBookLoanMsg.Visible = true;
                }
                else
                {
                    pnlBookLoanMsg.Visible = false;
                }

                txtUploadBusinessDate.Text = _BussDate;
                HideShowOverrideBrkCrLimit();

                if (!IsPostBack)
                {
                    _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

                    //Logging Activity Code For Authorization, base on ModuleName
                    LogUserAuthorization(_ModuleName, _AccessTypeCode);

                    if (Request.Form.AllKeys.Length == 0)
                    {
                        this.vwSelectedBaskets = null;
                        this.vwSettlCCY = null;
                        this.vwAllocation = null;
                        this.vwBookLoan = null;
                        this.vwValidSettlemetDateForCounry = null;
                    }

                    rdWorldLendstyle.Checked = true;

                    if (cboWLCollSched.Items.Count == 0)
                        cboWLCollSched.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));

                    if (cboEQLCollSched.Items.Count == 0)
                        cboEQLCollSched.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));

                    if (cboBookLoanCollSched.Items.Count == 0)
                        cboBookLoanCollSched.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));

                    if (cboWLBasketNbr.Items.Count == 0)
                        cboWLBasketNbr.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));

                    if (cboEQLBasketNbr.Items.Count == 0)
                        cboEQLBasketNbr.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));

                    cmdOpenBasket.Enabled =
                                cmdCopyBasket.Enabled =
                                    cmdDeleteBasket.Enabled = false;

                    //Initialize combo boxes
                    if (FillComboBoxes(null) == false)
                    {
                        _logger.Debug(Common.GetMessage("Common", "ErrorFillingComboBox"));
                        Response.Write(Common.GetMessage("Common", "ErrorFillingComboBox"));
                    }

                    #region "Set Query String sent from SecLending Dashboard"
                    parentScreen = Request.QueryString["ParentScreen"];

                    if (parentScreen == "SecLendDashboard")
                    {
                        if (Session[Common.CON_TXNREFNBRLIST] != null)
                        {
                            _TxnRefNbrList = (string)Session[Common.CON_TXNREFNBRLIST];
                        }

                        _SecType = Convert.ToString(Request.QueryString["SecType"]);
                        _Broker = Convert.ToString(Request.QueryString["Broker"]);

                        _TxnRefNbrList = _TxnRefNbrList.Substring(0, _TxnRefNbrList.Length - 1);
                        FillCancelledLoansData(_TxnRefNbrList, _SecType, _Broker);

                    }
                    #endregion

                    //using cross page posting, access values of control from previous page
                    if (Page.PreviousPage != null)
                    {
                        if (PreviousPage.IsCrossPagePostBack)
                        {
                            HtmlInputHidden hdnSelectedIds = (HtmlInputHidden)PreviousPage.FindControl("hdnSelectedIDs");

                            string SelectedId = hdnSelectedIds.Value;
                            if (SelectedId != null && SelectedId != string.Empty)
                            {
                                HtmlInputHidden hdnSecType = (HtmlInputHidden)PreviousPage.FindControl("hdnSecType");
                                HtmlInputHidden hdnBroker = (HtmlInputHidden)PreviousPage.FindControl("hdnBroker");
                                string BrkNbr = hdnBroker.Value;
                                SelectedId = SelectedId.Substring(0, SelectedId.Length - 1);
                                string SecType = hdnSecType.Value;

                                FillCancelledLoansData(SelectedId, SecType, BrkNbr);
                            }
                        }
                    }
                    _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
                }

                if (hdnSelectedTab.Value == BASKET_CONFIGURATION)
                {
                    lnkBasketConfiguration.Attributes.Add("class", "selected");
                    lnkNewBasket.Attributes.Add("class", "notselected");
                    lnkBookLoan.Attributes.Add("class", "notselected");

                    divBasketConfigure.Style.Add("display", "inline");
                    divNewBasket.Style.Add("display", "inline");
                    divUploadBasket.Style.Add("display", "inline");

                    divSelectionCriteria.Style.Add("display", "none");
                    divBasketAvialabiltiy.Style.Add("display", "none");
                    divBasketSelection.Style.Add("display", "none");
                    divCreateNewLoanTicket.Style.Add("display", "none");
                    divNewLoanTicket.Style.Add("display", "none");

                    ajxTimer.Enabled = false;
                }

                else if (hdnSelectedTab.Value == NEW_BASKET)
                {
                    lnkBasketConfiguration.Attributes.Add("class", "notselected");
                    lnkNewBasket.Attributes.Add("class", "selected");
                    lnkBookLoan.Attributes.Add("class", "notselected");

                    divBasketConfigure.Style.Add("display", "none");
                    divNewBasket.Style.Add("display", "none");
                    divUploadBasket.Style.Add("display", "none");

                    divSelectionCriteria.Style.Add("display", "inline");
                    divBasketAvialabiltiy.Style.Add("display", "inline");
                    divBasketSelection.Style.Add("display", "inline");
                    divCreateNewLoanTicket.Style.Add("display", "none");
                    divNewLoanTicket.Style.Add("display", "none");

                    ajxTimer.Enabled = false;
                }

            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
        }

        /// <summary>
        /// Get loan data for selected txnrefnbr
        /// </summary>
        /// <param name="SelectedId"></param>
        /// <param name="SecType"></param>
        /// <param name="BrkNbr"></param>
        private void FillCancelledLoansData(string SelectedId, string SecType, string BrkNbr)
        {
            string BasketName = BrkNbr + DateTime.Now.ToString("yyyyMMddHHmmss");
            string[] strCancelledLoanIds = SelectedId.Split(',');
            StringBuilder strLoanIdsXML = new StringBuilder();
            strLoanIdsXML.Append("<SelectedLoanId>");
            foreach (string LoanId in strCancelledLoanIds)
            {
                strLoanIdsXML.Append("<TxnRefNbr>" + LoanId.Trim() + "</TxnRefNbr>");
            }
            strLoanIdsXML.Append("</SelectedLoanId>");

            DataTable dtUploadedBasket = GetCancelledLoanDtlsForReBooking(Convert.ToString(strLoanIdsXML));

            hdnSelectedTab.Value = NEW_BASKET;

            ResetControl(NEW_BASKET);
            //fill country listbox
            GetCountryList();
            if (!String.IsNullOrEmpty(SecType))
            {
                cboCriteriaSecutiyType.SelectedValue = SecType;
            }
            UploadBasketForCancelledLoan(dtUploadedBasket, SecType, BrkNbr);
            EnableFILoanBookingAttributes();   //Added For P-1486
            if (BasketName != string.Empty && BasketName != null)
            {
                txtBasketComment.Text = BasketName;
            }

            if (BrkNbr != string.Empty && BrkNbr != null)
            {
                txtWLBroker.Text = BrkNbr;
                txtBroker_TextChanged(txtWLBroker, null);
            }
        }

