        /// <summary>
        /// Get xml for calculating transmit flag
        /// </summary>
        /// <param name="DT"></param>
        /// <returns></returns>
        private string GetXMLForCalculateTransmitFlag(DataTable DT)
        {
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            //create new instance of XmlDocument
            XmlDocument doc = new XmlDocument();
            bool blnFirstRowProcessed = false;
            string path = string.Empty;
            string strMainNode = string.Empty;
            string xml = string.Empty;

            path = @"/LAVA/XmlTemplates/CalculateTransmit.xml";
            strMainNode = "Transmit";
            MethodName = "GetXMLForCalculateTransmitFlag()";

            try
            {
                //load from file
                XmlTextReader reader = new XmlTextReader(Server.MapPath(path));
                doc.Load(reader);

                //create main node
                XmlNode mainNode = doc.SelectSingleNode(strMainNode);

                int iXmlRowCount = 1;
                int intRowCount = 0;


                for (int iRowCount = 0; iRowCount < DT.Rows.Count; iRowCount++)
                {
                    XmlNode node = doc.CreateNode(XmlNodeType.Element, "FieldName", null);

                    if (blnFirstRowProcessed == true)
                    {
                        for (int i = 0; i < doc.DocumentElement.ChildNodes[iXmlRowCount - 1].Attributes.Count; i++)
                        {
                            if (doc.DocumentElement.ChildNodes[iXmlRowCount - 1].Attributes[i].Name == "RowId")
                            {
                                XmlAttribute att = doc.CreateAttribute("RowId");
                                att.Value = (iXmlRowCount + 1).ToString();
                                node.Attributes.Append(att);
                            }
                            else if (doc.DocumentElement.ChildNodes[iXmlRowCount - 1].Attributes[i].Name == "AsOfDate")
                            {
                                XmlAttribute att = doc.CreateAttribute("AsOfDate");
                                att.Value = txtAsOfDate.Text.Trim();
                                node.Attributes.Append(att);
                            }
                            else if (doc.DocumentElement.ChildNodes[iXmlRowCount - 1].Attributes[i].Name == "SettlementDate")
                            {
                                XmlAttribute att = doc.CreateAttribute("SettlementDate");
                                att.Value = DT.Rows[iRowCount]["SettlementDate"].ToString().Replace("&nbsp;", "").Trim();
                                node.Attributes.Append(att);
                            }
                            else if (doc.DocumentElement.ChildNodes[iXmlRowCount - 1].Attributes[i].Name == "SecCode")
                            {
                                XmlAttribute att = doc.CreateAttribute("SecCode");
                                att.Value = DT.Rows[iRowCount]["SecCode"].ToString().Replace("&nbsp;", "").Trim();
                                node.Attributes.Append(att);
                            }
                            else if (doc.DocumentElement.ChildNodes[iXmlRowCount - 1].Attributes[i].Name == "SecID")
                            {
                                XmlAttribute att = doc.CreateAttribute("SecID");
                                att.Value = DT.Rows[iRowCount]["SecID"].ToString().Replace("&nbsp;", "").Trim();
                                node.Attributes.Append(att);
                            }
                            else if (doc.DocumentElement.ChildNodes[iXmlRowCount - 1].Attributes[i].Name == "BucketSecType")
                            {
                                XmlAttribute att = doc.CreateAttribute("BucketSecType");
                                att.Value = DT.Rows[iRowCount]["BucketSecType"].ToString().Replace("&nbsp;", "").Trim();
                                node.Attributes.Append(att);
                            }
                            else if (doc.DocumentElement.ChildNodes[iXmlRowCount - 1].Attributes[i].Name == "ISOCountry")
                            {
                                XmlAttribute att = doc.CreateAttribute("ISOCountry");
                                att.Value = DT.Rows[iRowCount]["ISOCountry"].ToString().Replace("&nbsp;", "").Trim();
                                node.Attributes.Append(att);
                            }
                        }

                        iXmlRowCount++;
                        mainNode.AppendChild(node);
                    }
                    else if (blnFirstRowProcessed == false)
                    {
                        doc.DocumentElement.ChildNodes[0].Attributes["AsOfDate"].Value = txtAsOfDate.Text.Trim();
                        doc.DocumentElement.ChildNodes[0].Attributes["SettlementDate"].Value = DT.Rows[iRowCount]["SettlementDate"].ToString().Replace("&nbsp;", "").Trim();
                        doc.DocumentElement.ChildNodes[0].Attributes["SecCode"].Value = DT.Rows[iRowCount]["SecCode"].ToString().Replace("&nbsp;", "").Trim();
                        doc.DocumentElement.ChildNodes[0].Attributes["SecID"].Value = DT.Rows[iRowCount]["SecID"].ToString().Replace("&nbsp;", "").Trim();
                        doc.DocumentElement.ChildNodes[0].Attributes["BucketSecType"].Value = DT.Rows[iRowCount]["BucketSecType"].ToString().Replace("&nbsp;", "").Trim();
                        doc.DocumentElement.ChildNodes[0].Attributes["ISOCountry"].Value = DT.Rows[iRowCount]["ISOCountry"].ToString().Replace("&nbsp;", "").Trim();
                        blnFirstRowProcessed = true;
                    }
                    intRowCount++;
                }  //For Loop End


                if (intRowCount == 0)
                {
                    _show_error_row = string.Empty;
                }
                else
                {
                    xml = doc.InnerXml.ToString();
                    _logger.Debug("XML in " + MethodName + ">> " + xml.ToString());
                }
            }
            catch (Exception ex)
            {
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(ex.Message);
                _show_error_row = string.Empty;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
            }
            finally
            {
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
            return xml;
        }

