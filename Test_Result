        {
            MethodName = "ChkSelectALLSecLocAndTransmit_Click";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            try
            {
                if (chkSelectALLSecLocAndTransmit.Checked)
                {
                    foreach (DataGridItem item in grdBookLoanRecords.Items)
                    {
                        DropDownList secLoc = (DropDownList)item.FindControl("cboSecLoc");
                        DropDownList cboSettCCY = (DropDownList)item.FindControl("cboSettCCY"); // Settlement Mode
                        DropDownList cboBookLoanTransmit = (DropDownList)item.FindControl("cboBookLoanTransmit");
                        TextBox txtSettInstruct = (TextBox)item.FindControl("txtSettInstruct");

                        string strWLDepository = item.Cells[(int)enumgrdBookLoanRecordsMapping.WLDepository].Text.Replace("&nbsp;", "");


                        if (cboBookLoanTransmit != null)
                            cboBookLoanTransmit.SelectedValue = cboSelectAllTransmit.SelectedValue;

                        if (secLoc != null)
                        {
                            secLoc.SelectedValue = cboSelectAllSecLocation.SelectedValue;


                            //Populate Settlement mode base on SecLocation 

                            if (secLoc.SelectedValue != "0")
                            {
                                DataSet objDS = new DataSet();
                                Database clsDB = new Database();
                                DataReader clsReader = new DataReader();
                                string[] SqlCondition = new string[6] { "", "", "", "", "", "" };
                                string SMODE = null;

                                if (clsDB.Open() == false)
                                {
                                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                                }
                                else
                                {
                                    clsReader.Connection = clsDB.Connection;
                                    clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance;

                                    // fill up the reason code combo box
                                    clsReader.SqlIdentifier = SqlIdentifier.GET_SETTLEMENT_MODE_INSTR.ToString();

                                    SqlCondition[0] = _BussDate.ToString();
                                    SqlCondition[1] = cboCriteriaSecutiyType.SelectedValue;
                                    SqlCondition[2] = secLoc.SelectedValue;
                                    SqlCondition[3] = strWLDepository;
                                    SqlCondition[4] = rdWorldLendstyle.Checked ? txtWLBroker.Text.Trim() : cboEQLBroker.SelectedValue.ToString();
                                    SqlCondition[5] = cboSettCCY.SelectedValue;


                                    if (clsReader.GetData(ref objDS, SqlCondition) == true)
                                    {
                                        //Bind cboSettCCY Over here
                                        if (objDS != null && objDS.Tables.Count > 0)
                                            SMODE = objDS.Tables[0].Rows[0]["SMODE"].ToString();

                                        if ((cboSettCCY.Items.FindByValue(SMODE) != null) && (!string.IsNullOrEmpty(SMODE)))
                                        {
                                            cboSettCCY.SelectedValue = SMODE;


                                            #region On Change of settlement Mode change settlement Instruction start

                                            if ((cboSettCCY.SelectedValue != "0") && (objDS != null) && (objDS.Tables.Count > 1))
                                                txtSettInstruct.Text = objDS.Tables[1].Rows[0]["SettlInstr"].ToString();
                                            else
                                                txtSettInstruct.Text = string.Empty;

                                            #endregion


                                        }

                                    }
                                }
                            }
                        }
                    } //End of For Loop

                }
                ResetControl(BOOK_BASKET);

            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
                ResetControl(BOOK_BASKET);
            }
            finally
            {
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
        }

