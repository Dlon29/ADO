
private static void CollectViewStateStrings(
    object value,
    List<string> values,
    int depth)
{
    if (value == null || depth > 40 || values.Count >= 10000)
        return;

    // Collect complete strings without combining them.
    string text = value as string;

    if (text != null)
    {
        values.Add(text);
        return;
    }

    // Collect primitive and common scalar values.
    Type valueType = value.GetType();

    if (valueType.IsPrimitive ||
        valueType.IsEnum ||
        value is decimal ||
        value is DateTime ||
        value is Guid)
    {
        values.Add(value.ToString());
        return;
    }

    // Traverse Pair.
    Pair pair = value as Pair;

    if (pair != null)
    {
        CollectViewStateStrings(pair.First, values, depth + 1);
        CollectViewStateStrings(pair.Second, values, depth + 1);
        return;
    }

    // Traverse Triplet.
    Triplet triplet = value as Triplet;

    if (triplet != null)
    {
        CollectViewStateStrings(triplet.First, values, depth + 1);
        CollectViewStateStrings(triplet.Second, values, depth + 1);
        CollectViewStateStrings(triplet.Third, values, depth + 1);
        return;
    }

    // Traverse dictionaries.
    IDictionary dictionary = value as IDictionary;

    if (dictionary != null)
    {
        foreach (DictionaryEntry entry in dictionary)
        {
            if (values.Count >= 10000)
                break;

            CollectViewStateStrings(entry.Key, values, depth + 1);
            CollectViewStateStrings(entry.Value, values, depth + 1);
        }

        return;
    }

    // Traverse collections and arrays.
    IEnumerable items = value as IEnumerable;

    if (items != null)
    {
        foreach (object item in items)
        {
            if (values.Count >= 10000)
                break;

            CollectViewStateStrings(item, values, depth + 1);
        }
    }
}








