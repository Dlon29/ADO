                    uploadFileName = flCollFileUpload.PostedFile.FileName;

                    _logger.Info("Preparing to upload repo/rev repo requests.");
                    // string templateUploadArchivePath = @"\\" + GlobalVariable.AppFileServer + @"\STBUSA APP FILES\INTRA-NET\LAVA\TEMP\";
                    string templateUploadArchivePath = ConfigurationManager.AppSettings["RevRepoTemplateBulkUploadPath"] + @"RevRepoCollateralUploads\";// @"\\" + GlobalVariable.AppFileServerPath + @"TEMP\";

                    string savedFileNamePath = string.Empty;
                    string _ExportPath = templateUploadArchivePath + clsUI.NTUserName + @"\";

                    _ExportPath += DateTime.Now.ToString("MM-dd-yyyy") + @"\";

                    if (!Directory.Exists(_ExportPath))
                    {
                        System.IO.Directory.CreateDirectory(_ExportPath);
                    }

                    savedFileNamePath = _ExportPath + System.IO.Path.GetFileNameWithoutExtension(uploadFileName) + "_" + DateTime.Now.ToString("HHmmss") + System.IO.Path.GetExtension(uploadFileName);
                    flCollFileUpload.PostedFile.SaveAs(savedFileNamePath);

                    //Read Excel Data
                    using (C1XLBook wbExcel = new C1XLBook())
                    {
                        if (Path.GetExtension(savedFileNamePath) == ".xls")
                        {
                            //wbExcel.Load(uploadFileName, FileFormat.Biff8);
                            wbExcel.Load(savedFileNamePath, FileFormat.Biff8);
                        }
                        else
                        {
                            // wbExcel.Load(uploadFileName, FileFormat.OpenXml);
                            wbExcel.Load(savedFileNamePath, FileFormat.OpenXml);
                        }
                        _logger.InfoFormat("savedFileNamePath : {0}", savedFileNamePath);
                        XLSheet sheet = wbExcel.Sheets[0];

                        for (int row = 1; row <= maxNoOfCollateralRows; row++)
                        {
                            //Process the rows till we have data else break
                            if (sheet[row, (int)collSheetSequence.CUSIP].Text != "" || sheet[row, (int)collSheetSequence.ISIN].Text != "")
                            {
                                drCollRow = dtRevRepoCollateralInput.NewRow();

                                drCollRow[(int)RevRepoCollateralsDataTableSequence.SecCode] = sheet[row, (int)collSheetSequence.CUSIP].Text;
                                drCollRow[(int)RevRepoCollateralsDataTableSequence.CUSIP] = sheet[row, (int)collSheetSequence.CUSIP].Text;
                                drCollRow[(int)RevRepoCollateralsDataTableSequence.ISIN] = sheet[row, (int)collSheetSequence.ISIN].Text;
                                drCollRow[(int)RevRepoCollateralsDataTableSequence.FaceAmount] = sheet[row, (int)collSheetSequence.FaceAmount].Text;
                                drCollRow[(int)RevRepoCollateralsDataTableSequence.Principal] = sheet[row, (int)collSheetSequence.Principal].Text;
                                drCollRow[(int)RevRepoCollateralsDataTableSequence.Remarks] = sheet[row, (int)collSheetSequence.Remarks].Text;

                                dtRevRepoCollateralInput.Rows.Add(drCollRow);
                            }
                            else
                            {
                                break;
                            }
                        }
                    }

                    ViewState[CONST_VWSTATE_REVREPOCOLLATERALS] = dtRevRepoCollateralInput;

                    if (dtRevRepoCollateralInput.Rows.Count > 0)
                    {
                        RefreshCollateralSecurities();
                    }
                }
                else
                {
                    _ErrorString = new StringBuilder();
                    _ErrorString.Append("<a>" + Common.GetMessage("SingleLoanBooking", "ErrorSelectCollateralFile") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                    _show_error_row = "";
                }
            }
            catch (Exception ex)
            {
                _logger.Error(ex.Message);
                _logger.ErrorFormat(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
                throw ex;
            }

            finally
            {
                flCollFileUpload.PostedFile.InputStream.Flush();
                flCollFileUpload.PostedFile.InputStream.Close();
                flCollFileUpload.PostedFile.InputStream.Dispose();
            }
        }

        /// <summary>
        /// Refresh the Collateral Securities grid. Highlight the missing Securities
        /// </summary>
        private void RefreshCollateralSecurities()
        {
            XElement xmlSecurityList;
            DataSet dsRevRepoCollateralInput;
            string collXML, repoTicketBrokerID, InvalidSecCodeList;

            xmlSecurityList = new XElement(CONST_XML_NODE_COLLSECURITYLIST);

            try
            {
                dtRevRepoCollateralInput = (DataTable)ViewState[CONST_VWSTATE_REVREPOCOLLATERALS];

                foreach (DataRow rowCollSec in dtRevRepoCollateralInput.Rows)
                {
                    xmlSecurityList.Add(new XElement(CONST_XML_NODE_COLLSECURITY,
                                        new XAttribute(CONST_XML_ELEMENT_SECURITY_ISIN, rowCollSec[RevRepoCollateralsDataTableSequence.ISIN.ToString()]),
                                        new XAttribute(CONST_XML_ELEMENT_SECURITY_CUSIP, rowCollSec[RevRepoCollateralsDataTableSequence.CUSIP.ToString()]),
                                        new XAttribute(CONST_XML_ELEMENT_SECURITY_FACEAMOUNT, rowCollSec[RevRepoCollateralsDataTableSequence.FaceAmount.ToString()]),
                                        new XAttribute(CONST_XML_ELEMENT_SECURITY_PRINCIPAL, rowCollSec[RevRepoCollateralsDataTableSequence.Principal.ToString()]),
                                        new XAttribute(CONST_XML_ELEMENT_SECURITY_REMARKS, rowCollSec[RevRepoCollateralsDataTableSequence.Remarks.ToString()])
                                        ));
                }

                collXML = xmlSecurityList.ToString();
                repoTicketBrokerID = Convert.ToString(hdnRepoTktBrokerID.Value);
                dsRevRepoCollateralInput = CollateralSecurityOperation(txtRRLinkRefNbr.Text, collXML, _RepoTktID, repoTicketBrokerID, collateralInputOperation.REFRESH.ToString());

                if (dsRevRepoCollateralInput != null)
                {
                    if (dsRevRepoCollateralInput.Tables.Count == 1)     //Some Securities does not fall into UST,MBS. Display the validation Error Message 
                                                                        //and do not bind the Collateral/Loan Grid
                    {
                        InvalidSecCodeList = Convert.ToString(dsRevRepoCollateralInput.Tables[0].Rows[0][0]);

                        _ErrorString = new StringBuilder();
                        _ErrorString.Append("<a>" + Common.GetMessage("SingleLoanBooking", "ErrorInvalidSecType") + InvalidSecCodeList + "\n");
                        _ErrorString.Append("</a> <br>\n");
                        _show_error_row = "";
                    }
                    else
                    {
                        //Query will return 2 tables if Valid SecType
                        dtRevRepoCollateralInput = dsRevRepoCollateralInput.Tables[0];
                        ViewState[CONST_VWSTATE_REVREPOCOLLATERALS] = dtRevRepoCollateralInput;
                        dtRevRepoLoanInput = dsRevRepoCollateralInput.Tables[1];
                        ViewState[CONST_VWSTATE_REVREPOLOANS] = dtRevRepoLoanInput;

                        //Validate the Pricipal of Loan Input against the Collateral Input
                        if (ValidatePrincipalMatch() == true)
                        {
                            gvRevRepoCollateralInput.DataSource = dtRevRepoCollateralInput;
                            gvRevRepoCollateralInput.DataBind();
                            gvRevRepoLoanInput.DataSource = dtRevRepoLoanInput;
                            gvRevRepoLoanInput.DataBind();
                        }
                        else
                        {
                            _ErrorString = new StringBuilder();
                            _ErrorString.Append("<a>" + Common.GetMessage("SingleLoanBooking", "ErrorPrincipalMismatch") + "\n");
                            _ErrorString.Append("</a> <br>\n");
                            _show_error_row = "";
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.Error(ex.Message);
                _logger.ErrorFormat(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
                throw ex;
            }
        }

