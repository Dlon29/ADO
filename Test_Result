        /// <summary>
        /// Page Load Event
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void Page_Load(object sender, EventArgs e)
        {
            try
            {
                EventTarget = Request.Form["__EVENTTARGET"] != null ? Request.Form["__EVENTTARGET"].ToString() : string.Empty;
                ViewState["EventTarget"] = EventTarget == string.Empty ? Convert.ToString(ViewState["EventTarget"]) : EventTarget;

                SetModule(ViewState["EventTarget"].ToString());

                _AccessTypeCode = getUserAppAccessTypeCode(_ModuleName, clsUI.NTUserName);
                _AccessTypeCode = _AccessTypeCode == enumUserAccessCode.F.ToString() ? getUserAppAccessTypeCode(_ModuleName, clsUI.NTUserName) : _AccessTypeCode;

                if (Request.QueryString[Common.QRYSTR_PARAM_LENDINGPROCESSTYPE] != null)
                {
                    _LendingProcessType = Request.QueryString[Common.QRYSTR_PARAM_LENDINGPROCESSTYPE];
                }

                if (_AccessTypeCode == enumUserAccessCode.R.ToString())
                {
                    _UserAccess = enumUserAccess.ReadOnly.ToString();
                    EnableDisablePageButtons(false);
                }
                else if (_AccessTypeCode == enumUserAccessCode.N.ToString())
                {
                    Response.Redirect(string.Format(Common.ACCESSDENIEDPAGE, Common.AUTHORIZATIONFAIL, _page));
                }
                else if (_AccessTypeCode == enumUserAccessCode.F.ToString())
                {
                    _UserAccess = enumUserAccess.Full.ToString();
                    EnableDisablePageButtons(true);
                }

                _SecIDExisting = Request["hdnSecIDExisting"];
                legHardBlock.Style.Add("background-color", ConfigurationManager.AppSettings["RepoRequest_HardBlock"]);
                legSoftBlock.Style.Add("background-color", ConfigurationManager.AppSettings["RepoRequest_SoftBlock"]);
                legRejected.Style.Add("background-color", ConfigurationManager.AppSettings["RepoRequest_Rejected"]);

                if (!Page.IsPostBack)
                {
                    //SetEncryptionCode();                    
                    lnkCalTradeDate.HRef = "javascript:OpenCalendar('" + txtTradeDate.ClientID + "', false)";
                    lnkCalSettlementDate.HRef = "javascript:OpenCalendar('" + txtsettlementDate.ClientID + "', false)";
                    lnkCalTermDate.HRef = "javascript:OpenCalendar('" + txtTermDate.ClientID + "', false)";
                    lnkCalUploadedDate.HRef = "javascript:OpenCalendar('" + txtUploadedDate.ClientID + "', false)";
                    txtUploadedDate.Text = _BussDate;
                    txtConfUploadDate.Text = _BussDate;
                    //repoExcelID = Convert.ToInt32(Request.QueryString["RepoExcelID"]);

                    //if (repoExcelID != 0)
                    //    SearchRepoRequest(repoExcelID);

                    if (FillDropDownList("") == false)
                        Response.Write(Common.GetMessage("Common", "ErrorGetComboBox"));

                    if (FillDropDownListConfirmation("") == false)
                        Response.Write(Common.GetMessage("Common", "ErrorGetComboBox"));

                    reloadParent = Request.QueryString["IsPostback"];

                    SearchRepoRequest(0);

                    //if (EventTarget == "RefreshParent")
                    if (reloadParent == "1")
                        SearchRepoRequest(0);
                }

                if (EventTarget == "RCD")
                {
                    RepoConfDash.Attributes.Add("style", "display:inline");
                    RepoReqDash.Attributes.Add("style", "display:none");
                    RepoConfDashboard.Attributes.Add("class", "selected");
                    RepoViewDashboard.Attributes.Add("class", "notselected");
                    SearchRepoConfirmation();
                }
                else if (EventTarget == "RRD")
                {
                    RepoConfDash.Attributes.Add("style", "display:none");
                    RepoReqDash.Attributes.Add("style", "display:inline");
                    RepoViewDashboard.Attributes.Add("class", "selected");
                    RepoConfDashboard.Attributes.Add("class", "notselected");
                    SearchRepoRequest(0);
                }

            }

            catch (Exception ex)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(ex.Message);
                _show_info_row = _ErrorInfoNone;
                _show_error_row = _ErrorInfoBlank;
                log.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, ex));
            }

        }

