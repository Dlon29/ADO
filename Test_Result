        #region Methods
        private IDictionary<int, IReportBuilder> CreateReportBuilderDict()
        {
            try
            {
                IDictionary<int, IReportBuilder> reportBldrs = new Dictionary<int, IReportBuilder>();
                reportBldrs.Add(RPT_ID_DEFAULT, new DefaultReportBuilder()
                {
                    AsOfDate = _asOfDate,
                    InvestmentMgrID = this.InvestmentMgrID,
                    ReportTitle = this._reportTitle,
                    Accounts = _accounts,
                    CreditGroups = _creditGroups,
                    InvestmentManagers = _investmentManagers,
                    LendingLimitBrokerPct = _lendingLimitBrkPct,
                    Loans = _loans
                });

                reportBldrs.Add(RPT_ID_CBJ_LENDING_BALANCE_MONITORING_PQ, new DefaultReportBuilder()
                {
                    AsOfDate = _asOfDate, 
                    InvestmentMgrID = this.InvestmentMgrID,
                    ReportTitle = this._reportTitle,
                    Accounts = _accounts,
                    CreditGroups = _creditGroups,
                    InvestmentManagers = _investmentManagers,
                    LendingLimitBrokerPct = _lendingLimitBrkPct,
                    Loans = _loans
                });

                return reportBldrs;
            }
            catch (Exception ex)
            {
                _logger.Error(ex);
                throw;
            }
        }

        public override string GetTemplateOutput()
        {
            try
            {
                return this.GetExtract();
            }
            catch (Exception ex)
            {

                _logger.Error(ex);
                throw;
            }
        }

        private string GetExtract()
        {
            try
            {
                this.GetDataForReport((SqlDataReader)this._container);
                this.CheckData();
                string workbook = _reportBldrDict[this.ReportID].BuildWorkbookXml();
                return workbook;
            }
            catch (Exception ex)
            {
                _logger.Error(ex);
                throw;
            }
        }

        public byte[] CreateReport()
        {
            this.GetDataForReport((SqlDataReader)this._container);
            this.CheckData();
            byte[] workbook = _reportBldrDict[this.ReportID].BuildC1Workbook();
            return workbook;
        }


