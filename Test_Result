        private void CheckData()
        {
            try
            {
                if (_accounts.Count == 0)
                {
                    _logger.Warn("No accounts found.");
                    throw new ApplicationException("No accounts found on supplied parameters.");
                }

                if (this._creditGroups.Count == 0)
                {
                    _logger.Warn("No credit groups found.");
                    throw new ApplicationException("No credit groups found on supplied parameters.");
                }


                if (!this._reportBldrDict.ContainsKey(this.ReportID))
                {
                    _logger.WarnFormat("There is no report builder associated with the given Report ID. ReportID:{0}", this.ReportID);
                    throw new NotSupportedException(string.Format("There is no report builder associated with the given Report ID. ReportID:{0}", this.ReportID));
                }
            }
            catch (Exception ex)
            {
                _logger.Error(ex);
                throw;
            }

        }
