        /// <summary>
        /// This method will calculate Amount and price on postback
        /// </summary>
        private void CalculateAmountAndPriceOnPostBack()
        {
            //All the below calculations are not applicable for Reverse Repo. So skip these calculations if Loan is Reverse Repo.
            //For Reverse Repo, Traded Price is 1 and Quantity and Amount should be same.
            if (!Is_FI_RevRepo_Ticket_BOOKING)
            {
                if (txtQuantity.Text != "" && txtPrice.Text != "" && (!chkUseAmount.Checked))
                {
                    txtAmmount.Text = (this.litSecType.Text == Common.enumSecType.EQ.ToString() || this.litSecType.Text == Common.enumSecType.RI.ToString())
                                         ? Math.Round((Convert.ToInt64(txtQuantity.Text.Replace(",", "")) * Convert.ToDecimal(txtPrice.Text.Replace(",", ""))), 2).ToString("#,##0.00") //.ToString()//
                                         : Math.Round(((Convert.ToInt64(txtQuantity.Text.Replace(",", "")) * Convert.ToDecimal(txtPrice.Text.Replace(",", ""))) / 100), 2).ToString("#,##0.00");  //.ToString();//

                    txtQuantity.Text = Convert.ToInt64(txtQuantity.Text.Replace(",", "")).ToString("#,##0");
                }

                if (chkUseAmount.Checked && txtAmmount.Text != "" && txtQuantity.Text != "")
                {

                    // Neelima-- change in code to make Price as 7 Decimal 
                    txtPrice.Text = (this.litSecType.Text == Common.enumSecType.EQ.ToString() || this.litSecType.Text == Common.enumSecType.RI.ToString())
                                             ? Math.Round((Convert.ToDecimal(txtAmmount.Text.Replace(",", "")) / Convert.ToInt64(txtQuantity.Text.Replace(",", ""))), 7).ToString("#,##0.00#####")
                                             : Math.Round(((Convert.ToDecimal(txtAmmount.Text.Replace(",", "")) / Convert.ToInt64(txtQuantity.Text.Replace(",", ""))) * 100), 7).ToString("#,##0.00#####");


                    txtQuantity.Text = Convert.ToInt64(txtQuantity.Text.Replace(",", "")).ToString("#,##0");
                }

                // This is added fro GNMA Loans to Calculate the Price after PostBack,, if ChkAmount chekbox is not checked..
                if ((Is_GNMA_MBS_CMO_FI_Loan == true) && txtHairCut.Text != "" && txtFactor.Text != "" && txtCashBidPrice.Text != "" && (!chkUseAmount.Checked) && this.litSecType.Text == Common.enumSecType.FI.ToString())
                {
                    decimal dblPrice = 0;

                    dblPrice = Math.Round((Convert.ToDecimal(txtHairCut.Text.Replace(",", "")) / 100) * (Convert.ToDecimal(txtFactor.Text.Replace(",", ""))) * (Convert.ToDecimal(txtCashBidPrice.Text.Replace(",", ""))), 7);

                    txtPrice.Text = (Math.Ceiling(dblPrice * 8) / 8).ToString("#,##0.00#####");

                    if (txtPrice.Text != "" && txtQuantity.Text != "")
                    {
                        txtAmmount.Text = Math.Round(((Convert.ToInt64(txtQuantity.Text.Replace(",", "")) * Convert.ToDecimal(txtPrice.Text.Replace(",", ""))) / 100), 2).ToString("#,##0.00");  //.ToString();//
                        txtQuantity.Text = Convert.ToInt64(txtQuantity.Text.Replace(",", "")).ToString("#,##0");
                    }
                }

                // This is added fro GNMA Loans to Calculate the Price after PostBack , if ChkAmount chekbox is checked

                if ((Is_GNMA_MBS_CMO_FI_Loan == true) && txtHairCut.Text != "" && txtFactor.Text != "" && txtPrice.Text != "" && (chkUseAmount.Checked) && this.litSecType.Text == Common.enumSecType.FI.ToString())
                {
                    txtCashBidPrice.Text = Math.Round((Convert.ToDecimal(txtPrice.Text.Replace(",", ""))) / ((Convert.ToDecimal(txtFactor.Text.Replace(",", ""))) * (Convert.ToDecimal(txtHairCut.Text.Replace(",", "")) / 100)), 7).ToString("#,##0.00#####");

                    txtQuantity.Text = Convert.ToInt64(txtQuantity.Text.Replace(",", "")).ToString("#,##0");
                }
            }

            if (Is_FI_Repo_Ticket_BOOKING || Is_FI_RevRepo_Ticket_BOOKING)
                RepoTktCalculateCleanPrice(null, null);
        }

