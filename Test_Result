public XLRow Clone()
{
    return new XLRow(_row.Clone());
}



public XLRow Insert(int index, XLRow row)
{
    if (row == null)
        throw new ArgumentNullException("row");

    NativeXLRow insertedRow = _rows.Insert(
        index,
        row.NativeRow);

    return insertedRow == null
        ? null
        : new XLRow(insertedRow);
}



public XLCellRange Add(XLCellRange range)
{
    if (range == null)
        throw new ArgumentNullException("range");

    if (_collection == null)
    {
        throw new NotSupportedException(
            "Adding ranges is supported only for worksheet merged cells.");
    }

    NativeXLCellRange addedRange =
        _collection.Add(range.NativeRange);

    return addedRange == null
        ? null
        : new XLCellRange(addedRange);
}



public XLCellRange(
    int rowFrom,
    int rowTo,
    int columnFrom,
    int columnTo)
{
    _range = new NativeXLCellRange(
        rowFrom,
        rowTo,
        columnFrom,
        columnTo);
}



public int RowFrom
{
    get { return _range.RowFrom; }
}

public int ColumnFrom
{
    get { return _range.ColumnFrom; }
}

public int RowCount
{
    get { return _range.RowCount; }
}

public int ColumnCount
{
    get { return _range.ColumnCount; }
}




