        /// </summary>
        /// <returns></returns>
        private bool GetRecords()
        {
            string[] SqlCondition = new string[7] { "", "", "", "", "", "", "" };
            string Identifier = null;
            int _resultSetPosition = 0;
            int _resultCollCCYPrice = 0;

            // change the identifier and parameter to the stored procedure based on the 
            // reference table ie., actionID
            switch (_ActionID)
            {
                case "GET_EQ_DETAILS":
                case "GET_OTHER_DETAILS":
                    Identifier = "GET_POSITION_DETAILS";
                    break;

                case "GET_FI_DETAILS":
                    Identifier = "GET_POSITION_DETAILS";
                    break;
                case "VIEW_LOAN_DATA":
                    break;
                default:
                    return false;
            }

            // display header information
            SetHeaderInfo(_secType);

            if (_AsOfDate != "")
                SqlCondition[0] = _AsOfDate;
            else
                SqlCondition[0] = _batchRunDate;

            SqlCondition[2] = _secCode.Trim();
            SqlCondition[3] = _secType;
