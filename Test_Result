                    foreach (DataGridItem item in grdBasketAvailRecords.Items)
                    {
                        chkselect = (CheckBox)item.FindControl("chkselect");
                        lnkBasketAvailSecCode = (HyperLink)item.FindControl("lnkBasketAvailSecCode");


                        if (chkselect.Checked)
                        {
                            dr = dtSelectedBasket.Select("SecID =" + item.Cells[(int)enumgrdBasketAvailRecordsMapping.SecID].Text.Trim());

                            if (dr != null && dr.Length > 0)
