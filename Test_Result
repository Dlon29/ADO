        protected void RepoTktCalculateCashpoolRate(object sender, EventArgs e)
        {

            //Calculate Cash Pool rate for Repo
            if (Is_FI_Repo_Ticket_BOOKING || Is_FI_RevRepo_Ticket_BOOKING)
            {
                bool isError = false;
                _ErrorString = new StringBuilder();
                MethodName = "RepoTktCalculateCashpoolRate()";

                try
                {
                    if (this.txtRate.Text.Trim().Length <= 0)
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtRate.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorREBFEE") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                        isError = true;
                    }

                    if (this.txtRate.Text.Trim().Length > 0 && (Convert.ToDouble(txtRate.Text.Trim()) >= Convert.ToDouble(Common.enumRebFeeGoToRateLimit.MAXLIMIT)))
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtRate.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorREBFEEPos") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                        isError = true;
                    }

                    if (this.txtRate.Text.Trim().Length > 0 && (Convert.ToDouble(txtRate.Text.Trim()) <= Convert.ToDouble(Common.enumRebFeeGoToRateLimit.MINLIMIT)))
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtRate.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorREBFEENeg") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                        isError = true;
                    }


                    if (!isError)
                    {
                        if ((cboBroker.SelectedValue != "0") || (!string.IsNullOrEmpty(txtBroker.Text)))
                            RepoCalculateCashPoolRate();
                    }
                    else
                    {
                        if (_ErrorString.Length > 0)
                            _show_error_row = "";
                    }

                }
                catch (Exception Exc)
                {
                    _ErrorString = new StringBuilder("");
                    _ErrorString.Append(Exc.Message);
                    _show_error_row = "";
                    _logger.Debug(Exc.Message);
                    _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));

                }
            }
        }

