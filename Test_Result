        /// <summary>
        ///  Zip files
        /// </summary>
        /// <param name="RecievedFilePath"></param>
        /// <param name="FileName"></param>
        /// <param name="Password"></param>
        /// <returns></returns>
        private void CompressFiles(string RecievedFilePath, string FileName, string Password)
        {
            MethodName = "CompressFiles()";
            try
            {
                FileArchiver archiver = new FileArchiver();
                archiver.SourceFolder = RecievedFilePath + "\\";
                archiver.ArchiveFolder = RecievedFilePath + "\\" + FileName.Trim();
                archiver.ArchiveFileName = RecievedFilePath + "\\" + Path.GetFileNameWithoutExtension(FileName.Trim()) + ".zip";
                archiver.Password = Password;
                archiver.CompressFiles();

                DirectoryInfo directory = new DirectoryInfo(RecievedFilePath);
                List<FileInfo> fileInfos = directory.GetFiles().ToList();

                foreach (FileInfo f in fileInfos)
                {
                    if (Path.GetExtension(f.FullName) == ".xlsx" || Path.GetExtension(f.FullName) == ".xls" || Path.GetExtension(f.FullName) == ".xlsm")
                        File.Delete(f.FullName);
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _show_info_row = _ErrorInfoNone;
                _show_error_row = _ErrorInfoBlank;
                log.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
            }
        }

        /// <summary>
        /// Generate confirmation excel
        /// </summary>
        /// <param name="DS_Result"></param>
        private void GenerateConfirmation(DataSet DS_Result)
        {
            DataTable dtResponse;
            string confFilePath = string.Empty;
            string clientName = string.Empty;
            string templateTypeID = string.Empty;
            StringBuilder strMessage;
            Byte[] bytesRepoExcel = null;
            int NoOfSheets;
            int headerRowNo = Common.RepoDashBoard_headerRowNo;
            int colHeader;
            int confirmationRowNo;
            string _compressPassword = string.Empty;
            string repoExcelID = string.Empty;
            string fileNameLoad = string.Empty;
            string password = string.Empty;

            try
            {
                foreach (DataRow dr in DS_Result.Tables[0].Rows)
                {

                    confFilePath = ConfigurationManager.AppSettings["RepoTemplateConfirmationPath"];// +dr["RepoExcelID"];
                    confFilePath = confFilePath + "\\" + DateTime.Now.Year.ToString() + "\\" + DateTime.Now.Month.ToString() + "\\" + DateTime.Now.Date.Day.ToString();

                    if (!Directory.Exists(confFilePath))
                        System.IO.Directory.CreateDirectory(confFilePath);

                    templateTypeID = dr["TemplateTypeID"].ToString();
                    bytesRepoExcel = (Byte[])dr["RepoExcelFile"];
                    repoExcelID = dr["RepoExcelID"].ToString();
                    password = dr["Password"].ToString();

                    dtResponse = new DataTable("RepoResponse");
                    if (DS_Result.Tables[1].Rows.Count > 0)
                        dtResponse = DS_Result.Tables[1].Select("RepoExcelID = " + dr["RepoExcelID"]).CopyToDataTable();

                    using (C1XLBook wbExcel = new C1XLBook())
                    {
                        fileNameLoad = confFilePath + "\\" + Path.GetFileNameWithoutExtension(dr["FileName"].ToString()) + Path.GetExtension(dr["FileName"].ToString());

                        using (FileStream fsNew = new FileStream(fileNameLoad, FileMode.Create, FileAccess.Write))
                        {
                            fsNew.Write(bytesRepoExcel, 0, bytesRepoExcel.Length);
                        }

                        if (Path.GetExtension(fileNameLoad) == ".xls")
                        {
                            wbExcel.Load(fileNameLoad, FileFormat.Biff8);
                        }
