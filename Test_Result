                    SqlConditionEX[11] = countryList.ToString(); //CountrySelected
                    SqlConditionEX[12] = string.Empty; //SecIdList
                }


                //-----------------------------------------------------

                if (ReportType == CP_REPORT || ReportType == INT_REPORT)
                {
                    SqlCondition[0] = clsReader.SqlIdentifier;

                    if (this.vwSelectedBaskets != null)
                    {
                        DataTable dtBasket = this.vwSelectedBaskets as DataTable;
                        SqlCondition[1] = dtBasket.Rows[0]["BulkNbr"] != DBNull.Value ? dtBasket.Rows[0]["BulkNbr"].ToString() : "";
                        SqlCondition[2] = dtBasket.Rows[0]["VersionNbr"] != DBNull.Value ? dtBasket.Rows[0]["VersionNbr"].ToString() : "";

                    }
                    else
                    {
                        SqlCondition[1] = "";
                        SqlCondition[2] = "";
                    }
                }

                if (SqlCondition[1] == "" || SqlCondition[2] == "" && (ReportType == CP_REPORT || ReportType == INT_REPORT))
                {
                    ConfirmMessage(Common.GetMessage(BASKET_CONFIGURATION, "SaveBasketForReport"));
                }

                else
                {

                    if (ReportType == CP_REPORT || ReportType == INT_REPORT)
                    {
                        // get the data from either current or history table.
                        if (clsReader.GetData(ref objDS, SqlObjects.p_GetData_BulkLoanConfigurationReports, SqlCondition) == false)
                            return false;
                    }

                    if (ReportType == "EXREPORT")
                    {
                        if (clsReader.GetData(ref objDS, SqlObjects.p_GetData_BulkLoanAvailability, SqlConditionEX) == false)
                        {
                            return false;
                        }
                    }

                    Lava.ExcelTemplates.BasketConfigurationReport gxst = null;

                    if (ReportType == CP_REPORT)
                    {
                        gxst = new Lava.ExcelTemplates.BasketConfigurationReport(objDS);
                        gxst.ExtractTemplate = CP_REPORT;
                        fileName = "BulkLoanConfiguration_CPReport_";
                        gxst.ExtractTitle = "Bulk Loan Configuration CP Report";
                    }
                    else if (ReportType == INT_REPORT)
                    {
                        gxst = new Lava.ExcelTemplates.BasketConfigurationReport(objDS);

                        gxst.ExtractTemplate = INT_REPORT;
                        fileName = "BulkLoanConfiguration_INTReport_";
                        gxst.ExtractTitle = "Bulk Loan Configuration INT Report";
                    }
                    else if (ReportType == "EXREPORT")
                    {
                        gxst = new Lava.ExcelTemplates.BasketConfigurationReport(objDS);

                        gxst.ExtractTemplate = "EXREPORT";
                        fileName = "BulkLoanConfiguration_AvailabilityREPORT_";
                        gxst.ExtractTitle = "Bulk Loan Configuration EX REPORT";
                    }

                    gxst.OutputFormat = "FULL";

                    STBUSA.Excel.ExcelReportGenerator erg = new STBUSA.Excel.ExcelReportGenerator(gxst);

                    byte[] temp = erg.Generate();

                    if (temp != null)
                    {
                        IsUI = false;
                        _show_error_row = "NONE";
                        Response.Clear();
                        Response.ClearContent();
                        Response.ClearHeaders();
                        Response.ContentType = "application/xls";
                        Response.AppendHeader("Content-Disposition", "attachment;filename=" + fileName + System.DateTime.Now.ToString("yyyyMMdd") + ".xls");
                        Response.BinaryWrite(temp);
                        Response.Flush();
                    }
                    else
                    {
                        Common.WriteJavascript("alert('" + Common.GetMessage("Common", "NoRecordsFound") + "');");
                    }
                }
            }
            catch (Exception Exc)
            {
                Response.ClearContent();
                Response.ContentType = "text/html";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _show_error_row = string.Empty;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
                return false;
            }
            finally
            {
                clsReader.Dispose();
                clsDB.Dispose();
                objDS.Dispose();
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
            return true;
        }

