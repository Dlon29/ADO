        private List<LendingLimitBrokerPct> CreateLendingLimitBrkPercentage(SqlDataReader lendingLimitBrkPctRdr)
        {
            try
            {
                _logger.DebugFormat("Preparing to read lending limit broker percentage.");
                List<LendingLimitBrokerPct> brokerPercentage = new List<LendingLimitBrokerPct>();
                while (lendingLimitBrkPctRdr.Read())
                {
                    int lendingLimitGrpID = 0;
                    int brkCrGrpID = 0;
                    decimal percentLimit = 0;
                    bool isDefaultPctForEQ = false;
                    bool isDefaultPctForFI = false;

                    LendingLimitBrokerPct brkPct = new LendingLimitBrokerPct()
                    {
                        LendingLimitGrpID = Int32.TryParse(Convert.ToString(lendingLimitBrkPctRdr["LendingLimitGrpID"]), out lendingLimitGrpID) ? lendingLimitGrpID : 0,
                        BrkCrGrpID = Int32.TryParse(Convert.ToString(lendingLimitBrkPctRdr["BrkCrGrpID"]), out brkCrGrpID) ? brkCrGrpID : 0,
                        PercentLimit = decimal.TryParse(Convert.ToString(lendingLimitBrkPctRdr["PercentLimit"]), out percentLimit) ? percentLimit : 0,
                        IsDefaultPctForEQ = bool.TryParse(Convert.ToString(lendingLimitBrkPctRdr["IsDefaultPctForEQ"]), out isDefaultPctForEQ) ? isDefaultPctForEQ : false, 
                        IsDefaultPctForFI = bool.TryParse(Convert.ToString(lendingLimitBrkPctRdr["IsDefaultPctForFI"]), out isDefaultPctForFI) ? isDefaultPctForFI : false
                    };

                    brokerPercentage.Add(brkPct);
                }
                return brokerPercentage;
            }
            catch (Exception ex)
            {
                _logger.Error(ex);
                throw;
            }
        }

