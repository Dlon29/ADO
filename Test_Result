                        _EQgrdBrokerLendableSum += Convert.ToInt64(((Label)e.Item.Cells[(int)grdEQMapping.AllocatedQtyRestricted].FindControl("lblAvailableQty")).Text.Replace(",", "").Trim());

                    if (((TextBox)e.Item.Cells[(int)grdEQMapping.FaceAmount].FindControl("txtUnitsAllocated")).Text.Replace(",", "").Trim() != "")
                        _EQgrdUnitsLeandableSum += Convert.ToInt64(((TextBox)e.Item.Cells[(int)grdEQMapping.FaceAmount].FindControl("txtUnitsAllocated")).Text.Replace(",", "").Trim());

                }


                if (e.Item.ItemType == ListItemType.Footer)
                {
                    if (_EQitmLoanCount < 2)
                        e.Item.Visible = false;
                    else
                    {
                        e.Item.Cells[(int)grdEQMapping.IsIndemnified].Text = "TOTAL:";
                        e.Item.Cells[(int)grdEQMapping.IsIndemnified].HorizontalAlign = HorizontalAlign.Right;


                        // Total Units
                        e.Item.Cells[(int)grdEQMapping.AcctAvailibityRem].Text = string.Format("{0:#,##0}", _EQgrdTraderLendableSum);
                        e.Item.Cells[(int)grdEQMapping.AcctAvailibityRem].HorizontalAlign = HorizontalAlign.Right;

                        e.Item.Cells[(int)grdEQMapping.AllocatedQtyRestricted].Text = string.Format("{0:#,##0}", _EQgrdBrokerLendableSum);
                        e.Item.Cells[(int)grdEQMapping.AllocatedQtyRestricted].HorizontalAlign = HorizontalAlign.Right;

                        e.Item.Cells[(int)grdEQMapping.FaceAmount].Text = string.Format("{0:#,##0}", _EQgrdUnitsLeandableSum);
                        e.Item.Cells[(int)grdEQMapping.FaceAmount].HorizontalAlign = HorizontalAlign.Right;

                    }
                }


            }
            catch (Exception Exc)
            {
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
        }

