                }

                if (clsReader.GetData(ref ds, SqlCondition) == false)
                {
                    blnStatus = false;
                    _logger.Debug(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                    throw new Exception(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                }
                else
                {
                    blnStatus = true;
                }

                for (int iRowCount = 0; iRowCount < ds.Tables[0].Rows.Count; iRowCount++)
