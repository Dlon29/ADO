        for (j = 0; j < arrCount2; j++) {
            objControl = inpControls[j];

            //proceed if the child is valid one
            if (blnMismatchFound == false) {
                if (objControl != null) {
                    if (objControl.id.indexOf("txtSelectedAsOfDate") != -1) {
                        asofdate = new Date(objControl.value);
                        if (asofdate < g1BussDate) {
                            blnMismatchFound = true;
                            if (confirm('As of Date is less than Bussiness Date. \nDo you want to continue?')) {
                                document.getElementById("hdnValidateAsOfDate").value = "Yes";                            
                            } else {
                                document.getElementById("hdnValidateAsOfDate").value = "No";
                            }
                        }
                        else {
                            document.getElementById("hdnValidateAsOfDate").value = "Yes";
                        }
                    }
                }
            }
        }

    

    }

    function ConfirmationonBookLoan() {
        if ($("#hdnValidateAsOfDate").val() == "Yes") {
            var filteredRowList = $("#grdSelectedBasket tr");
            var isDMCSecurityTrue = '1';

            if (filteredRowList.length > 0) {
                var hdnDMCSecurity = filteredRowList.has("input[id*='hdnDMCFISecurity'][value='" + isDMCSecurityTrue + "']");

                if (hdnDMCSecurity.length > 0) {
                    if (confirm("Security is also part of Dedicated Margin Collateral for one or more allocated account groups, are you sure you want to proceed?")) {
                        $("#hdnValidateDMCSecurity").val("Yes");
                    }
                    else {
                        $("#hdnValidateDMCSecurity").val("No");
                    }
                }

                if ($("#hdnValidateDMCSecurity").val() == '' || $("#hdnValidateDMCSecurity").val() == "Yes") {
                    var hdnSecMatured = filteredRowList.has("input[id*='hdnSecMatured'][value='" + isDMCSecurityTrue + "']");

                    if (hdnSecMatured.length > 0) {
                        if (confirm("Security maturity is within 30 days of trade date, are you sure you want to proceed?")) {
                            $("#hdnValidateIsFISecurityMatured").val("Yes");
                        }
                        else {
                            $("#hdnValidateIsFISecurityMatured").val("No");
                        }
                    }
                }

            }
        }
    }

    function fnSetDefaultTPUID(termDate) {
      
        var row = $("#" + termDate.id).closest('tr');
        if (row != null || row != undefined) {
            var defaultOpenTPUID = row.find("input[id*='hdnSelDefaultOpenTPUID']");
            var defaultTermTPUID = row.find("input[id*='hdnSelDefaultTermTPUID']");
            var drpTPUID = row.find("select[id*='drpTPUID']");
            
            if (termDate.value == '') {
                if (defaultOpenTPUID.length > 0) {
                    drpTPUID.val(defaultOpenTPUID.val());
                }
            }
            else {
                if (defaultTermTPUID.length > 0) {
                    drpTPUID.val(defaultTermTPUID.val());                   
                }
            }
        }
    }

</Script>
