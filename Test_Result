                        hdnTotalIndNonIndUnitsRestrictedRem.Value = objDS.Tables[2].Rows[0]["TotalIndNonIndUnitsRestrictedRem"].ToString();
                        hdnIsUnitsAvail.Value = objDS.Tables[2].Rows[0]["IsUnitsAvail"].ToString();

                        /* 01/27/2012 : This functionality is no more req because WL does not allow more then 50 mln loan booking. If in future this func is required, just uncommnet this part.*/
                        //Uncommenting the code
                        if ((IsLoanBreak) && (this._secType == Common.enumSecType.FI.ToString()))
