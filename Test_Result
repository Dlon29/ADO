        [WebMethod]
        [System.Web.Script.Services.ScriptMethod(UseHttpGet = false)]
        public static string GetSecurityPriceInCollCCY(string collCCYCode)
        {
            JavaScriptSerializer Serializer = new JavaScriptSerializer();
            string jsonres = string.Empty;
            DataTable dt_CollCCYPriceMatrix;
            DataRow[] dr_CollCurrency;
            string price;

            try
            {
                dt_CollCCYPriceMatrix = (DataTable)HttpContext.Current.Session[CONST_SESSSION_SECPRICETABLE];
                dr_CollCurrency = dt_CollCCYPriceMatrix.Select("CollCCY='" + collCCYCode + "'");

                if (dr_CollCurrency.Length > 0)
                {
                    price = Convert.ToString(dr_CollCurrency[0]["CollCCYPrice"]);
                }
                else
                {
                    price = "";
                }

                jsonres = Serializer.Serialize(price);

                return jsonres;
            }
            catch (Exception Exc)
            {
                ApplicationLogger _logger = new ApplicationLogger();
                _logger.WriteLog(ApplicationLogger.MsgType.Error, Exc.Message);
                throw new Exception("<font class=\"ErrorMsg\">" + Exc.Message + "</font>");

            }
        }
