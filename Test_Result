        /// <summary>
        /// Compare the Principal of Total Loan against the Sum of Pricipal of Collateral Input. 
        /// </summary>
        /// <returns></returns>
        private bool ValidatePrincipalMatch()
        {
            bool isPrincipalMatch = true;
            decimal loanTotalPrincipal, collInputTotalPrincipal;

            try
            {
                dtRevRepoCollateralInput = (DataTable)ViewState[CONST_VWSTATE_REVREPOCOLLATERALS];
                loanTotalPrincipal = Math.Round(Convert.ToDecimal(txtAmmount.Text), 2);

                collInputTotalPrincipal = Math.Round(dtRevRepoCollateralInput.AsEnumerable()
                                                        .Sum(x => x.Field<Decimal>(RevRepoCollateralsDataTableSequence.Principal.ToString())), 2);

                if (loanTotalPrincipal == collInputTotalPrincipal)
                    isPrincipalMatch = true;
                else
                    isPrincipalMatch = false;

                return isPrincipalMatch;
            }
            catch (Exception ex)
            {
                _logger.Error(ex.Message);
                _logger.ErrorFormat(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
                throw ex;
            }
        }

        /// <summary>
        /// Validate whether the Collateral Security is present in Reference database.
        /// </summary>
        /// <returns></returns>
        private bool ValidateCollateralSecurity()
        {
            bool isValid = false;
            DataRow[] inValidSecurities;

            try
            {
                dtRevRepoCollateralInput = (DataTable)ViewState[CONST_VWSTATE_REVREPOCOLLATERALS];
                inValidSecurities = dtRevRepoCollateralInput.Select("IsValid=0");

                if (inValidSecurities.Length > 0)
                {
                    isValid = false;
                }
                else
                {
                    isValid = true;
                }

                return isValid;
            }
            catch (Exception ex)
            {
                _logger.Error(ex.Message);
                _logger.ErrorFormat(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
                throw ex;
            }
        }

