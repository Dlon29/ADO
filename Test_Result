            DataGridItem dgi = null;

            for (int iRowCount = 0; iRowCount < grdFIRecords.Items.Count; iRowCount++)
            {
                dgi = grdFIRecords.Items[iRowCount];


                UnitsAllocated = ((TextBox)dgi.Cells[(int)grdMapping.FaceAmount].FindControl("txtUnitsAllocated")).Text.Replace(",", "").Trim();

                if (UnitsAllocated == string.Empty)
