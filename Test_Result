        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void EnableDisableTradeConfirmation(object sender, EventArgs e)
        {
            try
            {
                hdnSelectedTab.Value = "BookLoan";
                ResetControl(BOOK_BASKET);
                lstConfirmationEmailAddress.Enabled = !(((CheckBox)sender).Checked);

                //If Supress is checked then display the email addresses fetched from database
                if (((CheckBox)sender).Checked == true)
                {
                    foreach (ListItem item in lstConfirmationEmailAddress.Items)
                    {
                        item.Selected = true;
                    }
                }
            }
            catch (Exception Exc)
            {
                _show_error_row = "";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
        }

