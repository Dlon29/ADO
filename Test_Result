                            hdnPriceUSD.Value = txtPrice.Text = Convert.ToDecimal(dtSecInfo.Rows[0]["PriceUSD"]).ToString("#,##0.00#####");

                        if (dtSecInfo.Rows[0]["CcyCode"].ToString().ToUpper() != Common.DefaultCollateralCCY.USD.ToString())
