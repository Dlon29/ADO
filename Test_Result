                    string SecCode = litCountryCode.Text == "US" ? dtSecInfo.Rows[0]["CUSIP"].ToString() : (Convert.IsDBNull(dtSecInfo.Rows[0]["SEDOL"]) == false && dtSecInfo.Rows[0]["CUSIP"].ToString().Length > 0) ? dtSecInfo.Rows[0]["SEDOL"].ToString() : dtSecInfo.Rows[0]["ISIN"].ToString();

                    // will happen if user trying to see the blocked one
                    if (dtSecInfo.Rows[0]["UnitsTotal"] != DBNull.Value)
                        litTotalUnits.Text = Convert.ToDecimal(dtSecInfo.Rows[0]["UnitsTotal"]).ToString("#,##0");
                    else
                        litTotalUnits.Text = "N/A";	// only if all the account are blocked

                    if (dtSecInfo.Rows[0]["UnitsLendable"] != DBNull.Value)
                    {
                        decimal _TotalLendable = Convert.ToDecimal(dtSecInfo.Rows[0]["UnitsLendable"]);

                        if (_TotalLendable < 0)
                            litTotalLendable.Text = "<font color = 'red'>" + _TotalLendable.ToString("#,##0") + "</font>";
                        else
                            litTotalLendable.Text = _TotalLendable.ToString("#,##0");
                    }
                    else
                        litTotalLendable.Text = "N/A";	// only if all the account are blocked

                    Is_GNMA_MBS_CMO_FI_Loan = (dtSecInfo.Rows[0]["IS_GNMA_MBS_CMO_Security"] != DBNull.Value && dtSecInfo.Rows[0]["IS_GNMA_MBS_CMO_Security"].ToString().Length > 0) ? Convert.ToBoolean(dtSecInfo.Rows[0]["IS_GNMA_MBS_CMO_Security"]) : false;
