                        txtRejectComments.Visible = true;
                        lblRejectComments.Visible = true;
                    }

                    //Apply Color  Coding Logic Over here
                    strXMLData.Append(dsUserType.Tables[0].Rows[0]["DataFieldXML"].ToString());

                }
                else  // if no Row present then for the first time user is Booking / Saving the Loan info from screen.
                    _UserRoleMakerOrChecker = Common.enumUserMakerCheckerRole.MAKER.ToString();

                if ((dsUserType != null) && (dsUserType.Tables.Count > 0) && (dsUserType.Tables[1].Rows.Count > 0))
                {
                    FinderValue = dsUserType.Tables[1].Rows[0]["FinderNbr"].ToString();
                    hdnRepoIsAccruedInterestRequired.Value = dsUserType.Tables[1].Rows[0]["IsAccruedInterestRequired"].ToString();
                    hdnRepoIsLIBORRateRequired.Value = dsUserType.Tables[1].Rows[0]["LIBORRateRequired"].ToString();

                    if (!string.IsNullOrEmpty(FinderValue))
                    {
                        // If Finder is not applicable for  Account then don;t dispaly it.
                        for (int i = cboFinder.Items.Count - 1; i >= 0; i--)
                        {
                            if (cboFinder.Items[i].Value != FinderValue) cboFinder.Items.RemoveAt(i);
                        }
                    }

                    if (this.cboFinder.Items.FindByValue(FinderValue) != null)
                        this.cboFinder.SelectedValue = FinderValue;

                    if ((hdnRepoIsLIBORRateRequired != null) && (hdnRepoIsLIBORRateRequired.Value == "False"))
                    {
                        this.txtLIBORRate.Style.Add(stcBackColor, strNonMandatoryBackColor);
                        this.txtLIBORRate.Enabled = false;
                        this.BtnCalculateLIBORRate.Enabled = false;
                    }
                    else
                    {
                        this.txtLIBORRate.Style.Add(stcBackColor, strMandatoryBackColor);
                        this.txtLIBORRate.Enabled = true;
                        this.BtnCalculateLIBORRate.Enabled = true;

                        //calculate Libor Rate 
                        if ((cboCollCCY.SelectedValue != "0") && (txtTermDate.Text.Trim() != ""))
                            CalculateLIBORRate();
                    }

                    //  Other than OwnRepo booking , ClenaPrice nad AccInterest is Mandetory are requried for booking
                    if ((hdnRepoIsAccruedInterestRequired != null) && (hdnRepoIsAccruedInterestRequired.Value == "True") && (Is_CLO_REPO == false))
                    {
                        this.txtAccruedInterest.Style.Add(stcBackColor, strMandatoryBackColor);
                        this.txtCleanPrice.Style.Add(stcBackColor, strMandatoryBackColor);
                        this.txtAccruedInterest.Enabled = true;
                    }
                    else
                    {
                        this.txtAccruedInterest.Style.Add(stcBackColor, strNonMandatoryBackColor);
                        this.txtCleanPrice.Style.Add(stcBackColor, strNonMandatoryBackColor);
                        this.txtAccruedInterest.Enabled = false;
                    }
                }

                //2nd Table Contains Rate for Smart Check Validation
                if ((dsUserType != null) && (dsUserType.Tables.Count > 0) && (dsUserType.Tables[2].Rows.Count > 0))
                {
                    hdnValidateRateForBooking.Value = dsUserType.Tables[2].Rows[0]["MaxRateAllowed"].ToString();
                }

                //3rd Table Contains Price Percentage for Smart Check Validation
                if ((dsUserType != null) && (dsUserType.Tables.Count > 0) && (dsUserType.Tables[3].Rows.Count > 0))
                {
                    if (dsUserType.Tables[3].Rows[0]["PricePercentage"] != null)
                    {
                        if (litCcyCode.Text == Common.DefaultCollateralCCY.USD.ToString() && (!string.IsNullOrEmpty(litPriceUSD.Text)))
                            hdnValidatePriceForBooking.Value = (Convert.ToDecimal(litPriceUSD.Text) + (Convert.ToDecimal(litPriceUSD.Text) * Convert.ToDecimal(dsUserType.Tables[3].Rows[0]["PricePercentage"].ToString()) / 100)).ToString("#,##0.#######");

                        if (litCcyCode.Text == Common.DefaultCollateralCCY.EUR.ToString() && (!string.IsNullOrEmpty(litPriceEURO.Text)))
                            hdnValidatePriceForBooking.Value = (Convert.ToDecimal(litPriceEURO.Text) + (Convert.ToDecimal(litPriceEURO.Text) * Convert.ToDecimal(dsUserType.Tables[3].Rows[0]["PricePercentage"].ToString()) / 100)).ToString("#,##0.#######");

                        //Added for fetching price for the new Coll CCY's and Loan Category = CR
                        if (this._secType == Common.enumSecType.FI.ToString() && this.cboLoanCategory.SelectedValue == enumLoanCategory.CR.ToString())
                        {
                            //Repo Loan scenario
                            //If Sec CCY is not USD/EUR and value is not calculated with above 2 statements then caluclate by using the CollCCYPrice.
                            if ((string.IsNullOrEmpty(hdnValidatePriceForBooking.Value)))
                            {
                                string collCCYPrice = hdnCollCCYPrice.Value == "" ? "0" : hdnCollCCYPrice.Value;
                                hdnValidatePriceForBooking.Value = (Convert.ToDecimal(collCCYPrice) + (Convert.ToDecimal(collCCYPrice) * Convert.ToDecimal(dsUserType.Tables[3].Rows[0]["PricePercentage"].ToString()) / 100)).ToString("#,##0.#######");
                            }

                            if ((string.IsNullOrEmpty(litPriceEURO.Text)) && (string.IsNullOrEmpty(litPriceUSD.Text)) && (string.IsNullOrEmpty(hdnCollCCYPrice.Value)) && (!string.IsNullOrEmpty(litPrice.Text)))
                                hdnValidatePriceForBooking.Value = (Convert.ToDecimal(litPrice.Text) + (Convert.ToDecimal(litPrice.Text) * Convert.ToDecimal(dsUserType.Tables[3].Rows[0]["PricePercentage"].ToString()) / 100)).ToString("#,##0.#######");
                        }
                        else
                        {
                            ///SecLending Loan scenario
                            if ((string.IsNullOrEmpty(litPriceEURO.Text)) && (string.IsNullOrEmpty(litPriceUSD.Text)) && (!string.IsNullOrEmpty(litPrice.Text)))
                                hdnValidatePriceForBooking.Value = (Convert.ToDecimal(litPrice.Text) + (Convert.ToDecimal(litPrice.Text) * Convert.ToDecimal(dsUserType.Tables[3].Rows[0]["PricePercentage"].ToString()) / 100)).ToString("#,##0.#######");
                        }

                        if (string.IsNullOrEmpty(hdnValidatePriceForBooking.Value))
                            hdnValidatePriceForBooking.Value = "0";
                    }
                }


                if (_UserRoleMakerOrChecker == Common.enumUserMakerCheckerRole.MAKER.ToString())
                {
                    this.cmdAllocate.Visible = true;
                    this.btnSaveLoanInfo.Visible = true;
                    this.btnSendForApproval.Visible = true;
                    this.btnSaveLoanInfo.Enabled = true;

                    this.btnApprove.Visible = false;
                    this.btnReject.Visible = false;
                    this.cmdClear.Visible = true;

                    txtRejectComments.ReadOnly = true;

                    //For Maker all Pre-populated Controls should be disable
                    RepoTicketDisableControlForMaker(false);
                    RepoTicketDisplayPreFilledControl(false);
                }
                else if (_UserRoleMakerOrChecker == Common.enumUserMakerCheckerRole.CHECKER.ToString())
                {
                    this.cmdAllocate.Visible = false;
                    this.btnSaveLoanInfo.Enabled = false;
                    this.btnSaveLoanInfo.Visible = false;
                    this.btnSendForApproval.Visible = false;

                    this.btnApprove.Visible = true;
                    this.btnReject.Visible = true;
                    this.cmdClear.Visible = false;

                    //Disable the Link buttons added for Collateral Upload operations for Reverse Repo
                    if (Is_FI_RevRepo_Ticket_BOOKING)
                    {
                        this.lnkUploadCollateral.Enabled = false;
                        if (lnkUploadCollateral.OnClientClick != null)
                        {
                            lnkUploadCollateral.OnClientClick = null;
                        }

                        this.lnkRefeshCollateral.Enabled = false;
                        this.lnkDeleteCollateral.Enabled = false;
                    }

                    // Here for Checker Disable all the controls from the Page
                    DisableForm(Page.Controls);

                    #region After Disable all Controls from Page, Enable requried Control for checker

                    //we are calling this because the prefilled controls should be disaply in different color, for Checker Also
                    RepoTicketDisplayPreFilledControl(false);

                    this.grdFIRecords.Enabled = false;
                    this.btnApprove.Enabled = true;
                    this.btnReject.Enabled = true;
                    this.txtLoanProcessStatus.Enabled = true;
                    refAsOfDate.HRef = "";
                    refTermDate.HRef = "";
                    refSetelmentDate.HRef = "";
                    this.txtRejectComments.Visible = true;
                    this.lblRejectComments.Visible = true;
                    this.txtRejectComments.Enabled = true;
                    txtRejectComments.ReadOnly = false;

                    this.txtLoanProcessStatus.Font.Bold = false;
                    this.txtRejectComments.Font.Bold = false;

                    #endregion


                    #region  //For Checker Check Data and Display in different color Code
                    if (!(string.IsNullOrEmpty(strXMLData.ToString())))
                    {
                        stream = new StringReader(strXMLData.ToString());
                        // Load the XmlTextReader from the stream
                        reader = new XmlTextReader(stream);
                        xmlDS.ReadXml(reader);
                        RepoTicketShowMismatchFields(xmlDS);
                    }
                    #endregion

                }
            }
            catch (Exception Exc)
            {
                Response.ClearContent();
                Response.ContentType = "text/html";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));

            }
        }

