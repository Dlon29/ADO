    #region C1XLBook

    public sealed class C1XLBook : IDisposable
    {
        private readonly NativeC1XLBook _book;
        private bool _disposed;

        internal NativeC1XLBook NativeBook
        {
            get
            {
                EnsureNotDisposed();
                return _book;
            }
        }

        public C1XLBook()
        {
            _book = new NativeC1XLBook();
        }

        public void Load(string filePath)
        {
            EnsureNotDisposed();
            _book.Load(filePath);
        }

        public void Load(string filePath, FileFormat format)
        {
            EnsureNotDisposed();

            _book.Load(filePath, ToNativeFileFormat(format));
        }

        public void Load(Stream stream)
        {
            EnsureNotDisposed();
            _book.Load(stream);
        }

        public void Save(string filePath)
        {
            EnsureNotDisposed();
            _book.Save(filePath);
        }

        public void Save(string filePath, FileFormat format)
        {
            EnsureNotDisposed();

            _book.Save(filePath, ToNativeFileFormat(format));
        }

        public int SheetCount
        {
            get
            {
                EnsureNotDisposed();
                return _book.Sheets.Count;
            }
        }

        public XLSheets Sheets
        {
            get
            {
                EnsureNotDisposed();
                return new XLSheets(_book.Sheets);
            }
        }

        public XLNamedRangeCollection NamedRanges
        {
            get
            {
                EnsureNotDisposed();

                if (_book.NamedRanges == null)
                    return null;

                return new XLNamedRangeCollection(_book.NamedRanges);
            }
        }

        private static NativeFileFormat ToNativeFileFormat(
            FileFormat format)
        {
            switch (format)
            {
                case FileFormat.Biff8:
                    return NativeFileFormat.Biff8;

                case FileFormat.OpenXml:
                    return NativeFileFormat.OpenXml;

                case FileFormat.OpenXmlMacro:
                    return NativeFileFormat.OpenXmlMacro;

                default:
                    throw new ArgumentOutOfRangeException("format");
            }
        }

        private void EnsureNotDisposed()
        {
            if (_disposed)
                throw new ObjectDisposedException("C1XLBook");
        }

        public void Dispose()
        {
            if (_disposed)
                return;

            IDisposable disposable = (object)_book as IDisposable;

            if (disposable != null)
                disposable.Dispose();

            _disposed = true;
        }
    }

