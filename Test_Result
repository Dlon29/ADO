                    TextBox txtSettlementDate = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.SettlementDate].FindControl("txtSettlementDate");
                    TextBox txtSelectedAsOfDate = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.AsofDate].FindControl("txtSelectedAsOfDate");

