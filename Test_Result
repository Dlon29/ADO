        protected void HideShowOverrideBrkCrLimit()
        {
            Database clsDB = new Database();
            MethodName = "HideShowOverrideBrkCrLimit()";
            try
            {
                DataSet objDSBrkCrLmt = new DataSet();
                DataReader clsReader = new DataReader();
                string[] SqlCondition;


                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                }

                clsReader.Connection = clsDB.Connection;

                SqlCondition = new string[1] { ""};


                clsReader.SqlIdentifier = SqlIdentifier.GET_OVERIDE_BRK_CRD_LMT_FLAG.ToString();
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance;

                if (clsReader.GetData(ref objDSBrkCrLmt, SqlCondition) == false)
                    return;
                hdnShowBrkCrLimit.Value = objDSBrkCrLmt.Tables[0].DefaultView.ToTable().Rows[0]["OverrideBrkCRLMTFlag"].ToString().ToUpper();
                if (hdnShowBrkCrLimit.Value == "TRUE" && (this._secType == Common.enumSecType.FI.ToString()))
                {
                    lblBrkCrLimit.Visible = true;
                    chkOverrideBrkCreditLmt.Visible = true;
                }
                else
                {
                    lblBrkCrLimit.Visible = false;
                    chkOverrideBrkCreditLmt.Visible = false;
                    chkOverrideBrkCreditLmt.Checked = false;
                }

            }
            catch (Exception Exc)
            {
                string Logmessage = "Error in "+ MethodName;
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                _logger.Debug(Logmessage);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));

            }
        }
