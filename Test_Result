using NativeXLRowCollection = C1.C1Excel.XLRowCollection;
using NativeXLRow = C1.C1Excel.XLRow;
using NativeXLColumnCollection = C1.C1Excel.XLColumnCollection;
using NativeXLColumn = C1.C1Excel.XLColumn;
using NativeXLPrintSettings = C1.C1Excel.XLPrintSettings;






public sealed class XLRows
{
    private readonly NativeXLRowCollection _rows;

    internal XLRows(NativeXLRowCollection rows)
    {
        _rows = rows;
    }

    public int Count
    {
        get { return _rows.Count; }
    }

    public XLRow this[int index]
    {
        get
        {
            NativeXLRow row = _rows[index];
            return row == null ? null : new XLRow(row);
        }
    }

    public void Add()
    {
        _rows.Add();
    }

    public void RemoveAt(int index)
    {
        _rows.RemoveAt(index);
    }
}

public sealed class XLRow
{
    private readonly NativeXLRow _row;

    internal XLRow(NativeXLRow row)
    {
        _row = row;
    }

    public int Height
    {
        get { return _row.Height; }
        set { _row.Height = value; }
    }
}








