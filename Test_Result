        /// <summary>
        /// Timer tick event
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void Timer1_Tick(object sender, EventArgs e)
        {
            Database db = new Database();
            DataReader clsReader = new DataReader();
            Hashtable htMain = new Hashtable();
            DataSet loanStatusDtst = new DataSet();
            MethodName = "Timer1_Tick()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            string statusDesc = "";

            try
            {
                if (db.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "TimerTickFailedToOpenDB"));
                    throw new Exception(Common.GetMessage("Common", "TimerTickFailedToOpenDB"));
                }

                clsReader.Connection = db.Connection;

                DataGridItem dgi = null;
                string secID = string.Empty;
                TextBox txtLoanReqStatus = null;
                DataRow[] drSecID = null;

                string[] SqlCondition = new string[1];
                SqlCondition[0] = hdnSourceID.Value;


                if (clsReader.GetData(ref loanStatusDtst, SqlObjects.op_LoanRequestStatusReport, SqlCondition) != false)
                {
                    if (loanStatusDtst.Tables[0].Rows.Count > 0)
                    {
                        this.ajxTimer.Enabled = false;

                        for (int iRowCount = 0; iRowCount < grdBookLoanRecords.Items.Count; iRowCount++)
                        {
                            dgi = this.grdBookLoanRecords.Items[iRowCount];

                            txtLoanReqStatus = (TextBox)dgi.Cells[(int)enumgrdBookLoanRecordsMapping.LoanReqStatus].FindControl("txtLoanReqStatus");
                            secID = dgi.Cells[(int)enumgrdBookLoanRecordsMapping.SecID].Text.Replace("&nbsp;", "");

                            drSecID = loanStatusDtst.Tables[0].Select("SecID=" + secID);

                            if (drSecID != null && drSecID.Length > 0)
                            {
                                if (!Convert.IsDBNull(drSecID[0]["StatusDesc"]) && drSecID[0]["StatusDesc"].ToString() != "" && !txtLoanReqStatus.Text.Contains(drSecID[0]["StatusDesc"].ToString()))
                                {
                                    statusDesc = drSecID[0]["StatusDesc"].ToString();

                                    //Implemented the similar logic to concatenate the TxnRefNbr's in case of Loan Breaks.
                                    if (Convert.ToString(drSecID[0]["TxnRefNbr"]) != "" && statusDesc.Contains(Convert.ToString(drSecID[0]["TxnRefNbr"])))
                                    {
                                        statusDesc = drSecID[0]["StatusDesc"].ToString().Replace(Convert.ToString(drSecID[0]["TxnRefNbr"]), "") + '(';
                                        for (int i = 0; i < drSecID.Length; i++)
                                        {
                                            if (i == 0)
                                                statusDesc += Convert.ToString(drSecID[i]["TxnRefNbr"]);
                                            else
                                                statusDesc += ',' + Convert.ToString(drSecID[i]["TxnRefNbr"]);
                                        }

                                        statusDesc += ')';
                                    }

                                    txtLoanReqStatus.Text =
                                        txtLoanReqStatus.ToolTip =
                                        DateTime.Now.ToString("T") + " - " + statusDesc + "\n" + txtLoanReqStatus.Text;
                                }
                            }
                        }
                    }

                }
                else
                    throw new Exception(Common.GetMessage("Common", "FailedToRetrieveFlowStatus"));
            }
            catch (Exception ex)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(ex.Message);
                _show_error_row = string.Empty;
                this.ajxTimer.Enabled = false;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
            }
            finally
            {
                loanStatusDtst.Dispose();
                db.Dispose();
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
        }

