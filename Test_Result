                                    txtPrice.Text = Convert.ToDecimal(dtSecInfo.Rows[0]["PriceAUD"]).ToString("#,##0.00#####");
                                else if (dtSecInfo.Rows[0]["CcyCode"].ToString().ToUpper() == Common.DefaultCollateralCCY.EUR.ToString())
                                    txtPrice.Text = Convert.ToDecimal(dtSecInfo.Rows[0]["PriceEURO"]).ToString("#,##0.00#####");
                                else
                                {
                                    //If Currency is not USD/EUR/AUD then fetch the Price from the datatable for that Currency.
                                    if (dr_CollCurrency.Length > 0)
                                    {
                                        txtPrice.Text = Convert.ToDecimal(dr_CollCurrency[0]["CollCCYPrice"]).ToString("#,##0.00#####");
                                    }
                                    //If no row is present in the datatable the default to EUROPrice.
