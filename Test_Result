        private List<Account> CreateAccounts(SqlDataReader acctRdr)
        {
            try
            {
                _logger.DebugFormat("Preparing to read accounts and lending limits.");
                List<Account> accounts = new List<Account>();
                while (acctRdr.Read())
                {
                    int lendingLimitGrpID = 0;
                    decimal lendingLimit = 0;
                    decimal exchangeRateYENUSD = 0;
                    decimal exchangeRateYENEUR = 0;
                    bool isDefaultExchRate = false;

                    Account account = new Account()
                    {
                        AcctNbr = Convert.ToString(acctRdr["AcctNbr"]),
                        AcctName = Convert.ToString(acctRdr["AcctName"]),
                        AcctSN = Convert.ToString(acctRdr["AcctSN"]),
                        AcctType = Convert.ToString(acctRdr["AcctType"]),
                        LendingLimitGrpID = Int32.TryParse(Convert.ToString(acctRdr["LendingLimitGrpID"]), out lendingLimitGrpID) ? lendingLimitGrpID : 0,
                        LendingLimit = decimal.TryParse(Convert.ToString(acctRdr["LendingLimit"]), out lendingLimit) ? lendingLimit : 0,
                        LendingLimitCurrency = Convert.ToString(acctRdr["LendingLimitCurr"]),
                        ExchangeRate_YENUSD = decimal.TryParse(Convert.ToString(acctRdr["ExchRate_YENUSD"]), out exchangeRateYENUSD) ? exchangeRateYENUSD : 0,
                        ExchangeRate_YENEUR = decimal.TryParse(Convert.ToString(acctRdr["ExchRate_YENEUR"]), out exchangeRateYENEUR) ? exchangeRateYENEUR : 0,
                        IsDefaultExchangeRate = bool.TryParse(Convert.ToString(acctRdr["IsDefaultExchRate"]), out isDefaultExchRate) ? isDefaultExchRate : false
                    };

                    accounts.Add(account);
                }
                return accounts;
            }
            catch (Exception ex)
            {
                _logger.Error(ex);
                throw;
            }
        }

        private List<CreditGroup> CreateCreditGroups(SqlDataReader creditGrpRdr)
