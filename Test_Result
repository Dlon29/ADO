                    }
                }
                else if (ActionType == "U")  //Update
                {
                    if (this.vwSelectedBaskets != null)
                    {
                        DataTable dtSelectedBasket = this.vwSelectedBaskets;

                        doc.DocumentElement.ChildNodes[0].Attributes["BulkNbr"].Value = dtSelectedBasket.Rows[0]["BulkNbr"].ToString(); //BulkNbr
                        doc.DocumentElement.ChildNodes[0].Attributes["VersionNbr"].Value = dtSelectedBasket.Rows[0]["VersionNbr"].ToString(); //BulkNbr
