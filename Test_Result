        /// </summary>
        /// <param name="rrLinkRefNbr"></param>
        /// <param name="collSecurityList"></param>
        /// <param name="identifier"></param>
        /// <returns></returns>
        public static DataSet CollateralSecurityOperation(string rrLinkRefNbr, string collSecurityList, string repoTicketID, string repoTicketBrokerID, string identifier)
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet objDS = new DataSet();
            string[] SqlCondition = new string[5] { "", "", "", "", "" };

            try
            {
                if (clsDB.Open() == false)
                    return null;

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_RevRepo_CollateralUpload_Operations;

                SqlCondition[0] = rrLinkRefNbr;
                SqlCondition[1] = collSecurityList;
                SqlCondition[2] = repoTicketID;
                SqlCondition[3] = repoTicketBrokerID;
                SqlCondition[4] = identifier;

                clsReader.GetData(ref objDS, SqlObjects.p_RevRepo_CollateralUpload_Operations, SqlCondition);

