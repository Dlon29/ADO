        /// <summary>
        /// This method will calculate Div REB FEE rate
        /// </summary>
        /// <returns></returns>
        private bool CalculateDiv_REBFEE_Rate()
        {

            Database clsDB = new Database();
            DataCommand clsCmd = new DataCommand();
            bool blnStatus = false;
            MethodName = "CalculateDiv_REBFEE_Rate()";
            try
            {
                CalculateAmountAndPriceOnPostBack();
                string xml = GetXMLForCalculateAllInRate();

                if (xml == string.Empty)
                    return false;

                DataReader clsReader = new DataReader();
                DataTable dt = new DataTable();

                string[] SqlCondition = new string[1] { "" };
                string Identifier = "";

                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_Get_DivArbAllInRate;

                SqlCondition[0] = xml;


                clsReader.SqlIdentifier = Identifier;

                if (clsReader.GetData(ref dt, SqlCondition) == false)
                {
                    blnStatus = false;
                    _logger.Debug(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                    throw new Exception(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                }
                else
                {
                    blnStatus = true;
                }


                if (blnStatus)
                {
                    DataRow drColl = dt.Rows[0];

                    if (drColl != null)
                    {


                        if (drColl["ALLInFee"] != DBNull.Value)
                            txtRate.Text = Convert.ToDecimal(drColl["ALLInFee"].ToString().Trim().Replace(",", "")).ToString("#,##0.00");   //txtRate.Text = drColl["ALLInFee"].ToString().Trim().Replace(",", "")    // Calculated ALLInFee comes to REE/BEE field.
                        else
                            txtRate.Text = "";


                        if (drColl["DeclaredDividend"] != DBNull.Value)
                            txtDivArbRate.Text = Convert.ToDecimal(drColl["DeclaredDividend"].ToString().Trim().Replace(",", "")).ToString("#,##0.00####"); // Calculated DeclaredDividend comes to STTDivRate textBox.
                        else
                            txtDivArbRate.Text = "";


                        if (drColl["ProjectedDividendAmount"] != DBNull.Value)
                            txtProjectedDividendAmount.Text = Convert.ToDecimal(drColl["ProjectedDividendAmount"].ToString().Trim().Replace(",", "")).ToString("#,##0.00####"); // Calculated ProjectedDividendAmount comes to ProjectedDividendAmount textBox.
                        else
                            txtProjectedDividendAmount.Text = "";


                        if (drColl["IsProjectedDividend"] != DBNull.Value)
                            chkIsProjectedDividend.Checked = drColl["IsProjectedDividend"].ToString() == "True" ? true : false; // Calculated IsProjectedDividend comes to chkIsProjectedDividend textBox.
                        else
                            chkIsProjectedDividend.Checked = false;


                        if (drColl["ErrorMessage"] != DBNull.Value)
                        {
                            _ErrorString.Append(drColl["ErrorMessage"].ToString().Trim().Replace(",", ""));
                            EnableDisableLoanBookButtons(false);
                        }
                    }
                }


                if (_ErrorString.Length > 0)
                {
                    _show_error_row = "";
                    //log.Debug(_ErrorString.ToString());
                    throw new Exception(_ErrorString.ToString());
                }

                return blnStatus;

            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
                return false;
            }
        }


