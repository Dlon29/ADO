        /// <summary>
        /// Calculate REBFEE Rate
        /// </summary>
        /// <returns></returns>
        private bool CalculateDiv_REBFEE_Rate()
        {

            Database clsDB = new Database();
            DataCommand clsCmd = new DataCommand();
            bool blnStatus = false;
            MethodName = "CalculateDiv_REBFEE_Rate()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            try
            {
                string xml = GetXMLForCalculateAllInRate();

                if (xml == string.Empty)
                    return false;

                DataReader clsReader = new DataReader();
                DataTable dt = new DataTable();

                string[] SqlCondition = new string[1] { "" };
                string Identifier = "";

                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_Get_DivArbAllInRate;

                SqlCondition[0] = xml;


                clsReader.SqlIdentifier = Identifier;

                if (clsReader.GetData(ref dt, SqlCondition) == false)
                {
                    blnStatus = false;
                    _logger.Debug(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                    throw new Exception(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                }
                else
                {
                    blnStatus = true;
                }


                if (blnStatus)
                    UpdateBasketForALLInRate(dt);


                return blnStatus;

            }
            catch (Exception ex)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(ex.Message);
                _show_error_row = string.Empty;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
                return false;
            }
            finally
            {
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
        }

        //Addded for P-1810... Get XML for Calculating STT Level .
        /// <summary>
        /// Get XML for Calculating STT Level .
        /// </summary>
        /// <returns></returns>
        private string GetXMLForCalculateAllInRate()
        {
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            //create new instance of XmlDocument
            XmlDocument doc = new XmlDocument();
            bool blnFirstRowProcessed = false;
            string path = string.Empty;
            string strMainNode = string.Empty;
            string xml = string.Empty;
            MethodName = "GetXMLForCalculateAllInRate()";
            try
            {
                path = @"/LAVA/XmlTemplates/CalculateDivAllInRate.xml";
                strMainNode = "STTLevel";


                //load from file
                XmlTextReader reader = new XmlTextReader(Server.MapPath(path));
                doc.Load(reader);

                //create main node
                XmlNode mainNode = doc.SelectSingleNode(strMainNode);

                DataGridItem dgi = null;
                int iXmlRowCount = 1;
                int intRowCount = 0;
                Double NumberOfDays = 0;

                for (int iRowCount = 0; iRowCount < grdSelectedBasket.Items.Count; iRowCount++)
                {
                    dgi = this.grdSelectedBasket.Items[iRowCount];

                    XmlNode node = doc.CreateNode(XmlNodeType.Element, "FieldName", null);

                    TextBox txtPrice = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.Price].FindControl("txtPrice");
                    TextBox txtPrincipal = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.Price].FindControl("lblPrincipal");
