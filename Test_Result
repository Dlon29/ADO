string fieldName = formPostParam.Keys[recform];
if (fieldName == "__VIEWSTATE" || fieldName == "__EVENTVALIDATION")
{
    try
    {
        object decoded = new LosFormatter().Deserialize(formPostParam[recform]);
        postValue = decoded.ToString().ToLower();      // this is what Reject4 scans below, unchanged

        // ===== TEMPORARY LOGGING (remove after verification) =====
        try
        {
            string logText = postValue;                // see the note below to log the real contents instead
            string kw = arrstrFilterString.FirstOrDefault(f => logText.Contains(f.ToString().ToLower()));

            if (kw != null)
            {
                int idx = logText.IndexOf(kw);
                int start = Math.Max(0, idx - 100);
                int end = Math.Min(logText.Length, idx + kw.Length + 100);
                string prev = idx != 0 ? logText.Substring(idx - 1, 1) : "";
                string next = logText.Length > idx + kw.Length ? logText.Substring(idx + kw.Length, 1) : "";

                _logger.InfoFormat("VS-DECODED Field={0} Keyword={1} Prev={2} Next={3} Len={4} Excerpt={5}",
                    fieldName, kw, prev, next, logText.Length, logText.Substring(start, end - start));
            }
            else
            {
                _logger.InfoFormat("VS-DECODED Field={0} Keyword=none Len={1} Start={2}",
                    fieldName, logText.Length, logText.Substring(0, Math.Min(200, logText.Length)));
            }
        }
        catch (Exception) { /* logging must never affect the request */ }
        // ===== END TEMPORARY LOGGING =====
    }
    catch (Exception)
    {
        continue;
    }
}



