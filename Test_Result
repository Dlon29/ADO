    #region Named ranges and cell ranges

    public sealed class XLNamedRangeCollection : IEnumerable<XLNamedRange>
    {
        private readonly NativeXLNamedRangeCollection _ranges;
        internal XLNamedRangeCollection(NativeXLNamedRangeCollection ranges) { _ranges = ranges; }
        public int Count { get { return _ranges.Count; } }
        public void Add(string name, XLCellRange range)
        {
            if (range == null) throw new ArgumentNullException("range");
            _ranges.Add(name, range.NativeRange);
        }
        public IEnumerator<XLNamedRange> GetEnumerator()
        {
            foreach (NativeXLNamedRange range in _ranges)
                yield return range == null ? null : new XLNamedRange(range);
        }
        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }
    }

    public sealed class XLNamedRange
    {
        private readonly NativeXLNamedRange _range;
        internal XLNamedRange(NativeXLNamedRange range) { _range = range; }
        public string Name { get { return _range.Name; } }
        public bool IsEmpty { get { return _range.IsEmpty; } }
        public XLCellRangeCollection CellRanges { get { return new XLCellRangeCollection(_range.CellRanges); } }
    }

    public sealed class XLCellRangeCollection : IEnumerable<XLCellRange>
    {
        private readonly object _ranges;
        internal XLCellRangeCollection(object ranges) { _ranges = ranges; }
        public int Count { get { return NativeAccess.Get<int>(_ranges, "Count"); } }
        public XLCellRange this[int index]
        {
            get
            {
                object range = NativeAccess.GetIndexed(_ranges, index);
                return range == null ? null : new XLCellRange((NativeXLCellRange)range);
            }
        }
        public IEnumerator<XLCellRange> GetEnumerator()
        {
            foreach (object range in (IEnumerable)_ranges)
                yield return range == null ? null : new XLCellRange((NativeXLCellRange)range);
        }
        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }
    }

    public sealed class XLCellRange
    {
        private readonly NativeXLCellRange _range;
        internal NativeXLCellRange NativeRange { get { return _range; } }

        public XLCellRange(int sheetFrom, int sheetTo, int rowFrom, int rowTo,
            int columnFrom, int columnTo, XLReferenceType rowFromType,
            XLReferenceType rowToType, XLReferenceType columnFromType,
            XLReferenceType columnToType)
        {
            _range = new NativeXLCellRange(sheetFrom, sheetTo, rowFrom, rowTo,
                columnFrom, columnTo, ToNativeReference(rowFromType),
                ToNativeReference(rowToType), ToNativeReference(columnFromType),
                ToNativeReference(columnToType));
        }

        internal XLCellRange(NativeXLCellRange range) { _range = range; }
        public int ColumnTo { get { return _range.ColumnTo; } set { _range.ColumnTo = value; } }
        public int RowTo { get { return _range.RowTo; } set { _range.RowTo = value; } }
        public XLRangeType RangeType
        {
            set { _range.RangeType = (NativeXLRangeType)Enum.Parse(typeof(NativeXLRangeType), value.ToString()); }
        }
        private static NativeXLReferenceType ToNativeReference(XLReferenceType value)
        {
            return (NativeXLReferenceType)Enum.Parse(typeof(NativeXLReferenceType), value.ToString());
        }
    }

