                            HideShowColumns(grdSelectedBasket);

                            //This method Will Update the view According to values of the grid

                            RefreshView(this.vwSelectedBaskets);

                            pnlSavedBasketMsg.Visible = false;
                            divSelectedBaskets.Visible = true;

                            cmdRefreshBasket.Enabled = true;
                        }
                        else
                        {
                            pnlSavedBasketMsg.Visible = true;
                            divSelectedBaskets.Visible = false;
                        }

                        objDS.Tables[0].DefaultView.RowFilter = "IsValidSec = 0";

                        if (objDS.Tables[0].DefaultView.ToTable().Rows.Count > 0)
                            IsInvalidSecurityPresent = true;

                        objDS.Tables[0].DefaultView.RowFilter = "IsBlocked = 1";

                        if (objDS.Tables[0].DefaultView.ToTable().Rows.Count > 0)
                        {
                            IsBlockedSecurityPresent = true;

                            foreach (DataRow row in objDS.Tables[0].DefaultView.ToTable().Rows)
                            {
                                if (Convert.ToString(row["IsBlocked"]).ToUpper() == "TRUE")
                                {

                                    if (strBlockedSecCode.Length == 0)
                                        strBlockedSecCode.Append(row["SecCode"].ToString());
                                    else
                                    {
                                        strBlockedSecCode.Append(", ");
                                        strBlockedSecCode.Append(row["SecCode"].ToString());
                                    }
                                }
                            }
                        }

                        if ((IsInvalidSecurityPresent) && (IsBlockedSecurityPresent))
                            ConfirmMessage(Common.GetMessage(BASKET_CONFIGURATION, "InvalidSecInFileMsg") + "\\n" + Common.GetMessage(BASKET_CONFIGURATION, "BlockedSecuritiesPresent") + strBlockedSecCode.ToString() + Common.GetMessage(BASKET_CONFIGURATION, "BlockedSecuritiesPresent1"));
                        else if (IsInvalidSecurityPresent)
                            ConfirmMessage(Common.GetMessage(BASKET_CONFIGURATION, "InvalidSecInFileMsg"));
                        else if (IsBlockedSecurityPresent)
                            ConfirmMessage(Common.GetMessage(BASKET_CONFIGURATION, "BlockedSecuritiesPresent") + strBlockedSecCode.ToString() + Common.GetMessage(BASKET_CONFIGURATION, "BlockedSecuritiesPresent1"));

                    }
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(Exc.Message);
                _show_error_row = string.Empty;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
                return false;
            }
            finally
            {
                objPagedDS = null;
                objDS.Dispose();

                if (clsCmd != null)
                    clsCmd.Dispose();

                if (clsDB != null)
                    clsDB.Dispose();

                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
            return true;
        }

        /// <summary>
        /// Refresh View 
        /// </summary>
        /// <param name="dt"></param>
        private void RefreshView(DataTable dt)
        {
            DataGridItem dgi = null;
            MethodName = "RefreshView()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            try
            {
                for (int iRowCount = 0; iRowCount < grdSelectedBasket.Items.Count; iRowCount++)
                {

                    dgi = this.grdSelectedBasket.Items[iRowCount];
                    DropDownList cboProductCategory = (DropDownList)dgi.FindControl("cboProductCategory");


                    TextBox txtBullet = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.ProductCategoryLoanDuration].FindControl("txtBullet");

                    TextBox txtEXT1 = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.ProductCategoryLoanDuration].FindControl("txtEXT1");

                    TextBox txtEVG = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.ProductCategoryLoanDuration].FindControl("txtEVG");

                    TextBox txtDivArbEndDate = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.STTEndDate].FindControl("txtDivArbEndDate");
                    HtmlAnchor lnkDivArbEndDate = (HtmlAnchor)dgi.Cells[(int)enumgrdSelectedBasketMapping.STTEndDate].FindControl("lnkDivArbEndDate");

                    TextBox txtScripEndDate = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.ScripEndDate].FindControl("txtScripEndDate");
                    HtmlAnchor lnkScripEndDate = (HtmlAnchor)dgi.Cells[(int)enumgrdSelectedBasketMapping.ScripEndDate].FindControl("lnkScripEndDate");

                    TextBox txtDivArbAllInRate = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.STTLevel].FindControl("txtDivArbAllInRate");
                    TextBox txtDivArbDivRate = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.STTDivRate].FindControl("txtDivArbDivRate");

                    DropDownList cboTermLoanType = (DropDownList)dgi.FindControl("cboTermLoanType");

                    dt.Rows[dgi.ItemIndex]["ProductCategory"] = cboProductCategory.SelectedValue == "0" ? "" : cboProductCategory.SelectedValue;
                    dt.Rows[dgi.ItemIndex]["ProductCategoryLoanType"] = cboTermLoanType.SelectedValue == "0" ? "" : cboTermLoanType.SelectedValue;

                    dt.Rows[dgi.ItemIndex]["STTLevel"] = txtDivArbAllInRate.Text.Trim() == string.Empty ? decimal.Zero : Convert.ToDecimal(txtDivArbAllInRate.Text.Trim());
                    dt.Rows[dgi.ItemIndex]["STTDivRate"] = txtDivArbDivRate.Text.Trim() == string.Empty ? decimal.Zero : Convert.ToDecimal(txtDivArbDivRate.Text.Trim());
                    dt.Rows[dgi.ItemIndex]["STTEndDate"] = txtDivArbEndDate.Text.Trim() == string.Empty ? "1900-01-01 00:00:00.000" : txtDivArbEndDate.Text.Trim();
                    dt.Rows[dgi.ItemIndex]["ScripEndDate"] = txtScripEndDate.Text.Trim() == string.Empty ? "1900-01-01 00:00:00.000" : txtScripEndDate.Text.Trim();

                    if (cboProductCategory.SelectedValue == "GCT")
                    {
                        if (cboTermLoanType.SelectedValue == "BULLET")
                        {
                            dt.Rows[dgi.ItemIndex]["ProductCategoryLoanDuration"] = txtBullet.Text.Trim();
                        }
                        else if (cboTermLoanType.SelectedValue == "EVG")
                        {
                            dt.Rows[dgi.ItemIndex]["ProductCategoryLoanDuration"] = txtEVG.Text.Trim();
                        }
                        else if (cboTermLoanType.SelectedValue == "EXT")
                        {
                            string EXT = txtEXT1.Text;
                            dt.Rows[dgi.ItemIndex]["ProductCategoryLoanDuration"] = EXT;
                        }
                    }

                    if (cboTermLoanType.SelectedValue == "0")
                    {
                        dt.Rows[dgi.ItemIndex]["ProductCategoryLoanDuration"] = "";
                    }

                    TextBox txtGotoRate = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.GotoRate].FindControl("txtGotoRate");
                    dt.Rows[dgi.ItemIndex]["GotoRepoRate"] = txtGotoRate.Text.Trim() == string.Empty ? decimal.Zero : Convert.ToDecimal(txtGotoRate.Text.Trim());

                    DropDownList cboGotoProductCategory = (DropDownList)dgi.FindControl("cboGotoProductCategory");

                    TextBox txtGotoBullet = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.GotoProductCategoryLoanDuration].FindControl("txtGotoBullet");
                    TextBox txtGotoEXT1 = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.GotoProductCategoryLoanDuration].FindControl("txtGotoEXT1");
                    TextBox txtGotoEVG = (TextBox)dgi.Cells[(int)enumgrdSelectedBasketMapping.GotoProductCategoryLoanDuration].FindControl("txtGotoEVG");
                    DropDownList cboGotoTermLoanType = (DropDownList)dgi.FindControl("cboGotoTermLoanType");

                    dt.Rows[dgi.ItemIndex]["GotoProductCategory"] = cboGotoProductCategory.SelectedValue == "0" ? "" : cboGotoProductCategory.SelectedValue;
                    dt.Rows[dgi.ItemIndex]["GotoProductCategoryLoanType"] = cboGotoTermLoanType.SelectedValue == "0" ? "" : cboGotoTermLoanType.SelectedValue;

                    DropDownList ddlIsEquilend = (DropDownList)dgi.FindControl("ddlIsEquilend");
                    dt.Rows[dgi.ItemIndex]["IsEquilend"] = ddlIsEquilend.SelectedValue;

                    if (cboGotoProductCategory.SelectedValue == "GCT")
                    {
                        if (cboGotoTermLoanType.SelectedValue == "BULLET")
                        {
                            dt.Rows[dgi.ItemIndex]["GotoProductCategoryLoanDuration"] = txtGotoBullet.Text.Trim();
                        }
                        else if (cboGotoTermLoanType.SelectedValue == "EVG")
                        {
                            dt.Rows[dgi.ItemIndex]["GotoProductCategoryLoanDuration"] = txtGotoEVG.Text.Trim();
                        }
                        else if (cboGotoTermLoanType.SelectedValue == "EXT")
                        {
                            dt.Rows[dgi.ItemIndex]["GotoProductCategoryLoanDuration"] = txtGotoEXT1.Text.Trim();
                        }
                    }

                    if (cboGotoTermLoanType.SelectedValue == "0")
                    {
                        dt.Rows[dgi.ItemIndex]["GotoProductCategoryLoanDuration"] = "";
                    }


                    dt.AcceptChanges();
                    this.vwSelectedBaskets = dt;
