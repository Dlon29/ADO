            {
                throw Exc;
            }
            finally
            {
                clsDB.Dispose();
            }
        }

        /// <summary>
        /// This method is used to set Default disclosure based on Bucket Sec Type and Loan Category
        /// </summary>
        private void SetDefaultDisclosure()
        {
            /*P2420(R2): As per users, for all Loan Category - Cash repo, rev repo and lending and for both EQ and FI, Disclosure should be defaulted to "N".
             The default values are set in DomainLookUp and retrieved fro database and set to hidden fields.*/
            if (this._secType == Common.enumSecType.FI.ToString())
            {
                if (cboLoanCategory.SelectedValue == enumLoanCategory.L.ToString() && !string.IsNullOrEmpty(hdnFILendingDefaultDisclosure.Value))
                {
                    if (this.cboDisclosure.Items.FindByValue(hdnFILendingDefaultDisclosure.Value) != null)
                        this.cboDisclosure.SelectedValue = hdnFILendingDefaultDisclosure.Value;
                }
                else if (cboLoanCategory.SelectedValue == enumLoanCategory.CR.ToString() && !string.IsNullOrEmpty(hdnFICashRepoDefaultDisclosure.Value))
                {
                    if (this.cboDisclosure.Items.FindByValue(hdnFICashRepoDefaultDisclosure.Value) != null)
                        this.cboDisclosure.SelectedValue = hdnFICashRepoDefaultDisclosure.Value;
                }
                else if (cboLoanCategory.SelectedValue == enumLoanCategory.RR.ToString() && !string.IsNullOrEmpty(hdnFIRevRepoDefaultDisclosure.Value))
                {
                    if (this.cboDisclosure.Items.FindByValue(hdnFIRevRepoDefaultDisclosure.Value) != null)
                        this.cboDisclosure.SelectedValue = hdnFIRevRepoDefaultDisclosure.Value;
                }
            }
            else if (this._secType == Common.enumSecType.EQ.ToString() && !string.IsNullOrEmpty(hdnEQDefaultDisclosure.Value))
            {
                if (this.cboDisclosure.Items.FindByValue(hdnEQDefaultDisclosure.Value) != null)
                    this.cboDisclosure.SelectedValue = hdnEQDefaultDisclosure.Value;
            }
            else
            {
                if (this.cboDisclosure.Items.FindByValue("N") != null)
                    this.cboDisclosure.SelectedValue = "N";
            }
        }
