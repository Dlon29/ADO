            private void BuildWorksheetBody(StringBuilder workbook, WorksheetInfo worksheetInfo)
            {
                try
                {

                    _accounts = this.Accounts.Select(acct => new Account() {
                                                                                AcctNbr = acct.AcctNbr, 
                                                                                AcctName = acct.AcctName, 
                                                                                AcctSN = acct.AcctSN, 
                                                                                LendingLimitGrpID = acct.LendingLimitGrpID, 
                                                                                LendingLimit = acct.LendingLimit 
                                                                            })
                                            .ToList()
                                            .Distinct()
                                            .ToList();

                    this.BuildAccountHeaders(workbook, worksheetInfo);

                    //==================================================================================================================================================================
                    //Render balances by credit group and account 
                    //==================================================================================================================================================================

                    var loans = this.Loans.GroupBy(ln => new { ln.AcctNbr, ln.BrkCrGrpID, ln.IsFuture, ln.LendingLimitGrpID })
                                          .Select(lnGrp => new
                                                              {
                                                                  AcctNbr = lnGrp.Key.AcctNbr,
                                                                  BrkCrGrpID = lnGrp.Key.BrkCrGrpID,
                                                                  IsFuture = lnGrp.Key.IsFuture,
                                                                  LendingLimitGrpID = lnGrp.Key.LendingLimitGrpID,
                                                                  PrincipalDomestic = lnGrp.Sum(ln => ln.PrincipalDomestic),
                                                                  PrincipalGlobalEUR = lnGrp.Sum(ln => ln.PrincipalGlobalEUR),
                                                                  PrincipalGlobalUSD = lnGrp.Sum(ln => ln.PrincipalGlobalUSD)
                                                              })
                                          .ToList();

                    var templateDict = worksheetInfo.TemplateDictionary;
                    var loanBalanceBldr = new StringBuilder();

                    foreach (var creditGrp in CreditGroups)
                    {
                        var domesticUSDRowBldr = new StringBuilder();
                        var globalUSDRowBldr = new StringBuilder();
                        var totalUSDRowBldr = new StringBuilder();
                        var globalEURRowBldr = new StringBuilder();
                        var lendingLimitPctRowBldr = new StringBuilder();
                        var availableBalanceUSDRowBldr = new StringBuilder();
                        var availableBalanceEURRowBldr = new StringBuilder();


                        foreach (var acct in _accounts)
                        {
                            var percentLimit = this.LendingLimitBrokerPct.SingleOrDefault(pct => (pct.LendingLimitGrpID == acct.LendingLimitGrpID) && (pct.BrkCrGrpID == creditGrp.BrkCrGrpID));
                            totalUSDRowBldr.Append(templateDict["CELL.BALANCE.TOTALUSD"]);
                            lendingLimitPctRowBldr.Append(templateDict["CELL.LENDINGLIMIT.PCT"]);
                            availableBalanceUSDRowBldr.Append(templateDict["CELL.AVAILABLE.BALANCE.USD"].Replace("<!--PercentLimit-->", (percentLimit != null) ? Convert.ToString(percentLimit.PercentLimit) : "0"));
                            availableBalanceEURRowBldr.Append(templateDict["CELL.AVAILABLE.BALANCE.EUR"].Replace("<!--PercentLimit-->", (percentLimit != null) ? Convert.ToString(percentLimit.PercentLimit) : "0"));


                            var loanBalance = loans.SingleOrDefault(ln => (ln.LendingLimitGrpID == acct.LendingLimitGrpID) && (ln.BrkCrGrpID == creditGrp.BrkCrGrpID));
                            domesticUSDRowBldr.Append(templateDict["CELL.DOMESTIC.BALANCE"].Replace("<!--TotalPrincipal-->", (loanBalance != null) ? Convert.ToString(loanBalance.PrincipalDomestic) : "0"));
                            globalUSDRowBldr.Append(templateDict["CELL.BALANCE"].Replace("<!--TotalPrincipal-->", (loanBalance != null) ? Convert.ToString(loanBalance.PrincipalGlobalUSD) : "0"));
                            globalEURRowBldr.Append(templateDict["CELL.BALANCE"].Replace("<!--TotalPrincipal-->", (loanBalance != null) ? Convert.ToString(loanBalance.PrincipalGlobalEUR) : "0"));

                        }


                        var defaultFIPct = this.LendingLimitBrokerPct.SingleOrDefault(pct => ( pct.IsDefaultPctForFI == true ) && (pct.BrkCrGrpID == creditGrp.BrkCrGrpID));
                        var defaultEQPct = this.LendingLimitBrokerPct.SingleOrDefault(pct => ( pct.IsDefaultPctForEQ == true ) && (pct.BrkCrGrpID == creditGrp.BrkCrGrpID));


                        var creditGroupRowBldr = templateDict[ReportTemplate.DEFAULT_WORKSHEET_ROW]
                                                    .Replace("<!--BrkCrGrpName-->", creditGrp.BrkCrGrpName)
                                                    .Replace("<!--CreditRating-->", creditGrp.CreditRating)
                                                    .Replace("<!--CrLimit-->",   Convert.ToString(creditGrp.CrLimit))
                                                    .Replace("<!--DefaultFIPct-->", ( ( defaultFIPct != null ) ? defaultFIPct.PercentLimit * 100 : 0).ToString("#,##0"))
                                                    .Replace("<!--DefaultEQPct-->", ((defaultEQPct != null) ? defaultEQPct.PercentLimit * 100 : 0).ToString("#,##0"))
                                                    .Replace("<!--DomesticUSD-->", domesticUSDRowBldr.ToString())
                                                    .Replace("<!--GlobalUSD-->", globalUSDRowBldr.ToString())
                                                    .Replace("<!--TotalUSD-->", totalUSDRowBldr.ToString())
                                                    .Replace("<!--GlobalEUR-->", globalEURRowBldr.ToString())
                                                    .Replace("<!--LendingLimitPercentage-->", lendingLimitPctRowBldr.ToString())
                                                    .Replace("<!--AvailableBalanceUSD-->", availableBalanceUSDRowBldr.ToString())
                                                    .Replace("<!--AvailableBalanceEUR-->", availableBalanceEURRowBldr.ToString());

                        loanBalanceBldr.Append(creditGroupRowBldr.ToString());
                    }

                    //Subtotals
                    var totalLoanBalanceDomesticUSD = new StringBuilder();
                    var totalLoanBalanceGlobalUSD = new StringBuilder();
                    var totalLoanBalanceGlobalEUR = new StringBuilder();
                    var outOfBalanceUSD = new StringBuilder();
                    var outOfBalanceEUR = new StringBuilder();

                    foreach (var acct in _accounts)
                    {
                        totalLoanBalanceDomesticUSD.Append(templateDict["CELL.TOTAL.BALANCE.DOMESTIC.USD"]);
                        totalLoanBalanceGlobalUSD.Append(templateDict["CELL.TOTAL.BALANCE.GLOBAL.USD"]);
                        totalLoanBalanceGlobalEUR.Append(templateDict["CELL.TOTAL.BALANCE.GLOBAL.EUR"]);

                        var totalPrincipalUSD = loans.Where(ln => (ln.AcctNbr == acct.AcctNbr)).Sum(ln => ln.PrincipalGlobalUSD + ln.PrincipalDomestic);
                        var totalPrincipalEUR = loans.Where(ln => (ln.AcctNbr == acct.AcctNbr)).Sum(ln => ln.PrincipalGlobalEUR);
                        outOfBalanceUSD.Append(templateDict["CELL.OUT.OF.BALANCE.USD"].Replace("<!--TotalPrincipal-->", Convert.ToString(totalPrincipalUSD)));
                        outOfBalanceEUR.Append(templateDict["CELL.OUT.OF.BALANCE.EUR"].Replace("<!--TotalPrincipal-->", Convert.ToString(totalPrincipalEUR)));
                    }

                    var investmentMgr = InvestmentManagers.FirstOrDefault();
                    var investmentMgrName = string.Empty;
                    if (this.InvestmentMgrID != 0)
                    {
                        investmentMgrName = (investmentMgr != null)
                                ? string.Format("{0} : {1}", "Investment Manager", investmentMgr.InvestmentMgrName)
                                : string.Empty;
                    }

                    workbook.Replace("<!--AsOfDate-->", this.AsOfDate.ToString("yyyy-MM-dd"));
                    workbook.Replace("<!--InvestmentMgrName-->", investmentMgrName);
                    workbook.Replace("<!--LoanBalances-->", loanBalanceBldr.ToString());
                    workbook.Replace("<!--TotalLoanBalanceDomesticUSD-->", totalLoanBalanceDomesticUSD.ToString());
                    workbook.Replace("<!--TotalLoanBalanceGlobalUSD-->", totalLoanBalanceGlobalUSD.ToString());
                    workbook.Replace("<!--TotalLoanBalanceGlobalEUR-->", totalLoanBalanceGlobalEUR.ToString());
                    workbook.Replace("<!--OutOfBalanceUSD-->", outOfBalanceUSD.ToString());
                    workbook.Replace("<!--OutOfBalanceEUR-->", outOfBalanceEUR.ToString());
                    
                }
                catch (Exception ex)
                {
                    _logger.Error(ex);
                    throw;
                }
            }

