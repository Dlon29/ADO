            if (_BrkCrGrpID.Equals("0") && _BrokerMask.Equals("0"))
                SqlCondition[5] = ""; //No broker info passed
            else if (_BrkCrGrpID != "0" && _BrokerMask.Equals("0"))
                SqlCondition[5] = "ACCT_BRK|" + _BrkCrGrpID; //search by broker credit group
            else if (_exclusiveSelection != "NE" && _BrkCrGrpID != "0" && _BrokerMask.Equals("0"))
                SqlCondition[5] = "EXCL_BRG|" + _BrkCrGrpID; //search by broker credit group
            else if (_BrokerMask != "0")
                SqlCondition[5] = "EXCL_BRK|" + _BrkGrpID; //search by specific broker

            SqlCondition[6] = _exclusiveSelection;

            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet ds = new DataSet();
            DataTable dtSecInfo = new DataTable();
            SqlDataReader clsDR = null;

            clsReader.SqlIdentifier = Identifier;
            MethodName = "GetRecords()";

            try
            {
                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    return false;
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Reports;

                if (clsReader.GetData(ref ds, SqlCondition) == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorInRetrieveData"));
                    return false;
                }

                //result set 1: get security header information
                _resultSetPosition = (int)ResultSet.SECURITY_DETAILS;
