        /// <summary>
        /// This method will set Transmit flag based on Settlement Date
        /// </summary>
        /// <returns></returns>
        private void CalculateTransmitFlag()
        {

            if ((this._secType != Common.enumSecType.FI.ToString()) && (!this.chkIsProjectedDividend.Checked))
            {
                string[] SqlCondition = new string[1] { "" };

                Database clsDB = new Database();
                DataReader clsReader = new DataReader();
                DataSet objDS = new DataSet();
                string strCountry = null;
                DataRow[] drTransmit = null;
                MethodName = "CalculateTransmitFlag()";

                try
                {
                    if (clsDB.Open() == false)
                    {
                        _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    }

                    SqlCondition[0] = "";

                    clsReader.Connection = clsDB.Connection;

                    if (clsReader.GetData(ref objDS, SqlObjects.p_GetTransmitFlagSettlementDate, SqlCondition) == false)
                        _logger.Debug(Common.GetMessage("Common", "ErrorInRetrieveData"));

                    strCountry = litCountryCode.Text;

                    drTransmit = objDS.Tables[0].Select("ISOCountry=" + "'" + strCountry + "'");
                    if (drTransmit != null && drTransmit.Length > 0)
                    {
                        DateTime dt1 = Convert.ToDateTime(txtSetelmentDate.Text);
                        DateTime dt2 = Convert.ToDateTime(drTransmit[0]["ValidSettlementDate"]);

                        int cmp = dt1.CompareTo(dt2);

                        if (cmp > 0)        // User enter settlement DateTime is  grater than Valid  settlement date
                            cboTransmit.SelectedValue = "N";
                        else
                            cboTransmit.SelectedValue = "Y";
                    }
                    else
                        cboTransmit.SelectedValue = "Y";   // Changes done for M-443 -- For Equity new loan booking  a.Transmit Flag will be defaulted to ‘YE 
                }
                catch (Exception Exc)
                {
                    _show_error_row = "";
                    _ErrorString = new StringBuilder();
                    _ErrorString.Append(Exc.Message);
                    _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
                }
                finally
                {
                    objDS.Dispose();
                    clsReader.Dispose();
                    clsDB.Dispose();
                }
            }
            else
                cboTransmit.SelectedValue = "N";

        }

        /// <summary>
        /// This method will Calculate LIBOR Rate
        /// </summary>
        /// <returns></returns>
        private bool CalculateLIBORRate()
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet ds = new DataSet();
            MethodName = "CalculateLIBORRate()";

            try
            {
                string[] SqlCondition = new string[3] { "", "", "" };

                if (_AsOfDate != "")
                    SqlCondition[0] = _AsOfDate;
                else
                    SqlCondition[0] = _batchRunDate;

                if (cboCollCCY.SelectedValue == "0")
                {
                    _logger.Debug(Common.GetMessage("SingleLoanBooking", "ErrorCollCCYSel"));
                    throw new Exception(Common.GetMessage("SingleLoanBooking", "ErrorCollCCYSel"));
                }


                if (txtTermDate.Text.Trim() == "")
                {
                    _logger.Debug(Common.GetMessage("SingleLoanBooking", "ErrorTermDateSel"));
                    throw new Exception(Common.GetMessage("SingleLoanBooking", "ErrorTermDateSel"));
                }

                SqlCondition[1] = Convert.ToDateTime(txtTermDate.Text).ToShortDateString();
                SqlCondition[2] = cboCollCCY.SelectedValue;

                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    return false;
                }

                clsReader.Connection = clsDB.Connection;


                if (clsReader.GetData(ref ds, SqlObjects.p_GetData_Calculate_LIBORRate, SqlCondition) == false)
                    return false;

                if (ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
                {
                    if (!string.IsNullOrEmpty(ds.Tables[0].Rows[0]["InterpolatedLIBORRate"].ToString()))
                        txtLIBORRate.Text = Convert.ToDecimal(ds.Tables[0].Rows[0]["InterpolatedLIBORRate"]).ToString("#,##0.####");
                }
                else
                {
                    _logger.Debug(Common.GetMessage("SingleLoanBooking", "ErrorLIBORRateNotExists"));
                    throw new Exception(Common.GetMessage("SingleLoanBooking", "ErrorLIBORRateNotExists"));
                }


            }
            catch (Exception Exc)
            {
                Response.ClearContent();
                Response.ContentType = "text/html";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));

            }
            finally
            {
                ds.Dispose();
                clsReader.Dispose();
                clsDB.Dispose();
            }

            return true;
        }

        /// <summary>
