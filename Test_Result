        }

        internal XLStyle(NativeXLStyle style) { _style = style; }

        public Color ForeColor { get { return _style.ForeColor; } set { _style.ForeColor = value; } }
        public Color BackColor { get { return _style.BackColor; } set { _style.BackColor = value; } }
