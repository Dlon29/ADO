                        fntCLOAccruedInterest.Visible = false;
                        txtAccruedInterest.Visible = true;
                        fntAccruedInterest.Visible = true;
                    }

                    if (!string.IsNullOrEmpty(dsUserType.Tables[0].Rows[0]["RejectedComments"].ToString()))
                    {
