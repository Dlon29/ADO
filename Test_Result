                              new XAttribute(CONST_XML_ELEMENT_ACCOUNTNBR, drAccount[CONST_COLNAME_ACCOUNTNBR])
                          ));
                        }

                        PopulateCollateralCurrency(xmlAccountList.ToString());
                    }
                }
            }
            catch (Exception Exc)
            {
                _show_error_row = "";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                this.ajxTimer.Enabled = false;
                EnableDisableLoanBookButtons(blnEnableSave);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));

                return false;
            }
            finally
            {
                objDS.Dispose();
                clsReader.Dispose();
                clsDB.Dispose();
            }
            return true;
        }

