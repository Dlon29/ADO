            string collSecurityXML = "";
            string xmlTicketLevel, xmlLoanLevel, xmlCollSecLevel;
            MethodName = "RepoTktSaveETIData()";

            try
            {
                DataReader clsReader = new DataReader();
                DataSet ds = new DataSet();

                xmlTicketLevel = xmlLoanLevel = xmlCollSecLevel = "";
                RepoTktCalculateCleanPrice(null, null);

                //If Loan is Reverse Repo Ticket, then pass the Collateral Input XML else pass "".
                if (Is_FI_RevRepo_Ticket_BOOKING)
                {
                    //This XML is for Collateral Upload Details
                    collSecurityXML = RevRepoTktCollateralInputXML();

                    //This XML is for New Collateral booking details.
                    xmlCollSecLevel = AddNodeToCollateralXMLFile();
                }

                string[] SqlCondition;

                //Prepare 2 XML's for Reverse Repo scenario. One XML will have a data related to RepoTickerBroker and consolidated Amount for all the Loans/
                //Other XML will have all the Spilt Loan details which will be passed to the booking SP.
                //For Repo, both the XML's will be same.
                xmlLoanLevel = AddNodeToXMLFile(false);

                if (Is_FI_RevRepo_Ticket_BOOKING)
                {
                    xmlTicketLevel = AddNodeToXMLTicketFile();
                }
