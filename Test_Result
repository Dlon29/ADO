            Footer_item.Cells[(int)grdMapping.FaceAmount].Text = string.Format("{0:#,##0}", TotalAllocatedUnits);
            Footer_item.Cells[(int)grdMapping.FaceAmount].HorizontalAlign = HorizontalAlign.Right;
        }

