        /// <summary>
        /// Save Basket
        /// </summary>
        /// <param name="ActionType"></param>
        /// <returns></returns>
        private bool SaveBasket(string ActionType)
        {
            Database clsDB = new Database();
            DataCommand clsCmd = new DataCommand();
            bool blnStatus = false;
            MethodName = "SaveBasket()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            try
            {
                string xml = AddNodeToXMLFile("S");

                if (xml == string.Empty)
                    return false;

                DataReader clsReader = new DataReader();
                DataSet ds = new DataSet();

                string[] SqlCondition = new string[1] { "" };
                string Identifier = "";

                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_SaveData_BulkLoan;

                SqlCondition[0] = xml;
                Identifier = "SAVE";

                clsReader.SqlIdentifier = Identifier;

                if (clsReader.GetData(ref ds, SqlCondition) == false)
                {
                    blnStatus = false;
                    _logger.Debug(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                    throw new Exception(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                }
                else
                {
                    blnStatus = true;
                    _logger.InfoFormat("Successfully saved Bulk Loan in LAVA via {0}", SqlObjectsStaticClass.p_SaveData_BulkLoan);
                }


                if (blnStatus && ActionType == SAVE_BASKET)
                    ConfirmMessage(Common.GetMessage(BASKET_CONFIGURATION, "BasketSavedMsg"));

                if (ds.Tables[0].Rows.Count > 0)
                {

                    if (this.vwSelectedBaskets != null)
                    {
                        DataTable dtSelectedBasket = this.vwSelectedBaskets as DataTable;
                        DataRow[] dr = null;

                        foreach (DataRow drColl in ds.Tables[0].Rows)
                        {
                            dr = dtSelectedBasket.Select("BulkNbr =" + drColl["OldBulkNbr"].ToString().Trim());

                            if (dr != null && dr.Length == 0)
                            {
                                dr = dtSelectedBasket.Select("BulkNbr IS NULL");
                            }

                            if (dr != null && dr.Length > 0)
                            {
                                for (int drCount = 0; drCount < dr.Length; drCount++)
                                {
                                    dr[drCount]["BulkNbr"] = drColl["NewBulkNbr"].ToString().Trim();
                                    dr[drCount]["VersionNbr"] = drColl["NewVersionNbr"].ToString().Trim();
                                }

                                dtSelectedBasket.AcceptChanges();
                            }
                        }

                        this.vwSelectedBaskets = dtSelectedBasket;
                        grdSelectedBasket.DataSource = vwSelectedBaskets;
                        grdSelectedBasket.DataBind();

                        // Added on 15-May-2014 for hinding colums in case of FI
                        HideShowColumns(grdSelectedBasket);

                    }
                }

                return blnStatus;

            }
            catch (Exception ex)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(ex.Message);
                _show_error_row = string.Empty;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
                return false;
            }
            finally
            {
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
        }


