        private DataSet RepoTktGetRepoTicketData()
        {
            //Get data from 'RepoTicketBrokerDetail' table 


            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet ds = new DataSet();
            MethodName = "RepoTktGetRepoTicketData()";
            try
            {
                string[] SqlCondition = new string[4] { "", "", "", "" };

                SqlCondition[0] = _batchRunDate;
                SqlCondition[1] = _RepoTktID;
                SqlCondition[2] = hdnRepoTktBrokerID.Value.ToString();
                SqlCondition[3] = clsUI.NTUserName;


                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    return ds;
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.SqlIdentifier = SqlIdentifier.GET_REPOTKT_BROKER_DETAIL_INFO.ToString(); ;

                if (clsReader.GetData(ref ds, SqlObjects.p_GetData_RepoTktBrkDtlInfo, SqlCondition) == false)
                    return null;

            }
            catch (Exception Exc)
            {
                Response.ClearContent();
                Response.ContentType = "text/html";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));

            }
            finally
            {
                ds.Dispose();
                clsReader.Dispose();
                clsDB.Dispose();
            }

            return ds;
        }

