        /// <summary>
        /// Update basket
        /// </summary>
        /// <param name="dtUpdateDataToBasket"></param>
        private void UpdateBasket(DataTable dtUpdateDataToBasket)
        {
            DataTable dtSelectedBasket = null;
            DataRow[] dr = null;
            MethodName = "UpdateBasket()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            try
            {
                if (vwSelectedBaskets != null)
                {
                    dtSelectedBasket = this.vwSelectedBaskets as DataTable;

                    foreach (DataRow drColl in dtUpdateDataToBasket.Rows)
                    {
                        dr = dtSelectedBasket.Select("SecID =" + drColl["SecID"].ToString().Trim());

                        if (dr != null && dr.Length > 0)
                        {
                            if (drColl["BrokerLendable"] != DBNull.Value)
                                dr[0]["BrokerLendable"] = Convert.ToInt64(drColl["BrokerLendable"].ToString().Trim().Replace(",", ""));
                            if (drColl["PriceBaseCurrency"] != DBNull.Value)
                                dr[0]["PriceBaseCurrency"] = Convert.ToDecimal(drColl["PriceBaseCurrency"].ToString().Trim());
                            if (drColl["FxRate"] != DBNull.Value)
                                dr[0]["FxRate"] = Convert.ToDecimal(drColl["FxRate"].ToString().Trim().Replace("&nbsp;", ""));
                            if (drColl["TraderLendable"] != DBNull.Value)
                                dr[0]["TraderLendable"] = Convert.ToInt64(drColl["TraderLendable"].ToString().Trim().Replace(",", ""));


                            if ((dr[0]["FaceAmount"] != DBNull.Value) && (dr[0]["BrokerLendable"] != DBNull.Value))
                            {
                                //Changes added For P2201 for display the Records on TOP where FaceAmount > BrokerLendable.
                                if (Convert.ToInt64(dr[0]["FaceAmount"]) > Convert.ToInt64(dr[0]["BrokerLendable"]))
                                    dr[0]["isQtyGreaterThanBrkLendable"] = 1;
                                else
                                    dr[0]["isQtyGreaterThanBrkLendable"] = 0;
                            }


                            if (drColl["Default_Open_TPUID"] != DBNull.Value)
                            {
                                dr[0]["Default_Open_TPUID"] = Convert.ToString(drColl["Default_Open_TPUID"]);
                            }

                            if (drColl["Default_Term_TPUID"] != DBNull.Value)
                            {
                                dr[0]["Default_Term_TPUID"] = Convert.ToString(drColl["Default_Term_TPUID"]);
                            }


                            if (Convert.ToString(dr[0]["TPUID"]) == string.Empty)
                            {
                                if (drColl["Default_Open_TPUID"] != DBNull.Value)
                                {
                                    dr[0]["TPUID"] = Convert.ToString(drColl["Default_Open_TPUID"]);
                                }

                                DateTime termDate = DateTime.MinValue;
                                if ( (dr[0]["TermDate"] != DBNull.Value) && DateTime.TryParse(Convert.ToString(dr[0]["TermDate"]), out termDate) && termDate.Year > 1900)
                                {
                                    dr[0]["TPUID"] = Convert.ToString(drColl["Default_Term_TPUID"]);
                                }
                            }

                            if (drColl["IsPrePay"] != DBNull.Value)
                            {
                                dr[0]["IsPrePay"] = drColl["IsPrePay"]; 
                            }

                            dtSelectedBasket.AcceptChanges();
                        }
                    }

                    //calculate Total basket market cap
                    object SumPrincipal = dtSelectedBasket.Compute("Sum (Principal)", "");
                    txtCurrBasketMktCap.Text = SumPrincipal != DBNull.Value ? Convert.ToDecimal(SumPrincipal).ToString("#,##0.00####") : string.Empty;


                    DataView dv = dtSelectedBasket.DefaultView;
                    dv.Sort = "isQtyGreaterThanBrkLendable DESC";

                    this.vwSelectedBaskets = dv.ToTable();
                    grdSelectedBasket.DataSource = vwSelectedBaskets;
                    grdSelectedBasket.DataBind();
                }
            }
            catch (Exception ex)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(ex.Message);
                _show_error_row = string.Empty;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
            }
            finally
            {
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
        }

