		private bool PopulateCollateralCurrency(string allocatedAccounts)
        {
            DataSet objDS = new DataSet();
            string isFIRepo;
            ListItem collCCYSelectedItem;
            MethodName = "PopulateCollateralCurrency()";

            try
            {
                if ((this._secType == Common.enumSecType.FI.ToString()) && ((this.cboLoanCategory.SelectedValue == enumLoanCategory.CR.ToString()) || this.cboLoanCategory.SelectedValue == enumLoanCategory.RR.ToString()))
                {
                    isFIRepo = Common.STRNBRONE;
                }
                else
                {
                    isFIRepo = Common.STRNBRZERO;
                }

                objDS = Common.GetCollateralCurrency(isFIRepo, allocatedAccounts, Common.STRBLANK);

                collCCYSelectedItem = cboCollCCY.SelectedItem;

                ListItem lstItem = new ListItem(Common.cboSelectText, Common.cboSelectVal);
                cboCollCCY.DataSource = objDS;
                cboCollCCY.DataTextField = Common.DRP_COLLCURRENCY_TEXT;
                cboCollCCY.DataValueField = Common.DRP_COLLCURRENCY_VALUE;
                cboCollCCY.DataBind();
                cboCollCCY.Items.Insert(0, lstItem);

                // If any item is already selected in the dropdown then after repopulating the dropdown, set the dropdown value to original value
                // If previously selected item is not present in the returned resultset then display Prompt to User and then reset the dropdown. 
                if (collCCYSelectedItem != null)
                {
                    if (cboCollCCY.Items.Contains(collCCYSelectedItem))
                    {
                        cboCollCCY.SelectedValue = collCCYSelectedItem.Value;
                    }
                    else
                    {
                        string jsScript = "alert('" + Common.GetMessage("SingleLoanBooking", "ErrorRepoCurrencyNotSetup") + "');";
                        ScriptManager.RegisterStartupScript(this, this.GetType(), "NoEmailSetup", jsScript, true);

                        cboCollCCY.SelectedValue = Common.cboSelectVal;
                    }
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                _logger.Error(Exc.Message);
                _logger.ErrorFormat(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
            finally
            {
                objDS = null;
            }
            return true;
        }

