                else
                {
                    if (!String.IsNullOrEmpty(this.txtTripartyRepoShellNbr.Text) && (!Common.IsNumber(this.txtTripartyRepoShellNbr.Text)))
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtTripartyRepoShellNbr.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("Common", "ErrorBDAShallNbr") + hdnBDASShellNbr.Value + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }
                }
            }
            // Add Validation For BDASSHell Number Ends
