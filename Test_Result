                                    this.txtTripartyRepoCollType.Text = Convert.ToString(objDS.Tables[3].Rows[0]["Value"]);

                                if (objDS.Tables[4] != null && objDS.Tables[4].Rows.Count > 0)
                                    this.txtTripartyRepoPID.Text = Convert.ToString(objDS.Tables[4].Rows[0]["Value"]);

                                if (objDS.Tables[5] != null && objDS.Tables[5].Rows.Count > 0)
                                    this.txtTripartyRepoNP.Text = Convert.ToString(objDS.Tables[5].Rows[0]["Value"]);
                            }

                            if (sender.ToUpper() == "DDLTRIPARTYREPOSTRUCTURE")
                            {
                                //On Changing TriPartyRepo Structure Sched, populate Notice Period
                                if (objDS.Tables[5] != null && objDS.Tables[5].Rows.Count > 0)
                                    this.txtTripartyRepoNP.Text = Convert.ToString(objDS.Tables[5].Rows[0]["Value"]);
                            }

