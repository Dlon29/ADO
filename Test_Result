    #region Reflection adapter

    // Used only for C1 collection/settings members whose concrete public types
    // are not exposed by this wrapper. Other frequently used C1 types are typed.
    internal static class NativeAccess
    {
        private const BindingFlags PublicInstance = BindingFlags.Public | BindingFlags.Instance;

        private static PropertyInfo Property(object target, string name)
        {
            if (target == null) throw new ArgumentNullException("target");
            PropertyInfo property = target.GetType().GetProperty(name, PublicInstance);
            if (property == null) throw new MissingMemberException(target.GetType().FullName, name);
            return property;
        }

        public static T Get<T>(object target, string name)
        {
            object value = Property(target, name).GetValue(target, null);
            if (value == null) return default(T);

            Type destination = Nullable.GetUnderlyingType(typeof(T)) ?? typeof(T);
            if (destination.IsInstanceOfType(value)) return (T)value;
            if (destination.IsEnum) return (T)Enum.Parse(destination, value.ToString(), false);
            return (T)Convert.ChangeType(value, destination);
        }

        public static void Set(object target, string name, object value)
        {
            PropertyInfo property = Property(target, name);
            if (!property.CanWrite) throw new MissingMemberException(target.GetType().FullName, name);
            if (value != null)
            {
                Type destination = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
                if (!destination.IsInstanceOfType(value))
                    value = destination.IsEnum
                        ? Enum.Parse(destination, value.ToString(), false)
                        : Convert.ChangeType(value, destination);
            }
            property.SetValue(target, value, null);
        }

        public static object GetIndexed(object target, int index)
        {
            if (target == null) throw new ArgumentNullException("target");
            foreach (PropertyInfo property in target.GetType().GetProperties(PublicInstance))
                if (property.Name == "Item" && property.GetIndexParameters().Length == 1)
                    return property.GetValue(target, new object[] { index });
            throw new MissingMemberException(target.GetType().FullName, "Item");
        }

        public static void Invoke(object target, string name, params object[] arguments)
        {
            if (target == null) throw new ArgumentNullException("target");
            foreach (MethodInfo method in target.GetType().GetMethods(PublicInstance))
            {
                if (method.Name != name) continue;
                ParameterInfo[] parameters = method.GetParameters();
                if (parameters.Length != arguments.Length) continue;

                bool matches = true;
                for (int i = 0; i < parameters.Length; i++)
                {
                    if (arguments[i] == null)
                    {
                        if (parameters[i].ParameterType.IsValueType &&
                            Nullable.GetUnderlyingType(parameters[i].ParameterType) == null)
                            matches = false;
                    }
                    else if (!parameters[i].ParameterType.IsAssignableFrom(arguments[i].GetType()))
                        matches = false;
                    if (!matches) break;
                }
                if (matches)
                {
                    method.Invoke(target, arguments);
                    return;
                }
            }
            throw new MissingMethodException(target.GetType().FullName, name);
        }
    }

