                    SqlCondition[9] = string.Empty; //SecCode
                    SqlCondition[10] = cboCriteriaCollCCY.SelectedValue; //CollCCYCode
                    SqlCondition[11] = string.Empty; //CountrySelected
                    SqlCondition[12] = secIDs.ToString(); //SecIdList

                    if (clsReader.GetData(ref objDS, SqlObjects.p_GetData_BulkLoanAvailability, SqlCondition) == false)
                    {
                        return false;
                    }

                    if (objDS.Tables[0].Rows.Count > 0)
                    {

                        UpdateBasket(objDS.Tables[0]);

                        pnlSavedBasketMsg.Visible = false;
                        divSelectedBaskets.Visible = true;

                        cmdAllocate.Enabled =
                            cmdSaveBasket.Enabled = true;

                    }
                    else
                    {
                        ConfirmMessage(Common.GetMessage(BASKET_CONFIGURATION, "BasketNotRefreshedMsg"));
                    }

                    //Get Collateral Schedule ID value
                    clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance;
                    DataSet objCollDS = new DataSet();
                    SqlCondition = new string[2] { "", "" };

                    clsReader.SqlIdentifier = SqlIdentifier.GET_BRK_COLL_SCHED_TRIPARTY_MAPPING.ToString();

                    SqlCondition[0] = _BussDate;

                    if (txtWLBroker.Text == string.Empty)
                        SqlCondition[1] = cboEQLBroker.SelectedValue;
                    else
                        SqlCondition[1] = txtWLBroker.Text.Trim();

                    if (clsReader.GetData(ref objCollDS, SqlCondition) == false)
                        return false;

                    if (objCollDS != null && objCollDS.Tables.Count > 0 && objCollDS.Tables[0].Rows.Count > 0)
                        COLL_SCHEDULE_ID_VAL = string.IsNullOrEmpty(objCollDS.Tables[0].Rows[0]["CollScheduleId"].ToString()) ? null : Convert.ToString(objCollDS.Tables[0].Rows[0]["CollScheduleId"]);
                }

                else if (ActionType == UPLOAD_BASKET)
                {
                    bool IsInvalidSecurityPresent = false;
                    bool IsBlockedSecurityPresent = false;
                    StringBuilder strBlockedSecCode = new StringBuilder();

                    cboCriteriaSecutiyType.SelectedValue = cboUploadSecutiyType.SelectedValue;  //Added for P-1486

                    SqlCondition = new string[18] { "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "" };

                    clsReader.SqlIdentifier = UPLOAD_BASKET;

                    StringBuilder secAtt = GetXML4BulkUpload(hdnSelectedSecID.Value);

                    SqlCondition[0] = _BussDate; //BussDate
                    SqlCondition[1] = string.Empty; //BulkNbr
                    SqlCondition[2] = string.Empty; //VersionNbr
                    SqlCondition[3] = cboUploadSecutiyType.SelectedValue; //SecType   // Added for M-443 Passing secType to SP
                    SqlCondition[4] = string.Empty; //BrkCrGrpID
                    SqlCondition[5] = string.Empty;//BrkGrpID
                    SqlCondition[6] = string.Empty; //BrkNbr
                    SqlCondition[7] = string.Empty;//FinderNbr
                    SqlCondition[8] = string.Empty; //UserCode
                    SqlCondition[9] = string.Empty;  //Comments
                    SqlCondition[10] = string.Empty;  //CollSchedID
                    SqlCondition[11] = string.Empty; //FinderNbrAvailOnly
                    SqlCondition[12] = string.Empty; //LowDivRate
