            {
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
        }
        private bool ValidateTPUID()
        {
            bool IsValidTPUID = true;
            bool IsDVP = false;
            bool IsFoP = false;
            var dtTPUID = (DataTable)ViewState["TPUIDList"];
            var gridRows = grdSelectedBasket.Items;
            _ErrorString = new StringBuilder();
            MethodName = "ValidateTPUID()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            for (int i = 0; i < gridRows.Count; i++)
            {
                var item = gridRows[i];
                if (item.ItemType == ListItemType.Item || item.ItemType == ListItemType.AlternatingItem || item.ItemType == ListItemType.SelectedItem)
                {
                    DropDownList drpTPUID = (DropDownList)item.Cells[(int)enumgrdSelectedBasketMapping.TPUID].FindControl("drpTPUID");

                    string dvpFop = (from r in dtTPUID.AsEnumerable().Where(e => e.Field<string>("TPUID") == drpTPUID.SelectedValue)
                                     select r.Field<string>("DVPFOP")).FirstOrDefault<string>();
                    if (dvpFop != null && dvpFop.ToLower() == "dvp") { IsDVP = true; }
                    else if (dvpFop != null && dvpFop.ToLower() == "fop") { IsFoP = true; }
                    if (IsDVP && IsFoP)
                    {
                        _ErrorString.Append("\t" + Common.GetMessage("BasketConfiguration", "InValidTPUID") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                        IsValidTPUID = false;
                        cmdAllocate.Enabled = cmdSaveBasket.Enabled = false;
                        break;
                    }
                }
            }
            if (_ErrorString.Length > 0)
            {
                _show_error_row = string.Empty;
                throw new Exception(_ErrorString.ToString());
            }
            return IsValidTPUID;
        }
