        protected void GetShellNumbersforPairOff(object sender, EventArgs e)
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            SqlDataReader clsDR = null;
            Boolean isError = false;
            MethodName = "GetShellNumbersforPairOff";

            try
            {
                if (txtSetelmentDate.Text == string.Empty)
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtSetelmentDate.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorSettDate") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                    isError = true;
                }

                if (txtSetelmentDate.Text != string.Empty)
                {
                    if (txtSetelmentDate.Text.Length > 0 && (!Common.CheckDate(txtSetelmentDate.Text)))
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtSetelmentDate.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorSettDate") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                        isError = true;
                    }
                }

                if (this.rbEquiLendBrokerSelection.Checked && this.cboBroker.SelectedValue == "0")
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].cboBroker.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorBroker") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                    isError = true;
                }

                if (!this.rbEquiLendBrokerSelection.Checked && this.txtBroker.Text == "")
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtBroker.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorBroker") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                    isError = true;
                }

                if (!isError)
                {
                    if (ChkIsTripartyRepoPairOff.Checked)
                    {
                        EnableDisableShellNumberControls(true);
                        string[] SqlCondition = new string[8] { "", "", "", "", "", "", "", "" };

                        if (clsDB.Open() == false)
                        {
                            _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                            return;
                        }

                        clsReader.Connection = clsDB.Connection;
                        clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance;
                        clsReader.SqlIdentifier = SqlIdentifier.CBO_TRIPARTYREPO_PAIROFF_SHELLNUMBERS.ToString();

                        SqlCondition[0] = txtSetelmentDate.Text.Trim();
                        SqlCondition[1] = this.rbEquiLendBrokerSelection.Checked ? cboBroker.SelectedValue : txtBroker.Text.Trim().ToUpper();

                        if (clsReader.GetData(ref clsDR, SqlCondition) == false)
                            return;

                        ddlTripartyRepoPairOffShellNbr.DataSource = clsDR;
                        ddlTripartyRepoPairOffShellNbr.DataTextField = "TripartyRepoShellNbr";
                        ddlTripartyRepoPairOffShellNbr.DataValueField = "TripartyRepoShellNbr";
                        ddlTripartyRepoPairOffShellNbr.DataBind();
                        ddlTripartyRepoPairOffShellNbr.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));

                        clsDR.Close();
                    }
                    else
                    {
                        EnableDisableShellNumberControls(false);
                        PopulateBDASControls("TRIPARTYREPO_PAIROFF");
                    }
                }
                else
                {
                    if (_ErrorString.Length > 0)
                        _show_error_row = "";

                    if (ddlTripartyRepoPairOffShellNbr.Items.Count == 0)
                        ddlTripartyRepoPairOffShellNbr.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));


                    return;
                }
            }
            catch (Exception Exc)
            {
                _show_error_row = "";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
            finally
            {
                if (clsDR != null && !clsDR.IsClosed)
                    clsDR.Close();

                clsReader.Dispose();
                clsDB.Dispose();
            }
        }

