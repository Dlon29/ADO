        /// <summary>
        /// Timer tick event
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void Timer1_Tick(object sender, EventArgs e)
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            Hashtable htMain = new Hashtable();
            DataSet objDS = new DataSet();
            DataRow dr = null;
            MethodName = "Timer1_Tick()";
            SqlObjects ProcName;

            try
            {
                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                }

                clsReader.Connection = clsDB.Connection;

                string[] SqlCondition = new string[1];
                SqlCondition[0] = this.litSourceID.Text.ToString();

                if ((tr_Override50Mln.Visible) && (!chkBreakLoan.Checked) && (this._secType == Common.enumSecType.FI.ToString()))
                {
                    ProcName = SqlObjects.op_LoanRequestStatusReportForLoanBreak;
                    clsReader.StoredProcedure = SqlObjectsStaticClass.op_LoanRequestStatusReportForLoanBreak;
                }
                else
                {
                    ProcName = SqlObjects.op_LoanRequestStatusReport;
                    clsReader.StoredProcedure = SqlObjectsStaticClass.op_LoanRequestStatusReport;
                }


                if (clsReader.GetData(ref objDS, ProcName, SqlCondition) != false)
                {
                    if (objDS != null && objDS.Tables.Count > 0)
                    {
                        for (int i = 0; i < objDS.Tables[0].Rows.Count; i++)
                        {
                            dr = objDS.Tables[0].Rows[i];

                            if (!Convert.IsDBNull(dr["StatusDesc"]) && dr["StatusDesc"].ToString() != "" && !this.txtLoanProcessStatus.Text.Contains(dr["StatusDesc"].ToString()))
                            {
                                this.txtLoanProcessStatus.Text = DateTime.Now.ToString("T") + " - " + dr["StatusDesc"].ToString() + "\n" + this.txtLoanProcessStatus.Text;
                            }

                            if (Convert.ToBoolean(dr["LoanSuccess"]))
                            {
                                if (!this.cmdShowAllocation.Visible)
                                {
                                    object[] temp = new object[5];

                                    string value = "JavaScript: return onETIDetail(";
                                    value += dr["ID"].ToString() + ", '" + Convert.ToDateTime(dr["BatchDate"]).ToShortDateString();
                                    value += "', " + dr["RecordTypeID"].ToString() + ", " + dr["BatchNbr"].ToString() + ",";
                                    value += "140,'" + _secType.Trim() + "'); \n";

                                    this.cmdShowAllocation.Attributes.Add("onclick", value);
                                    this.cmdShowAllocation.Visible = true;
                                }
                            }
                        }
                    }
                }
                else
                    throw new Exception(Common.GetMessage("Common", "FailedToRetrieveFlowStatus"));
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                this.ajxTimer.Enabled = false;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
            finally
            {
                clsDB.Dispose();
            }

        }

