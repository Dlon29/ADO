                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtRate.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorREBFEE") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }


                if (this._secType == Common.enumSecType.FI.ToString() && this.cboLoanCategory.SelectedValue == enumLoanCategory.CR.ToString() && txtComments.Text == string.Empty)
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtComments.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorRemarks") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }

                if (this.cboSettlementCCY.SelectedIndex == 0 || this.cboSettlementCCY.SelectedItem.Value == string.Empty) //added validation for 'Settlement CCY'
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].cboSettlementCCY.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorSettMode") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }





                try
                {

                    if (txtSetelmentDate.Text.Length > 0 && (!Common.CheckDate(txtSetelmentDate.Text)))
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtSetelmentDate.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorSettDate") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }
                    else if (this.txtSetelmentDate.Text.Trim().Length > 0 && Convert.ToDateTime(this.txtSetelmentDate.Text.Trim()) < Convert.ToDateTime(_G1BatchDate))
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtSetelmentDate.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorSettDateLessBussDate") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }
                }
                catch (Exception)
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtSetelmentDate.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorSettDate") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }


                if (txtAsOfDate.Text != string.Empty)
                {
                    if (Common.CheckHoliday(txtAsOfDate.Text))
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtAsOfDate.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorAsOfDateWeekend") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }
                }


                if (txtTermDate.Text != string.Empty)
                {
                    if (Common.CheckHoliday(txtTermDate.Text))
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtTermDate.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorTermDateWeekend") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }
                }

                if (txtSetelmentDate.Text != string.Empty)
                {
                    if (Common.CheckHoliday(txtSetelmentDate.Text))
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtSetelmentDate.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorSettDateWeekend") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }

                    //Check Holiday for Country Change request in Release 5.1.0  -- Do the  Changes for EQ and RI
                    if (this._secType != Common.enumSecType.FI.ToString())
                    {
                        if (Common.CheckHoliday(txtSetelmentDate.Text, litCountryCode.Text))
                        {
                            _ErrorString.Append("<a href = \"javascript: document.forms[0].txtSetelmentDate.focus();\">\n");
                            _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorSettDateWeekendForCountry") + "\n");
                            _ErrorString.Append("</a> <br>\n");
                        }
                    }

                }

                if (string.IsNullOrEmpty(txtNoteToCustomer.Text))
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtNoteToCustomer.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorNoteToCustomer") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }



                #endregion

            } // end of if (Is_FI_Repo_Ticket_BOOKING)
            #endregion

            //Start - Validate whether selected broker is setup in MTM Report Assignment
            if (this._secType == Common.enumSecType.EQ.ToString() || this._secType == Common.enumSecType.RI.ToString() || (this._secType == Common.enumSecType.FI.ToString() && this.cboLoanCategory.SelectedValue != enumLoanCategory.CR.ToString() && this.cboLoanCategory.SelectedValue != enumLoanCategory.RR.ToString()))
            {
                if (!IS_BRK_EXISTS_MTM_REPORT_ASSIGNMENT)
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtBroker.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("Common", "ErrorBrkNotSetUpInMTM") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }
            }
            //End - Validate whether selected broker is setup in MTM Report Assignment

            //Start - Validate whether Use Existing UTI option is selected. If yes the Loan Reference Nmuber textbox should not be blank
            if (rbReuseUTI.Checked == true && txtLoanRefNbrUTI.Text.Trim() == "")
            {
                _ErrorString.Append("<a href = \"javascript: document.forms[0].txtLoanRefNbrUTI.focus();\">\n");
                _ErrorString.Append("\t" + Common.GetMessage("Common", "BlankLoanRefNbr") + "\n");
                _ErrorString.Append("</a> <br>\n");
            }
            //End - Validate whether Use Existing UTI option is selected. If yes the Loan Reference Nmuber textbox should not be blank

            //Start : P2420.2 Additional Reverse Repo Ticket Validations
            if (Is_FI_RevRepo_Ticket_BOOKING)
            {
                //Validate the Term Date for Reverse Repo. Term Date should be Settlement Date + 1
                if ((!DateTime.Equals(Convert.ToDateTime(txtTermDate.Text), Convert.ToDateTime(hdnRevRepoExpectedTermDate.Value))))
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtTermDate.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorTermDateRevRepo") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }

                //Validate Collateral Details are uploaded in the grid or not
                if (ValidateCollateralSecuritiesPresent() == false)
                {
                    _ErrorString = new StringBuilder();
                    _ErrorString.Append("<a>" + Common.GetMessage("SingleLoanBooking", "ErrorMissingCollateralDetails") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                    _show_error_row = "";
                }

                //Validate the Pricipal of Loan Input against the Collateral Input
                if (ValidatePrincipalMatch() == false)
                {
                    _ErrorString = new StringBuilder();
                    _ErrorString.Append("<a>" + Common.GetMessage("SingleLoanBooking", "ErrorPrincipalMismatch") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                    _show_error_row = "";
                }

                //Validate the Collateral Security is a Valid security or not
                if (ValidateCollateralSecurity() == false)
                {
                    _ErrorString = new StringBuilder();
                    _ErrorString.Append("<a>" + Common.GetMessage("SingleLoanBooking", "ErrorInvalidCollSecurity") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                    _show_error_row = "";
                }
            }
            //End : P2420.2 Additional Reverse Repo Ticket Validations

            if (_ErrorString.Length > 0)
            {
                _show_error_row = "";

                if (Is_FI_Repo_Ticket_BOOKING || Is_FI_RevRepo_Ticket_BOOKING)
                    this.btnSendForApproval.Enabled = false;

                //log.Debug(_ErrorString.ToString());
                //throw new Exception(_ErrorString.ToString());
            }
            else
            {
                blnValidReq = true;
            }
            return blnValidReq;
        }

