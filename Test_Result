        /// <summary>
        /// Add node to xml file
        /// </summary>
        /// <param name="ActionType"></param>
        /// <returns></returns>
        private string AddNodeToXMLFile(string ActionType)
        {
            //create new instance of XmlDocument
            XmlDocument doc = new XmlDocument();
            bool blnFirstRowProcessed = false;
            string path = string.Empty;
            string strMainNode = string.Empty;
            string xml = string.Empty;
            MethodName = "AddNodeToXMLFile()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            string selectedEmailID;

            try
            {
                if (ActionType == "D" || ActionType == "S" || ActionType == "U") // for delete or save or update basket
                {
                    path = @"/LAVA/XmlTemplates/BasketConfiguration.xml";
                    strMainNode = BASKET_CONFIGURATION;
                }
                else if (ActionType == "A" || ActionType == "B" || ActionType == "FI_B") //for allocation and loan booking
                {
                    path = @"/LAVA/XmlTemplates/NewLoan.xml";
                    strMainNode = "NewLoan";
                }

                selectedEmailID = GetSelectedEmailID();

                //load from file
                XmlTextReader reader = new XmlTextReader(Server.MapPath(path));
                doc.Load(reader);

                //create main node
                XmlNode mainNode = doc.SelectSingleNode(strMainNode);

                DataGridItem dgi = null;
                int iXmlRowCount = 1;
                int intRowCount = 0;

                if (ActionType == "D")  //Delete
                {
                    RadioButton rb = null;
                    foreach (DataGridItem item in grdSavedBasket.Items)
                    {
                        rb = (RadioButton)item.FindControl("rdSelect");
                        if (rb.Checked)
                        {

                            doc.DocumentElement.ChildNodes[0].Attributes["BulkNbr"].Value = item.Cells[(int)enumgrdSavedBasketMapping.BulkNbr].Text; //BulkNbr
                            doc.DocumentElement.ChildNodes[0].Attributes["VersionNbr"].Value = item.Cells[(int)enumgrdSavedBasketMapping.VersionNbr].Text; //BulkNbr
                            doc.DocumentElement.ChildNodes[0].Attributes["ModifiedBy"].Value = this.clsUI.NTUserName;
                            intRowCount += 1;
