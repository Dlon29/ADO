        /// <summary>
        /// This method will be called to save data in database
        /// </summary>
        private void SaveLoan()
        {
            bool blnValidReq = false;
            MethodName = "SaveLoan()";

            try
            {
                string confirmValue = Request.Form["confirm_value"];

                if (hdnValidateAsOfDate.Value == "Yes")
                {
                    if (cmdBookLoan.Enabled == false)
                        return;

                    if (this._secType == Common.enumSecType.FI.ToString())
                    {
                        if (hdnValidateDMCSecurity.Value == "No" || hdnValidateFIMaturedSecurity.Value == "No")
                        {
                            return;
                        }
                    }

                    _ClickCount = Convert.ToInt32(hdnBtnClickCount.Value);
                    _ClickCount++;

                    // This function will calculate Total Units Lendable at server side...
                    if (this._secType == Common.enumSecType.FI.ToString())
                        FI_txtUnitsAllocated_Calculate();
                    else
                        EQ_txtUnitsAllocated_Calculate();


                    blnValidReq = ValidateInput();

                    //Display a warning message if there are no Trader Emails setup. 
                    if (chkSupressEmailConfirm.Checked == false && GetSelectedEmailID() == Common.STRBLANK)
                    {
                        string jsScript = "alert('" + Common.GetMessage("SingleLoanBooking", "WarningNoEmailSetup") + "');";
                        ScriptManager.RegisterStartupScript(this, this.GetType(), "NoEmailSetup", jsScript, true);
                    }

                    if (blnValidReq)
                    {
                        if (_ClickCount == 1)
                        {
                            _logger.Info("Book Loan Button Click Count: " + _ClickCount.ToString() + " At: " + DateTime.Now.ToString() + " By User: " + this.clsUI.NTUserName);
                            hdnBtnClickCount.Value = _ClickCount.ToString();


                            EnableDisableLoanBookButtons(false);
                            cmdAllocate.Enabled = false;
                            chkOverrideAlloc.Visible = false;

                            /* This Code is Commented and move to SaveETIRawData method(), will call this, after  scussfull insertion of data in ETI table.
                            this.ajxTimer.Enabled = true;
                            * */

                            CheckLoanRequest();

                            SaveETIRawData();
                        }
                    }
                }
            }
            catch (Exception Exc)
            {
                if (blnValidReq)
                    this.txtLoanProcessStatus.Text = DateTime.Now.ToString("T") + " - GCI Request Sent - Failed\n" + this.txtLoanProcessStatus.Text;

                _show_error_row = "";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                this.ajxTimer.Enabled = false;
                EnableDisableLoanBookButtons(true);
                chkOverrideAlloc.Visible = true;
                this.cmdAllocate.Enabled = true;
                hdnBtnClickCount.Value = "0";
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
        }



        /// <summary>
        /// This method will be called to save data in database
        /// </summary>
        private bool RepoTktSaveLoanInformationByMaker(Boolean isValidataionRequired)
        {
            bool blnStatus = false;
            bool blnValidReq = false;
            Database clsDB = new Database();
            DataCommand clsCmd = new DataCommand();
            string collSecurityXML = "";
            MethodName = "RepoTktSaveLoanInformationByMaker()";

            try
            {
                if (isValidataionRequired)
                    blnValidReq = ValidateAllocationInput();
                else
                    blnValidReq = true;

                if (blnValidReq)
                {
                    CalculateAmountAndPriceOnPostBack();
                    string xml = RepoTktCreateXMLFile("SAVE_LOAN_BY_MAKER");

                    //If Loan is Reverse Repo Ticket, then pass the Collateral Input XML else pass "".
                    if (Is_FI_RevRepo_Ticket_BOOKING)
                        collSecurityXML = RevRepoTktCollateralInputXML();

                    DataReader clsReader = new DataReader();
                    DataSet ds = new DataSet();
                    int nReturnValue = 0;

                    string[] SqlCondition;


                    if (clsDB.Open() == false)
                    {
                        _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                        throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    }

                    clsReader.Connection = clsDB.Connection;
                    clsReader.SqlIdentifier = SqlIdentifier.REPOTKT_SAVE_LOAN_INFO.ToString();

                    SqlCondition = new string[9] { "", "", "", "", "", "", "", "", "" };
                    SqlCondition[0] = xml;
                    SqlCondition[1] = chkBreakLoan.Enabled == true ? (!chkBreakLoan.Checked).ToString() : (chkBreakLoan.Checked).ToString();//IsLoanBreak.ToString();
                    SqlCondition[2] = Convert.ToInt16(StatusIDForLoanBooking.SAVE_BY_MAKER).ToString();
                    SqlCondition[3] = _RepoTktID;
                    SqlCondition[4] = hdnRepoTktBrokerID.Value.ToString();
                    SqlCondition[5] = this.rbEquiLendBrokerSelection.Checked ? cboBroker.SelectedValue : txtBroker.Text.Trim().ToUpper();
                    SqlCondition[6] = clsUI.NTUserName;
                    SqlCondition[7] = collSecurityXML;
                    SqlCondition[8] = (Is_FI_RevRepo_Ticket_BOOKING ? txtRRLinkRefNbr.Text : Common.STRBLANK);

                    if (clsReader.GetData(ref ds, SqlObjects.p_SaveLoanInformation_FI_MAKER, ref nReturnValue, SqlCondition) == false)
                    {
                        blnStatus = false;
                        _logger.Debug(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                        throw new Exception(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                    }
                    else
                    {
                        blnStatus = true;

                        if (string.IsNullOrEmpty(hdnRepoTktBrokerID.Value) || hdnRepoTktBrokerID.Value == Common.STRNBRZERO)
                            hdnRepoTktBrokerID.Value = nReturnValue.ToString();

                    }
                }
            }
            catch (Exception Exc)
            {
                string Logmessage = "User Name:" + clsUI.NTUserName + ",SeCode :" + litSecCode.Text + ",Broker Nbr:" + (txtBroker.Text != "" ? txtBroker.Text : cboBroker.SelectedItem.Text) + ",CollSchedId :" + cboCollSched.SelectedItem.Text + ",Quantity:" + txtQuantity.Text + ",Price:" + txtPrice.Text;
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                _logger.Debug(Logmessage);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
                blnStatus = false;
            }

            return blnStatus;
        }

        private string RepoTktCreateXMLFile(string Identifier)
