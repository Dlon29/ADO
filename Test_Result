        /// <summary>
        /// Validate whether Broker is set up in MTM Report Assignment
        /// </summary>
        private void ValidateBrokerSetUpInMTM()
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            string[] SqlCondition = new string[8] { "", "", "", "", "", "", "", "" };
            MethodName = "ValidateBrokerSetUpInMTM()";

            try
            {
                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance;

                //Start - Validate whether selected broker is setup in MTM Report Assignment
                DataSet objMTMDS = new DataSet();
                clsReader.SqlIdentifier = SqlIdentifier.GET_BRK_MTM_REPORT_ASSIGNMENT.ToString();

                SqlCondition[0] = _batchRunDate;

                if (txtBroker.Text == string.Empty)
                    SqlCondition[1] = cboBroker.SelectedValue;
                else
                    SqlCondition[1] = txtBroker.Text.Trim();

                SqlCondition[2] = this._secType;
                SqlCondition[3] = cboCollCCY.SelectedItem.Value.Trim();
                SqlCondition[4] = litSecId.Text.Trim();

                if (clsReader.GetData(ref objMTMDS, SqlCondition) == false)
                    _logger.Debug(Common.GetMessage("Common", "ErrorInRetrieveData"));

                if (objMTMDS != null && objMTMDS.Tables.Count > 0 && objMTMDS.Tables[0].Rows.Count > 0)
                {
                    if (!String.IsNullOrEmpty(Convert.ToString(objMTMDS.Tables[0].Rows[0]["MTMNewLoans"])))
                    {
                        IS_BRK_EXISTS_MTM_REPORT_ASSIGNMENT = true;
                    }
                    else
                    {
                        IS_BRK_EXISTS_MTM_REPORT_ASSIGNMENT = false;
                    }

                }
                else
                {
                    IS_BRK_EXISTS_MTM_REPORT_ASSIGNMENT = false;
                }
                //End - Validate whether selected broker is setup in MTM Report Assignment
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
        }

        /// <summary>
        /// This method will get data for selected broker and requested Qunatity.
        /// </summary>
        /// <returns>True/False</returns>
        private bool Allocation()
        {
            string[] SqlCondition = new string[1] { "" };

            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet objDS = new DataSet();
            DataTable dtLoanInfo = new DataTable();
            XElement xmlAccountList;
            MethodName = "Allocation()";
            bool blnEnableSave = false;

            try
            {
                PopulateBDASControls("CollSchd");
                grdFIRecords.DataBind();
                grdRecords.DataBind();
                CalculateAmountAndPriceOnPostBack();

                if (this._secType == Common.enumSecType.EQ.ToString() || this._secType == Common.enumSecType.RI.ToString() || (this._secType == Common.enumSecType.FI.ToString() && this.cboLoanCategory.SelectedValue != enumLoanCategory.CR.ToString()))
                {
                    ValidateBrokerSetUpInMTM();
                }

                if (ValidateAllocationInput())
                {
                    if (clsDB.Open() == false)
                    {
                        _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    }

                    string xml = AddNodeToXMLFile(true);

                    clsReader.Connection = clsDB.Connection;
                    clsReader.StoredProcedure = (this._secType == Common.enumSecType.EQ.ToString() || this._secType == Common.enumSecType.RI.ToString()) ? SqlObjectsStaticClass.p_GetData_ETI_NewLoanAllocation_EQ : SqlObjectsStaticClass.p_GetData_ETI_NewLoanAllocation_FI;

                    if (xml == string.Empty)
                        return false;

                    SqlCondition[0] = xml;
                    clsReader.SqlIdentifier = SqlIdentifier.SINGLELOAN.ToString();

                    if (clsReader.GetData(ref objDS, SqlCondition) == false)
                    {
                        _logger.Debug(Common.GetMessage("Common", "ErrorInRetrieveData"));
                    }

                    _ErrorString = new StringBuilder();

                    if (objDS.Tables[0].Rows.Count > 0)
                    {
                        if (this._secType == Common.enumSecType.EQ.ToString() || this._secType == Common.enumSecType.RI.ToString())
                        {
                            grdRecords.DataSource = objDS.Tables[0].DefaultView;
                            grdRecords.DataBind();
                        }
                        else
                        {
                            if (!Is_FI_RevRepo_Ticket_BOOKING)       //Do not bind the Account Allocation grid in case of Reverse Repo Trade booking.
                            {
                                grdFIRecords.DataSource = objDS.Tables[0].DefaultView;
                                grdFIRecords.DataBind();
                            }
                            else
                            {
                                //Display message "Allocation Successful" in case of Reverse Repo
                                this.txtLoanProcessStatus.Text = DateTime.Now.ToString("T") + "  " + Common.GetMessage("SingleLoanBooking", "SuccessAllocationRevRepo");
                            }
                        }

                        pnlMsg.Visible = false;

                        EnableDisableLoanBookButtons(true);

                        chkOverrideAlloc.Visible = true;
                        chkOverrideAlloc.Checked = false;
                        //cmdAllocate.Enabled = false;

                        IsLoanBreak = Convert.ToBoolean(objDS.Tables[1].Rows[0][0]);

                        // P-1486 Change M-412 -- FI loan booking - User selected Sec Loc Code shouldn't change on click of Allocate
                        if (this._secType != Common.enumSecType.FI.ToString())
                            cboSecLocCode.SelectedValue = objDS.Tables[2].Rows[0][0].ToString();

                        cboPrePayIndicator.SelectedValue = objDS.Tables[0].Rows[0]["IsPrePay"].ToString() == "1" ? "Y" : "N";

