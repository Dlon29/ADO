                    _ErrorString.Append("\t" + Common.GetMessage("Common", "ErrorBDASNPNumeric") + "\n");
                    _ErrorString.Append("<br>\n");
                }


                if (this.ddlTripartyRepoTranType.Text == string.Empty)
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].ddlTripartyRepoTranType.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("Common", "ErrorBDASTransType") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }

                if (this.txtTripartyRepoPID.Text == string.Empty)
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtTripartyRepoPID.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("Common", "ErrorBDASTripcode") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }

                // Add Validation For BDASSHell Number Starts

                //if ((String.IsNullOrEmpty(this.txtTripartyRepoShellNbr.Text)) && (ddlTripartyRepoPairOffShellNbr.SelectedIndex == 0))
                //{
                //    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtTripartyRepoShellNbr.focus();\">\n");
                //    _ErrorString.Append("\t" + Common.GetMessage("Common", "ErrorInncorrectBDAShallNbr")+ "\n");
                //    _ErrorString.Append("</a> <br>\n");
                //}


                bool isContainLetter = !String.IsNullOrEmpty(this.txtTripartyRepoShellNbr.Text) && Char.IsLetter(this.txtTripartyRepoShellNbr.Text[0]);
                if (isContainLetter)
                {
                    string str = this.txtTripartyRepoShellNbr.Text;
                    str = str.Substring(1, str.Length - 1);

                    if (this.txtTripartyRepoShellNbr.Text[0] != 'T')
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtTripartyRepoShellNbr.focus();\">\n");
