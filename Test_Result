                doc.DocumentElement.ChildNodes[0].Attributes["DesiredSTTLevel"].Value = txtDesiredAllInRate.Text.Replace(",", "").Trim();
                doc.DocumentElement.ChildNodes[0].Attributes["DurationOfDays"].Value = NumberOfDays.ToString();
                doc.DocumentElement.ChildNodes[0].Attributes["STTEndDate"].Value = txtDivArbEndDate.Text;
                doc.DocumentElement.ChildNodes[0].Attributes["SettlementDate"].Value = txtSetelmentDate.Text;



                intRowCount++;
            }


            string xml = string.Empty;

            if (intRowCount == 0)
            {
                _show_error_row = "";
                _logger.Debug(Common.GetMessage("SingleLoanBooking", "ErrorProdCatDA"));
                throw new Exception(Common.GetMessage("SingleLoanBooking", "ErrorProdCatDA"));
