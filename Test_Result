        /// <summary>
        /// Allocation
        /// </summary>
        /// <returns></returns>
        private bool Allocation()
        {
            _show_error_row = "NONE";

            string[] SqlCondition = new string[1] { "" };

            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet objDS = new DataSet();
            DataTable dtLoanInfo = new DataTable();
            bool blnError = false;
            bool blnErrorForEitherSec = false;
            DataRow[] dr = null;
            DataRow[] drErrRow = null;
            DataRow[] drAlloc = null;
            DataTable dtSelectedBasket = null;
            DataTable dtAllocationBasket = null;
            string SecID = string.Empty;
            MethodName = "Allocation()";
            DataRow[] drAllocSecurity = null;
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            try
            {

                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                }

                string xml = AddNodeToXMLFile("A");

                clsReader.Connection = clsDB.Connection;
                clsReader.StoredProcedure = (this.cboCriteriaSecutiyType.SelectedValue == Common.enumSecType.EQ.ToString() || this.cboCriteriaSecutiyType.SelectedValue == Common.enumSecType.RI.ToString()) ?
                                        SqlObjectsStaticClass.p_GetData_ETI_NewLoanAllocation_EQ : SqlObjectsStaticClass.p_GetData_ETI_NewLoanAllocation_FI;

                if (xml == string.Empty)
                    return false;

                SqlCondition[0] = xml;
                clsReader.SqlIdentifier = SqlIdentifier.BULKLOAN.ToString();

                if (clsReader.GetData(ref objDS, SqlCondition) == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorInRetrieveData"));
                }

                _ErrorString = new StringBuilder();

                if (objDS.Tables[0].Rows.Count > 0)
                {
                    this.vwAllocation = objDS.Tables[1];
                    dtAllocationBasket = objDS.Tables[1];

                    if (this.vwSelectedBaskets != null)
                    {
                        dtSelectedBasket = this.vwSelectedBaskets as DataTable;

                        foreach (DataRow drColl in objDS.Tables[0].Rows)
                        {
                            SecID = drColl["SecID"].ToString().Trim();

                            dr = dtSelectedBasket.Select("SecID =" + SecID.Trim());

                            if (dr != null && dr.Length > 0)
                            {
                                if (dtAllocationBasket.Columns["Is_DedicatedMarginCollateral_FISecurity"] != null)
                                {
                                    drAllocSecurity = dtAllocationBasket.Select("SecID =" + SecID.Trim() + " AND Is_DedicatedMarginCollateral_FISecurity = 1");
                                    if (drAllocSecurity != null && drAllocSecurity.Length > 0)
                                    {
                                        dr[0]["Is_DedicatedMarginCollateral_FISecurity"] = drAllocSecurity[0]["Is_DedicatedMarginCollateral_FISecurity"];
                                        dtSelectedBasket.AcceptChanges();
                                    }
                                }

                                if (drColl["IsPrePay"] != null)
                                {
                                    dr[0]["IsPrePay"] = Convert.ToString(drColl["IsPrePay"]).Trim().ToUpper() == "1" ? 1 : 0;
                                    dtSelectedBasket.AcceptChanges();
                                }

                                if (drColl["ErrorMessage"].ToString() == string.Empty)
                                {
                                    dr[0]["ErrorMessage"] = string.Empty;
                                    dtSelectedBasket.AcceptChanges();

                                    if (dtAllocationBasket != null)
                                    {
                                        if (dtAllocationBasket.Rows.Count > 0)
                                        {
                                            drAlloc = dtAllocationBasket.Select("WLDepository = '' AND UnitsLendable > 0 AND SecID =" + SecID.Trim());
                                        }
                                    }

                                    if (drAlloc != null && drAlloc.Length > 0)
                                    {
                                        dr[0]["ErrorMessage"] = Common.GetMessage("BasketConfiguration", "ErrorMissingDepository");
                                        dtSelectedBasket.AcceptChanges();

                                        drColl["ErrorMessage"] = Common.GetMessage("BasketConfiguration", "ErrorMissingDepository");
                                        drColl.AcceptChanges();
                                    }
                                }
                            }

                        }

                        foreach (DataRow drColl in objDS.Tables[0].Rows)
                        {
                            SecID = drColl["SecID"].ToString().Trim();

                            dr = dtSelectedBasket.Select("SecID =" + SecID);

                            drErrRow = objDS.Tables[0].Select("SecID =" + drColl["SecID"].ToString().Trim() + " AND ErrorMessage IS NULL");

                            if (drErrRow != null && drErrRow.Length > 0)
                            {
                                blnError = false;
                            }
                            else
                            {
                                blnError = true;

                                DataRow[] drRowSeq = objDS.Tables[0].Select("SecID =" + drColl["SecID"].ToString().Trim() + " AND ErrorMessage IS NOT NULL AND RowSeq = 2");

                                if (drRowSeq != null && drRowSeq.Length > 0)
                                {
                                    blnErrorForEitherSec = true;
                                }
                            }

                            //Commented for P-1486. Showing errorMessage on grid, enven if ASE is check. 
                            if (blnError)
                            {
                                dr = dtSelectedBasket.Select("SecID =" + drColl["SecID"].ToString().Trim());

                                if (dr != null && dr.Length > 0)
                                {
                                    if (drColl["ErrorMessage"].ToString() != string.Empty)
                                    {
                                        dr[0]["ErrorMessage"] = drColl["ErrorMessage"].ToString().Trim();
                                        dr[0]["RowSeq"] = drColl["RowSeq"].ToString().Trim();
                                    }
                                    else
                                    {
                                        dr[0]["ErrorMessage"] = string.Empty;
                                        dr[0]["RowSeq"] = drColl["RowSeq"].ToString().Trim();
                                    }

                                    dtSelectedBasket.AcceptChanges();
                                }
                            }
                            else
                            {
                                dr = dtSelectedBasket.Select("SecID =" + drColl["SecID"].ToString().Trim());

                                if (dr != null && dr.Length > 0)
                                {
                                    if (drColl["ErrorMessage"].ToString() == string.Empty)
                                    {
                                        dr[0]["ErrorMessage"] = string.Empty;
                                        dr[0]["RowSeq"] = drColl["RowSeq"].ToString().Trim();
                                        dtSelectedBasket.AcceptChanges();
                                    }
                                }
                            }
                        }


                        object SumPrincipal = dtSelectedBasket.Compute("Sum (Principal)", "");
                        txtCurrBasketMktCap.Text = SumPrincipal != DBNull.Value ? Convert.ToDecimal(SumPrincipal).ToString("#,##0.00####") : string.Empty;

                        DataView dv = dtSelectedBasket.DefaultView;
                        dv.Sort = "RowSeq DESC";
                        this.vwSelectedBaskets = dv.ToTable();


                        this.vwSelectedBaskets = dtSelectedBasket;
                        grdSelectedBasket.DataSource = vwSelectedBaskets;
                        grdSelectedBasket.DataBind();

                        // Added on 15-May-2014 for hinding colums in case of FI
                        HideShowColumns(grdSelectedBasket);

                        if (blnErrorForEitherSec)
                            cmdBookBasket.Enabled = false;
                        else
                        {
                            DataView defView = objDS.Tables[0].DefaultView;
                            defView.RowFilter = "(ErrorMessage IS NULL OR ErrorMessage = '') OR ((ErrorMessage IS NOT NULL OR ErrorMessage <> '') AND RowSeq <> 2)";

                            this.vwBookLoan = defView.ToTable();
                            cmdBookBasket.Enabled = true;

                        }
                    }
                }
                else
                {
                    cmdBookBasket.Enabled = false;
                }

                if (_ErrorString.Length > 0)
                {
                    throw new Exception(_ErrorString.ToString());
                }
            }
            catch (Exception Exc)
            {
                _show_error_row = string.Empty;
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
                return false;
            }
            finally
            {
                objDS.Dispose();
                clsReader.Dispose();
                clsDB.Dispose();
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
            return true;
        }

