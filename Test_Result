                        txtSettlementInstruction.Text = string.Empty;
                    }
                }

                //IF cboSecurityType is changed from UI, then Broker value is resetting 
                if (sender == "cboSecurityType" || sender == "cboLoanCategory")
                {
                    this.BDAS_SECTION.Visible = Is_TriPartyRepo_FI_REPO_Loan = false;
                    this.FICC_SECTION.Visible = Is_FICC_FI_REPO_Loan = false;

                    PopulateCollateralCurrency(Common.STRBLANK);
                }

                if (sender == null)
                {
                    SqlCondition = new string[1] { "" };
                    SqlCondition[0] = "1";

                    clsReader.SqlIdentifier = SqlIdentifier.CBO_DEPOSITORY.ToString();
                    if (clsReader.GetData(ref clsDR, SqlCondition) == false)
                        return false;

                    cboDepoCode.DataSource = clsDR;
                    cboDepoCode.DataTextField = "DepoCodeDesc";
                    cboDepoCode.DataValueField = "DepoCode";
                    cboDepoCode.DataBind();
                    cboDepoCode.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectEmpty));
                    clsDR.Close();

                    PopulateCollateralCurrency(Common.STRBLANK);
                }

                if (sender == "ddlTripartyRepoStructure")
                {
                    PopulateBDASControls(sender);
                }

                if (!IsPostBack)
                {
                    if (sender == null || sender == "ddlAllocateOverrideReason")
                    {
                        clsReader.SqlIdentifier = SqlIdentifier.GET_ALLOCATION_OVERRIDE_REASON.ToString();
                        if (clsReader.GetData(ref clsDR, SqlCondition) == false)
                            return false;
                        ddlAllocateOverrideReason.DataSource = clsDR;
                        ddlAllocateOverrideReason.DataTextField = "AllocationOverrideReasonDescription";
                        ddlAllocateOverrideReason.DataValueField = "AllocationOverrideReasonValue";
                        ddlAllocateOverrideReason.DataBind();
                        ddlAllocateOverrideReason.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));
                        clsDR.Close();
                    }
                    if (cboSettlementCCY.Items.Count == 0)
                        cboSettlementCCY.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectEmpty));
                    if (cboCollSched.Items.Count == 0)
                        cboCollSched.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectEmpty));

                    if (cboBasketNbr.Items.Count == 0)
                        cboBasketNbr.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectEmpty));

                    this.cboFinder.SelectedValue = "";

                    //P-1486 Code added for Filling Security Type Combo Box
                    if (cboSecurityType.Items.Count == 0) //Condition added on 18_Aug
                    {
                        SqlCondition = new string[2] { "", "" };
                        SqlCondition[0] = _batchRunDate.ToString();
                        SqlCondition[1] = Is_FI_RevRepo_Ticket_BOOKING.ToString();

                        clsReader.SqlIdentifier = SqlIdentifier.CBO_SECURITY_TYPE.ToString();
                        if (clsReader.GetData(ref clsDR, SqlCondition) == false)
                            return false;

                        cboSecurityType.DataSource = clsDR;
                        cboSecurityType.DataTextField = "RepoSecurityTypeDesc";
                        cboSecurityType.DataValueField = "RepoSecurityTypeID";
                        cboSecurityType.DataBind();
                        cboSecurityType.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));
                        clsDR.Close();
                    }
                    //END here P-1486 Code added for Filling Security Type Combo Box

                    //Repopulate the Finder Nbr for Tri Party Lending
                    if (sender == null)
                    {
                        objDSFinderNbr = new DataSet();
                        clsReader.SqlIdentifier = SqlIdentifier.CBO_FINDERNBR.ToString();
                        if (clsReader.GetData(ref objDSFinderNbr, SqlCondition) == false)
                            return false;

                        dvFinderNbr = new DataView(objDSFinderNbr.Tables[0]);

                        dvFinderNbr.RowFilter = "FinderNbr <> '000LSS'";

                        cboFinder.Items.Clear();
                        cboFinder.DataTextField = "FinderNbrDescription";
                        cboFinder.DataValueField = "FinderNbr";
                        cboFinder.DataSource = dvFinderNbr;
                        cboFinder.DataBind();


                    }

                    if (IsLondon && FinderValue == cboFinder.SelectedValue)
                    {
                        this.cboFinder.SelectedIndex = 1; //London Desk                            
                    }
                    else
                    {

                        if (Is_FI_Repo_Ticket_BOOKING)
                        {
                            if (!string.IsNullOrEmpty(FinderValue))
                            {
                                // If Finder is not applicable for  Account then don;t dispaly it.
                                for (int i = cboFinder.Items.Count - 1; i >= 0; i--)
                                {
                                    if (cboFinder.Items[i].Value != FinderValue) cboFinder.Items.RemoveAt(i);
                                }
                            }
                        }

                        if (this.cboFinder.Items.FindByValue(FinderValue) != null)
                        {
                            this.cboFinder.SelectedValue = FinderValue;
                        }
                    }
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                this.ajxTimer.Enabled = false;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
                return false;
            }
            finally
            {
                if (clsDR != null && !clsDR.IsClosed)
                    clsDR.Close();

                clsReader.Dispose();
                clsDB.Dispose();
            }
            return true;
        }

        private bool PopulateCollateralSchedule()
        {
            Database db = new Database();

            try
            {
                if (db.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    return false;
                }

                SqlDataReader sqlRdr = null;

                DataReader dataRdr = new DataReader()
                {
                    Connection = db.Connection,
                    StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance
                };

                string[] sqlParams = new string[8] { "", "", "", "", "", "", "", "" };


                if (Is_FI_Repo_Ticket_BOOKING || Is_FI_RevRepo_Ticket_BOOKING)
                {
                    dataRdr.SqlIdentifier = SqlIdentifier.GET_BRK_COLL_SCHED_FI_REPO_TICKET.ToString();
                }
                else if (this._secType == Common.enumSecType.FI.ToString() && (cboLoanCategory.SelectedValue == enumLoanCategory.CR.ToString() || cboLoanCategory.SelectedValue == enumLoanCategory.RR.ToString()))
                {
                    dataRdr.SqlIdentifier = SqlIdentifier.GET_BRK_COLL_SCHED_FI_REPO.ToString();
                }
                else
                {
                    dataRdr.SqlIdentifier = SqlIdentifier.GET_BRK_COLL_SCHED_LOAN_BOOK.ToString();
                }

                sqlParams[0] = _batchRunDate;
                sqlParams[1] = (txtBroker.Text == string.Empty) ? cboBroker.SelectedValue : txtBroker.Text.Trim();
                sqlParams[2] = cboLoanCategory.SelectedValue;   //P1486 -- Filter Collateral Schedule base upon Loan Category...

                if (dataRdr.SqlIdentifier == SqlIdentifier.GET_BRK_COLL_SCHED_LOAN_BOOK.ToString())
                {
                    sqlParams[3] = cboCollCCY.SelectedValue;
                    sqlParams[4] = string.Empty;
                }
                else
                {
                    sqlParams[3] = cboSecurityType.SelectedValue;
                    sqlParams[4] = (Is_FI_Repo_Ticket_BOOKING || Is_FI_RevRepo_Ticket_BOOKING) ? _RepoTktID : string.Empty;
                }
                sqlParams[5] = string.Empty;
                sqlParams[6] = string.Empty;
                sqlParams[7] = string.Empty;


                if (sqlRdr != null && !sqlRdr.IsClosed)
                {
                    sqlRdr.Close();
                }


                if (!dataRdr.GetData(ref sqlRdr, sqlParams))
                {
                    return false;
                }
                this.cboCollSched.SelectedIndex = -1;
                if (sqlRdr.HasRows)
                {
                    cboCollSched.DataSource = sqlRdr;
                    cboCollSched.DataTextField = "CollSchedName";
                    cboCollSched.DataValueField = "CollSchedId";
                    cboCollSched.DataBind();
                    cboCollSched.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));
                    sqlRdr.Close();

                    if (cboCollSched.Items.Count == 2)
                    {
                        this.cboCollSched.SelectedIndex = 1;    //IF for above combination,we have only CollSched then, default it ....  
                    }
                }
                else
                {
                    this.cboCollSched.Items.Clear();
                }


                if (sqlRdr != null)
                {
                    sqlRdr.Close();
                }
                return true;
            }
            catch (Exception ex)
            {
                _logger.Error(ex);
                throw;
            }
            finally
            {
                db.Dispose();
            }

        }

