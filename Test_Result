                _show_EquiLendloanStyle = Request["hdnEquilendStyleResetState"].ToString();
                _show_WorldLendloanStyle = Request["hdnWorldLendStyleResetState"].ToString();  //Code added for P-1775 starts -- Loan Booking for repo Tickets                                    
