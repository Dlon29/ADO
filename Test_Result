    public sealed class XLNamedRangeCollection : IEnumerable<XLNamedRange>
    {
        private readonly NativeXLNamedRangeCollection _ranges;
        internal XLNamedRangeCollection(NativeXLNamedRangeCollection ranges) { _ranges = ranges; }
        public int Count { get { return _ranges.Count; } }
        public void Add(string name, XLCellRange range)
        {
            if (range == null) throw new ArgumentNullException("range");
            _ranges.Add(name, range.NativeRange);
        }
        public IEnumerator<XLNamedRange> GetEnumerator()
        {
            foreach (NativeXLNamedRange range in _ranges)
                yield return range == null ? null : new XLNamedRange(range);
        }
        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }
    }

    public sealed class XLNamedRange
    {
        private readonly NativeXLNamedRange _range;
        internal XLNamedRange(NativeXLNamedRange range) { _range = range; }
        public string Name { get { return _range.Name; } }
        public bool IsEmpty { get { return _range.IsEmpty; } }
        public XLCellRangeCollection CellRanges { get { return new XLCellRangeCollection(_range.CellRanges); } }
    }

    public sealed class XLCellRangeCollection : IEnumerable<XLCellRange>
    {        
        private readonly NativeXLCellRange[] _ranges;

        // Mobetter API
        private readonly NativeXLCellRangeCollection _collection;
        
        internal XLCellRangeCollection(NativeXLCellRange[] ranges)
        {
            _ranges = ranges ?? new NativeXLCellRange[0];
            _collection = null;
        }

        // Mobetter API
        internal XLCellRangeCollection(
            NativeXLCellRangeCollection collection)
        {
            if (collection == null)
                throw new ArgumentNullException("collection");

            _collection = collection;
            _ranges = null;
        }

        public int Count
        {
            get
            {
                return _collection != null
                    ? _collection.Count
                    : _ranges.Length;
            }
        }

        public XLCellRange this[int index]
        {
            get
            {
                NativeXLCellRange range = _collection != null
                    ? _collection[index]
                    : _ranges[index];

                return range == null ? null : new XLCellRange(range);
            }
        }

        // Mobetter API
        public XLCellRange Add(
            int rowIndex,
            int colIndex,
            int rowCount,
            int colCount)
        {
            if (_collection == null)
            {
                throw new NotSupportedException(
                    "Adding ranges is supported only for worksheet merged cells.");
            }

            NativeXLCellRange range = _collection.Add(
                rowIndex,
                colIndex,
                rowCount,
                colCount);

            return range == null ? null : new XLCellRange(range);
        }

        public IEnumerator<XLCellRange> GetEnumerator()
        {
            for (int i = 0; i < Count; i++)
            {
                yield return this[i];
            }
        }

        IEnumerator IEnumerable.GetEnumerator()
        {
            return GetEnumerator();
        }

        //Mobetter API
        public XLCellRange Add(XLCellRange range)
        {
            if (range == null)
                throw new ArgumentNullException("range");

            if (_collection == null)
            {
                throw new NotSupportedException(
                    "Adding ranges is supported only for worksheet merged cells.");
            }

            NativeXLCellRange addedRange =
                _collection.Add(range.NativeRange);

            return addedRange == null
                ? null
                : new XLCellRange(addedRange);
        }
    }

