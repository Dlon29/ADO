            XmlNode mainNode = doc.SelectSingleNode(strMainNode);

            int intRowCount = 0;
            Double NumberOfDays = 0;
            XmlNode node = doc.CreateNode(XmlNodeType.Element, "FieldName", null);


            if (rbDivArb.Checked)
            {

                if (txtDivArbEndDate.Text.Trim() != string.Empty && txtSetelmentDate.Text.Trim() != string.Empty)
