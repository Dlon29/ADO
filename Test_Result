                            if (chkBox.Checked)
                            {
                                txtgrdPrincipal.ReadOnly = false;
                                txtgrdtxtPrice.ReadOnly = true;
                            }
                            else
                            {
                                txtgrdPrincipal.ReadOnly = true;
                                txtgrdtxtPrice.ReadOnly = false;
