                {
                    dtAddToBasket = this.vwSelectedBaskets as DataTable;
                    dtSelectedBasket = this.vwSelectedBaskets as DataTable;
                    EnsureIsEquilendColumn(dtAddToBasket);

                    int BulkNbr = (dtSelectedBasket != null && dtSelectedBasket.Rows.Count > 0) ? (dtSelectedBasket.Rows[0]["BulkNbr"] != DBNull.Value ? Convert.ToInt16(dtSelectedBasket.Rows[0]["BulkNbr"]) : 0) : 0;
