        public void DisableForm(ControlCollection ctrls)
        {
            try
            {

                MethodName = "DisableForm";
                foreach (Control ctrl in ctrls)
                {
                    if (ctrl is TextBox)
                    {
                        ((TextBox)ctrl).ReadOnly = true;
                        // ((TextBox)ctrl).Font.Bold = true;
                    }
                    if (ctrl is Button)
                        ((Button)ctrl).Enabled = false;
                    else if (ctrl is DropDownList)
                    {
                        //((DropDownList)ctrl).Enabled = false;
                        RepoTicketDisableDropdownOptions(((DropDownList)ctrl).SelectedValue, (DropDownList)ctrl);
                        //((DropDownList)ctrl).Font.Bold = true;
                    }
                    else if (ctrl is CheckBox)
                        ((CheckBox)ctrl).Enabled = false;
                    else if (ctrl is RadioButton)
                        ((RadioButton)ctrl).Enabled = false;
                    else if (ctrl is HtmlInputButton)
                        ((HtmlInputButton)ctrl).Disabled = true;
                    else if (ctrl is HtmlInputText)
                        ((HtmlInputText)ctrl).Disabled = true;
                    else if (ctrl is HtmlSelect)
                        ((HtmlSelect)ctrl).Disabled = true;
                    else if (ctrl is HtmlInputCheckBox)
                        ((HtmlInputCheckBox)ctrl).Disabled = true;
                    else if (ctrl is HtmlInputRadioButton)
                        ((HtmlInputRadioButton)ctrl).Disabled = true;
                    else if (ctrl is CheckBoxList)
                    {
                        foreach (ListItem item in ((CheckBoxList)ctrl).Items)
                        {
                            item.Enabled = false;
                        }
                    }

                    DisableForm(ctrl.Controls);
                }


            }
            catch (Exception Exc)
            {
                Response.ClearContent();
                Response.ContentType = "text/html";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _show_error_row = "";
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
        }


