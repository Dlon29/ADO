        /// <summary>
        /// This method will add JS attributes to controls
        /// </summary>
        private void AddJsAttributes()
        {

            string price = ((this.litSecType.Text == Common.enumSecType.EQ.ToString() || this.litSecType.Text == Common.enumSecType.RI.ToString()) ? this.litPriceUSD.Text : ((this.cboCollCCY.SelectedIndex == 2) ? this.litPriceUSD.Text : this.litPrice.Text));

            if (!Is_FI_RevRepo_Ticket_BOOKING)
            {
                if (chkUseAmount.Checked)
                    txtQuantity.Attributes.Add("onblur", "return fnCalculatePrice(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "', '" + (Is_GNMA_MBS_CMO_FI_Loan) + "','" + Is_FI_Repo_Ticket_BOOKING + "');");
                else
                    txtQuantity.Attributes.Add("onblur", "return fnCalculateAmount(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "' );");

                txtPrice.Attributes.Add("onblur", "return fnCalculateAmount(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "');");

                //Added for M-431
                txtAmmount.Attributes.Add("onblur", "return fnCalculatePrice(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "', '" + (Is_GNMA_MBS_CMO_FI_Loan) + "','" + Is_FI_Repo_Ticket_BOOKING + "'), fnCalculateAmount(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "');");
            }

            //Added for M417
            txtDivArbEndDate.Attributes.Add("onblur", "return fnAssignDADate(" + txtDivArbEndDate.ClientID + "," + txtResetDate.ClientID + ")");

            txtSetelmentDate.Attributes.Add("onblur", "return fnAssignDate(" + txtSetelmentDate.ClientID + "," + txtAsOfDate.ClientID + ")");

            //Added for P-2078 Starts
            if (!Is_FI_RevRepo_Ticket_BOOKING)
            {
                txtHairCut.Attributes.Add("onchange", "return fnCalculateGNMALoanPrice(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "'," + txtHairCut.ClientID + "," + txtFactor.ClientID + "," + txtCashBidPrice.ClientID + " );");
                txtFactor.Attributes.Add("onchange", "return fnCalculateGNMALoanPrice(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "'," + txtHairCut.ClientID + "," + txtFactor.ClientID + "," + txtCashBidPrice.ClientID + " );");
                txtCashBidPrice.Attributes.Add("onchange", "return fnCalculateGNMALoanPrice(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "'," + txtHairCut.ClientID + "," + txtFactor.ClientID + "," + txtCashBidPrice.ClientID + " );");
            }

            cmdBookLoan.Attributes.Add("onclick", "fnValidateAsOfDate('" + _G1BatchDate + "'), ConfirmationonBookLoan('" + hdnIsFISecurityMatured.Value + "')");

            if (Is_FI_Repo_Ticket_BOOKING)
            {
                btnSendForApproval.Attributes.Add("onclick", "ConfirmRatePriceValidationWhileBooking('" + _G1BatchDate + "'), ConfirmationonBookLoan('" + hdnIsFISecurityMatured.Value + "')");
                //txtPrice.TextChanged += new EventHandler(RepoTktCalculateCleanPrice);
                if ((hdnRepoIsAccruedInterestRequired != null) && (hdnRepoIsAccruedInterestRequired.Value == "True"))
                {
                    txtPrice.Attributes.Add("onblur", "return fnCalculateAmount(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "') , fnCalculateCleanPrice('" + txtPrice.ClientID + "')");
                    txtAmmount.Attributes.Add("onblur", "return fnCalculatePrice(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "', '" + (Is_GNMA_MBS_CMO_FI_Loan) + "','" + Is_FI_Repo_Ticket_BOOKING + "'), fnCalculateAmount(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ", '" + litSecType.Text + "'), fnCalculateCleanPrice('" + txtPrice.ClientID + "');");
                }
            }
            //Added for P-2078 Ends

            if (Is_FI_RevRepo_Ticket_BOOKING)
            {
                txtAmmount.Attributes.Add("onblur", "return fnCalculateQuantity(" + txtQuantity.ClientID + "," + txtPrice.ClientID + "," + txtAmmount.ClientID + ");");
                btnSendForApproval.Attributes.Add("onclick", "ConfirmRatePriceValidationWhileBooking('" + _G1BatchDate + "')");
            }
        }

        /// <summary>
        /// This method will get querystring parameter and set variables
        /// </summary>
        /// <returns></returns>
        private bool GetParameter()
        {
            MethodName = "GetParameter()";
            try
            {
                if (_G1BatchDate == string.Empty)
                    _G1BatchDate = GlobalVariable.SystemDate;

                _ActionID = Request.QueryString["ActionID"];
                _batchRunDate = Request.QueryString["AsOfDate"];
                _secCode = (Request.QueryString["SecCode"] == null) ? "" : Request.QueryString["SecCode"].Trim();
                _secType = Request.QueryString["SecType"];
                _ShowDetails = Request.QueryString["ShowDetails"];
                _AsOfDate = (txtAsOfDate.Text == null) ? "" : txtAsOfDate.Text.Trim();

                _LoanBookRequestIdentifier = Request.QueryString["LoanBookRequestIdentifier"];
                _RepoTktID = Request.QueryString["RepoTktID"];


                if (Page.IsPostBack)
                {
                    _BrkCrGrpID = this.cboBrokerCrGroup.SelectedItem.Value;
                }
                else
                    _exclusiveSelection = (Request.QueryString["ExclusiveSelection"] == null) ? "NE" : Request.QueryString["ExclusiveSelection"];

                //Extract broker ID from _BrokerMask
                if (_BrokerMask != "0")
                    _BrkGrpID = _BrokerMask.Substring(_BrokerMask.IndexOf("|") + 2);

                if (_projectedDate == "")
                    _projectedDate = _batchRunDate;

                if (_LoanBookRequestIdentifier == Common.LoanBookingType.REVREPO_TICKET_BOOKING.ToString())
                {
                    Is_FI_RevRepo_Ticket_BOOKING = true;
                }

                // Calculate Price / Amount  On Page Postback
                if (!Is_FI_RevRepo_Ticket_BOOKING)
                {
                    if ((!String.IsNullOrEmpty(txtPrice.Text)) && (String.IsNullOrEmpty(txtAmmount.Text)))
                        CalculateAmountAndPriceOnPostBack();

                    if ((!String.IsNullOrEmpty(txtAmmount.Text)) && (String.IsNullOrEmpty(txtPrice.Text)))
                        CalculateAmountAndPriceOnPostBack();
                }

                if ((Is_GNMA_MBS_CMO_FI_Loan))
                {
                    if ((!String.IsNullOrEmpty(txtHairCut.Text)) && (!String.IsNullOrEmpty(txtFactor.Text)) && (!String.IsNullOrEmpty(txtCashBidPrice.Text)) && (String.IsNullOrEmpty(txtPrice.Text)))
                        CalculateAmountAndPriceOnPostBack();
                }

                if (Is_FICC_FI_REPO_Loan)
                {
                    if ((this.chkFICCTransmit.Checked) && (!(this.chkFICCTrade.Checked)))
                        this.chkFICCTrade.Checked = true;

                    if ((!(this.chkFICCTrade.Checked)) && (this.chkFICCTransmit.Checked))
                        this.chkFICCTransmit.Checked = false;

                }

                return true;
            }

            catch (Exception Exc)
            {
                _show_error_row = "";
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                this.ajxTimer.Enabled = false;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
                return false;
            }
        }

