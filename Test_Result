        private DataTable GetSecLocationForTPUID(string brkNbr, string collCCYCode, string collSchedid, string TPUID)
        {
            DataSet objDS = new DataSet();
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            string[] SqlCondition = new string[5] { "", "", "", "", "" };
            DataTable dt = new DataTable();

            if (clsDB.Open() == false)
            {
                _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                return null;
            }

            clsReader.Connection = clsDB.Connection;
            clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetTPUID_SecLocationCode;


            SqlCondition[0] = _BussDate.ToString();
            SqlCondition[1] = brkNbr;
            SqlCondition[2] = collSchedid;
            SqlCondition[3] = collCCYCode;
            SqlCondition[4] = TPUID;

            // get the data from either current or history table.
            clsReader.GetData(ref objDS, SqlObjects.p_GetTPUID_SecLocationCode, SqlCondition);

            if (objDS != null && objDS.Tables.Count > 0)
                dt = objDS.Tables[0];
            return dt;
