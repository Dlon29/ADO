                            pnlSavedBasketMsg.Visible = true;
                            divSelectedBaskets.Visible = false;
                        }
                    }
                }
                else if (ActionType == REFRESH_BASKET)
                {
                    SqlCondition = new string[13] { "", "", "", "", "", "", "", "", "", "", "", "", "" };

                    clsReader.SqlIdentifier = REFRESH_BASKET;

                    StringBuilder secIDs = GetXML4BulkAdd(hdnSelectedSecID.Value);

                    SqlCondition[0] = _BussDate; //BussDate
                    SqlCondition[1] = cboCriteriaSecutiyType.SelectedValue; //BucketSecType
                    SqlCondition[2] = rdWorldLendstyle.Checked ? txtWLBroker.Text.Trim() : cboEQLBroker.SelectedValue.ToString(); //BrkNbr
                    SqlCondition[3] = rdWorldLendstyle.Checked ? cboWLCollSched.SelectedValue.ToString().Split('|')[0] : cboEQLCollSched.SelectedValue.ToString().Split('|')[0];  //item.Cells[(int)enumgrdSavedBasketMapping.CollSchedID].Text.Replace("&nbsp;", "").Trim(); //TriPartyGrpID
                    SqlCondition[4] = rdWorldLendstyle.Checked ? cboWLCollSched.SelectedValue.ToString().Split('|')[1] : cboEQLCollSched.SelectedValue.ToString().Split('|')[1];  //item.Cells[(int)enumgrdSavedBasketMapping.CollSchedID].Text.Replace("&nbsp;", "").Trim(); //CollSchedID
