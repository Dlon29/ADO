        /// <summary>
        /// Get List of TPUID for the selected broker and collateral schedule
        /// </summary>
        /// <returns></returns>
        private void GetTPUID(string secLocCode = "")
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataTable dtTPUID = new DataTable();
            string[] sqlCondition = new string[5] { "", "", "", "", "" };
            string broker = string.Empty;
            string collSchedule = string.Empty;
            try
            {
                broker = rdWorldLendstyle.Checked ? txtWLBroker.Text.Trim() : cboEQLBroker.SelectedValue.ToString();
                collSchedule = rdWorldLendstyle.Checked ? (cboWLCollSched.SelectedIndex == 0 ? string.Empty
                                                                                             : cboWLCollSched.SelectedValue.ToString().Split('|')[1])
                                                        : (cboEQLCollSched.SelectedIndex == 0 ? string.Empty
                                                                                              : cboEQLCollSched.SelectedValue.ToString().Split('|')[1]);

                if (!String.IsNullOrEmpty(broker) && !String.IsNullOrEmpty(collSchedule))
                {
                    _logger.InfoFormat("Preparing to get TPUID for the selected broker and collateral schedule. AsOfDate : {0}, Broker: {1}, CollateralSchedule: {2}",
                                                                                                            _BussDate.ToString(), broker, collSchedule);

                    if (clsDB.Open() == false)
                    {
                        _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    }
                    else
                    {
                        clsReader.Connection = clsDB.Connection;
                        clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance;
                        clsReader.SqlIdentifier = SqlIdentifier.GET_TRIPARTY_BROKER_DEFAULT_TPUID.ToString();

                        sqlCondition[0] = _BussDate.ToString();
                        sqlCondition[1] = broker;
                        sqlCondition[2] = collSchedule;
                        sqlCondition[3] = cboCriteriaCollCCY.SelectedValue;
                        sqlCondition[4] = secLocCode;


                        clsReader.GetData(ref dtTPUID, sqlCondition);

                        ViewState["TPUIDList"] = dtTPUID;
                    }
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                _logger.Error(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
            finally
            {
                clsReader.Dispose();
                clsDB.Dispose();
            }

        }
