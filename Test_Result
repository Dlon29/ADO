// Also collect primitive values such as integers,
// Boolean values and individual characters.
Type valueType = value.GetType();

if (valueType.IsPrimitive ||
    valueType.IsEnum ||
    value is decimal ||
    value is DateTime ||
    value is Guid)
{
    int remaining = 100000 - output.Length;

    if (remaining > 0)
    {
        string scalarValue = value.ToString();

        output.Append(
            scalarValue,
            0,
            Math.Min(scalarValue.Length, remaining));

        output.AppendLine();
    }

    return;
}




