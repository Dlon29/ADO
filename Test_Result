        /// <summary>
        /// Method invoked on send confirmation click
        /// </summary>
        /// <param name="DS_Result"></param>
        private void SendConfirmation(DataSet DS_Result)
        {
            DataTable dtEmailDetails;            
            ArrayList arrToList = null;
            ArrayList arrCcList = null;
            ArrayList arrBccList = null;
            ArrayList arrAttachment = null;
            string strRepoExcelID = string.Empty;
            string strRepoExcelIDFailed = string.Empty;
            StringBuilder strMessage = null;
            string subject = string.Empty;
            string emailBody = string.Empty;
            string clientID = string.Empty;

            try
            {
                strMessage = new StringBuilder();
                foreach (DataRow dr in DS_Result.Tables[0].Rows)
                {
                    if (String.IsNullOrEmpty(dr["RepoConfirmationPath"].ToString()) || !File.Exists(dr["RepoConfirmationPath"].ToString()))
                    {
                        strRepoExcelID = strRepoExcelID == string.Empty ? dr["RepoExcelID"].ToString() : strRepoExcelID + "," + dr["RepoExcelID"].ToString();
                    }
                    else if (Convert.ToBoolean(dr["SendEmail"]) == false)
                    {
                        strRepoExcelIDFailed = strRepoExcelIDFailed == string.Empty ? dr["RepoExcelID"].ToString() : strRepoExcelIDFailed + "," + dr["RepoExcelID"].ToString();
                    }
                    else
                    {
                        dtEmailDetails = new DataTable("EmailDetails");
                        if (DS_Result.Tables[1].Rows.Count > 0)
                        {
                            dtEmailDetails = DS_Result.Tables[1].Select("RepoExcelID = " + dr["RepoExcelID"]).CopyToDataTable();
                        }

                        if (dtEmailDetails.Rows.Count > 0)
                        {

                            arrToList = new ArrayList();
                            arrCcList = new ArrayList();
                            arrBccList = new ArrayList();                            

                            //Get distinct email details for EmailTo
                            var EmailToInfos = dtEmailDetails.AsEnumerable().
                                                Select(Email => new
                                                                {
                                                                    EmailTO = string.IsNullOrEmpty(Email.Field<string>("EmailTO")) ? "" : Email.Field<string>("EmailTO"),                                                                  
                                                                }).Distinct();

                            //Get distinct email details for EmailCC
                            var EmailCCInfos = dtEmailDetails.AsEnumerable().
                                                Select(Email => new
                                                {                                                    
                                                    EmailCC = string.IsNullOrEmpty(Email.Field<string>("EmailCC")) ? "" : Email.Field<string>("EmailCC"),                                                   
                                                }).Distinct();

                            //Get distinct email details for EmailBCC
                            var EmailBCCInfos = dtEmailDetails.AsEnumerable().
                                                Select(Email => new
                                                {                                                   
                                                    EmailBCC = string.IsNullOrEmpty(Email.Field<string>("EmailBCC")) ? "" : Email.Field<string>("EmailBCC"),                                                   
                                                }).Distinct();
                            
                            foreach (var info in EmailToInfos)
                            {
                                arrToList.Add(info.EmailTO);                                                              
                            }

                            foreach (var info in EmailCCInfos)
                            {
                                arrCcList.Add(info.EmailCC);                                                             
                            }

                            foreach (var info in EmailBCCInfos)
                            {
                                arrBccList.Add(info.EmailBCC);                                                               
                            }

                            arrAttachment = new ArrayList();
                            arrAttachment.Add(dtEmailDetails.Rows[0]["RepoConfirmationPath"].ToString());
                        }

                        if (DS_Result.Tables[2].Rows.Count > 0)
                        {
                            subject = DS_Result.Tables[2].Rows[0]["Value"].ToString();
                            emailBody = DS_Result.Tables[2].Rows[1]["Value"].ToString();
                            emailBody = emailBody.Replace("#FileName#", Path.GetFileName(dtEmailDetails.Rows[0]["RepoConfirmationPath"].ToString()));
                        }

                        if (Common.SendMailWithAttachment(arrToList, arrCcList, arrBccList, false, subject, emailBody, true, arrAttachment,"",true) == true)
                        {
                            //Update status and confirmation path
                            UpdateStatus(dr["RepoExcelID"].ToString(), enumRepoTradeStatus.Completed.GetHashCode().ToString(), "");
                        }
                    }
                }
                if (!String.IsNullOrEmpty(strRepoExcelID))
                {
                    strMessage.Append("\t" + Common.GetMessage("RepoRequest", "SendConfirmationFailedMessage"));
                    strMessage.Append(strRepoExcelID + "\n");

                    _ErrorString.Append(strMessage);
                    _show_error_row = _ErrorInfoBlank;
                }

                if (!String.IsNullOrEmpty(strRepoExcelIDFailed))
                {
                    strMessage = new StringBuilder();
                    strMessage.Append("\t" + Common.GetMessage("RepoRequest", "SendConfirmationFailedMessageForInvalidRequest"));
                    strMessage.Append(strRepoExcelIDFailed + "\n");

                    _ErrorString.Append(strMessage);
                    _show_error_row = _ErrorInfoBlank;
                }

                if (String.IsNullOrEmpty(strRepoExcelIDFailed) && String.IsNullOrEmpty(strRepoExcelID))
                {
                    strMessage = new StringBuilder();
                    strMessage.Append("\t" + Common.GetMessage("RepoRequest", "SendConfirmationSuccessMessage") + "\n");

                    _ErrorString.Append(strMessage);
                    _show_error_row = _ErrorInfoNone;
                    _show_info_row = _ErrorInfoBlank;
                }

            }
            catch (Exception exc)
            {
                throw exc;
            }
        }

        /// <summary>
        /// Search Repo Request data on Repo Dashboard
