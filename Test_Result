public void CopyFormula(
    int sourceRow,
    int sourceColumn,
    int destinationRow,
    int destinationColumn)
{
    _sheet.CopyFormula(
        sourceRow,
        sourceColumn,
        destinationRow,
        destinationColumn);
}



public int IndexOf(string sheetName)
{
    return _book.Sheets.IndexOf(sheetName);
}




public XLColumn Insert(int index)
{
    NativeXLColumn column = _columns.Insert(index);

    return column == null ? null : new XLColumn(column);
}

public XLColumn RemoveAt(int index)
{
    NativeXLColumn column = _columns.RemoveAt(index);

    return column == null ? null : new XLColumn(column);
}



public XLCell Clone()
{
    return new XLCell(_cell.Clone());
}




public object Value
{
    get
    {
        object value = _cell.Value;

        NativeXLPictureShape picture =
            value as NativeXLPictureShape;

        return picture == null
            ? value
            : new XLPictureShape(picture);
    }
    set
    {
        XLPictureShape picture = value as XLPictureShape;

        _cell.Value = picture == null
            ? value
            : (object)picture.NativeShape;
    }
}




public sealed class XLPictureShape
{
    private readonly NativeXLPictureShape _shape;

    internal NativeXLPictureShape NativeShape
    {
        get { return _shape; }
    }

    public XLPictureShape(
        Image image,
        int x,
        int y,
        int width,
        int height)
    {
        if (image == null)
            throw new ArgumentNullException("image");

        _shape = new NativeXLPictureShape(
            image,
            x,
            y,
            width,
            height);
    }

    internal XLPictureShape(NativeXLPictureShape shape)
    {
        if (shape == null)
            throw new ArgumentNullException("shape");

        _shape = shape;
    }
}



public Color BorderColorBottom
