        /// <summary>
        /// Dropdown index change for Collateral Schedule
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void cboCollSchedIndexChanged(Object sender, EventArgs e)
        {
            DataRow[] drOpenTPUID = null;
            DataRow[] drTermTPUID = null;
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataTable dtTPUID = new DataTable();
            string[] sqlCondition = new string[5] { "", "", "", "", "" };
            MethodName = "cboCollSchedIndexChanged()";
            _logger.InfoFormat("Retrieve TPUID for selected collateral schedule : {0}, BrkNbr : {1}", cboCollSched.SelectedValue, txtBroker.Text.Trim());

            try
            {
                if (this.cboLoanCategory.SelectedValue != enumLoanCategory.CR.ToString())
                {
                    if (clsDB.Open() == false)
                    {
                        _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    }
                    else
                    {
                        hdnDefaultOpenTPUID.Value = string.Empty;
                        hdnDefaultTermTPUID.Value = string.Empty;

                        clsReader.Connection = clsDB.Connection;
                        clsReader.StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance;
                        clsReader.SqlIdentifier = SqlIdentifier.GET_TRIPARTY_BROKER_DEFAULT_TPUID.ToString();

                        sqlCondition[0] = _batchRunDate;
                        sqlCondition[1] = String.IsNullOrEmpty(txtBroker.Text.Trim()) ? cboBroker.SelectedValue : txtBroker.Text.Trim();
                        sqlCondition[2] = cboCollSched.SelectedValue == "0" ? cboCollSched.SelectedValue : cboCollSched.SelectedValue.Split(new char[] { '|' })[1].ToString();
                        sqlCondition[3] = cboCollCCY.SelectedValue;
                        sqlCondition[4] = cboSecLocCode.SelectedValue;

                        clsReader.GetData(ref dtTPUID, sqlCondition);

                        if (dtTPUID != null)
                        {
                            if (dtTPUID.Rows.Count > 0)
                            {
                                drpTPUID.Items.Clear();
                                drpTPUID.DataSource = dtTPUID;
                                drpTPUID.DataTextField = "TPUID";
                                drpTPUID.DataValueField = "TPUID";
                                drpTPUID.DataBind();
                                drpTPUID.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectEmpty));

                                drOpenTPUID = dtTPUID.Select("IsDefaultOpen = 1");
                                drTermTPUID = dtTPUID.Select("IsDefaultTerm = 1");

                                if (drOpenTPUID.Length > 0)
                                {
                                    hdnDefaultOpenTPUID.Value = drOpenTPUID[0]["TPUID"].ToString();
                                    if (txtTermDate.Text == string.Empty)
                                    {
                                        drpTPUID.SelectedValue = drOpenTPUID[0]["TPUID"].ToString();
                                    }
                                }

                                if (drTermTPUID.Length > 0)
                                {
                                    hdnDefaultTermTPUID.Value = drTermTPUID[0]["TPUID"].ToString();
                                    if (txtTermDate.Text != string.Empty)
                                    {
                                        drpTPUID.SelectedValue = drTermTPUID[0]["TPUID"].ToString();
                                    }
                                }
                            }
                            else
                            {
                                drpTPUID.Items.Clear();
                                drpTPUID.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectEmpty));
                            }
                        }
                    }
                }
            }
            catch (Exception Exc)
            {
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                this.ajxTimer.Enabled = false;
                _logger.Error(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, Exc));
            }
            finally
            {
                clsReader.Dispose();
                clsDB.Dispose();
            }
        }

