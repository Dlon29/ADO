                        _ErrorString.Append("</a> <br>\n");
                    }
                    else
                    {
                        int bdasNumber = Convert.ToInt32(hdnBDASShellNbr.Value.Substring(1, str.Length));
                        if ((!String.IsNullOrEmpty(txtTripartyRepoShellNbr.Text.Trim()) && txtTripartyRepoShellNbr.Text.Trim().Length != 6) || Convert.ToInt32(str) < bdasNumber)
