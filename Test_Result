string fieldName = formPostParam.Keys[recform];
if (fieldName == "__VIEWSTATE" || fieldName == "__EVENTVALIDATION")
{
    // ===== TEMPORARY PROOF LOGGING (remove after verification) =====
    // postValue is still the raw lowercase base64 here. Run the OLD check on it, log only, never redirect.
    try
    {
        if (arrstrFilterString.Any(postValue.Contains))
        {
            string proofKw = arrstrFilterString.FirstOrDefault(filter => postValue.Contains(filter.ToString().ToLower()));
            int proofIdx = postValue.IndexOf(proofKw);
            int proofStart = Math.Max(0, proofIdx - 100);
            int proofEnd = Math.Min(postValue.Length, proofIdx + proofKw.Length + 100);
            string proofExcerpt = postValue.Substring(proofStart, proofEnd - proofStart);

            if (IsAlphaNumeric(proofKw))
            {
                string proofPrev = proofIdx != 0 ? postValue.Substring(proofIdx - 1, 1) : "";
                string proofNext = postValue.Length > proofIdx + proofKw.Length ? postValue.Substring(proofIdx + proofKw.Length, 1) : "";

                if (!((IsAlphaNumeric(proofPrev) || proofPrev == BLANK_SPACE) && (IsAlphaNumeric(proofNext) || proofNext == BLANK_SPACE)))
                {
                    _logger.ErrorFormat("WOULD-HAVE-REJECTED [Reject4-old] Field={0} Keyword={1} Prev={2} Next={3} ValueLen={4} Excerpt={5}",
                        fieldName, proofKw, proofPrev, proofNext, postValue.Length, proofExcerpt);
                }
            }
            else
            {
                _logger.ErrorFormat("WOULD-HAVE-REJECTED [Reject4-old-nonalnum] Field={0} Keyword={1} ValueLen={2} Excerpt={3}",
                    fieldName, proofKw, postValue.Length, proofExcerpt);
            }
        }
    }
    catch (Exception) { /* proof logging must never affect the request */ }
    // ===== END TEMPORARY PROOF LOGGING =====

    // existing fix, unchanged
    try
    {
        postValue = new LosFormatter().Deserialize(formPostParam[recform]).ToString().ToLower();
    }
    catch (Exception)
    {
        continue;
    }
}
