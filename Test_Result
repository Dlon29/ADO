                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorCleanPrice") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }

                    if (this.txtAccruedInterest.Text == string.Empty)
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtAccruedInterest.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorAccruedInterest") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }
                }

                if (Is_CLO_REPO)
                {
                    if (this.txtCLOAccruedInterestAtBooking.Text == string.Empty)
                    {
                        _ErrorString.Append("<a href = \"javascript: document.forms[0].txtCLOAccruedInterestAtBooking.focus();\">\n");
                        _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorCLOAccruedInterestAtBooking") + "\n");
                        _ErrorString.Append("</a> <br>\n");
                    }
                }

                if (string.IsNullOrEmpty(txtNoteToCustomer.Text))
                {
                    _ErrorString.Append("<a href = \"javascript: document.forms[0].txtNoteToCustomer.focus();\">\n");
                    _ErrorString.Append("\t" + Common.GetMessage("SingleLoanBooking", "ErrorNoteToCustomer") + "\n");
                    _ErrorString.Append("</a> <br>\n");
                }

            }
           
            if (_ErrorString.Length > 0)
            {
                this.ajxTimer.Enabled = false;
                _show_error_row = "";
                _show_createloan = "";
                //log.Debug(_ErrorString.ToString());
                //throw new Exception(_ErrorString.ToString());
            }
            else
            {
                blnValidReq = true;
            }

            return blnValidReq;
        }

        /// <summary>
        /// This method will enable amount comtrol
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        protected void fnEnableAmount(object sender, EventArgs e)
        {
            if (chkUseAmount.Checked)
            {
                txtAmmount.Text = "";
                txtPrice.Text = "";

                txtPrice.ReadOnly = true;
                txtAmmount.ReadOnly = false;

                this.txtPrice.Style.Add(stcBackColor, strNonMandatoryBackColor);
                this.txtAmmount.Style.Add(stcBackColor, strMandatoryBackColor);

                if (Is_FI_Repo_Ticket_BOOKING || Is_FI_RevRepo_Ticket_BOOKING)
                    RepoTktCalculateCleanPrice(null, null);

                this.txtAmmount.Focus();
            }
            else if (Is_GNMA_MBS_CMO_FI_Loan)
            {
                txtAmmount.Text = "";
                txtPrice.Text = "";

                txtPrice.ReadOnly = true;
                txtAmmount.ReadOnly = true;

                if ((!String.IsNullOrEmpty(txtHairCut.Text)) && ((!String.IsNullOrEmpty(txtFactor.Text))) && ((!String.IsNullOrEmpty(txtCashBidPrice.Text))))
                {
                    txtPrice.Text = (Math.Ceiling(((Convert.ToDouble(txtHairCut.Text) / 100) * Convert.ToDouble(txtFactor.Text) * Convert.ToDouble(txtCashBidPrice.Text)) * 8) / 8).ToString("#,##0.00#####");
                }

                if (txtQuantity.Text != "" && txtPrice.Text != "" && (!chkUseAmount.Checked))
                {
                    txtAmmount.Text = Math.Round(((Convert.ToInt64(txtQuantity.Text.Replace(",", "")) * Convert.ToDecimal(txtPrice.Text.Replace(",", ""))) / 100), 2).ToString("#,##0.00");  //.ToString();//

                    txtQuantity.Text = Convert.ToInt64(txtQuantity.Text.Replace(",", "")).ToString("#,##0");
                }
                this.txtPrice.Style.Add(stcBackColor, strMandatoryBackColor);
                this.txtAmmount.Style.Add(stcBackColor, strNonMandatoryBackColor);
            }
            else
            {
                txtAmmount.Text = "";
                txtPrice.Text = "";

                txtPrice.Text = hdnPriceUSD.Value;
                txtAmmount.Text = (this.litSecType.Text == Common.enumSecType.EQ.ToString() || this.litSecType.Text == Common.enumSecType.RI.ToString())
                                     ? Math.Round((Convert.ToInt64(txtQuantity.Text.Replace(",", "")) * Convert.ToDecimal(txtPrice.Text.Replace(",", ""))), 2).ToString("#,##0.00") //.ToString()//
                                     : Math.Round(((Convert.ToInt64(txtQuantity.Text.Replace(",", "")) * Convert.ToDecimal(txtPrice.Text.Replace(",", ""))) / 100), 2).ToString("#,##0.00");  //.ToString();//

                txtQuantity.Text = Convert.ToInt64(txtQuantity.Text.Replace(",", "")).ToString("#,##0");

                txtPrice.ReadOnly = false;
                txtAmmount.ReadOnly = true;

                this.txtPrice.Style.Add(stcBackColor, strMandatoryBackColor);
                this.txtAmmount.Style.Add(stcBackColor, strNonMandatoryBackColor);

                if (Is_FI_Repo_Ticket_BOOKING)
                    RepoTktCalculateCleanPrice(null, null);
            }
        }

