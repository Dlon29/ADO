using System;
using System.Collections;
using System.Text;
using System.Web.UI;

private static void AppendViewStateStrings(
    object value,
    StringBuilder output,
    int depth)
{
    // Diagnostic limits to prevent excessive output or recursion.
    if (value == null || depth > 40 || output.Length >= 100000)
        return;

    // Actual string value.
    string text = value as string;

    if (text != null)
    {
        int remaining = 100000 - output.Length;

        if (remaining > 0)
            output.Append(text, 0, Math.Min(text.Length, remaining));

        output.Append('\n');
        return;
    }

    // Pair: two objects.
    Pair pair = value as Pair;

    if (pair != null)
    {
        AppendViewStateStrings(pair.First, output, depth + 1);
        AppendViewStateStrings(pair.Second, output, depth + 1);
        return;
    }

    // Triplet: three objects.
    Triplet triplet = value as Triplet;

    if (triplet != null)
    {
        AppendViewStateStrings(triplet.First, output, depth + 1);
        AppendViewStateStrings(triplet.Second, output, depth + 1);
        AppendViewStateStrings(triplet.Third, output, depth + 1);
        return;
    }

    // Dictionaries: inspect their keys and values.
    IDictionary dictionary = value as IDictionary;

    if (dictionary != null)
    {
        foreach (DictionaryEntry entry in dictionary)
        {
            if (output.Length >= 100000)
                break;

            AppendViewStateStrings(entry.Key, output, depth + 1);
            AppendViewStateStrings(entry.Value, output, depth + 1);
        }

        return;
    }

    // Arrays, lists and other enumerable containers.
    IEnumerable items = value as IEnumerable;

    if (items != null)
    {
        foreach (object item in items)
        {
            if (output.Length >= 100000)
                break;

            AppendViewStateStrings(item, output, depth + 1);
        }
    }
}



