            XmlTextReader reader = new XmlTextReader(Server.MapPath(@"/LAVA/XmlTemplates/NewLoan.xml"));
            doc.Load(reader);

            //create main node
            XmlNode mainNode = doc.SelectSingleNode("NewLoan");

            RepoTicketAppendNodesToXml(ref doc, 0);

            string selectedEmailID = GetSelectedEmailID();

            int intRowCount = 0;

            switch (Identifier.ToUpper())
