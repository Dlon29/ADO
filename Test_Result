        /// <summary>
        /// Book Loan
        /// </summary>
        private void BookLoan()
        {
            string xml = null;

            if (this.cboCriteriaSecutiyType.SelectedValue == Common.enumSecType.FI.ToString())
                xml = AddNodeToXMLFile("FI_B");
            else
                xml = AddNodeToXMLFile("B");

            //Display a warning message if there are no Trader Emails setup. 
            if (chkSupressEmailConfirm.Checked == false && GetSelectedEmailID() == Common.STRBLANK)
            {
                string jsScript = "alert('" + Common.GetMessage("SingleLoanBooking", "WarningNoEmailSetup") + "');";
                ScriptManager.RegisterStartupScript(this, this.GetType(), "NoEmailSetup", jsScript, true);
            }

            Database clsDB = new Database();
            DataCommand clsCmd = new DataCommand();
            MethodName = "BookLoan()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            try
            {
                DataReader clsReader = new DataReader();
                DataSet ds = new DataSet();

                string[] SqlCondition;
                string Identifier = "";
                bool blnStatus = false;

                if (clsDB.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.SqlIdentifier = SqlIdentifier.BULKLOAN.ToString();


                clsReader.StoredProcedure = (this.cboCriteriaSecutiyType.SelectedValue == Common.enumSecType.FI.ToString()) ? SqlObjectsStaticClass.p_ETINewLoanUpload_FI : SqlObjectsStaticClass.p_ETINewLoanUpload_EQ;

                if (this.cboCriteriaSecutiyType.SelectedValue == Common.enumSecType.FI.ToString())
                    SqlCondition = new string[4] { "", "", "", "" };
                else
                    SqlCondition = new string[1] { "" };

                SqlCondition[0] = xml;


                if (this.cboCriteriaSecutiyType .SelectedValue == Common.enumSecType.FI.ToString())
                {
                    SqlCondition[1] = "0";
                    SqlCondition[2] = Convert.ToInt16(StatusIDForLoanBooking.LOAN_BOOK).ToString();
                    SqlCondition[3] = xml;  //New parameter is introduced for Rev Repo. For all other calls, same XML should be passed as parameter 1.
                }

                if (clsReader.GetData(ref ds, SqlCondition) == false)
                {
                    blnStatus = false;
                    _logger.Debug(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                    throw new Exception(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                }
                else
                {
                    cmdBookLoan.Enabled = false;
                    blnStatus = true;
                    this.EnableTimer();

                    xml = AddNodeToXMLFile("U");

                    SqlCondition = new string[1] { "" };
                    Identifier = "";

                    if (clsDB.Open() == false)
                    {
                        _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                        throw new Exception(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    }

                    clsReader.Connection = clsDB.Connection;
                    clsReader.StoredProcedure = SqlObjectsStaticClass.p_SaveData_BulkLoan;

                    SqlCondition[0] = xml;
                    Identifier = "UPDATE";

                    clsReader.SqlIdentifier = Identifier;

                    if (clsReader.GetData(ref ds, SqlCondition) == false)
                    {
                        blnStatus = false;
                        _logger.Debug(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                        throw new Exception(Common.GetMessage("Common", "ErrorExecSP") + clsCmd.StoredProcedure);
                    }
                    else
                    {
                        blnStatus = true;
                    }

                    if (blnStatus)
                        ConfirmMessage(Common.GetMessage(BASKET_CONFIGURATION, "BasketBookedMsg"));
                }

                for (int iRowCount = 0; iRowCount < ds.Tables[0].Rows.Count; iRowCount++)
                {
                    hdnSourceID.Value = Convert.ToString(ds.Tables[0].Rows[iRowCount]["SourceId"]);
                }

                if (blnStatus)
                {
                    DataGridItem dgi = null;
                    for (int iRowCount = 0; iRowCount < grdBookLoanRecords.Items.Count; iRowCount++)
                    {
                        dgi = this.grdBookLoanRecords.Items[iRowCount];

                        TextBox txtLoanReqStatus = (TextBox)dgi.Cells[(int)enumgrdBookLoanRecordsMapping.LoanReqStatus].FindControl("txtLoanReqStatus");
                        txtLoanReqStatus.Text =
                            txtLoanReqStatus.ToolTip =
                                DateTime.Now.ToString("T") + " - Loan Request Sent - Succeed\n";
                    }
                }
            }
            catch (Exception ex)
            {
                DataGridItem dgi = null;
                for (int iRowCount = 0; iRowCount < grdBookLoanRecords.Items.Count; iRowCount++)
                {
                    dgi = this.grdBookLoanRecords.Items[iRowCount];

                    TextBox txtLoanReqStatus = (TextBox)dgi.Cells[(int)enumgrdBookLoanRecordsMapping.LoanReqStatus].FindControl("txtLoanReqStatus");
                    txtLoanReqStatus.Text =
                        txtLoanReqStatus.ToolTip =
                            DateTime.Now.ToString("T") + " - Loan Request Sent - Failed\n";
                }
                _ErrorString = new StringBuilder("");
                _ErrorString.Append(ex.Message);
                _show_error_row = string.Empty;
                _logger.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodBase.GetCurrentMethod().Name, ex));
            }
            finally
            {
                _logger.InfoFormat(strEndMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);
            }
        }

