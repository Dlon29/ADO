                string fileName = flUpload.PostedFile.FileName;
                string _ExportPath = @"C:\Users\dcolaco\TFS\Reports\" + clsUI.NTUserName + @"\";

                //-----this is temporary folder path remove this, and uncomment the above line.                
                string _TemplatePath = Server.MapPath(@"/LAVA/ParserTemplates/BasketConfigurationTemplate.xml");

                _ExportPath += DateTime.Now.ToString("MM-dd-yyyy") + @"\";

                Lava.ParserTemplates.BasketConfigurationTemplate fp = null;

                try
