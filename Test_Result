            public byte[] BuildC1Workbook()
            {
                try
                {
                    string incFilePath = System.Web.HttpContext.Current.Server.MapPath(@"/" + _appRoot);
                    byte[] reportContent = null;
                    C1XLBook workBookTemplate = new C1XLBook();
                    C1XLBook workBookFinal = new C1XLBook();
                    string templateName = Path.Combine(incFilePath, "ExcelTemplates", "CBJLendingBalanceMonitoring_Template.xls");
                    string uploadPath = "C:\\Adnan's Stuff\\P2422.1\\Templates\\";
                    string fileName = "CBJLendingBalanceMonitoring_POC.xls";
                    int dataColWidth = 0;

                    using (FileStream fs = new FileStream(templateName, FileMode.Open, FileAccess.Read))
                    {
                        workBookTemplate.Load(fs);
                        fs.Close();
                    }
                    workBookFinal.Clear();

                    #region Worksheets

                    XLSheet worksheetTemplate = workBookTemplate.Sheets[0];
                    dataColWidth = worksheetTemplate.Columns[2].Width;

                    var defaultExchRates = this.Accounts.Exists(acct => acct.IsDefaultExchangeRate == true) ?
                            this.Accounts.SingleOrDefault(acct => acct.IsDefaultExchangeRate) :
                            this.Accounts.FirstOrDefault();

                    // Set the sheet name
                    XLSheet worksheetFinal = workBookFinal.Sheets.Add("PEN");

                    worksheetFinal.Columns[0].Width = worksheetTemplate.Columns[0].Width;
                    worksheetFinal.Columns[1].Width = worksheetTemplate.Columns[1].Width;
                    worksheetFinal[2, 0].SetValue(ReportTitle, worksheetTemplate.GetCell(2, 0).Style);
                    worksheetFinal[5, 0].SetValue(AsOfDate.ToString("yyyy-MM-dd"), worksheetTemplate.GetCell(5, 0).Style);
                    worksheetFinal[9, 0].SetValue(defaultExchRates.ExchangeRate_YENUSD, worksheetTemplate.GetCell(9, 0).Style);
                    worksheetFinal[10, 0].SetValue(defaultExchRates.ExchangeRate_YENEUR, worksheetTemplate.GetCell(10, 0).Style);

                    if (defaultExchRates == null)
                    {
                        throw new ApplicationException("Missing lending limit exchange rate.");
                    }

                    for (int r = 5; r <= 18; r++)
                    {
                        int c = 1;
                        XLCell acctHeaderCell = worksheetTemplate.GetCell(r, c);
                        worksheetFinal[r, c].SetValue(acctHeaderCell.Value, acctHeaderCell.Style);
                        foreach (Account acct in Accounts)
                        {
                            c++;
                            worksheetFinal.Columns[c].Width = dataColWidth;
                            XLCell dataCellTemplate = worksheetTemplate.GetCell(r, 2);

                            if (r <= 9)
                            {
                                Type aType = acct.GetType();
                                PropertyInfo pi = aType.GetProperty(dataCellTemplate.Value.ToString());
                                worksheetFinal[r, c].SetValue(pi.GetValue(acct), dataCellTemplate.Style);
                            }

                            if (r == 10) {
                                worksheetFinal[r, c].Formula = GetExcelColumnName(c) + r.ToString() + "/" + "A" + r.ToString();
                                worksheetFinal[r, c].Style = dataCellTemplate.Style;
                            }

                            if(r == 11)
                            {
                                worksheetFinal[r, c].Formula = GetExcelColumnName(c) + (r -1).ToString() + "/" + "A" + r.ToString();
                                worksheetFinal[r, c].Style = dataCellTemplate.Style;

                            }

                            if (r > 11 && r <= 17)
                            {
                                if (c == 2)
                                {
                                    worksheetFinal[r, c].Formula = dataCellTemplate.Formula;
                                    worksheetFinal[r, c].Style = dataCellTemplate.Style;
                                }
                                else
                                {
                                    worksheetFinal.CopyFormula(r, 2, r, c);
                                    worksheetFinal[r, c].Style = dataCellTemplate.Style;
                                }
                            }

                            if (r == 18)
                            {
                                dataCellTemplate = worksheetTemplate.GetCell(r, 0);
                                worksheetFinal[r, 0].SetValue(dataCellTemplate.Value, dataCellTemplate.Style);
                            }
                        }
                    }

                    #region Worksheet Body

                    var loanBalances = this.Loans
                                           .GroupBy(ln => new { ln.LendingLimitGrpID, ln.BrkCrGrpID })
                                           .ToList()
                                           .Select(lnBalance => new {
                                               LendingLimitGrpID = lnBalance.Key.LendingLimitGrpID,
                                               BrkCrGrpID = lnBalance.Key.BrkCrGrpID,
                                               PrincipalDomestic = lnBalance.Sum(b => b.PrincipalDomestic),
                                               PrincipalGlobalUSD = lnBalance.Sum(b => b.PrincipalGlobalUSD),
                                               PrincipalGlobalEUR = lnBalance.Sum(b => b.PrincipalGlobalEUR)
                                           })
                                           .ToList();

                    int dataRow = 19;
                    foreach (var creditGrp in CreditGroups)
                    {
                        for (int templateRow = 19; templateRow <= 25; templateRow++)
                        {
                            
                            PropertyInfo pi;
                            XLCell dataCellTemplate = worksheetTemplate.GetCell(templateRow, 0);

                            if (templateRow != 23)
                            {
                                Type bcType = creditGrp.GetType();
                                string cellValue = "";
                                if (!String.IsNullOrEmpty(Convert.ToString(dataCellTemplate.Value)))
                                {
                                    pi = bcType.GetProperty(dataCellTemplate.Value.ToString());
                                    cellValue = pi.GetValue(creditGrp).ToString();
                                }
                                worksheetFinal[dataRow, 0].SetValue(cellValue, dataCellTemplate.Style);
                            }
                            else
                            {
                                worksheetFinal[dataRow, 0].Formula = dataCellTemplate.Formula;
                            }

                            dataCellTemplate = worksheetTemplate.GetCell(templateRow, 1);
                            worksheetFinal[dataRow, 1].SetValue(dataCellTemplate.Value, dataCellTemplate.Style);

                            int c = 2;
                            foreach (Account acct in Accounts)
                            {
                                dataCellTemplate = worksheetTemplate.GetCell(templateRow, 2);

                                if (templateRow <= 22 && templateRow != 21)
                                {
                                    var loanBalance = loanBalances.SingleOrDefault(ln => (ln.LendingLimitGrpID == acct.LendingLimitGrpID) && (ln.BrkCrGrpID == creditGrp.BrkCrGrpID));
                                    string cellValue = "0";
                                    if (loanBalance != null)
                                    {
                                        Type loanBalanceType = loanBalance.GetType();
                                        pi = loanBalanceType.GetProperty(dataCellTemplate.Value.ToString());
                                        cellValue = pi.GetValue(loanBalance).ToString();
                                    }
                                    worksheetFinal[dataRow, c].SetValue(cellValue, dataCellTemplate.Style);
                                }

                                if(templateRow == 21)
                                {
                                    if (c == 2)
                                    {
                                        worksheetFinal[dataRow, c].Formula = dataCellTemplate.Formula;
                                    }
                                    else
                                    {
                                        worksheetFinal.CopyFormula(dataRow, 2, dataRow, c);
                                    }
                                }

                                string colName = GetExcelColumnName(c);
                                if (templateRow == 23)
                                {
                                    worksheetFinal[dataRow, c].Formula = "SUM(" + colName + dataRow.ToString() + " * $A$11, " + colName + (dataRow - 1).ToString() + " * $A$10)/" + colName + "$10 *100";
                                }

                                var percentLimit = LendingLimitBrokerPct.SingleOrDefault(pct => (pct.LendingLimitGrpID == acct.LendingLimitGrpID) && (pct.BrkCrGrpID == creditGrp.BrkCrGrpID));
                                string pctLmtValue = (percentLimit != null) ? percentLimit.PercentLimit.ToString() : "0";
                                if (templateRow == 24)
                                {
                                    worksheetFinal[dataRow, c].Formula = "CONCATENATE(\"(\",TEXT(" + pctLmtValue + ",\"###%\"),\") \", TEXT((" + colName + "$11*" + pctLmtValue + ")-" + colName + (dataRow - 2).ToString() + "-(" + colName + (dataRow - 1).ToString() + "*$A$11/$A$10),\"_(#,##0.00_)\"))";
                                }

                                if (templateRow == 25)
                                {
                                    worksheetFinal[dataRow, c].Formula = "CONCATENATE(\"(\",TEXT(" + pctLmtValue + ",\"###%\"),\") \", TEXT((" + colName + "$12*" + pctLmtValue + ")-" + colName + (dataRow - 2).ToString() + "-(" + colName + (dataRow - 3).ToString() + "*$A$10/$A$11),\"_(#,##0.00_)\"))";
                                }

                                worksheetFinal[dataRow, c].Style = dataCellTemplate.Style;

                                c++;
                            }

                            dataRow++;
                        }
                    }
                    #endregion

                    workBookFinal.Sheets.RemoveAt(0);
                    DirectoryInfo dirInf = Directory.CreateDirectory(uploadPath);
                    workBookFinal.Save(dirInf.FullName + fileName);
                    using (FileStream fs = new FileStream(dirInf.FullName + fileName, FileMode.Open, FileAccess.Read))
                    {
                        reportContent = new byte[fs.Length];
                        fs.Read(reportContent, 0, reportContent.Length);
                        fs.Close();
                    }

                    return reportContent;
                    #endregion

                }
                catch (Exception ex)
                {
                    _logger.Error(ex);
                    throw;
                }
            }

            private void BuildWorksheetBody(StringBuilder workbook, WorksheetInfo worksheetInfo)
            {
                const int ACCOUNT_COL_IDX_START = 3;
                const int HEADER_ROW_COUNT = 19;
                const int ROW_COUNT_PER_CR_GRP = 7;
                const int LENDING_LIMIT_ROW_START = 5; 
                
                try
                {
                    this.BuildAccountHeaders(workbook, worksheetInfo);
                    var conditionalFormattingBldr = new StringBuilder();
                    var lendingLimitChkExceedCondGTUSDBldr = new StringBuilder();
                    var lendingLimitChkExceedCondGTEURBldr = new StringBuilder();
                    var conditionalFormattingGTUSDBldr = new StringBuilder();
                    var conditionalFormattingGTEURBldr = new StringBuilder();


                    //==================================================================================================================================================================
                    //Render balances by credit group and account 
                    //==================================================================================================================================================================
                    var templateDict = worksheetInfo.TemplateDictionary;
                    var loanBalanceBldr = new StringBuilder();
                    


                    var loanBalances = this.Loans
                                           .GroupBy( ln=> new  { ln.LendingLimitGrpID, ln.BrkCrGrpID} )
                                           .ToList()
                                           .Select(lnBalance => new { 
                                                                        LendingLimitGrpID = lnBalance.Key.LendingLimitGrpID, 
                                                                        BrkCrGrpID = lnBalance.Key.BrkCrGrpID, 
                                                                        PrincipalDomestic = lnBalance.Sum(b=>b.PrincipalDomestic),
                                                                        PrincipalGlobalUSD = lnBalance.Sum(b=>b.PrincipalGlobalUSD),
                                                                        PrincipalGlobalEUR = lnBalance.Sum(b=>b.PrincipalGlobalEUR)
                                           })
                                           .ToList();

                    var limitRowIdx = HEADER_ROW_COUNT + LENDING_LIMIT_ROW_START;

                    foreach (var creditGrp in CreditGroups)
                    {
                        var domesticUSDRowBldr = new StringBuilder();
                        var globalUSDRowBldr = new StringBuilder();
                        var totalUSDRowBldr = new StringBuilder();
                        var globalEURRowBldr = new StringBuilder();
                        var lendingLimitChkExceedCondBldr = new StringBuilder();
                        var lendingLimitPctRowBldr = new StringBuilder();
                        var availableBalanceUSDRowBldr = new StringBuilder();
                        var availableBalanceEURRowBldr = new StringBuilder();
                        var acctColIdx = ACCOUNT_COL_IDX_START;

                        foreach (var acct in this.Accounts)
                        {
                            var percentLimit = LendingLimitBrokerPct.SingleOrDefault(pct => (pct.LendingLimitGrpID == acct.LendingLimitGrpID) && (pct.BrkCrGrpID == creditGrp.BrkCrGrpID));
                            totalUSDRowBldr.Append(templateDict["CELL.BALANCE.TOTALUSD"]);
                            lendingLimitPctRowBldr.Append(templateDict["CELL.LENDINGLIMIT.PCT"]);
                            availableBalanceUSDRowBldr.Append(templateDict["CELL.AVAILABLE.BALANCE.USD"].Replace("<!--PercentLimit-->", (percentLimit != null) ? Convert.ToString(percentLimit.PercentLimit) : "0"));
                            availableBalanceEURRowBldr.Append(templateDict["CELL.AVAILABLE.BALANCE.EUR"].Replace("<!--PercentLimit-->", (percentLimit != null) ? Convert.ToString(percentLimit.PercentLimit) : "0"));


                            var loanBalance = loanBalances.SingleOrDefault(ln => (ln.LendingLimitGrpID == acct.LendingLimitGrpID)  && (ln.BrkCrGrpID == creditGrp.BrkCrGrpID));
                            domesticUSDRowBldr.Append(templateDict["CELL.DOMESTIC.BALANCE"].Replace("<!--TotalPrincipal-->", (loanBalance != null) ? Convert.ToString(loanBalance.PrincipalDomestic) : "0"));
                            globalUSDRowBldr.Append(templateDict["CELL.BALANCE"].Replace("<!--TotalPrincipal-->", (loanBalance != null) ? Convert.ToString(loanBalance.PrincipalGlobalUSD) : "0"));
                            globalEURRowBldr.Append(templateDict["CELL.BALANCE"].Replace("<!--TotalPrincipal-->", (loanBalance != null) ? Convert.ToString(loanBalance.PrincipalGlobalEUR) : "0"));


                            if (lendingLimitChkExceedCondBldr.Length > 0)
                            {
                                lendingLimitChkExceedCondBldr.Append(",");
                            }
                            
                            lendingLimitChkExceedCondBldr.Append(
                                    templateDict["CELL.LENDINGLIMIT.CHK.EXCEED.CONDITION"]
                                                    .Replace("<!--AcctColIdx-->", Convert.ToString(acctColIdx))
                                                    .Replace("<!--PercentLimit-->",(percentLimit != null) ? Convert.ToString(percentLimit.PercentLimit) : "0"));

                            conditionalFormattingBldr.Append(templateDict["CELL.LENDINGLIMIT.CONDITIONAL.FORMAT"]
                                                                .Replace("<!--RuleRowIdx-->", Convert.ToString(limitRowIdx))
                                                                .Replace("<!--RuleColIdx-->", Convert.ToString(acctColIdx))
                                                                .Replace("<!--PercentLimit-->", (percentLimit != null) ? Convert.ToString(percentLimit.PercentLimit) : "0"));

                            acctColIdx++;

                        }


                        var creditGroupRowBldr = templateDict[ReportTemplate.DEFAULT_WORKSHEET_ROW]
                                                    .Replace("<!--BrkCrGrpName-->", creditGrp.BrkCrGrpName)
                                                    .Replace("<!--CreditRating-->", creditGrp.CreditRating)
                                                    .Replace("<!--DomesticUSD-->", domesticUSDRowBldr.ToString())
                                                    .Replace("<!--GlobalUSD-->", globalUSDRowBldr.ToString())
                                                    .Replace("<!--TotalUSD-->", totalUSDRowBldr.ToString())
                                                    .Replace("<!--GlobalEUR-->", globalEURRowBldr.ToString())
                                                    .Replace("<!--LendingLimitPercentage-->", lendingLimitPctRowBldr.ToString())
                                                    .Replace("<!--AvailableBalanceUSD-->", availableBalanceUSDRowBldr.ToString())
                                                    .Replace("<!--AvailableBalanceEUR-->", availableBalanceEURRowBldr.ToString())
                                                    .Replace("<!--LendingLimitChkConditions-->", lendingLimitChkExceedCondBldr.ToString());

                        loanBalanceBldr.Append(creditGroupRowBldr.ToString());
                        limitRowIdx += ROW_COUNT_PER_CR_GRP;
                    }

                    //Subtotals
                    var totalLoanBalanceDomesticUSD = new StringBuilder();
                    var totalLoanBalanceGlobalUSD = new StringBuilder();
                    var totalLoanBalanceGlobalEUR = new StringBuilder();
                    var outOfBalanceUSD = new StringBuilder();
                    var outOfBalanceEUR = new StringBuilder();
                    var colIdx = ACCOUNT_COL_IDX_START;

                    foreach (var acct in this.Accounts)
                    {
                        totalLoanBalanceDomesticUSD.Append(templateDict["CELL.TOTAL.BALANCE.DOMESTIC.USD"]);
                        totalLoanBalanceGlobalUSD.Append(templateDict["CELL.TOTAL.BALANCE.GLOBAL.USD"]);
                        totalLoanBalanceGlobalEUR.Append(templateDict["CELL.TOTAL.BALANCE.GLOBAL.EUR"]);

                        var totalPrincipalUSD = Loans.Where(ln => (ln.AcctNbr == acct.AcctNbr) && (acct.AcctType.Contains(ln.BucketSecType))).Sum(ln => ln.PrincipalGlobalUSD + ln.PrincipalDomestic);
                        var totalPrincipalEUR = Loans.Where(ln => (ln.AcctNbr == acct.AcctNbr) && (acct.AcctType.Contains(ln.BucketSecType))).Sum(ln => ln.PrincipalGlobalEUR);
                        outOfBalanceUSD.Append(templateDict["CELL.OUT.OF.BALANCE.USD"].Replace("<!--TotalPrincipal-->", Convert.ToString(totalPrincipalUSD)));
                        outOfBalanceEUR.Append(templateDict["CELL.OUT.OF.BALANCE.EUR"].Replace("<!--TotalPrincipal-->", Convert.ToString(totalPrincipalEUR)));

                        if (lendingLimitChkExceedCondGTUSDBldr.Length > 0)
                        {
                            lendingLimitChkExceedCondGTUSDBldr.Append(",");
                        }

                        lendingLimitChkExceedCondGTUSDBldr.Append(
                                templateDict["CELL.LENDINGLIMIT.CHK.EXCEED.CONDITION.GRANDTOTAL.USD"]
                                                .Replace("<!--AcctColIdx-->", Convert.ToString(colIdx)));

                        if (lendingLimitChkExceedCondGTEURBldr.Length > 0)
                        {
                            lendingLimitChkExceedCondGTEURBldr.Append(",");
                        }

                        lendingLimitChkExceedCondGTEURBldr.Append(
                                templateDict["CELL.LENDINGLIMIT.CHK.EXCEED.CONDITION.GRANDTOTAL.EUR"]
                                                .Replace("<!--AcctColIdx-->", Convert.ToString(colIdx)));

                        conditionalFormattingGTUSDBldr.Append(templateDict["CELL.LENDINGLIMIT.CONDITIONAL.FORMAT.GT.USD"]
                                                                .Replace("<!--RuleColIdx-->", Convert.ToString(colIdx)));

                        conditionalFormattingGTEURBldr.Append(templateDict["CELL.LENDINGLIMIT.CONDITIONAL.FORMAT.GT.EUR"]
                                                                .Replace("<!--RuleColIdx-->", Convert.ToString(colIdx)));

                        colIdx++;
                    }


                    var investmentMgr = InvestmentManagers.FirstOrDefault();
                    var investmentMgrName = string.Empty;
                    if (this.InvestmentMgrID != 0)
                    {
                        investmentMgrName = (investmentMgr != null) 
                                ? string.Format("{0} : {1}", "Investment Manager", investmentMgr.InvestmentMgrName) 
                                : string.Empty;
                    }

                    workbook.Replace("<!--AsOfDate-->", this.AsOfDate.ToString("yyyy-MM-dd"));
                    workbook.Replace("<!--ReportTitle-->", this.ReportTitle);
                    workbook.Replace("<!--InvestmentMgrName-->",  investmentMgrName);


                    

                    workbook.Replace("<!--LoanBalances-->", loanBalanceBldr.ToString());
                    workbook.Replace("<!--TotalLoanBalanceDomesticUSD-->", totalLoanBalanceDomesticUSD.ToString());
                    workbook.Replace("<!--LendingLimitChkConditionsGrandTotalUSD-->", lendingLimitChkExceedCondGTUSDBldr.ToString());
                    workbook.Replace("<!--TotalLoanBalanceGlobalUSD-->", totalLoanBalanceGlobalUSD.ToString());
                    workbook.Replace("<!--LendingLimitChkConditionsGrandTotalEUR-->", lendingLimitChkExceedCondGTEURBldr.ToString());
                    workbook.Replace("<!--TotalLoanBalanceGlobalEUR-->", totalLoanBalanceGlobalEUR.ToString());
                    workbook.Replace("<!--OutOfBalanceUSD-->", outOfBalanceUSD.ToString());
                    workbook.Replace("<!--OutOfBalanceEUR-->", outOfBalanceEUR.ToString());

                    int exceedLimitRowOffset = HEADER_ROW_COUNT + (ROW_COUNT_PER_CR_GRP * CreditGroups.Count);
                    workbook.Replace("<!--ExceedLimitRowOffset-->", Convert.ToString(exceedLimitRowOffset));
                                                limitRowIdx += ROW_COUNT_PER_CR_GRP;

                    workbook.Replace("<!--ConditionalFormattingGrandTotalRowUSD-->", conditionalFormattingGTUSDBldr.ToString());
                    workbook.Replace("<!--ConditionalFormattingGrandTotalRowEUR-->", conditionalFormattingGTEURBldr.ToString());
                    workbook.Replace("<!--ExceedLimitRowOffset1-->", Convert.ToString(exceedLimitRowOffset + 2));
                    workbook.Replace("<!--ExceedLimitRowOffset2-->", Convert.ToString(exceedLimitRowOffset + 3));
                    workbook.Replace("<!--ExceedLimitRowOffset3-->", Convert.ToString(exceedLimitRowOffset + 4));
                    workbook.Replace("<!--ConditionalFormatting-->", conditionalFormattingBldr.ToString());
                    

                }
                catch (Exception ex)
                {
                    _logger.Error(ex);
                    throw;
                }
            }

            private StringBuilder BuildAccountHeaders(StringBuilder workbook, WorksheetInfo worksheetInfo)
            {
                try
                {
                    var defaultExchRates = this.Accounts.Exists(acct => acct.IsDefaultExchangeRate == true) ?
                                                this.Accounts.SingleOrDefault(acct => acct.IsDefaultExchangeRate) :
                                                this.Accounts.FirstOrDefault();

                    if (defaultExchRates == null)
                    {
                        throw new ApplicationException("Missing lending limit exchange rate.");
                    }

                    var templateDict = worksheetInfo.TemplateDictionary;

                    var acctNames = this.Accounts.Select(acct => templateDict["CELL.ACCTNAME"].Replace("<!--AcctName-->", acct.AcctName))
                                             .ToList()
                                             .Aggregate((seed, accName) => string.Concat(seed, accName));

                    var acctNbrs = this.Accounts.Select(acct => templateDict["CELL.ACCTNBR"].Replace("<!--AcctNbr-->", acct.AcctNbr))
                                            .ToList()
