        /// <summary>
        /// Set module name
        /// </summary>
        /// <param name="p"></param>
        private void SetModule(string p)
        {
            switch (p)
            {
                case "RRD":
                    _ModuleName = "RepoRequestDashBoard";
                    break;
                case "RCD":
                    _ModuleName = "RepoRequestConfirmation";
                    break;
                default:
                    _ModuleName = "RepoRequestDashBoard";
                    break;
            }
        }
