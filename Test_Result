        /// <summary>
        /// Get loan data for selected txnrefnbr
        /// </summary>
        /// <param name="SelectedId"></param>
        /// <param name="SecType"></param>
        /// <param name="BrkNbr"></param>
        private void FillCancelledLoansData(string SelectedId, string SecType, string BrkNbr)
        {
            string BasketName = BrkNbr + DateTime.Now.ToString("yyyyMMddHHmmss");
            string[] strCancelledLoanIds = SelectedId.Split(',');
            StringBuilder strLoanIdsXML = new StringBuilder();
            strLoanIdsXML.Append("<SelectedLoanId>");
            foreach (string LoanId in strCancelledLoanIds)
            {
                strLoanIdsXML.Append("<TxnRefNbr>" + LoanId.Trim() + "</TxnRefNbr>");
            }
            strLoanIdsXML.Append("</SelectedLoanId>");

            DataTable dtUploadedBasket = GetCancelledLoanDtlsForReBooking(Convert.ToString(strLoanIdsXML));

            hdnSelectedTab.Value = NEW_BASKET;

            ResetControl(NEW_BASKET);
            //fill country listbox
            GetCountryList();
            if (!String.IsNullOrEmpty(SecType))
            {
                cboCriteriaSecutiyType.SelectedValue = SecType;
            }
            UploadBasketForCancelledLoan(dtUploadedBasket, SecType, BrkNbr);
            EnableFILoanBookingAttributes();   //Added For P-1486
            if (BasketName != string.Empty && BasketName != null)
            {
                txtBasketComment.Text = BasketName;
            }

            if (BrkNbr != string.Empty && BrkNbr != null)
            {
                txtWLBroker.Text = BrkNbr;
                txtBroker_TextChanged(txtWLBroker, null);
            }
        }

