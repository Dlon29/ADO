        private bool PopulateCollateralSchedule()
        {
            Database db = new Database();
            try
            {
                if (db.Open() == false)
                {
                    _logger.Debug(Common.GetMessage("Common", "ErrorCantOpenDB"));
                    return false;
                }

                DataReader dataReader = new DataReader()
                {
                    Connection = db.Connection,
                    StoredProcedure = SqlObjectsStaticClass.p_GetData_Maintenance,
                    SqlIdentifier = SqlIdentifier.GET_BRK_COLL_SCHED_LOAN_BOOK.ToString()
                };
                
                string[] sqlParam = new string[8] { "", "", "", "", "", "", "", "" };
                sqlParam[0] = _BussDate;
                sqlParam[1] = (txtWLBroker.Text == string.Empty) ? cboEQLBroker.SelectedValue : txtWLBroker.Text.Trim();
                sqlParam[2] = string.Empty;
                sqlParam[3] = cboCriteriaCollCCY.SelectedValue;


                SqlDataReader sqlRdr = null;
                if (!dataReader.GetData(ref sqlRdr, sqlParam) )
                {
                    return false;
                }


                if (rdWorldLendstyle.Checked && txtWLBroker.Text != string.Empty)
                {
                    cboWLCollSched.DataSource = sqlRdr;
                    cboWLCollSched.DataTextField = "CollSchedName";
                    cboWLCollSched.DataValueField = "CollSchedId";
                    cboWLCollSched.DataBind();
                    cboWLCollSched.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));
                }
                else if (rdEquiLendStyle.Checked)
                {
                    cboEQLCollSched.DataSource = sqlRdr;
                    cboEQLCollSched.DataTextField = "CollSchedName";
                    cboEQLCollSched.DataValueField = "CollSchedId";
                    cboEQLCollSched.DataBind();
                    cboEQLCollSched.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));
                }
                if (sqlRdr != null && !sqlRdr.IsClosed)
                {
                    sqlRdr.Close();
                }
                if (!dataReader.GetData(ref sqlRdr, sqlParam))
                {
                    return false;
                }

                cboBookLoanCollSched.DataSource = sqlRdr;
                cboBookLoanCollSched.DataTextField = "CollSchedName";
                cboBookLoanCollSched.DataValueField = "CollSchedId";
                cboBookLoanCollSched.DataBind();
                cboBookLoanCollSched.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));

                if (sqlRdr != null && !sqlRdr.IsClosed)
                {
                    sqlRdr.Close();
                }
                return true;
            }
            catch (Exception ex)
            {
                _logger.Error(ex);
                throw;
            }
            finally
            {
                db.Dispose();
            }
        }

