            get { return (XLAlignHorzEnum)Enum.Parse(typeof(XLAlignHorzEnum), _style.AlignHorz.ToString()); }
            set { _style.AlignHorz = (NativeXLAlignHorzEnum)Enum.Parse(typeof(NativeXLAlignHorzEnum), value.ToString()); }
        }
        public XLAlignVertEnum AlignVert
        {
            get { return (XLAlignVertEnum)Enum.Parse(typeof(XLAlignVertEnum), _style.AlignVert.ToString()); }
            set { _style.AlignVert = (NativeXLAlignVertEnum)Enum.Parse(typeof(NativeXLAlignVertEnum), value.ToString()); }
        }
        public XLLineStyleEnum BorderBottom
        {
            get { return (XLLineStyleEnum)Enum.Parse(typeof(XLLineStyleEnum), _style.BorderBottom.ToString()); }
            set { _style.BorderBottom = ToNativeLine(value); }
        }
        public XLLineStyleEnum BorderTop
        {
            get { return (XLLineStyleEnum)Enum.Parse(typeof(XLLineStyleEnum), _style.BorderTop.ToString()); }
            set { _style.BorderTop = ToNativeLine(value); }
        }
        public XLLineStyleEnum BorderLeft
        {
            get { return (XLLineStyleEnum)Enum.Parse(typeof(XLLineStyleEnum), _style.BorderLeft.ToString()); }
            set { _style.BorderLeft = ToNativeLine(value); }
        }
        public XLLineStyleEnum BorderRight
        {
            get { return (XLLineStyleEnum)Enum.Parse(typeof(XLLineStyleEnum), _style.BorderRight.ToString()); }
            set { _style.BorderRight = ToNativeLine(value); }
        }

        private static NativeXLLineStyleEnum ToNativeLine(XLLineStyleEnum value)
        {
            return (NativeXLLineStyleEnum)Enum.Parse(typeof(NativeXLLineStyleEnum), value.ToString());
        }
