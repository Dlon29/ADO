                    cboEQLCollSched.DataValueField = "CollSchedId";
                    cboEQLCollSched.DataBind();
                    cboEQLCollSched.Items.Insert(0, new ListItem(Common.cboSelectText, Common.cboSelectVal));
                }
                if (sqlRdr != null && !sqlRdr.IsClosed)
                {
                    sqlRdr.Close();
