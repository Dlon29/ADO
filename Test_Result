            MethodName = "AddNodeToXMLFile()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            string selectedEmailID;

            try
            {
                if (ActionType == "D" || ActionType == "S" || ActionType == "U") // for delete or save or update basket
                {
                    path = @"/LAVA/XmlTemplates/BasketConfiguration.xml";
                    strMainNode = BASKET_CONFIGURATION;
                }
                else if (ActionType == "A" || ActionType == "B" || ActionType == "FI_B") //for allocation and loan booking
                {
                    path = @"/LAVA/XmlTemplates/NewLoan.xml";
                    strMainNode = "NewLoan";
                }

                selectedEmailID = GetSelectedEmailID();

                //load from file
                XmlTextReader reader = new XmlTextReader(Server.MapPath(path));
                doc.Load(reader);

                //create main node
                XmlNode mainNode = doc.SelectSingleNode(strMainNode);

                DataGridItem dgi = null;
                int iXmlRowCount = 1;
                int intRowCount = 0;

                if (ActionType == "D")  //Delete
                {
