        /// <summary>
        /// Get Records
        /// </summary>
        /// <param name="ActionType"></param>
        /// <returns></returns>
        private bool GetRecords(string ActionType)
        {
            DataSet objDS = new DataSet();
            PagedDataSource objPagedDS = new PagedDataSource();


            STBUSA.Utility.IGlobalVariable gv = new GlobalVariable();
            STBUSA.Data.DataBase clsDB = null;
            STBUSA.Data.DataCommand clsCmd = null;
            MethodName = "GetRecords()";
            _logger.InfoFormat(strStartMsg + strArrow + _ModuleName + strArrow + MethodBase.GetCurrentMethod().Name);

            try
            {
                clsDB = new STBUSA.Data.DataBase(ref gv);
                clsCmd = new STBUSA.Data.DataCommand(ref clsDB);

                if (clsDB.Open() == false)
                    return false;

                DataReader clsReader = new DataReader();
                clsReader.Connection = clsDB.Connection;

                string[] SqlCondition = new string[18] { "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "" };

                if (ActionType == SEARCH_MODIFY)
                {
                    clsReader.SqlIdentifier = SEARCH_MODIFY;

                    SqlCondition[0] = _BussDate; //BussDate
                    SqlCondition[1] = string.Empty; //BulkNbr
                    SqlCondition[2] = string.Empty; //VersionNbr
                    SqlCondition[3] = string.Empty; //SecType
                    SqlCondition[4] = cboModifyBrokerCrGroup.SelectedValue; //BrkCrGrpID
                    SqlCondition[5] = cboModifyBrokerGroup.SelectedValue; //BrkGrpID
                    SqlCondition[6] = cboModifyBroker.SelectedValue; //BrkNbr
                    SqlCondition[7] = cboFinder.SelectedValue; //FinderNbr
                    SqlCondition[8] = cboUser.SelectedValue == "0" ? "" : cboUser.SelectedItem.Text.Trim(); //UserCode
                    SqlCondition[9] = txtComment.Text.Trim(); //Comments
                    SqlCondition[10] = string.Empty; //CollSchedID
                    SqlCondition[11] = string.Empty; //FinderNbrAvailOnly
                    SqlCondition[12] = string.Empty; //LowDivRate
                    SqlCondition[13] = string.Empty; //CountrySelected
                    SqlCondition[14] = string.Empty; //basketWeighting
                    SqlCondition[15] = string.Empty; //SecCode
                    SqlCondition[16] = string.Empty; //CollCCYCode
                    SqlCondition[17] = string.Empty; //SecIdList

                    if (clsReader.GetData(ref objDS, SqlObjects.p_GetData_BulkLoan, SqlCondition) == false)
                    {
                        return false;
                    }


                    objPagedDS.DataSource = objDS.Tables[0].DefaultView;
                    objPagedDS.AllowPaging = true;

                    objPagedDS.PageSize = objPagedDS.DataSourceCount;
                    if (_PageNo > objPagedDS.PageCount)
                        _PageNo = objPagedDS.PageCount;

                    if (_PageNo <= 0)
                        _PageNo = 1;

                    objPagedDS.CurrentPageIndex = _PageNo - 1;
                    _TotPage = objPagedDS.PageCount;

                    if (objPagedDS.Count == 0)
                    {
                        _PageNo = 0;
                        _TotPage = 0;
                    }

                    PageNofM = _PageNo.ToString() + " of " + _TotPage.ToString();


                    grdSavedBasket.DataSource = objPagedDS;
                    grdSavedBasket.DataBind();

                    cmdOpenBasket.Enabled =
                               cmdCopyBasket.Enabled =
