        /// </summary>
        /// <returns></returns>
        private bool GetExcelExtract()
        {
            Database clsDB = new Database();
            DataReader clsReader = new DataReader();
            DataSet objDS = new DataSet();
            string[] SqlCondition = new string[21] { "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "" };
            string fileName = string.Empty;
            MethodName = "GetExcelExtract()";
            StringBuilder TradeStatusList = new StringBuilder();

            try
            {
                if (clsDB.Open() == false)
                    return false;

                clsReader.Connection = clsDB.Connection;
                STBUSA.Excel.ExcelReportGenerator erg = null;

                for (int i = 0; i < lstTradeStatus.Items.Count; i++)
                {
                    if (lstTradeStatus.Items[i].Selected)
                    {
                        if (lstTradeStatus.Items[i].Value == "0")
                        {
                            TradeStatusList.Append(lstTradeStatus.Items[i].Value);
                            break;
                        }
                        else
                        {
                            if (lstTradeStatus.Items[i].Value == "100")
                            {
                                TradeStatusList.Append(enumRepoTradeStatus.UploadedErrorWithHardBlock.GetHashCode().ToString() + "|");
                            }
                            TradeStatusList.Append(lstTradeStatus.Items[i].Value + "|");
                        }
                    }
                }

                clsReader.Connection = clsDB.Connection;
                clsReader.SqlIdentifier = enumGetSQLIndentifier.GET_DATA_REPO_DASHBOARD.ToString();

                SqlCondition[0] = ddlSecType.SelectedValue.ToString();
                SqlCondition[1] = txtSecCode.Text;
                SqlCondition[2] = txtRateFee.Text;
                SqlCondition[3] = TradeStatusList.ToString();
                SqlCondition[4] = txtBDASShell.Text;
                SqlCondition[5] = string.Empty;//txtTransNumber.Text;
                SqlCondition[6] = ddlBrokerCrGroup.SelectedValue;
                SqlCondition[7] = ddlBrokerGroup.SelectedValue;
                SqlCondition[8] = ddlBroker.SelectedValue;
                SqlCondition[9] = "";
                SqlCondition[10] = ddlCustomerAccountGrp.SelectedValue;
                SqlCondition[11] = ddlFinder.SelectedValue;
                SqlCondition[12] = txtTradeDate.Text;
                SqlCondition[13] = txtsettlementDate.Text;
                SqlCondition[14] = txtTermDate.Text;
                SqlCondition[15] = txtUploadedDate.Text;
                SqlCondition[16] = cboCollSched.SelectedValue;
                SqlCondition[17] = null; // RepoTicketID
                //SqlCondition[18] = Convert.ToString(repoExcelID);
                SqlCondition[19] = clsUI.NTUserName;
                SqlCondition[20] = drpBOStatus.SelectedValue;

                // get the data from either current or history table.
                if (clsReader.GetData(ref objDS, SqlObjects.p_GetData_RepoDashBoard, SqlCondition) == false)
                    return false;

                Lava.ExcelTemplates.RepoRequestDashboardReport gxst = null;
                gxst = new Lava.ExcelTemplates.RepoRequestDashboardReport(objDS);

                gxst.ExtractTemplate = EXTRACT_TEMPLATE_NAME;
                fileName = EXCEL_FILENAME + System.DateTime.Now.ToString("yyyyMMdd");
                gxst.ExtractTitle = EXCEL_TITLE;// +txtAsOfDate.Text.Trim() + ")";

                gxst.OutputFormat = Common.EXCEL_OUTPUT_FORMAT;

                erg = new STBUSA.Excel.ExcelReportGenerator(gxst);

                byte[] temp = erg.Generate();

                if (temp != null)
                {
                    IsUI = false;
                    _show_error_row = "NONE";

                    Common.GenerateExcelInXLSFormat(Response, fileName, temp);
                }
                else
                {
                    Common.WriteJavascript("alert('" + Common.GetMessage("Common", "NoRecordsFound") + "');");
                }
            }
            catch (Exception Exc)
            {
                Response.ClearContent();
                Response.ContentType = Common.HTML_CONTENT_TYPE;
                _ErrorString = new StringBuilder();
                _ErrorString.Append(Exc.Message);
                log.Debug(string.Format(ErrorMessageToLog, ModuleName, MethodName, Exc));
                _show_error_row = "";
                return false;
            }
            finally
            {
                clsReader.Dispose();
                clsDB.Dispose();
                objDS.Dispose();
            }

            return true;
        }

