SELECT
    CONVERT(DATE, AsOfDate) AS AsOfDate,
    BrkCode,
    TriPartyGrpID,
    SUM(CollateralAmount) AS CollateralAmount,
    SUM(CollateralAmountWithoutMargin)
        AS CollateralAmountWithoutMargin
FROM dbo.CollateralCoverageHistory
WHERE AsOfDate >= '20260630'
  AND AsOfDate <  '20260702'
GROUP BY
    CONVERT(DATE, AsOfDate),
    BrkCode,
    TriPartyGrpID
ORDER BY
    AsOfDate,
    BrkCode,
    TriPartyGrpID;



SELECT
    AsOfDate,
    BrkGrpID,
    TriPartyGrpID,
    CollValue,
    CollValueWithoutMargin,
    BrkCode,
    CollateralID
FROM dbo.f_GetTripartyCollaterals
(
    '20260630',
    '20260630'
)
ORDER BY
    BrkGrpID,
    TriPartyGrpID,
    BrkCode,
    CollateralID;
