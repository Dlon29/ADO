                    litCountryCode.Text = dtSecInfo.Rows[0]["IsoCountry"].ToString();

                    if (dtSecInfo.Rows[0]["FeeFinal"] != DBNull.Value)
                        litFeeFinal.Text = dtSecInfo.Rows[0]["FeeFinal"].ToString();
                    else
