CREATE PROCEDURE [dbo].[p_GetData_BulkLoan]
(
	@Identifier			VARCHAR(25) = 'S',	 -- E : Existing, N : New , S : Search
	@BussDate			DATETIME = '',
	@BulkNbr			INT = 0,
	@VersionNbr			INT  = 0,
	@SecType			VARCHAR(2) = '',
	@BrkCrGrpID			INT = 0,
	@BrkGrpID			INT = 0, 
	@BrkNbr				VARCHAR(12)  = '0',	
	@FinderNbr			VARCHAR(12)  = '',	
	@UserCode			VARCHAR(50) = '',
	@Comments			VARCHAR(255) = '',
	@CollSchedId		INT = 0,
	@FinderNbrAvailOnly	BIT = 0,
	@LowDivRate			BIT = 0,
	@xmlCountrySelected	VARCHAR(MAX) = '',
	@BasketWeighting	VARCHAR(2) = '',
	@SecCode			VARCHAR(12) = '',
	@CollCCYCode		VARCHAR(3) = '',
	@xmlSecIDList		VARCHAR(MAX) = ''
)
AS
BEGIN
	
	SET NOCOUNT ON;
	DECLARE @ERROR_NO INT, @hdocSecId INT, @ErrorRowSeq INT, @Maturity_Days INT
	DECLARE @DEFAULT_OPEN_TPUID VARCHAR(20)
	DECLARE @DEFAULT_TERM_TPUID VARCHAR(20)

--set @BussDate = '04/22/2013'
	SET @Maturity_Days = 30

	CREATE TABLE #TempBasketHeader
	(
		BulkNbr				INT,
		VersionNbr				INT,
		BucketSecType			VARCHAR(2),
		BrkID					INT,
		BrkName					VARCHAR(255),
		TriPartyID				INT,
		BrkNbr					VARCHAR(6),
		TriPartyGrpID			INT,
		CollSchedId				INT,
		CollCCYCode				VARCHAR(3),			
		FinderNbr				VARCHAR(6),
		FinderAvailabilityOnly	BIT,
		Comments				VARCHAR(255),
		BasketMarketCap			BIGINT,
		LowDivRate				BIT,		
		StatusID				INT,
		LoanStatus				VARCHAR(50),
--		isDeleted				BIT,
		ModifiedBy				VARCHAR(50),
		ModifiedDate			DATETIME,
		ModifiedTime			DATETIME
	)

	SET @ErrorRowSeq = 1

	IF (@Identifier = 'SEARCHMODIFY') -- this section will be called when user clicks on Search button to get Booked/Saved/Deleted basket details
	BEGIN 
		SELECT 
			LoanBasket.BulkNbr,
			LoanBasket.VersionNbr,
			LoanBasket.BucketSecType,
			LoanBasket.BrkNbr,
			LoanBasket.TriPartyGrpID,
			LoanBasket.CollSchedId,
			LoanBasket.FinderNbr,
			LoanBasket.FinderAvailabilityOnly,
			LoanBasket.Comments,
			LoanBasket.BasketMarketCap,			
			LoanBasket.StatusID,
			CASE LoanBasket.StatusID WHEN 10 THEN 'New' WHEN 20 THEN 'Booked' WHEN 30 THEN 'Deleted' END LoanStatus,
--			LoanBasket.isDeleted,
			LoanBasket.ModifiedBy,
			LoanBasket.ModifiedDate,
			CONVERT(VARCHAR(10),LoanBasket.ModifiedDate,108) ModifiedTime
		FROM 
			BulkLoanHeader LoanBasket
		INNER JOIN
			dbo.Broker Brk
		ON
			Brk.BrkNbr = LoanBasket.BrkNbr AND
			ISNULL(Brk.IsDeleted,0) = 0 AND
			(
				ISNULL(@BussDate,GETDATE()) BETWEEN Brk.EffectiveDateBegin AND Brk.EffectiveDateEnd
			)  AND
			(
				ISNULL(@SecType,'') = '' OR Brk.BusinessInd = @SecType
			) AND
			(
				ISNULL(@BrkNbr,'0') = '0' OR Brk.BrkNbr = @BrkNbr
			)
		INNER JOIN
			dbo.BrokerGroup BrkGrp
		ON
			Brk.BrkGrpID = BrkGrp.BrkGrpID AND
			ISNULL(BrkGrp.IsDeleted,0) = 0 AND
			(
				ISNULL(@BussDate,GETDATE()) BETWEEN BrkGrp.EffectiveDateBegin AND BrkGrp.EffectiveDateEnd
			) AND 
			(
				ISNULL(@BrkGrpID,'0') = '0' OR BrkGrp.BrkGrpID = @BrkGrpID
			)
		INNER JOIN
			dbo.BrokerCreditGroup BrkCrGrp
		ON
			BrkGrp.BrkCrGrpID = BrkCrGrp.BrkCrGrpID AND
			ISNULL(BrkCrGrp.IsDeleted,0) = 0 AND
			(
				ISNULL(@BussDate,GETDATE()) BETWEEN BrkCrGrp.EffectiveDateBegin AND BrkCrGrp.EffectiveDateEnd
			)  AND 
			(
				ISNULL(@BrkCrGrpID,'0') = '0' OR BrkCrGrp.BrkCrGrpID = @BrkCrGrpID
			) AND
			(
				@FinderNbr = '' -- for all loans
				OR (@FinderNbr = '0' AND ISNULL(LoanBasket.FinderNbr,'') != '000LDN' )-- for US Loans
				OR LoanBasket.FinderNbr = @FinderNbr -- for London loans
			) AND
			(
				ISNULL(@UserCode,'0') = '0' OR LoanBasket.ModifiedBy LIKE '%' + @UserCode + '%'
			) AND
			(
				ISNULL(@Comments,'') = '' OR LoanBasket.Comments LIKE '%' + @Comments + '%'
			) AND 
			(
				ISNULL(@CollCCYCode,'') = '' OR LoanBasket.CollCCYCode = @CollCCYCode
			)
		ORDER BY 
			LoanBasket.ID DESC
	END
	ELSE IF (@Identifier = 'OPENBASKET' OR @Identifier = 'COPYBASKET')  -- this section will be called when user clicks on Open/Copy button to get Booked/Saved/Deleted basket details
	BEGIN 
		INSERT INTO #TempBasketHeader
		(
			BulkNbr,
			VersionNbr,
			BucketSecType,
			BrkID,
			BrkName,
			TriPartyID,
			BrkNbr,
			TriPartyGrpID,
			CollSchedId,
			CollCCYCode,			
			FinderNbr,
			FinderAvailabilityOnly,
			Comments,
			BasketMarketCap,
			LowDivRate,
			StatusID,
			LoanStatus,
--			isDeleted,
			ModifiedBy,
			ModifiedDate,
			ModifiedTime
		)
		SELECT 
			LoanBasket.BulkNbr,
			LoanBasket.VersionNbr,
			LoanBasket.BucketSecType,
			Brk.BrkID,
			Brk.BrkName,
			Brk.TriPartyID,
			LoanBasket.BrkNbr,
			LoanBasket.TriPartyGrpID,
			LoanBasket.CollSchedId,
			LoanBasket.CollCCYCode,			
			LoanBasket.FinderNbr,
			LoanBasket.FinderAvailabilityOnly,
			LoanBasket.Comments,
			LoanBasket.BasketMarketCap,			
			LoanBasket.LowDivRate,
			LoanBasket.StatusID,
			CASE LoanBasket.StatusID WHEN 10 THEN 'New' WHEN 20 THEN 'Booked' WHEN 30 THEN 'Deleted' END LoanStatus,
--			LoanBasket.isDeleted,
			LoanBasket.ModifiedBy,
			LoanBasket.ModifiedDate,
			CONVERT(VARCHAR(10),LoanBasket.ModifiedDate,108) ModifiedTime
		FROM 
			BulkLoanHeader LoanBasket
		INNER JOIN
			dbo.Broker Brk
		ON
			Brk.BrkNbr = LoanBasket.BrkNbr AND
			ISNULL(Brk.IsDeleted,0) = 0 AND
			(
				ISNULL(@BussDate,GETDATE()) BETWEEN Brk.EffectiveDateBegin AND Brk.EffectiveDateEnd
			)  AND
			(
				Brk.BusinessInd = LoanBasket.BucketSecType
			)
		INNER JOIN
			dbo.BrokerGroup BrkGrp
		ON
			Brk.BrkGrpID = BrkGrp.BrkGrpID AND
			ISNULL(BrkGrp.IsDeleted,0) = 0 AND
			(
				ISNULL(@BussDate,GETDATE()) BETWEEN BrkGrp.EffectiveDateBegin AND BrkGrp.EffectiveDateEnd
			) 
		INNER JOIN
			dbo.BrokerCreditGroup BrkCrGrp
		ON
			BrkGrp.BrkCrGrpID = BrkCrGrp.BrkCrGrpID AND
			ISNULL(BrkCrGrp.IsDeleted,0) = 0 AND
			(
				ISNULL(@BussDate,GETDATE()) BETWEEN BrkCrGrp.EffectiveDateBegin AND BrkCrGrp.EffectiveDateEnd
			)  AND 						
			(
				LoanBasket.BulkNbr = @BulkNbr
			)AND
			(
				LoanBasket.VersionNbr = @VersionNbr
			)			

		SELECT 
			@DEFAULT_OPEN_TPUID = ISNULL(TPUID,'')
		FROM
			MTMTripartyManualEntry TBL_MTMTRI
		INNER JOIN
			#TempBasketHeader TMP_BULK_HEADER
		ON
			( TBL_MTMTRI.BrkNbr = TMP_BULK_HEADER.BrkNbr ) AND
			( TBL_MTMTRI.CollSchedId = TMP_BULK_HEADER.CollSchedId )
		 WHERE							
			( TBL_MTMTRI.IsDefaultOpen = 1 )
		
		SELECT 
			@DEFAULT_TERM_TPUID = ISNULL(TPUID,'')
		FROM
			MTMTripartyManualEntry TBL_MTMTRI
		INNER JOIN
			#TempBasketHeader TMP_BULK_HEADER
		ON
			( TBL_MTMTRI.BrkNbr = TMP_BULK_HEADER.BrkNbr ) AND
			( TBL_MTMTRI.CollSchedId = TMP_BULK_HEADER.CollSchedId )
		 WHERE								
			( TBL_MTMTRI.IsDefaultTerm = 1 )

		SELECT 
			CASE @Identifier WHEN 'OPENBASKET' THEN BulkNbr WHEN 'COPYBASKET' THEN NULL END BulkNbr, --0
			CASE @Identifier WHEN 'OPENBASKET' THEN VersionNbr WHEN 'COPYBASKET' THEN NULL END VersionNbr, --1
			BucketSecType,
			BrkID,
			BrkName,
			TriPartyID,
			BrkNbr,
			TriPartyGrpID,
			CollSchedId,
			CollCCYCode,			
			FinderNbr,
			FinderAvailabilityOnly,
			Comments,
			BasketMarketCap,
			LowDivRate,			
			StatusID,
			LoanStatus,
--			isDeleted,
			ModifiedBy,
			ModifiedDate,
			ModifiedTime
		FROM 
			#TempBasketHeader

		SELECT     
			BrokerAttributes = (IsNull(Temp.BrkName,'') + ' (' + IsNull(Temp.BrkNbr,'') + ')') /*+ 
				' - ' + bd.LoanType + '' + 
				case bd.LoanType when 'C' THEN '(Cash Loan)' WHEN 'L' THEN '(Letter of Credit)' WHEN 'P' THEN '(Pooled Collateral)' WHEN 'S' THEN '(Specific Collateral)'
								WHEN 'T' THEN '(Tri-party)' END + ''*/,
			bd.LoanType 
		FROM         
			MOBETTER.DBO.Broker bd
		INNER JOIN 
			#TempBasketHeader Temp 
		ON
			Temp.BrkID = bd.BrkID	AND
			ISNULL(bd.IsDeleted,0) = 0 AND
			(
				ISNULL(@BussDate,GETDATE()) BETWEEN bd.EffectiveDateBegin AND bd.EffectiveDateEnd
			)

		SELECT DISTINCT
			CONVERT(VARCHAR(10),ISNULL(AccCollSched.TriPartyGrpID,0)) + '|' + CONVERT(VARCHAR(10),CollSched.CollSchedId) CollSchedId,
			CollSched.CollSchedName + ' (' + RiskWgh.RiskWeightDesc + ')' CollSchedName
		FROM 
			#TempBasketHeader Temp 
		INNER JOIN
			MOBETTER.dbo.AcctCollTypeSchedule AccCollSched			
		ON
			ISNULL(AccCollSched.TriPartyGrpID,0) = ISNULL(Temp.TriPartyGrpID,0) AND
			@BussDate BETWEEN AccCollSched.EffectiveDateBegin AND AccCollSched.EffectiveDateEnd AND
			ISNULL(AccCollSched.IsDeleted,0) = 0
		INNER JOIN 
			MOBETTER.dbo.CollateralSchedule CollSched
		ON
			AccCollSched.CollSchedId = CollSched.CollSchedId AND 				
			@BussDate BETWEEN CollSched.EffectiveDateBegin AND CollSched.EffectiveDateEnd AND
			ISNULL(CollSched.IsDeleted,0) = 0 
		INNER JOIN
			MOBETTER.dbo.CollateralScheduleRiskWeights RiskWgh
		ON
			RiskWgh.CollSchedId = AccCollSched.CollSchedId AND
			RiskWgh.TriPartyGrpID = ISNULL(AccCollSched.TriPartyGrpID,0) AND
			@BussDate BETWEEN RiskWgh.EffectiveDateBegin AND RiskWgh.EffectiveDateEnd AND
			RiskWgh.LoanCategory = 'L' AND			  --Currently bulk functionality is used only for sec lending and not for repo
			RiskWgh.BusinessInd = Temp.BucketSecType 
			
/*
--		INNER JOIN 
--			Account Acc 
--		ON
--			Acc.AcctNbr = AccCollSched.AcctNbr AND
--			ISNULL(Acc.IsDeleted, 0) = 0 AND
--			ISNULL(Acc.IsCollateral, 0) = 0 AND
--			(@BussDate BETWEEN Acc.EffectiveDateBegin AND Acc.EffectiveDateEnd) AND
--			(Acc.AcctType = Temp.BucketSecType)
*/
		

		SELECT 
			CASE @Identifier WHEN 'OPENBASKET' THEN BasketDtl.BulkNbr WHEN 'COPYBASKET' THEN NULL END BulkNbr, --0
			CASE @Identifier WHEN 'OPENBASKET' THEN BasketDtl.VersionNbr WHEN 'COPYBASKET' THEN NULL END VersionNbr, --1
			Temp.BucketSecType, --2
			Sec.SecID, --3
			Sec.ISOCOuntry, --4 
			Sec.SecCode, --5
			Sec.SEDOL, --6
			Sec.TickSymb, --7
			(ISNULL(Sec.SecurityDesc1,'') + ISNULL(Sec.SecurityDesc2,'')) SecurityName, --8
			ISNULL(BasketDtl.BrokerLendable,0) as BrokerLendable, --9
			BasketDtl.PriceBaseCurrency, --10
			BasketDtl.FXRate, --11
			BasketDtl.Price as Price, --12  -- For 'OPENBASKET' and 'COPYBASKET' we will show price store in database, no need to Convert the same.
			--CASE @SecType WHEN 'FI' THEN dbo.f_Get_FI_PriceRounded(BasketDtl.Price) ELSE BasketDtl.Price END  Price, -- Price --12
			BasketDtl.DivYield, --13
			BasketDtl.DateEx, --14
			BasketDtl.DateRecord RecordDate, --15
			BasketDtl.DivPaymentRate DivRate, --16
			BasketDtl.RebateRate, --17
			BasketDtl.FaceAmount, --18
			BasketDtl.Principal BasketMarketCap, --19
			CONVERT(DECIMAL,0) AllocationPerc, --20
			BasketDtl.Principal, --21
			BasketDtl.ProductCategory, --22
			BasketDtl.ProductCategoryLoanType,--23
			BasketDtl.ProductCategoryLoanDuration,--24
			BasketDtl.SettlementDate, --25
			BasketDtl.AsOfDate, --25
			BasketDtl.TermDate, --26
			BasketDtl.STTLevel, --27
			BasketDtl.STTEndDate, --28
			BasketDtl.STTDivRate, --29
			BasketDtl.ScripEndDate, --30
			'' ErrorMEssage, -- 31
			Sec.CcyCode, -- 32
			BasketDtl.Remarks,
			GotoRemarks,
			LIBORRate,
			GotoRepoRate,
			GotoSTTLevel,
			GotoSTTDivRate,
			GotoProductCategoryLoanType,
			GotoProductCategoryLoanDuration,
			GotoScripEndDate,
			GotoSTTEndDate,
			GotoTermDate,
			ResetDate,
			GotoProductCategory,
			BasketIdentifier = dbo.f_GetBasketIdentifier(BasketDtl.BasketNbr),
			BasketDtl.BasketNbr,
			'' ASECheck,
			'' UseTraderLendable,
			0  TraderLendable,
			'' UseAmount,
			BasketDtl.DesiredSTTLevel as DesiredSTTLevel,
			'' as IsProjectedDividend,
			CONVERT(DECIMAL,NULL) as ProjectedDividendAmount,
			@ErrorRowSeq RowSeq,
			BasketDtl.DivRateForAlloc as DivRateForAlloc,
			IsBlocked = dbo.f_IsSecurityBlocked (Sec.SecID,@BussDate),
			CASE WHEN (ISNULL(BasketDtl.FaceAmount,0) >  ISNULL(BasketDtl.BrokerLendable,0))  THEN 1 ELSE  0 END AS isQtyGreaterThanBrkLendable,
			Is_DedicatedMarginCollateral_FISecurity = '',
			Is_FISecurity_Matured =  CASE WHEN ( Temp.BucketSecType <> 'FI' ) 
									 THEN 0 ELSE 
										( CASE WHEN ( DATEDIFF(dd, @BussDate, ISNULL(MaturityDate,@BussDate)) < @Maturity_Days ) THEN 1 ELSE 0 END ) END,
			BasketDtl.TPUID,
			Default_Open_TPUID = @DEFAULT_OPEN_TPUID,
			Default_Term_TPUID = @DEFAULT_TERM_TPUID,
			IsPrePay = ISNULL(BasketDtl.IsPrePay, 0),
			IsEquilend = CASE WHEN ISNULL(BasketDtl.IsEquilend, 0) = 1 THEN 'Y' ELSE 'N' END
		FROM
			dbo.BulkLoanDetail BasketDtl
		INNER JOIN
			#TempBasketHeader Temp
		ON
			Temp.BulkNbr = BasketDtl.BulkNbr AND
			Temp.VersionNbr = BasketDtl.VersionNbr
		INNER JOIN
			REFERENCE.dbo.Security Sec
		ON
			Sec.SecID = BasketDtl.SecID
		--LEFT JOIN
		--	LAVA.dbo.DedicatedMarginCollateral TDMC
		--ON
		--	TDMC.SecId = Sec.SecID
		ORDER BY 
			isQtyGreaterThanBrkLendable DESC

		SELECT @BrkNbr = BrkNbr, @SecType = BucketSecType FROM #TempBasketHeader

		SELECT DISTINCT
			ADD_MD Country, ADD_MD Curr
		FROM 			
			GLOBALONE.dbo.SETTLE_INST
		WHERE
			SE_ACCT_NO LIKE '%' + @BrkNbr
		ORDER BY 
			ADD_MD

		SELECT
			 DISTINCT LBS.BasketNbr,LBS.Comments as BasketIdentifier --,LBS.BasketIdentifier  -- Modified for M-446, Replace  Basket Identifier with Basket Comments (Basket Name)
		FROM
			 dbo.LoanBasketSetup LBS	
		INNER JOIN
			dbo.Broker B
		ON
			LBS.BrkNbr = B.BrkNbr AND
			@BussDate BETWEEN B.EffectiveDateBegin AND B.EffectiveDateEnd AND
			ISNULL(B.IsDeleted,0) = 0				
		WHERE
			ISNULL(LBS.IsDeleted,0) = 0 AND
			LBS.BrkNbr    = @BrkNbr AND
			LBS.BucketSecType = @SecType -- AND
--			(ISNULL(NULLIF(@SQL_CONDITION4, ''), '0') = '0' or LBS.BasketSecLocation LIKE '%' + @SQL_CONDITION4 + '%')

		SELECT 
			DISTINCT sec.secID,
			TM.BondForeign DivRateVal, CONVERT(VARCHAR(10),
			ISNULL(CONVERT(DECIMAL(8,2),TM.BondForeign),1) * 100) + '%' DivRate
		FROM  
			dbo.BulkLoanDetail BasketDtl
		INNER JOIN
			#TempBasketHeader Temp
		ON
			Temp.BulkNbr = BasketDtl.BulkNbr AND
			Temp.VersionNbr = BasketDtl.VersionNbr
		INNER JOIN
			REFERENCE.dbo.Security Sec
		ON
			BasketDtl.SecID  = Sec.SecID 
		INNER JOIN
			GLOBALONE.dbo.TaxMatrix  TM
		ON
			Sec.ISOCountry = TM.SecCountry
		ORDER BY
			sec.SecID,TM.BondForeign
		

		DROP TABLE #TempBasketHeader

	END	
	ELSE IF (@Identifier = 'UPLOADBASKET') -- this section will be called when user clicks on Search button to get Booked/Saved/Deleted basket details
	BEGIN
		DECLARE @PrevBizDay	DATETIME, @PrevOfPrevBizDay DATETIME

		/** Get Previous business date for AsOfDate**/
		SELECT @PrevBizDay = dbo.f_GetPrevBizDay (@BussDate)	

		/** Get Previous business date of previous business date **/
		SELECT @PrevOfPrevBizDay = dbo.f_GetPrevBizDay (@PrevBizDay)	

		--Retain data only for selected securities
		IF (@xmlSecIdList IS NOT NULL AND @xmlSecIdList != '')
		BEGIN
			DECLARE @TempSecIDTable TABLE 
			(
				RowID	INT IDENTITY(1,1),				
				BulkNbr		INT,
				VersionNbr		INT,
				SecID			INT,
				CUSIP			VARCHAR(9),
				ISIN			VARCHAR(12),
				TickSymb		VARCHAR(12),
				SEDOL			VARCHAR(7),				
				BucketSecType	VARCHAR(2),
				SecCode			VARCHAR(12),
				CcyCode			VARCHAR(3),
				SecurityName	VARCHAR(255),
				ISOCOuntry		VARCHAR(2),				
				BrokerLendable	BIGINT,
				PriceBaseCurrency DECIMAL(14,7),
				FxRate			DECIMAL(13,5),
				Price			DECIMAL(14,7),
				DivYield		DECIMAL(13,5),
				DateEx			DATETIME,
				RecordDate		DATETIME,
				DivRate			DECIMAL(13,5),
				RebateRate		DECIMAL(13,5),
				FaceAmount		BIGINT,
				Principal		DECIMAL(13,8),
				BasketMarketCap	BIGINT,
				AllocationPerc	DECIMAL(13,5),
				ProductCategory	VARCHAR(3),
				ProductCategoryLoanType		VARCHAR(20),	--LoanType
				ProductCategoryLoanDuration	VARCHAR(20),
				STTLevel	DECIMAL(13,5),
				STTDivRate	DECIMAL(13,5),
				STTEndDate	DATETIME,
				ScripEndDate	DATETIME,  --
				SettlementDate	DATETIME,
				AsOfDate		DATETIME,
				TermDate		DATETIME,
				ErrorMessage	VARCHAR(100),
				IsValidSec		BIT DEFAULT 0,
				IsDuplicateSec	BIT DEFAULT 0,
				Remarks		varchar(20) NULL,
				GotoRemarks varchar(20) NULL,
				LIBORRate decimal(20, 10) NULL,
				GotoRepoRate decimal(20, 7) NULL,
				GotoSTTLevel decimal(5, 2) NULL,
				GotoSTTDivRate decimal(13, 6) NULL,
				GotoProductCategoryLoanType varchar(20) NULL,
				GotoProductCategoryLoanDuration varchar(20) NULL,
				GotoScripEndDate datetime NULL,
				GotoSTTEndDate datetime NULL,
				GotoTermDate datetime NULL,
				ResetDate datetime NULL,
				GotoProductCategory varchar(3) NULL,
				BasketNbr INT NULL,
				DesiredSTTLevel DECIMAL(5,2),
				IsSystemGeneratedPrice BIT DEFAULT 0,
				Is_DedicatedMarginCollateral_FISecurity INT DEFAULT 0,
				Is_FISecurity_Matured INT DEFAULT 0,
				Security_Maturity_Date	VARCHAR(10),
				IsEquilend VARCHAR(10) NULL
			)

			EXEC SP_XML_PREPAREDOCUMENT @hdocSecId OUTPUT, @xmlSecIdList

			INSERT INTO @TempSecIDTable 
			(
				CUSIP,
				ISIN,
				TickSymb,
				SEDOL,				
				DivYield,
				DateEx,
				RecordDate,
				DivRate,
				Price,
				RebateRate,
				FaceAmount,
				ProductCategory,
				ProductCategoryLoanType,
				ProductCategoryLoanDuration,
				STTLevel,
				STTDivRate,
				STTEndDate,
				ScripEndDate, 
				SettlementDate,
				AsOfDate,
				TermDate,
				Remarks,
				GotoRemarks,
				LIBORRate,
				GotoRepoRate,
				GotoSTTLevel,
				GotoSTTDivRate,
				GotoProductCategoryLoanType,
				GotoProductCategoryLoanDuration,
				GotoScripEndDate,
				GotoSTTEndDate,
				GotoTermDate,
				ResetDate,
				GotoProductCategory,
				DesiredSTTLevel,
				IsEquilend
			)
			SELECT 
				CUSIP,
				ISIN,
				TickSymb,
				SEDOL,				
				CASE LEN(DivYield) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(13,6),DivYield) END,
				CASE NextExDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL ELSE NextExDate END,
				CASE NextRecDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL ELSE NextRecDate END,
				CASE LEN(DivRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(13,6),DivRate) END,
				CASE LEN(Price) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(13,6),Price) END,
				CASE LEN(REBFEE) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(15,8),REBFEE) END,
				CASE LEN(FaceAmount) WHEN 0 THEN NULL ELSE CONVERT(BIGINT,FaceAmount) END,
				ProductCategory,
				ProductCategoryLoanType,
				ProductCategoryLoanDuration,
				CASE LEN(AllInRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(5,2),AllInRate) END,
				CASE LEN(STTDivRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(13,6),STTDivRate) END,
				CASE STTEndDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL  ELSE STTEndDate END,
				CASE ScripEndDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL  ELSE ScripEndDate END,	--
				CASE SettlementDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL ELSE SettlementDate END,
				CASE AsOfDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL ELSE AsOfDate END,
				CASE TermDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL ELSE TermDate END,
				Remarks,
				GotoRemarks,
				0,--CASE LEN(LIBORRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(5,2),LIBORRate) END,
				CASE LEN(GotoRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(20,7),GotoRate) END,
				NULL,--CASE LEN(GotoSTTLevel) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(5,2),GotoSTTLevel) END,
				NULL,--CASE LEN(GotoSTTDivRate) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(5,2),GotoSTTDivRate) END,
				GotoProductCategoryLoanType,
				GotoProductCategoryLoanDuration,
				NULL,--CASE GotoScripEndDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL  ELSE GotoScripEndDate END,
				NULL,--CASE GotoSTTEndDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL  ELSE GotoSTTEndDate END,	
				CASE GotoTermDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL ELSE GotoTermDate END,
				CASE ResetDate WHEN '1900-01-01 00:00:00.000' THEN NULL WHEN '' THEN NULL ELSE ResetDate END,
				GotoProductCategory,
				CASE LEN(DesiredSTTLevel) WHEN 0 THEN NULL ELSE CONVERT(DECIMAL(5,2),DesiredSTTLevel) END,
				UPPER(LTRIM(RTRIM(ISNULL(IsEquilend, ''))))

			FROM 
				OPENXML(@hdocSecId, '/ROOT/record', 1)
			WITH 
			(
				CUSIP			VARCHAR(9),
				ISIN			VARCHAR(12),
				TickSymb		VARCHAR(12),
				SEDOL			VARCHAR(7),				
				DivYield		VARCHAR(100),
				NextExDate		VARCHAR(100),
				NextRecDate		VARCHAR(100),
				DivRate			VARCHAR(100),
				Price			VARCHAR(100),
				REBFEE			VARCHAR(100),
				FaceAmount		VARCHAR(100),
				ProductCategory	VARCHAR(3),
				ProductCategoryLoanType		VARCHAR(20),	--LoanType
				ProductCategoryLoanDuration	VARCHAR(20),
				AllInRate		VARCHAR(100),
				STTDivRate	VARCHAR(100),
				STTEndDate	VARCHAR(100),
				ScripEndDate	VARCHAR(100),
				SettlementDate	VARCHAR(100),
				AsOfDate		VARCHAR(100),
				TermDate		VARCHAR(100),
				Remarks			VARCHAR(20),
				GotoRemarks		VARCHAR(20),
				--LIBORRate		VARCHAR(100),
				GotoRate		VARCHAR(100),
				--GotoSTTLevel decimal(5, 2),
				--GotoSTTDivRate decimal(13, 6),
				GotoProductCategoryLoanType varchar(20),
				GotoProductCategoryLoanDuration varchar(20),
				--GotoScripEndDate datetime,
				--GotoSTTEndDate datetime,
				GotoTermDate datetime,
				ResetDate datetime,
				GotoProductCategory		varchar(3),
				DesiredSTTLevel	VARCHAR(10),
				IsEquilend VARCHAR(10)

			)

			EXEC SP_XML_REMOVEDOCUMENT @hdocSecId	

--			SELECT * FROM @TempSecIDTable		

			UPDATE 
				@TempSecIDTable 
			SET 
				SecID = Ref.SecID, 
				SecCode = Ref.SecCode,
				CcyCode = Ref.CcyCode,
				BucketSecType = Ref.BucketSecurityType,
				SecurityName = Ref.SecurityDesc1,
				ISOCOuntry = Ref.ISOCOuntry,
				TickSymb = RTRIM(LEFT(Ref.TickSymb, 5)),
				Security_Maturity_Date = ISNULL(convert(varchar(10),Ref.MaturityDate,101),'N/A'),
				IsValidSec = 1
			FROM 
				REFERENCE.dbo.Security Ref
			INNER JOIN 
				@TempSecIDTable Temp
			ON 
				ISNULL(Ref.CUSIP,'') = ISNULL(Temp.CUSIP,'') AND
				ISNULL(Ref.ISIN,'') = ISNULL(Temp.ISIN,'')  AND
				ISNULL(Ref.SEDOL,'') = ISNULL(Temp.SEDOL,'') AND
				ISNULL(Ref.TickSymb,'') = ISNULL(Temp.TickSymb,'')
				
			UPDATE 
				@TempSecIDTable 
			SET 
				SecID = Ref.SecID, 
				SecCode = Ref.SecCode,
				CcyCode = Ref.CcyCode,				
				BucketSecType = Ref.BucketSecurityType,
				SecurityName = Ref.SecurityDesc1,
				ISOCOuntry = Ref.ISOCOuntry,
				TickSymb = RTRIM(LEFT(Ref.TickSymb, 5)),
				Security_Maturity_Date = ISNULL(convert(varchar(10),Ref.MaturityDate,101),'N/A'),
				IsValidSec = 1
			FROM 
				REFERENCE.dbo.Security Ref
			INNER JOIN 
				@TempSecIDTable Temp
			ON 
				ISNULL(Ref.CUSIP,'') = ISNULL(Temp.CUSIP,'') AND
				ISNULL(Temp.ISIN,'')= '' AND
				ISNULL(Temp.SEDOL,'')= '' AND
				ISNULL(Temp.TickSymb,'')= '' 

			UPDATE 
				@TempSecIDTable 
			SET 
				SecID = Ref.SecID, 
				SecCode = Ref.SecCode,
				CcyCode = Ref.CcyCode,
				BucketSecType = Ref.BucketSecurityType,
				SecurityName = Ref.SecurityDesc1,
				ISOCOuntry = Ref.ISOCOuntry,
				TickSymb = RTRIM(LEFT(Ref.TickSymb, 5)),
				Security_Maturity_Date = ISNULL(convert(varchar(10),Ref.MaturityDate,101),'N/A'),
				IsValidSec = 1
			FROM 
				REFERENCE.dbo.Security Ref
			INNER JOIN 
				@TempSecIDTable Temp
			ON 
				Ref.ISIN = Temp.ISIN AND
				temp.SecID IS NULL AND
				ISNULL(Temp.CUSIP,'')= '' AND
				ISNULL(Temp.SEDOL,'')= '' AND
				ISNULL(Temp.TickSymb,'')= '' 

			UPDATE 
				@TempSecIDTable 
			SET 
				SecID = Ref.SecID, 
				SecCode = Ref.SecCode,
				CcyCode = Ref.CcyCode,				
				BucketSecType = Ref.BucketSecurityType,
				SecurityName = Ref.SecurityDesc1,
				ISOCOuntry = Ref.ISOCOuntry,
				TickSymb = RTRIM(LEFT(Ref.TickSymb, 5)),
				Security_Maturity_Date = ISNULL(convert(varchar(10),Ref.MaturityDate,101),'N/A'),
				IsValidSec = 1
			FROM 
				REFERENCE.dbo.Security Ref
			INNER JOIN 
				@TempSecIDTable Temp
			ON 
				Ref.SEDOL = Temp.SEDOL AND
				temp.SecID IS NULL AND
				ISNULL(Temp.CUSIP,'')= '' AND
				ISNULL(Temp.ISIN,'')= '' AND
				ISNULL(Temp.TickSymb,'')= '' 

			UPDATE 
				@TempSecIDTable 
			SET 
				SecID = Ref.SecID, 
				SecCode = Ref.SecCode,
				CcyCode = Ref.CcyCode,				
				BucketSecType = Ref.BucketSecurityType,
				SecurityName = Ref.SecurityDesc1,
				ISOCOuntry = Ref.ISOCOuntry,
				TickSymb = RTRIM(LEFT(Ref.TickSymb, 5)),
				Security_Maturity_Date = ISNULL(convert(varchar(10),Ref.MaturityDate,101),'N/A'),
				IsValidSec = 1
			FROM 
				REFERENCE.dbo.Security Ref
			INNER JOIN 
				@TempSecIDTable Temp
			ON 
				Ref.TickSymb LIKE '%' + Temp.TickSymb  +'%' AND
				temp.SecID IS NULL AND
				ISNULL(Temp.CUSIP,'')= '' AND
				ISNULL(Temp.ISIN,'')= '' AND
				ISNULL(Temp.SEDOL,'')= '' 

			--Obtain price (1 business day old) for security with same currency as CollCCYCode
			UPDATE
				@TempSecIDTable
			SET
				--Price = (Pr.Price / 100)
				Price = (CASE Report.BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END),
				IsSystemGeneratedPrice = 1
			FROM
				@TempSecIDTable Report
			INNER JOIN	
				REFERENCE.dbo.Price Pr
			ON
				Report.SecID = Pr.SecID 
			WHERE
				Report.CCYCode = @CollCCYCode AND --Report.CCYCode = 'USD' AND
				Pr.PricingDate >= @PrevBizDay AND
				REport.Price IS NULL

			--Obtain price (1 business day old) for security with currency different from CollCCYCode
			UPDATE
				@TempSecIDTable
			SET 
				--Price = ((Pr.Price/100)/((CASE fx.Rate WHEN 0 THEN NULL ELSE fx.Rate END) /100))
				Price =(( CASE Report.BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END )/((CASE fx.Rate WHEN 0 THEN NULL ELSE fx.Rate END) /100)),
				IsSystemGeneratedPrice = 1
			FROM
				@TempSecIDTable Report
			INNER JOIN
				REFERENCE.dbo.Price Pr
			ON
				Report.SecID = Pr.SecID 
			LEFT JOIN 
				REFERENCE.dbo.ForeignExchange fx
			ON 
				fx.CCYCode = Pr.CCYCode AND 
				fx.BaseCCYCode = @CollCCYCode AND  --fx.BaseCCYCode = 'USD' AND 
				FXDate >= @PrevBizDay
			WHERE
				Report.CCYCode <> @CollCCYCode AND --Report.CCYCode <> 'USD' AND
				Pr.PricingDate >= @PrevBizDay AND
				REport.Price IS NULL

			--Obtain price (2 business day old) for security with same currency as CollCCYCode
			UPDATE
				@TempSecIDTable
			SET
				--Price = (Pr.Price / 100)
				Price = (CASE Report.BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END),
				IsSystemGeneratedPrice = 1
			FROM
				@TempSecIDTable Report
			INNER JOIN	
				REFERENCE.dbo.Price Pr
			ON
				Report.SecID = Pr.SecID 
			WHERE
				Report.CCYCode = @CollCCYCode AND --Report.CCYCode = 'USD' AND
				Pr.PricingDate >= @PrevOfPrevBizDay AND
				(Report.Price IS NULL OR Report.Price = 0) AND
				REport.Price IS NULL

			--Obtain price (2 business day old) for security with currency different from CollCCYCode
			UPDATE
				@TempSecIDTable
			SET 
				--Price = ((Pr.Price/100)/((CASE fx.Rate WHEN 0 THEN NULL ELSE fx.Rate END) /100))
				Price =(( CASE Report.BucketSecType WHEN 'FI' THEN Pr.Price ELSE (Pr.Price/100) END )/((CASE fx.Rate WHEN 0 THEN NULL ELSE fx.Rate END) /100)),
				IsSystemGeneratedPrice = 1
			FROM
				@TempSecIDTable Report
			INNER JOIN
				REFERENCE.dbo.Price Pr
			ON
				Report.SecID = Pr.SecID 
			LEFT JOIN 
				REFERENCE.dbo.ForeignExchange fx
			ON 
				fx.CCYCode = Pr.CCYCode AND 
				fx.BaseCCYCode = @CollCCYCode AND 
				FXDate >= @PrevOfPrevBizDay
			WHERE
				Report.CCYCode <> @CollCCYCode AND --Report.CCYCode <> 'USD' AND
				Pr.PricingDate >= @PrevOfPrevBizDay AND
				(Report.Price IS NULL OR Report.Price = 0) AND
				REport.Price IS NULL

			UPDATE 
				@TempSecIDTable 
			SET 
				IsDuplicateSec = 1
			FROM
				@TempSecIDTable Temp
			INNER JOIN
			(
				SELECT SecID,COUNT(SecID) Cnt FROM @TempSecIDTable GROUP BY secid
			)Sec
			ON
				Sec.SecID = temp.SecID AND
				Sec.Cnt > 1		

			-- Changes for M-443 FOR EQ new loan booking,a. If system price is used, it will be rounded to 2 decimal places
			-- FOR FI new loan booking,a. If system price is used, it will be rounded to 1/8 th price
			UPDATE 
				@TempSecIDTable 
			SET 
				Price = CASE @SecType WHEN 'FI' THEN dbo.f_Get_FI_PriceRounded(Temp.Price) ELSE convert (decimal (15,2),Temp.Price) END 
			FROM
				@TempSecIDTable Temp
			WHERE 
				IsSystemGeneratedPrice = 1

			/* Update Is_DedicatedMarginCollateral_FISecurity to 1 if security selected for loan booking is also part of dedicated margin collateral*/
	
			-- UPDATE TMPSECID 
			-- SET 
			--	Is_DedicatedMarginCollateral_FISecurity = 1
			-- FROM
			--	LAVA.dbo.DedicatedMarginCollateral TDMC
			--INNER JOIN
			--	@TempSecIDTable TMPSECID
			--ON
			--	( TDMC.SecId = TMPSECID.SecID ) AND
			--	( TMPSECID.BucketSecType = 'FI' )
							
		
			/* Update Is_FISecurity_Matured to 1 if Security maturity is within 30 days of trade date */
	
			 UPDATE @TempSecIDTable 
			 SET 
				Is_FISecurity_Matured = CASE WHEN ( BucketSecType <> 'FI' ) 
										THEN 0 ELSE 
											( CASE WHEN ( DATEDIFF(dd, @BussDate, ISNULL(Security_Maturity_Date,@BussDate)) < @Maturity_Days ) THEN 1 ELSE 0 END ) END		 
			WHERE
				Security_Maturity_Date <> 'N/A'

			UPDATE @TempSecIDTable 
			 SET 
				IsEquilend = 'N'		 
			WHERE
				ISNULL(IsEquilend, '') = ''

			SELECT  
				BulkNbr, --0
				VersionNbr, --1
				BucketSecType, --2
				SecID, --3
				ISOCOuntry, --4 
				SecCode, --5
				SEDOL, --6
				TickSymb, --7
				SecurityName, --8
				ISNULL(BrokerLendable,0) as BrokerLendable, --9
				PriceBaseCurrency, --10
				FXRate, --11
				Price, --12
				DivYield, --13
				DateEx, --14
				RecordDate, --15
				DivRate, --16
				RebateRate, --17
				FaceAmount, --18
				BasketMarketCap, --19
				AllocationPerc, --20
				Principal, --21
				ProductCategory, --22
				ProductCategoryLoanType, --23
				ProductCategoryLoanDuration, --24
				SettlementDate, --25
				AsOfDate,
				TermDate, --26
				STTLevel, --27
				STTEndDate, --28
				STTDivRate, --29,
				ScripEndDate, --30
				'' ErrorMEssage, -- 31
				IsValidSec, --32
				IsDuplicateSec, -- 33
				CcyCode, -- 34
				Remarks,
				GotoRemarks,
				LIBORRate,
				GotoRepoRate,
				GotoSTTLevel,
				GotoSTTDivRate,
				GotoProductCategoryLoanType,
				GotoProductCategoryLoanDuration,
				GotoScripEndDate,
				GotoSTTEndDate,
				GotoTermDate,
				ResetDate,
				GotoProductCategory,
				BasketNbr,
				'' as ASECheck,
				'' UseTraderLendable,
				0  TraderLendable,
				'' UseAmount,
				DesiredSTTLevel,
				'' as IsProjectedDividend,
				CONVERT(DECIMAL,NULL) as ProjectedDividendAmount,
				@ErrorRowSeq RowSeq,
				'' as DivRateForAlloc,
				IsBlocked = dbo.f_IsSecurityBlocked (SecID,@BussDate),
				CASE WHEN (ISNULL(FaceAmount,0) >  ISNULL(BrokerLendable,0))  THEN 1 ELSE  0 END AS isQtyGreaterThanBrkLendable	,
				Is_DedicatedMarginCollateral_FISecurity,
				Is_FISecurity_Matured,
				TPUID = '',
				Default_Open_TPUID = '',
				Default_Term_TPUID = ''	,
				IsPrePay = 0,
				IsEquilend
			FROM 
				@TempSecIDTable
			ORDER BY
				isQtyGreaterThanBrkLendable DESC



			SELECT DISTINCT 
				sec.secID,
				ISNULL(TM.BondForeign,1.00000) as DivRateVal, 
				CONVERT(VARCHAR(10),ISNULL(CONVERT(DECIMAL(8,2),TM.BondForeign),1) * 100) + '%' DivRate
			FROM  
				@TempSecIDTable sec
			LEFT JOIN
				GLOBALONE.dbo.TaxMatrix  TM
			ON
				TM.SecCountry = sec.ISOCOuntry
			WHERE
				sec.SecID is NOT NULL
			ORDER BY
				sec.secID,DivRateVal
		END
	END
	
	IF @ERROR_NO <> 0 
		RAISERROR ( 'Error raised in p_GetData_BulkLoan', 16, 1 )
END
