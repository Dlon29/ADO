    // what to do before ajax request
    function BeginRequestHandler(sender, e) {
        var tdETIStatus = document.getElementById("tdETISTatus");
        if (tdETIStatus != null)
            tdETIStatus.innerHTML = "Loading...";
    }

    // check any ajax error after request completed
    function EndRequestHandler(sender, e) {

        //        alert('x:'+sender._getScrollPosition().x + 'y:' + sender._getScrollPosition().y + 'h:' + hScroll + 'v:'+ vScroll);
        /*if (hScroll != '' && vScroll != '') 
