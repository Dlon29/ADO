    function fnShowHideTab(Object) {
        var TabsArray = new Array("AllLoan", "NewLoan", "RePricing", "ReturnLoan", "CancelLoan", "VerifyLoan", "AdjustRate", "Reallocation", "AdjustTermDate", "AdjustAvail", "NewCollateral", "AdjustTPUID", "AdjustPrePay", "CashPoolRate", "AllStatus");
        var TabsitemIntoArray = new Array("AllLoantatus_info", "NewLoan_items_info", "RePricing_items_info", "ReturnLoan_items_info", "CancelLoan_items_info", "VerifyLoan_items_info", "AdjustRateLoan_items_info", "Reallocation_items_info", "AdjustTermDate_items_info", "AdjustAvail_items_info", "NewCollateral_items_info", "AdjustTPUID_items_info", "AdjustPrePay_items_info", "CashPoolRate_items_info", "AllStatus_items_info");

        for (var i = 0; i < TabsArray.length; i++) {
            document.getElementById(TabsArray[i]).className = "notselected";

            if (TabsArray[i] == Object) {
                document.getElementById(TabsArray[i]).className = "selected";
            }
        }

        for (var i = 0; i < TabsitemIntoArray.length; i++) {
            document.getElementById(TabsitemIntoArray[i]).style.display = "none";

            if (TabsitemIntoArray[i].indexOf(Object) != -1) {
                document.getElementById(TabsitemIntoArray[i]).style.display = "inline";
            }
        }


        return false;
    }

