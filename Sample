        if (event.button == 2) {
            //alert("Sorry, you do not have permission to right click.");
            return false;
        }
        return true;
    }

    function Init_Form() {
        // on pressing the print button, the hdnPrint = 'true' which is set from codebehind so that 
        // when the page is loaded again this will open a report 
        var printUrl = document.forms[0].hdnPrintUrl.value;
        if (printUrl.length > 0) {
            document.forms[0].hdnPrintUrl.value = "";
            PopUpWindow(printUrl, '', 'width=screen.width,height=screen.height,scrollbars=no,resizable=yes,alwaysRaised,titlebar=no,screenX=0,screenY=0,left=0,top=0');
        }
        CheckAccessType();

        return;
