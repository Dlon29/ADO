    function fnShowHideSalesRecallDashboardTab(SelectedTAB, BucketSecType) {
        if (SelectedTAB != "") {
            $("#hdnCurrentTab").val(SelectedTAB);
        }

        var TabsArray = new Array("ALL", "FI", "EQ", "CurrentDay", "PreviousDay");
        if (SelectedTAB == "") {
            var selectedtabitem = new Array($("#hdnCurrentTab").val(), BucketSecType);
        }
        else {
            var selectedtabitem = new Array(SelectedTAB, BucketSecType);
        }

        var TabsitemIntoArray = new Array("CurrentDayALL_Records", "CurrentDayEQ_Records", "CurrentDayFI_Records", "PreviousDayALL_Records", "PreviousDayEQ_Records", "PreviousDayFI_Records");

        for (var i = 0; i < TabsArray.length; i++) {
            document.getElementById(TabsArray[i]).className = "notselected";
        }
        for (var i = 0; i < selectedtabitem.length; i++) {
            document.getElementById(selectedtabitem[i]).className = "selected";
        }
        if (SelectedTAB != "") {
            var tab = SelectedTAB + BucketSecType;
        }
        else {
            var tab = $("#hdnCurrentTab").val() + BucketSecType;
        }
        for (var i = 0; i < TabsitemIntoArray.length; i++) {
            document.getElementById(TabsitemIntoArray[i]).style.display = "none";

            if (TabsitemIntoArray[i].indexOf(tab) != -1) {
                document.getElementById(TabsitemIntoArray[i]).style.display = "inline";
            }
        }

        return false;
    }

