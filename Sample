        window.scrollTo(hScroll, vScroll);
        }*/

        window.scrollTo(sender._getScrollPosition().x, sender._getScrollPosition().y);

        if (e.get_error()) {
            alert(e.get_error().description);
            e.set_errorHandled(true);
        }
    }

