        var ShowAllocation = (recTypeId == 18 || recTypeId == 21 || recTypeId == 23 || recTypeId == 25) ? true : false; // Show Allocation for ASE/RAL/GPL/AJQ

        PopUpWindow('/LAVA/ETI/DetailData.aspx?sourceID=' + sourceID +
